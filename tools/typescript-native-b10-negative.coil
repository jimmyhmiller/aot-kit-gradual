(module typescriptnativeb10negative)

(import "frontendnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(defn code-of [(source (slice u8))] (-> i64)
  (let [(mut frontend) (fe-native-new source)]
    (fe-native-index! (mut frontend))
    (let [code (load (field frontend error-code))]
      (fe-native-free! (mut frontend))
      code)))

(defn main [] (-> i64)
  (let [constructor-layout (code-of
          "function Bad(value:number):number { return value; } function main():number { let x=new Bad(1); return x; }")
        method-layout (code-of
          "interface Box { value:number; } function add(amount:number):number { return amount; } function main():number { let box:Box={value:1}; return box.add(2); }")]
    (fmt (stdout) "constructor-layout={d} method-layout={d}\n"
      constructor-layout method-layout)
    (if (and (= constructor-layout FE-CODE-CONSTRUCTOR-LAYOUT)
             (= method-layout FE-CODE-MISSING-RECEIVER)) 0 2)))
