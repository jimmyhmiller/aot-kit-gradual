(module emitb06intobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1605)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        regs (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 8)
        a (n-new1 OP-ARG (t-int) (g-start))
        b (if (= mode 6) a (n-new1 OP-ARG (t-int) (g-start)))
        value (case mode
                0 (n-new3 OP-BITAND 0 NO-NODE a b)
                1 (n-new3 OP-BITOR 0 NO-NODE a b)
                2 (n-new3 OP-BITXOR 0 NO-NODE a b)
                3 (n-new3 OP-SHL 0 NO-NODE a b)
                4 (n-new3 OP-SHR 0 NO-NODE a b)
                5 (n-new3 OP-USHR 0 NO-NODE a b)
                6 (n-new2 OP-BITNOT 0 NO-NODE a)
                7 (n-new3 OP-MOD 0 NO-NODE a b)
                (n-new3 OP-BITAND 0 NO-NODE a b))]
    (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (g-start) value))
    (g-analyze!)
    (if (not (be-select-machine-program!))
        (let [gv (g-verify)]
          (fmt (stderr) "B06 selection failed mode={d} gv={d}:{d}@{d} be={d}@{d} verify={d} ms={d}@{d}\n"
               mode gv (g-verify-code) (g-verify-node)
               (be-result) (be-result-node) (be-verify-code)
               (ms-result) (ms-result-item)) 2)
      (do (be-schedule!)
          (if (< (be-color! regs) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
