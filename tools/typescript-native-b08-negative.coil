(module typescriptnativeb08negative)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn rejected [(source (slice u8))] (-> bool)
  (let [(mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))
        ok (and (= status FE-TARGET)
                (and (= (load (field frontend error-code)) FE-CODE-INVALID-TARGET)
                     (= (load (field frontend error-role)) TS-ROLE-LABEL)))]
    (fe-native-free! (mut frontend)) ok))

(defn main [] (-> i64)
  (let [outside (rejected "function main(): number { break; return 0; }")
        missing (rejected "function main(): number { while(1){ break missing; } return 0; }")
        nonloop (rejected "function main(): number { label: { continue label; } return 0; }")
        duplicate (rejected "function main(): number { x: { x: { break x; } } return 0; }")]
    (fmt (stdout) "outside={d} missing={d} nonloop={d} duplicate={d}\n"
      (if outside 1 0) (if missing 1 0) (if nonloop 1 0) (if duplicate 1 0))
    (if (and outside (and missing (and nonloop duplicate))) 0 2)))
