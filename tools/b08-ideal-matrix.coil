(module b08idealmatrix)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn integer-answer [(value RtVal)] (-> i64)
  ;; TypeScript's `number` is represented as either an exact interpreter integer or IEEE bits.
  ;; This control-flow matrix compares source-level integer answers, not RtVal payload encoding.
  (match value
    (RUndef [] 0)
    (RNull [] 0)
    (RBool [boolean] (if boolean 1 0))
    (RInt [number] number)
    (RFlt [bits] (cast i64 (bits-f64 bits)))
    (RObj [object] object)
    (RStr [string] string)
    (RSym [symbol] symbol)
    (RBig [bigint] bigint)
    (RFun [function] function)
    (RMem [memory] memory)))

(defn run-arg [(source (slice u8)) (seed i64) (optimize bool) (arg-value i64)] (-> i64)
  (let [(mut frontend) (fe-native-new source)]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) -9001)
        (let [arg (frontend-native-build-mode! (mut frontend) seed optimize true)]
          (ev-reset!) (ev-bind! arg (RInt arg-value))
          (let [status (ev-run-nobind 1000000)
                answer (if (= status EV-OK) (integer-answer (ev-result)) (- -9100 status))]
            (fe-native-free! (mut frontend)) answer)))))

(defn run-none [(source (slice u8)) (seed i64) (optimize bool)] (-> i64)
  (let [(mut frontend) (fe-native-new source)]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) -9001)
        (do (frontend-native-build-mode! (mut frontend) seed optimize true)
            (ev-reset!)
            (let [status (ev-run-nobind 1000000)
                  answer
                    (if (= status EV-OK)
                        (integer-answer (ev-result))
                        (do (ev-print (stderr)) (- -9100 status)))]
              (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (let [switch-source "function main(limit: number): number { let i=0; let out=0; outer: do { i++; switch(i) { default: out=out*10+8; case 3: out=out*10+3; break; case 1: out=out*10+1; continue outer; case 2: out=out*10+2; } out=out*10+9; if(i>=limit) break outer; } while(i<5); return out*10+i; }"
        loop-source "function main(limit: number): number { let out=0; outer: for(let j=0;j<limit;j++){ if(j===1) continue outer; out=out*10+j; if(j===3) break outer; } let i=0; while(i<2){ i++; if(i===1) continue; out=out*10+i; } return out; }"
        memory-source "type Box={value:number;count:number}; function Box(value:number,count:number):Box{return {value:value,count:count};} function main():number{let box=new Box(0,0); outer: do { box.value+=1; if(box.value===1){box.count+=10;continue outer;} box.count+=box.value; if(box.value>=3)break outer; } while(box.value<5); return box.value*100+box.count;}"
        w (stdout)]
    (fmt w "raw-switch-2|{d}\n" (run-arg switch-source 8301 false 2))
    (fmt w "raw-switch-3|{d}\n" (run-arg switch-source 8302 false 3))
    (fmt w "raw-loops-6|{d}\n" (run-arg loop-source 8303 false 6))
    (fmt w "raw-memory|{d}\n" (run-none memory-source 8304 false))
    (fmt w "optimized-switch-2|{d}\n" (run-arg switch-source 8311 true 2))
    (fmt w "optimized-switch-3|{d}\n" (run-arg switch-source 8312 true 3))
    (fmt w "optimized-loops-6|{d}\n" (run-arg loop-source 8313 true 6))
    (fmt w "optimized-memory|{d}\n" (run-none memory-source 8314 true))
    0))
