(module emitnativegcobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))

(defn gc-const [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn gc-mem [(alias i64)] (-> i64)
  (n-new1 OP-ARG (t-mem-alias alias (t-top)) (g-start)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1201) (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "x" (t-int)) ax (shape-field-alias sx 0)
        first (n-new-obj1! (g-start) sx (gc-mem ax)) root (n-obj-ptr first)
        mem1 (n-new4 OP-STORE ax NO-NODE (n-obj-mem first 0) root (gc-const 41))
        second (n-new-obj1! (g-start) sx mem1) other (n-obj-ptr second)
        mem2 (n-new4 OP-STORE ax NO-NODE (n-obj-mem second 0) other (gc-const 2))
        value (n-new3 OP-LOAD ax NO-NODE mem2 root)
        ret (n-new3 OP-RETURN 0 (g-start) value mem2)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!)) 2
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 1) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
