(module emitnativegcargumentobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn ac [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn am [(ctrl i64) (a i64)] (-> i64)
  (n-new1 OP-ARG (t-mem-alias a (t-undef)) ctrl))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1203) (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "value" (t-int)) av (shape-field-alias sx 0)
        fun (n-fun-open! 0) object (n-parm! fun 0)
        scratch (n-new-obj1! (n-fun-entry fun) sx (am (n-fun-entry fun) av))
        scratch-ptr (n-obj-ptr scratch)
        scratch-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem scratch 0) scratch-ptr (ac 7))
        cast-object (n-new2 OP-CAST (t-obj-shape sx) (n-fun-entry fun) object)
        value (n-new3 OP-LOAD av NO-NODE scratch-mem cast-object)
        body (n-new2 OP-RETURN 0 (n-fun-entry fun) value)]
    (n-fun-close! fun body)
    (let [nw (n-new-obj1! (g-start) sx (am (g-start) av)) obj (n-obj-ptr nw)
          mem (n-new4 OP-STORE av NO-NODE (n-obj-mem nw 0) obj (ac 41))
          site (n-call1! (g-start) fun obj)
          ret (n-new3 OP-RETURN 0 (call-end site) (call-value site) mem)]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (if (not (be-select-machine-program!))
        (do (fmt (stderr) "argument selection failed be={d} ms={d} item={d} gv={d}/{d}\n"
                 (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
        (do (be-use-runtime-allocation! true) (be-schedule!)
            (if (< (be-color! 10) 0)
              (do (fmt (stderr) "argument allocation failed {d} at {d}\n"
                       (mra-result) (mra-result-item))
                  (let [(mut vr) 0]
                    (loop (if (>= (load vr) (ml-vreg-count)) (break)
                      (do (fmt (stderr) " v{d} owner={d} reg={d} spill={d} kind={d}\n"
                               (load vr) (mra-owner (load vr)) (mra-reg (load vr))
                               (mra-spill (load vr)) (ml-value-kind (load vr)))
                          (store! vr (+ (load vr) 1)) 0)))) 3)
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
