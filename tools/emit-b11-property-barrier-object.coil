(module emitb11propertybarrierobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend" :use *)
(import "jsvalue" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn qc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn qm [(a i64)] (-> i64) (n-new1 OP-ARG (t-mem-alias a (t-undef)) (g-start)))

(defn main [] (-> i64)
  (graph-reset! 11160) (shape-reset!)
  (let [child-shape (shape-transition SHAPE-ROOT "value" (t-int))
        av (shape-field-alias child-shape 0)
        holder-shape (shape-transition SHAPE-ROOT "keep" (t-dyn))
        ah (shape-field-alias holder-shape 0)
        holder-new (n-new-obj1! (g-start) holder-shape (qm ah))
        holder (n-obj-ptr holder-new)
        trigger1 (n-new-obj1! (g-start) holder-shape (n-obj-mem holder-new 0))
        trigger1-mem (n-store! (n-obj-mem trigger1 0) (n-obj-ptr trigger1)
                               (qc JSV-UNDEFINED) ah)
        trigger2 (n-new-obj1! (g-start) holder-shape trigger1-mem)
        trigger2-mem (n-store! (n-obj-mem trigger2 0) (n-obj-ptr trigger2)
                               (qc JSV-NULL) ah)
        child-new (n-new-obj1! (g-start) child-shape (qm av))
        child (n-obj-ptr child-new)
        child-mem (n-store! (n-obj-mem child-new 0) child (qc 41) av)
        holder-properties (n-prop-store! trigger2-mem holder (n-box! child) "child")
        trigger3 (n-new-obj1! (g-start) holder-shape holder-properties)
        trigger3-mem (n-store! (n-obj-mem trigger3 0) (n-obj-ptr trigger3)
                               (qc JSV-UNDEFINED) ah)
        moved-box (n-prop-load! trigger3-mem holder "child")
        moved-child (n-unbox! moved-box (t-obj-shape child-shape))
        value (n-load! child-mem moved-child av)
        ret (n-new3 OP-RETURN 0 (g-start) value trigger3-mem)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!))
        (do (fmt (stderr) "B11 property barrier selection failed be={d} ms={d}@{d} gv={d}/{d}\n"
              (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 8) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len))
                       (be-object-len)) 0 6))))))))
