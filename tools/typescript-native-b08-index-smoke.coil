(module typescriptnativeb08indexsmoke)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "function main(limit: number): number { let i=0; outer: do { i++; switch(i) { default: i+=8; case 3: break; case 1: continue outer; } } while(i<limit); return i; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))
        ast (field frontend ast)
        (mut index) 0
        (mut seen) 0]
    (loop (if (>= (load index) (ts-node-count ast))
              (break)
              (let [kind (ts-kind ast (load index))]
                (if (or (= kind TSK-DO) (or (= kind TSK-SWITCH)
                    (or (= kind TSK-LABELED) (or (= kind TSK-CONTINUE)
                    (or (= kind TSK-BREAK) (or (= kind TSK-CASE-BLOCK)
                    (or (= kind TSK-CASE-CLAUSE) (= kind TSK-DEFAULT-CLAUSE))))))))
                    (store! seen (+ (load seen) 1)) 0)
                (store! index (+ (load index) 1)))))
    (fmt (stdout) "status={d} structured={d}\n" status (load seen))
    (fe-native-free! (mut frontend))
    (if (and (= status FE-OK) (= (load seen) 9)) 0 2)))
