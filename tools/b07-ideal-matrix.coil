(module b07idealmatrix)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(const BUDGET i64 100000)

(defn run-one [(source (slice u8)) (optimize bool) (flag i64)] (-> i64)
  (let [(mut frontend) (fe-native-new source)]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) -9001)
      (let [arg (frontend-native-build-mode! (mut frontend) (+ 7000 flag) optimize true)]
        (ev-reset!)
        (ev-bind! arg (RInt flag))
        (let [status (ev-run-nobind BUDGET)
              answer (if (= status EV-OK) (rt-payload (ev-result)) (- -9100 status))]
          (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (let [source
          "function main(flag: number): number { let x = 1; let selected = flag ? x++ : ++x; let andValue = flag && (x += 10); let orValue = flag || (x += 100); return selected + x + andValue + orValue; }"
        w (stdout)]
    (fmt w "raw-false|{d}\n" (run-one source false 0))
    (fmt w "raw-true|{d}\n" (run-one source false 1))
    (fmt w "optimized-false|{d}\n" (run-one source true 0))
    (fmt w "optimized-true|{d}\n" (run-one source true 1))
    0))
