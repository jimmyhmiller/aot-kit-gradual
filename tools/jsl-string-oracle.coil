;; The JSL side of the `String.prototype.indexOf` conformance table.
;;
;; Emits exactly the lines `tools/jsl-string-oracle.mjs` emits, so `tools/jsl-gate.sh` can `cmp`
;; the two. The case list is duplicated between the two files ON PURPOSE: a shared generator would
;; make the comparison self-consistent, which is the one thing an oracle must not be. Two
;; independent transcriptions of the same spec table is the point.
(module jslstringoracle)

(import "jsl"       :use *)
(import "jsl_lower" :use *)
(import "node"      :use *)
(import "ty"        :use *)
(import "eval"      :use *)
(import "shape"     :use *)
(import "jsstring"  :use *)
(import "verify"    :use *)
(import "jsvalue"   :use *)
(import "coil.io"    :use *)
(import "coil.fmt"   :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.control" :use *)
(import "coil.primitive" :as primitive)

(const INF-BITS i64 9218868437227405312)
(const NEG-INF-BITS i64 -4503599627370496)

(defn oracle-panic [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "jsl string oracle: ") (ps w msg) (ps w "\n"))
  (abort) 0)

;; A fresh graph with the shipped library loaded and lowered. Every case gets one, because a run
;; makes its Return a def of Stop and two Returns give the evaluator two entry points.
;; TEST ENTRY POINTS, defined here rather than in `lib/`. Each ALLOCATES the array it then reads, so
;; nothing crosses a call boundary — memory cannot. They are scaffolding, and scaffolding does not
;; belong in the shipped library.
(const ORACLE-PROBES
  "(builtin ProbeLen :params [(n dyn)] :ret dyn (%ArrayLen (ArrayIota n)))
   (builtin ProbeIndexOf :params [(n dyn) (t dyn)] :ret dyn (ArrayIndexOfFrom (ArrayIota n) t 0))
   (builtin ProbeIncludes :params [(n dyn) (t dyn)] :ret dyn (ArrayIncludes (ArrayIota n) t))
   (builtin ProbeLastIndexOf :params [(n dyn) (t dyn)] :ret dyn (ArrayLastIndexOf (ArrayIota n) t))
   (builtin ProbeAt :params [(n dyn) (i dyn)] :ret dyn (ArrayAt (ArrayIota n) i))
   (builtin ProbeJoin :params [(n dyn) (s dyn)] :ret dyn (ArrayJoin (ArrayIota n) s))
   (builtin ProbeMapJoin :params [(n dyn)] :ret dyn (ArrayJoin (ArrayMapDouble (ArrayIota n)) \",\"))
   (builtin ProbeRepeat :params [(n dyn) (v dyn)] :ret dyn (ArrayJoin (ArrayRepeat n v) \",\"))")

(defn oracle-fresh! [(seed i64)] (-> i64)
  (graph-reset! seed)
  (shape-reset!)
  (jss-reset!)
  (jsl-reset!)
  (if (!= (jsl-load-index! "lib/index") JSL-OK) (oracle-panic "library did not load") 0)
  (if (!= (jsl-read! ORACLE-PROBES) JSL-OK) (oracle-panic "probe definitions did not read") 0)
  ;; The native gate's probes are read here too, so BOTH execution modes cover the same rows.
  (if (!= (jsl-read-file! "tools/jsl-native-probes.jsl") JSL-OK)
      (oracle-panic "native probe definitions did not read") 0)
  (if (!= (jsl-check) JSL-OK) (oracle-panic "probe definitions did not check") 0)
  (if (!= (jsl-lower!) JSL-OK) (oracle-panic "library did not lower") 0)
    0)

;; Write a jsstring with every code unit outside printable ASCII escaped as \uXXXX, matching the
;; Node side exactly. No UTF-8 encoding on either side, and the whitespace fixtures (U+00A0, U+FEFF)
;; stay visible in a diff instead of being invisible bytes.
(defn oracle-put-hex4 [(w (ptr Writer)) (v i64)] (-> i64)
  (let [digits "0123456789abcdef"
        buf (stack (array u8 1))
        p (cast (ptr u8) buf)
        (mut sh) 12]
    (loop (if (< (load sh) 0) (break)
            (do (store! (index p 0) (slice-get digits (& (>> v (load sh)) 15)))
                (ps w (slice-new [u8] p 1))
                (store! sh (- (load sh) 4))
                0)))
    0))

(defn oracle-put-string [(w (ptr Writer)) (string i64)] (-> i64)
  (let [n (jss-length string)
        buf (stack (array u8 1))
        p (cast (ptr u8) buf)
        (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (let [unit (jss-code-unit string (load i))]
              (if (= unit 34) (ps w "\\\"")
                (if (= unit 92) (ps w "\\\\")
                  (if (or (< unit 32) (> unit 126))
                      (do (ps w "\\u") (oracle-put-hex4 w unit) 0)
                      (do (store! (index p 0) (cast u8 unit))
                          (ps w (slice-new [u8] p 1))
                          0))))
              (store! i (+ (load i) 1))
              0)))
    0))

;; A number, encoded canonically so the Node side can be compared byte for byte: `nan`, `inf`,
;; `-inf`, a decimal integer when the value is integral and safe, and otherwise the IEEE bit
;; pattern. Printing a decimal expansion would compare two FORMATTERS rather than two
;; implementations, and `{f}` here is a fixed six-digit display that could not round-trip anyway.
(const ORACLE-INF-BITS i64 9218868437227405312)
(const ORACLE-NEG-INF-BITS i64 -4503599627370496)

(defn oracle-put-number [(w (ptr Writer)) (r RtVal)] (-> i64)
  (if (= (rt-tag r) RT-INT) (do (dec-print w (rt-payload r)) 0)
    (if (= (rt-tag r) RT-BOOL) (do (ps w (if (= (rt-payload r) 1) "true" "false")) 0)
      (let [bits (rt-payload r)]
        (if (f64-nan-bits? bits) (do (ps w "nan") 0)
          (if (= bits ORACLE-INF-BITS) (do (ps w "inf") 0)
            (if (= bits ORACLE-NEG-INF-BITS) (do (ps w "-inf") 0)
              (let [d (bits-f64 bits)]
                (if (and (and (> d -9007199254740992.0) (< d 9007199254740992.0))
                         (primitive/fcmp-eq d (cast f64 (cast i64 d))))
                    (do (dec-print w (cast i64 d)) 0)
                    (do (ps w "bits:") (dec-print w bits) 0))))))))))

(defn oc-str [(s (slice u8))] (-> i64) (n-string-const! (jss-from-utf8! s)))
(defn oc-ty  [(t i64)] (-> i64) (n-peephole (n-new1 OP-CONST t (g-start))))
(defn oc-int [(v i64)] (-> i64) (oc-ty (t-int-con v)))
;; The two non-ASCII whitespace fixtures, built from code units because the source file is ASCII.
(defn oc-nbsp [] (-> i64)
  (n-string-const! (jss-concat! (jss-from-code-unit! 160)
                                (jss-concat! (jss-from-utf8! "ab") (jss-from-code-unit! 160)))))
(defn oc-zwnbsp [] (-> i64)
  (n-string-const! (jss-concat! (jss-from-code-unit! 65279) (jss-from-utf8! "ab"))))

;; The largest double below 0.5, by bit pattern rather than by literal so the fixture cannot drift
;; through the reader. See the Node side for why this value in particular.
(defn oc-half [] (-> i64) (oc-ty (t-flt-bits 4602678819172646911)))

(defn oc-nan [] (-> i64) (oc-ty (t-flt-bits JSV-NAN)))
(defn oc-inf [] (-> i64) (oc-ty (t-flt-bits ORACLE-INF-BITS)))
(defn oc-ninf [] (-> i64) (oc-ty (t-flt-bits ORACLE-NEG-INF-BITS)))
(defn oc-flt [(x f64)] (-> i64) (oc-ty (t-flt-con x)))

;; Run `String.prototype.indexOf` over three already-built argument nodes and print `NN=RESULT`.
;; A throw prints `throw`, which is what the Node side prints for the nullish-receiver cases.
(defn oracle-case [(index i64) (this i64) (search i64) (position i64)] (-> i64)
  (let [buf (stack (array i64 3))
        p (cast (ptr i64) buf)]
    (store! (index p 0) this)
    (store! (index p 1) search)
    (store! (index p 2) position)
    (let [cs (jsl-call! (g-start) "String.prototype.indexOf" (slice-new [i64] p 3))
          ret (n-new2 OP-RETURN 0 (call-end cs) (call-value cs))]
      (n-add-def! (g-stop) ret)
      (n-peephole (g-stop))
      (iterate!)
      (g-analyze!)
      (if (!= (g-verify) 0) (oracle-panic "graph did not verify") 0)
      (ev-reset!)
      (ev-bind-args! 0)
      (let [status (ev-run-nobind 100000)
            w (stdout)]
        (if (< index 10) (ps w "0") 0)
        (dec-print w index)
        (ps w "=")
        (if (= status EV-THROW)
            (ps w "throw")
            (if (!= status EV-OK)
                (oracle-panic "evaluation neither returned nor threw")
                (dec-print w (rt-payload (ev-result)))))
        (ps w "\n")
        0))))

;; A labelled case over a named builtin with N already-built argument nodes. Prints `LABEL=RESULT`,
;; with a string result quoted (JSON-style) and a throw as the bare token `throw`, matching the Node
;; side byte for byte.
(defn oracle-run [(label (slice u8)) (name (slice u8)) (args (slice i64))] (-> i64)
  (let [cs (jsl-call! (g-start) name args)
        ret (n-new2 OP-RETURN 0 (call-end cs) (call-value cs))]
    (n-add-def! (g-stop) ret)
    (n-peephole (g-stop))
    (iterate!)
    (g-analyze!)
    (if (!= (g-verify) 0) (oracle-panic "graph did not verify") 0)
    (ev-reset!)
    (ev-bind-args! 0)
    (let [status (ev-run-nobind 1000000)
          w (stdout)]
      (print-str w label)
      (ps w "=")
      (if (= status EV-THROW) (ps w "throw")
        (if (!= status EV-OK) (oracle-panic "evaluation neither returned nor threw")
          (let [r (ev-result)]
            (if (= (rt-tag r) RT-STR)
                (do (ps w "\"") (oracle-put-string w (rt-payload r)) (ps w "\"") 0)
              ; `String.prototype.at` answers `undefined` out of range, and the Node side maps that
              ; to the token "undef" so it cannot be confused with a numeric 0.
              (if (= (rt-tag r) RT-UNDEF) (do (ps w "\"undef\"") 0)
                (oracle-put-number w r))))))
      (ps w "\n")
      0)))

(defn oracle-run1 [(label (slice u8)) (name (slice u8)) (a i64)] (-> i64)
  (let [buf (stack (array i64 1)) p (cast (ptr i64) buf)]
    (store! (index p 0) a)
    (oracle-run label name (slice-new [i64] p 1))))

(defn oracle-run2 [(label (slice u8)) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (let [buf (stack (array i64 2)) p (cast (ptr i64) buf)]
    (store! (index p 0) a) (store! (index p 1) b)
    (oracle-run label name (slice-new [i64] p 2))))

(defn oracle-run3 [(label (slice u8)) (name (slice u8)) (a i64) (b i64) (c i64)] (-> i64)
  (let [buf (stack (array i64 3)) p (cast (ptr i64) buf)]
    (store! (index p 0) a) (store! (index p 1) b) (store! (index p 2) c)
    (oracle-run label name (slice-new [i64] p 3))))

(defn main [] (-> i64)
  (oracle-fresh! 92000) (oracle-case 0  (oc-str "hello world") (oc-str "o") (oc-int 0))
  (oracle-fresh! 92001) (oracle-case 1  (oc-str "hello world") (oc-str "o") (oc-int 5))
  (oracle-fresh! 92002) (oracle-case 2  (oc-str "hello world") (oc-str "o") (oc-int 99))
  (oracle-fresh! 92003) (oracle-case 3  (oc-str "hello world") (oc-str "o") (oc-int -99))
  (oracle-fresh! 92004) (oracle-case 4  (oc-str "abcabc") (oc-str "b") (oc-int 2))
  (oracle-fresh! 92005) (oracle-case 5  (oc-str "abcabc") (oc-str "b") (oc-flt 2.9))
  (oracle-fresh! 92006) (oracle-case 6  (oc-str "abcabc") (oc-str "b") (oc-flt -2.9))
  (oracle-fresh! 92007) (oracle-case 7  (oc-str "abc") (oc-str "c") (oc-ty (t-flt-bits INF-BITS)))
  (oracle-fresh! 92008) (oracle-case 8  (oc-str "abc") (oc-str "c") (oc-ty (t-flt-bits NEG-INF-BITS)))
  (oracle-fresh! 92009) (oracle-case 9  (oc-str "abc") (oc-str "c") (oc-ty (t-flt-bits JSV-NAN)))
  (oracle-fresh! 92010) (oracle-case 10 (oc-str "abc") (oc-str "") (oc-int 0))
  (oracle-fresh! 92011) (oracle-case 11 (oc-str "abc") (oc-str "") (oc-int 99))
  (oracle-fresh! 92012) (oracle-case 12 (oc-str "abc") (oc-str "zz") (oc-int 0))
  (oracle-fresh! 92013) (oracle-case 13 (oc-str "abc") (oc-str "b") (oc-ty (t-undef)))
  (oracle-fresh! 92014) (oracle-case 14 (oc-str "abc") (oc-str "b") (oc-ty (t-null)))
  (oracle-fresh! 92015) (oracle-case 15 (oc-str "abc") (oc-str "b") (oc-ty (t-bool-con true)))
  (oracle-fresh! 92016) (oracle-case 16 (oc-str "abc") (oc-str "b") (oc-str "1"))
  (oracle-fresh! 92017) (oracle-case 17 (oc-str "abc") (oc-str "b") (oc-str " 1 "))
  (oracle-fresh! 92018) (oracle-case 18 (oc-str "abc") (oc-str "b") (oc-str "1e0"))
  (oracle-fresh! 92019) (oracle-case 19 (oc-str "abc") (oc-str "b") (oc-str "0x1"))
  (oracle-fresh! 92020) (oracle-case 20 (oc-str "abc") (oc-str "b") (oc-str ""))
  (oracle-fresh! 92021) (oracle-case 21 (oc-str "abc") (oc-str "b") (oc-str "nonsense"))
  (oracle-fresh! 92022) (oracle-case 22 (oc-str "12345") (oc-int 34) (oc-int 0))
  (oracle-fresh! 92023) (oracle-case 23 (oc-str "truthy") (oc-ty (t-bool-con true)) (oc-int 0))
  ; Step 1: RequireObjectCoercible throws on a nullish receiver.
  (oracle-fresh! 92024) (oracle-case 24 (oc-ty (t-null)) (oc-str "b") (oc-int 0))
  (oracle-fresh! 92025) (oracle-case 25 (oc-ty (t-undef)) (oc-str "b") (oc-int 0))

  ; The iterative builtins. None of these was expressible before `loop`.
  (oracle-fresh! 92100) (oracle-run2 "rep0" "StringRepeatCount" (oc-str "ab") (oc-int 3))
  (oracle-fresh! 92101) (oracle-run2 "rep1" "StringRepeatCount" (oc-str "ab") (oc-int 0))
  (oracle-fresh! 92102) (oracle-run2 "rep2" "StringRepeatCount" (oc-str "") (oc-int 5))
  (oracle-fresh! 92103) (oracle-run2 "rep3" "StringRepeatCount" (oc-str "x") (oc-int 1))
  (oracle-fresh! 92104) (oracle-run2 "rep4" "StringRepeatCount" (oc-str "ab") (oc-int -1))

  (oracle-fresh! 92110) (oracle-run2 "last0" "StringLastIndexOf" (oc-str "abcabc") (oc-str "b"))
  (oracle-fresh! 92111) (oracle-run2 "last1" "StringLastIndexOf" (oc-str "abcabc") (oc-str "zz"))
  (oracle-fresh! 92112) (oracle-run2 "last2" "StringLastIndexOf" (oc-str "aaa") (oc-str "a"))
  (oracle-fresh! 92113) (oracle-run2 "last3" "StringLastIndexOf" (oc-str "abc") (oc-str ""))
  (oracle-fresh! 92114) (oracle-run2 "last4" "StringLastIndexOf" (oc-str "abcabc") (oc-str "abc"))

  (oracle-fresh! 92120) (oracle-run3 "pad0" "StringPadStart" (oc-str "abc") (oc-int 6) (oc-str "0"))
  (oracle-fresh! 92121) (oracle-run3 "pad1" "StringPadStart" (oc-str "abc") (oc-int 2) (oc-str "0"))
  (oracle-fresh! 92122) (oracle-run3 "pad2" "StringPadStart" (oc-str "abc") (oc-int 3) (oc-str "0"))
  (oracle-fresh! 92123) (oracle-run3 "pad3" "StringPadStart" (oc-str "abc") (oc-int 8) (oc-str "xy"))
  (oracle-fresh! 92124) (oracle-run3 "pad4" "StringPadStart" (oc-str "abc") (oc-int 6) (oc-str ""))
  (oracle-fresh! 92125) (oracle-run3 "pad5" "StringPadStart" (oc-str "") (oc-int 3) (oc-str "z"))

  ; The rest of String.prototype.
  (oracle-fresh! 94000) (oracle-run2 "chat0" "StringCharAt" (oc-str "abc") (oc-int 0))
  (oracle-fresh! 94001) (oracle-run2 "ccode0" "StringCharCodeAt" (oc-str "abc") (oc-int 0))
  (oracle-fresh! 94002) (oracle-run2 "at0" "StringAt" (oc-str "abc") (oc-int 0))
  (oracle-fresh! 94003) (oracle-run2 "chat1" "StringCharAt" (oc-str "abc") (oc-int 2))
  (oracle-fresh! 94004) (oracle-run2 "ccode1" "StringCharCodeAt" (oc-str "abc") (oc-int 2))
  (oracle-fresh! 94005) (oracle-run2 "at1" "StringAt" (oc-str "abc") (oc-int 2))
  (oracle-fresh! 94006) (oracle-run2 "chat2" "StringCharAt" (oc-str "abc") (oc-int 3))
  (oracle-fresh! 94007) (oracle-run2 "ccode2" "StringCharCodeAt" (oc-str "abc") (oc-int 3))
  (oracle-fresh! 94008) (oracle-run2 "at2" "StringAt" (oc-str "abc") (oc-int 3))
  (oracle-fresh! 94009) (oracle-run2 "chat3" "StringCharAt" (oc-str "abc") (oc-int -1))
  (oracle-fresh! 94010) (oracle-run2 "ccode3" "StringCharCodeAt" (oc-str "abc") (oc-int -1))
  (oracle-fresh! 94011) (oracle-run2 "at3" "StringAt" (oc-str "abc") (oc-int -1))
  (oracle-fresh! 94012) (oracle-run2 "chat4" "StringCharAt" (oc-str "") (oc-int 0))
  (oracle-fresh! 94013) (oracle-run2 "ccode4" "StringCharCodeAt" (oc-str "") (oc-int 0))
  (oracle-fresh! 94014) (oracle-run2 "at4" "StringAt" (oc-str "") (oc-int 0))
  (oracle-fresh! 94015) (oracle-run2 "atn0" "StringAt" (oc-str "abcdef") (oc-int -2))
  (oracle-fresh! 94016) (oracle-run2 "atn1" "StringAt" (oc-str "abcdef") (oc-int -99))
  (oracle-fresh! 94017) (oracle-run2 "atn2" "StringAt" (oc-str "abc") (oc-int 1))
  (oracle-fresh! 94018) (oracle-run3 "slice0" "StringSlice" (oc-str "abcdef") (oc-int 1) (oc-int 4))
  (oracle-fresh! 94019) (oracle-run3 "slice1" "StringSlice" (oc-str "abcdef") (oc-int -3) (oc-int -1))
  (oracle-fresh! 94020) (oracle-run3 "slice2" "StringSlice" (oc-str "abcdef") (oc-int 4) (oc-int 1))
  (oracle-fresh! 94021) (oracle-run3 "slice3" "StringSlice" (oc-str "abcdef") (oc-int -99) (oc-int 99))
  (oracle-fresh! 94022) (oracle-run3 "slice4" "StringSlice" (oc-str "abc") (oc-int 2) (oc-int 2))
  (oracle-fresh! 94023) (oracle-run1 "trim0" "StringTrim" (oc-str "  ab  "))
  (oracle-fresh! 94024) (oracle-run1 "trimS0" "StringTrimStart" (oc-str "  ab  "))
  (oracle-fresh! 94025) (oracle-run1 "trimE0" "StringTrimEnd" (oc-str "  ab  "))
  (oracle-fresh! 94026) (oracle-run1 "trim1" "StringTrim" (oc-str "\t\n ab"))
  (oracle-fresh! 94027) (oracle-run1 "trimS1" "StringTrimStart" (oc-str "\t\n ab"))
  (oracle-fresh! 94028) (oracle-run1 "trimE1" "StringTrimEnd" (oc-str "\t\n ab"))
  (oracle-fresh! 94029) (oracle-run1 "trim2" "StringTrim" (oc-str "ab\r\n"))
  (oracle-fresh! 94030) (oracle-run1 "trimS2" "StringTrimStart" (oc-str "ab\r\n"))
  (oracle-fresh! 94031) (oracle-run1 "trimE2" "StringTrimEnd" (oc-str "ab\r\n"))
  (oracle-fresh! 94032) (oracle-run1 "trim3" "StringTrim" (oc-str ""))
  (oracle-fresh! 94033) (oracle-run1 "trimS3" "StringTrimStart" (oc-str ""))
  (oracle-fresh! 94034) (oracle-run1 "trimE3" "StringTrimEnd" (oc-str ""))
  (oracle-fresh! 94035) (oracle-run1 "trim4" "StringTrim" (oc-str "   "))
  (oracle-fresh! 94036) (oracle-run1 "trimS4" "StringTrimStart" (oc-str "   "))
  (oracle-fresh! 94037) (oracle-run1 "trimE4" "StringTrimEnd" (oc-str "   "))
  (oracle-fresh! 94038) (oracle-run1 "trim5" "StringTrim" (oc-str "a b"))
  (oracle-fresh! 94039) (oracle-run1 "trimS5" "StringTrimStart" (oc-str "a b"))
  (oracle-fresh! 94040) (oracle-run1 "trimE5" "StringTrimEnd" (oc-str "a b"))
  (oracle-fresh! 94041) (oracle-run1 "trim6" "StringTrim" (oc-nbsp))
  (oracle-fresh! 94042) (oracle-run1 "trimS6" "StringTrimStart" (oc-nbsp))
  (oracle-fresh! 94043) (oracle-run1 "trimE6" "StringTrimEnd" (oc-nbsp))
  (oracle-fresh! 94044) (oracle-run1 "trim7" "StringTrim" (oc-zwnbsp))
  (oracle-fresh! 94045) (oracle-run1 "trimS7" "StringTrimStart" (oc-zwnbsp))
  (oracle-fresh! 94046) (oracle-run1 "trimE7" "StringTrimEnd" (oc-zwnbsp))
  (oracle-fresh! 94047) (oracle-run3 "pade0" "StringPadEnd" (oc-str "abc") (oc-int 6) (oc-str "0"))
  (oracle-fresh! 94048) (oracle-run3 "pade1" "StringPadEnd" (oc-str "abc") (oc-int 2) (oc-str "0"))
  (oracle-fresh! 94049) (oracle-run3 "pade2" "StringPadEnd" (oc-str "abc") (oc-int 8) (oc-str "xy"))
  (oracle-fresh! 94050) (oracle-run3 "pade3" "StringPadEnd" (oc-str "") (oc-int 3) (oc-str "z"))
  (oracle-fresh! 94051) (oracle-run3 "repl0" "StringReplaceAll" (oc-str "abcabc") (oc-str "b") (oc-str "X"))
  (oracle-fresh! 94052) (oracle-run3 "repl1" "StringReplaceAll" (oc-str "abcabc") (oc-str "abc") (oc-str ""))
  (oracle-fresh! 94053) (oracle-run3 "repl2" "StringReplaceAll" (oc-str "abc") (oc-str "") (oc-str "-"))
  (oracle-fresh! 94054) (oracle-run3 "repl3" "StringReplaceAll" (oc-str "") (oc-str "") (oc-str "-"))
  (oracle-fresh! 94055) (oracle-run3 "repl4" "StringReplaceAll" (oc-str "aaa") (oc-str "aa") (oc-str "b"))
  (oracle-fresh! 94056) (oracle-run3 "repl5" "StringReplaceAll" (oc-str "abc") (oc-str "zz") (oc-str "X"))
  (oracle-fresh! 94057) (oracle-run3 "repl6" "StringReplaceAll" (oc-str "abc") (oc-str "c") (oc-str "cc"))

  ; Array.prototype, over arrays the JSL side builds itself.
  (oracle-fresh! 95000) (oracle-run2 "aidx0" "ProbeIndexOf" (oc-int 5) (oc-int 3))
  (oracle-fresh! 95001) (oracle-run2 "ainc0" "ProbeIncludes" (oc-int 5) (oc-int 3))
  (oracle-fresh! 95002) (oracle-run2 "alast0" "ProbeLastIndexOf" (oc-int 5) (oc-int 3))
  (oracle-fresh! 95003) (oracle-run2 "aidx1" "ProbeIndexOf" (oc-int 5) (oc-int 0))
  (oracle-fresh! 95004) (oracle-run2 "ainc1" "ProbeIncludes" (oc-int 5) (oc-int 0))
  (oracle-fresh! 95005) (oracle-run2 "alast1" "ProbeLastIndexOf" (oc-int 5) (oc-int 0))
  (oracle-fresh! 95006) (oracle-run2 "aidx2" "ProbeIndexOf" (oc-int 5) (oc-int 4))
  (oracle-fresh! 95007) (oracle-run2 "ainc2" "ProbeIncludes" (oc-int 5) (oc-int 4))
  (oracle-fresh! 95008) (oracle-run2 "alast2" "ProbeLastIndexOf" (oc-int 5) (oc-int 4))
