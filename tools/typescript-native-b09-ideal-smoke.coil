(module typescriptnativeb09idealsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)

(defn run [(limit i64) (optimize bool)] (-> i64)
  (let [source "function main(limit:number):number { let x=1; let add=function(amount:number):number { x+=amount; return x; }; let multiply=function(amount:number):number { x*=amount; return x; }; let y=0; let touch=function():number { y+=1; return y; }; let factorial=function self(n:number):number { if(n<=1)return 1; return n*self(n-1); }; return add(limit)*100000+multiply(3)*100+factorial(5)+touch()-1; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK) (do (fe-native-free! (mut frontend)) -9000)
      (let [arg (frontend-native-build-mode! (mut frontend) (+ 9000 limit) optimize true)]
        (ev-reset!) (ev-bind-args! 0) (ev-bind! arg (RInt limit))
        (let [run-status (ev-run-nobind 1000000)
              answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
          (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (let [raw2 (run 2 false) raw5 (run 5 false)
        opt2 (run 2 true) opt5 (run 5 true)]
    (if (and (= raw2 301020) (and (= raw5 601920)
             (and (= opt2 301020) (= opt5 601920)))) 0 3)))
