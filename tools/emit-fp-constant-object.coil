(module emitfpconstantobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1506)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        bits (case mode 0 0 1 JSV-NEGATIVE-ZERO
                    2 9218868437227405312 3 JSV-NAN 0)
        value (n-new1 OP-CONST (t-flt-bits bits) (g-start))
        ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (if (not (be-select-machine-program!)) 2
      (do (be-schedule!) (be-color! 8)
          (if (not (be-encode-checked!)) 3
            (if (not (be-macho-checked!)) 4
              (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 5)))))))
