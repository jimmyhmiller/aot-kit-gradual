(module emitb14builtinobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "jsbuiltin" :use *)
(import "jsbuiltin_desc" :use *)
(import "coil.io" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))

(defn main [] (-> i64)
  (graph-reset! 11410)
  (let [nine (n-new1 OP-CONST (t-int-con 9) (g-start))
        zero (n-new1 OP-CONST (t-int-con 0) (g-start))
        dynamic (n-js-builtin! JBI-SQRT (n-box! nine) (n-box! zero))
        value (n-unbox! dynamic (t-flt))
        ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (if (not (be-select-machine-program!)) 2
      (do (be-schedule!)
          (if (< (be-color! 1) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
