(module typescriptnativeb07updatesmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "typescriptnative" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "function main(a: number): number { let x = a; let old = x++; let fresh = ++x; return (x += 10, old + fresh + x); }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 32768))]
    (let [status (fe-native-index! (mut frontend))]
      (if (!= status FE-OK)
        (do (fmt (stderr) "B07 index={d} code={d} node={d} kind={d}\n"
                 status (load (field frontend error-code)) (load (field frontend error-node))
                 (ts-kind (field frontend ast) (load (field frontend error-node))))
            (fe-native-free! (mut frontend)) 2)
        (let [built (frontend-native-build! (mut frontend) 6207 false)]
          (fmt (stderr) "B07 update build={d} nodes={d}\n" built (n-count))
            (ps (stdout) (g-render (cast (ptr i8) buffer) 32768))
            (fe-native-free! (mut frontend)) 0)))))
