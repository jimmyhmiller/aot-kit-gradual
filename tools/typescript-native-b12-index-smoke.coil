(module typescriptnativeb12indexsmoke)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [(mut frontend) (fe-native-new "function main(){let a=[10,,30];return a[0];}")
        status (fe-native-index! (mut frontend)) ast (field frontend ast)
        (mut node) 0 (mut arrays) 0 (mut elements) 0]
    (loop (if (>= (load node) (ts-node-count ast)) (break)
      (do (if (= (ts-kind ast (load node)) TSK-ARRAY-LITERAL)
              (do (store! arrays (+ (load arrays) 1))
                  (fmt (stdout) "array-children={d}" (ts-child-count ast (load node)))
                  (let [(mut child) 0]
                    (loop (if (>= (load child) (ts-child-count ast (load node))) (break)
                      (do (fmt (stdout) " kind={d}" (ts-kind ast (ts-child ast (load node) (load child))))
                          (store! child (+ (load child) 1)) 0))))
                  (fmt (stdout) "\n") 0) 0)
          (if (= (ts-kind ast (load node)) TSK-ELEMENT-ACCESS)
              (store! elements (+ (load elements) 1)) 0)
          (store! node (+ (load node) 1)) 0)))
    (fmt (stdout) "status={d} arrays={d} elements={d}\n"
      status (load arrays) (load elements))
    (fe-native-free! (mut frontend))
    (if (and (= status FE-OK) (and (= (load arrays) 1) (= (load elements) 1))) 0 2)))
