(module emitb10receiverobject)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "backend" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [regs (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)
        mutation (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 0)
        seed (if (> argc 3) (cast i64 (atoi (load (index argv 3)))) 10200)
        source "interface Box { value:number; } function add(this:Box, amount:number):number { return this.value+amount; } function Primitive(this:Box, value:number):number { this.value=value; return 99; } function ObjectResult(this:Box, value:number):Box { this.value=-1; return {value:value}; } function main():number { let box:Box={value:40}; let receiverResult=box.add(2)*10+1; let a:Box=new Primitive(7); let b:Box=new ObjectResult(11); return receiverResult*1000+a.add(0)*100+b.value; }"
        (mut frontend) (fe-native-new source)]
    (store! (fng-omit-receiver-ptr) (= mutation 1))
    (store! (fng-duplicate-receiver-ptr) (= mutation 2))
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
      (do (frontend-native-build! (mut frontend) seed false)
          (fe-native-free! (mut frontend))
          (if (not (be-select-machine-program!))
              (do (fmt (stderr) "B10 selection failed be={d}@{d} ms={d}@{d} verify={d}@{d}\n"
                    (be-result) (be-result-node) (ms-result) (ms-result-item)
                    (g-verify-code) (g-verify-node)) 3)
            (do (be-use-runtime-allocation! true)
                (be-schedule!)
                (if (< (be-color! regs) 0) 4
                  (if (not (be-encode-checked!)) 5
                    (if (not (be-macho-checked!)) 6
                      (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 7))))))))))
