(module typescriptnativeb10indexsmoke)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source "interface Box { value:number; } function add(this:Box, amount:number):number { return this.value+amount; } function BoxCtor(this:Box, value:number):void { this.value=value; } function main(box:Box):number { return box.add(2)+new BoxCtor(3).value; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))
        add (if (= status FE-OK) (al-get [FeFunction] (load (field frontend functions)) 0)
                                    (zeroed FeFunction))
        ctor (if (= status FE-OK) (al-get [FeFunction] (load (field frontend functions)) 1)
                                     (zeroed FeFunction))
        add-receiver (load (field add receiver-type-node))
        ctor-receiver (load (field ctor receiver-type-node))
        ok (and (= status FE-OK)
                (and (= (al-len [FeFunction] (load (field frontend functions))) 3)
                     (and (= (load (field add parameter-count)) 1)
                          (and (= (load (field ctor parameter-count)) 1)
                               (and (= (ts-kind (field frontend ast) add-receiver) TSK-TYPE-REFERENCE)
                                    (= (ts-kind (field frontend ast) ctor-receiver) TSK-TYPE-REFERENCE))))))]
    (fmt (stdout) "status={d} functions={d} add-params={d} ctor-params={d} receivers={d},{d}\n"
      status (al-len [FeFunction] (load (field frontend functions)))
      (load (field add parameter-count)) (load (field ctor parameter-count))
      (if (= add-receiver -1) 0 1) (if (= ctor-receiver -1) 0 1))
    (fe-native-free! (mut frontend))
    (if ok 0 2)))
