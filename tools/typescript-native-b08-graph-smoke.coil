(module typescriptnativeb08graphsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.str" :use *)

(defn main [] (-> i64)
  (let [source "function main(limit: number): number { let i=0; let out=0; outer: do { i++; switch(i) { default: out=out*10+8; case 3: out=out*10+3; break; case 1: out=out*10+1; continue outer; case 2: out=out*10+2; } out=out*10+9; if(i>=limit) break outer; } while(i<5); return out*10+i; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 65536))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do (frontend-native-build-mode! (mut frontend) 8401 false true)
            (ps (stdout) (g-render (cast (ptr i8) buffer) 65536))
            (fe-native-free! (mut frontend)) 0))))
