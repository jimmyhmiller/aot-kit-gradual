(module typescriptnativecallgraphsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "function twice(x: number): number { return x * 2; } function main(n: number): number { let y = twice(n + 1); return y - 1; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 32768))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do
          (frontend-native-build! (mut frontend) 6202 true)
          (ps (stdout) (g-render (cast (ptr i8) buffer) 32768))
          (fe-native-free! (mut frontend))
          0))))
