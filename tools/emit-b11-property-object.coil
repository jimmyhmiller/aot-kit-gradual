(module emitb11propertyobject)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "backend" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [regs (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)
        seed (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 11140)
        source "function main() { let object={}; let child={x:11}; object.child=child; let junk={z:1}; return object.child.x; }"
        (mut frontend) (fe-native-new source)]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
      (do (frontend-native-build! (mut frontend) seed false)
          (fe-native-free! (mut frontend))
          (if (not (be-select-machine-program!))
              (do (fmt (stderr) "B11 selection failed be={d}@{d} ms={d}@{d} verify={d}@{d}\n"
                    (be-result) (be-result-node) (ms-result) (ms-result-item)
                    (g-verify-code) (g-verify-node))
                  (let [(mut at) 0]
                    (loop
                      (if (>= (load at) (be-inst-count)) (break)
                        (do (fmt (stderr) "  mi={d} op={s} dst={d} a={d} node={d}\n"
                              (load at) (mi-op-name (ms-inst-op (load at)))
                              (ms-inst-dst (load at)) (ms-inst-a (load at))
                              (ms-inst-node (load at)))
                            (store! at (+ (load at) 1)) 0)))) 3)
            (do (be-use-runtime-allocation! true)
                (be-schedule!)
                (if (< (be-color! regs) 0) 4
                  (if (not (be-encode-checked!)) 5
                    (if (not (be-macho-checked!)) 6
                      (if (= (write 1 (be-object-data) (be-object-len))
                             (be-object-len)) 0 7))))))))))
