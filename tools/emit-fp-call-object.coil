(module emitfpcallobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1507)
  (let [add (n-fun-open! 0) x (n-parm! add 0) y (n-parm! add 1)
        sum (n-new3 OP-ADD 0 NO-NODE x y)
        add-ret (n-new2 OP-RETURN 0 (n-fun-entry add) sum)]
    (n-fun-close! add add-ret)
    (let [a (n-new1 OP-ARG (t-flt) (g-start))
          b (n-new1 OP-ARG (t-int) (g-start))
          site (n-call2! (g-start) add a b)
          zero (n-new3 OP-SUB 0 NO-NODE a a)
          result (n-new3 OP-ADD 0 NO-NODE (call-value site) zero)
          ret (n-new2 OP-RETURN 0 (call-end site) result)]
      (n-add-def! (g-stop) ret)
      (g-infer!)
      (if (not (be-select-machine-program!)) 2
        (do (be-schedule!)
            (if (< (be-color! (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)) 0) 3
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
