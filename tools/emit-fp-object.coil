(module emitfpobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1505)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        a (n-new1 OP-ARG (if (>= mode 8) (t-int) (t-flt)) (g-start))
        b (n-new1 OP-ARG (if (or (= mode 0) (>= mode 8)) (t-int) (t-flt)) (g-start))
        value (case mode
                0 (n-new3 OP-ADD 0 NO-NODE a b)
                1 (n-new3 OP-SUB 0 NO-NODE a b)
                2 (n-new3 OP-MUL 0 NO-NODE a b)
                3 (n-new3 OP-DIV 0 NO-NODE a b)
                4 (n-new2 OP-MINUS 0 NO-NODE (n-new3 OP-ADD 0 NO-NODE a b))
                5 (n-new3 OP-EQ 0 NO-NODE a b)
                6 (n-new3 OP-LT 0 NO-NODE a b)
                7 (n-new3 OP-LE 0 NO-NODE a b)
                8 (n-new3 OP-DIV 0 NO-NODE a b)
                9 (n-new3 OP-ADD (t-flt) NO-NODE a b)
                (n-new3 OP-ADD 0 NO-NODE a b))
        ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (if (not (be-select-machine-program!))
        (do (fmt (stderr) "fp selection failed mode={d} be={d}@{d} ms={d}@{d}\n"
                 mode (be-result) (be-result-node) (ms-result) (ms-result-item)) 2)
      (do (be-schedule!)
          (if (< (be-color! (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 8)) 0) 3
            (if (not (be-encode-checked!)) 4
              (do
                (if (> argc 3)
                    (case (cast i64 (atoi (load (index argv 3))))
                      1 (be-falsify-first-fp-reload!)
                      2 (be-falsify-fp-lt-unordered!)
                      0) 0)
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
