(module emitnativegcfieldobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn fc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn fm [(a i64)] (-> i64) (n-new1 OP-ARG (t-mem-alias a (t-undef)) (g-start)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1202) (shape-reset!)
  (let [child-shape (shape-transition SHAPE-ROOT "value" (t-int))
        av (shape-field-alias child-shape 0)
        parent-shape (shape-transition SHAPE-ROOT "child" (t-obj-shape child-shape))
        ac (shape-field-alias parent-shape 0)
        child-new (n-new-obj1! (g-start) child-shape (fm av)) child (n-obj-ptr child-new)
        child-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem child-new 0) child (fc 41))
        parent-new (n-new-obj1! (g-start) parent-shape (fm ac)) parent (n-obj-ptr parent-new)
        parent-mem (n-new4 OP-STORE ac NO-NODE (n-obj-mem parent-new 0) parent child)
        scratch-new (n-new-obj1! (g-start) child-shape child-mem) scratch (n-obj-ptr scratch-new)
        scratch-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem scratch-new 0) scratch (fc 7))
        trigger-new (n-new-obj1! (g-start) parent-shape parent-mem) trigger (n-obj-ptr trigger-new)
        trigger-mem (n-new4 OP-STORE ac NO-NODE (n-obj-mem trigger-new 0) trigger child)
        moved-child (n-new3 OP-LOAD ac NO-NODE trigger-mem parent)
        cast-child (n-new2 OP-CAST (t-obj-shape child-shape) (g-start) moved-child)
        value (n-new3 OP-LOAD av NO-NODE child-mem cast-child)
        ret (n-new3 OP-RETURN 0 (g-start) value scratch-mem)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "field selection failed be={d} ms={d} item={d} gv={d}/{d}\n"
               (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 10) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
