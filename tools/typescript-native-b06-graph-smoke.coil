(module typescriptnativeb06graphsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)

(defn main [] (-> i64)
  (let [source
          "function main(a: number, b: number): number { let x = (a & b) ^ (a | b); x <<= 33; x = (x >>> 1) + (a >> b); x %= 97; return ~x; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 32768))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do
          (frontend-native-build! (mut frontend) 6206 true)
          (ps (stdout) (g-render (cast (ptr i8) buffer) 32768))
          (fe-native-free! (mut frontend))
          0))))
