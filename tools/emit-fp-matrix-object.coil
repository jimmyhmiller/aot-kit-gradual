(module emitfpmatrixobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1511)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        a (n-new1 OP-ARG (t-flt) (g-start))
        b (n-new1 OP-ARG (t-flt) (g-start))
        value (case mode
                0 (n-new3 OP-ADD 0 NO-NODE a b)
                1 (n-new3 OP-ADD 0 NO-NODE a b)
                2 (n-new3 OP-ADD 0 NO-NODE a b)
                3 (n-new3 OP-ADD 0 NO-NODE a b)
                4 (n-new3 OP-MUL 0 NO-NODE a b)
                5 (n-new3 OP-DIV 0 NO-NODE a b)
                6 (n-new3 OP-MUL 0 NO-NODE a b)
                7 (n-new3 OP-DIV 0 NO-NODE a b)
                8 (n-new3 OP-DIV 0 NO-NODE a b)
                9 (n-new3 OP-DIV 0 NO-NODE a b)
                10 (n-new3 OP-SUB 0 NO-NODE a b)
                11 (n-new3 OP-MUL 0 NO-NODE a b)
                12 (n-new3 OP-SUB 0 NO-NODE b a)
                13 (n-new3 OP-DIV 0 NO-NODE a b)
                14 (n-new3 OP-EQ 0 NO-NODE a b)
                15 (n-new3 OP-EQ 0 NO-NODE a b)
                16 (n-new3 OP-LT 0 NO-NODE a b)
                17 (n-new3 OP-LT 0 NO-NODE a b)
                (n-new3 OP-ADD 0 NO-NODE a b))
        ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "matrix selection failed mode={d} be={d}@{d} ms={d}@{d}\n"
             mode (be-result) (be-result-node) (ms-result) (ms-result-item)) 2)
      (do (be-schedule!) (be-color! (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 8))
          (if (not (be-encode-checked!)) 3
            (if (not (be-macho-checked!)) 4
              (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 5)))))))
