(module typescriptnativeb08switchsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn run [(limit i64) (want i64) (optimize bool)] (-> i64)
  (let [source "function main(limit: number): number { let i=0; let out=0; outer: do { i++; switch(i) { default: out=out*10+8; case 3: out=out*10+3; break; case 1: out=out*10+1; continue outer; case 2: out=out*10+2; } out=out*10+9; if(i>=limit) break outer; } while(i<5); return out*10+i; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK)
        (do (fmt (stderr) "B08 switch index={d} code={d} node={d}\n" status
                 (load (field frontend error-code)) (load (field frontend error-node)))
            (fe-native-free! (mut frontend)) 2)
        (let [arg (frontend-native-build-mode! (mut frontend)
                    (+ (+ 8100 limit) (if optimize 100 0)) optimize true)]
          (ev-reset!)
          (ev-bind! arg (RInt limit))
          (let [run-status (ev-run-nobind 1000000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) -1)]
            (fmt (stdout) "limit={d} status={d} at={d} answer={d}\n" limit run-status (ev-at) answer)
            (fe-native-free! (mut frontend))
            (if (and (= run-status EV-OK) (= answer want)) 0 3))))))

(defn main [] (-> i64)
  (+ (+ (run 2 1292 false) (run 3 129393 false))
     (+ (run 2 1292 true) (run 3 129393 true))))
