(module typescriptnativeb13stringsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn run [(optimize bool)] (-> i64)
  (let [source
          "function main(){let a='co';let b='il';let c=a+b;let p=parseInt;let s=String;let n=isNaN;let hex=255;return c==='coil'?c.length+c.charCodeAt(1)+c.substring(1,3).length+c.substr(-2,1).length+c.slice(-3,-1).length+c.charAt(9).length+p('1f',16)+p(7)+p(7/2)+s(-42).length+s(true).length+s(null).length+s(undefined).length+s(NaN).length+s(1/2).length+String.fromCharCode(65,9786).length+hex.toString(16).length+(n(undefined)?1:0)+(n(null)?1:0)+(n('12x')?1:0):0;}"
        (mut frontend) (fe-native-new source)
        indexed (fe-native-index! (mut frontend))]
    (if (!= indexed FE-OK)
        (do (fe-native-free! (mut frontend)) (- -9000 indexed))
        (do
          (frontend-native-build-mode! (mut frontend) 11310 optimize true)
          (ev-reset!)
          (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 100000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (fe-native-free! (mut frontend))
            answer)))))

(defn main [] (-> i64)
  (let [raw (run false)
        optimized (run true)]
    (if (and (= raw 193) (= optimized 193))
        0
        (do (fmt (stderr) "B13 string smoke raw={d} optimized={d}\n" raw optimized) 3))))
