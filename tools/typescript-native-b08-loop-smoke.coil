(module typescriptnativeb08loopsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source "function main(limit: number): number { let out=0; outer: for(let j=0;j<limit;j++){ if(j===1) continue outer; out=out*10+j; if(j===3) break outer; } let i=0; while(i<2){ i++; if(i===1) continue; out=out*10+i; } return out; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK)
        (do (fmt (stderr) "B08 loops index={d} code={d} node={d}\n" status
                 (load (field frontend error-code)) (load (field frontend error-node)))
            (fe-native-free! (mut frontend)) 2)
        (let [arg (frontend-native-build-mode! (mut frontend) 8002 false true)]
          (ev-reset!)
          (ev-bind! arg (RInt 6))
          (let [run-status (ev-run-nobind 100000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) -1)]
            (fmt (stdout) "status={d} answer={d}\n" run-status answer)
            (fe-native-free! (mut frontend))
            (if (and (= run-status EV-OK) (= answer 232)) 0 3))))))
