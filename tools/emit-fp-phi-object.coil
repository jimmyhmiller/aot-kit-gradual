(module emitfpphiobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1508)
  (let [a (n-new1 OP-ARG (t-flt) (g-start)) b (n-new1 OP-ARG (t-flt) (g-start))
        pred (n-new3 OP-LT 0 NO-NODE a b)
        arms (n-if-arms! (n-new2 OP-IF 0 (g-start) pred))
        join (n-new OP-REGION 0)]
    (n-add-def! join NO-NODE) (n-add-def! join (arms-t arms)) (n-add-def! join (arms-f arms))
    (let [phi (n-new OP-PHI (t-flt))]
      (n-add-def! phi join) (n-add-def! phi a) (n-add-def! phi b)
      (n-add-def! (g-stop) (n-new2 OP-RETURN 0 join phi))
      (g-analyze!)
      (if (not (be-select-machine-program!)) 2
        (do (be-schedule!)
            (if (< (be-color! (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)) 0) 3
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
