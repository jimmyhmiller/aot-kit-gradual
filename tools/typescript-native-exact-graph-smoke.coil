(module typescriptnativeexactgraphsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "type Box = { value: number }; function Box(value: number): Box { return { value: value }; } function adjust(box: Box, n: number): number { let x = 0; if (box.value < 0) { x = x + 1; } else { x = x + 2; } for (let i = 0; i < n; i = i + 1) { x += 1; } return x; } function main(n: number): number { let box = new Box(n); return adjust(box, n); }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 32768))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do
          (frontend-native-build! (mut frontend) 6101 true)
          (ps (stdout) (g-render (cast (ptr i8) buffer) 32768))
          (fe-native-free! (mut frontend))
          0))))
