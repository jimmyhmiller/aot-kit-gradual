;; Run ONE JavaScript file through the same two oracles the fuzzer compares.
;;
;;   coil build tools/js-repro.coil -o out/js-repro
;;   out/js-repro repros/field-copy-stays-boxed.js 10
;;
;; The point is the build/run split. `coil test tests/js-source-prop.coil` is 26 seconds, and all
;; but a moment of that is compiling the compiler; a repro session spends it again on every file
;; and every argument. This binary pays it once, so trying a shape costs milliseconds and a
;; rebuild is only owed when the compiler itself changes.
;;
;; It prints node's answer and ours side by side and exits non-zero on a disagreement, so it also
;; works as the gate in a shell loop over `repros/`.
(module jsrepro)

(import "coil.alloc" :use * :as alloc)
(import "coil.args" :use *)
(import "coil.arraylist" :use *)
(import "coil.assert" :use *)
(import "coil.control" :use *)
(import "coil.fmt" :use *)
(import "coil.fs" :use *)
(import "coil.io" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "eval" :use *)
(import "jsstring" :use *)
(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)

;; The property caps a case at 100k steps so one slow case cannot stall a search. A repro is run
;; deliberately, one at a time, and several in `repros/` are whole NavierStokes kernels -- a cap
;; that small reports "step budget exhausted" for a program that is merely large.
(const REPRO-BUDGET i64 2000000000)

(extern popen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern fgets :cc c [(ptr i8) i32 (ptr u8)] (-> (ptr i8)))
(extern atoll :cc c [(ptr i8)] (-> i64))

;; ONE PERSISTENT NODE, over a pipe -- see native/js-oracle/oracle.c for the protocol and for why
;; it is posix_spawn rather than fork. The driver used to write each case to a file and run `node`
;; on it, which is correct but costs a process startup (63 ms) per trial; this costs 0.076 ms, and
;; the sweeper in tools/js-sweep.coil could not exist at the old price.
;;
;; It also removes the last quoting question. The old path had already moved off `node -e '...'`
;; because an apostrophe in a repro comment closed the shell quoting; a length-prefixed pipe has no
;; escaping at all, so no program can be misread however it is written.
(extern js_oracle_run :cc c [(ptr i8) i64 i64 (ptr i8) i64] (-> i32))
(extern js_oracle_shutdown :cc c [] (-> i64))

(defn node-answer [(source (slice u8)) (arg i64)] (-> i64)
  (let [out (alloc/stack (array i8 4096))]
    (if (!= [i64]
            (cast i64
                  (js_oracle_run (cast (ptr i8) (slice-data source))
                                 (slice-len source)
                                 arg
                                 (cast (ptr i8) out)
                                 4096))
            0)
        (do (ps (stderr) "the node oracle could not be reached (is `node` on PATH?)\n") (abort) 0)
        0)
    ;; "ERR ..." is node refusing the program, which for a repro is a fact about the repro.
    (if (and (= (cast i64 (load (index (cast (ptr i8) out) 0))) 69)
             (= (cast i64 (load (index (cast (ptr i8) out) 1))) 82))
        (do
          (ps (stderr) "node rejected the program: ")
          (print-cstr (stderr) (cast (ptr i8) out))
          (ps (stderr) "\n")
          (abort)
          0)
        0)
    (atoll (cast (ptr i8) out))))

(defn find-arg-node [] (-> i64)
  (let [n (n-count)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (and (not (n-dead? (load i))) (op-is? (load i) Arg [_]))
                         (not (ty-mem? (n-arg-type (load i)))))
                    (do (store! found (load i)) 0)
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

;; The frontend builds, the verifier judges, the evaluator runs -- in that order, so a repro that
;; dies tells you WHICH of the three rejected it rather than only that something did.
(defn our-answer [(source (slice u8)) (arg i64)] (-> i64)
  (graph-reset! 4242)
  (shape-reset!)
  (jss-reset!)
  (let [(mut fe) (fe-native-new source)]
    ;; NAME THE REFUSAL. This said only "the source did not index", which is the least useful half
    ;; of what the frontend already knows: it records a status, a reason code and the offending AST
    ;; node, and `fe-error-text` resolves that back to source.
    (if (!= (fe-native-index! (mut fe)) FE-OK)
        (do
          (fmt (stderr)
               "frontend refused ({s}/{s}): {s}\n"
               (fe-status-name (load (field fe status)))
               (fe-code-name (load (field fe error-code)))
               (fe-error-text (mut fe)))
          (abort)
          0)
        0)
    (frontend-native-build! (mut fe) 6201 true)
    (fe-native-free! (mut fe)))
  ;; `g-verify` records its verdict rather than printing it, and `g-verify-print` is what turns
  ;; that into the VERR line naming the node. Without it the driver could only say "not well
  ;; formed", which is the least useful half of what the verifier already knows.
  (if (!= [i64] (g-verify) 0)
      (do
        (ps (stderr) "verify: ")
        (g-verify-print (stderr))
        (ps (stderr) "\n")
        (g-print-flat (stderr))
        (abort)
        0)
      0)
  (ev-reset!)
  (ev-bind-args! arg)
  (let [a (find-arg-node)]
    (if (!= a NO-NODE) (do (ev-bind! a (RInt arg)) 0) 0))
  (let [status (ev-run-nobind REPRO-BUDGET)]
    (if (= status EV-OK)
        0
        (do
          (ps (stderr) "evaluator stopped: ")
          (ps (stderr) (ev-status-name status))
          ;; The node it stopped AT. Without it the message says which rule broke and leaves
          ;; finding where to a full read of the graph.
          (fmt (stderr) " at n{d}\n" (ev-at))
          (g-print-flat (stderr))
          (abort)
          0)))
  ;; A JavaScript number is a double, so a repro whose answer happens to be integral may still come
  ;; back as RT-FLT -- `return readX(p) * 4` on a field holding 2.5 is exactly 10 and node prints
  ;; "10". Rejecting that would report a correct program as a driver failure, which is the one
  ;; thing a differential tool must never do. A float with a fractional part is a real mismatch
  ;; against `atoll`'s reading of node, so it stays loud.
  (if (args-has? "--tag")
      (do (fmt (stderr) "result tag={d} (RT-INT={d} RT-FLT={d})\n"
               (rt-tag (ev-result)) RT-INT RT-FLT) 0)
      0)
  (cond (= (rt-tag (ev-result)) RT-INT) (rt-payload (ev-result))
        (= (rt-tag (ev-result)) RT-FLT)
          (let [value (bits-f64 (rt-payload (ev-result)))
                as-int (cast i64 value)]
            (if (= (f64-bits (cast f64 as-int)) (rt-payload (ev-result)))
                as-int
                (do
                  (ps (stderr) "evaluator returned a non-integral number; compare it by hand\n")
                  (abort)
                  0)))
        :else (do (ps (stderr) "evaluator returned neither a number nor an integer\n") (abort) 0)))

;; A positional integer, not a named flag -- `args-int` only reads `--name value`.
(defn arg-at [(i i64) (dflt i64)] (-> i64)
  (if (< (args-count) (+ i 1))
      dflt
      (let [s (args-nth i)
            buf (alloc/stack (array i8 32))
            n (if (> (slice-len s) 31) 31 (slice-len s))
            (mut j) 0]
        (loop (if (>= (load j) n)
                  (break)
                  (do
                    (store! (index (cast (ptr i8) buf) (load j))
                            (cast i8 (slice-get s (load j))))
                    (store! j (+ (load j) 1))
                    0)))
        (store! (index (cast (ptr i8) buf) n) (cast i8 0))
        (atoll (cast (ptr i8) buf)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (if (< (args-count) 2)
      (do (ps (stderr) "usage: js-repro FILE.js [ARG]\n") 1)
      (let [path (args-nth 1)
            arg (arg-at 2 10)
            a (malloc-allocator)]
        (match (read-file a path)
          (Err [_] (do (fmt (stderr) "cannot read {s}\n" path) 1))
          (Ok [source]
              (let [w (stdout)
                    theirs (node-answer source arg)
                    ours (our-answer source arg)]
                (fmt w "node={d} ours={d} arg={d}  {s}\n" theirs ours arg path)
                ;; A DISAGREEMENT DESERVES THE GRAPH TOO. A build that aborts prints one; a build
                ;; that merely computes the wrong answer printed two numbers and nothing to work
                ;; with -- the harder case, and the one that needs it more. `--dump` also prints on
                ;; success, for comparing a passing shape against a failing one.
                (if (or (args-has? "--dump") (!= theirs ours)) (g-print-flat w) 0)
                (if (= theirs ours) 0 (do (ps w "DISAGREE\n") 1))))))))
