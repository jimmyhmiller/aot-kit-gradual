(module typescriptnativeobjectgraphsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "type Box = { value: number }; function Box(value: number): Box { return { value: value }; } function main(n: number): number { let box: Box = new Box(n); return box.value; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 32768))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do
          (frontend-native-build! (mut frontend) 6204 true)
          (ps (stdout) (g-render (cast (ptr i8) buffer) 32768))
          (fe-native-free! (mut frontend))
          0))))
