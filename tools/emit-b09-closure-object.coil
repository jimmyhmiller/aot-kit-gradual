(module emitb09closureobject)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [regs (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)
        capture-by-value (and (> argc 2) (!= (atoi (load (index argv 2))) (cast i32 0)))
        seed (if (> argc 3) (cast i64 (atoi (load (index argv 3)))) 9400)
        source "function main(limit:number):number { let x=1; let add=function(amount:number):number { x+=amount; return x; }; let multiply=function(amount:number):number { x*=amount; return x; }; let y=0; let touch=function():number { y+=1; return y; }; let factorial=function self(n:number):number { if(n<=1)return 1; return n*self(n-1); }; return add(limit)*100000+multiply(3)*100+factorial(5)+touch()-1; }"
        (mut frontend) (fe-native-new source)]
    (store! (fng-capture-by-value-ptr) capture-by-value)
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do (frontend-native-build! (mut frontend) seed false)
            (fe-native-free! (mut frontend))
            (if (not (be-select-machine-program!))
              (do (fmt (stderr) "B09 selection failed be={d}@{d} ms={d}@{d} verify={d}@{d} mcfg={d}@{d}\n"
                    (be-result) (be-result-node) (ms-result) (ms-result-item)
                    (g-verify-code) (g-verify-node)
                    (mu-verify-result) (mu-verify-item))
                  3)
              (do (be-use-runtime-allocation! true)
                  (be-schedule!)
                  (if (< (be-color! regs) 0)
                    4
                    (if (not (be-encode-checked!)) 5
                      (if (not (be-macho-checked!)) 6
                        (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 7))))))))))
