;; Emit a Mach-O object for a program that CALLS a JSL library definition.
;;
;; WHY THIS EXISTS. Every JSL test so far ran the lowered graph through `eval.coil`, the IR
;; interpreter. That proves the graph computes the right values; it does not prove the graph is one
;; the BACKEND can compile. This tool takes the same lowered graph through selection, scheduling,
;; register allocation, AArch64 encoding and Mach-O emission, so the claim "one definition serves
;; both execution modes" is settled by a linked binary rather than asserted.
;;
;; The emitted symbol is `kernel`.
;;
;;   emit-jsl-object ENTRY [ARITY] [REGISTERS]
;;
;; EVERY PARAMETER IS `dyn`. A JSL builtin takes NaN-boxed JavaScript values; declaring them as raw
;; integers compiles, links, runs and answers nonsense — `MathAbs` on a boxed -5 returned -5,
;; because a boxed integer is a large positive word and `x < 0` was false.
(module emitjslobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "jsl" :use *)
(import "jsl_lower" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.str" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))
(extern strlen :cc c [(ptr i8)] (-> i64))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< argc 2) (do (fmt (stderr) "usage: emit-jsl-object ENTRY [ARITY] [REGS]
") 1)
    (let [raw (load (index argv 1))
          entry (slice-new [u8] (cast (ptr u8) raw) (strlen raw))
          arity (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 1)
          regs (if (> argc 3) (cast i64 (atoi (load (index argv 3)))) 8)]
      (graph-reset! 9600)
      (shape-reset!)
      (jss-reset!)
      (jsl-reset!)
      (if (!= (jsl-load-index! "lib/index") JSL-OK)
          (do (fmt (stderr) "jsl load failed: {s}
" (jsl-err-name (jsl-err))) 7)
        ;; Probe definitions live outside `lib/` so test scaffolding never ships in the library,
        ;; but they have to be read and checked WITH it to be callable.
        (if (!= (jsl-read-file! "tools/jsl-native-probes.jsl") JSL-OK)
            (do (fmt (stderr) "probe read failed: {s} at {s}\n"
                     (jsl-err-name (jsl-err)) (jsl-where)) 9)
        (if (!= (jsl-check) JSL-OK)
            (do (fmt (stderr) "probe check failed: {s} at {s}\n"
                     (jsl-err-name (jsl-err)) (jsl-where)) 10)
        (if (!= (jsl-lower!) JSL-OK)
            (do (fmt (stderr) "jsl lower failed: {s} at {s}
"
                     (jsl-err-name (jsl-err)) (jsl-where)) 8)
          (let [buf (stack (array i64 4))
                p (cast (ptr i64) buf)
                (mut i) 0]
            (loop (if (>= (load i) arity) (break)
                    (do (store! (index p (load i)) (n-new1 OP-ARG (t-dyn) (g-start)))
                        (store! i (+ (load i) 1))
                        0)))
            (let [cs (jsl-call! (g-start) entry (slice-new [i64] p arity))]
              (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (call-end cs) (call-value cs)))
              (iterate!)
              (g-analyze!)
              (if (not (be-select-machine-program!))
                  (do (fmt (stderr)
                           "JSL selection failed entry={s} gv={d}:{d}@{d} be={d}@{d} ms={d}@{d}
"
                           entry (g-verify) (g-verify-code) (g-verify-node)
                           (be-result) (be-result-node) (ms-result) (ms-result-item))
                      2)
                (do (be-schedule!)
                    (if (< (be-color! regs) 0) 3
                      (if (not (be-encode-checked!)) 4
                        (if (not (be-macho-checked!)) 5
                          (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len))
                              0 6)))))))))))))))
