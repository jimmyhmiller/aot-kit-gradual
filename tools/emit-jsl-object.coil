;; Emit a Mach-O object for a program that CALLS a JSL library definition.
;;
;; WHY THIS EXISTS. Every JSL test so far ran the lowered graph through `eval.coil`, the IR
;; interpreter. That proves the graph computes the right values; it does not prove the graph is one
;; the BACKEND can compile. This tool takes the same lowered graph through selection, scheduling,
;; register allocation, AArch64 encoding and Mach-O emission, so the claim "one definition serves
;; both execution modes" is settled by a linked binary rather than asserted.
;;
;; The emitted symbol is `kernel`, taking one integer argument, matching the harness convention the
;; other `emit-*` tools use.
(module emitjslobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "jsl" :use *)
(import "jsl_lower" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.str" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

;; Which library definition to call, chosen by argv[1] so one tool covers several shapes: a pure
;; arithmetic builtin, one that calls another builtin, and one that loops.
(defn jsl-entry-name [(mode i64)] (-> (slice u8))
  (case mode
        0 "MathAbs"
        1 "MathSign"
        2 "NumberIsFinite"
        3 "MathFloor"
        "MathAbs"))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        regs (if (> argc 2) (cast i64 (atoi (load (index argv 2)))) 8)]
    (graph-reset! 9600)
    (shape-reset!)
    (jss-reset!)
    (jsl-reset!)
    (if (!= (jsl-load-index! "lib/index") JSL-OK)
        (do (fmt (stderr) "jsl load failed: {s}\n" (jsl-err-name (jsl-err))) 7)
      (if (!= (jsl-lower!) JSL-OK)
          (do (fmt (stderr) "jsl lower failed: {s}\n" (jsl-err-name (jsl-err))) 8)
        (let [buf (stack (array i64 1))
              p (cast (ptr i64) buf)]
          (store! (index p 0) (n-new1 OP-ARG (t-int) (g-start)))
          (let [cs (jsl-call! (g-start) (jsl-entry-name mode) (slice-new [i64] p 1))]
            (n-add-def! (g-stop)
                        (n-new2 OP-RETURN 0 (call-end cs) (call-value cs)))
            (iterate!)
            (g-analyze!)
            (if (not (be-select-machine-program!))
                (do (fmt (stderr)
                         "JSL selection failed mode={d} gv={d}:{d}@{d} be={d}@{d} ms={d}@{d}\n"
                         mode (g-verify) (g-verify-code) (g-verify-node)
                         (be-result) (be-result-node) (ms-result) (ms-result-item))
                    2)
              (do (be-schedule!)
                  (if (< (be-color! regs) 0) 3
                    (if (not (be-encode-checked!)) 4
                      (if (not (be-macho-checked!)) 5
                        (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len))
                            0 6))))))))))))
