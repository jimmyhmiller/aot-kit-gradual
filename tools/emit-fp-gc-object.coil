(module emitfpgcobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.alloc" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))

(defn main [] (-> i64)
  (graph-reset! 1509) (shape-reset!)
  (let [value (n-new1 OP-ARG (t-flt) (g-start))
        sx (shape-transition SHAPE-ROOT "x" (t-int)) ax (shape-field-alias sx 0)
          mem-in (n-new1 OP-ARG (t-mem-alias ax (t-undef)) (g-start))
          alloc (n-new-obj1! (g-start) sx mem-in)
          obj (n-obj-ptr alloc)
          one (n-new1 OP-CONST (t-int-con 1) (g-start))
          mem (n-new4 OP-STORE ax NO-NODE (n-obj-mem alloc 0) obj one)
          three (n-new1 OP-CONST (t-flt-con 3.0) (g-start))
          result (n-new3 OP-ADD 0 NO-NODE value three)
          ret (n-new3 OP-RETURN 0 (g-start) result mem)]
      (n-add-def! (g-stop) ret)
      (g-analyze!)
      (if (not (be-select-machine-program!)) 2
        (do (be-use-runtime-allocation! true) (be-schedule!)
            (if (< (be-color! 10) 0) 3
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
