(module b06idealmatrix)

(import "ty" :use *)
(import "node" :use *)
(import "eval" :use *)
(import "jsvalue" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern atoi :cc c [(ptr i8)] (-> i32))

(const BUDGET i64 10000)

(defn value-node [(value RtVal)] (-> i64)
  (match value
    (RInt [n] (n-new1 OP-CONST (t-int-con n) (g-start)))
    (RFlt [bits] (n-new1 OP-CONST (t-flt-bits bits) (g-start)))
    (RUndef [] NO-NODE) (RNull [] NO-NODE) (RBool [b] NO-NODE)
    (RObj [id] NO-NODE) (RStr [id] NO-NODE) (RSym [id] NO-NODE)
    (RBig [n] NO-NODE) (RFun [f] NO-NODE) (RMem [ver] NO-NODE)))

(defn run-bin [(op i64) (left RtVal) (right RtVal) (optimized bool)] (-> RtVal)
  (graph-reset! 1607)
  (let [a (if optimized (value-node left) (n-new1 OP-ARG (t-num) (g-start)))
        b (if optimized (value-node right) (n-new1 OP-ARG (t-num) (g-start)))
        raw (n-new3 op 0 NO-NODE a b)
        value (if optimized (n-peephole raw) raw)]
    (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (g-start) value))
    (g-analyze!) (ev-reset!)
    (if (not optimized) (do (ev-bind! a left) (ev-bind! b right)) 0)
    (if (= (ev-run-nobind BUDGET) EV-OK) (ev-result) (RUndef))))

(defn run-not [(input RtVal) (optimized bool)] (-> RtVal)
  (graph-reset! 1608)
  (let [a (if optimized (value-node input) (n-new1 OP-ARG (t-num) (g-start)))
        raw (n-new2 OP-BITNOT 0 NO-NODE a)
        value (if optimized (n-peephole raw) raw)]
    (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (g-start) value))
    (g-analyze!) (ev-reset!)
    (if (not optimized) (ev-bind! a input) 0)
    (if (= (ev-run-nobind BUDGET) EV-OK) (ev-result) (RUndef))))

(defn emit-int [(name (slice u8)) (value RtVal)] (-> i64)
  (match value
    (RInt [n] (do (fmt (stdout) "{s}|int|{d}\n" name n) 0))
    (RFlt [bits] (do (fmt (stdout) "{s}|int|{d}\n" name (cast i64 (bits-f64 bits))) 0))
    (RUndef [] 2) (RNull [] 2) (RBool [b] 2) (RObj [id] 2) (RStr [id] 2)
    (RSym [id] 2) (RBig [n] 2) (RFun [f] 2) (RMem [ver] 2)))

(defn emit-number [(name (slice u8)) (value RtVal)] (-> i64)
  (match value
    (RInt [n] (do (fmt (stdout) "{s}|number|{d}\n" name (f64-bits (cast f64 n))) 0))
    (RFlt [bits]
      (let [canonical (if (f64-nan-bits? bits) JSV-NAN bits)]
        (if (= canonical JSV-NEGATIVE-ZERO)
            (do (fmt (stdout) "{s}|number|-9223372036854775808\n" name) 0)
          (do (fmt (stdout) "{s}|number|{d}\n" name canonical) 0))))
    (RUndef [] 2) (RNull [] 2) (RBool [b] 2) (RObj [id] 2) (RStr [id] 2)
    (RSym [id] 2) (RBig [n] 2) (RFun [f] 2) (RMem [ver] 2)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [optimized (and (> argc 1) (!= (cast i64 (atoi (load (index argv 1)))) 0))]
    (emit-int "to-int32-nan" (run-bin OP-BITOR (RFlt JSV-NAN) (RInt 0) optimized))
    (emit-int "to-int32-infinity" (run-bin OP-BITOR (RFlt 9218868437227405312) (RInt 0) optimized))
    (emit-int "to-int32-negative-zero" (run-bin OP-BITOR (RFlt JSV-NEGATIVE-ZERO) (RInt 0) optimized))
    (emit-int "to-int32-fraction" (run-bin OP-BITOR (RFlt (f64-bits -3.9)) (RInt 0) optimized))
    (emit-int "to-int32-sign" (run-bin OP-BITOR (RFlt (f64-bits 2147483648.0)) (RInt 0) optimized))
    (emit-int "to-int32-wrap" (run-bin OP-BITOR (RFlt (f64-bits 4294967297.75)) (RInt 0) optimized))
    (emit-int "to-uint32-negative-one" (run-bin OP-USHR (RInt -1) (RInt 0) optimized))
    (emit-int "bit-and" (run-bin OP-BITAND (RInt -1) (RInt 252645135) optimized))
    (emit-int "bit-or" (run-bin OP-BITOR (RFlt (f64-bits 2147483648.0)) (RInt 1) optimized))
    (emit-int "bit-xor" (run-bin OP-BITXOR (RInt -1) (RInt 4294967295) optimized))
    (emit-int "bit-not" (run-not (RInt 0) optimized))
    (emit-int "shift-left-mask" (run-bin OP-SHL (RInt 1) (RInt 33) optimized))
    (emit-int "shift-right-mask" (run-bin OP-SHR (RInt -1) (RInt 65) optimized))
    (emit-int "unsigned-right-zero" (run-bin OP-USHR (RInt -1) (RInt 0) optimized))
    (emit-int "unsigned-right-one" (run-bin OP-USHR (RInt -2147483648) (RInt 1) optimized))
    (emit-number "remainder-negative-zero" (run-bin OP-MOD (RInt -4) (RInt 2) optimized))
    (emit-number "remainder-fraction" (run-bin OP-MOD (RFlt (f64-bits 5.5)) (RInt 2) optimized))
    (emit-number "remainder-zero-divisor" (run-bin OP-MOD (RInt 1) (RInt 0) optimized))
    (emit-number "remainder-infinite-dividend" (run-bin OP-MOD (RFlt 9218868437227405312) (RInt 2) optimized))
    (emit-number "remainder-infinite-divisor" (run-bin OP-MOD (RInt 7) (RFlt 9218868437227405312) optimized))
    0))
