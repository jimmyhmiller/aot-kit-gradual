(module test262native)

(import "coil.primitive" :as primitive)
(import "nativeharness" :use *)
(import "frontendnative" :use *)
(import "frontendnativegraph" :use [frontend-native-reuse-jsl-index!])
(import "backend_core" :use [be-use-profiling! be-profiling?])
(import "typescriptnative" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.args" :use *)
(import "coil.fmt" :use *)
(import "coil.fs" :use *)
(import "coil.io" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)

(extern fdopen :cc c [i32 (ptr i8)] (-> (ptr u8)))
(extern fgets :cc c [(ptr i8) i32 (ptr u8)] (-> (ptr i8)))
(extern fflush :cc c [(ptr u8)] (-> i32))

(defn t262-native-parse-negative [(path (slice u8))] (-> i64)
  (let [a (malloc-allocator)
        source (t262-native-read a path)]
    (if (= (slice-len source) 0)
        (do (fmt (stderr) "test262-native: cannot read empty parse-negative source\n") 66)
        (let [(mut ast) (ts-open-file source path TS-SCRIPT-JS)
              rejected (> (ts-diagnostic-count ast) 0)]
          (ts-close! (mut ast))
          (if rejected
              (do (fmt (stdout) "PASS\n") 0)
              (do (fmt (stdout) "RUNTIME-FAILED 0\n") 1))))))

(defn t262-native-server [] (-> i64)
  (let [input (fdopen 0 (cast (ptr i8) (slice-data "r")))
        buffer (primitive/alloc-stack (array i8 4096))
        (mut index) 0]
    (loop
      (let [line (fgets (cast (ptr i8) buffer) 4096 input)]
        (if (= (cast i64 line) 0)
            (break)
            (let [(mut length) 0]
              (loop (if (or (>= (load length) 4095)
                            (= (load (index (cast (ptr i8) buffer) (load length))) (cast i8 0)))
                        (break)
                        (set! length (+ (load length) 1))))
              (loop (if (or (<= (load length) 0)
                            (and (!= (load (index (cast (ptr i8) buffer) (- (load length) 1)))
                                      (cast i8 10))
                                 (!= (load (index (cast (ptr i8) buffer) (- (load length) 1)))
                                      (cast i8 13))))
                        (break)
                        (set! length (- (load length) 1))))
              (if (> (load length) 0)
                  (do
                    (fmt (stderr) "AOTK_CASE_BEGIN index={d}\n" (load index))
                    (let [parse-negative (= (load (index (cast (ptr i8) buffer) 0))
                                             (cast i8 33))
                          path (slice-new [u8]
                                          (cast (ptr u8)
                                                (if parse-negative
                                                    (+ (cast i64 buffer) 1)
                                                    (cast i64 buffer)))
                                          (- (load length) (if parse-negative 1 0)))
                          status (if parse-negative
                                     (t262-native-parse-negative path)
                                     (t262-native-one path))]
                      ;; stdout ordering guarantees the result line above is visible before this
                      ;; completion marker even though diagnostics use a separate stderr pipe.
                      (fmt (stdout) "AOTK_CASE_END index={d} status={d}\n"
                           (load index) (if (= status 0) 0 1))
                      (fflush (cast (ptr u8) 0)))
                    (set! index (+ (load index) 1))
                    0)
                  0))))
    0)))

(defn t262-native-read [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (try (try-or! (read-file a path) "")))

(defn t262-native-one [(path (slice u8))] (-> i64)
  (block :done
    (fmt (stderr) "AOTK_READY ns={d}\n" (nh-now-ns))
    (let [a (malloc-allocator)
          source (t262-native-read a path)]
      (if (= (slice-len source) 0)
          (return-from :done
                       (do (fmt (stderr) "test262-native: cannot read empty source\n") 66))
          0)
      (if (not (nh-try-compile? source))
          (do (fmt (stdout) "REFUSED\n") 2)
          (if (!= (nh-link!) 0)
              (do (fmt (stdout) "LINK-FAILED\n") 3)
              (let [ok (primitive/alloc-stack bool)
                    exec-start (nh-now-ns)
                    answer (do (set! ok true) (nh-exec-checked-timeout! 0 2 ok))
                    _ (nh-timing! "native_execution" exec-start)
                    cleanup-start (nh-now-ns)
                    _ (nh-cleanup!)
                    _ (nh-timing! "native_cleanup" cleanup-start)]
                (if (load ok)
                    (do (fmt (stdout) "PASS\n") 0)
                    (do (fmt (stdout) "RUNTIME-FAILED {d}\n" answer) 1))))))))

(defn t262-native-batch [(path (slice u8)) (count i64)] (-> i64)
  (block :done
    (fmt (stderr) "AOTK_READY ns={d}\n" (nh-now-ns))
    (let [a (malloc-allocator)
          source (t262-native-read a path)]
      (if (= (slice-len source) 0)
          (return-from :done
                       (do (fmt (stderr) "test262-native: cannot read empty source\n") 66))
          0)
      (if (not (nh-try-compile? source))
          (do (fmt (stdout) "REFUSED\n") 2)
          (if (!= (nh-link!) 0)
              (do (fmt (stdout) "LINK-FAILED\n") 3)
              (let [(mut index) 0]
                (loop (if (>= (load index) count)
                          (break)
                          (let [ok (primitive/alloc-stack bool)
                                exec-start (nh-now-ns)
                                answer (do (fmt (stderr) "AOTK_BATCH_EXEC index={d}\n" (load index))
                                           (set! ok true)
                                           (nh-exec-checked-timeout! (load index) 2 ok))
                                _ (nh-timing! "native_execution" exec-start)]
                            (if (load ok)
                                (fmt (stdout) "BATCH {d} PASS\n" (load index))
                                (fmt (stdout) "BATCH {d} RUNTIME-FAILED {d}\n"
                                     (load index) answer))
                            (set! index (+ (load index) 1)))))
                (let [cleanup-start (nh-now-ns)]
                  (nh-cleanup!)
                  (nh-timing! "native_cleanup" cleanup-start))
                0))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (block :done
    (args-set! argc argv)
    (frontend-native-reuse-jsl-index! true)
    ;; The bounded/native test suites leave exhaustive graph verification enabled by default.
    ;; Test262 is the production-throughput corpus and does not pay for that debug pass.
    (nh-use-graph-verification! false)
    (let [profile (and (> (args-count) 1) (= (args-nth 1) "--profile"))
          first (if profile 2 1)]
    (be-use-profiling! profile)
    (if (be-profiling?)
        (do (fmt (stderr) "AOTK_PROFILE enabled\n") 0)
        0)
    (if (< (args-count) (+ first 1))
        (return-from :done
                     (do (fmt (stderr) "usage: test262-native [--profile] <assembled-source.js>...\n") 64))
        0)
    (if (and (= (args-count) (+ first 1)) (= (args-nth first) "--server"))
        (return-from :done (t262-native-server))
        0)
    (if (= (args-count) (+ first 2))
        (return-from :done
                     (t262-native-batch
                       (args-nth first)
                       (atoll (cast (ptr i8) (slice-data (args-nth (+ first 1)))))))
        0)
    (let [(mut index) first (mut failed) false]
      (loop (if (>= (load index) (args-count))
                (break)
                (let [status (t262-native-one (args-nth (load index)))]
                  (if (!= status 0) (set! failed true) 0)
                  (set! index (+ (load index) 1)))))
      (if (load failed) 1 0)))))
