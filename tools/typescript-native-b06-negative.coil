(module typescriptnativeb06negative)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)

(defn main [] (-> i64)
  (let [(mut frontend)
          (fe-native-new "function main(value: number): number { return value ** 2; }")
        status (fe-native-index! (mut frontend))
        code (load (field frontend error-code))
        role (load (field frontend error-role))]
    (fe-native-free! (mut frontend))
    (if (and (= status FE-UNSUPPORTED)
             (and (= code FE-CODE-UNSUPPORTED-OPERATOR) (= role TS-ROLE-OPERATOR)))
        0 1)))
