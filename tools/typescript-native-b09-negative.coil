(module typescriptnativeb09negative)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn status-of [(source (slice u8))] (-> i64)
  (let [(mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (fe-native-free! (mut frontend))
    status))

(defn main [] (-> i64)
  (let [cross-target (status-of
          "function main(): number { while(1) { let f=function(): number { break; return 0; }; break; } return 0; }")
        leaked-name (status-of
          "function main(): number { let f=function self(n: number): number { return n; }; return self(1); }")
        exact (and (= cross-target FE-TARGET) (= leaked-name FE-UNBOUND))]
    (fmt (stdout) "cross-target={d} leaked-name={d}\n" cross-target leaked-name)
    (if exact 0 2)))
