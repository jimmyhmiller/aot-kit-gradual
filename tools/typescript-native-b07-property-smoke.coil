(module typescriptnativeb07propertysmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source
          "type Box = { value: number; count: number }; function Box(value: number, count: number): Box { return { value: value, count: count }; } function touch(box: Box): Box { box.count += 1; return box; } function main(): number { let box = new Box(3, 0); let old = touch(box).value++; return old * 100 + box.value * 10 + box.count; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 65536))
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK)
        (do (fmt (stderr) "B07 property index={d} code={d} node={d}\n"
                 status (load (field frontend error-code)) (load (field frontend error-node)))
            (fe-native-free! (mut frontend)) 2)
      (do (frontend-native-build-mode! (mut frontend) 6209 false true)
          (ps (stdout) (g-render (cast (ptr i8) buffer) 65536))
          (ev-reset!)
          (let [run-status (ev-run-nobind 1000000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) -1)]
            (fmt (stderr) "B07 property eval={d} answer={d}\n" run-status answer)
            (fe-native-free! (mut frontend))
            (if (and (= run-status EV-OK) (= answer 341)) 0 3))))))
