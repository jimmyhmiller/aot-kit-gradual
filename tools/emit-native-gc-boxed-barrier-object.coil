(module emitnativegcboxedbarrierobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "jsvalue" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn zc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn zm [(a i64)] (-> i64) (n-new1 OP-ARG (t-mem-alias a (t-undef)) (g-start)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1305) (shape-reset!)
  (let [child-shape (shape-transition SHAPE-ROOT "value" (t-int))
        av (shape-field-alias child-shape 0)
        holder-shape (shape-transition SHAPE-ROOT "child" (t-dyn))
        ah (shape-field-alias holder-shape 0)
        holder-new (n-new-obj1! (g-start) holder-shape (zm ah))
        holder (n-obj-ptr holder-new)
        trigger1 (n-new-obj1! (g-start) holder-shape (n-obj-mem holder-new 0))
        trigger1-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger1 0)
                            (n-obj-ptr trigger1) (zc JSV-UNDEFINED))
        trigger2 (n-new-obj1! (g-start) holder-shape trigger1-mem)
        trigger2-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger2 0)
                            (n-obj-ptr trigger2) (zc JSV-NULL))
        child-new (n-new-obj1! (g-start) child-shape (zm av))
        child (n-obj-ptr child-new)
        child-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem child-new 0) child (zc 41))
        boxed-child (n-new2 OP-BOX 0 NO-NODE child)
        holder-mem (n-new4 OP-STORE ah NO-NODE trigger2-mem holder boxed-child)
        trigger3 (n-new-obj1! (g-start) holder-shape holder-mem)
        trigger3-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger3 0)
                            (n-obj-ptr trigger3) (zc JSV-UNDEFINED))
        moved-box (n-new3 OP-LOAD ah NO-NODE trigger3-mem holder)
        moved-child (n-new2 OP-UNBOX (t-obj-shape child-shape) NO-NODE moved-box)
        value (n-new3 OP-LOAD av NO-NODE child-mem moved-child)
        ret (n-new3 OP-RETURN 0 (g-start) value trigger3-mem)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "boxed barrier selection failed be={d} ms={d} item={d}\n"
               (be-result) (ms-result) (ms-result-item)) 2)
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 10) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
