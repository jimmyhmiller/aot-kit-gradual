(module typescriptnativeb09indexsmoke)

(import "frontendnative" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source "function main(limit:number):number { let x=1; let add=function(amount:number):number { x+=amount; return x; }; let multiply=function(amount:number):number { x*=amount; return x; }; let y=0; let touch=function():number { y+=1; return y; }; let factorial=function self(n:number):number { if(n<=1)return 1; return n*self(n-1); }; return add(limit)*100000+multiply(3)*100+factorial(5)+touch()-1; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (let [functions (al-len [FeFunction] (load (field frontend functions)))
          captures (al-len [FeCapture] (load (field frontend captures)))
          first (if (> captures 0) (al-get [FeCapture] (load (field frontend captures)) 0)
                                  (zeroed FeCapture))
          second (if (> captures 1) (al-get [FeCapture] (load (field frontend captures)) 1)
                                   (zeroed FeCapture))
          ok (and (= status FE-OK)
               (and (= functions 5)
                 (and (= captures 3)
                   (and (= (load (field first function)) 1)
                     (and (= (load (field second function)) 2)
                          (and (load (field first mutable)) (load (field second mutable))))))))]
      (fmt (stdout) "status={d} functions={d} captures={d} owners={d},{d} mutable={d},{d}\n"
        status functions captures (load (field first function)) (load (field second function))
        (if (load (field first mutable)) 1 0) (if (load (field second mutable)) 1 0))
      (fe-native-free! (mut frontend))
      (if ok 0 2))))
