(module emitnativegcboxedobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn xc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn xm [(a i64)] (-> i64) (n-new1 OP-ARG (t-mem-alias a (t-undef)) (g-start)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1303) (shape-reset!)
  (let [child-shape (shape-transition SHAPE-ROOT "value" (t-int))
        av (shape-field-alias child-shape 0)
        holder-shape (shape-transition SHAPE-ROOT "child" (t-dyn))
        ah (shape-field-alias holder-shape 0)
        child-new (n-new-obj1! (g-start) child-shape (xm av))
        child (n-obj-ptr child-new)
        child-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem child-new 0) child (xc 41))
        boxed-child (n-new2 OP-BOX 0 NO-NODE child)
        holder-new (n-new-obj1! (g-start) holder-shape (xm ah))
        holder (n-obj-ptr holder-new)
        holder-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem holder-new 0)
                           holder boxed-child)
        scratch-new (n-new-obj1! (g-start) child-shape child-mem)
        scratch (n-obj-ptr scratch-new)
        scratch-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem scratch-new 0) scratch (xc 7))
        trigger-new (n-new-obj1! (g-start) holder-shape holder-mem)
        trigger (n-obj-ptr trigger-new)
        trigger-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger-new 0)
                            trigger boxed-child)
        moved-box (n-new3 OP-LOAD ah NO-NODE trigger-mem holder)
        moved-child (n-new2 OP-UNBOX (t-obj-shape child-shape) NO-NODE moved-box)
        value (n-new3 OP-LOAD av NO-NODE child-mem moved-child)
        ret (n-new3 OP-RETURN 0 (g-start) value scratch-mem)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "boxed selection failed be={d} ms={d} item={d} gv={d}/{d}\n"
               (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 10) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
