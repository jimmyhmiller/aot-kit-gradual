(module typescriptnativeb11prototypeindexsmoke)

(import "frontendnative" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source "function Box(value) { this.value=value; } function bump(amount) { return this.value+amount; } Box.prototype.bump=bump; function main() { let box=new Box(40); return box.bump(2); }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))
        count (al-len [FePrototypeMethod] (load (field frontend prototype-methods)))
        method (if (> count 0) (al-get [FePrototypeMethod]
                  (load (field frontend prototype-methods)) 0) (zeroed FePrototypeMethod))]
    (fmt (stdout) "status={d} methods={d} constructor={d} target={d}\n"
      status count (load (field method constructor)) (load (field method target)))
    (fe-native-free! (mut frontend))
    (if (and (= status FE-OK) (and (= count 1)
             (and (= (load (field method constructor)) 0)
                  (= (load (field method target)) 1)))) 0 2)))
