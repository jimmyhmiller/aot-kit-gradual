(module typescriptnativeb11constructorsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)

(defn run [(optimize bool)] (-> i64)
  (let [source "function Box(value) { this.value=value; return 99; } function main() { let box=new Box(42); return box.value; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK) (do (fe-native-free! (mut frontend)) (- -9000 status))
      (do (frontend-native-build-mode! (mut frontend) 11120 optimize true)
          (ev-reset!) (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 1000000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (if (and (= (run false) 42) (= (run true) 42)) 0 3))
