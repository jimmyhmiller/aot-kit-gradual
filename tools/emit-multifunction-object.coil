(module emitmultifunctionobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.control" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn mc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn mb [(op i64) (a i64) (b i64)] (-> i64) (n-new3 op 0 NO-NODE a b))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1101)
  (let [inc (n-fun-open! 0) ix (n-parm! inc 0)
        inc-ret (n-new2 OP-RETURN 0 (n-fun-entry inc) (mb OP-ADD ix (mc 1)))
        twice (n-fun-open! 1) tx (n-parm! twice 0)
        twice-ret (n-new2 OP-RETURN 0 (n-fun-entry twice) (mb OP-MUL tx (mc 2)))]
    (n-fun-close! inc inc-ret)
    (n-fun-close! twice twice-ret)
    (let [first (n-call1! (g-start) inc (mc 20))
          second (n-call1! (call-end first) twice (call-value first))
          ret (n-new2 OP-RETURN 0 (call-end second) (call-value second))]
      (n-add-def! (g-stop) ret)
      (g-analyze!)
      (if (not (be-select-machine-program!)) 2
        (do (be-schedule!)
            (be-function-layout-seeded!
              (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0))
            (if (< (be-color! 10) 0) 3
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
