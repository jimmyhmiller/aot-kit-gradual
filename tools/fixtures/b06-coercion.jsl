;; B06's float-to-int32 coercion kernels, as SOURCE. Was `tools/emit-b06-coercion-object.coil`.
;;
;; The parameters are `flt`, which is the whole point: these prove a double operand reaches the
;; int32 operators through ToInt32 rather than being reinterpreted. `tools/b06-coercion-harness.c`
;; declares them as `double`. The gate also runs two of these under `--falsify`, which corrupts the
;; BACKEND after colouring — that is a flag on the emitter, not a property of this source.
(builtin B06CoerceBitNot :params [(a flt)]           :ret int (%BitNot a))
(builtin B06CoerceShl    :params [(a flt) (b flt)]   :ret int (%Shl  a b))
(builtin B06CoerceShr    :params [(a flt) (b flt)]   :ret int (%Shr  a b))
(builtin B06CoerceUshr   :params [(a flt) (b flt)]   :ret int (%Ushr a b))
(builtin B06CoerceMod    :params [(a flt) (b flt)]   :ret int (%Mod  a b))
