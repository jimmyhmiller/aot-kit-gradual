;; B06's int32 bitwise kernels, as SOURCE. These were `tools/emit-b06-int-object.coil`, thirty
;; lines of hand-built IR that linked the whole compiler to select between eight opcodes.
;;
;; The parameters are `int`, not `dyn`: this is the raw-ABI surface `tools/b06-int-harness.c`
;; declares as `int64_t kernel(int64_t, int64_t)`. Boxing them would test a different thing.
(builtin B06BitAnd :params [(a int) (b int)] :ret int (%BitAnd a b))
(builtin B06BitOr  :params [(a int) (b int)] :ret int (%BitOr  a b))
(builtin B06BitXor :params [(a int) (b int)] :ret int (%BitXor a b))
(builtin B06Shl    :params [(a int) (b int)] :ret int (%Shl    a b))
(builtin B06Shr    :params [(a int) (b int)] :ret int (%Shr    a b))
(builtin B06Ushr   :params [(a int) (b int)] :ret int (%Ushr   a b))
(builtin B06BitNot :params [(a int)]         :ret int (%BitNot a))
(builtin B06Mod    :params [(a int) (b int)] :ret int (%Mod    a b))
