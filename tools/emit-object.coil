;; THE emitter. One binary, built once, that reads its input at runtime.
;;
;; WHY THIS EXISTS. There were thirty-five `tools/emit-*-object.coil` programs. Each was a
;; thirty-line `main` that built one fixture graph and called the backend, and each one linked the
;; whole 41,500-line compiler into its own executable to do it — two seconds of `coil build` per
;; fixture, thirty-five times, to vary a few dozen lines of driver. Nobody rebuilds clang per `.c`
;; file. The fixture is INPUT, so it belongs in a file the emitter reads, not in source the emitter
;; is compiled from.
;;
;;   emit-object [--source PATH]... ENTRY [ARITY] [REGISTERS]
;;
;; `--source` is repeatable and is read AFTER `lib/index`, so a fixture may call the shipped
;; library. ENTRY is the JSL definition to compile; the emitted symbol is that name. The Mach-O
;; object goes to stdout.
;;
;; EVERY PARAMETER IS `dyn`. A JSL builtin takes NaN-boxed JavaScript values; declaring them as raw
;; integers compiles, links, runs and answers nonsense — `MathAbs` on a boxed -5 returned -5,
;; because a boxed integer is a large positive word and `x < 0` was false.
(module emitobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "jsl" :use *)
(import "jsl_lower" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "coil.control" :use *)
(import "coil.os" :as os)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))
(extern strlen :cc c [(ptr i8)] (-> i64))

;; A C string as a slice, so `str-eq` and the JSL reader can both take it.
(defn cstr [(raw (ptr i8))] (-> (slice u8))
  (slice-new [u8] (cast (ptr u8) raw) (strlen raw)))

(defn die [(msg (slice u8)) (detail (slice u8)) (code i64)] (-> i64)
  (fmt (stderr) "emit-object: {s}: {s} at {s}\n" msg detail (jsl-where))
  code)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< argc 2)
      (do (fmt (stderr) "usage: emit-object [--source PATH]... ENTRY [ARITY] [REGISTERS]\n") 1)
    (do
      (graph-reset! 9600)
      (shape-reset!)
      (jss-reset!)
      (jsl-reset!)
      (if (!= (jsl-load-index! "lib/index") JSL-OK)
          (die "jsl load failed" (jsl-err-name (jsl-err)) 7)
        ;; ONE PASS over argv. `lib/index` is already loaded, so a `--source` file can be read the
        ;; moment it is seen and may reference the library; positionals accumulate around them.
        ;; Fixture sources live outside `lib/` so test scaffolding never ships in the library, but
        ;; they have to be read and checked WITH it to be callable.
        (let [(mut ai) 1
              (mut np) 0
              (mut entry) (slice-new [u8] (cast (ptr u8) 0) 0)
              (mut arity) 1
              (mut regs) 8
              (mut rc) 0]
          (loop
            (if (or (>= (load ai) (cast i64 argc)) (!= (load rc) 0)) (break)
              (let [a (cstr (load (index argv (load ai))))]
                (if (str-eq a "--source")
                    (if (>= (+ (load ai) 1) (cast i64 argc))
                        (do (fmt (stderr) "emit-object: --source needs a PATH\n")
                            (store! rc 1) 0)
                      (let [path (cstr (load (index argv (+ (load ai) 1))))]
                        (if (!= (jsl-read-file! path) JSL-OK)
                            (do (die "source read failed" (jsl-err-name (jsl-err)) 0)
                                (store! rc 9) 0)
                          (do (store! ai (+ (load ai) 2)) 0))))
                  (do
                    (if (= (load np) 0) (store! entry a)
                      (if (= (load np) 1)
                          (store! arity (cast i64 (atoi (load (index argv (load ai))))))
                        (if (= (load np) 2)
                            (store! regs (cast i64 (atoi (load (index argv (load ai))))))
                          0)))
                    (store! np (+ (load np) 1))
                    (store! ai (+ (load ai) 1))
                    0)))))
          (if (!= (load rc) 0) (load rc)
          (if (= (load np) 0)
              (do (fmt (stderr) "emit-object: no ENTRY given\n") 1)
          ;; 9 arguments plus jsl-call!'s implicit memory arg fills its 10-slot buffer; a larger
          ;; CLI arity must fail loudly here rather than overflow two stack arrays.
          (if (or (< (load arity) 0) (> (load arity) 9))
              (do (fmt (stderr) "emit-object: arity {d} out of range [0, 9]\n" (load arity))
                  (os/_exit 11) 0)
            (if (!= (jsl-check) JSL-OK)
                (die "check failed" (jsl-err-name (jsl-err)) 10)
              ;; ON DEMAND, not the whole library. This is the same path the frontend links
              ;; through, so compiling every entry here exercises the dependency walk rather than
              ;; only `jsl-lower!`. It also means the emitted object contains the entry and its
              ;; callees and nothing else.
              (if (do (jl-reset!) (!= (jsl-require! (load entry)) JSL-OK))
                  (die "jsl lower failed" (jsl-err-name (jsl-err)) 8)
                ;; Ten slots to match jsl-call!'s own argument buffer: arity is read from the
                ;; command line, and a 6-parameter builtin overflowed the old 4-slot array into
                ;; whatever the frame layout placed after it.
                (let [buf (stack (array i64 10))
                      p (cast (ptr i64) buf)
                      (mut i) 0]
                  (loop (if (>= (load i) (load arity)) (break)
                          (do (store! (index p (load i)) (n-new1 OP-ARG (t-dyn) (g-start)))
                              (store! i (+ (load i) 1))
                              0)))
                  (let [cs (jsl-call! (g-start) (load entry)
                                      (slice-new [i64] p (load arity)))]
                    (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (call-end cs) (call-value cs)))
                    (iterate!)
                    (g-analyze!)
                    (if (not (be-select-machine-program!))
                        (do (fmt (stderr)
                                 "emit-object: selection failed entry={s} gv={d}:{d}@{d} be={d}@{d} ms={d}@{d}\n"
                                 (load entry) (g-verify) (g-verify-code) (g-verify-node)
                                 (be-result) (be-result-node) (ms-result) (ms-result-item))
                            2)
                      (do (be-schedule!)
                          (if (< (be-color! (load regs)) 0) 3
                            (if (not (be-encode-checked!)) 4
                              (if (not (be-macho-checked!)) 5
                                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len))
                                    0 6))))))))))))))))))
