(module emitbenchobject)
(import "ty" :use *)
(import "node" :use *)
(import "backend" :use *)
(import "coil.control" :use *)
(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn c [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn main [] (-> i64)
  (graph-reset! 13)
  (let [fun (n-fun-open! 0) a (n-parm! fun 0) b (n-parm! fun 1)
        sum (n-new3 OP-ADD 0 NO-NODE a b) out (n-new3 OP-MUL 0 NO-NODE sum (c 2))
        ret (n-new2 OP-RETURN 0 (n-fun-entry fun) out)]
    (n-fun-close! fun ret) (g-analyze!)
    (if (not (be-select-fun! fun)) 2
      (do (be-schedule!)
          (if (not (be-color-checked! 8)) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
