(module emitrecursiveobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.control" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn rc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn rb [(op i64) (a i64) (b i64)] (-> i64) (n-new3 op 0 NO-NODE a b))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1102)
  (let [even (n-fun-open! 0) odd (n-fun-open! 1)
        en (n-parm! even 0) on (n-parm! odd 0)
        ea (n-if-arms! (n-peephole (n-new2 OP-IF 0 (n-fun-entry even) (rb OP-EQ en (rc 0)))))
        er (n-call1! (arms-f ea) odd (rb OP-SUB en (rc 1)))
        eb (n-new2 OP-RETURN 0 (arms-t ea) (rc 1))
        es (n-new2 OP-RETURN 0 (call-end er) (call-value er))
        oa (n-if-arms! (n-peephole (n-new2 OP-IF 0 (n-fun-entry odd) (rb OP-EQ on (rc 0)))))
        orc (n-call1! (arms-f oa) even (rb OP-SUB on (rc 1)))
        ob (n-new2 OP-RETURN 0 (arms-t oa) (rc 0))
        os (n-new2 OP-RETURN 0 (call-end orc) (call-value orc))]
    (n-fun-close! even eb) (n-fun-add-return! even es)
    (n-fun-close! odd ob) (n-fun-add-return! odd os)
    (let [site (n-call1! (g-start) even (rc 42))
          ret (n-new2 OP-RETURN 0 (call-end site) (call-value site))]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (if (not (be-select-machine-program!)) 2
        (do (be-schedule!)
            (be-function-layout-seeded!
              (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0))
            (if (< (be-color! 10) 0) 3
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
