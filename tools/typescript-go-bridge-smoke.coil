(module typescriptgobridgesmoke)

(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(extern aot_ts_parse :cc c [(ptr u8) i32] (-> u64))
(extern aot_ts_parse_delete :cc c [u64] (-> void))
(extern aot_ts_root :cc c [u64] (-> i32))
(extern aot_ts_node_count :cc c [u64] (-> i32))
(extern aot_ts_node_kind :cc c [u64 i32] (-> i32))
(extern aot_ts_node_start :cc c [u64 i32] (-> i32))
(extern aot_ts_node_end :cc c [u64 i32] (-> i32))
(extern aot_ts_node_child_count :cc c [u64 i32] (-> i32))
(extern aot_ts_node_child :cc c [u64 i32 i32] (-> i32))
(extern aot_ts_diagnostic_count :cc c [u64] (-> i32))
(extern aot_ts_diagnostic_code :cc c [u64 i32] (-> i32))
(extern aot_ts_diagnostic_start :cc c [u64 i32] (-> i32))
(extern aot_ts_diagnostic_length :cc c [u64 i32] (-> i32))

(defn main [] (-> i64)
  (let [valid "function main(x: number): number { return x + 1; }"
        invalid "function main(: number) {"
        good (aot_ts_parse (slice-data valid) (cast i32 (slice-len valid)))
        bad (aot_ts_parse (slice-data invalid) (cast i32 (slice-len invalid)))
        good-count (aot_ts_diagnostic_count good)
        bad-count (aot_ts_diagnostic_count bad)
        bad-start (aot_ts_diagnostic_start bad 0)
        bad-length (aot_ts_diagnostic_length bad 0)
        root (aot_ts_root good)
        function-node (aot_ts_node_child good root 0)
        ok (and (= good-count 0) (> bad-count 0) (>= bad-start 0) (>= bad-length 0)
                (= (aot_ts_node_kind good root) 307)
                (= (aot_ts_node_kind good function-node) 263)
                (= (aot_ts_node_start good function-node) 0)
                (= (aot_ts_node_end good function-node) (cast i32 (slice-len valid)))
                (> (aot_ts_node_count good) 1)
                (> (aot_ts_node_child_count good function-node) 0))]
    (fmt (stdout) "native TypeScript valid={d} invalid={d} first={d}:{d} code={d}\n"
      (cast i64 good-count) (cast i64 bad-count) (cast i64 bad-start) (cast i64 bad-length)
      (cast i64 (aot_ts_diagnostic_code bad 0)))
    (aot_ts_parse_delete good)
    (aot_ts_parse_delete bad)
    (if ok 0 1)))
