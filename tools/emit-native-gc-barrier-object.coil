(module emitnativegcbarrierobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn bc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn bm [(a i64)] (-> i64) (n-new1 OP-ARG (t-mem-alias a (t-undef)) (g-start)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1205) (shape-reset!)
  (let [child-shape (shape-transition SHAPE-ROOT "value" (t-int))
        av (shape-field-alias child-shape 0)
        holder-shape (shape-transition SHAPE-ROOT "child" (t-obj-shape child-shape))
        ah (shape-field-alias holder-shape 0)
        holder-new (n-new-obj1! (g-start) holder-shape (bm ah))
        holder (n-obj-ptr holder-new)
        trigger1 (n-new-obj1! (g-start) holder-shape (n-obj-mem holder-new 0))
        trigger1-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger1 0)
                            (n-obj-ptr trigger1) holder)
        trigger2 (n-new-obj1! (g-start) holder-shape trigger1-mem)
        trigger2-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger2 0)
                            (n-obj-ptr trigger2) holder)
        child-new (n-new-obj1! (g-start) child-shape (bm av))
        child (n-obj-ptr child-new)
        child-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem child-new 0) child (bc 41))
        holder-mem (n-new4 OP-STORE ah NO-NODE trigger2-mem holder child)
        trigger3 (n-new-obj1! (g-start) holder-shape holder-mem)
        trigger3-mem (n-new4 OP-STORE ah NO-NODE (n-obj-mem trigger3 0)
                            (n-obj-ptr trigger3) holder)
        moved-child (n-new3 OP-LOAD ah NO-NODE trigger3-mem holder)
        child-cast (n-new2 OP-CAST (t-obj-shape child-shape) (g-start) moved-child)
        value (n-new3 OP-LOAD av NO-NODE child-mem child-cast)
        ret (n-new3 OP-RETURN 0 (g-start) value trigger3-mem)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "barrier selection failed be={d} ms={d} item={d} gv={d}/{d}\n"
               (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
      (do (be-use-runtime-allocation! true) (be-schedule!)
          (if (< (be-color! 10) 0) 3
            (if (not (be-encode-checked!)) 4
              (if (not (be-macho-checked!)) 5
                (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6))))))))
