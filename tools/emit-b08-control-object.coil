(module emitb08controlobject)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "backend" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [regs (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 8)
        redirect (and (> argc 2) (!= (atoi (load (index argv 2))) (cast i32 0)))
        seed (if (> argc 3) (cast i64 (atoi (load (index argv 3)))) 8400)
        source (if redirect
          "function main(limit: number): number { let i=0; let out=0; outer: do { i++; switch(i) { default: out=out*10+8; case 3: out=out*10+3; break outer; case 1: out=out*10+1; continue outer; case 2: out=out*10+2; } out=out*10+9; if(i>=limit) break outer; } while(i<5); return out*10+i; }"
          "function main(limit: number): number { let i=0; let out=0; outer: do { i++; switch(i) { default: out=out*10+8; case 3: out=out*10+3; break; case 1: out=out*10+1; continue outer; case 2: out=out*10+2; } out=out*10+9; if(i>=limit) break outer; } while(i<5); return out*10+i; }")
        (mut frontend) (fe-native-new source)]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) 2)
        (do (frontend-native-build! (mut frontend) seed false)
            (fe-native-free! (mut frontend))
            (if (not (be-select-machine-program!))
              (do (fmt (stderr) "B08 selection failed be={d}@{d} ms={d}@{d}\n"
                    (be-result) (be-result-node) (ms-result) (ms-result-item)) 3)
              (do (be-schedule!)
                  (if (< (be-color! regs) 0) 4
                    (if (not (be-encode-checked!)) 5
                      (if (not (be-macho-checked!)) 6
                        (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 7))))))))))
