(module typescriptnativeb14negative)

(import "frontendnative" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [(mut frontend) (fe-native-new "function main(){return Math.notAFunction(1);}")
        status (fe-native-index! (mut frontend))
        code (load (field frontend error-code))
        node (load (field frontend error-node))]
    (fmt (stdout) "status={d} code={d} node={d}\n" status code node)
    (fe-native-free! (mut frontend))
    (if (and (= status FE-UNSUPPORTED) (= code FE-CODE-UNKNOWN-BUILTIN)) 0 2)))
