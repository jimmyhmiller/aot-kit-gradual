(module jsint32matrix)

(import "jsint32" :use *)
(import "ty" :use *)
(import "jsvalue" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn row [(name (slice u8)) (kind (slice u8)) (value i64)] (-> i64)
  (let [w (stdout)]
    (ps w name) (ps w "|") (ps w kind) (ps w "|") (dec-print w value) (ps w "\n") 0))

(defn main [] (-> i64)
  (row "to-int32-nan" "int" (js-to-int32-f64 (bits-f64 JSV-NAN)))
  (row "to-int32-infinity" "int" (js-to-int32-f64 (bits-f64 9218868437227405312)))
  (row "to-int32-negative-zero" "int" (js-to-int32-f64 (bits-f64 JSV-NEGATIVE-ZERO)))
  (row "to-int32-fraction" "int" (js-to-int32-f64 -3.9))
  (row "to-int32-sign" "int" (js-to-int32-f64 2147483648.0))
  (row "to-int32-wrap" "int" (js-to-int32-f64 4294967297.75))
  (row "to-uint32-negative-one" "int" (js-to-uint32-f64 -1.0))
  (row "bit-and" "int" (js-bit-bin JS-BIT-AND -1 252645135))
  (row "bit-or" "int" (js-bit-bin JS-BIT-OR 2147483648 1))
  (row "bit-xor" "int" (js-bit-bin JS-BIT-XOR -1 4294967295))
  (row "bit-not" "int" (js-bit-not 0))
  (row "shift-left-mask" "int" (js-bit-bin JS-SHL 1 33))
  (row "shift-right-mask" "int" (js-bit-bin JS-SHR -1 65))
  (row "unsigned-right-zero" "int" (js-bit-bin JS-USHR -1 0))
  (row "unsigned-right-one" "int" (js-bit-bin JS-USHR -2147483648 1))
  (row "remainder-negative-zero" "number" (js-remainder-bits -4.0 2.0))
  (row "remainder-fraction" "number" (js-remainder-bits 5.5 2.0))
  (row "remainder-zero-divisor" "number" (js-remainder-bits 1.0 0.0))
  (row "remainder-infinite-dividend" "number"
       (js-remainder-bits (bits-f64 9218868437227405312) 2.0))
  (row "remainder-infinite-divisor" "number"
       (js-remainder-bits 7.0 (bits-f64 9218868437227405312)))
  0)
