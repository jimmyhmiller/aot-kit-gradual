(module emitfptruthobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))

(defn main [] (-> i64)
  (graph-reset! 1510)
  (let [value (n-new1 OP-ARG (t-flt) (g-start))
        arms (n-if-arms! (n-peephole (n-new2 OP-IF 0 (g-start) value)))
        yes (n-new2 OP-RETURN 0 (arms-t arms)
              (n-new1 OP-CONST (t-int-con 1) (g-start)))
        no (n-new2 OP-RETURN 0 (arms-f arms)
             (n-new1 OP-CONST (t-int-con 0) (g-start)))]
    (n-add-def! (g-stop) yes)
    (n-add-def! (g-stop) no)
    (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "truth selection failed be={d}@{d} ms={d}@{d}\n"
             (be-result) (be-result-node) (ms-result) (ms-result-item))
          (ms-dump (stderr)) 2)
      (do (be-schedule!) (be-color! 8)
          (if (not (be-encode-checked!)) 3
            (if (not (be-macho-checked!)) 4
              (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 5)))))))
