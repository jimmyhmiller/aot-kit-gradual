(module typescriptnativeb10constructorsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)

(defn run [(optimize bool)] (-> i64)
  (let [source "interface Box { value:number; } function Primitive(this:Box, value:number):number { this.value=value; return 99; } function ObjectResult(this:Box, value:number):Box { this.value=-1; return {value:value}; } function main():number { let a:Box=new Primitive(7); let b:Box=new ObjectResult(11); return a.value*100+b.value; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK) (do (fe-native-free! (mut frontend)) -9000)
      (do (frontend-native-build-mode! (mut frontend) 10200 optimize true)
          (ev-reset!) (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 1000000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (if (and (= (run false) 711) (= (run true) 711)) 0 3))
