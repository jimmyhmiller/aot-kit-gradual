(module typescriptnativeb12arraysmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "node" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn run [(optimize bool)] (-> i64)
  (let [source "function main(){let s=[10,,30,,];let z=s.slice(-3,-1);let p=[];p[-1]=5;p[1.5]=6;p['x']=7;let a=[1];let x=a.push(2,3);let y=a.pop();return s[0]+s[2]+s.length+z.length+z[1]+p[-1]+p[1.5]+p['x']+p.length+x*100+y*10+a.length+a[1];}"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK) (do (fe-native-free! (mut frontend)) (- -9000 status))
      (do (frontend-native-build-mode! (mut frontend) 11210 optimize true)
          (ev-reset!) (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 100000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (if (= run-status EV-OK) 0
              (do (fmt (stderr) "B12 array eval status={d} at={d} op={s}\n"
                    run-status (ev-at) (op-name (n-op (ev-at)))) 0))
            (fe-native-free! (mut frontend)) answer)))))

(defn main [] (-> i64)
  (let [raw (run false) optimized (run true)]
    (if (and (= raw 428) (= optimized 428)) 0
      (do (fmt (stderr) "B12 array smoke raw={d} optimized={d}\n" raw optimized) 3))))
