(module typescriptnativeb08dosmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "gtext" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.str" :use *)
(import "coil.alloc" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(defn main [] (-> i64)
  (let [source "function main(limit: number): number { let i=0; let out=0; outer: do { i++; if(i===1) continue outer; out=out*10+i; if(i>=limit) break outer; } while(i<5); return out*10+i; }"
        (mut frontend) (fe-native-new source)
        buffer (stack (array i8 65536))
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK)
        (do (fmt (stderr) "B08 do index={d} code={d} node={d}\n" status
                 (load (field frontend error-code)) (load (field frontend error-node)))
            (fe-native-free! (mut frontend)) 2)
        (let [arg (frontend-native-build-mode! (mut frontend) 8001 false true)]
          (do
            (ps (stdout) (g-render (cast (ptr i8) buffer) 65536))
            (ev-reset!)
            (let []
              (ev-bind! arg (RInt 3))
              (let [run-status (ev-run-nobind 100000)
                    answer (if (= run-status EV-OK) (rt-payload (ev-result)) -1)]
                (fmt (stderr) "B08 do eval={d} answer={d}\n" run-status answer)
                (fe-native-free! (mut frontend))
                (if (and (= run-status EV-OK) (= answer 233)) 0 3))))))))
