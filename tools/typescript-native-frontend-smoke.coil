(module typescriptnativefrontendsmoke)

(import "frontendnative" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.str" :use *)

(defn main [] (-> i64)
  (let [source
          "type Box = { value: number }; function Box(value: number): Box { return { value: value }; } function main(n: number): number { let box = new Box(n); return box.value; }"
        (mut frontend) (fe-native-new source)
        indexed (fe-native-index! (mut frontend))
        function-count (al-len [FeFunction] (load (field frontend functions)))
        symbol-count (al-len [FeSymbol] (load (field frontend symbols)))
        type-count (al-len [FeTypeDecl] (load (field frontend types)))
        field-count (al-len [FeField] (load (field frontend fields)))
        s0 (al-get [FeSymbol] (load (field frontend symbols)) 0)
        s1 (al-get [FeSymbol] (load (field frontend symbols)) 1)
        s2 (al-get [FeSymbol] (load (field frontend symbols)) 2)
        resolution-count (al-len [FeResolution] (load (field frontend resolutions)))
        ok
          (and (= indexed 0)
               (= function-count 2)
               (= symbol-count 3)
               (= type-count 1)
               (= field-count 1)
               (= resolution-count 4)
               (str-eq (fe-function-name frontend 0) "Box")
               (str-eq (fe-function-name frontend 1) "main")
               (= (load (field s0 id)) 2)
               (= (load (field s1 id)) 3)
               (= (load (field s2 id)) 4)
               (str-eq (fe-symbol-name frontend 0) "value")
               (str-eq (fe-symbol-name frontend 1) "n")
               (str-eq (fe-symbol-name frontend 2) "box")
               (str-eq (fe-type-name frontend 0) "Box")
               (str-eq (fe-field-name frontend 0) "value"))]
    (fmt (stdout)
         "Coil frontend functions={d} symbols={d} uses={d} ids={d},{d},{d}\n"
         function-count
         symbol-count
         resolution-count
         (load (field s0 id))
         (load (field s1 id))
         (load (field s2 id)))
    (fe-native-free! (mut frontend))
    (if ok 0 1)))
