(module emitfpstackcallobject)

(import "ty" :use *)
(import "node" :use *)
(import "backend" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(extern atoi :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1512)
  (let [mode (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)
        fun (n-fun-open! 0)
        pbuf (stack (array i64 16))
        parms (cast (ptr i64) pbuf)
        (mut i) 0]
    (loop
      (if (>= (load i) 16) (break)
        (do (store! (index parms (load i)) (n-parm! fun (load i)))
            (store! i (+ (load i) 1)) 0)))
    (let [(mut sum) (load (index parms 0))]
      (store! i 1)
      (loop
        (if (>= (load i) 16) (break)
          (do (store! sum (n-new3 OP-ADD 0 NO-NODE (load sum)
                            (load (index parms (load i)))))
              (store! i (+ (load i) 1)) 0)))
      (n-fun-close! fun (n-new2 OP-RETURN 0 (n-fun-entry fun) (load sum))))
    (let [abuf (stack (array i64 16)) args (cast (ptr i64) abuf)]
      (store! i 0)
      (loop
        (if (>= (load i) 16) (break)
          (do
            (let [fp (if (= mode 0)
                         (or (= (% (load i) 2) 0) (>= (load i) 14))
                       (and (= (% (load i) 2) 1) (< (load i) 14)))
                  value (+ (load i) 1)]
              (store! (index args (load i))
                (n-new1 OP-CONST
                  (if fp (t-flt-con (cast f64 value)) (t-int-con value))
                  (g-start))))
            (store! i (+ (load i) 1)) 0)))
      (let [site (n-call! (g-start) fun (slice-new [i64] args 16))]
        (n-add-def! (g-stop)
          (n-new2 OP-RETURN 0 (call-end site) (call-value site)))))
    (g-analyze!)
    (if (not (be-select-machine-program!))
      (do (fmt (stderr) "stack-call selection failed mode={d} be={d}@{d} ms={d}@{d}\n"
             mode (be-result) (be-result-node) (ms-result) (ms-result-item)) 2)
      (do (be-schedule!) (be-color! 10)
          (if (not (be-encode-checked!)) 3
            (if (not (be-macho-checked!)) 4
              (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 5)))))))
