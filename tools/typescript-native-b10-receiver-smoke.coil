(module typescriptnativeb10receiversmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern atoi :cc c [(ptr i8)] (-> i32))

(defn run [(optimize bool)] (-> i64)
  (let [source "interface Box { value:number; } function add(this:Box, amount:number):number { return this.value+amount; } function main():number { let count=0; let box:Box={value:40}; let get=function():Box { count+=1; return box; }; return get().add(2)*10+count; }"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK) (do (fe-native-free! (mut frontend)) -9000)
      (do (frontend-native-build-mode! (mut frontend) 10100 optimize true)
          (ev-reset!) (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 1000000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (if (!= run-status EV-OK)
                (do
                  (fmt (stderr) "receiver optimize={d} status={d} at={d}\n"
                       (if optimize 1 0) run-status (ev-at))
                  0)
                0)
            (fe-native-free! (mut frontend)) answer)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [mutation (if (> argc 1) (cast i64 (atoi (load (index argv 1)))) 0)]
    (store! (fng-omit-receiver-ptr) (= mutation 1))
    (store! (fng-duplicate-receiver-ptr) (= mutation 2))
  (let [a (run false) b (run true)]
    (if (and (= a 421) (= b 421)) 0 3))))
