(module emitnativegcrecursiveobject)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "verify" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(extern write :cc c [i32 (ptr u8) i64] (-> i64))
(defn rc [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn rb [(op i64) (a i64) (b i64)] (-> i64) (n-new3 op 0 NO-NODE a b))
(defn rm [(ctrl i64) (alias i64)] (-> i64)
  (n-new1 OP-ARG (t-mem-alias alias (t-undef)) ctrl))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (graph-reset! 1204) (shape-reset!)
  (let [parent-shape (shape-transition SHAPE-ROOT "parent" (t-obj-shape SHAPE-ROOT))
        ap (shape-field-alias parent-shape 0)
        node-shape (shape-transition parent-shape "value" (t-int))
        av (shape-field-alias node-shape 1)
        fun (n-fun-open! 0) n (n-parm! fun 0) parent (n-parm! fun 1)
        arms (n-if-arms!
               (n-peephole (n-new2 OP-IF 0 (n-fun-entry fun) (rb OP-LT n (rc 1)))))
        nw (n-new-obj2! (arms-f arms) node-shape
                        (rm (n-fun-entry fun) ap) (rm (n-fun-entry fun) av))
        node (n-obj-ptr nw)
        parent-unboxed (n-new2 OP-UNBOX (t-obj-shape SHAPE-ROOT) NO-NODE parent)
        parent-cast (n-new2 OP-CAST (t-obj-shape SHAPE-ROOT) (arms-f arms) parent-unboxed)
        parent-mem (n-new4 OP-STORE ap NO-NODE (n-obj-mem nw 0) node parent-cast)
        value-mem (n-new4 OP-STORE av NO-NODE (n-obj-mem nw 1) node n)
        boxed-node (n-new2 OP-BOX 0 NO-NODE node)
        recur (n-call2! (arms-f arms) fun (rb OP-SUB n (rc 1)) boxed-node)
        local-value (n-new3 OP-LOAD av NO-NODE value-mem node)
        total (rb OP-ADD local-value (call-value recur))
        base (n-new2 OP-RETURN 0 (arms-t arms) (rc 0))
        step (n-new3 OP-RETURN 0 (call-end recur) total parent-mem)]
    (n-fun-close! fun base)
    (n-fun-add-return! fun step)
    (let [seed-new (n-new-obj0! (g-start) SHAPE-ROOT) seed (n-obj-ptr seed-new)
          boxed-seed (n-new2 OP-BOX 0 NO-NODE seed)
          site (n-call2! (g-start) fun (rc 100) boxed-seed)
          ret (n-new2 OP-RETURN 0 (call-end site) (call-value site))]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (if (not (be-select-machine-program!))
        (do (fmt (stderr) "recursive selection failed be={d} ms={d} item={d} gv={d}/{d}\n"
                 (be-result) (ms-result) (ms-result-item) (g-verify-code) (g-verify-node)) 2)
        (do (be-use-runtime-allocation! true) (be-schedule!)
            (if (< (be-color! 10) 0)
              (do (fmt (stderr) "recursive allocation failed {d} at {d}\n"
                       (mra-result) (mra-result-item)) 3)
              (if (not (be-encode-checked!)) 4
                (if (not (be-macho-checked!)) 5
                  (if (= (write 1 (be-object-data) (be-object-len)) (be-object-len)) 0 6)))))))))
