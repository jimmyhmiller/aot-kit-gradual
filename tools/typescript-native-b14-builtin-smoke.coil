(module typescriptnativeb14builtinsmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn run [(optimize bool)] (-> i64)
  (let [source
          "function main(){let root=Math.sqrt;let absolute=Math.abs;let maximum=Math.max;return root(81)+Math.floor(3.9)+Math.ceil(3.1)+Math.round(1.5)+absolute(-2)+maximum(4,7)+Math.min(4,7)+Math.pow(2,3)+Math.exp(Math.log(1))+Math.sin(0)+Math.cos(0)+Math.tan(0)+Math.asin(0)+Math.acos(1)+Math.atan(0)+(Math.LN2-Math.log(2))+Math.random();}"
        (mut frontend) (fe-native-new source)
        indexed (fe-native-index! (mut frontend))]
    (if (!= indexed FE-OK)
        (do (fe-native-free! (mut frontend)) (- -9000 indexed))
        (do
          (frontend-native-build-mode! (mut frontend) 11420 optimize true)
          (ev-reset!)
          (ev-bind-args! 0)
          (let [run-status (ev-run-nobind 100000)
                answer (if (= run-status EV-OK) (rt-payload (ev-result)) (- -9100 run-status))]
            (fe-native-free! (mut frontend))
            answer)))))

(defn main [] (-> i64)
  (let [raw (run false) optimized (run true) expected 4631106001900666880]
    (if (and (= raw expected) (= optimized expected))
        0
        (do (fmt (stderr) "B14 builtin smoke raw={d} optimized={d} expected={d}\n"
                 raw optimized expected) 3))))
