;; Probes for tools/jsl-native-gate.sh. Not part of the shipped library: they exist so a string
;; result can be judged by the numeric harness.
;;
;; EACH PROBE RETURNS A BOOLEAN, comparing what the library computes against an expected literal.
;; The harness therefore needs no way to read a string out of the runtime, and the Node side
;; computes the same booleans, so the committed golden judges both. Negative cases are included
;; deliberately: a table of expected-true rows would pass against a `%StringEq` that always agreed.
(macro Sel :params [(i dyn) (k int)] :ret bool (%Eq (%UnboxInt i) k))

(builtin ProbeStrEq :transitioning true :params [(i dyn)] :ret dyn
  (%Box
    (if (Sel i 0)  (%StringEq (%Substring "hello" 1 3) "el")
    (if (Sel i 1)  (%StringEq (%Substring "hello" 1 3) "XX")
    (if (Sel i 2)  (%StringEq (StringTrim "  ab  ") "ab")
    (if (Sel i 3)  (%StringEq (StringTrimStart "  ab  ") "ab  ")
    (if (Sel i 4)  (%StringEq (StringTrimEnd "  ab  ") "  ab")
    (if (Sel i 5)  (%StringEq (StringRepeatCount "ab" 3) "ababab")
    (if (Sel i 6)  (%StringEq (StringRepeatCount "ab" 0) "")
    (if (Sel i 7)  (%StringEq (StringPadStart "abc" 6 "0") "000abc")
    (if (Sel i 8)  (%StringEq (StringPadEnd "abc" 6 "0") "abc000")
    (if (Sel i 9)  (%StringEq (StringSlice "abcdef" 1 4) "bcd")
    (if (Sel i 10) (%StringEq (StringCharAt "abc" 1) "b")
    (if (Sel i 11) (%StringEq (StringCharAt "abc" 9) "")
    (if (Sel i 12) (%StringEq (StringReplaceAll "abcabc" "b" "X") "aXcaXc")
    (if (Sel i 13) (%StringEq (StringReplaceAll "abc" "" "-") "-a-b-c-")
    (if (Sel i 14) (%StringEq (StringSlice "abcdef" 4 1) "")
                   false)))))))))))))))))

;; The index and predicate results, compared as BOXED values. `%Eq` on two boxed booleans or two
;; boxed integers is an identity test on identical tags and payloads, which is exactly right here —
;; and it avoids unboxing a call result, which traps when the checked unbox is reached on a path the
;; guard did not establish.
(builtin ProbeStrNum :transitioning true :params [(i dyn)] :ret dyn
  (%Box
    (if (Sel i 0)  (%Eq (StringIndexOfFrom "hello world" "o" 0) 4)
    (if (Sel i 1)  (%Eq (StringIndexOfFrom "hello world" "o" 5) 7)
    (if (Sel i 2)  (%Eq (StringIndexOfFrom "hello world" "o" 99) -1)
    (if (Sel i 3)  (%Eq (%StringLen "hello") 5)
    (if (Sel i 4)  (%Eq (%StringCharCode "abc" 1) 98)
    (if (Sel i 5)  (%Eq (StringStartsWith "coil" "co") (%Box true))
    (if (Sel i 6)  (%Eq (StringStartsWith "coil" "il") (%Box false))
    (if (Sel i 7)  (%Eq (StringEndsWith "coil" "il") (%Box true))
    (if (Sel i 8)  (%Eq (StringEndsWith "oil" "coil") (%Box false))
    (if (Sel i 9)  (%Eq (StringLastIndexOf "abcabc" "b") 4)
    (if (Sel i 10) (%Eq (StringLastIndexOf "abc" "") 3)
    (if (Sel i 11) (%Eq (StringIncludesFrom "coil" "il" 0) (%Box true))
    (if (Sel i 12) (%Eq (StringIncludesFrom "coil" "zz" 0) (%Box false))
    ;; `StringAt` returns a TAGGED value — it has to, because the out-of-range arm is `undefined`,
    ;; and a Phi with a raw pointer on one side and a tag on the other is read as whichever the
    ;; consumer assumes. There is no `%UnboxStr` to get the pointer back for `%StringEq`, so what
    ;; this probe checks is the ARM SELECTION: in range is not undefined, out of range is. The
    ;; content is checked where it can be, through `String(...)` in
    ;; tests/native-conformance/string-transforms.ts.
    (if (Sel i 13) (%Not (%Eq (StringAt "abcdef" (%Box -2)) (%Box undefined)))
    (if (Sel i 14) (%StringEq (StringSlice "abcdef" 1 4) "bcd")
                   false)))))))))))))))))

;; Raw values, for diagnosing a disagreement rather than only detecting one.
(builtin ProbeStrRaw :transitioning true :params [(i dyn)] :ret dyn
  (if (Sel i 0) (%Box (StringLastIndexOf "abcabc" "b"))
  (if (Sel i 1) (%Box (StringLastIndexOf "abc" ""))
  (if (Sel i 2) (%Box (StringIndexOfFrom "abcabc" "b" 0))
  (if (Sel i 3) (%Box (StringIndexOfFrom "abcabc" "b" 2))
                (%Box -999))))))
