(module typescriptnativeb08memorysmoke)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "eval" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn main [] (-> i64)
  (let [source "type Box={value:number;count:number}; function Box(value:number,count:number):Box{return {value:value,count:count};} function main():number{let box=new Box(0,0); outer: do { box.value+=1; if(box.value===1){box.count+=10;continue outer;} box.count+=box.value; if(box.value>=3)break outer; } while(box.value<5); return box.value*100+box.count;}"
        (mut frontend) (fe-native-new source)
        status (fe-native-index! (mut frontend))]
    (if (!= status FE-OK)
        (do (fmt (stderr) "B08 memory index={d} code={d}\n" status
              (load (field frontend error-code))) (fe-native-free! (mut frontend)) 2)
        (do (frontend-native-build-mode! (mut frontend) 8200 false true)
            (ev-reset!)
            (let [run-status (ev-run-nobind 1000000)
                  result (ev-result)
                  answer (if (= run-status EV-OK)
                             (if (= (rt-tag result) RT-FLT)
                                 (cast i64 (bits-f64 (rt-payload result)))
                                 (rt-payload result))
                             -1)]
              (fmt (stdout) "status={d} at={d} answer={d}\n" run-status (ev-at) answer)
              (if (= run-status EV-OK)
                  0
                  (do (ev-print (stderr)) (g-print-flat (stderr)) 0))
              (fe-native-free! (mut frontend))
              (if (and (= run-status EV-OK) (= answer 315)) 0 3))))))
