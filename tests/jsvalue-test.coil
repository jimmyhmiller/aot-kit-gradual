(module jsvaluetest)

(import "jsvalue" :use *)
(import "coil.assert" :use *)

(deftest integer_payload_boundaries_round_trip
  (assert (= (jsv-unbox-int (jsv-box-int JSV-INT-MIN)) JSV-INT-MIN))
  (assert (= (jsv-unbox-int (jsv-box-int JSV-INT-MAX)) JSV-INT-MAX))
  (assert (= (jsv-box-int (- JSV-INT-MIN 1)) JSV-NAN))
  (assert (= (jsv-box-int (+ JSV-INT-MAX 1)) JSV-NAN)))

(deftest malformed_and_reserved_words_are_rejected
  (assert (not (jsv-well-formed? (+ JSV-UNDEFINED 1))))
  (assert (not (jsv-well-formed? (+ JSV-BOOLEAN 2))))
  (assert (not (jsv-well-formed? JSV-SYMBOL)))
  (assert (not (jsv-well-formed? -281474976710656)))
  (assert (not (jsv-well-formed? JSV-OBJECT)))
  (assert (not (jsv-well-formed? (+ JSV-ARRAY 3))))
  (assert (jsv-well-formed? (+ JSV-OBJECT 8))))

(deftest every_defined_tag_has_one_shared_classification
  (assert (jsv-well-formed? JSV-NAN))
  (assert (jsv-well-formed? JSV-UNDEFINED))
  (assert (jsv-well-formed? JSV-NULL))
  (assert (jsv-well-formed? (+ JSV-BOOLEAN 1)))
  (assert (jsv-well-formed? (jsv-box-int -17)))
  (assert (jsv-well-formed? (+ JSV-STRING 8)))
  (assert (jsv-well-formed? (+ JSV-REF 8)))
  (assert (jsv-well-formed? (+ JSV-FUNCTION 8)))
  (assert (jsv-well-formed? (+ JSV-OBJECT 8)))
  (assert (jsv-well-formed? (+ JSV-ARRAY 8)))
  (assert (jsv-well-formed? (+ JSV-CLOSURE 8)))
  (assert (jsv-well-formed? (+ JSV-REGEXP 8)))
  (assert (jsv-well-formed? (+ JSV-SYMBOL 8)))
  (assert (jsv-managed? (+ JSV-OBJECT 8)))
  (assert (jsv-managed? (+ JSV-ARRAY 8)))
  (assert (jsv-managed? (+ JSV-CLOSURE 8)))
  (assert (jsv-managed? (+ JSV-REGEXP 8)))
  (assert (jsv-managed? (+ JSV-SYMBOL 8)))
  (assert (not (jsv-managed? (+ JSV-STRING 8))))
  (assert (not (jsv-managed? (+ JSV-FUNCTION 8))))
  (assert (jsv-reference? (+ JSV-STRING 8)))
  (assert (jsv-reference? (+ JSV-FUNCTION 8)))
  (assert (not (jsv-reference? (+ JSV-SYMBOL 8)))))

(deftest malformed_payload_matrix_rejects_each_constrained_class
  (assert (not (jsv-well-formed? (+ JSV-NAN 1))))
  (assert (not (jsv-well-formed? (+ JSV-NULL 1))))
  (assert (not (jsv-well-formed? (+ JSV-BOOLEAN 2))))
  (assert (not (jsv-well-formed? JSV-ARRAY)))
  (assert (not (jsv-well-formed? JSV-CLOSURE)))
  (assert (not (jsv-well-formed? JSV-REGEXP)))
  (assert (not (jsv-well-formed? (+ JSV-OBJECT 9))))
  (assert (not (jsv-well-formed? (+ JSV-CLOSURE 15)))))

(deftest truthiness_covers_falsey_tagged_values_and_both_zeroes
  (assert (not (jsv-truthy? JSV-UNDEFINED)))
  (assert (not (jsv-truthy? JSV-NULL)))
  (assert (not (jsv-truthy? JSV-NAN)))
  (assert (not (jsv-truthy? JSV-BOOLEAN)))
  (assert (not (jsv-truthy? (jsv-box-int 0))))
  (assert (not (jsv-truthy? 0)))
  (assert (not (jsv-truthy? JSV-NEGATIVE-ZERO)))
  (assert (not (jsv-truthy? JSV-STRING)))
  (assert (jsv-truthy? (+ JSV-BOOLEAN 1)))
  (assert (jsv-truthy? (+ JSV-STRING 1)))
  (assert (jsv-truthy? (+ JSV-SYMBOL 8)))
  (assert (jsv-truthy? (jsv-box-int -1))))

(deftest strict_equality_rejects_nan_and_equates_signed_zero
  (assert (not (jsv-strict-equal? JSV-NAN JSV-NAN)))
  (assert (jsv-strict-equal? 0 JSV-NEGATIVE-ZERO))
  (assert (jsv-strict-equal? (jsv-box-int 7) (jsv-box-int 7)))
  (assert (not (jsv-strict-equal? (jsv-box-int 7) (jsv-box-int 8)))))
