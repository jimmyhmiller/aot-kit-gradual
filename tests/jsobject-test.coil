(module jsobjecttest)

(import "jsobject" :use *)
(import "jsvalue" :use *)
(import "shape" :use *)
(import "ty" :use *)
(import "coil.assert" :use *)

(deftest own_storage_transitions_without_losing_identity_or_fields
  (shape-reset!)
  (jso-reset!)
  (let [object (jso-new! JSO-NONE)]
    (assert (= object 0))
    (assert (= (jso-store! object "x" (jsv-box-int 10)) JSO-OK))
    (let [sx (jso-shape object)]
      (assert (shape-has-field? sx "x"))
      (assert (= (jso-store! object "y" (jsv-box-int 20)) JSO-OK))
      (assert (shape-has-field? (jso-shape object) "x"))
      (assert (shape-has-field? (jso-shape object) "y"))
      (assert (= (jso-load object "x") (jsv-box-int 10)))
      (assert (= (jso-load object "y") (jsv-box-int 20)))
      (assert (= (jso-load object "missing") JSV-UNDEFINED))
      (assert (= (jso-store! object "x" (jsv-box-int 11)) JSO-OK))
      (assert (= (jso-shape object) (shape-transition sx "y" (t-dyn))))
      (assert (= (jso-load object "x") (jsv-box-int 11))))))

(deftest prototype_lookup_and_own_shadowing
  (shape-reset!)
  (jso-reset!)
  (let [prototype (jso-new! JSO-NONE) object (jso-new! prototype)]
    (jso-store! prototype "inherited" (jsv-box-int 20))
    (jso-store! prototype "undefined-value" JSV-UNDEFINED)
    (jso-store! prototype "shadowed" (jsv-box-int 3))
    (jso-store! object "shadowed" (jsv-box-int 7))
    (assert (= (jso-load object "inherited") (jsv-box-int 20)))
    (assert (jso-prototype-reaches? (jso-prototype object) prototype))
    (assert (not (jso-prototype-reaches? (jso-prototype prototype) object)))
    (assert (= (jso-load object "shadowed") (jsv-box-int 7)))
    (assert (jso-has? object "inherited"))
    (assert (jso-has? object "undefined-value"))
    (assert (not (jso-has? object "missing")))
    (assert (jso-own? object "shadowed"))
    (assert (not (jso-own? object "inherited")))))

(deftest deletion_removes_only_the_own_property_and_allows_reinsertion
  (shape-reset!)
  (jso-reset!)
  (let [prototype (jso-new! JSO-NONE) object (jso-new! prototype)]
    (jso-store! prototype "x" (jsv-box-int 4))
    (jso-store! object "x" JSV-UNDEFINED)
    (assert (jso-own? object "x"))
    (assert (jso-delete! object "x"))
    (assert (not (jso-own? object "x")))
    (assert (jso-has? object "x"))
    (assert (= (jso-load object "x") (jsv-box-int 4)))
    (assert (jso-delete! object "missing"))
    (jso-store! object "x" (jsv-box-int 9))
    (assert (jso-own? object "x"))
    (assert (= (jso-load object "x") (jsv-box-int 9)))))

(deftest prototype_cycles_are_rejected_without_mutation
  (shape-reset!)
  (jso-reset!)
  (let [a (jso-new! JSO-NONE) b (jso-new! a)]
    (assert (= (jso-set-prototype! a b) JSO-CYCLE))
    (assert (= (jso-status) JSO-CYCLE))
    (assert (= (jso-prototype a) JSO-NONE))
    (assert (= (jso-set-prototype! a a) JSO-CYCLE))))

(deftest own_keys_follow_ecmascript_index_then_insertion_order
  (shape-reset!)
  (jso-reset!)
  (let [object (jso-new! JSO-NONE)]
    (jso-store! object "later" (jsv-box-int 1))
    (jso-store! object "10" (jsv-box-int 2))
    (jso-store! object "2" (jsv-box-int 3))
    (jso-store! object "earlier" (jsv-box-int 4))
    (assert (= (jso-own-key-count object) 4))
    (assert (= (jso-own-key-at object 0) (shape-name-find "2")))
    (assert (= (jso-own-key-at object 1) (shape-name-find "10")))
    (assert (= (jso-own-key-at object 2) (shape-name-find "later")))
    (assert (= (jso-own-key-at object 3) (shape-name-find "earlier")))
    (assert (= (jso-own-key-at object 4) SHAPE-NO-NAME))
    ;; Updates preserve order; deletion plus reinsertion moves a string key to the end.
    (jso-store! object "later" (jsv-box-int 5))
    (assert (= (jso-own-key-at object 2) (shape-name-find "later")))
    (jso-delete! object "later")
    (jso-store! object "later" (jsv-box-int 6))
    (assert (= (jso-own-key-at object 2) (shape-name-find "earlier")))
    (assert (= (jso-own-key-at object 3) (shape-name-find "later")))))

(deftest freezing_is_recorded_on_the_object_identity
  (shape-reset!)
  (jso-reset!)
  (let [object (jso-new! JSO-NONE)]
    (assert (not (jso-frozen? object)))
    (assert (= (jso-freeze! object) JSO-OK))
    (assert (jso-frozen? object))))
