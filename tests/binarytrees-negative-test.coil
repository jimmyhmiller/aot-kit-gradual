(module binarytreesnegativetest)

(import "binarytrees" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "eval" :use *)
(import "ty" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "coil.assert" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn neg-pow2 [(n i64)] (-> i64)
  (let [(mut value) 1 (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (store! value (* (load value) 2)) (store! i (+ (load i) 1)) 0)))
    (load value)))
(defn neg-tree-check [(depth i64)] (-> i64) (- (neg-pow2 (+ depth 1)) 1))

(defn neg-result-field [(slot i64)] (-> i64)
  (let [obj (rt-payload (ev-result)) alias (shape-field-alias (ev-obj-shape obj) slot)
        ver (hv-find (ev-result-mem) obj alias)]
    (if (< ver 0) -9223372036854775807 (rt-payload (hve-val (hv-ent ver))))))

(defn neg-result-valid? [(depth i64)] (-> bool)
  (if (or (!= (ev-status) EV-OK) (!= (rt-tag (ev-result)) RT-OBJ)) false
    (if (or (!= (neg-result-field 0) (+ depth 1))
            (!= (neg-result-field 1) (neg-tree-check (+ depth 1)))) false
      (let [(mut slot) 0 (mut valid) true]
        (loop
          (if (or (>= (load slot) BT-WORK-SLOTS) (not (load valid))) (break)
            (do (let [work-depth (+ BT-MIN-DEPTH (* (load slot) 2))
                      base (+ 2 (* (load slot) 3))
                      iterations (if (<= work-depth depth)
                                     (neg-pow2 (+ (- depth work-depth) BT-MIN-DEPTH)) 0)]
                  (if (or (!= (neg-result-field base) work-depth)
                          (or (!= (neg-result-field (+ base 1)) iterations)
                              (!= (neg-result-field (+ base 2))
                                  (* iterations (neg-tree-check work-depth)))))
                      (store! valid false) 0))
                (store! slot (+ (load slot) 1)) 0)))
        (and (load valid)
             (and (= (neg-result-field 29) depth)
                  (= (neg-result-field 30) (neg-tree-check depth))))))))

(defn neg-find-op [(op i64)] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (or (>= (load i) (n-count)) (!= (load found) NO-NODE)) (break)
        (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) op))
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn neg-find-loop-phi [] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (or (>= (load i) (n-count)) (!= (load found) NO-NODE)) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-PHI)
                          (= (n-op (n-in (load i) 0)) OP-LOOP)))
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn neg-find-recursive-add [] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (or (>= (load i) (n-count)) (!= (load found) NO-NODE)) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-ADD)
                          (and (= (n-op (n-in (load i) 1)) OP-CALL)
                               (= (n-op (n-in (load i) 2)) OP-CALL))))
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn neg-find-final-check-call [] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) (n-count)) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-CALL)
                          (and (= (n-aux (n-in (load i) 1)) 1)
                               (= (n-op (n-in (load i) 0)) OP-REGION))))
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn neg-find-pow-base-constant [] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) (n-count)) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-FUN) (= (n-aux (load i)) 2)))
                (let [fun (load i) (mut r) 1]
                  (loop
                    (if (>= (load r) (n-nins fun)) (break)
                      (do (let [ret (n-in fun (load r))]
                            (if (and (= (n-op ret) OP-RETURN)
                                     (and (= (n-op (n-in ret 1)) OP-CONST)
                                          (= (ty-int-lo (n-ty (n-in ret 1))) 1)))
                                (store! found (n-in ret 1)) 0))
                          (store! r (+ (load r) 1)) 0)))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn neg-run-caught! [(kind i64)] (-> bool)
  (let [arg (binarytrees-build! (+ 2400 kind))]
    (case kind
      0 (let [load-node (neg-find-op OP-LOAD)]
          (store! (field (nd load-node) aux) (+ (n-aux load-node) 2)))
      1 (let [eq (neg-find-op OP-EQ)] (store! (field (nd eq) op) OP-LT))
      2 (let [add (neg-find-recursive-add)] (n-set-def! add 2 (bt-const 0)))
      3 (let [phi (neg-find-loop-phi) entry (n-in phi 1) back (n-in phi 2)]
          (n-set-def! phi 1 back) (n-set-def! phi 2 entry))
      4 (let [constant (neg-find-pow-base-constant)]
          (store! (field (nd constant) aux) (t-int-con 2))
          (n-set-ty! constant (t-int-con 2)))
      5 (let [call (neg-find-final-check-call)] (n-set-def! call 2 (bt-null)))
      0)
    (ev-reset!) (ev-bind! arg (RInt 4))
    (ev-run-nobind 10000000)
    (not (neg-result-valid? 4))))

(defn build-asymmetric-field-check! [(swap bool)] (-> i64)
  (graph-reset! (if swap 2502 2501)) (shape-reset!)
  (let [left-shape (shape-transition SHAPE-ROOT "left" (t-obj))
        tree-shape (shape-transition left-shape "right" (t-obj))
        left-alias (shape-field-alias tree-shape 0)
        right-alias (shape-field-alias tree-shape 1)
        initial-left (n-new1 OP-ARG (t-mem-alias left-alias (t-undef)) (g-start))
        initial-right (n-new1 OP-ARG (t-mem-alias right-alias (t-undef)) (g-start))
        first-new (n-new-obj2! (g-start) tree-shape initial-left initial-right)
        first (n-obj-ptr first-new)
        first-left (n-store! (n-obj-mem first-new 0) first (bt-null) left-alias)
        first-right (n-store! (n-obj-mem first-new 1) first (bt-null) right-alias)
        second-new (n-new-obj2! (g-start) tree-shape first-left first-right)
        second (n-obj-ptr second-new)
        second-left (n-store! (n-obj-mem second-new 0) second (bt-null) left-alias)
        second-right (n-store! (n-obj-mem second-new 1) second (bt-null) right-alias)
        parent-new (n-new-obj2! (g-start) tree-shape second-left second-right)
        parent (n-obj-ptr parent-new)
        parent-left (n-store! (n-obj-mem parent-new 0) parent first left-alias)
        parent-right (n-store! (n-obj-mem parent-new 1) parent second right-alias)
        merged (n-memmerge2! parent-left parent-right)
        loaded (n-load! merged parent (if swap right-alias left-alias))
        ret (n-new3 OP-RETURN 0 (g-start) (bt-bin OP-EQ loaded first) merged)]
    (n-add-def! (g-stop) ret) (g-analyze!) 0))

(defn neg-find-long-tree-call [] (-> i64)
  (let [(mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) (n-count)) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-CALL)
                          (and (= (n-op (n-in (load i) 1)) OP-FUN)
                               (and (= (n-aux (n-in (load i) 1)) 0)
                                    (= (n-op (n-in (load i) 2)) OP-ARG)))))
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(deftest focused_binarytrees_mutations_are_observable
  (let [(mut kind) 0]
    (loop
      (if (> (load kind) 5) (break)
        (do (let [caught (neg-run-caught! (load kind))]
              (if caught 0 (do (fmt (stderr) "uncaught binarytrees mutation {d}\n" (load kind)) 0))
              (assert caught))
            (store! kind (+ (load kind) 1)) 0)))))

(deftest exchanging_left_and_right_offsets_is_observable_on_distinct_children
  (build-asymmetric-field-check! false)
  (assert (= (ev-run-bound 1 100000) EV-OK))
  (assert (= (rt-payload (ev-result)) 1))
  (build-asymmetric-field-check! true)
  (assert (= (ev-run-bound 1 100000) EV-OK))
  (assert (= (rt-payload (ev-result)) 0)))

(deftest assigning_the_long_lived_root_to_a_caller_saved_register_is_rejected
  (binarytrees-build! 2510)
  (let [long-call (neg-find-long-tree-call)]
    (assert (!= long-call NO-NODE))
    (assert (be-select-machine-program!))
    (assert (> (be-schedule!) 0))
    (assert (>= (be-color! 8) 0))
    (let [root (ms-vget 0 long-call)]
      (assert (ml-live-after? 18 root))
      (mra-corrupt-reg! root 0)
      (assert (not (mra-verify!)))
      (assert (= (mra-result) MRA-INTERFERENCE)))))
