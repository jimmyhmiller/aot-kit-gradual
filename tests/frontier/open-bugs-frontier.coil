(module openbugsfrontier)
;; ONE GENUINELY FAILING TEST PER BUG THIS COMPILER STILL HAS.
;;
;;   coil test --suite frontier
;;
;; Every case here asserts the CORRECT answer -- the one node gives -- so every case is RED today.
;; That is the point. A test that asserts a bug is PRESENT is a test of the bug list rather than of
;; the compiler: fixing the bug turns a green thing red, and the remedy is to go edit a test, which
;; teaches exactly the wrong reflex. These go the other way. Fix the bug and the test goes green and
;; then simply stays, as the regression test it already was. Nothing is promoted, nothing deleted.
;;
;; IT IS OUT OF THE EVERYDAY GATE ON PURPOSE, declared `default = false` in Coil.toml. A permanently
;; red `coil test` stops answering the question the gate exists for -- did MY change break something
;; -- and the answer to that is not "get used to eight failures". What watches this corpus on every
;; gate instead is `tests/native-frontier-test.coil`: it derives each bug's status and compares
;; `docs/NATIVE-FRONTIER.md` byte for byte, so a bug that gets fixed, regressed, or merely changes
;; how it is broken turns the GATE red with a diff naming the file.
;;
;; THE CORPUS IS `repros/open/`, and that file is the bug report: each carries its own diagnosis and
;; node's answer for `main(7)`. Adding a bug means adding a file AND a case here; the default suite
;; refuses to pass if those two disagree, so neither can drift.
(import "nativeharness" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.slice" :use *)

;; `nh-agrees-with-node?` is not usable here: it asserts its way through the pipeline, so a repro
;; the frontend REFUSES dies with a backend assertion rather than saying which bug is open. This
;; reports the status and fails on anything that is not agreement.
(defn frontier-agrees? [(path (slice u8))] (-> bool)
  (let [a (malloc-allocator)
        source (nh-read-text a path)
        status (nh-status source 7)]
    (if (= status NH-AGREES)
        true
        (do (fmt (stderr) "STILL OPEN -- {s}: {s}\n  Read the file: it carries the diagnosis and node's answer for main(7).\n"
                 path (nh-status-name status))
            false))))

(deftest closure_capturing_a_loop_variable
  (assert (frontier-agrees? "repros/open/closure-capturing-a-loop-variable.js")))

(deftest for_await_has_no_bridge_kind
  (assert (frontier-agrees? "repros/open/for-await-has-no-bridge-kind.js")))

(deftest for_of_destructuring_pattern
  (assert (frontier-agrees? "repros/open/for-of-destructuring-pattern.js")))

(deftest for_of_into_an_existing_binding
  (assert (frontier-agrees? "repros/open/for-of-into-an-existing-binding.js")))

(deftest rest_parameters_are_unimplemented
  (assert (frontier-agrees? "repros/open/rest-parameters-are-unimplemented.js")))

(deftest shortest_round_trip_digits
  (assert (frontier-agrees? "repros/open/shortest-round-trip-digits.js")))
