;; Host-native byte selection for tests that execute generated code directly. Structural backend
;; tests continue to call the AArch64 encoder explicitly; only CPU execution goes through here.
(module native_code_test_support)

(import "backend_aarch64" :use *)
(import "backend_x64" :use *)
(import "backend_macho" :use *)
(import "backend_elf" :use *)

(extern aot_mmap_anon_flags :cc c [] (-> i32))
(extern aot_host_is_x86_64 :cc c [] (-> i32))

(defn host-native-encode-checked! [] (-> bool)
  (if (!= (aot_host_is_x86_64) (cast i32 0))
      (be-x64-encode-checked!)
      (be-encode-checked!)))

(defn host-native-object-checked! [] (-> bool)
  (if (!= (aot_host_is_x86_64) (cast i32 0))
      (be-elf-checked!)
      (be-macho-checked!)))

(defn host-native-x64? [] (-> bool)
  (!= (aot_host_is_x86_64) (cast i32 0)))

(defn host-native-code-len [] (-> i64)
  (if (!= (aot_host_is_x86_64) (cast i32 0))
      (be-x64-code-len)
      (be-code-len)))

(defn host-native-code-byte [(at i64)] (-> i64)
  (if (!= (aot_host_is_x86_64) (cast i32 0))
      (be-x64-code-byte at)
      (be-code-byte at)))

(defn host-native-mmap-flags [] (-> i32)
  (aot_mmap_anon_flags))
