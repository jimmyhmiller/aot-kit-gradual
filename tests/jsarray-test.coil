(module jsarraytest)

(import "jsarray" :use *)
(import "jsobject" :use *)
(import "jsvalue" :use *)
(import "shape" :use *)
(import "coil.assert" :use *)

(defn reset [] (-> i64) (shape-reset!) (jso-reset!) (jsa-reset!))

(deftest dense_storage_grows_without_changing_identity
  (reset)
  (let [array (jsa-new!) object (jsa-object array)]
    (assert (= (jsa-store! array 0 (jsv-box-int 1)) JSA-OK))
    (assert (= (jsa-store! array 9 (jsv-box-int 10)) JSA-OK))
    (assert (= (jsa-object array) object))
    (assert (= (jsa-length array) 10))
    (assert (>= (jsa-capacity array) 10))
    (assert (= (jsa-load array 9) (jsv-box-int 10)))))

(deftest holes_are_absent_and_read_as_undefined
  (reset)
  (let [array (jsa-new!)]
    (jsa-store! array 3 (jsv-box-int 4))
    (assert (= (jsa-length array) 4))
    (assert (not (jsa-present? array 1)))
    (assert (= (jsa-load array 1) JSV-UNDEFINED))
    (assert (= (jsa-load array 20) JSV-UNDEFINED))))

(deftest push_pop_and_slice_preserve_values_and_holes
  (reset)
  (let [array (jsa-new!)]
    (assert (= (jsa-push! array (jsv-box-int 2)) 1))
    (assert (= (jsa-push! array (jsv-box-int 3)) 2))
    (assert (= (jsa-pop! array) (jsv-box-int 3)))
    (jsa-store! array 3 (jsv-box-int 5))
    (let [copy (jsa-slice! array 0 4)]
      (assert (= (jsa-length copy) 4))
      (assert (= (jsa-load copy 0) (jsv-box-int 2)))
      (assert (not (jsa-present? copy 1)))
      (assert (= (jsa-load copy 3) (jsv-box-int 5))))))

(deftest non_index_keys_use_ordinary_property_storage
  (reset)
  (let [array (jsa-new!)]
    (assert (= (jsa-property-store! array "-1" (jsv-box-int 20)) JSO-OK))
    (assert (= (jsa-property-store! array "1.5" (jsv-box-int 30)) JSO-OK))
    (assert (= (jsa-length array) 0))
    (assert (= (jsa-property-load array "-1") (jsv-box-int 20)))
    (assert (= (jsa-property-load array "1.5") (jsv-box-int 30)))))

(deftest disabled_growth_falsifies_the_growth_witness
  (reset)
  (let [array (jsa-new!)]
    (store! (jsa-disable-growth-ptr) true)
    (assert (= (jsa-store! array 4 (jsv-box-int 5)) JSA-BAD-INDEX))
    (assert (= (jsa-length array) 0))))
