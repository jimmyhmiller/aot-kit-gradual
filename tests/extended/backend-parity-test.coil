(module backendparityextendedtest)

(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_aarch64" :use *)
(import "testmatrix" :use *)
(import "coil.assert" :use *)

(deftest unsupported_opcode_diagnostic_is_stable_across_the_extended_seed_matrix
         (let [(mut i) 0]
           (loop (if (>= (load i) MATRIX-EXTENDED-SEEDS)
                     (break)
                     (do
                       (graph-reset! (matrix-extended-seed (load i)))
                       (let [zero (n-new1 OP-CONST (t-int-con 0) (g-start))
                             value (n-new2 OP-NOT 0 NO-NODE zero)
                             ret (n-new2 OP-RETURN 0 (g-start) value)]
                         (n-add-def! (g-stop) ret)
                         (g-analyze!)
                         (assert (= (g-verify) 0))
                         (assert (not (be-select-program!)))
                         (assert (= (be-result) BER-UNSUPPORTED-OPCODE))
                         (assert (= (be-result-node) value))
                         (assert (= (be-code-len) 0)))
                       (store! i (+ (load i) 1))
                       0)))))
