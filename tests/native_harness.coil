(module nativeharness)
(import "coil.primitive" :as primitive)
;; THE PRODUCT PATH, EXECUTED, AS A REUSABLE PIECE: TypeScript source in, a running arm64 binary
;; out, and node's answer beside it.
;;
;; This began inside `tests/native-execution-test.coil` as nine hand-written cases. It moved here
;; when `tests/native-differential-test.coil` started asking the same question of every method the
;; frontend dispatches -- a couple of hundred programs rather than nine -- and at that scale the
;; two costs the original paid per case stopped being affordable:
;;
;;   1. IT RECOMPILED `native/gc/runtime.c` FOR EVERY PROGRAM. 0.25s each, against 0.05s to link an
;;      object that is already compiled. The runtime, the trampoline and the driver are the same
;;      bytes for every case; they are built once here and linked thereafter.
;;   2. IT SPAWNED A NODE PER PROGRAM. `native/js-oracle/oracle.c` keeps ONE node alive and talks to
;;      it down a pipe -- 0.076ms per case against 63ms of process startup, which is the measurement
;;      that file was written for. It survived the evaluator's deletion unused; this is its caller.
;;
;; THE DRIVER TAKES THE ARGUMENT FROM `argv`, which is what lets it be compiled once. Baking the
;; argument into its source, as the first version did, made the driver part of the per-case work.
(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "typescriptnative" :use *)
(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "backend_x64" :use *)
(import "backend_elf" :use *)
(import "coil.assert" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.control" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :use *)
(import "monotonic" :as monotonic)

(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern fwrite :cc c [(ptr u8) i64 i64 (ptr u8)] (-> i64))
(extern fclose :cc c [(ptr u8)] (-> i32))
(extern popen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern pclose :cc c [(ptr u8)] (-> i32))
(extern fgets :cc c [(ptr i8) i32 (ptr u8)] (-> (ptr i8)))
(extern atoll :cc c [(ptr i8)] (-> i64))
(extern system :cc c [(ptr i8)] (-> i32))
(extern getpid :cc c [] (-> i32))
(extern unlink :cc c [(ptr i8)] (-> i32))
(extern aot_host_is_x86_64 :cc c [] (-> i32))
(extern aot_mmap_anon_flags :cc c [] (-> i32))
(extern mmap :cc c [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect :cc c [(ptr u8) i64 i32] (-> i32))
(extern munmap :cc c [(ptr u8) i64] (-> i32))
(extern sys_icache_invalidate :cc c [(ptr u8) i64] (-> void))
(extern aot_gc_configure :cc c [i64 i32] (-> i32))
(extern aot_gc_register_unit :cc c [(ptr u8) (ptr u8) (ptr u8)] (-> i64))
(extern aot_gc_runtime_symbol :cc c [i32] (-> i64))
(extern aot_gc_enter1 :cc c [(ptr u8) i64] (-> i64))
;; native/js-oracle/oracle.c, on the link line through Coil.toml's `[cc] sources`.
(extern js_oracle_run :cc c [(ptr i8) i64 i64 (ptr i8) i64] (-> i32))

(defn nh-now-ns [] (-> i64)
  (monotonic/monotonic-now-ns))

;; Exhaustive graph verification is a test/debug policy, not an inseparable frontend phase.
;; Default it on so every existing native test keeps its current guarantees; corpus tools that
;; measure production throughput must opt out explicitly.
(defstruct NhPolicy [(verify-graph bool) (inited bool)])
(defn nh-policy [] (-> (ptr NhPolicy))
  (let [p (primitive/alloc-static NhPolicy)]
    (if (.inited p)
        0
        (do (set! (.verify-graph p) true) (set! (.inited p) true) 0))
    p))
(defn nh-use-graph-verification! [(enabled bool)] (-> i64)
  (set! (.verify-graph (nh-policy)) enabled)
  (be-use-verification! enabled)
  0)
(defn nh-graph-verification? [] (-> bool)
  (.verify-graph (nh-policy)))

(defn nh-timing! [(phase (slice u8)) (started i64)] (-> i64)
  (let [now (nh-now-ns)]
    (fmt (stderr) "AOTK_TIMING phase={s} ns={d}\n" phase (- now started))
    now))

;; A NUL-terminated C string in a caller buffer.
(defn nh-cstr! [(buf (ptr i8)) (cap i64) (s (slice u8))] (-> (ptr i8))
  (let [fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf) (set! (.cap fb) cap) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (fmt w "{s}" s)
    (set! (index buf (load (field fb len))) (cast i8 0))
    buf))

(defn nh-process-path! [(buf (ptr i8)) (cap i64) (suffix (slice u8))] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf) (set! (.cap fb) cap) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (fmt w "/tmp/aotk-native-{d}{s}" (cast i64 (getpid)) suffix)
    (let [len (load (field fb len))]
      (set! (index buf len) (cast i8 0))
      (slice-new [u8] (cast (ptr u8) buf) len))))

;; Run one shell command and read the first line as an integer.
;;
;; A CRASH IS NOT THE ANSWER 0, and for a long time this function said it was: a segfaulting
;; program prints nothing, `fgets` leaves the buffer empty, and `atoll("")` is 0. Every probe
;; whose expected answer happened to be 0 then PASSED on a program that never ran, and a probe
;; expecting anything else reported "ours=0" -- which reads as a wrong computation and sent the
;; search after the arithmetic instead of after the crash. `main(n) { let f = () => n; f();
;; return 42; }` took SIGSEGV and was reported as answering 0.
;;
;; `pclose` returns the child's wait status, and the driver returns 0 on every path it completes.
;; Anything else -- a signal, a non-zero exit, or no output line at all -- is NOT an answer.
;;
;; TWO ENTRY POINTS, because two suites want different things from that fact. The execution suite
;; wants to die on it, loudly and immediately; `tests/native-frontier-test.coil` wants to RECORD it,
;; because a program that crashes is one of the ways an open bug is open.
(defn nh-shell-answer [(cmd (ptr i8)) (ok (ptr bool))] (-> i64)
  (let [mode (primitive/alloc-stack (array i8 8))
        out (primitive/alloc-stack (array i8 256))]
    (set! (index (cast (ptr i8) out) 0) (cast i8 0))
    (let [spawn-start (nh-now-ns)
          p (popen cmd (nh-cstr! (cast (ptr i8) mode) 8 "r"))
          _ (nh-timing! "native_spawn" spawn-start)]
      (assert (!= (cast i64 p) 0))
      (let [output-start (nh-now-ns)
            line (fgets (cast (ptr i8) out) 256 p)
            _ (nh-timing! "native_to_first_output" output-start)
            reap-start (nh-now-ns)
            status (pclose p)
            _ (nh-timing! "native_reap" reap-start)]
        (if (or (= (cast i64 line) 0) (!= (cast i64 status) 0))
            (do (set! ok false) 0)
            (do (set! ok true) 0))
        (atoll (cast (ptr i8) out))))))

(defn nh-shell-integer [(cmd (ptr i8))] (-> i64)
  (let [ok (primitive/alloc-stack bool)
        answer (do (set! ok true) (nh-shell-answer cmd ok))]
    (if (load ok)
        answer
        (do (fmt (stderr) "native-harness: the compiled program did not answer\n")
            (panic-corrupt "native-harness: the compiled program crashed or printed nothing")
            0))))

(defn nh-run-shell! [(text (slice u8))] (-> i64)
  (let [cmd (primitive/alloc-stack (array i8 4096))]
    (cast i64 (system (nh-cstr! (cast (ptr i8) cmd) 4096 text)))))

(defn nh-store-u32! [(p (ptr u8)) (at i64) (v i64)] (-> i64)
  (set! (index p at) (cast u8 v))
  (set! (index p (+ at 1)) (cast u8 (>> v 8)))
  (set! (index p (+ at 2)) (cast u8 (>> v 16)))
  (set! (index p (+ at 3)) (cast u8 (>> v 24)))
  0)

(defn nh-store-u64! [(p (ptr u8)) (at i64) (v i64)] (-> i64)
  (nh-store-u32! p at v)
  (nh-store-u32! p (+ at 4) (>> v 32))
  0)

(defn nh-runtime-target [(m (ptr MInst))] (-> i64)
  (case (.op m)
    MI-NEW (aot_gc_runtime_symbol 0)
    MI-JSPROP (aot_gc_runtime_symbol 1)
    MI-JSARRAY (case (.imm m)
                 1 (aot_gc_runtime_symbol 3)
                 2 (aot_gc_runtime_symbol 4)
                 3 (aot_gc_runtime_symbol 5)
                 (aot_gc_runtime_symbol 2))
    MI-JSSTRING (aot_gc_runtime_symbol 6)
    0))

(defn nh-runtime-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)]
    (case (.op m)
      MI-NEW (mobj-new-branch-pc at)
      MI-JSPROP (mobj-jsprop-branch-pc at)
      MI-JSARRAY (mobj-jsarray-branch-pc at)
      MI-JSSTRING (mobj-jsstring-branch-pc at)
      -1)))

;; Install the verified AArch64 code directly. Each external BL targets a nearby 16-byte veneer:
;; `ldr x16, #8; br x16; .quad target`. This avoids both the BL range limit and a native linker.
(defn nh-exec-memory-checked! [(arg i64) (ok (ptr bool))] (-> i64)
  (let [code-len (be-code-len)
        relocs (mobj-external-reloc-count)
        image-len (& (+ (+ code-len (* relocs 16)) 4095) -4096)
        mem (mmap (cast (ptr u8) 0) image-len 3 (aot_mmap_anon_flags) -1 0)]
    (if (= (cast i64 mem) -1)
        (do (set! ok false) 0)
        (let [(mut i) 0]
          (loop (if (>= (load i) code-len)
                    (break)
                    (do (set! (index mem (load i)) (cast u8 (be-code-byte (load i))))
                        (set! i (+ (load i) 1)) 0)))
          (let [(mut at) 0 (mut reloc) 0]
            (loop (if (>= (load at) (be-inst-count))
                      (break)
                      (do
                        (let [m (be-inst (load at))
                              pc (nh-runtime-branch-pc (load at))]
                          (if (and (>= pc 0)
                                   (or (!= (.op m) MI-NEW) (be-runtime-allocation?)))
                              (let [stub (+ code-len (* (load reloc) 16))
                                    delta (/ (- stub pc) 4)]
                                (nh-store-u32! mem pc (| 2483027968 (& delta 67108863)))
                                (nh-store-u32! mem stub 1476395088)
                                (nh-store-u32! mem (+ stub 4) 3592356352)
                                (nh-store-u64! mem (+ stub 8) (nh-runtime-target m))
                                (set! reloc (+ (load reloc) 1))
                                0)
                              0))
                        (set! at (+ (load at) 1))
                        0))))
          (let [obj (be-object-data)
                stackoff (cast i64 (mobj-u32 232))
                layoutoff (cast i64 (mobj-u32 312))
                kernel (+ (cast i64 mem) (mu-function-code-start 0))]
            (aot_gc_register_unit (cast (ptr u8) kernel)
                                  (cast (ptr u8) (+ (cast i64 obj) stackoff))
                                  (cast (ptr u8) (+ (cast i64 obj) layoutoff)))
            (if (or (!= (cast i64 (mprotect mem image-len 5)) 0)
                    (= (cast i64 (aot_gc_configure 1048576 0)) 0))
                (do (set! ok false) 0)
                (do
                  (sys_icache_invalidate mem image-len)
                  (set! ok true)
                  (let [answer (aot_gc_enter1 (cast (ptr u8) kernel) arg)]
                    (aot_gc_register_unit (cast (ptr u8) 0) (cast (ptr u8) 0) (cast (ptr u8) 0))
                    (munmap mem image-len)
                    answer))))))))

;; ---------------------------------------------------------------------------
;; Leg 1: source -> graph -> machine code
;; ---------------------------------------------------------------------------
;; Compile WITHOUT asserting, for a caller choosing between candidate programs. Returns true when
;; machine code came out the other end.
(defn nh-try-compile? [(source (slice u8))] (-> bool)
  (block :done
    (let [(mut phase-start) (nh-now-ns)]
    (graph-reset! 7001)
    (shape-reset!)
    (jss-reset!)
    (let [(mut fe) (fe-native-new source)]
      (let [status (fe-native-index! (mut fe))]
        (set! phase-start (nh-timing! "frontend_index" (load phase-start)))
        (if (!= status FE-OK)
            (do (fmt (stderr)
                     "native-harness: frontend status={d} code={d} node={d}: {s}\n"
                     status (.error-code fe) (.error-node fe)
                     (ts-text (.ast fe) (.error-node fe)))
                (fe-native-free! (mut fe))
                (return-from :done false))
            0))
      (frontend-native-build! (mut fe) 7001 true)
      (set! phase-start (nh-timing! "frontend_graph" (load phase-start)))
      (fe-native-free! (mut fe)))
    (let [violations (if (nh-graph-verification?) (g-verify) 0)]
      (set! phase-start (nh-timing! "graph_verify" (load phase-start)))
      (if (!= violations 0)
          (do (fmt (stderr) "native-harness: verify violations={d}\n" violations)
              (g-verify-print (stderr))
              (let [failed (g-verify-node)]
                (if (and (>= failed 0) (< failed (n-count)))
                    (do (n-print-flat (stderr) failed)
                        (let [(mut input) 0]
                          (loop (if (>= (load input) (n-nins failed))
                                    (break)
                                    (do (let [value (n-in failed (load input))]
                                          (if (and (>= value 0) (< value (n-count)))
                                              (n-print-flat (stderr) value)
                                              0))
                                        (set! input (+ (load input) 1))))))
                        0)
                    0))
              (return-from :done false))
          0))
    (let [selected (be-select-verified-machine-program!)]
    (set! phase-start (nh-timing! "selection" (load phase-start)))
    (if (not selected)
        (do (fmt (stderr) "native-harness: selection code={d} node={d} machine={d}/{d}\n"
                 (be-result) (be-result-node) (ms-result) (ms-result-item))
            ;; Verifier failures carry a machine-instruction index. Terminator failures also need
            ;; their complete block: one instruction alone cannot distinguish a missing,
            ;; duplicate, misplaced, or wrong-kind terminator.
            (if (ms-result-item-is-machine?)
                (do
                  (ms-print-inst (stderr) (ms-result-item))
                  (if (and (= (ms-result) MSEL-TERMINATOR)
                           (and (>= (ms-result-item) 0)
                                (< (ms-result-item) (be-inst-count))))
                      (ms-print-block (stderr) (ms-inst-block (ms-result-item)))
                      0))
                ;; GCM/placement already reports machine instruction indices while construction's
                ;; phase marker still names the ideal domain. Show the in-range candidate as well;
                ;; the ideal-node diagnostic below remains available when the item really is one.
                (if (and (= (ms-result) MSEL-DEPENDENCY)
                         (and (>= (ms-result-item) 0)
                              (< (ms-result-item) (be-inst-count))))
                    (do
                      (ms-print-inst (stderr) (ms-result-item))
                      (let [machine-node (ms-inst-node (ms-result-item))]
                        (if (and (>= machine-node 0) (< machine-node (n-count)))
                            (n-print-flat (stderr) machine-node)
                            0))
                      0)
                    0))
            (if (and (>= (be-result-node) 0) (< (be-result-node) (n-count)))
                (let [failed (be-result-node)]
                  (n-print-flat (stderr) failed)
                  (if (> (n-nins failed) 1)
                      (let [input (n-in failed 1)]
                        (n-print-flat (stderr) input)
                        (if (> (n-nins input) 1)
                            (n-print-flat (stderr) (n-in input 1))
                            0))
                      0))
                0)
            (return-from :done false))
        0))
    (be-use-runtime-allocation! true)
    (be-schedule!)
    (set! phase-start (nh-timing! "scheduling" (load phase-start)))
    (let [colored (be-color! 10)]
    (set! phase-start (nh-timing! "allocation" (load phase-start)))
    (if (< colored 0)
        (do (fmt (stderr) "native-harness: allocation code={d} node={d}\n"
                 (be-result) (be-result-node))
            (return-from :done false))
        0))
    (if (!= (aot_host_is_x86_64) (cast i32 0))
        (let [encoded (be-x64-encode-checked!)]
          (set! phase-start (nh-timing! "x86_encoding" (load phase-start)))
        (if (not encoded)
            (do (fmt (stderr) "native-harness: x64 encode code={d} node={d}\n"
                     (be-result) (be-result-node))
                (return-from :done false))
            (let [published (be-elf-checked!)]
              (set! phase-start (nh-timing! "elf_publication" (load phase-start)))
              (if published true
                  (do (fmt (stderr) "native-harness: ELF emission failed\n") false)))))
        (let [encoded (be-encode-checked!)]
          (set! phase-start (nh-timing! "aarch64_encoding" (load phase-start)))
        (if (not encoded)
            (do (fmt (stderr) "native-harness: AArch64 encode code={d} node={d}\n"
                     (be-result) (be-result-node))
                (return-from :done false))
            (let [published (be-macho-checked!)]
              (set! phase-start (nh-timing! "macho_publication" (load phase-start)))
            (if published
                true
                (do (fmt (stderr) "native-harness: Mach-O emission failed\n") false)))))))))

(defn nh-compile! [(source (slice u8))] (-> i64)
  (graph-reset! 7001)
  (shape-reset!)
  (jss-reset!)
  (let [(mut fe) (fe-native-new source)]
    (assert (= (fe-native-index! (mut fe)) FE-OK))
    (frontend-native-build! (mut fe) 7001 true)
    (fe-native-free! (mut fe)))
  (let [violations (g-verify)]
    (if (> violations 0) (g-verify-print (stderr)) 0)
    (assert (= violations 0)))
  (let [selected (be-select-verified-machine-program!)]
    (if (not selected)
        (do (fmt (stderr) "native-harness: selection code={d} node={d} machine={d}/{d} cfg={d}/{d}\n"
                 (be-result) (be-result-node) (ms-result) (ms-result-item)
                 (mu-verify-result) (mu-verify-item))
            (mu-dump (stderr))
            (g-print-flat (stderr))
            0)
        0)
    (assert selected))
  ;; An allocation must call the collector rather than bumping thread state nothing initialised;
  ;; see the note in linked-object-test. Harmless for a program that allocates nothing.
  (be-use-runtime-allocation! true)
  (be-schedule!)
  (assert (>= (be-color! 10) 0))
  (if (!= (aot_host_is_x86_64) (cast i32 0))
      (do
        (if (not (be-x64-encode-checked!))
            (do
              (fmt (stderr) "native-harness: x64 encode failed result={d} node={d}\n"
                   (be-result) (be-result-node))
              0)
            0)
        (assert (= (be-result) BER-OK))
        (assert (be-elf-checked!)))
      (do (assert (be-encode-checked!)) (assert (be-macho-checked!))))
  0)

;; ---------------------------------------------------------------------------
;; Leg 2: object -> linked binary -> answer
;; ---------------------------------------------------------------------------
;; THE KERNEL IS ENTERED THROUGH `aot_gc_enter`, never called directly, and the collector is
;; configured first -- the same protocol linked-object-test uses. A program that allocates nothing
;; pays only the entry, and one that does allocate needs the stack base the entry records.
;;
;; `native/gc/runtime.c` is on the link line for every case, because that is where every `%`
;; primitive lives: a string operation compiles to a `BL` at `_aot_js_string`, and without the
;; runtime the link fails rather than the program misbehaving.
(defn nh-prebuilt? [] (-> (ptr bool))
  (let [done (primitive/alloc-static bool)] done))

(defn nh-prebuilt-current? [] (-> bool)
  (= (nh-run-shell!
       "test -f /tmp/aotk-memory-driver && test /tmp/aotk-memory-driver -nt native/gc/in-memory-driver.c && test /tmp/aotk-memory-driver -nt native/gc/runtime.c && test /tmp/aotk-memory-driver -nt native/gc/trampoline.S")
     0))

(defn nh-prepare! [] (-> i64)
  (if (load (nh-prebuilt?))
      0
      (if (nh-prebuilt-current?)
          (do (set! (nh-prebuilt?) true) 0)
          (do
        (set! (nh-prebuilt?) true)
        (assert (= (nh-run-shell!
          (if (!= (aot_host_is_x86_64) (cast i32 0))
              "clang -O1 -fno-omit-frame-pointer -Inative/gc -c native/gc/driver.c -o /tmp/aotk-driver.$$.o && clang -O1 -fno-omit-frame-pointer -Inative/gc -c native/gc/runtime.c -o /tmp/aotk-runtime.$$.o && clang -c native/gc/trampoline.S -o /tmp/aotk-trampoline.$$.o && mv /tmp/aotk-driver.$$.o /tmp/aotk-driver.o && mv /tmp/aotk-runtime.$$.o /tmp/aotk-runtime.o && mv /tmp/aotk-trampoline.$$.o /tmp/aotk-trampoline.o"
              "xcrun clang -arch arm64 -O1 -fno-omit-frame-pointer -DAOT_IN_MEMORY_HOST=1 -Inative/gc native/gc/in-memory-driver.c native/gc/runtime.c native/gc/trampoline.S -o /tmp/aotk-memory-driver.$$.bin && mv /tmp/aotk-memory-driver.$$.bin /tmp/aotk-memory-driver"))
          0))
        0))))

;; LINKING AND RUNNING ARE SEPARATE, and the reason is a macOS cost with a sharp edge: the FIRST
;; execution of a freshly linked binary takes ~0.69s while the system assesses it, and every
;; execution after that takes 3ms. Measured, repeatedly, on this machine. A suite that links one
;; binary per case therefore pays 0.7s per case no matter how small the program is -- which is what
;; made a differential over every method in the frontend look unaffordable at three minutes.
;;
;; `tests/native-differential-test.coil` links ONE binary whose `main` selects a case from its
;; argument, and then runs it once per case. One assessment, N runs.
(defn nh-link! [] (-> i64)
  (nh-prepare!)
  (let [object-buf (primitive/alloc-stack (array i8 128))
        binary-buf (primitive/alloc-stack (array i8 128))
        error-buf (primitive/alloc-stack (array i8 128))
        mode-buf (primitive/alloc-stack (array i8 8))
        command-buf (primitive/alloc-stack (array i8 1024))
        object (nh-process-path! (cast (ptr i8) object-buf) 128 ".o")
        binary (nh-process-path! (cast (ptr i8) binary-buf) 128 "")
        error (nh-process-path! (cast (ptr i8) error-buf) 128 ".err")]
    (let [object-start (nh-now-ns)
          f (fopen (cast (ptr i8) (slice-data object))
                   (nh-cstr! (cast (ptr i8) mode-buf) 8 "w"))]
      (assert (!= (cast i64 f) 0))
      (fwrite (be-object-data) 1 (be-object-len) f)
      (fclose f)
      (nh-timing! "object_write" object-start))
    (if (= (aot_host_is_x86_64) (cast i32 0))
        0
        (let [fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
      (set! (.data fb) (cast (ptr i8) command-buf))
      (set! (.cap fb) 1024) (set! (.len fb) 0)
      (fixed-buffer-writer w fb)
      (if (!= (aot_host_is_x86_64) (cast i32 0))
          (fmt w "clang /tmp/aotk-driver.o /tmp/aotk-runtime.o /tmp/aotk-trampoline.o {s} -lm -o {s} 2>{s}"
               object binary error)
          (fmt w "xcrun clang -arch arm64 /tmp/aotk-driver.o /tmp/aotk-runtime.o /tmp/aotk-trampoline.o {s} -o {s} 2>{s}"
               object binary error))
      (let [link-start (nh-now-ns)
            status (nh-run-shell! (slice-new [u8]
                                             (cast (ptr u8) command-buf)
                                             (load (field fb len))))]
        (nh-timing! "clang_link" link-start)
        status)))))

(defn nh-exec-command! [(cmd (ptr i8)) (arg i64)] (-> i64)
  (let [binary-buf (primitive/alloc-stack (array i8 128))
        binary (nh-process-path! (cast (ptr i8) binary-buf) 128 "")
        fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
    (set! (.data fb) cmd)
    (set! (.cap fb) 256) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (if (!= (aot_host_is_x86_64) (cast i32 0))
        (fmt w "{s} {d}" binary arg)
        (let [object-buf (primitive/alloc-stack (array i8 128))
              object (nh-process-path! (cast (ptr i8) object-buf) 128 ".o")]
          (fmt w "/tmp/aotk-memory-driver {s} {d}" object arg)))
    (set! (index cmd (load (field fb len))) (cast i8 0))
    0))

(defn nh-cleanup! [] (-> i64)
  (let [buf (primitive/alloc-stack (array i8 128))]
    (unlink (cast (ptr i8) (slice-data (nh-process-path! (cast (ptr i8) buf) 128 ".o"))))
    (unlink (cast (ptr i8) (slice-data (nh-process-path! (cast (ptr i8) buf) 128 ".err"))))
    (unlink (cast (ptr i8) (slice-data (nh-process-path! (cast (ptr i8) buf) 128 ""))))
    0))

(defn nh-exec! [(arg i64)] (-> i64)
  (let [cmd (primitive/alloc-stack (array i8 256))]
    (nh-exec-command! (cast (ptr i8) cmd) arg)
    (nh-shell-integer (cast (ptr i8) cmd))))

;; The same run, with the crash reported rather than fatal. See `nh-shell-answer`.
(defn nh-exec-checked! [(arg i64) (ok (ptr bool))] (-> i64)
  (let [cmd (primitive/alloc-stack (array i8 256))]
    (nh-exec-command! (cast (ptr i8) cmd) arg)
    (nh-shell-answer (cast (ptr i8) cmd) ok)))

;; Batch Test262 execution needs a bound distinct from compilation: one nonterminating JavaScript
;; body must not consume the compile timeout or prevent the remaining entry points from running.
(defn nh-exec-checked-timeout! [(arg i64) (seconds i64) (ok (ptr bool))] (-> i64)
  (let [cmd (primitive/alloc-stack (array i8 256))
        binary-buf (primitive/alloc-stack (array i8 128))
        binary (nh-process-path! (cast (ptr i8) binary-buf) 128 "")
        fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
    (set! (.data fb) (cast (ptr i8) cmd))
    (set! (.cap fb) 256) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (if (!= (aot_host_is_x86_64) (cast i32 0))
        (fmt w "timeout --signal=KILL {d}s {s} {d}" seconds binary arg)
        (let [object-buf (primitive/alloc-stack (array i8 128))
              object (nh-process-path! (cast (ptr i8) object-buf) 128 ".o")]
          (fmt w "timeout --signal=KILL {d}s /tmp/aotk-memory-driver {s} {d}"
               seconds object arg)))
    (set! (index (cast (ptr i8) cmd) (load (field fb len))) (cast i8 0))
    (nh-shell-answer (cast (ptr i8) cmd) ok)))

(defn nh-run! [(arg i64)] (-> i64)
  (nh-link!)
  (nh-exec! arg))

;; ---------------------------------------------------------------------------
;; Leg 3: the same source, answered by node
;; ---------------------------------------------------------------------------
;; THE SAME TEXT GOES TO BOTH. The oracle strips the TypeScript annotations itself, so the frontend
;; and the engine read one identical source rather than two emitters that could drift apart -- a bug
;; in a node-only flavour would be invisible to the comparison meant to catch it.
;;
;; A JavaScript EXCEPTION comes back as a line beginning "ERR ", which is not an answer and must
;; never be compared against one: `atoll` would read it as 0 and a program that returns 0 would
;; agree with a program that threw.
(defn nh-node-answer [(source (slice u8)) (arg i64) (ok (ptr bool))] (-> i64)
  (let [buf (primitive/alloc-stack (array i8 65536))
        out (primitive/alloc-stack (array i8 4096))
        src (nh-cstr! (cast (ptr i8) buf) 65536 source)]
    (set! (index (cast (ptr i8) out) 0) (cast i8 0))
    (if (!= (cast i64 (js_oracle_run src (slice-len source) arg (cast (ptr i8) out) 4096)) 0)
        (do (fmt (stderr) "native-harness: the node oracle failed to answer\n")
            (set! ok false)
            0)
        (if (and (= (load (index (cast (ptr i8) out) 0)) (cast i8 69))
                 (= (load (index (cast (ptr i8) out) 1)) (cast i8 82)))
            (do (set! ok false) 0)
            (do (set! ok true) (atoll (cast (ptr i8) out)))))))

;; ---------------------------------------------------------------------------
;; The whole pipeline, as a STATUS rather than a yes/no
;; ---------------------------------------------------------------------------
;; `nh-agrees-with-node?` answers the execution suite's question -- is this right -- and dies on
;; anything that is not. `tests/native-frontier-test.coil` asks the opposite question of a KNOWN
;; BUG: is it still broken, and in which of the ways. Both walk the same three legs, so they share
;; them here rather than growing a second copy of the pipeline.
;;
;; `NH-AGREES` is the interesting one: for a frontier repro it is a FAILURE, because it means the
;; bug is fixed and the repro should be promoted to a real execution case.
(const NH-AGREES i64 0)
(const NH-DISAGREES i64 1)
(const NH-CRASHES i64 2)
(const NH-REFUSED i64 3)
(const NH-NODE-THREW i64 4)

(defn nh-status-name [(status i64)] (-> (slice u8))
  (case status
    NH-AGREES "agrees with node"
    NH-DISAGREES "disagrees"
    NH-CRASHES "crashes"
    NH-REFUSED "refused"
    NH-NODE-THREW "node throws"
    "?"))

(defn nh-status [(source (slice u8)) (arg i64)] (-> i64)
  (if (not (nh-try-compile? source))
      NH-REFUSED
      (if (!= (nh-link!) 0)
          NH-CRASHES
          (let [ok (primitive/alloc-stack bool)
                ours (do (set! ok true) (nh-exec-checked! arg ok))]
            (if (not (load ok))
                NH-CRASHES
                (let [node-ok (primitive/alloc-stack bool)
                      theirs (do (set! node-ok true) (nh-node-answer source arg node-ok))]
                  (if (not (load node-ok))
                      NH-NODE-THREW
                      (if (= ours theirs)
                          NH-AGREES
                          (do (fmt (stderr) "  ours={d} node={d}\n" ours theirs)
                              NH-DISAGREES)))))))))

;; The whole claim, in one function: compile it, run it, and ask node.
(defn nh-agrees-with-node? [(source (slice u8)) (arg i64)] (-> bool)
  (nh-compile! source)
  (let [ours (nh-run! arg)
        ok (primitive/alloc-stack bool)
        theirs (do (set! ok true) (nh-node-answer source arg ok))]
    (if (not (load ok))
        (do (fmt (stderr) "native-harness: node threw on\n  source: {s}\n" source) false)
        (if (= ours theirs)
            true
            (do (fmt (stderr)
                     "native-harness: ours={d} node={d} for arg {d}\n  source: {s}\n"
                     ours theirs arg source)
                false)))))

;; ---------------------------------------------------------------------------
;; The method surface, read out of the frontend's own dispatch tables
;; ---------------------------------------------------------------------------
;; Both tables are `cond` chains of `(= name "X")` inside one function, so the function name bounds
;; the region and every quoted name in it is a method the frontend dispatches. Reading the compiler
;; rather than a copy of it is the whole point: a copy is a second list to forget to update.
;;
;; Shared by `tests/native-capability-test.coil`, which asks whether each method COMPILES, and
;; `tests/native-differential-test.coil`, which asks whether it computes what node computes. Two
;; questions, one list, and it is the compiler's list.
(defn nh-read-text [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (try (let [text (try-or! (read-file a path)
                           (do (fmt (stderr) "native-harness: cannot read {s}\n" path) (abort) ""))]
         text)))

;; Coil's stdlib spells this as tail recursion, but the Linux no-LLVM compiler currently leaves
;; that recursion in the binary. Scanning the 200KB frontend then exhausts Linux's 8MB stack before
;; capability or differential collection reaches a case. Keep this source-sized walk explicit.
(defn nh-find-from [(hay (slice u8)) (needle (slice u8)) (start i64)] (-> (Option i64))
  (let [last (- (slice-len hay) (slice-len needle))
        (mut at) start
        (mut found) -1]
    (loop (if (> (load at) last)
              (break)
              (if (= (subslice hay (load at) (+ (load at) (slice-len needle))) needle)
                  (do (set! found (load at)) (break))
                  (set! at (+ (load at) 1)))))
    (if (< (load found) 0) (None) (Some (load found)))))

(defn nh-collect-names! [(text (slice u8)) (fn-header (slice u8)) (out (mut (ArrayList (slice u8))))
                         (arities (mut (ArrayList i64)))] (-> i64)
  (match (nh-find-from text fn-header 0)
    (None [] (do (fmt (stderr) "native-harness: `{s}` is gone from the frontend; this reads\n  the compiler's dispatch tables by name and one of them moved.\n" fn-header) (abort) 0))
    (Some [start]
      (let [after (+ start (slice-len fn-header))
            stop (match (nh-find-from text "\n(defn " after)
                   (Some [e] e)
                   (None [] (slice-len text)))
            (mut at) after]
        (loop (match (nh-find-from text "(= name \"" (load at))
                (None [] (break))
                (Some [hit]
                  (if (>= hit stop)
                      (break)
                      (let [from (+ hit 9)]
                        (match (nh-find-from text "\"" from)
                          (None [] (break))
                          (Some [end]
                            (al-push! [(slice u8)] (mut out)
                                      (slice-new [u8] (index (slice-data text) from) (- end from)))
                            ;; THE ARITY COMES OUT OF THE SAME LINE, and it is not decoration: a call
                            ;; the arity table does not accept reaches a lowering that ABORTS, which
                            ;; without a fork takes the suite down. Probing only accepted arities is
                            ;; what makes this safe to run. `-1` means the table states none (the
                            ;; array chain is `(= name "x") true`), and every count is tried.
                            (al-push! [i64] (mut arities)
                                      (match (nh-find-from text "argc " end)
                                        (None [] -1)
                                        (Some [a]
                                          (if (> a (+ end 24))
                                              -1
                                              (- (cast i64 (slice-get text (+ a 5))) 48)))))
                            (set! at (+ end 1))
                            0)))))))
        0))))
