(module linkedobjecttest)
(import "coil.primitive" :as primitive)
;; THE LINKED OBJECT, EXECUTED. docs/DEFTESTS-OWED.md recorded this capability as lost when the
;; shell gates went: a deftest can mmap encoded bytes and call them, but the Mach-O container,
;; symbol table and relocations are only exercised by a real link, and a real link needs clang.
;;
;; It turns out a deftest CAN drive clang -- the same `popen` the node oracle already uses. The
;; object is written to disk, linked against a generated C harness, and run, so this covers the
;; whole path the mmap properties stop short of: be-macho-checked!, the symbol table, and the
;; relocations resolving against a C caller at a real ABI boundary.
(import "ty" :use *) (import "node" :use *) (import "verify" :use *)
(import "shape" :use *)
(import "shape" :use *)
(import "corpus" :use *)
(import "backend_core" :use *) (import "backend_select" :use *)
(import "backend_schedule" :use *) (import "backend_allocate" :use *)
(import "backend_aarch64" :use *) (import "backend_macho" :use *)
(import "native_code_test_support" :use *)
(import "coil.assert" :use *) (import "coil.io" :use *) (import "coil.fmt" :use *)
(import "coil.slice" :use *) (import "coil.alloc" :use * :as alloc) (import "coil.control" :use *)
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern fwrite :cc c [(ptr u8) i64 i64 (ptr u8)] (-> i64))
(extern fclose :cc c [(ptr u8)] (-> i32))
(extern popen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern pclose :cc c [(ptr u8)] (-> i32))
(extern fgets :cc c [(ptr i8) i32 (ptr u8)] (-> (ptr i8)))
(extern atoll :cc c [(ptr i8)] (-> i64))
;;; a NUL-terminated C string in a caller buffer
(defn cstr! [(buf (ptr i8)) (cap i64) (s (slice u8))] (-> (ptr i8))
  (let [fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf) (set! (.cap fb) cap) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (fmt w "{s}" s)
    (set! (index buf (load (field fb len))) (cast i8 0))
    buf))
(defn emit-and-run [(arg i64)] (-> i64)
  (let [b1 (primitive/alloc-stack (array i8 64)) b2 (primitive/alloc-stack (array i8 8)) b3 (primitive/alloc-stack (array i8 8))
        b4 (primitive/alloc-stack (array i8 2048)) out (primitive/alloc-stack (array i8 128))]
    (let [f (fopen (cstr! (cast (ptr i8) b1) 64 "/tmp/aotk-prop.o")
                   (cstr! (cast (ptr i8) b2) 8 "w"))]
      (assert (!= (cast i64 f) 0))
      (fwrite (be-object-data) 1 (be-object-len) f)
      (fclose f))
    (let [fb (primitive/alloc-stack FixBuf) w (primitive/alloc-stack Writer)]
      (set! (.data fb) (cast (ptr i8) b4))
      (set! (.cap fb) 2048) (set! (.len fb) 0)
      (fixed-buffer-writer w fb)
      (if (host-native-x64?)
          (fmt w "printf '#include <stdint.h>\\n#include <stdio.h>\\nextern int64_t kernel(int64_t);\\nint main(void){{printf(\"%%lld\\\\n\",(long long)kernel({d}));}}\\n' > /tmp/aotk-prop.c && clang /tmp/aotk-prop.c /tmp/aotk-prop.o -o /tmp/aotk-prop 2>/dev/null && /tmp/aotk-prop" arg)
          (fmt w "printf '#include <stdint.h>\\n#include <stdio.h>\\nextern int64_t kernel(int64_t);\\nint main(void){{printf(\"%%lld\\\\n\",(long long)kernel({d}));}}\\n' > /tmp/aotk-prop.c && xcrun clang -arch arm64 /tmp/aotk-prop.c /tmp/aotk-prop.o -o /tmp/aotk-prop 2>/dev/null && /tmp/aotk-prop" arg))
      (set! (index (cast (ptr i8) b4) (load (field fb len))) (cast i8 0)))
    (let [p (popen (cast (ptr i8) b4) (cstr! (cast (ptr i8) b3) 8 "r"))]
      (assert (!= (cast i64 p) 0))
      (fgets (cast (ptr i8) out) 128 p)
      (pclose p)
      (atoll (cast (ptr i8) out)))))

(defn build-linked-program! [(ops (slice u8))] (-> i64)
  (let [pool (primitive/alloc-stack (array i64 32))
        p (cast (ptr i64) pool)
        a0 (n-new1 (Arg (t-int)) (g-start))
        v0 (n-new3 (Add) NO-NODE a0 (n-new1 (Const (t-int-con 3)) (g-start)))]
    (set! (index p 0) v0)
    (let [(mut n) 1 (mut cur) v0 (mut k) 0
          limit (if (> (slice-len ops) 6) 6 (slice-len ops))]
      (loop (if (>= (load k) limit) (break)
              (let [b (cast i64 (slice-get ops (load k)))
                    other (if (= (% (/ b 4) 2) 0)
                              (n-new1 (Const (t-int-con (+ 1 (% (/ b 8) 7)))) (g-start))
                            (load (index p (% (/ b 8) (load n)))))]
                (set! cur (n-new3 (if (= (% b 2) 0) (Add) (Sub)) NO-NODE (load cur) other))
                (set! (index p (load n)) (load cur))
                (set! n (+ (load n) 1)) (set! k (+ (load k) 1)) 0)))
      (let [ret (n-new2 (Return) (g-start) (load cur))]
        (n-add-def! (g-stop) ret) (g-analyze!) ret))))

(defn linked-native [(ops (slice u8)) (arg i64)] (-> i64)
  (graph-reset! 909)
  (build-linked-program! ops)
  (assert (= (g-verify) 0))
  (assert (be-select-machine-program!))
  (be-schedule!)
  (assert (= (be-color! 8) 0))
  (assert (host-native-encode-checked!))
  (assert (host-native-object-checked!))
  (emit-and-run arg))

;;; AN ALLOCATING PROGRAM, LINKED AGAINST THE COLLECTOR AND RUN.
;;;
;;; The piece that made this work is `be-use-runtime-allocation!`. Without it the backend compiles an
;;; allocation to a pure inline bump against thread state nothing has initialised: the object carries
;;; ZERO relocations, links cleanly, and segfaults. With it the object calls `_aot_alloc_slow` and the
;;; collector is actually in the loop. A `_aot_alloc_slow` relocation is therefore the cheap signal
;;; that a generated allocation is the real thing -- asserted below, before anything is run.
;;;
;;; The kernel is entered through `aot_gc_enter`, never called directly. There is no heap argument;
;;; there is an entry protocol. `native/gc/` holds the collector, trampoline and header, restored
;;; from the deletion commit.
(defn gc-mem [(alias i64)] (-> i64) (n-new1 (Arg (t-mem-alias alias (t-top))) (g-start)))

(defn gc-run [] (-> i64)
  (let [b1 (primitive/alloc-stack (array i8 64)) b2 (primitive/alloc-stack (array i8 8)) b3 (primitive/alloc-stack (array i8 8))
        b4 (primitive/alloc-stack (array i8 2048)) out (primitive/alloc-stack (array i8 128))]
    (let [f (fopen (cstr! (cast (ptr i8) b1) 64 "/tmp/aotk-gc.o")
                   (cstr! (cast (ptr i8) b2) 8 "w"))]
      (assert (!= (cast i64 f) 0))
      (fwrite (be-object-data) 1 (be-object-len) f)
      (fclose f))
    (let [p (popen (cstr! (cast (ptr i8) b4) 2048
                          (if (host-native-x64?)
                              "printf '#include <stdint.h>\\n#include <stddef.h>\\n#include <stdio.h>\\nint aot_gc_configure(size_t,int);\\nextern int64_t kernel(void);\\nint64_t aot_gc_enter(int64_t(*)(void));\\nint main(void){if(!aot_gc_configure(4096,0))return 2;printf(\"%%lld\\\\n\",(long long)aot_gc_enter(kernel));}\\n' > /tmp/aotk-gc.c && clang -O1 -fno-omit-frame-pointer -Inative/gc /tmp/aotk-gc.c native/gc/runtime.c native/gc/trampoline.S /tmp/aotk-gc.o -lm -o /tmp/aotk-gc 2>/dev/null && /tmp/aotk-gc"
                              "printf '#include <stdint.h>\\n#include <stddef.h>\\n#include <stdio.h>\\nint aot_gc_configure(size_t,int);\\nextern int64_t kernel(void);\\nint64_t aot_gc_enter(int64_t(*)(void));\\nint main(void){if(!aot_gc_configure(4096,0))return 2;printf(\"%%lld\\\\n\",(long long)aot_gc_enter(kernel));}\\n' > /tmp/aotk-gc.c && xcrun clang -arch arm64 -O1 -fno-omit-frame-pointer -Inative/gc /tmp/aotk-gc.c native/gc/runtime.c native/gc/trampoline.S /tmp/aotk-gc.o -o /tmp/aotk-gc 2>/dev/null && /tmp/aotk-gc"))
                   (cstr! (cast (ptr i8) b3) 8 "r"))]
      (assert (!= (cast i64 p) 0))
      (fgets (cast (ptr i8) out) 128 p)
      (pclose p)
      (atoll (cast (ptr i8) out)))))

(deftest an_allocating_program_runs_under_the_collector
  (graph-reset! 1201) (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "x" (t-int)) ax (shape-field-alias sx 0)
        first (n-new-obj1! (g-start) sx (gc-mem ax)) root (n-obj-ptr first)
        mem1 (n-new4 (Store ax) NO-NODE (n-obj-mem first 0) root
                     (n-new1 (Const (t-int-con 41)) (g-start)))
        second (n-new-obj1! (g-start) sx mem1) other (n-obj-ptr second)
        mem2 (n-new4 (Store ax) NO-NODE (n-obj-mem second 0) other
                     (n-new1 (Const (t-int-con 2)) (g-start)))
        value (n-new3 (Load ax) NO-NODE mem2 root)
        ret (n-new3 (Return) (g-start) value mem2)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (= (g-verify) 0))
    (assert (be-select-machine-program!))
    (be-use-runtime-allocation! true)
    (be-schedule!)
    (assert (>= (be-color! 1) 0))
    (assert (host-native-encode-checked!))
    (assert (host-native-object-checked!))
    ;; two allocations, so two calls into the collector -- and the field written to the FIRST
    ;; object is the one read back, across a second allocation that could have moved it.
    (assert (= (gc-run) 41))))

(deftest a_generated_layout_slot_is_a_strong_traced_edge_of_a_weak_owner
  (graph-reset! 1202) (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "x" (t-int)) ax (shape-field-alias sx 0)
        owner-allocation (n-new-obj1! (g-start) sx (gc-mem ax))
        owner (n-obj-ptr owner-allocation)
        property-memory (gc-mem JS-PROPERTY-ALIAS)
        layout-id (n-new1 (Const (t-int-con 1)) (g-start))
        array-family-id (n-new1 (Const (t-int-con 2)) (g-start))
        get-method-id (n-new1 (Const (t-int-con 8)) (g-start))
        prototype-slot-id (n-new1 (Const (t-int-con 2)) (g-start))
        undefined-value (n-new1 (Const (t-undef)) (g-start))
        layout-memory (n-prop-store-key-operation-at!
                        (g-start) property-memory owner layout-id undefined-value 25)
        family-memory (n-prop-store-key-operation-at!
                        (g-start) layout-memory owner array-family-id undefined-value 31)
        target-allocation (n-new-obj1! (g-start) sx (n-obj-mem owner-allocation 0))
        target (n-obj-ptr target-allocation)
        target-memory (n-new4 (Store ax) NO-NODE (n-obj-mem target-allocation 0) target
                              (n-new1 (Const (t-int-con 42)) (g-start)))
        slot-memory (n-prop-store-key-operation-at!
                      (g-start) family-memory owner prototype-slot-id (n-box! target) 28)
        (mut allocation-memory) target-memory
        (mut i) 0]
    ;; 300 allocations exceed the 4 KiB test heap. `target` has no SSA use after its slot store, so
    ;; surviving collection and returning its field depends on the generated side-table edge.
    (loop (if (>= (load i) 300) (break)
            (let [garbage (n-new-obj1! (g-start) sx (load allocation-memory))]
              (set! allocation-memory (n-obj-mem garbage 0))
              (n-kill! (n-obj-ptr garbage))
              (set! i (+ (load i) 1)))))
    (let [boxed-target (n-prop-load-key-operation-at!
                         (g-start) slot-memory owner prototype-slot-id 27)
          moved-target (n-unbox! boxed-target (t-obj))
          value (n-new3 (Load ax) NO-NODE (load allocation-memory) moved-target)
          matches (n-new3 (Eq) NO-NODE value
                           (n-new1 (Const (t-int-con 42)) (g-start)))
          installed-family (n-prop-load-key-operation-at!
                            (g-start) slot-memory owner array-family-id 30)
          ordinary-get (n-prop-load-key-operation-at!
                         (g-start) slot-memory owner get-method-id 32)
          retained-and-installed (n-new3 (BitAnd) NO-NODE matches installed-family)
          result (n-new3 (BitAnd) NO-NODE retained-and-installed ordinary-get)
          ret (n-new3 (Return) (g-start) result (load allocation-memory))]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (if (!= (g-verify) 0) (g-verify-print (stderr)) 0)
      (assert (= (g-verify) 0))
      (assert (be-select-machine-program!))
      (be-use-runtime-allocation! true)
      (be-schedule!)
      (assert (>= (be-color! 4) 0))
      (assert (host-native-encode-checked!))
      (assert (host-native-object-checked!))
      (assert (= (gc-run) 1)))))
