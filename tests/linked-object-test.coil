(module linkedobjecttest)
;; THE LINKED OBJECT, EXECUTED. docs/DEFTESTS-OWED.md recorded this capability as lost when the
;; shell gates went: a deftest can mmap encoded bytes and call them, but the Mach-O container,
;; symbol table and relocations are only exercised by a real link, and a real link needs clang.
;;
;; It turns out a deftest CAN drive clang -- the same `popen` the node oracle already uses. The
;; object is written to disk, linked against a generated C harness, and run, so this covers the
;; whole path the mmap properties stop short of: be-macho-checked!, the symbol table, and the
;; relocations resolving against a C caller at a real ABI boundary.
(import "ty" :use *) (import "node" :use *) (import "verify" :use *)
(import "shape" :use *)
(import "corpus" :use *)
(import "eval" :use *)
(import "backend_core" :use *) (import "backend_select" :use *)
(import "backend_schedule" :use *) (import "backend_allocate" :use *)
(import "backend_aarch64" :use *) (import "backend_macho" :use *)
(import "coil.assert" :use *) (import "coil.io" :use *) (import "coil.fmt" :use *)
(import "coil.slice" :use *) (import "coil.alloc" :use *) (import "coil.control" :use *)
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern fwrite :cc c [(ptr u8) i64 i64 (ptr u8)] (-> i64))
(extern fclose :cc c [(ptr u8)] (-> i32))
(extern popen :cc c [(ptr i8) (ptr i8)] (-> (ptr u8)))
(extern pclose :cc c [(ptr u8)] (-> i32))
(extern fgets :cc c [(ptr i8) i32 (ptr u8)] (-> (ptr i8)))
(extern atoll :cc c [(ptr i8)] (-> i64))
;; a NUL-terminated C string in a caller buffer
(defn cstr! [(buf (ptr i8)) (cap i64) (s (slice u8))] (-> (ptr i8))
  (let [fb (stack FixBuf) w (stack Writer)]
    (store! (field fb data) buf) (store! (field fb cap) cap) (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (fmt w "{s}" s)
    (store! (index buf (load (field fb len))) (cast i8 0))
    buf))
(defn emit-and-run [(arg i64)] (-> i64)
  (let [b1 (stack (array i8 64)) b2 (stack (array i8 8)) b3 (stack (array i8 8))
        b4 (stack (array i8 2048)) out (stack (array i8 128))]
    (let [f (fopen (cstr! (cast (ptr i8) b1) 64 "/tmp/aotk-prop.o")
                   (cstr! (cast (ptr i8) b2) 8 "w"))]
      (assert (!= (cast i64 f) 0))
      (fwrite (be-object-data) 1 (be-object-len) f)
      (fclose f))
    (let [fb (stack FixBuf) w (stack Writer)]
      (store! (field fb data) (cast (ptr i8) b4))
      (store! (field fb cap) 2048) (store! (field fb len) 0)
      (fixed-buffer-writer w fb)
      (fmt w "printf '#include <stdint.h>\\n#include <stdio.h>\\nextern int64_t kernel(int64_t);\\nint main(void){{printf(\"%%lld\\\\n\",(long long)kernel({d}));}}\\n' > /tmp/aotk-prop.c && xcrun clang -arch arm64 /tmp/aotk-prop.c /tmp/aotk-prop.o -o /tmp/aotk-prop 2>/dev/null && /tmp/aotk-prop" arg)
      (store! (index (cast (ptr i8) b4) (load (field fb len))) (cast i8 0)))
    (let [p (popen (cast (ptr i8) b4) (cstr! (cast (ptr i8) b3) 8 "r"))]
      (assert (!= (cast i64 p) 0))
      (fgets (cast (ptr i8) out) 128 p)
      (pclose p)
      (atoll (cast (ptr i8) out)))))


(defn build-linked-program! [(ops (slice u8))] (-> i64)
  (let [pool (stack (array i64 32))
        p (cast (ptr i64) pool)
        a0 (n-new1 OP-ARG (t-int) (g-start))
        v0 (n-new3 OP-ADD 0 NO-NODE a0 (n-new1 OP-CONST (t-int-con 3) (g-start)))]
    (store! (index p 0) v0)
    (let [(mut n) 1 (mut cur) v0 (mut k) 0
          limit (if (> (slice-len ops) 6) 6 (slice-len ops))]
      (loop (if (>= (load k) limit) (break)
              (let [b (cast i64 (slice-get ops (load k)))
                    other (if (= (% (/ b 4) 2) 0)
                              (n-new1 OP-CONST (t-int-con (+ 1 (% (/ b 8) 7))) (g-start))
                            (load (index p (% (/ b 8) (load n)))))]
                (store! cur (n-new3 (if (= (% b 2) 0) OP-ADD OP-SUB) 0 NO-NODE (load cur) other))
                (store! (index p (load n)) (load cur))
                (store! n (+ (load n) 1)) (store! k (+ (load k) 1)) 0)))
      (let [ret (n-new2 OP-RETURN 0 (g-start) (load cur))]
        (n-add-def! (g-stop) ret) (g-analyze!) ret))))

(defn linked-eval [(ops (slice u8)) (arg i64)] (-> i64)
  (graph-reset! 909)
  (build-linked-program! ops)
  (assert (= (g-verify) 0))
  (ev-reset!)
  (let [nn (n-count) (mut i) 0 (mut a) NO-NODE]
    (loop (if (or (>= (load i) nn) (!= (load a) NO-NODE)) (break)
            (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-ARG))
                    (do (store! a (load i)) 0) 0)
                (store! i (+ (load i) 1)) 0)))
    (if (!= (load a) NO-NODE) (do (ev-bind! (load a) (RInt arg)) 0) 0))
  (assert (= (ev-run-nobind 100000) EV-OK))
  (rt-payload (ev-result)))

(defn linked-native [(ops (slice u8)) (arg i64)] (-> i64)
  (graph-reset! 909)
  (build-linked-program! ops)
  (assert (= (g-verify) 0))
  (assert (be-select-machine-program!))
  (be-schedule!)
  (assert (= (be-color! 8) 0))
  (assert (be-encode-checked!))
  (assert (be-macho-checked!))
  (emit-and-run arg))

;; A LINKED OBJECT, not an mmapped page: the only test here exercising the Mach-O container and the
;; relocations resolving against a C caller at a real ABI boundary.
;;
;; A DEFTEST OVER A FIXED TABLE, not a property, and the reason is cost: each case writes an object,
;; runs clang and executes the result, which a 200-case property cannot sustain -- it ran past ten
;; minutes. Six programs is enough to cover the path; breadth at this layer belongs to the mmap
;; properties, which run thousands of cases against the same encoder.
(deftest a_linked_object_agrees_with_the_interpreter
  (assert (= (linked-eval "a" 41) (linked-native "a" 41)))
  (assert (= (linked-eval "ab" 7) (linked-native "ab" 7)))
  (assert (= (linked-eval "abc" -13) (linked-native "abc" -13)))
  (assert (= (linked-eval "zq" 0) (linked-native "zq" 0)))
  (assert (= (linked-eval "\x01\x02" 99) (linked-native "\x01\x02" 99)))
  (assert (= (linked-eval "abcdef" 1234) (linked-native "abcdef" 1234))))
