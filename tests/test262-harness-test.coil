(module test262harnesstest)

(import "nativeharness" :use *)
(import "test262harness" :use *)
(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.assert" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)

(deftest core_synchronous_test262_harness_compiles_links_and_runs
  (let [a (malloc-allocator)
        test (t262-read a "tests/test262/fixtures/same-value.js")
        source (t262-wrap-core! a test)]
    (let [(mut frontend) (fe-native-new source)
          status (fe-native-index! (mut frontend))]
      (if (!= status FE-OK)
          (do (fmt (stderr) "test262 frontend status={d} node={d}: {s}\n"
                   status (.error-node frontend) (ts-text (.ast frontend) (.error-node frontend))) 0) 0)
      (fe-native-free! (mut frontend))
      (assert (= status FE-OK)))
    (assert (nh-agrees-with-node? source 7))))
