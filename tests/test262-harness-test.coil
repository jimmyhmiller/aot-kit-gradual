(module test262harnesstest)

(import "nativeharness" :use *)
(import "test262harness" :use *)
(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.assert" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)

(deftest core_synchronous_test262_harness_compiles_links_and_runs
  (let [a (malloc-allocator)
        test (t262-read a "tests/test262/fixtures/same-value.js")
        source (t262-wrap-core! a test)]
    (let [(mut frontend) (fe-native-new source)
          status (fe-native-index! (mut frontend))]
      (if (!= status FE-OK)
          (do (fmt (stderr) "test262 frontend status={d} node={d}: {s}\n"
                   status (.error-node frontend) (ts-text (.ast frontend) (.error-node frontend))) 0) 0)
      (fe-native-free! (mut frontend))
      (assert (= status FE-OK)))
    (assert (nh-agrees-with-node? source 7))))

(defn actual-test262-case-agrees? [(path (slice u8))] (-> bool)
  (let [a (malloc-allocator)
        test (t262-read a path)
        source (t262-wrap-core! a test)]
    (nh-agrees-with-node? source 0)))

(deftest actual_test262_division_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/division-line-terminator.js")))

(deftest actual_test262_modulus_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/modulus-line-terminator.js")))

(deftest actual_test262_multiplication_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/multiplication-line-terminator.js")))

(deftest actual_test262_compare_array_harness_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/compare-array-empty.js")))

(deftest actual_test262_assert_throws_native_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/assert-throws-native.js")))

(deftest actual_test262_assert_throws_custom_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/assert-throws-custom.js")))

(deftest actual_test262_assert_throws_incorrect_constructor_case_runs_natively
  (assert (actual-test262-case-agrees? "tests/test262/cases/assert-throws-incorrect-ctor.js")))
