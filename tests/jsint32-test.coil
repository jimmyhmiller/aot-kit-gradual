(module jsint32test)

(import "jsint32" :use *)
(import "jsvalue" :use *)
(import "ty" :use *)
(import "coil.assert" :use *)

(deftest int32_and_uint32_cover_wrapping_boundaries
  (assert (= (js-to-int32-int 2147483647) 2147483647))
  (assert (= (js-to-int32-int 2147483648) -2147483648))
  (assert (= (js-to-int32-int 4294967295) -1))
  (assert (= (js-to-int32-int 4294967296) 0))
  (assert (= (js-to-uint32-int -1) 4294967295)))

(deftest floating_coercion_truncates_then_wraps
  (assert (= (js-to-int32-f64 3.9) 3))
  (assert (= (js-to-int32-f64 -3.9) -3))
  (assert (= (js-to-int32-f64 4294967297.75) 1))
  (assert (= (js-to-int32-f64 (bits-f64 JSV-NAN)) 0))
  (assert (= (js-to-int32-f64 (bits-f64 9218868437227405312)) 0))
  (assert (= (js-to-int32-f64 (bits-f64 JSV-NEGATIVE-ZERO)) 0)))

(deftest shifts_mask_counts_and_distinguish_signed_from_unsigned
  (assert (= (js-bit-bin JS-SHL 1 33) 2))
  (assert (= (js-bit-bin JS-SHR -1 65) -1))
  (assert (= (js-bit-bin JS-USHR -1 0) 4294967295))
  (assert (= (js-bit-bin JS-USHR -2147483648 1) 1073741824)))

(deftest bitwise_results_are_signed_int32
  (assert (= (js-bit-bin JS-BIT-AND -1 252645135) 252645135))
  (assert (= (js-bit-bin JS-BIT-OR 2147483648 1) -2147483647))
  (assert (= (js-bit-bin JS-BIT-XOR -1 4294967295) 0))
  (assert (= (js-bit-not 0) -1)))

(deftest remainder_preserves_negative_zero_and_canonicalizes_nan
  (assert (= (js-remainder-bits -4.0 2.0) JSV-NEGATIVE-ZERO))
  (assert (= (js-remainder-bits 5.5 2.0) (f64-bits 1.5)))
  (assert (= (js-remainder-bits 1.0 0.0) JSV-NAN))
  (assert (= (js-remainder-bits (bits-f64 9218868437227405312) 2.0) JSV-NAN)))
