(module b12idealtest)

(import "node" :use *)
(import "shape" :use *)
(import "ty" :use *)
(import "eval" :use *)
(import "jsstring" :use *)
(import "verify" :use *)
(import "coil.assert" :use *)

(defn ac [(value i64)] (-> i64)
  (n-new1 (Const (t-int-con value)) (g-start)))
(defn am [(alias i64)] (-> i64)
  (n-new1 (Arg (t-mem-alias alias (t-undef))) (g-start)))

(defn build-array-result [(index i64) (length-result bool)] (-> i64)
  (graph-reset! 11200)
  (shape-reset!)
  (let [shape (shape-transition SHAPE-ROOT "keep" (t-int))
        alias (shape-field-alias shape 0)
        allocation (n-new-obj1! (g-start) shape (am alias))
        array (n-array-mark! (g-start) (n-obj-ptr allocation))
        first (n-array-store! (am JS-PROPERTY-ALIAS) array (ac 0) (n-box! (ac 10)))
        second (n-array-store! first array (ac 3) (n-box! (ac 40)))
        value
          (if length-result
              (n-array-length! second array)
              (n-array-load! second array (ac index)))
        memory (n-memmerge2! (n-obj-mem allocation 0) second)
        ret (n-new3 (Return) (g-start) value memory)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    value))

(deftest indexed_store_and_load_are_memory_versioned
         (build-array-result 3 false)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (= (rt-payload (ev-result)) 40)))

(deftest a_required_hole_reads_as_undefined
         (build-array-result 1 false)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (= (rt-tag (ev-result)) RT-UNDEF)))

(deftest length_tracks_the_highest_written_dense_index
         (build-array-result 0 true)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (= (rt-payload (ev-result)) 4)))

(defn build-resize-result [(regrow bool)] (-> i64)
  (graph-reset! 11201)
  (shape-reset!)
  (let [shape (shape-transition SHAPE-ROOT "keep" (t-int))
        alias (shape-field-alias shape 0)
        allocation (n-new-obj1! (g-start) shape (am alias))
        array (n-array-mark! (g-start) (n-obj-ptr allocation))
        written (n-array-store! (am JS-PROPERTY-ALIAS) array (ac 3) (n-box! (ac 40)))
        shrunk (n-array-resize! written array (ac 2))
        final-memory (if regrow (n-array-resize! shrunk array (ac 4)) shrunk)
        value
          (if regrow
              (n-array-load! final-memory array (ac 3))
              (n-array-length! final-memory array))
        memory (n-memmerge2! (n-obj-mem allocation 0) final-memory)
        ret (n-new3 (Return) (g-start) value memory)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    value))

(deftest resize_sets_exact_length
         (build-resize-result false)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (= (rt-payload (ev-result)) 2)))

(deftest truncated_elements_do_not_reappear_after_regrowth
         (build-resize-result true)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (= (rt-tag (ev-result)) RT-UNDEF)))

(defn build-property-key-array-result [(operation i64)] (-> i64)
  (graph-reset! 11203)
  (shape-reset!)
  (let [shape (shape-transition SHAPE-ROOT "keep" (t-int))
        alias (shape-field-alias shape 0)
        allocation (n-new-obj1! (g-start) shape (am alias))
        array (n-array-mark! (g-start) (n-obj-ptr allocation))
        property-memory (am JS-PROPERTY-ALIAS)
        zero (n-string-const! (jss-from-utf8! "0"))
        stored (n-prop-store-key-at! (g-start) property-memory array zero (n-box! (ac 17)))
        result-memory
          (if (= operation 3)
              (n-prop-delete-key-at! (g-start) stored array zero)
              stored)
        value
          (case operation 0
                (n-prop-load-key-at! (g-start) result-memory array zero) 1
                (n-prop-load-key-at! (g-start)
                                     result-memory
                                     array
                                     (n-string-const! (jss-from-utf8! "length")))
                  2
                (n-prop-has-key-at! (g-start) result-memory array zero) 3
                (n-prop-has-key-at! (g-start) result-memory array zero)
                  (n-prop-load-key-at! (g-start) result-memory array zero))
        memory (n-memmerge2! (n-obj-mem allocation 0) result-memory)
        ret (n-new3 (Return) (g-start) value memory)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    value))

(deftest canonical_property_keys_observe_array_payload
         (build-property-key-array-result 0)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (rt-eq? (ev-result) (RInt 17)))

         (build-property-key-array-result 1)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (rt-eq? (ev-result) (RInt 1)))

         (build-property-key-array-result 2)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (rt-eq? (ev-result) (RBool true)))

         (build-property-key-array-result 3)
         (assert (= (g-verify) 0))
         (ev-reset!)
         (ev-bind-args! 0)
         (assert (= (ev-run-nobind 10000) EV-OK))
         (assert (rt-eq? (ev-result) (RBool false))))

(deftest array_copy_preserves_source_holes
         (graph-reset! 11202)
         (shape-reset!)
         (let [source-shape (shape-transition SHAPE-ROOT "source" (t-int))
               result-shape (shape-transition SHAPE-ROOT "result" (t-int))
               source-alias (shape-field-alias source-shape 0)
               result-alias (shape-field-alias result-shape 0)
               source-allocation (n-new-obj1! (g-start) source-shape (am source-alias))
               result-allocation (n-new-obj1! (g-start) result-shape (am result-alias))
               source (n-array-mark! (g-start) (n-obj-ptr source-allocation))
               result (n-array-mark! (g-start) (n-obj-ptr result-allocation))
               written (n-array-store! (am JS-PROPERTY-ALIAS) source (ac 3) (n-box! (ac 40)))
               resized (n-array-resize! written result (ac 4))
               copied (n-array-copy! resized source result (ac 0))
               value (n-array-load! copied result (ac 1))
               allocations
                 (n-memmerge2! (n-obj-mem source-allocation 0)
                               (n-obj-mem result-allocation 0))
               memory (n-memmerge2! allocations copied)
               ret (n-new3 (Return) (g-start) value memory)]
           (n-add-def! (g-stop) ret)
           (g-analyze!)
           (assert (= (g-verify) 0))
           (ev-reset!)
           (ev-bind-args! 0)
           (assert (= (ev-run-nobind 10000) EV-OK))
           (assert (= (rt-tag (ev-result)) RT-UNDEF))))
