(module b09closurecontracttest)

(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "coil.assert" :use *)
(import "coil.slice" :use *)

(defn c [(x i64)] (-> i64) (n-new1 (Const (t-int-con x)) (g-start)))
(defn finish! [(site CallSite)] (-> i64)
  (n-add-def! (g-stop) (n-new2 (Return) (call-end site) (call-value site)))
  (g-analyze!) 0)

(deftest wrong_arity_is_named
  (graph-reset! 9901)
  (let [fun (n-fun-open! 0) a (n-parm! fun 0) b (n-parm! fun 1)]
    (n-fun-close! fun (n-new2 (Return) (n-fun-entry fun) (n-new3 (Add) NO-NODE a b)))
    (let [site (n-call1! (g-start) fun (c 1))]
      (finish! site)
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CALL-ARITY)))))

(deftest wrong_callee_tag_is_named
  (graph-reset! 9902)
  (let [site (n-call1! (g-start) (c 7) (c 1))]
    (finish! site)
    (assert (> (g-verify) 0))
    (assert (= (g-verify-code) VERR-CALL-TAG))))

(deftest corrupt_capture_layout_is_named
  (graph-reset! 9903)
  (let [fun (n-fun-open! 0) captured (n-parm! fun 0) arg (n-parm! fun 1)]
    (n-fun-close! fun (n-new2 (Return) (n-fun-entry fun)
                        (n-new3 (Add) NO-NODE captured arg)))
    (let [clos (n-closure1! fun (c 40)) site (n-call1! (g-start) clos (c 2))]
      (finish! site)
      (assert (= (g-verify) 0))
      (n-set-op! clos (Closure 0))
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CLOSURE-LAYOUT)))))

(deftest corrupt_target_set_is_named
  (graph-reset! 9904)
  (let [fun (n-fun-open! 0) arg (n-parm! fun 0)]
    (n-fun-close! fun (n-new2 (Return) (n-fun-entry fun) arg))
    (let [clos (n-closure! fun (slice-new [i64] (cast (ptr i64) 0) 0))
          site (n-call1! (g-start) clos (c 2))]
      (finish! site)
      (assert (= (g-verify) 0))
      (n-set-ty! clos (t-fun-con 1))
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CALL-TARGETS)))))
