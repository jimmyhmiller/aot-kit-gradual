(module test262harness)

(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.fs" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)

(defn t262-read [(a (dyn Allocator)) (path (slice u8))] (-> (slice u8))
  (try (try-or! (read-file a path) (do (abort) ""))))

(defn t262-append! [(out (mut (ArrayList u8))) (text (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len text))
              (break)
              (do (al-push! [u8] (mut out) (slice-get text (load i)))
                  (set! i (+ (load i) 1))))))
  0)

;; Phase one deliberately builds one script realm as one generated entry function. Metadata,
;; strict/module variants, includes, negative phases, async completion, and the `$262` host object
;; remain runner work; this boundary proves that the core synchronous harness and a test reach
;; native object publication and execution before those policies are layered on top.
(defn t262-wrap-core! [(a (dyn Allocator)) (test (slice u8))] (-> (slice u8))
  (let [(mut out) (al-new [u8] a)]
    (t262-append! (mut out) "function main(n) {\n")
    (t262-append! (mut out) (t262-read a "tests/test262/harness/sta.js"))
    (t262-append! (mut out) "\n")
    (t262-append! (mut out) (t262-read a "tests/test262/harness/assert.js"))
    (t262-append! (mut out) "\n")
    (t262-append! (mut out) test)
    (t262-append! (mut out) "\nreturn 0;\n}\n")
    (al-into-slice [u8] (mut out))))
