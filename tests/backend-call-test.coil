      (store! (index values 1) (cc 2))
      (n-fun-close! fun
        (n-return-values! (arms-f arms) (slice-new [i64] values 2) NO-NODE))
      (store! (index values 0) marked)
      (store! (index values 1) (cc 0))
      (n-fun-add-return! fun
        (n-return-values! (arms-t arms) (slice-new [i64] values 2) NO-NODE)))
    (let [fail (n-new1 (Arg (t-int)) (g-start))
          abuf (primitive/alloc-stack (array i64 1))
          args (cast (ptr i64) abuf)]
      (store! (index args 0) fail)
      (let [site (n-call! (g-start) fun (slice-new [i64] args 1))
            dependency (call-result site 0)
            tagged-pending
              (n-peephole
                (n-new3 (JsBuiltin 101) (call-end site) dependency (cc 0)))
            pending (n-unbox! tagged-pending (t-bool))
            arms (n-if-arms!
                   (n-peephole (n-new2 (If) (call-end site) pending)))
            thrown (n-peephole (n-new3 (JsBuiltin 102) (arms-t arms) pending (cc 0)))
            abrupt-answer (cb (Add) (n-unbox! thrown (t-int)) (cc 2))
            normal-answer (cb (Add) (call-result site 0) (call-result site 1))]
        (n-add-def! (g-stop) (n-new2 (Return) (arms-t arms) abrupt-answer))
        (n-add-def! (g-stop) (n-new2 (Return) (arms-f arms) normal-answer))))
    (g-analyze!)
    (assert (= (g-verify) 0))
    (assert (be-select-machine-program!))
    (assert (= (mu-call-bundle-count) 1))
    (assert (= (.result-count (mu-call-bundle 0)) 2))
    (assert (.can-throw (mu-call-bundle 0)))
    (assert (>= (be-schedule!) 0))
    (assert (>= (be-color! 10) 0))
    (assert (be-encode-checked!))
    (assert (be-macho-checked!))
    (let [ok (primitive/alloc-stack bool)
          got (nh-exec-memory-checked! 1 ok)]
      (assert (load ok))
      (assert (= got 42))
      ;; The pending value was consumed and cleared by descriptor 102. Re-enter the identical
      ;; image through its normal result projections to prove that abrupt transport neither leaks
      ;; process state nor changes the two-result ABI.
      (let [normal (nh-exec-memory-checked! 0 ok)]
        (assert (load ok))
        (assert (= normal 42))))))

(deftest recursive_direct_call_restores_lr_and_sp_from_each_frame
         (graph-reset! 406)
         (let [fun (n-fun-open! 0)
               n (n-parm! fun 0)
               arms (n-if-arms! (n-peephole (n-new2 (If) (n-fun-entry fun) (cb (Lt) n (cc 1)))))
               recur (n-call1! (arms-f arms) fun (cb (Sub) n (cc 1)))
               base (n-new2 (Return) (arms-t arms) (cc 1))
               step (n-new2 (Return) (call-end recur) (call-value recur))]
           (n-fun-close! fun base)
           (n-fun-add-return! fun step)
           (let [site (n-call1! (g-start) fun (cc 100))
                 ret (n-new2 (Return) (call-end site) (call-value site))]
             (n-add-def! (g-stop) ret)
             (g-analyze!)
             (assert (= (g-verify) 0))
             (compile-machine!)
             (assert (= (native0) 1)))))

(deftest mutual_recursion_preserves_each_functions_lr_and_frame
         (graph-reset! 409)
         (let [even (n-fun-open! 0)
               odd (n-fun-open! 1)
               en (n-parm! even 0)
               on (n-parm! odd 0)
               ea
                 (n-if-arms! (n-peephole (n-new2 (If) (n-fun-entry even) (cb (Eq) en (cc 0)))))
               er (n-call1! (arms-f ea) odd (cb (Sub) en (cc 1)))
               eb (n-new2 (Return) (arms-t ea) (cc 1))
               es (n-new2 (Return) (call-end er) (call-value er))
               oa
                 (n-if-arms! (n-peephole (n-new2 (If) (n-fun-entry odd) (cb (Eq) on (cc 0)))))
               orc (n-call1! (arms-f oa) even (cb (Sub) on (cc 1)))
               ob (n-new2 (Return) (arms-t oa) (cc 0))
               os (n-new2 (Return) (call-end orc) (call-value orc))]
           (n-fun-close! even eb)
           (n-fun-add-return! even es)
           (n-fun-close! odd ob)
           (n-fun-add-return! odd os)
           (let [site (n-call1! (g-start) even (cc 20))
                 ret (n-new2 (Return) (call-end site) (call-value site))]
             (n-add-def! (g-stop) ret)
             (g-analyze!)
             (assert (= (g-verify) 0))
             (compile-machine!)
             (assert (= (mu-function-count) 3))
             (assert (= (native0) 1)))))

(deftest runtime_function_value_with_a_singleton_closed_world_target_is_devirtualized
         (graph-reset! 407)
         (let [fun (n-fun-open! 0)
               x (n-parm! fun 0)
               body (n-new2 (Return) (n-fun-entry fun) x)]
           (n-fun-close! fun body)
           (let [indirect (n-new1 (Arg (t-fun-con 0)) (g-start))
                 site (n-call1! (g-start) indirect (cc 42))
                 ret (n-new2 (Return) (call-end site) (call-value site))]
             (n-add-def! (g-stop) ret)
             (g-analyze!)
             (assert (= (g-verify) 0))
             (compile-machine!)
             (assert (= (mu-function-count) 2))
             (assert (= (native0) 42)))))

(deftest polymorphic_dispatch_retains_every_internal_code_address_relocation
  (graph-reset! 425)
  (let [left (n-fun-open! 1)
        lx (n-parm! left 0)
        right (n-fun-open! 2)
        rx (n-parm! right 0)]
    (n-fun-close! left (n-new2 (Return) (n-fun-entry left) lx))
    (n-fun-close! right (n-new2 (Return) (n-fun-entry right) rx))
    (let [callee (n-new1 (Arg (t-fun-set 6)) (g-start))
          site (n-call1! (g-start) callee (cc 42))]
      (n-add-def! (g-stop) (n-new2 (Return) (call-end site) (call-value site)))
      (g-analyze!)
      (assert (= (g-verify) 0))
      (compile-machine!)
      (assert (= (mu-function-count) 3))
      ;; Function id zero is reserved from runtime dispatch; ids one and two are both materialized.
      (assert (= (mu-internal-address-reloc-count) 2))
      (let [(mut relocation) 0]
        (loop
          (if (>= (load relocation) (mu-internal-address-reloc-count))
              (break)
              (do
                (let [source (mu-internal-address-reloc-source (load relocation))
                      offset (mu-internal-address-reloc-offset (load relocation))
                      target (mu-internal-address-reloc-target (load relocation))]
                  (assert (= source 0))
                  (assert (>= target 1))
                  (assert (< target (mu-function-count)))
                  (assert (>= offset (mu-function-code-start source)))
                  (assert (< offset (+ (mu-function-code-start source)
                                       (mu-function-code-size source))))
                  (assert (= (be-code-u32 offset) (a64-adr 17 0))))
                (set! relocation (+ (load relocation) 1)))))))))

(deftest polymorphic_noncallable_values_skip_the_closure_environment_load
  (graph-reset! 427)
  (let [left (n-fun-open! 1)
        lx (n-parm! left 0)
        right (n-fun-open! 2)
        rx (n-parm! right 0)]
    (n-fun-close! left (n-new2 (Return) (n-fun-entry left) lx))
    (n-fun-close! right (n-new2 (Return) (n-fun-entry right) rx))
    (let [callee (n-new1 (Arg (t-fun-set 6)) (g-start))
          site (n-call1! (g-start) callee (cc 42))]
      (n-add-def! (g-stop) (n-new2 (Return) (call-end site) (call-value site)))
      (g-analyze!)
      (assert (= (g-verify) 0))
      (compile-machine!)
      ;; A non-callable is represented by callable id zero for the resolver. It must branch around
      ;; the closure-only payload dereference instead of loading through that intentional null.
      (assert (encoded_polymorphic_noncall_path_skips_closure_load?)))))
