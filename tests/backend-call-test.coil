          arms (n-if-arms! (n-peephole (n-new2 (If) (n-fun-entry fun) fail)))
          values-buf (primitive/alloc-stack (array i64 2))
          values (cast (ptr i64) values-buf)
          raised (n-peephole (n-new2 (JsThrow) (arms-t arms) (n-box! (cc 40))))
          marked (n-peephole
                   (n-new3 (JsBuiltin BE-EXCEPTION-RETURN-DESCRIPTOR)
                           (arms-t arms) raised (cc 0)))]
