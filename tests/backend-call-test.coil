                      (n-peephole (n-new2 (If) (n-fun-entry fun) (cb (Lt) n (cc 1)))))
               recur (n-call1! (arms-f arms) fun (cb (Sub) n (cc 1)))
               base (n-new2 (Return) (arms-t arms) (cc 0))
               step (n-new2 (Return) (call-end recur)
                            (cb (Add) (cc 1) (call-value recur)))]
           (n-fun-close! fun base)
