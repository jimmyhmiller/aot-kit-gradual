;; X2 hand-built binary-trees kernel, grown from independently executable units.
(module binarytreestest)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "verify" :use *)
(import "eval" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn btc [(v i64)] (-> i64) (n-new1 (Const (t-int-con v)) (g-start)))
(defn btnull [] (-> i64) (n-new1 (Const (t-null)) (g-start)))
(defn btb [(op Op) (a i64) (b i64)] (-> i64) (n-new3 op NO-NODE a b))
(defn btmem [(ctrl i64) (alias i64)] (-> i64)
  (n-new1 (Arg (t-mem-alias alias (t-undef))) ctrl))

(defn bt-node! [(ctrl i64) (shape i64) (left-alias i64) (right-alias i64)
                 (left i64) (right i64)] (-> (array i64 2))
  (let [nw (n-new-obj2! ctrl shape (btmem ctrl left-alias) (btmem ctrl right-alias))
        obj (n-obj-ptr nw)
        lm (n-store! (n-obj-mem nw 0) obj left left-alias)
        rm (n-store! (n-obj-mem nw 1) obj right right-alias)
        out (alloc/stack (array i64 2))]
    (store! (index out 0) obj)
    (store! (index out 1) (n-memmerge2! lm rm))
    (load out)))

(defn build-tree-check! [(depth i64)] (-> i64)
  (graph-reset! 1301) (shape-reset!)
  (let [left-shape (shape-transition SHAPE-ROOT "left" (t-obj))
        tree-shape (shape-transition left-shape "right" (t-obj))
        left-alias (shape-field-alias tree-shape 0)
        right-alias (shape-field-alias tree-shape 1)
        bottom (n-fun-open! 0) d (n-parm! bottom 0)
        split (n-if-arms!
                (n-peephole (n-new2 (If) (n-fun-entry bottom) (btb (Lt) d (btc 1)))))
        leaf (bt-node! (arms-t split) tree-shape left-alias right-alias (btnull) (btnull))
        leaf-ret (n-new3 (Return) (arms-t split) (index leaf 0) (index leaf 1))
        next (btb (Sub) d (btc 1))
        left-call (n-call1! (arms-f split) bottom next)
        right-call (n-call1! (call-end left-call) bottom next)
        parent (bt-node! (call-end right-call) tree-shape left-alias right-alias
                         (call-value left-call) (call-value right-call))
        parent-ret (n-new3 (Return) (call-end right-call)
                          (index parent 0) (index parent 1))]
    (n-fun-close! bottom leaf-ret)
    (n-fun-add-return! bottom parent-ret)
    (let [check (n-fun-open! 1) node (n-parm! check 0)
          cast (n-new2 (Cast (t-obj-shape tree-shape)) (n-fun-entry check) node)
          left (n-load! (btmem (n-fun-entry check) left-alias) cast left-alias)
          arms (n-if-arms!
                 (n-peephole (n-new2 (If) (n-fun-entry check)
                                     (btb (Eq) left (btnull)))))
          leaf-check (n-new2 (Return) (arms-t arms) (btc 1))
          right (n-load! (btmem (n-fun-entry check) right-alias) cast right-alias)
          lc (n-call1! (arms-f arms) check left)
          rc (n-call1! (call-end lc) check right)
          branch-check (n-new2 (Return) (call-end rc)
                         (btb (Add) (btc 1)
                              (btb (Add) (call-value lc) (call-value rc))))]
      (n-fun-close! check leaf-check)
      (n-fun-add-return! check branch-check)
      (let [tree (n-call1! (g-start) bottom (btc depth))
            checked (n-call1! (call-end tree) check (call-value tree))
            ret (n-new2 (Return) (call-end checked) (call-value checked))]
        (n-add-def! (g-stop) ret)
        (g-analyze!) tree-shape))))

(deftest bottom_up_and_item_check_agree_for_depths_zero_through_six
  (let [(mut depth) 0]
    (loop
      (if (> (load depth) 6) (break)
        (do
          (build-tree-check! (load depth))
          (assert (= (g-verify) 0))
          (let [status (ev-run-bound 1 2000000)]
            (if (= status EV-OK) 0
              (do (fmt (stderr) "binary tree depth={d} status={d} at={d} op={s}\n"
                       (load depth) status (ev-at) (op-name (n-op (ev-at)))) 0))
            (assert (= status EV-OK)))
          (assert (= (rt-payload (ev-result)) (- (<< 1 (+ (load depth) 1)) 1)))
          (let [selected (be-select-machine-program!)]
            (if selected 0
              (do (fmt (stderr) "binary selection depth={d} be={d} ms={d} item={d}\n"
                       (load depth) (be-result) (ms-result) (ms-result-item))
                  (ms-dump (stderr)) 0))
            (assert selected))
          (store! depth (+ (load depth) 1)) 0)))))
