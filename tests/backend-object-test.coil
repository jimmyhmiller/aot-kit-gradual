;; G10 multi-function object publication and metadata validation.
(module backendobjecttest)

(import "ty" :use *)
(import "node" :use *)
(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "backend_function_text" :use *)
(import "verify" :use *)
(import "corpus" :use *)
(import "shape" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fs" :use *)
(import "coil.slice" :use *)
(import "coil.fmt" :use *)

(defn object-publish! [] (-> i64)
  (if (be-macho-checked!) 0
    (do (fmt (stderr) "object publish failed result={d} item={d} ber={d}\n"
             (mobj-result) (mobj-item) (be-result))
        (assert false) 0)))

(defn oc [(v i64)] (-> i64) (n-new1 (Const (t-int-con v)) (g-start)))
(defn ob [(op Op) (a i64) (b i64)] (-> i64) (n-new3 op NO-NODE a b))

(defn object-call-program! [] (-> i64)
  (graph-reset! 1001)
  (let [inc (n-fun-open-identity! 0 FUN-IDENTITY-SOURCE 123456 0)
        (mut types) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut types) (t-int))
    (n-fun-declare-abi! inc (al-slice [i64] (load types)) (t-int))
    (al-free! [i64] (mut types))
    (let [x (n-parm! inc 0)
        body (n-new2 (Return) (n-fun-entry inc) (ob (Add) x (oc 1)))]
      (n-fun-close! inc body)
      (let [site (n-call1! (g-start) inc (oc 41))
            ret (n-new2 (Return) (call-end site) (call-value site))]
        (n-add-def! (g-stop) ret)
        (g-analyze!) 0))))

(defn object-compile! [] (-> i64)
  (assert (be-select-machine-program!))
  (assert (>= (be-schedule!) 0))
  (assert (>= (be-color! 8) 0))
  (assert (be-encode-checked!)) 0)

(defn object-compile-layout! [(seed i64)] (-> i64)
  (assert (be-select-machine-program!))
  (assert (>= (be-schedule!) 0))
  (assert (>= (be-function-layout-seeded! seed) 0))
  (assert (ms-call-bundles-valid?))
  (assert (>= (be-color! 8) 0))
  (assert (be-encode-checked!))
  (object-publish!) 0)

(defn object-compile-runtime! [] (-> i64)
  (assert (be-select-machine-program!))
  (be-use-runtime-allocation! true)
  (assert (>= (be-schedule!) 0))
  (assert (>= (be-color! 8) 0))
  (assert (be-encode-checked!)) 0)

(deftest encoder_publishes_exact_nonempty_range_for_every_machine_function
  (object-call-program!)
  (object-compile!)
  (assert (= (mu-function-count) 2))
  (let [(mut owner) 0]
    (loop
      (if (>= (load owner) (mu-function-count)) (break)
        (do
          (assert (>= (mu-function-code-start (load owner)) 0))
          (assert (> (mu-function-code-size (load owner)) 0))
          (assert (<= (+ (mu-function-code-start (load owner))
                         (mu-function-code-size (load owner)))
                      (be-code-len)))
          (store! owner (+ (load owner) 1)) 0))))
  (assert (mobj-verify-model!)))

(deftest encoder_retains_relocatable_internal_call_sites
  (object-call-program!)
  (object-compile!)
  (assert (= (mu-internal-call-reloc-count) 1))
  (let [source-owner (mu-internal-call-reloc-source 0)
        site (mu-internal-call-reloc-offset 0)
        target-owner (mu-internal-call-reloc-target 0)
        target (mu-function-code-start target-owner)]
    (assert (>= source-owner 0))
    (assert (< source-owner (mu-function-count)))
    (assert (>= site 0))
    (assert (< site (be-code-len)))
    (assert (>= site (mu-function-code-start source-owner)))
    (assert (< site (+ (mu-function-code-start source-owner)
                       (mu-function-code-size source-owner))))
    (assert (>= target-owner 0))
    (assert (< target-owner (mu-function-count)))
    (assert (= (be-code-u32 site) (a64-bl (/ (- target site) 4))))))

(deftest pure_function_text_extracts_relative_calls_and_stackmap_sites
  (object-call-program!)
  (object-compile!)
  (assert (mft-extract! 0))
  (assert (= (mft-byte-count) (mu-function-code-size 0)))
  (assert (= (mft-reloc-count) 1))
  (assert (= (mft-reloc-kind 0) MFT-RELOC-CALL))
  (assert (>= (mft-reloc-offset 0) 0))
  (assert (< (mft-reloc-offset 0) (mft-byte-count)))
  (assert (= (mft-reloc-target 0) (mu-function-symbol 1)))
  (assert (= (mft-reloc-target-kind 0) FUN-IDENTITY-SOURCE))
  (assert (= (mft-reloc-target-unit 0) 123456))
  (assert (= (mft-reloc-target-local 0) 0))
  (assert (= (mft-site-count) 1))
  (assert (> (mft-site-offset 0) (mft-reloc-offset 0)))
  (assert (= (mft-site-root-count 0) 0)))

(deftest runtime_function_text_retains_external_branch_relocation
  (corpus-build! CX-OBJECT-RET)
  (object-compile-runtime!)
  (assert (mft-extract! 0))
  (assert (= (mft-reloc-count) 6))
  (assert (= (mft-reloc-kind 0) MFT-RELOC-EXTERNAL))
  (assert (= (mft-reloc-target 0) MI-NEW))
  (assert (>= (mft-reloc-offset 0) 0))
  (assert (< (mft-reloc-offset 0) (mft-byte-count)))
  (assert (= (mft-reloc-kind 1) MFT-RELOC-SHAPE-SIZE))
  (assert (= (mft-reloc-kind 2) MFT-RELOC-SHAPE-ID))
  (assert (= (mft-reloc-kind 3) MFT-RELOC-SHAPE-SIZE))
  (assert (= (mft-reloc-kind 4) MFT-RELOC-SHAPE-SIZE))
  (assert (= (mft-reloc-kind 5) MFT-RELOC-SHAPE-ID))
  (assert (= (mft-reloc-target 1) (mft-reloc-target 2)))
  (assert (= (mft-reloc-target 2) (mft-reloc-target 3)))
  (assert (= (mft-reloc-target 3) (mft-reloc-target 4)))
  (assert (= (mft-reloc-target 4) (mft-reloc-target 5)))
  (assert (= (mft-reloc-aux 1) (shape-size 1)))
  (assert (= (mft-reloc-target-kind 1) (shape-field-count 1)))
  (assert (= (mft-reloc-target-unit 1) (mobj-shape-bitmap 1)))
  (assert (= (mft-reloc-target-local 1) (mobj-shape-boxed-bitmap 1))))

(deftest retained_allocation_relinks_from_its_catalog_after_compiler_shapes_are_gone
  (corpus-build! CX-OBJECT-RET)
  (object-compile-runtime!)
  (let [size (shape-size 1)
        fields (shape-field-count 1)
        refs (mobj-shape-bitmap 1)
        boxed (mobj-shape-boxed-bitmap 1)]
    (assert (mfts-snapshot!))
    (shape-reset!)
    (assert (= (shape-count) 1))
    (assert (mfti-build!))
    (assert (= (mfti-layout-u32 0) 1280593729))
    (assert (= (mfti-layout-u32 8) 2))
    (assert (= (mfti-layout-size) 80))
    ; Header is 16 bytes; root record is 32 bytes; retained record starts at 48.
    (assert (= (mfti-layout-u32 48) 1))
    (assert (= (mfti-layout-u32 52) size))
    (assert (= (mfti-layout-u32 56) 8))
    (assert (= (mfti-layout-u32 60) fields))
    (assert (= (mfti-layout-u64 64) refs))
    (assert (= (mfti-layout-u64 72) boxed))))

(deftest cacheability_requires_semantic_owner_and_resolved_dependencies
  (object-call-program!)
  (object-compile!)
  (assert (mft-extract! 0))
  (assert (= (mft-cache-reason) MFT-UNCACHEABLE-IDENTITY))
  (assert (mft-extract! 1))
  (assert (mft-cacheable?)))

(deftest declared_function_abi_does_not_follow_current_callers
  (graph-reset! 1003)
  (let [fun (n-fun-open-identity! 0 FUN-IDENTITY-SOURCE 7654321 0)
        (mut types) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut types) (t-dyn))
    (n-fun-declare-abi! fun (al-slice [i64] (load types)) (t-dyn))
    (al-free! [i64] (mut types))
    (let [parm (n-parm! fun 0)
          body (n-new2 (Return) (n-fun-entry fun) parm)]
      (n-fun-close! fun body)
      (let [integer-call (n-call1! (g-start) fun (oc 7))
            null-call (n-call1! (call-end integer-call) fun
                                (n-new1 (Const (t-null)) (g-start)))
            ret (n-new2 (Return) (call-end null-call) (call-value null-call))]
      (n-add-def! (g-stop) ret))
      (g-analyze!)
      (if (= (g-verify) 0) 0
          (do (fmt (stderr) "declared ABI graph failed verify={d}/{d}\n"
                   (g-verify-code) (g-verify-node))
              0))
      (let [selected (be-select-machine-program!)]
        (if selected 0
            (do (fmt (stderr) "declared ABI selection failed be={d}/{d} mu={d}/{d} ms={d}/{d}\n"
                     (be-result) (be-result-node) (mu-verify-result) (mu-verify-item)
                     (ms-result) (ms-result-item))
                0))
        (assert selected))
      (let [owner (mu-find-function fun)]
        (assert (>= owner 0))
        (assert (= (ml-kind-for-parm-representation parm) MLK-BOXED))
        (assert (= (be-function-return-kind owner) MLK-BOXED))))))

(deftest function_text_store_owns_every_function_record
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (assert (= (mfts-count) (mu-function-count)))
  (let [(mut owner) 0 (mut bytes) 0]
    (loop (if (>= (load owner) (mfts-count)) (break)
              (do
                (assert (= (mfts-symbol (load owner)) (mu-function-symbol (load owner))))
                (assert (= (mfts-byte-count (load owner))
                           (mu-function-code-size (load owner))))
                (set! bytes (+ (load bytes) (mfts-byte-count (load owner))))
                (set! owner (+ (load owner) 1)))))
    (assert (= (load bytes) (be-code-len))))
  (assert (= (mfts-reloc-count 0) 1))
  (assert (= (mfts-site-count 0) 1))
  (assert (= (mfts-reloc-target-abi-arity-at 0 0) 1))
  (assert (= (mfts-reloc-target-abi-return-kind-at 0 0) MLK-SCALAR))
  (assert (= (mfts-identity-kind 1) FUN-IDENTITY-SOURCE))
  (assert (= (mfts-identity-unit 1) 123456))
  (assert (= (mfts-identity-local 1) 0))
  (assert (= (mfts-abi-arity 1) 1))
  (assert (= (mfts-abi-return-kind 1) MLK-SCALAR)))

(deftest retained_artifact_round_trips_indexed_multi_result_abi_metadata
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  ;; Value kind alone cannot distinguish integer and floating register locations. Preserve both
  ;; indexed vectors for the function and the caller relocation across a clean artifact reload.
  (let [s (mfts)
        target 1
        reloc (mfts-reloc-index 0 0)
        path "/tmp/aotk-multi-result-abi.artifact"]
    (al-set! [i64] (field s abi-result-counts) target 2)
    (al-set! [i64] (field s abi-can-throws) target 1)
    (al-push! [i64] (field s abi-result-kinds) MLK-SCALAR)
    (al-push! [i64] (field s abi-result-classes) MRC-FPR)
    (al-set! [i64] (field s reloc-target-result-count) reloc 2)
    (al-push! [i64] (field s reloc-target-result-kind) MLK-SCALAR)
    (al-push! [i64] (field s reloc-target-result-class) MRC-FPR)
    (assert (mfts-save-artifact! path 123))
    (mfts-clear!)
    (assert (mfts-load-artifact! path))
    (assert (= (mfts-loaded-artifact-context) (mfts-artifact-context 123)))
    (assert (!= (mfts-loaded-artifact-digest) 0))
    (assert (= (mfts-abi-result-count target) 2))
    (assert (mfts-abi-can-throw? target))
    (assert (= (mfts-abi-result-kind target 0) MLK-SCALAR))
    (assert (= (mfts-abi-result-class target 0) MRC-GPR))
    (assert (= (mfts-abi-result-kind target 1) MLK-SCALAR))
    (assert (= (mfts-abi-result-class target 1) MRC-FPR))
    (assert (= (mfts-reloc-target-result-count-at 0 0) 2))
    (assert (= (mfts-reloc-target-result-kind-at 0 0 0) MLK-SCALAR))
    (assert (= (mfts-reloc-target-result-class-at 0 0 0) MRC-GPR))
    (assert (= (mfts-reloc-target-result-kind-at 0 0 1) MLK-SCALAR))
    (assert (= (mfts-reloc-target-result-class-at 0 0 1) MRC-FPR))
    (let [loaded (mfts)
          first (al-get [i64] (.reloc-target-result-first loaded) reloc)]
      (assert (mfts-result-range-matches-record? first 2 target))
      ;; Same coarse MLK-SCALAR kinds but a different register class is an ABI mismatch.
      (al-set! [i64] (field loaded reloc-target-result-class) (+ first 1) MRC-GPR)
      (assert (not (mfts-result-range-matches-record? first 2 target)))
      ;; The effect vector is checked artifact data, not truthy metadata with arbitrary values.
      (al-set! [i64] (field loaded abi-can-throws) target 2)
      (assert (mfts-save-artifact! path 123))
      (mfts-clear!)
      (assert (not (mfts-load-artifact! path)))
      (assert (= (mfts-count) 0)))))

(deftest retained_artifact_digest_rejects_payload_corruption
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (let [path "/tmp/aotk-corrupt-content-addressed.artifact"]
    (assert (mfts-save-artifact! path 456))
    (try
      (let [a (malloc-allocator)
            bytes (try-or! (read-file a path) (do (assert false) ""))
            at 64]
        (assert (> (slice-len bytes) (+ at 8)))
        (set! (index (slice-data bytes) at)
              (cast u8 (^ (cast i64 (load (index (slice-data bytes) at))) 1)))
        (try-or! (write-file a path bytes) (do (assert false) bytes))
        (alloc/free [u8] a bytes)
        ""))
    (mfts-clear!)
    (assert (not (mfts-load-artifact! path)))
    (assert (= (mfts-count) 0))))

(deftest invalid_function_range_is_named_and_object_publication_is_atomic
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  (assert (> (be-object-len) 0))
  (mobj-corrupt-function-range! 1 (be-code-len) 8)
  (assert (not (be-macho-checked!)))
  (assert (= (mobj-result) MOBJ-FUNCTION-RANGE))
  (assert (= (mobj-item) 1))
  (assert (= (be-object-len) 0)))

(deftest raw_object_parser_cross_checks_local_and_exported_symbols
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  (assert (mobj-verify-bytes!))
  (assert (= (mobj-result) MOBJ-OK)))

(deftest corrupt_symbol_section_is_rejected_by_raw_byte_parser
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  ; LC_SYMTAB.symoff is fixed at byte 352 in schema v1. Corrupt local symbol n_sect.
  (let [symoff (mobj-u32 352)]
    (mobj-corrupt-byte! (+ symoff 5) 0)
    (assert (not (mobj-verify-bytes!)))
    (assert (= (mobj-result) MOBJ-SYMBOL))
    (assert (= (mobj-item) 0))))

(deftest versioned_stackmap_and_layout_sections_are_structurally_cross_checked
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  (let [stackoff (mobj-u32 232) layoutoff (mobj-u32 312)]
    (assert (= (mobj-u32 stackoff) 1398034241))
    (assert (= (mobj-u32 (+ stackoff 4)) 5))
    (assert (= (mobj-u32 (+ stackoff 8)) 1))
    (let [record (+ stackoff 24)
          code (be-function-dispatch-return-code 0)]
      (assert (= (mobj-u32 (+ record 28)) (cast i64 (cast u32 (>> code 32)))))
      (assert (= (mobj-u32 (+ record 36)) (cast i64 (cast u32 code)))))
    (assert (= (mobj-u32 layoutoff) 1280593729))
    (assert (= (mobj-u32 (+ layoutoff 4)) 1))
    (assert (mobj-verify-bytes!))))

(deftest corrupt_stackmap_reference_and_layout_version_are_named
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  (let [stackoff (mobj-u32 232)]
    ; First site instruction index follows the header and function records, then pc/owner.
    (mobj-corrupt-byte! (+ (+ (+ stackoff 24) (* (mu-function-count) 40)) 8) 255)
    (assert (not (mobj-verify-bytes!)))
    (assert (= (mobj-result) MOBJ-STACKMAP)))
  (object-call-program!)
  (object-compile!)
  (object-publish!)
  (let [layoutoff (mobj-u32 312)]
    (mobj-corrupt-byte! (+ layoutoff 4) 2)
    (assert (not (mobj-verify-bytes!)))
    (assert (= (mobj-result) MOBJ-LAYOUT))))

(deftest three_function_layout_seeds_preserve_valid_symbols_calls_and_metadata
  (let [(mut seed) 0 (mut prior-entry) -1]
    (loop
      (if (>= (load seed) 3) (break)
        (do
          (object-call-program!)
          (object-compile-layout! (load seed))
          (assert (mobj-verify-model!))
          (assert (mobj-verify-bytes!))
          (if (> (load seed) 0)
              (assert (!= (mu-function-code-start 0) (load prior-entry))) 0)
          (store! prior-entry (mu-function-code-start 0))
          (store! seed (+ (load seed) 1)) 0)))))

(deftest corrupt_internal_call_target_is_named_as_a_relocation_failure
  (object-call-program!)
  (object-compile!)
  (let [(mut at) 0 (mut call) -1]
    (loop
      (if (or (>= (load at) (be-inst-count)) (>= (load call) 0)) (break)
        (do (if (= (ms-inst-op (load at)) MI-CALL) (store! call (load at)) 0)
            (store! at (+ (load at) 1)) 0)))
    (assert (>= (load call) 0))
    (mobj-corrupt-call-target! (load call) 99)
    (assert (not (mobj-verify-model!)))
    (assert (= (mobj-result) MOBJ-RELOCATION))
    (assert (= (mobj-item) (load call)))))

(deftest call_stackmaps_exclude_arguments_and_the_not_yet_defined_result
  (object-call-program!)
  (object-compile!)
  (let [(mut at) 0 (mut call) -1]
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do (if (= (ms-inst-op (load at)) MI-CALL) (store! call (load at)) 0)
            (store! at (+ (load at) 1)) 0)))
    (assert (>= (load call) 0))
    (assert (not (mobj-root? (load call) (ms-inst-dst (load call)))))
    (let [(mut vr) 0]
      (loop
        (if (>= (load vr) (ml-vreg-count)) (break)
          (do
            (if (mobj-root? (load call) (load vr))
                (assert (or (>= (mra-reg (load vr)) 19)
                            (>= (mra-spill (load vr)) 0))) 0)
            (store! vr (+ (load vr) 1)) 0))))))

(deftest allocation_slow_path_has_named_undefined_symbol_and_branch_relocation
  (corpus-build! CX-OBJECT-RET)
  (object-compile-runtime!)
  (object-publish!)
  (assert (= (mobj-external-reloc-count) 1))
  (assert (= (mobj-u32 164) 1))
  (let [basesyms (mu-function-count) relocoff (mobj-u32 160)]
    (assert (= (& (mobj-u32 (+ relocoff 4)) 16777215) basesyms)))
  (assert (mobj-verify-bytes!)))

(deftest corrupt_external_branch_relocation_is_named
  (corpus-build! CX-OBJECT-RET)
  (object-compile-runtime!)
  (object-publish!)
  (let [relocoff (mobj-u32 160)]
    ; Destroy the relocation type/pcrel/width byte while retaining its address.
    (mobj-corrupt-byte! (+ relocoff 7) 0)
    (assert (not (mobj-verify-bytes!)))
    (assert (= (mobj-result) MOBJ-RELOCATION))
    (assert (= (mobj-item) 0))))

(deftest managed_root_stackmap_serializes_exact_g7_location_and_kind
  (graph-reset! 1002)
  (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "x" (t-dyn)) ax (shape-field-alias sx 0)
        first (n-new-obj1! (g-start) sx (mk-mem-in ax)) root (n-obj-ptr first)
        mem1 (n-new4 (Store ax) NO-NODE (n-obj-mem first 0) root (oc 1))
        second (n-new-obj1! (g-start) sx mem1) other (n-obj-ptr second)
        mem2 (n-new4 (Store ax) NO-NODE (n-obj-mem second 0) other (oc 2))
        value (n-new3 (Load ax) NO-NODE mem2 root)
        ret (n-new3 (Return) (g-start) value mem2)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (be-select-machine-program!))
    (be-use-runtime-allocation! true)
    (assert (>= (be-schedule!) 0))
    (assert (>= (be-color! 1) 0))
    (assert (be-encode-checked!))
    (object-publish!)
    (let [root-v (ms-vget 0 root) stackoff (mobj-u32 232)
          sites (mobj-u32 (+ stackoff 8)) roots (mobj-u32 (+ stackoff 12))
          rootbase (+ (+ (+ stackoff 24) (* (mu-function-count) 40)) (* sites 24))
          (mut which) 0 (mut found) false]
      (assert (= sites 2))
      (assert (> roots 0))
      (loop
        (if (>= (load which) roots) (break)
          (do
            (let [rec (+ rootbase (* (load which) 16))]
              (if (= (mobj-u32 rec) root-v)
                  (do (store! found true)
                      (assert (= (mobj-u32 (+ rec 4)) MLK-RAW-MANAGED))
                      (assert (= (mobj-u32 (+ rec 8)) 1))
                      (assert (= (mobj-u32 (+ rec 12)) (be-spill-off-vreg root-v)))) 0))
            (store! which (+ (load which) 1)) 0)))
      (assert (load found))
      (assert (mobj-verify-bytes!)))))

(deftest retained_function_linker_repatches_internal_calls_by_identity
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (assert (mfti-build!))
  (assert (= (mfti-byte-count) (be-code-len)))
  (let [site (+ (mfti-function-start 0) (mfts-reloc-offset-at 0 0))
        target (mfti-function-start 1)]
    (assert (= (mfts-reloc-kind-at 0 0) MFT-RELOC-CALL))
    (assert (= (mfti-u32 site) (a64-bl (/ (- target site) 4)))))
  (assert (= (mfti-site-count) 1))
  (assert (= (mfti-site-owner 0) 0))
  (assert (= (mfti-site-offset 0)
             (+ (mfti-function-start 0) (mft-site-offset 0))))
  (assert (= (mfti-site-root-count 0) 0))
  (assert (= (mfti-root-count) 0))
  (assert (= (mfti-function-frame-size 0) (mu-function-frame-size 0)))
  (assert (= (mfti-function-callee-mask 0) (mu-function-callee-mask 0)))
  (assert (= (mfti-function-callee-count 0) (mu-function-callee-count 0)))
  (assert (= (mfti-stackmap-size) (mobj-stackmap-size)))
  (assert (= (mfti-layout-size) (mobj-layout-size)))
  (assert (= (mfti-stackmap-u32 0) 1398034241))
  (assert (= (mfti-stackmap-u32 8) (mfti-site-count)))
  (assert (= (mfti-stackmap-u32 16) (mfti-function-count)))
  (assert (= (mfti-external-count) 0)))

(deftest retained_archive_suffix_is_fully_removed_at_the_request_boundary
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (let [prefix (mfts-count)
        first-bytes (mfts-byte-count 0)]
    (assert (> prefix 0))
    (assert (mfts-append-snapshot!))
    (assert (= (mfts-count) (* prefix 2)))
    (assert (mfts-truncate-records! prefix))
    (assert (= (mfts-count) prefix))
    (assert (= (mfts-byte-count 0) first-bytes))
    (assert (mfti-build!))))

(deftest fresh_caller_links_to_retained_body_without_recompiling_that_body
  ;; First compilation supplies the immutable semantic definition.
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (let [prefix (mfts-count)]
    (assert (= prefix 2))
    ;; Second compilation declares the same function identity and ABI but deliberately has no body.
    (graph-reset! 1004)
    (let [inc (n-fun-open-identity! 0 FUN-IDENTITY-SOURCE 123456 0)
          (mut types) (al-new [i64] (malloc-allocator))]
      (al-push! [i64] (mut types) (t-int))
      (n-fun-declare-abi! inc (al-slice [i64] (load types)) (t-int))
      (al-free! [i64] (mut types))
      (n-fun-mark-imported! inc)
      (let [site (n-call1! (g-start) inc (oc 9))
            ret (n-new2 (Return) (call-end site) (call-value site))]
        (n-add-def! (g-stop) ret))
      (g-analyze!)
      (assert (= (g-verify) 0))
      (object-compile!)
      (let [import-owner (mu-find-function inc)]
        (assert (>= import-owner 0))
        (assert (mu-function-imported? import-owner))
        (assert (= (mu-function-block-count import-owner) 0)))
      (assert (mfts-append-snapshot!))
      ;; Only the fresh caller is appended; the imported owner contributes no duplicate text.
      (assert (= (mfts-count) (+ prefix 1)))
      (assert (mfti-build!))
      (assert (= (mfts-reloc-kind-at prefix 0) MFT-RELOC-CALL))
      (assert (mfts-truncate-records! prefix)))))

(deftest retained_archive_compaction_keeps_only_cacheable_semantic_kind
  (object-call-program!)
  (object-compile!)
  (assert (mfts-snapshot!))
  (assert (= (mfts-retain-cacheable-kind! FUN-IDENTITY-SOURCE) 1))
  (assert (= (mfts-count) 1))
  (assert (= (mfts-identity-kind 0) FUN-IDENTITY-SOURCE))
  (assert (= (mfts-identity-unit 0) 123456))
  (assert (mfts-cacheable? 0))
  ;; A reusable cache archive is not itself an executable image: compaction deliberately removed
  ;; the ephemeral entry, so there is no source root from which to form a linked closure.
  (assert (not (mfti-build!))))

(deftest retained_jsl_archive_keeps_the_complete_abi_checked_dependency_closure
  (graph-reset! 1005)
  (let [callee (n-fun-open-identity! 0 FUN-IDENTITY-JSL 777 0)
        (mut callee-types) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut callee-types) (t-int))
    (n-fun-declare-abi! callee (al-slice [i64] (load callee-types)) (t-int))
    (al-free! [i64] (mut callee-types))
    (let [x (n-parm! callee 0)
          body (n-new2 (Return) (n-fun-entry callee) (ob (Add) x (oc 1)))]
      (n-fun-close! callee body))
    (let [caller (n-fun-open-identity! 1 FUN-IDENTITY-JSL 777 1)
          (mut caller-types) (al-new [i64] (malloc-allocator))]
      (al-push! [i64] (mut caller-types) (t-int))
      (n-fun-declare-abi! caller (al-slice [i64] (load caller-types)) (t-int))
      (al-free! [i64] (mut caller-types))
      (let [x (n-parm! caller 0)
            site (n-call1! (n-fun-entry caller) callee x)
            body (n-new2 (Return) (call-end site) (call-value site))]
        (n-fun-close! caller body))
      (let [site (n-call1! (g-start) caller (oc 41))
            ret (n-new2 (Return) (call-end site) (call-value site))]
        (n-add-def! (g-stop) ret)))
    (g-analyze!)
    (object-compile!)
    (assert (mfts-snapshot!))
    (assert (= (mfts-retain-cacheable-jsl!) 2))
    (assert (= (mfts-count) 2))
    (assert (= (mfts-identity-kind 0) FUN-IDENTITY-JSL))
    (assert (= (mfts-identity-kind 1) FUN-IDENTITY-JSL))
    ;; The dependency closure is complete but cache-only. It becomes executable only when a fresh
    ;; source entry imports one of these identities and supplies the reachability root.
    (assert (not (mfti-build!)))))

(deftest retained_jsl_caller_cannot_link_after_its_exact_dependency_is_removed
  (graph-reset! 1006)
  (let [caller (n-fun-open-identity! 0 FUN-IDENTITY-JSL 778 0)
        callee (n-fun-open-identity! 1 FUN-IDENTITY-JSL 778 1)
        (mut callee-types) (al-new [i64] (malloc-allocator))]
    (al-push! [i64] (mut callee-types) (t-int))
    (n-fun-declare-abi! callee (al-slice [i64] (load callee-types)) (t-int))
    (al-free! [i64] (mut callee-types))
    (let [x (n-parm! callee 0)
          body (n-new2 (Return) (n-fun-entry callee) (ob (Add) x (oc 1)))]
      (n-fun-close! callee body))
    (let [(mut caller-types) (al-new [i64] (malloc-allocator))]
      (al-push! [i64] (mut caller-types) (t-int))
      (n-fun-declare-abi! caller (al-slice [i64] (load caller-types)) (t-int))
      (al-free! [i64] (mut caller-types)))
    (let [x (n-parm! caller 0)
          nested (n-call1! (n-fun-entry caller) callee x)
          body (n-new2 (Return) (call-end nested) (call-value nested))]
      (n-fun-close! caller body))
    (let [site (n-call1! (g-start) caller (oc 41))
          ret (n-new2 (Return) (call-end site) (call-value site))]
      (n-add-def! (g-stop) ret))
    (g-analyze!)
    (object-compile!)
    (assert (mfts-snapshot!))
    (assert (= (mfts-retain-cacheable-jsl!) 2))
    (assert (= (mfts-identity-local 0) 0))
    (assert (= (mfts-identity-local 1) 1))
    (assert (mfts-truncate-records! 1))
    (assert (not (mfti-build!)))))
