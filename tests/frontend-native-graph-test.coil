;; The native frontend's graph, pinned as ORDINARY TESTS.
;;
;; WHY THIS EXISTS. Each of these fixtures used to be its own 21-line program under `tools/`
;; (`typescript-native-*-graph-smoke.coil`), differing from its siblings by exactly two things: the
;; module name and a TypeScript source string. Every one of them imported `frontendnativegraph` --
;; 7,290 lines, the largest module in the repo -- so the gate spent ~2.6 seconds per fixture
;; recompiling the whole frontend to vary a string literal, then ran the binary, dumped its stdout
;; to a file, and had a Node script sha256 it.
;;
;; A deftest costs no build at all: `coil test` compiles the test tree once and forks each test.
;;
;; THE EXPECTED GRAPH IS TEXT, NOT A DIGEST, and that is the other half of the point. The digests
;; lived in tests/frontend-native-graph-regression.mjs under ~60 lines of changelog explaining what
;; each repin meant, because a hash can say THAT the graph changed and never WHAT. Here the graph
;; you expected is in the source next to the failure. (`assert-eq` prints the expected side and the
;; line, not the actual -- it is not a diff, it is a readable expectation.)
(module frontendnativegraphtest)

(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "typescriptnative" :use *)
(import "gtext" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "jsl" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.fmt" :use *)

;; The rendered graph for one TypeScript program. 6201 is the seed the smoke programs used; it
;; picks the graph's node-id base, so it is part of what the expected text pins.
(defn render-ts [(source (slice u8))] (-> (slice u8))
  (let [(mut frontend) (fe-native-new source)
        buffer (primitive/alloc-stack (array i8 32768))]
    (if (!= (fe-native-index! (mut frontend)) FE-OK)
        (do (fe-native-free! (mut frontend)) "FRONTEND INDEX FAILED")
        (do (frontend-native-build! (mut frontend) 6201 true)
            (let [out (g-render (cast (ptr i8) buffer) 32768)]
              (fe-native-free! (mut frontend))
              out)))))

;; RE-RECORDED AGAIN when `ToStringValue` learned about arrays. `String([1, 2, 3])` is "1,2,3", so
;; the definition tests `%IsArray` and calls a heap-reading builtin -- and `+` inlines
;; `ToStringValue`, so `n + 1` now says "this expression may read the heap" where it used to
;; synthesise its own. The two memory `Arg`s (same alias mask, merged) became one. The VALUE path
;; is unchanged, which is the thing this pin is actually watching.
;;
;; RE-RECORDED when arithmetic moved into the DSL. The VALUE path is still the six-node ideal --
;; the JsAdd guards folded to nothing, the declared-number return coerced the tagged result back
;; to raw, and Unbox(Box(Add)) cancelled -- but the frontend now threads memory through every
;; function (the DSL's operators may allocate), and the Return keeps its memory input: two mem
;; Args merged for the two alias classes the body could have touched. If this pin fails with MORE
;; nodes on the value path, the round trip stopped folding; that is a regression, not a repin.
(deftest native-graph-basic
  (assert-eq
    (render-ts "function main(n: number): number { return n + 1; }")
    "n0: Start <- : ctrl
n1: Stop <- n7 : ALL
n2: Arg int <- n0 : int
n3: Const int=1 <- n0 : int=1
n4: Arg mem#-9223372036854775808 undefined <- n0 : mem#-9223372036854775808 undefined
n5: Add <- _ n2 n3 : num
n6: MemMerge <- _ n4 : mem#-9223372036854775808 undefined
n7: Return <- n0 n5 n6 : [ctrl,num,mem#-9223372036854775808 undefined]
"))

(import "coil.primitive" :as primitive)
(import "verify" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_x64" :use *)
(extern mmap :cc c [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect :cc c [(ptr u8) i64 i32] (-> i32))
(extern munmap :cc c [(ptr u8) i64] (-> i32))
(extern sys_icache_invalidate :cc c [(ptr u8) i64] (-> void))
(extern aot_mmap_anon_flags :cc c [] (-> i32))
(extern aot_host_is_x86_64 :cc c [] (-> i32))

(deftest source_function_identity_is_independent_of_graph_namespace
  (let [(mut first) (fe-native-new "function main(n) { return n + 1; }")
        (mut second) (fe-native-new "function main(n) { return n + 1; }")
        (mut first-unit) 0
        (mut first-local) 0
        (mut first-jsl-unit) 0
        (mut first-jsl-local) 0]
    (assert (= (fe-native-index! (mut first)) FE-OK))
    (frontend-native-build-dispatched-script-at! (mut first) 7001 true 64)
    (let [fun (n-find-fun-index 65)]
      (assert (!= fun NO-NODE))
      (assert (= (n-fun-identity-kind fun) FUN-IDENTITY-SOURCE))
      (set! first-unit (n-fun-identity-unit fun))
      (set! first-local (n-fun-identity-local fun)))
    (let [decl (jsl-find "JsAdd") fun (n-find-fun-index (jsl-decl-fidx decl))]
      (assert (>= decl 0))
      (assert (!= fun NO-NODE))
      (assert (= (n-fun-identity-kind fun) FUN-IDENTITY-JSL))
      (set! first-jsl-unit (n-fun-identity-unit fun))
      (set! first-jsl-local (n-fun-identity-local fun)))
    (fe-native-free! (mut first))
    (assert (= (fe-native-index! (mut second)) FE-OK))
    (frontend-native-build-dispatched-script-at! (mut second) 7002 true 192)
    (let [fun (n-find-fun-index 193)]
      (assert (!= fun NO-NODE))
      (assert (= (n-fun-identity-kind fun) FUN-IDENTITY-SOURCE))
      (assert (= (n-fun-identity-unit fun) (load first-unit)))
      (assert (= (n-fun-identity-local fun) (load first-local))))
    (let [decl (jsl-find "JsAdd") fun (n-find-fun-index (jsl-decl-fidx decl))]
      (assert (>= decl 0))
      (assert (!= fun NO-NODE))
      (assert (= (n-fun-identity-kind fun) FUN-IDENTITY-JSL))
      (assert (= (n-fun-identity-unit fun) (load first-jsl-unit)))
      (assert (= (n-fun-identity-local fun) (load first-jsl-local))))
    (fe-native-free! (mut second))))

;; JAVASCRIPT SOURCE TO EXECUTED MACHINE CODE, in one process, with no toolchain.
;;
;; This is the whole pipeline a source-level property would need: a string goes to `fe-native-new`,
;; the frontend indexes and lowers it, the machine selector and allocator compile it, and the
;; encoded bytes are mapped executable and called. Nothing here shells out.
;;
;; It also settles the calling convention question: a `number` parameter lowers to an int-typed
;; `Arg`, not a NaN-boxed `dyn`, so an ordinary `(fnptr c [i64] i64)` reaches it.
(deftest javascript_source_compiles_and_executes
  ;; This mmap-only fixture cannot resolve runtime externs. Arithmetic now correctly reaches the
  ;; DSL's throwable ToNumber path, so linked execution tests own it; this one isolates source,
  ;; selection, allocation, encoding, mapping, and the scalar entry ABI without an object linker.
  (let [source "function main(n: number): number { return n; }"
        (mut frontend) (fe-native-new source)]
    (assert (= (fe-native-index! (mut frontend)) FE-OK))
    (frontend-native-build! (mut frontend) 6201 true)
    (assert (= (g-verify) 0))
    (if (be-select-machine-program!)
        0
        (do (fmt (stderr) "selection failed code={d} node={d} machine={d}/{d}\n"
                 (be-result) (be-result-node) (ms-result) (ms-result-item))
            (ms-print-inst (stderr) (ms-result-item))
            (if (and (>= (be-result-node) 0) (< (be-result-node) (n-count)))
                (n-print-flat (stderr) (be-result-node))
                0)
            (assert false)))
    (be-schedule!)
    (assert (= (be-color! 8) 0))
    (let [x64 (!= (aot_host_is_x86_64) (cast i32 0))]
      (assert (if x64 (be-x64-encode-checked!) (be-encode-checked!)))
      (assert (> (if x64 (be-x64-code-len) (be-code-len)) 0))
      (let [mem (mmap (cast (ptr u8) 0) 4096 3 (aot_mmap_anon_flags) -1 0)
            n (if x64 (be-x64-code-len) (be-code-len))
            (mut i) 0]
        (assert (!= (cast i64 mem) -1))
        (loop (if (>= (load i) n) (break)
                (do (store! (index mem (load i))
                            (cast u8 (if x64
                                        (be-x64-code-byte (load i))
                                        (be-code-byte (load i)))))
                    (store! i (+ (load i) 1)) 0)))
        (assert (= (mprotect mem 4096 5) 0))
        (sys_icache_invalidate mem n)
        (let [fp (cast (fnptr c [i64] i64) mem)]
          (assert (= (primitive/call-ptr fp 5) 5))
          (assert (= (primitive/call-ptr fp -1) -1))
          (assert (= (munmap mem 4096) 0))
          0))
      0)
    (fe-native-free! (mut frontend))))


;; The frontend's own world reset: the graph, the shape table and the string-constant table.
(defn js-reset-world! [] (-> i64)
  (graph-reset! 4242)
  (shape-reset!)
  (jss-reset!)
  0)

;; Rest syntax is indexed as a final formal plus explicit function metadata. Native differential
;; coverage below the frontend layer pins the array materialization and argument split.
(deftest a_rest_parameter_is_indexed_with_rest_metadata
  (js-reset-world!)
  (let [(mut fe) (fe-native-new "function main(n: number): number {
  const f = (...xs: number[]): number => xs.length;
  return (n + f(1, 2, 3)) | 0;
}
")]
    (assert (= (fe-native-index! (mut fe)) FE-OK))
    (let [fn (al-get [FeFunction] (.functions fe) 1)]
      (assert (.rest fn))
      (assert (= (.parameter-count fn) 1)))
    (fe-native-free! (mut fe)))
  0)

(deftest independent_script_entries_can_share_a_compiler_dispatcher_without_javascript_wrappers
  (js-reset-world!)
  (let [(mut left) (fe-native-new "var left = 41; left = left + 1;")
        (mut right) (fe-native-new "var right = 6; right = right + 1;")
        (mut entries) (al-new [i64] (malloc-allocator))]
    (assert (= (fe-native-index! (mut left)) FE-OK))
    (assert (= (fe-native-index! (mut right)) FE-OK))
    ;; Each frontend is an independently parsed and indexed Script. Disjoint source-function
    ;; bases prove the graph namespace preserves that boundary while sharing compiler work.
    (frontend-native-begin-script-unit-at! (mut left) 6202 true 512)
    (frontend-native-append-script-unit-at! (mut right) 6203 true 1024)
    (al-push! [i64] (mut entries) 513)
    (al-push! [i64] (mut entries) 1025)
    (frontend-native-build-indexed-dispatcher! (al-slice [i64] (load entries)))
    (frontend-native-finish-appended-units!)
    (assert (= (g-verify) 0))
    (let [(mut node) 0
          (mut saw-left-fun) false
          (mut saw-right-fun) false
          (mut host-calls) 0]
      (loop (if (>= (load node) (n-count))
                (break)
                (do
                  (if (and (not (n-dead? (load node)))
                           (op-is? (load node) Fun [_]))
                      (do
                        (if (= (n-fun-index (load node)) 513)
                            (set! saw-left-fun true)
                            0)
                        (if (= (n-fun-index (load node)) 1025)
                            (set! saw-right-fun true)
                            0))
                      0)
                  (if (and (not (n-dead? (load node)))
                           (op-is? (load node) Call [_]))
                      (set! host-calls (+ (load host-calls) 1))
                      0)
                  (set! node (+ (load node) 1)))))
      (assert (load saw-left-fun))
      (assert (load saw-right-fun))
      (assert (>= (load host-calls) 2)))
    (assert (be-select-machine-program!))
    (al-free! [i64] (mut entries))
    (fe-native-free! (mut left))
    (fe-native-free! (mut right))))

(deftest catch_only_try_indexes_but_finally_is_still_refused
  (js-reset-world!)
  (let [(mut fe) (fe-native-new "function main(n) { try { return n; } catch (error) { return 0; } }")]
    (assert (= (fe-native-index! (mut fe)) FE-OK))
    (frontend-native-build! (mut fe) 6201 true)
    (assert (= (g-verify) 0))
    (fe-native-free! (mut fe)))
  (js-reset-world!)
  (let [(mut fe) (fe-native-new "function main(n) { try { return n; } finally { n = 0; } }")]
    (assert (!= (fe-native-index! (mut fe)) FE-OK))
    (assert (= (load (field fe error-role)) TS-ROLE-FINALLY))
    (fe-native-free! (mut fe)))
  0)

(deftest independent_script_records_share_a_node_space_without_sharing_directive_prologues
  (let [harness "var harness = function() { return this; };"
        test "\"use strict\"; var test = function() { return this; };"
        source "var harness = function() { return this; };\"use strict\"; var test = function() { return this; };"
        raw-lengths (primitive/alloc-stack (array i32 2))]
    (store! (index raw-lengths 0) (cast i32 (slice-len harness)))
    (store! (index raw-lengths 1) (cast i32 (slice-len test)))
    (let [lengths (slice-new [i32] (cast (ptr i32) (index raw-lengths 0)) 2)
          (mut ast) (ts-open-scripts source lengths TS-SCRIPT-JS)
          root (ts-root ast)]
      (assert (= (ts-script-count ast) 2))
      (assert (not (ts-script-strict-at? ast 0)))
      (assert (ts-script-strict-at? ast 1))
      (assert (= (ts-node-script ast (ts-child ast root 0)) 0))
      (assert (= (ts-node-script ast (ts-child ast root 1)) 1))
      (assert (= (ts-node-script ast (ts-child ast (ts-child ast root 0) 0)) 0))
      (assert (= (ts-node-script ast (ts-child ast (ts-child ast root 1) 0)) 1))
      (assert (= (ts-text ast (ts-child ast root 1)) "\"use strict\";"))
      (ts-close! (mut ast))))
  0)
