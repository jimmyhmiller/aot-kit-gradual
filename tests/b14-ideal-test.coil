(module b14idealtest)

(import "node" :use *)
(import "ty" :use *)
(import "eval" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsbuiltin" :use *)
(import "jsbuiltin_desc" :use *)
(import "coil.assert" :use *)

(defn b14-int [(value i64)] (-> i64) (n-new1 OP-CONST (t-int-con value) (g-start)))
(defn b14-run [(value i64)] (-> RtVal)
  (let [ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (assert (= (g-verify) 0))
    (ev-reset!)
    (ev-bind-args! 0)
    (assert (= (ev-run-nobind 10000) EV-OK))
    (ev-result)))

(deftest descriptor_calls_execute_in_raw_and_optimized_ideal_ir
  (graph-reset! 11400)
  (shape-reset!)
  (let [result (b14-run (n-js-builtin! JBI-SQRT (b14-int 81) (b14-int 0)))]
    (assert (= (rt-tag result) RT-FLT))
    (assert (= (rt-payload result) (f64-bits 9.0))))
  (graph-reset! 11401)
  (shape-reset!)
  (let [result (b14-run (n-js-builtin! JBI-POW (b14-int 2) (b14-int 10)))]
    (assert (= (rt-payload result) (f64-bits 1024.0)))))

(deftest uncaught_throw_retains_its_original_payload
  (graph-reset! 11402)
  (shape-reset!)
  (let [payload (b14-int 73)
        ret (n-new2 OP-RETURN 0 (g-start) (n-js-throw! (n-box! payload)))]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (assert (= (g-verify) 0))
    (ev-reset!)
    (ev-bind-args! 0)
    (assert (= (ev-run-nobind 10000) EV-THROW))
    (assert (= (rt-payload (ev-result)) 73))))
