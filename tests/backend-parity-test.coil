;; G0 capability ladder. Unsupported programs are first-class assertions: each must be a verifier-
;; clean ideal program, must fail with the exact capability code, and must publish no bytes.
(module backendparitytest)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "verify" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "eval" :use *)
(import "testmatrix" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

(extern mmap :cc c [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect :cc c [(ptr u8) i64 i32] (-> i32))
(extern munmap :cc c [(ptr u8) i64] (-> i32))
(extern sys_icache_invalidate :cc c [(ptr u8) i64] (-> void))

(const PARITY-BUDGET i64 100000)
(const PARITY-LADDER-COUNT i64 11)

(defn parity-ladder-name [(i i64)] (-> (slice u8))
  (case i 0
        "diamond-two-phis" 1
        "loop-inside-branch" 2
        "loop-two-phis" 3
        "loop-copy-cycle" 4
        "branch-inside-loop" 5
        "two-direct-functions" 6
        "live-across-call" 7
        "direct-recursion" 8
        "mutual-recursion" 9
        "recursive-object-allocation-traversal" 10
        "reduced-binary-trees" "unknown"))

(defn parity-ladder-expected [(i i64)] (-> i64)
  (case i 0
        BER-OK 1
        BER-OK 2
        BER-UNSUPPORTED-PHI 3
        BER-UNSUPPORTED-PHI 4
        BER-UNSUPPORTED-CFG 5
        BER-UNSUPPORTED-CALL 6
        BER-UNSUPPORTED-CALL 7
        BER-UNSUPPORTED-CALL 8
        BER-UNSUPPORTED-CALL 9
        BER-UNSUPPORTED-CALL 10
        BER-UNSUPPORTED-CALL -1))

















(deftest result_codes_are_stable_and_named
         (assert (= BER-OK 0))
         (assert (= BER-MALFORMED-GRAPH 1))
         (assert (= BER-UNSUPPORTED-OPCODE 2))
         (assert (= BER-UNSUPPORTED-CFG 3))
         (assert (= BER-UNSUPPORTED-PHI 4))
         (assert (= BER-UNSUPPORTED-CALL 5))
         (assert (= BER-UNSUPPORTED-CALL-LIVE 6))
         (assert (= BER-ALLOCATION 7))
         (assert (= BER-ENCODING 8))
         (assert (= BER-OBJECT 9))
         (assert (= (be-result-name BER-UNSUPPORTED-CALL) "BER-UNSUPPORTED-CALL")))

(deftest parity_ladder_has_one_monotonic_capability_frontier
         (let [(mut i) 0
               (mut frontier) -1
               (mut unsupported) false]
           (loop (if (>= (load i) PARITY-LADDER-COUNT)
                     (break)
                     (do
                       (let [expected (parity-ladder-expected (load i))]
                         (if (= expected BER-OK)
                             (do (assert (not (load unsupported))) (store! frontier (load i)) 0)
                             (store! unsupported true)))
                       (store! i (+ (load i) 1))
                       0)))
           (assert (= (load frontier) 1))
           (fmt (stdout)
                "\nparity frontier {d}/{d}: {s}\n"
                (+ (load frontier) 1)
                PARITY-LADDER-COUNT
                (parity-ladder-name (load frontier)))))















