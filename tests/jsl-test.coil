;; The JSL gate: a `.jsl` definition becomes an ideal graph, and the evaluator runs it.
;;
;; WHAT THIS SUITE IS ACTUALLY CLAIMING. The point of JSL is that a builtin costs a definition and
;; ZERO dispatch arms, so the claim under test is not "the reader parses" — it is that the graph a
;; `.jsl` file lowers to is one `eval.coil` already knows how to run, with nothing added to it.
;; Every positive case therefore ends in `ev-run-nobind` and asserts the VALUE, because a test that
;; stopped at "the graph verified" would pass just as well against a lowering that built the wrong
;; nodes correctly.
;;
;; THE NEGATIVE CASES ASSERT THE SPECIFIC CODE, following tests/shape-test.coil and text.coil's
;; rule: "it was rejected" is satisfied by a checker that rejects everything, so the claim that
;; matters is that a NAMED check is the one that noticed. Each negative fixture differs from a
;; legal one in exactly the dimension its code names.
;;
;;   coil test tests/jsl-test.coil
(module jsltest)
(import "coil.primitive" :as primitive)

(import "jsl"       :use *)
(import "jsl_lower" :use *)
(import "node"      :use *)
(import "ty"        :use *)
(import "shape"     :use *)
(import "jsstring"  :use *)
(import "jsvalue"   :use *)
(import "verify"    :use *)
(import "coil.assert" :use *)
(import "coil.control" :use *)
(import "coil.slice"  :use *)
(import "coil.alloc"  :use * :as alloc)
(import "coil.str"    :use *)

; ---------------------------------------------------------------------------
; Harness
; ---------------------------------------------------------------------------
(defn fresh! [(seed i64)] (-> i64)
  (graph-reset! seed)
  (shape-reset!)
  (jss-reset!)
  (jsl-reset!)
  0)

(defn sconst [(s (slice u8))] (-> i64) (n-string-const! (jss-from-utf8! s)))
(defn kconst [(t i64)] (-> i64) (n-peephole (n-new1 (Const t) (g-start))))
(defn fconst [(x f64)] (-> i64) (kconst (t-flt-con x)))
(defn bconst [(b bool)] (-> i64) (kconst (t-bool-con b)))
(const INF-BITS i64 9218868437227405312)
(const NEG-INF-BITS i64 -4503599627370496)
(defn iconst [(v i64)] (-> i64) (n-peephole (n-new1 (Const (t-int-con v)) (g-start))))

;; Load, check and lower a unit, asserting each stage. Returns nothing useful; the assertions are
;; the content.
(defn build! [(src (slice u8))] (-> i64)
  (assert (= (jsl-load! src) JSL-OK))
  (assert (= (jsl-lower!) JSL-OK))
  0)

;; The library as it actually ships, loaded off disk through the index.
(defn lib! [(seed i64)] (-> i64)
  (fresh! seed)
  (assert (= (jsl-load-index! "lib/index") JSL-OK))
  (assert (= (jsl-lower!) JSL-OK))
  0)

;; A unit that must be REFUSED, and refused by the named code. `jsl-load!` runs the reader and the
;; checker, so both classes of refusal arrive through one entry point.
(defn refuses [(seed i64) (src (slice u8)) (code i64)] (-> i64)
  (fresh! seed)
  (assert (= (jsl-load! src) code))
  (assert (= (jsl-err) code))
  (assert (not (jsl-ok?)))
  0)

; ---------------------------------------------------------------------------
; Fixtures
; ---------------------------------------------------------------------------
(const SRC-ADD1 "(builtin add1 :params [(x dyn)] :ret dyn (%Add x 1))")

(const SRC-PICK
  "(builtin pick :params [(x dyn)] :ret dyn (if (%Lt x 0) (%Neg x) x))")

(const SRC-LET
  "(builtin scale :params [(x dyn)] :ret dyn (let [(d (%Add x 3)) (e (%Mul d 10))] (%Sub e 1)))")

;; Two definitions, the caller declared `:transitioning` because it contains a call. The callee is
;; declared LATER than its use on purpose: resolution has to see the whole table, which is why
;; `jsl-check` is a second pass over a table `jsl-load!` has already finished building.
(const SRC-CALL
  "(builtin twice :transitioning true :params [(x dyn)] :ret dyn (add1 (add1 x)))
   (builtin add1 :params [(x dyn)] :ret dyn (%Add x 1))")

;; The same pair with the caller's `:transitioning` removed. Nothing about the SOURCE changed shape
;; — only the annotation — so the refusal can only come from inspecting the lowered graph.
(const SRC-CALL-UNDECLARED
  "(builtin twice :params [(x dyn)] :ret dyn (add1 (add1 x)))
   (builtin add1 :params [(x dyn)] :ret dyn (%Add x 1))")

(const SRC-CALL-WITH-RECEIVER
  "(builtin invoke :transitioning true
     :params [(fn dyn) (receiver dyn) (value dyn)] :ret dyn
     (call-with-receiver fn receiver value))")

(const SRC-CALLABLE
  "(callable receiver-plus :params [(value dyn)] :ret dyn (%Add this value))")

(const SRC-CAPTURED-CALLABLE
  "(callable bound-add :transitioning true :captures [target receiver]
       :params [(value dyn)] :ret dyn
       (call-dynamic-with-receiver target receiver value))
   (builtin make-bound :params [(target dyn) (receiver dyn)] :ret dyn
     (closure bound-add target receiver))")

(const SRC-QUOTED-TYPE
  "(builtin narrow :params [(x \"int=[0..9]\")] :ret dyn (%Add x 1))")

;; A `let` that shadows a parameter. The checker and the lowering resolve names through two
;; different mechanisms — a name stack and a node stack — so this is the one program whose answer
;; distinguishes their orders. Resolving parameters first in the checker and innermost-first in the
;; lowering typechecks, verifies, and returns the wrong number.
(const SRC-SHADOW
  "(builtin shadow :params [(x dyn)] :ret dyn (let [(x (%Mul x 100))] (%Add x 5)))")

(deftest an_explicit_array_box_retains_its_runtime_tag_contract
         (fresh! 10067)
         (build! "(builtin boxed-array :params [] :ret dyn (%BoxArray (%NewArray)))")
         (let [(mut i) 0 (mut found) false]
           (loop (if (>= (load i) (n-count)) (break)
                   (do
                     (if (and (not (n-dead? (load i)))
                              (and (op-is? (load i) Box [_])
                                   (= (n-box-kind (load i)) BOX-AUX-ARRAY)))
                         (store! found true)
                         0)
                     (store! i (+ (load i) 1)))))
           (assert (load found))))

(deftest an_explicit_receiver_is_part_of_the_javascript_call_abi
         (fresh! 90109)
         (build! SRC-CALL-WITH-RECEIVER)
         (let [call (first-op OPTAG-CALL)]
           (assert (!= call NO-NODE))
           (assert (= (n-call-abi call) CALL-ABI-RECEIVER))
           ; ctrl, callee, hidden environment, receiver, actual argc, one positional value, and
           ; the implicit heap effect.
           (assert (= (n-nins call) 7)))
         (refuses 90110
                  "(builtin bad :params [(fn dyn)] :ret dyn (call-with-receiver fn))"
                  JSL-ERR-ARITY))

(deftest a_callable_uses_the_javascript_receiver_abi
         (fresh! 90111)
         (build! SRC-CALLABLE)
         (assert (jsl-callable? 0))
         (let [fun (jsl-decl-fun 0)]
           (assert (= (n-parm-index (n-parm! fun 1)) 1))
           (assert (= (n-parm-index (n-parm! fun 2)) 2))
           (assert (= (n-parm-index (n-parm! fun 3)) 3)))
         (refuses 90112
                  "(builtin bad-this :params [] :ret dyn this)"
                  JSL-ERR-UNBOUND))

(deftest a_callable_closure_has_a_checked_materialized_environment
         (fresh! 90113)
         (build! SRC-CAPTURED-CALLABLE)
         (assert (= (jsl-decl-ncaptures 0) 2))
         ;; The immutable library seed has no frontend JavaScript function targets. A callable
         ;; parameter is still open-world at import time, so lowering must retain the dynamic call
         ;; rather than treating the empty target set as proof that this path is unreachable.
         (let [call (first-op OPTAG-CALL)]
           (assert (!= call NO-NODE))
           (assert (= (n-call-abi call) CALL-ABI-DYNAMIC-RECEIVER)))
         (let [closure (first-op OPTAG-CLOSURE)]
           (assert (!= closure NO-NODE))
           (assert (= (n-closure-capture-count closure) 2)))
         (refuses 90114
                  "(callable c :captures [x] :params [] :ret dyn x)
                   (builtin bad :params [] :ret dyn (closure c))"
                  JSL-ERR-ARITY))

;; A DECLARED PARAMETER TYPE IS NOT A FACT (D1/D8). The annotation is recorded on the declaration
;; and is deliberately NOT injected onto the Parm, because a rewrite may only act on a PROVEN type
;; and an injected claim is one nobody computed. This pins that: the narrow spelling above and the
;; wide one below produce the same Parm type, so nothing downstream can act on the annotation yet.
(deftest an_annotation_is_recorded_on_the_declaration_and_never_injected_onto_the_parm
         (fresh! 90106)
         (build! SRC-QUOTED-TYPE)
         (let [narrow-parm (n-parm! (jsl-decl-fun 0) 0)
               narrow-ty (n-ty narrow-parm)]
           (fresh! 90107)
           (build! SRC-ADD1)
           (assert (= (jsl-param-ty 0 0) (t-dyn)))
           (assert (= (n-ty (n-parm! (jsl-decl-fun 0) 0)) narrow-ty))))

; ---------------------------------------------------------------------------
; The library on disk
; ---------------------------------------------------------------------------
;; THE POINT OF THIS BLOCK. Everything above builds its unit from a string literal, which proves
;; the language works but not that a LIBRARY does. These load `lib/index` — the real files, in the
;; real order, through the real reader — and run them. `;;` comments, multi-file name resolution
;; and the index format are all only exercised here.
(deftest the_library_on_disk_loads_and_every_declaration_lowers
         (lib! 90300)
         ; 232: `LooseEqual`, the relational pair, the seven bitwise operations, the arithmetic
         ; group, `NumberRaw`, and the equality/negation trio (`StrictNotEqual`, `LooseNotEqual`,
         ; `LogicalNot`), and `StringReplaceFirst` joined the library.
         ; 230: `ArrayToStringValue`, which is what `String([1, 2, 3])` reaches, plus the two
         ; helpers its cycle stack needs (`ArrayJoinSeen`, `ArraySeenHas`) and `ToStringValueSeen`.
         ; String indexed access now shares the generic DSL GetProperty operation.
         ; 234: `GetIterator`, `IteratorComplete` and `IteratorValue` -- what `for (const x of xs)`
         ; lowers to, over the array iterator that was already here.
         ; 237: built-in Error identity/object construction and ordinary prototype initialization.
         ; 250: eight Number static constants, Number and Boolean primitive-wrapper construction,
         ; and the three Number-hint ToPrimitive operations. 251: built-in Error instanceof.
         ; 253: String wrapper construction and Object(value)'s ToObject dispatch. 254: Array's
         ; runtime one-argument constructor dispatch. 255: shared built-in constructor identity.
         ; 270: data-property descriptors and stable built-in prototype identity. 272: built-in
         ; Error construction and the TypeError-throwing abstract-operation boundary. 273:
         ; property-descriptor and non-configurable-redefinition validation. 276: shared
         ; ArrayLike length, index-presence and indexed-Get operations.
         ; 316: host-side uncaught completion classification, callable names, and unresolvable
         ; assignment semantics.
  (assert (= (jsl-decl-count) 361))
         ; A builtin has a Fun and a macro does not, and every declaration is one or the other.
         (let [(mut i) 0 (mut funs) 0 (mut macros) 0]
           (loop (if (>= (load i) (jsl-decl-count)) (break)
                   (do (if (jsl-macro? (load i))
                           (do (assert (= (jsl-decl-fun (load i)) NO-NODE))
                               (store! macros (+ (load macros) 1)) 0)
                           (do (assert (!= (jsl-decl-fun (load i)) NO-NODE))
                               (store! funs (+ (load funs) 1)) 0))
                       (store! i (+ (load i) 1))
                       0)))
  (assert (= (+ (load funs) (load macros)) 361))
           ; Most existing heap definitions remain macros for graph visibility and historical
           ; stability; called builtins can now carry an implicit heap effect when recursion or
           ; code sharing requires one. BuiltinConstructorValue and BuiltinMethodValue are shared
           ; because each is identity initialization, not caller-specific JavaScript control.
           (assert (= (load macros) 264)))
         (assert (>= (jsl-find "Clamp") 0))
         (assert (>= (jsl-find "StringIndexOfFrom") 0))
         (assert (>= (jsl-find "StringStartsWith") 0))
         (assert (>= (jsl-find "StringEndsWith") 0))
         (assert (>= (jsl-find "StringIncludesFrom") 0))
         (assert (>= (jsl-find "String.prototype.indexOf") 0))
         ; The iterative units, none of which was expressible before `loop`.
         (assert (>= (jsl-find "StringRepeatCount") 0))
         (assert (>= (jsl-find "StringLastIndexOf") 0))
         (assert (>= (jsl-find "StringPadStart") 0))
         (assert (>= (jsl-find "StringSplit") 0))
         (assert (>= (jsl-find "StringSplitWhole") 0))
         (assert (jsl-macro? (jsl-find "RequireObjectCoercible"))))

(deftest a_missing_index_and_an_empty_index_are_refused_by_name
         (fresh! 90309)
         (assert (= (jsl-load-index! "lib/no-such-index") JSL-ERR-NO-SUCH-FILE))
         (fresh! 90310)
         (assert (= (jsl-load-index! "lib/abstract") JSL-ERR-NO-SUCH-FILE)))

; ---------------------------------------------------------------------------
; Negative: each refusal is the one that noticed
; ---------------------------------------------------------------------------
(deftest an_unbound_symbol_is_refused_by_name
         (refuses 90200 "(builtin f :params [(x dyn)] (%Add x y))" JSL-ERR-UNBOUND))

(deftest an_unknown_primitive_is_refused_rather_than_ignored
         (refuses 90201 "(builtin f :params [(x dyn)] (%NoSuchThing x))" JSL-ERR-UNKNOWN-PRIM))

(deftest a_primitive_with_the_wrong_operand_count_is_refused
         (refuses 90202 "(builtin f :params [(x dyn)] (%Add x))" JSL-ERR-ARITY))

(deftest a_call_with_the_wrong_argument_count_is_refused
         (refuses 90203
                  "(builtin f :transitioning true :params [(x dyn)] (g x x))
                   (builtin g :params [(y dyn)] (%Add y 1))"
                  JSL-ERR-ARITY))

(deftest a_call_to_an_undeclared_name_is_refused
         (refuses 90204 "(builtin f :params [(x dyn)] (nope x))" JSL-ERR-UNKNOWN-CALL))

(deftest two_definitions_of_one_name_are_refused
         (refuses 90205
                  "(builtin f :params [(x dyn)] x) (builtin f :params [(y dyn)] y)"
                  JSL-ERR-DUP-NAME))

;; The same definition as a `macro` is accepted, because a macro is lowered into its caller's graph
;; and so reads its caller's memory.
(deftest a_heap_reading_macro_is_accepted
         (fresh! 91202)
         (assert (= (jsl-load! "(macro m :params [(a dyn)] :ret int (%ArrayLen a))") JSL-OK))
         (assert (jsl-decl-uses-memory? (jsl-find "m")))
         (assert (jsl-macro? (jsl-find "m"))))

;; Heap use is a FIXPOINT over the call graph, and the walk must descend into vectors: since the
;; surface moved to brackets, a call written inside a `let` or `loop` binding lives in a `KVec`, and
;; a walk that only entered lists reported "does not read the heap" for a definition that does.
(deftest heap_use_is_found_inside_bracketed_bindings
         (fresh! 91203)
         (assert (= (jsl-load! "(macro m :params [(a dyn)] :ret int (let [(n (%ArrayLen a))] n))")
                    JSL-OK))
         (assert (jsl-decl-uses-memory? (jsl-find "m"))))

;; Both arms publish a distinct ArrayStore into one memory Phi. This is the ordinary shape of
;; JavaScript `[[Set]]` when one arm grows an array and the other only writes the existing slot;
;; keeping it executable is a language requirement, not merely a lowering-unit detail.
(deftest two_writing_arms_produce_a_typed_memory_phi
         (fresh! 91204)
         (assert (= (jsl-load!
                      "(macro chooseStore :params [(c dyn)] :ret dyn
                         (let [(a (%NewArray))]
                           (if c
                               (let [(ignored (%ArrayStore a 0 (%Box 11)))] a)
                               (let [(ignored (%ArrayStore a 0 (%Box 22)))] a))))")
                    JSL-OK))
         (let [ctrl (primitive/alloc-stack (array i64 1))
               mem (primitive/alloc-stack (array i64 1))
               argv (primitive/alloc-stack (array i64 1))
               cp (cast (ptr i64) ctrl)
               mp (cast (ptr i64) mem)
               ap (cast (ptr i64) argv)]
           (store! (index cp 0) (g-start))
           (store! (index mp 0)
                   (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef))) (g-start)))
           (store! (index ap 0) (n-new1 (Arg (t-dyn)) (g-start)))
           (let [value (jsl-inline! cp mp (g-start) "chooseStore" (slice-new [i64] ap 1))
                 ret (n-new3 (Return) (load (index cp 0)) value (load (index mp 0)))]
             (n-add-def! (g-stop) ret)
             (iterate!)
             (g-analyze!)
             (assert (= (g-verify) 0))
             (assert (op-is? (load (index mp 0)) Phi [_]))
             (assert (ty-mem? (n-ty (load (index mp 0))))))))

(deftest a_designed_but_unbuilt_form_is_refused_as_unsupported
         (refuses 90207 "(class JSArray :params [(x dyn)] x)" JSL-ERR-UNSUPPORTED))

(deftest an_unparseable_annotation_is_refused_by_the_one_type_parser
         (refuses 90208 "(builtin f :params [(x notatype)] x)" JSL-ERR-BAD-TYPE))

(deftest a_parenthesised_parameter_list_is_refused_because_the_surface_is_brackets
         ; `coil.reader` distinguishes KList from KVec, so there is one spelling and the other is a
         ; named refusal. Before the reader grew brackets this test asserted the opposite, because
         ; `[` and `]` came back as bare symbols and the bracketed form silently mis-parsed.
         (refuses 90209 "(builtin f :params ((x dyn)) x)" JSL-ERR-BAD-PARAMS))

(deftest a_definition_with_no_body_is_refused
         (refuses 90210 "(builtin f :params [(x dyn)] :ret dyn)" JSL-ERR-NO-BODY))

(deftest a_definition_with_two_bodies_is_refused
         (refuses 90211 "(builtin f :params [(x dyn)] x x)" JSL-ERR-NO-BODY))

(deftest a_malformed_let_binding_is_refused
         (refuses 90212 "(builtin f :params [(x dyn)] (let [(y)] y))" JSL-ERR-BAD-LET))

(deftest an_if_without_three_operands_is_refused
         (refuses 90213 "(builtin f :params [(x dyn)] (if x 1))" JSL-ERR-BAD-IF))

(deftest an_unknown_keyword_is_refused_rather_than_skipped
         (refuses 90214 "(builtin f :nosuchkey true :params [(x dyn)] x)" JSL-ERR-BAD-KEY))

(deftest a_non_boolean_flag_is_refused
         (refuses 90215 "(builtin f :transitioning yes :params [(x dyn)] x)" JSL-ERR-BAD-BOOL))

(deftest a_top_level_form_that_is_not_a_builtin_is_refused
         (refuses 90216 "(defn f 1)" JSL-ERR-UNKNOWN-FORM)
         (refuses 90217 "42" JSL-ERR-NOT-A-LIST))

;; THE ONE THAT IS CHECKED AGAINST THE GRAPH. The source differs from SRC-CALL only by the missing
;; annotation, so nothing syntactic distinguishes them: the refusal can only come from walking the
;; nodes the declaration built and finding an OPTAG-CALL in them. That is what makes this check
;; stronger than the annotation discipline it is modelled on.
(deftest a_call_inside_a_non_transitioning_definition_is_refused_by_the_lowered_graph
         (fresh! 90218)
         (assert (= (jsl-load! SRC-CALL-UNDECLARED) JSL-OK))
         (assert (= (jsl-lower!) JSL-ERR-UNDECLARED-TRANSITION))
         (assert (= (jsl-err) JSL-ERR-UNDECLARED-TRANSITION)))

;; The falsification of the row above: the SAME two definitions with the annotation present must
;; lower clean, or the check would be satisfied by one that always fires.
(deftest the_transition_check_passes_when_the_annotation_is_present
         (fresh! 90219)
         (assert (= (jsl-load! SRC-CALL) JSL-OK))
         (assert (= (jsl-lower!) JSL-OK))
         (assert (jsl-ok?)))

;; The reader's own refusal, surfaced as a named JSL failure rather than retold. `coil.reader`
;; returns a `Diag` carrying the message and the byte range that noticed; `jsl-read!` keeps the
;; message as the error site.
;; SOURCE RANGES. The roadmap requires an unsupported input to fail with a stable diagnostic AND a
;; source range, and `coil.reader` puts `lo`/`hi`/`source` on every node. The range must point at the
;; OFFENDING FORM, not at the whole definition — a range covering the file is a range that tells a
;; reader nothing, and it is what a naive implementation produces.
(deftest a_refusal_carries_the_source_range_of_the_offending_form
         (fresh! 91070)
         ; The unbound `y` is the last thing in the text; its span must be near the end and narrow,
         ; not the whole declaration.
         (let [src "(builtin f :params [(x dyn)] (%Add x y))"]
           (assert (= (jsl-load! src) JSL-ERR-UNBOUND))
           ; `y` is the single byte at offset 37; the range is half-open, so [37,38).
           (assert (= (jsl-err-lo) 37))
           (assert (= (jsl-err-hi) 38))
           ; and it names the source it came from
           (assert (= (jsl-source-path (jsl-err-src)) "<string>")))
         ; A range from a FILE is attributed to that file's path, which is what makes a multi-unit
         ; library's diagnostics readable at all.
         (fresh! 91071)
         (assert (= (jsl-load-index! "lib/index") JSL-OK))
         (assert (> (jsl-source-count) 1))
         (assert (= (jsl-source-path 0) "lib/abstract/clamp.jsl")))

(deftest a_reader_diagnostic_becomes_a_named_jsl_failure
         (refuses 91060 "(builtin f :params [(x dyn)] (%Add x 1)" JSL-ERR-PARSE)
         (refuses 91061 "(builtin f :params [(x dyn)] \"unterminated)" JSL-ERR-PARSE))

; ---------------------------------------------------------------------------
; Loops
; ---------------------------------------------------------------------------
;; A JSL loop is a TAIL-RECURSIVE BINDING GROUP: the body is an expression, and if it evaluates to
;; `(recur …)` the loop iterates with those values, otherwise that value is the loop's value. One
;; Phi per binding, the initialiser on the entry edge and the recur value on the back edge. There is
;; no assignment form and no mutable local anywhere in the language, which is what lets the surface
;; and the IR agree exactly.
(const SRC-SUM
  "(builtin sumto :params [(n dyn)] :ret dyn
     (loop [(i 0) (acc 0)]
       (if (%Lt i n) (recur (%Add i 1) (%Add acc i)) acc)))")

;; Two bindings that move at different rates, so a loop carrying more than one Phi is exercised
;; rather than assumed.
(const SRC-REPEAT
  "(builtin srepeat :params [(s dyn) (n dyn)] :ret dyn
     (loop [(i 0) (out \"\")]
       (if (%Lt i n) (recur (%Add i 1) (%StringConcat out s)) out)))")

;; TWO recur sites, in different arms. The IR gives a Loop exactly one back edge, so these must be
;; merged into a Region and each binding's back-edge value into a Phi over it. A lowering that
;; handled only the single-recur case would build a malformed Loop here.
(const SRC-TWO-RECUR
  "(builtin countodd :params [(n dyn)] :ret dyn
     (loop [(i 0) (acc 0)]
       (if (%Lt i n)
           (if (%Eq (%Mod i 2) 1)
               (recur (%Add i 1) (%Add acc 1))
               (recur (%Add i 1) acc))
           acc)))")

;; A loop inside a loop: the inner one's recurs must not be confused with the outer one's, which is
;; what the per-loop base index into the recur arrays is for.
(const SRC-NESTED
  "(builtin grid :params [(n dyn)] :ret dyn
     (loop [(i 0) (total 0)]
       (if (%Lt i n)
           (recur (%Add i 1)
                  (loop [(j 0) (row total)]
                    (if (%Lt j n) (recur (%Add j 1) (%Add row 1)) row)))
           total)))")

;; A `loop` nothing recurs to would leave the Loop's back edge null; a `loop` everything recurs from
;; cannot terminate and leaves the enclosing body with no Return. Both are named at lowering rather
;; than left to produce a malformed graph several passes later.
(deftest a_loop_that_cannot_iterate_or_cannot_exit_is_refused
         (fresh! 91110)
         (assert (= (jsl-load! "(builtin f :params [(x dyn)] :ret dyn (loop [(i 0)] i))") JSL-OK))
         (assert (= (jsl-lower!) JSL-ERR-LOOP-NO-RECUR))
         (fresh! 91111)
         (assert (= (jsl-load! "(builtin f :params [(x dyn)] :ret dyn (loop [(i 0)] (recur (%Add i 1))))") JSL-OK))
         (assert (= (jsl-lower!) JSL-ERR-LOOP-NO-EXIT)))

(deftest recur_is_checked_against_its_enclosing_loop
         (refuses 91120 "(builtin f :params [(x dyn)] (recur x))" JSL-ERR-RECUR-OUTSIDE-LOOP)
         (refuses 91121
                  "(builtin f :params [(n dyn)] (loop [(i 0)] (if (%Lt i n) (recur i i) i)))"
                  JSL-ERR-BAD-RECUR)
         (refuses 91122 "(builtin f :params [(x dyn)] (loop (i 0) x))" JSL-ERR-BAD-LOOP)
         ; An initialiser is checked in the ENCLOSING scope, so a binding cannot see itself.
         (refuses 91123 "(builtin f :params [(x dyn)] (loop [(i i)] (recur i)))" JSL-ERR-UNBOUND))

; ---------------------------------------------------------------------------
; Macros
; ---------------------------------------------------------------------------
;; How many LIVE nodes carry this op. The specialisation cases below assert absence, so this counts
;; the whole graph rather than one cone: "no If survived anywhere" is the claim, and a cone walk
;; would miss a node left stranded outside it.
(defn count-op [(op i64)] (-> i64)
  (let [n (n-count) (mut i) 0 (mut c) 0]
    (loop (if (>= (load i) n) (break)
            (do (if (and (not (n-dead? (load i))) (= (op-encode-tag (n-op (load i))) op))
                    (set! c (+ (load c) 1)) 0)
                (set! i (+ (load i) 1))
                0)))
    (load c)))

(defn first-op [(op i64)] (-> i64)
  (block :found
    (let [n (n-count) (mut i) 0]
      (loop (if (>= (load i) n) (break)
              (do (if (and (not (n-dead? (load i))) (= (op-encode-tag (n-op (load i))) op))
                      (return-from :found (load i)) 0)
                  (store! i (+ (load i) 1)) 0)))
      NO-NODE)))

;; `useTwice` is NOT declared `:transitioning`, and that is the assertion. A macro is expanded into
;; the caller's graph, so if `Twice` had lowered to a call instead the transition check would see an
;; OPTAG-CALL among the nodes `useTwice` built and refuse the whole unit.
(const SRC-MACRO
  "(macro Twice :params [(x dyn)] (%Mul x 2))
   (builtin useTwice :params [(y dyn)] :ret dyn (%Add (Twice y) 1))")

;; If a macro body could see its caller's bindings, `(M x)` would read the caller's `v` and answer
;; x*100+1. Lexically it is x+1. The two differ for every input, so the number is the whole test.
(const SRC-MACRO-SHADOW
  "(macro M :params [(v dyn)] (%Add v 1))
   (builtin caller :params [(x dyn)] :ret dyn (let [(v (%Mul x 100))] (M x)))")

(const SRC-MACRO-CYCLE
  "(macro A :params [(x dyn)] (B x))
   (macro B :params [(x dyn)] (A x))
   (builtin c :params [(x dyn)] :ret dyn (A x))")

;; A fast path with a bail-out, and a caller that says what bailing out means.
(const SRC-LABEL
  "(macro Positive :params [(x dyn)] :labels [Bail]
     (if (%Lt x 0) (goto Bail) (%Mul x 10)))
   (builtin classify :params [(x dyn)] :ret dyn
     (Positive x :otherwise -1))")

;; THE SAME MACRO, CALLED WITH A STATICALLY KNOWN ARGUMENT. This is the case the whole language
;; exists for: the guard is decidable, so the branch folds, the bail-out never reaches the label,
;; and the handler is never built at all.
(const SRC-SPECIALISE
  "(macro Positive :params [(x dyn)] :labels [Bail]
     (if (%Lt x 0) (goto Bail) (%Mul x 10)))
   (builtin fast :params [(y dyn)] :ret dyn
     (Positive 7 :otherwise (%Add y 999)))")

;; The falsification of the row above. Identical but for the argument, which is now opaque, so the
;; guard, the bail-out and the handler must all survive. Without this pair, "no If in the graph"
;; would be satisfied by a lowering that never built one.
(const SRC-NOT-SPECIALISED
  "(macro Positive :params [(x dyn)] :labels [Bail]
     (if (%Lt x 0) (goto Bail) (%Mul x 10)))
   (builtin slowpath :params [(y dyn)] :ret dyn
     (Positive y :otherwise (%Add y 999)))")

;; A macro that reaches itself has no fixed point, so the expansion would not terminate. It has to
;; be a named diagnostic found statically, not a depth cap that reports a legal deep nest.
(deftest a_recursive_macro_is_refused_before_anything_is_lowered
         (refuses 90402 SRC-MACRO-CYCLE JSL-ERR-MACRO-RECURSION)
         (refuses 90403
                  "(macro A :params [(x dyn)] (A x)) (builtin c :params [(x dyn)] :ret dyn (A x))"
                  JSL-ERR-MACRO-RECURSION))

(deftest a_label_on_a_builtin_is_refused_because_control_cannot_cross_a_call
         (refuses 90409 "(builtin f :labels [L] :params [(x dyn)] x)" JSL-ERR-BAD-LABELS))

(deftest more_labels_than_are_supported_are_refused_by_name
         (refuses 90410 "(macro m :labels [A B] :params [(x dyn)] x)" JSL-ERR-TOO-MANY-LABELS))

(deftest a_goto_naming_no_label_of_its_own_macro_is_refused
         (refuses 90411
                  "(macro m :labels [Bail] :params [(x dyn)] (goto Nope))"
                  JSL-ERR-BAD-GOTO)
         ; A `goto` in a callable with no label at all is the same failure.
         (refuses 90412 "(builtin f :params [(x dyn)] (goto Bail))" JSL-ERR-BAD-GOTO))

(deftest a_labelled_macro_must_be_given_somewhere_to_go
         (refuses 90413
                  "(macro m :labels [Bail] :params [(x dyn)] (goto Bail))
                   (builtin f :params [(x dyn)] :ret dyn (m x))"
                  JSL-ERR-MISSING-OTHERWISE))

(deftest an_otherwise_on_a_callee_with_no_label_is_refused
         (refuses 90414
                  "(macro m :params [(x dyn)] x)
                   (builtin f :params [(x dyn)] :ret dyn (m x :otherwise 0))"
                  JSL-ERR-UNEXPECTED-OTHERWISE)
         (refuses 90415
                  "(builtin f :params [(x dyn)] :ret dyn (%Add x 1 :otherwise 0))"
                  JSL-ERR-UNEXPECTED-OTHERWISE))

; ---------------------------------------------------------------------------
; The primitive table
; ---------------------------------------------------------------------------
;; Every row is complete. A column nobody filled is a `-1`, and a `-1` op would build a node with
;; an opcode no dispatch anywhere recognises, which is exactly the silent failure the one-function
;; -per-column shape exists to make impossible.
(deftest every_primitive_row_names_an_op_and_an_arity
         (let [(mut id) 0 (mut checked) 0 (mut retired) 0]
           (loop (if (>= (load id) JSP-COUNT) (break)
                   (do
                     (if (jsp-retired? (load id))
                         ; a retired id has no row, and no name that could find its way back
                         (do (assert (= (jsp-find (jsp-name (load id))) JSP-NONE))
                             (store! retired (+ (load retired) 1))
                             0)
                       (do
                         (assert (>= (op-encode-tag (jsp-op (load id))) 0))
                         ; `%NewArray` takes no operands: it needs the current control, not a value.
                         (assert (>= (jsp-arity (load id)) 0))
                         (assert (<= (jsp-arity (load id)) 3))
                         (assert (= (jsp-find (jsp-name (load id))) (load id)))
                         (store! checked (+ (load checked) 1))
                         0))
                     (store! id (+ (load id) 1))
                     0)))
           ; The vacuity defence: an empty loop satisfies every assertion above.
           (assert (= (+ (load checked) (load retired)) JSP-COUNT))
           (assert (= (jsp-find "%NotAPrimitive") JSP-NONE))))

(deftest every_failure_code_has_a_distinct_name
         (let [(mut c) 0 (mut named) 0]
           (loop (if (> (load c) JSL-ERR-UNEXPECTED-OTHERWISE) (break)
                   (do
                     (assert (not (= (jsl-err-name (load c)) "<unknown jsl code>")))
                     (store! named (+ (load named) 1))
                     (store! c (+ (load c) 1))
                     0)))
           (assert (= (load named) (+ JSL-ERR-UNEXPECTED-OTHERWISE 1)))))
