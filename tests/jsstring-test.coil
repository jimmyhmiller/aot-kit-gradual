(module jsstringtest)

(import "jsstring" :use *)
(import "jsvalue" :use *)
(import "coil.assert" :use *)

(deftest utf8_decodes_to_javascript_utf16_units
         (jss-reset!)
         (let [value (jss-from-utf8! "A😀Z")]
           (assert (= (jss-length value) 4))
           (assert (= (jss-code-unit value 0) 65))
           (assert (= (jss-code-unit value 1) 55357))
           (assert (= (jss-code-unit value 2) 56832))
           (assert (= (jss-code-unit value 3) 90))))

(deftest equality_and_concatenation_are_content_based
         (jss-reset!)
         (let [left (jss-from-utf8! "co")
               right (jss-from-utf8! "il")
               combined (jss-concat! left right)
               expected (jss-from-utf8! "coil")]
           (assert (jss-equal? combined expected))
           (assert (not (jss-equal? left right)))))

(deftest comparison_uses_javascript_utf16_lexicographic_order
         (jss-reset!)
         (assert (= (jss-compare (jss-from-utf8! "abc") (jss-from-utf8! "abd")) -1))
         (assert (= (jss-compare (jss-from-utf8! "abc") (jss-from-utf8! "abc")) 0))
         (assert (= (jss-compare (jss-from-utf8! "abc") (jss-from-utf8! "ab")) 1)))

(deftest character_bounds_and_range_normalization_match_javascript
         (jss-reset!)
         (let [value (jss-from-utf8! "abcdef")
               substring (jss-substring! value 4 1)
               substr (jss-substr! value -2 1)
               sliced (jss-slice! value -4 -1)]
           (assert (= (jss-code-unit value -1) -1))
           (assert (= (jss-code-unit value 6) -1))
           (assert (jss-equal? substring (jss-from-utf8! "bcd")))
           (assert (jss-equal? substr (jss-from-utf8! "e")))
           (assert (jss-equal? sliced (jss-from-utf8! "cde")))))

(deftest tagged_identity_is_nonzero_aligned_and_round_trips
         (jss-reset!)
         (let [value (jss-from-utf8! "x")
               boxed (jss-box value)]
           (assert (= (jsv-tag boxed) JSV-STRING))
           (assert (= (& (jsv-payload boxed) 7) 0))
           (assert (= (jss-unbox boxed) value))))

(deftest integer_conversion_and_parseint_cover_radix_sign_prefix_and_partial_input
         (jss-reset!)
         (assert (jss-equal? (jss-from-int-radix! -31 16) (jss-from-utf8! "-1f")))
         (match (jss-parse-int (jss-from-utf8! "  -0x1fZ") 0)
           (Some [value] (assert (= value -31)))
           (None [] (assert false)))
         (match (jss-parse-int (jss-from-utf8! "101") 2)
           (Some [value] (assert (= value 5)))
           (None [] (assert false)))
         (match (jss-parse-int (jss-from-utf8! "+") 10)
           (Some [_] (assert false))
           (None [] (assert true))))
