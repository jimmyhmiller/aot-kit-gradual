;; M10 backend foundations.
(module backendtest)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "corpus" :use *)
(import "eval" :use *)
(import "jsvalue" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.primitive" :as primitive)

(extern mmap :cc c [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect :cc c [(ptr u8) i64 i32] (-> i32))
(extern munmap :cc c [(ptr u8) i64] (-> i32))
(extern sys_icache_invalidate :cc c [(ptr u8) i64] (-> void))

(defn raw-const [(v i64)] (-> i64) (n-new1 OP-CONST (t-int-con v) (g-start)))
(defn raw-bin [(op i64) (a i64) (b i64)] (-> i64) (n-new3 op 0 NO-NODE a b))

(defn native-arg-word [(arg i64) (seed i64)] (-> i64)
  (let [t (n-aux arg) (mut i) 0 (mut same) 0]
    (loop
      (if (>= (load i) arg) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-ARG) (= (n-aux (load i)) t)))
                (store! same (+ (load same) 1)) 0)
            (store! i (+ (load i) 1)) 0)))
    (rt-payload (ev-value-in t (+ (* seed 31) (* (load same) 7919))))))

(defn native-arg-at [(idx i64) (seed i64)] (-> i64)
  (let [n (n-count) (mut i) 0 (mut seen) 0 (mut word) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-ARG))
                (if (= (load seen) idx) (do (store! word (native-arg-word (load i) seed)) (break))
                  (store! seen (+ (load seen) 1))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load word)))

(defn native-call3 [(a i64) (b i64) (c i64)] (-> i64)
  (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)
        heap (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
    (assert (!= (cast i64 mem) -1))
    (assert (!= (cast i64 heap) -1))
    (let [n (be-code-len) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
              (store! i (+ (load i) 1)) 0)))
      (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
      (let [fp (cast (fnptr c [i64 i64 i64 i64] i64) mem)
            got (primitive/call-ptr fp a b c (cast i64 heap))]
        (assert (= (munmap heap 4096) 0))
        (assert (= (munmap mem 4096) 0)) got))))

(defn native-call3-double-bits [(a i64) (b i64) (c i64)] (-> i64)
  (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
    (assert (!= (cast i64 mem) -1))
    (let [n (be-code-len) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
              (store! i (+ (load i) 1)) 0)))
      (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
      (let [fp (cast (fnptr c [i64 i64 i64] f64) mem)
            got (f64-bits (primitive/call-ptr fp a b c))]
        (assert (= (munmap mem 4096) 0)) got))))

(defn native-call-object-field [(a i64) (b i64) (c i64) (off i64)] (-> i64)
  (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)
        heap (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
    (assert (!= (cast i64 mem) -1)) (assert (!= (cast i64 heap) -1))
    (let [n (be-code-len) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
              (store! i (+ (load i) 1)) 0)))
      (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
      (let [fp (cast (fnptr c [i64 i64 i64 i64] i64) mem)
            obj (primitive/call-ptr fp a b c (cast i64 heap))
            got (load (cast (ptr i64) (+ obj off)))]
        (assert (= (munmap heap 4096) 0)) (assert (= (munmap mem 4096) 0)) got))))

(defn native-js-word [(i i64)] (-> i64)
  (case i
    0 JSV-UNDEFINED 1 JSV-NULL 2 (+ JSV-BOOLEAN 1) 3 (jsv-box-int -17)
    4 4607182418800017408 5 JSV-NAN 6 (+ JSV-STRING 8) 7 (+ JSV-OBJECT 8)
    8 (+ JSV-ARRAY 8) 9 (+ JSV-FUNCTION 8) 10 (+ JSV-CLOSURE 8)
    11 (+ JSV-REGEXP 8) 12 (+ JSV-REF 8) 0))
(defn native-js-word-count [] (-> i64) 13)

(defn build-kernel [] (-> i64)
  (graph-reset! 1)
  (let [sum (raw-bin OP-ADD (raw-const 20) (raw-const 22))
        product (raw-bin OP-MUL sum (raw-const 2))
        ret (n-new2 OP-RETURN 0 (g-start) product)]
    (n-add-def! (g-stop) ret) (g-analyze!) ret))

(defn select-program-or-report [] (-> bool)
  (let [ok (be-select-machine-program!)]
    (if ok 0
      (do (fmt (stderr) "selection failed be={d}/{d} ms={d}/{d} graph={d}/{d}\n"
               (be-result) (be-result-node) (ms-result) (ms-result-item)
               (be-verify-code) (be-result-node)) 0))
    ok))

(deftest arm64_encoders_match_reviewed_instruction_words
  (assert (= (a64-movz 0 42 0) 3531605312)) ; d2800540  mov x0,#42
  (assert (= (a64-add-reg 0 1 2) 2332164128)) ; 8b020020  add x0,x1,x2
  (assert (= (a64-sdiv 17 15 16) 2597326321)) ; 9ad00df1  sdiv x17,x15,x16
  (assert (= (a64-ret) 3596551104)))           ; d65f03c0  ret

(deftest selection_scheduling_coloring_and_encoding_form_one_pipeline
  (let [ret (build-kernel)]
    (assert (be-select-return! ret))
    (assert (= (be-inst-count) 6))
    (assert (= (be-schedule!) 6))
    ; One register forces real split/spill decisions; eight registers color the kernel fully.
    (assert (> (be-color! 1) 0))
    (assert (= (be-color! 8) 0))
    (assert (= (be-spills) 0))
    (let [n (be-inst-count) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (let [m (be-inst (load i))]
                (if (< (load (field m dst)) 0) 0
                  (assert (or (>= (load (field m reg)) 0)
                              (>= (load (field m spill)) 0)))))
              (store! i (+ (load i) 1)) 0))))
    (be-encode!)
    (assert (> (be-code-len) 12))
    ; The legacy single-entry ABI emits one stack prologue before the first selected instruction.
    ; Published instruction offsets are absolute text offsets and must include it.
    (assert (= (load (field (be-inst 0) first)) 4))
    ; Every arm64 instruction is four bytes and the function ends in RET.
    (assert (= (% (be-code-len) 4) 0))
    (let [n (be-code-len)]
      (assert (= (be-code-byte (- n 4)) 192))
      (assert (= (be-code-byte (- n 3)) 3))
      (assert (= (be-code-byte (- n 2)) 95))
      (assert (= (be-code-byte (- n 1)) 214)))))

(deftest emitted_arm64_is_executable_and_returns_the_ir_value
  (let [ret (build-kernel)]
    (assert (be-select-return! ret))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
      (assert (!= (cast i64 mem) -1))
      (let [dst (cast (ptr u8) mem) n (be-code-len) (mut i) 0]
        (loop
          (if (>= (load i) n) (break)
            (do (store! (index dst (load i)) (cast u8 (be-code-byte (load i))))
                (store! i (+ (load i) 1)) 0)))
        (assert (= (mprotect mem 4096 5) 0))
        (sys_icache_invalidate mem n)
        (let [fp (cast (fnptr c [] i64) mem)]
          (assert (= (primitive/call-ptr fp) 84)))
        (assert (= (munmap mem 4096) 0))))))

(deftest native_box_and_checked_unbox_are_real_machine_operations
  (graph-reset! 101)
  (let [value (raw-const -17)
        boxed (n-new2 OP-BOX 0 NO-NODE value)
        unboxed (n-new2 OP-UNBOX (t-int) NO-NODE boxed)
        ret (n-new2 OP-RETURN 0 (g-start) unboxed)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (be-select-return! ret))
    (let [(mut at) 0 (mut boxes) 0 (mut unboxes) 0]
      (loop
        (if (>= (load at) (be-inst-count)) (break)
          (do (case (ms-inst-op (load at))
                MI-JSBOX (store! boxes (+ (load boxes) 1))
                MI-JSUNBOX (store! unboxes (+ (load unboxes) 1))
                0)
              (store! at (+ (load at) 1)) 0)))
      (assert (= (load boxes) 1))
      (assert (= (load unboxes) 1)))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3 0 0 0) -17))))

(deftest native_box_returns_the_canonical_integer_tagged_word
  (graph-reset! 102)
  (let [boxed (n-new2 OP-BOX 0 NO-NODE (raw-const 42))
        ret (n-new2 OP-RETURN 0 (g-start) boxed)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (be-select-return! ret))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3 0 0 0) (jsv-box-int 42)))))

(deftest tagged_words_survive_direct_calls_and_returns
  (graph-reset! 103)
  (let [fun (n-fun-open! 0) value (n-parm! fun 0)
        body (n-new2 OP-RETURN 0 (n-fun-entry fun) value)]
    (n-fun-close! fun body)
    (let [boxed (n-new2 OP-BOX 0 NO-NODE (raw-const -23))
          site (n-call1! (g-start) fun boxed)
          unboxed (n-new2 OP-UNBOX (t-int) NO-NODE (call-value site))
          ret (n-new2 OP-RETURN 0 (call-end site) unboxed)]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (assert (select-program-or-report))
      (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
      (assert (= (native-call3 0 0 0) -23)))))

(deftest every_tag_survives_the_dynamic_direct_call_abi
  (graph-reset! 109)
  (let [fun (n-fun-open! 0) value (n-parm! fun 0)
        body (n-new2 OP-RETURN 0 (n-fun-entry fun) value)]
    (n-fun-close! fun body)
    (let [arg (n-new1 OP-ARG (t-dyn) (g-start)) site (n-call1! (g-start) fun arg)
          ret (n-new2 OP-RETURN 0 (call-end site) (call-value site))]
      (n-add-def! (g-stop) ret) (g-analyze!)
      (assert (select-program-or-report))
      (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
      (let [(mut i) 0]
        (loop
          (if (>= (load i) (native-js-word-count)) (break)
            (do (let [word (native-js-word (load i))]
                  (assert (= (native-call3 word 0 0) word)))
                (store! i (+ (load i) 1)) 0)))))))

(deftest tagged_words_survive_phi_edges
  (graph-reset! 104)
  (let [arg (n-new1 OP-ARG (t-bool) (g-start))
        iff (n-new2 OP-IF 0 (g-start) arg) arms (n-if-arms! iff)
        region (n-new OP-REGION 0)]
    (n-add-def! region NO-NODE) (n-add-def! region (arms-t arms))
    (n-add-def! region (arms-f arms))
    (let [phi (n-new OP-PHI (t-dyn))]
      (n-add-def! phi region)
      (n-add-def! phi (n-new2 OP-BOX 0 NO-NODE (raw-const 11)))
      (n-add-def! phi (n-new2 OP-BOX 0 NO-NODE (raw-const 22)))
      (let [value (n-new2 OP-UNBOX (t-int) NO-NODE phi)
            ret (n-new2 OP-RETURN 0 region value)]
        (n-add-def! (g-stop) ret) (g-analyze!)
        (assert (select-program-or-report))
        (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
        (assert (= (native-call3 1 0 0) 11))
        (assert (= (native-call3 0 0 0) 22))))))

(deftest every_tag_survives_dynamic_phi_edges
  (graph-reset! 110)
  (let [pred (n-new1 OP-ARG (t-bool) (g-start))
        left (n-new1 OP-ARG (t-dyn) (g-start)) right (n-new1 OP-ARG (t-dyn) (g-start))
        iff (n-new2 OP-IF 0 (g-start) pred) arms (n-if-arms! iff)
        region (n-new OP-REGION 0)]
    (n-add-def! region NO-NODE) (n-add-def! region (arms-t arms))
    (n-add-def! region (arms-f arms))
    (let [phi (n-new OP-PHI (t-dyn))]
      (n-add-def! phi region) (n-add-def! phi left) (n-add-def! phi right)
      (let [ret (n-new2 OP-RETURN 0 region phi)]
        (n-add-def! (g-stop) ret) (g-analyze!)
        (assert (select-program-or-report))
        (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
        (let [(mut i) 0]
          (loop
            (if (>= (load i) (native-js-word-count)) (break)
              (do (let [word (native-js-word (load i))]
                    (assert (= (native-call3 1 word JSV-NULL) word))
                    (assert (= (native-call3 0 JSV-NULL word) word)))
                  (store! i (+ (load i) 1)) 0))))))))

(deftest tagged_words_survive_forced_spills
  (graph-reset! 105)
  (let [fun (n-fun-open! 0) pa (n-parm! fun 0) pb (n-parm! fun 1) pc (n-parm! fun 2)
        ua (n-new2 OP-UNBOX (t-int) NO-NODE pa)
        ub (n-new2 OP-UNBOX (t-int) NO-NODE pb)
        uc (n-new2 OP-UNBOX (t-int) NO-NODE pc)
        body (n-new2 OP-RETURN 0 (n-fun-entry fun)
                     (raw-bin OP-ADD (raw-bin OP-ADD ua ub) uc))]
    (n-fun-close! fun body)
    (let [a (n-new2 OP-BOX 0 NO-NODE (raw-const 10))
          b (n-new2 OP-BOX 0 NO-NODE (raw-const 20))
          c (n-new2 OP-BOX 0 NO-NODE (raw-const 30))
          buf (stack (array i64 3)) args (cast (ptr i64) buf)]
      (store! (index args 0) a) (store! (index args 1) b) (store! (index args 2) c)
      (let [site (n-call! (g-start) fun (slice-new [i64] args 3))
            ret (n-new2 OP-RETURN 0 (call-end site) (call-value site))]
        (n-add-def! (g-stop) ret)))
    (g-analyze!)
    (assert (select-program-or-report)) (be-schedule!)
    (assert (> (be-color! 1) 0))
    (let [(mut vr) 0 (mut boxed-spills) 0]
      (loop
        (if (>= (load vr) (ml-vreg-count)) (break)
          (do (if (and (= (ml-value-kind (load vr)) MLK-BOXED)
                       (>= (mra-spill (load vr)) 0))
                  (store! boxed-spills (+ (load boxed-spills) 1)) 0)
              (store! vr (+ (load vr) 1)) 0)))
      (assert (> (load boxed-spills) 0)))
    (be-encode!) (assert (= (native-call3 0 0 0) 60))))

(deftest tagged_words_survive_dynamic_object_fields
  (graph-reset! 106) (shape-reset!)
  (let [shape (shape-transition SHAPE-ROOT "value" (t-dyn))
        alias (shape-field-alias shape 0)
        mem0 (n-new1 OP-ARG (t-mem-alias alias (t-undef)) (g-start))
        nw (n-new-obj1! (g-start) shape mem0) object (n-obj-ptr nw)
        boxed (n-new2 OP-BOX 0 NO-NODE (raw-const -91))
        mem1 (n-new4 OP-STORE alias NO-NODE (n-obj-mem nw 0) object boxed)
        loaded (n-new3 OP-LOAD alias NO-NODE mem1 object)
        value (n-new2 OP-UNBOX (t-int) NO-NODE loaded)
        ret (n-new3 OP-RETURN 0 (g-start) value mem1)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (select-program-or-report))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3 0 0 0) -91))))

(deftest every_tag_survives_dynamic_object_field_storage
  (graph-reset! 111) (shape-reset!)
  (let [shape (shape-transition SHAPE-ROOT "value" (t-dyn))
        alias (shape-field-alias shape 0)
        value (n-new1 OP-ARG (t-dyn) (g-start))
        mem0 (n-new1 OP-ARG (t-mem-alias alias (t-undef)) (g-start))
        nw (n-new-obj1! (g-start) shape mem0) object (n-obj-ptr nw)
        mem1 (n-new4 OP-STORE alias NO-NODE (n-obj-mem nw 0) object value)
        loaded (n-new3 OP-LOAD alias NO-NODE mem1 object)
        ret (n-new3 OP-RETURN 0 (g-start) loaded mem1)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (select-program-or-report))
    (be-schedule!) (assert (>= (be-color! 8) 0)) (be-encode!)
    (let [(mut i) 0]
      (loop
        (if (>= (load i) (native-js-word-count)) (break)
          (do (let [word (native-js-word (load i))]
                (assert (= (native-call3 word 0 0) word)))
              (store! i (+ (load i) 1)) 0))))))

(deftest native_type_tests_distinguish_integer_tags_from_other_values
  (graph-reset! 107)
  (let [arg (n-new1 OP-ARG (t-dyn) (g-start))
        tested (n-new2 OP-TYPETEST (t-int) NO-NODE arg)
        ret (n-new2 OP-RETURN 0 (g-start) tested)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (select-program-or-report))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3 (jsv-box-int 7) 0 0) 1))
    (assert (= (native-call3 (+ JSV-BOOLEAN 1) 0 0) 0))
    (assert (= (native-call3 4607182418800017408 0 0) 0))))

(deftest native_double_type_tests_include_nan_and_signed_zero_but_exclude_tags
  (graph-reset! 108)
  (let [arg (n-new1 OP-ARG (t-dyn) (g-start))
        tested (n-new2 OP-TYPETEST (t-flt) NO-NODE arg)
        ret (n-new2 OP-RETURN 0 (g-start) tested)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (select-program-or-report))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3 4607182418800017408 0 0) 1))
    (assert (= (native-call3 JSV-NEGATIVE-ZERO 0 0) 1))
    (assert (= (native-call3 JSV-NAN 0 0) 1))
    (assert (= (native-call3 JSV-UNDEFINED 0 0) 0))
    (assert (= (native-call3 (+ JSV-OBJECT 8) 0 0) 0))
    (assert (= (native-call3 (+ JSV-NAN 1) 0 0) 0))
    (assert (= (native-call3 JSV-RESERVED-0 0 0) 0))))

(deftest checked_native_double_unbox_preserves_bits
  (graph-reset! 112)
  (let [arg (n-new1 OP-ARG (t-dyn) (g-start))
        value (n-new2 OP-UNBOX (t-flt) NO-NODE arg)
        ret (n-new2 OP-RETURN 0 (g-start) value)]
    (n-add-def! (g-stop) ret) (g-analyze!)
    (assert (select-program-or-report))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (= (native-call3-double-bits 4607182418800017408 0 0) 4607182418800017408))
    (assert (= (native-call3-double-bits JSV-NEGATIVE-ZERO 0 0) JSV-NEGATIVE-ZERO))
    (assert (= (native-call3-double-bits JSV-NAN 0 0) JSV-NAN))))

(deftest forced_spills_split_ranges_through_stack_slots_and_execute
  (let [ret (build-kernel)]
    (assert (be-select-return! ret))
    (be-schedule!) (assert (> (be-color! 1) 0)) (be-encode!)
    (assert (> (be-code-len) 0))
    (assert (= (native-call3 0 0 0) 84))))

(deftest emitted_code_is_wrapped_in_a_valid_arm64_macho_object
  (let [ret (build-kernel)]
    (assert (be-select-return! ret))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (assert (> (be-macho!) (be-code-len)))
    ; MH_MAGIC_64, little endian.
    (assert (= (be-object-byte 0) 207))
    (assert (= (be-object-byte 1) 250))
    (assert (= (be-object-byte 2) 237))
    (assert (= (be-object-byte 3) 254))))

(deftest generated_functions_obey_the_arm64_integer_argument_abi
  (graph-reset! 2)
  (let [fun (n-fun-open! 0) a (n-parm! fun 0) b (n-parm! fun 1)
        sum (n-new3 OP-ADD 0 NO-NODE a b)
        product (n-new3 OP-MUL 0 NO-NODE sum (raw-const 2))
        ret (n-new2 OP-RETURN 0 (n-fun-entry fun) product)]
    (n-fun-close! fun ret) (g-analyze!)
    (assert (be-select-fun! fun))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
      (assert (!= (cast i64 mem) -1))
      (let [n (be-code-len) (mut i) 0]
        (loop
          (if (>= (load i) n) (break)
            (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
                (store! i (+ (load i) 1)) 0)))
        (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
        (let [fp (cast (fnptr c [i64 i64] i64) mem)]
          (assert (= (primitive/call-ptr fp 20 22) 84))
          (assert (= (primitive/call-ptr fp -5 8) 6)))
        (assert (= (munmap mem 4096) 0))))))

(deftest backend_coverage_is_measured_over_the_real_corpus
  (let [total (corpus-count) (mut i) 0 (mut selected) 0]
    (loop
      (if (>= (load i) total) (break)
        (do (corpus-build! (load i))
            (if (= (n-nins (g-stop)) 1)
                (if (be-select-return! (n-in (g-stop) 0))
                    (do (be-schedule!) (be-color! 8)
                        (let [n (be-inst-count) (mut j) 0]
                          (loop
                            (if (>= (load j) n) (break)
                              (do (let [m (be-inst (load j))]
                                    (if (< (load (field m dst)) 0) 0
                                      (assert (or (>= (load (field m reg)) 0)
                                                  (>= (load (field m spill)) 0)))))
                                  (store! j (+ (load j) 1)) 0))))
                        (store! selected (+ (load selected) 1)))
                  (if (be-select-program!)
                      (do (be-schedule!) (be-color! 8)
                          (store! selected (+ (load selected) 1)))
                    (do (fmt (stderr) "backend did not select {s}\n" (corpus-name (load i))) 0)))
              (if (be-select-program!)
                  (do (be-schedule!) (be-color! 8)
                      (store! selected (+ (load selected) 1)))
                (do (fmt (stderr) "backend did not select {s}\n" (corpus-name (load i))) 0)))
            (store! i (+ (load i) 1)) 0)))
    ; This floor rises as CFG, dynamic, and heap lowering land. It prevents backend coverage from
    ; silently shrinking while M10 is in progress.
    (assert (= (load selected) total))))

(deftest branch_cfg_is_lowered_with_patched_arm64_control_flow
  (graph-reset! 3)
  (let [arg (n-new1 OP-ARG (t-bool) (g-start))
        iff (n-peephole (n-new2 OP-IF 0 (g-start) arg))
        arms (n-if-arms! iff)
        yes (n-new2 OP-RETURN 0 (arms-t arms) (raw-const 11))
        no (n-new2 OP-RETURN 0 (arms-f arms) (raw-const 22))]
    (n-add-def! (g-stop) yes) (n-add-def! (g-stop) no) (iterate!)
    (assert (be-select-program!))
    (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
    (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
      (assert (!= (cast i64 mem) -1))
      (let [n (be-code-len) (mut i) 0]
        (loop
          (if (>= (load i) n) (break)
            (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
                (store! i (+ (load i) 1)) 0)))
        (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
        (let [fp (cast (fnptr c [i64] i64) mem)]
          (assert (= (primitive/call-ptr fp 1) 11))
          (assert (= (primitive/call-ptr fp 0) 22)))
        (assert (= (munmap mem 4096) 0))))))

(deftest diamond_phis_execute_as_arm64_conditional_selects
  (graph-reset! 4)
  (let [arg (n-new1 OP-ARG (t-bool) (g-start))
        iff (n-peephole (n-new2 OP-IF 0 (g-start) arg))
        arms (n-if-arms! iff)
        r (n-new OP-REGION 0)]
    (n-add-def! r NO-NODE) (n-add-def! r (arms-t arms)) (n-add-def! r (arms-f arms))
    (let [phi (n-new OP-PHI (t-int))]
      (n-add-def! phi r) (n-add-def! phi (raw-const 11)) (n-add-def! phi (raw-const 22))
      (let [ret (n-new2 OP-RETURN 0 r phi)]
        (n-add-def! (g-stop) ret) (g-analyze!)
        (assert (be-select-return! ret))
        (be-schedule!) (assert (= (be-color! 8) 0)) (be-encode!)
        (let [mem (mmap (cast (ptr u8) 0) 4096 3 4098 -1 0)]
          (assert (!= (cast i64 mem) -1))
          (let [n (be-code-len) (mut i) 0]
            (loop
              (if (>= (load i) n) (break)
                (do (store! (index mem (load i)) (cast u8 (be-code-byte (load i))))
                    (store! i (+ (load i) 1)) 0)))
            (assert (= (mprotect mem 4096 5) 0)) (sys_icache_invalidate mem n)
            (let [fp (cast (fnptr c [i64] i64) mem)]
              (assert (= (primitive/call-ptr fp 1) 11))
              (assert (= (primitive/call-ptr fp 0) 22)))
            (assert (= (munmap mem 4096) 0))))))))

(deftest selected_integer_corpus_programs_match_the_ir_interpreter_natively
  (let [total (corpus-count) (mut i) 0 (mut compared) 0]
    (loop
      (if (>= (load i) total) (break)
        (do (corpus-build! (load i))
            (let [ok (if (= (n-nins (g-stop)) 1)
                         (if (be-select-return! (n-in (g-stop) 0)) true
                           (be-select-program!))
                       (be-select-program!))]
              (if (not ok) 0
                (do (be-schedule!) (be-color! 8)
                    (if (or (> (be-spills) 0) (< (be-encode!) 0)) 0
                      (let [a (native-arg-at 0 5) b (native-arg-at 1 5) c (native-arg-at 2 5)]
                        (if (!= (ev-run-bound 5 100000) EV-OK) 0
                          (if (or (= (rt-tag (ev-result)) RT-INT)
                                  (= (rt-tag (ev-result)) RT-BOOL))
                              (do (let [got (native-call3 a b c) want (rt-payload (ev-result))]
                                    (if (= got want) 0
                                      (do (fmt (stderr) "native mismatch corpus {d}: args {d},{d},{d}; got {d}, want {d}\n"
                                               (load i) a b c got want)
                                          (let [nn (be-inst-count) (mut jj) 0]
                                            (loop
                                              (if (>= (load jj) nn) (break)
                                                (do (let [mm (be-inst (load jj))]
                                                      (fmt (stderr) "  mi {d}: op={d} d={d} a={d} b={d} r={d} [{d},{d}]\n"
                                                           (load jj) (load (field mm op)) (load (field mm dst))
                                                           (load (field mm a)) (load (field mm b))
                                                           (load (field mm reg)) (load (field mm first))
                                                           (load (field mm last))))
                                                    (store! jj (+ (load jj) 1)) 0))) 0)
                                          (assert false))))
                                  (store! compared (+ (load compared) 1))) 0)))))))
            (store! i (+ (load i) 1)) 0)))
    (assert (>= (load compared) 24))))

(deftest canonical_loop_executes_native_backedge_and_phi_move
  (corpus-build! CX-LOOP)
  (assert (be-select-program!))
  (be-schedule!) (assert (= (be-color! 8) 0))
  (be-encode!) (assert (> (be-code-len) 0))
  (assert (= (native-call3 0 0 0) 5)))

(deftest object_loop_executes_ordered_native_store_chain
  (corpus-build! CX-OBJECT-LOOP)
  (assert (be-select-program!))
  (be-schedule!) (assert (= (be-color! 8) 0))
  (be-encode!) (assert (> (be-code-len) 0))
  (assert (= (native-call3 0 0 0) 2)))

(deftest nested_loops_compile_to_finite_machine_cfg
  (corpus-build! CX-NESTED)
  (assert (be-select-program!))
  (be-schedule!) (assert (= (be-color! 8) 0))
  (be-encode!) (assert (> (be-code-len) 0)))

(deftest returned_object_fields_match_the_interpreter_heap
  (let [total (corpus-count) (mut i) 0 (mut compared) 0]
    (loop
      (if (>= (load i) total) (break)
        (do (corpus-build! (load i))
            (let [ok (if (= (n-nins (g-stop)) 1)
                         (if (be-select-return! (n-in (g-stop) 0)) true (be-select-program!))
                       (be-select-program!))]
              (if (not ok) 0
                (do (be-schedule!) (be-color! 8) (be-encode!)
                    (let [a (native-arg-at 0 5) b (native-arg-at 1 5) c (native-arg-at 2 5)]
                      (if (!= (ev-run-bound 5 100000) EV-OK) 0
                        (if (!= (rt-tag (ev-result)) RT-OBJ) 0
                          (let [obj (rt-payload (ev-result))
                                alias (shape-field-alias (ev-obj-shape obj) 0)
                                ver (hv-find (ev-result-mem) obj alias)]
                            (assert (>= ver 0))
                            (assert (= (native-call-object-field a b c (be-field-off alias))
                                       (rt-payload (hve-val (hv-ent ver)))))
                            (store! compared (+ (load compared) 1)))))))))
            (store! i (+ (load i) 1)) 0)))
    (assert (>= (load compared) 3))))
