(module binarytreesdifferentialtest)

(import "binarytrees" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "verify" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.assert" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn expected-pow2 [(n i64)] (-> i64)
  (let [(mut value) 1 (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (set! value (* (load value) 2))
            (set! i (+ (load i) 1)) 0)))
    (load value)))

(defn expected-tree-check [(depth i64)] (-> i64)
  (- (expected-pow2 (+ depth 1)) 1))

(deftest canonical_graph_reaches_the_complete_native_backend
  (binarytrees-build! 2201)
  (assert (= (g-verify) 0))
  (let [selected (be-select-machine-program!)]
    (if selected 0
      (do (fmt (stderr) "canonical selection be={d} cfg={d}:{d} select={d}:{d}\n"
               (be-result) (mu-verify-result) (mu-verify-item)
               (ms-result) (ms-result-item))
          (ms-dump (stderr)) 0))
    (assert selected))
  (assert (> (be-schedule!) 0))
  (assert (>= (be-color! 8) 0))
  (be-use-runtime-allocation! true)
  (be-encode!)
  (assert (> (be-code-len) 0))
  (assert (be-macho-checked!)))
