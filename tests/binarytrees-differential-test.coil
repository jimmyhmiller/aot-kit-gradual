(module binarytreesdifferentialtest)

(import "binarytrees" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "verify" :use *)
(import "eval" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "backend_macho" :use *)
(import "coil.assert" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn expected-pow2 [(n i64)] (-> i64)
  (let [(mut value) 1 (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (set! value (* (load value) 2))
            (set! i (+ (load i) 1)) 0)))
    (load value)))

(defn expected-tree-check [(depth i64)] (-> i64)
  (- (expected-pow2 (+ depth 1)) 1))

(defn result-field [(slot i64)] (-> i64)
  (let [obj (rt-payload (ev-result)) shape (ev-obj-shape obj)
        alias (shape-field-alias shape slot)
        ver (hv-find (ev-result-mem) obj alias)]
    (assert (>= ver 0))
    (rt-payload (hve-val (hv-ent ver)))))

(defn run-canonical! [(depth i64) (seed i64) (optimize bool)] (-> i64)
  (let [arg (binarytrees-build-mode! seed optimize)]
    (assert (= (g-verify) 0))
    (ev-reset!)
    (ev-bind! arg (RInt depth))
    (let [status (ev-run-nobind 100000000)]
      (if (= status EV-OK) 0
        (do (fmt (stderr) "canonical interpreter depth={d} status={d} steps={d} at={d}\n"
                 depth status (ev-steps) (ev-at)) 0))
      (assert (= status EV-OK)))
    (assert (= (rt-tag (ev-result)) RT-OBJ))
    arg))

(defn assert-canonical-result [(max-depth i64)] (-> i64)
  (assert (= (result-field 0) (+ max-depth 1)))
  (assert (= (result-field 1) (expected-tree-check (+ max-depth 1))))
  (let [(mut slot) 0]
    (loop
      (if (>= (load slot) BT-WORK-SLOTS) (break)
        (do
          (let [depth (+ BT-MIN-DEPTH (* (load slot) 2))
                base (+ 2 (* (load slot) 3))]
            (assert (= (result-field base) depth))
            (if (<= depth max-depth)
                (let [iterations (expected-pow2 (+ (- max-depth depth) BT-MIN-DEPTH))]
                  (assert (= (result-field (+ base 1)) iterations))
                  (assert (= (result-field (+ base 2))
                             (* iterations (expected-tree-check depth)))))
              (do (assert (= (result-field (+ base 1)) 0))
                  (assert (= (result-field (+ base 2)) 0)) 0)))
          (set! slot (+ (load slot) 1)) 0))))
  (assert (= (result-field 29) max-depth))
  (assert (= (result-field 30) (expected-tree-check max-depth)))
  0)

(deftest canonical_structured_observables_match_the_reference_formula
  (let [(mut depth) 4]
    (loop
      (if (> (load depth) 10) (break)
        (do (run-canonical! (load depth) (+ 2100 (load depth)) false)
            (assert-canonical-result (load depth))
            (run-canonical! (load depth) (+ 3100 (load depth)) true)
            (assert-canonical-result (load depth))
            (store! depth (+ (load depth) 2)) 0)))))

(deftest canonical_graph_reaches_the_complete_native_backend
  (binarytrees-build! 2201)
  (assert (= (g-verify) 0))
  (let [selected (be-select-machine-program!)]
    (if selected 0
      (do (fmt (stderr) "canonical selection be={d} cfg={d}:{d} select={d}:{d}\n"
               (be-result) (mu-verify-result) (mu-verify-item)
               (ms-result) (ms-result-item))
          (ms-dump (stderr)) 0))
    (assert selected))
  (assert (> (be-schedule!) 0))
  (assert (>= (be-color! 8) 0))
  (be-use-runtime-allocation! true)
  (be-encode!)
  (assert (> (be-code-len) 0))
  (assert (be-macho-checked!)))
