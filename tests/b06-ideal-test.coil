(module b06idealtest)

(import "ty" :use *)
(import "node" :use *)
(import "eval" :use *)
(import "verify" :use *)
(import "jsvalue" :use *)
(import "coil.assert" :use *)

(const BUDGET i64 10000)

(defn b06-int [(value i64)] (-> i64)
  (n-peephole (n-new1 OP-CONST (t-int-con value) (g-start))))
(defn b06-float [(value f64)] (-> i64)
  (n-peephole (n-new1 OP-CONST (t-flt-con value) (g-start))))
(defn b06-bin [(op i64) (a i64) (b i64)] (-> i64)
  (n-peephole (n-new3 op 0 NO-NODE a b)))
(defn b06-return [(value i64)] (-> i64)
  (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (g-start) value)) 0)

(deftest bitwise_constant_folding_uses_javascript_coercion
  (graph-reset! 1600)
  (let [shifted (b06-bin OP-SHL (b06-float 3.9) (b06-int 33))]
    (assert (= (n-op shifted) OP-CONST))
    (assert (= (ty-int-lo (n-ty shifted)) 6)))
  (graph-reset! 1601)
  (let [shifted (b06-bin OP-USHR (b06-int -1) (b06-int 0))]
    (assert (= (n-op shifted) OP-CONST))
    (assert (= (ty-int-lo (n-ty shifted)) 4294967295))))

(deftest evaluator_distinguishes_arithmetic_and_unsigned_right_shift
  (graph-reset! 1602)
  (let [a (n-new1 OP-ARG (t-flt) (g-start)) b (n-new1 OP-ARG (t-int) (g-start))]
    (b06-return (n-new3 OP-USHR 0 NO-NODE a b))
    (g-analyze!)
    (ev-reset!) (ev-bind! a (RFlt (f64-bits -1.75))) (ev-bind! b (RInt 32))
    (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-OK))
    (assert (rt-eq? (ev-result) (RInt 4294967295)))))

(deftest evaluator_remainder_preserves_negative_zero
  (graph-reset! 1603)
  (let [a (n-new1 OP-ARG (t-flt) (g-start)) b (n-new1 OP-ARG (t-flt) (g-start))]
    (b06-return (n-new3 OP-MOD 0 NO-NODE a b))
    (g-analyze!)
    (ev-reset!) (ev-bind! a (RFlt (f64-bits -4.0))) (ev-bind! b (RFlt (f64-bits 2.0)))
    (ev-run-nobind BUDGET)
    (assert (= (ev-status) EV-OK))
    (assert (rt-eq? (ev-result) (RFlt JSV-NEGATIVE-ZERO)))))

(deftest new_ops_have_verified_arity_and_slots
  (graph-reset! 1604)
  (b06-return (n-new2 OP-BITNOT 0 NO-NODE (b06-int 0)))
  (g-analyze!)
  (assert (= (g-verify) 0)))
