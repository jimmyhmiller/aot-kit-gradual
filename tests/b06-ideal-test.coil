(module b06idealtest)

(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "jsvalue" :use *)
(import "coil.assert" :use *)

(const BUDGET i64 10000)

(defn b06-int [(value i64)] (-> i64)
  (n-peephole (n-new1 (Const (t-int-con value)) (g-start))))
(defn b06-float [(value f64)] (-> i64)
  (n-peephole (n-new1 (Const (t-flt-con value)) (g-start))))
(defn b06-bin [(op Op) (a i64) (b i64)] (-> i64)
  (n-peephole (n-new3 op NO-NODE a b)))
(defn b06-return [(value i64)] (-> i64)
  (n-add-def! (g-stop) (n-new2 (Return) (g-start) value)) 0)

(deftest bitwise_constant_folding_uses_javascript_coercion
  (graph-reset! 1600)
  (let [shifted (b06-bin (Shl) (b06-float 3.9) (b06-int 33))]
    (assert (op-is? shifted Const [_]))
    (assert (= (ty-int-lo (n-ty shifted)) 6)))
  (graph-reset! 1601)
  (let [shifted (b06-bin (UShr) (b06-int -1) (b06-int 0))]
    (assert (op-is? shifted Const [_]))
    (assert (= (ty-int-lo (n-ty shifted)) 4294967295))))

(deftest new_ops_have_verified_arity_and_slots
  (graph-reset! 1604)
  (b06-return (n-new2 (BitNot) NO-NODE (b06-int 0)))
  (g-analyze!)
  (assert (= (g-verify) 0)))
