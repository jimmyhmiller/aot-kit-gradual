(module jsbuiltintest)

(import "coil.assert" :use *)
(import "jsbuiltin" :use *)
(import "jsbuiltin_desc" :use *)
(import "jsvalue" :use *)
(import "ty" :use *)

(deftest descriptor_table_covers_the_exact_corpus_math_surface
  (assert (= JBI-COUNT 17))
  (let [(mut id) 0]
    (loop (if (>= (load id) JBI-COUNT)
              (break)
              (do
                (assert (= (jbi-find (jbi-name (load id))) (load id)))
                (assert (= (jbi-result-kind (load id)) JBI-RESULT-NUMBER))
                (assert (= (jbi-coercion (load id)) JBI-COERCE-NUMBER))
                (assert (not (jbi-allocates? (load id))))
                (assert (not (jbi-safepoint? (load id))))
                (store! id (+ (load id) 1)))))))

(deftest descriptors_pin_arity_and_unknown_rejection
  (assert (jbi-valid-arity? JBI-SQRT 1))
  (assert (not (jbi-valid-arity? JBI-SQRT 0)))
  (assert (jbi-valid-arity? JBI-POW 2))
  (assert (jbi-valid-arity? JBI-RANDOM 0))
  (assert (= (jbi-find "Math.notAFunction") JBI-NONE)))

(deftest evaluator_covers_boundaries_and_javascript_rounding
  (assert (= (f64-bits (jbi-eval JBI-SQRT 9.0 0.0)) (f64-bits 3.0)))
  (assert (= (f64-bits (jbi-eval JBI-POW 2.0 10.0)) (f64-bits 1024.0)))
  (assert (= (f64-bits (jbi-eval JBI-ROUND -0.5 0.0)) (f64-bits -0.0)))
  (assert (= (f64-bits (jbi-eval JBI-ROUND 1.5 0.0)) (f64-bits 2.0)))
  (assert (= (f64-bits (jbi-eval JBI-MIN -0.0 0.0)) (f64-bits -0.0)))
  (assert (= (f64-bits (jbi-eval JBI-MAX -0.0 0.0)) (f64-bits 0.0)))
  (assert (= (f64-bits (jbi-eval JBI-MIN (bits-f64 JSV-NAN) 0.0)) JSV-NAN)))

(deftest random_matches_the_pinned_v8_v7_jenkins_sequence
  (jbi-random-reset!)
  (assert (= (f64-bits (jbi-eval JBI-RANDOM 0.0 0.0))
             4607067863935614976))
  (assert (= (f64-bits (jbi-eval JBI-RANDOM 0.0 0.0))
             4599955101774249984))
  (jbi-random-reset!)
  (assert (= (f64-bits (jbi-eval JBI-RANDOM 0.0 0.0))
             4607067863935614976)))
