;; G9 dependency-correct local scheduling.
(module backendscheduletest)

(import "ty" :use *)
(import "node" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "native_code_test_support" :use *)
(import "corpus" :use *)
(import "shape" :use *)
(import "coil.assert" :use *)
(import "coil.alloc" :use *)
(import "coil.primitive" :as primitive)

(extern mmap :cc c [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect :cc c [(ptr u8) i64 i32] (-> i32))
(extern munmap :cc c [(ptr u8) i64] (-> i32))
(extern sys_icache_invalidate :cc c [(ptr u8) i64] (-> void))

(defn sched-const [(v i64)] (-> i64)
  (n-new1 (Const (t-int-con v)) (g-start)))
(defn sched-bin [(op Op) (a i64) (b i64)] (-> i64)
  (n-peephole (n-new3 op NO-NODE a b)))

(defn sched-inst-for [(node i64)] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) (be-inst-count)) (>= (load found) 0)) (break)
        (do
          (if (= (ms-inst-node (load i)) node) (set! found (load i)) 0)
          (set! i (+ (load i) 1)) 0)))
    (load found)))

(defn sched-first-op [(op i64)] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) (be-inst-count)) (>= (load found) 0)) (break)
        (do
          (if (= (ms-inst-op (load i)) op) (set! found (load i)) 0)
          (set! i (+ (load i) 1)) 0)))
    (load found)))

(defn build-independent-arithmetic! [] (-> i64)
  (graph-reset! 901)
  (let [x (n-new1 (Arg (t-int)) (g-start))
        left (sched-bin (Add) x (sched-const 1))
        right (sched-bin (Mul) x (sched-const 2))
        result (sched-bin (Add) left right)
        ret (n-new2 (Return) (g-start) result)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    result))

(defn sched-native1 [(arg i64)] (-> i64)
  (let [mem (mmap (cast (ptr u8) 0) 4096 3 (host-native-mmap-flags) -1 0)]
    (assert (!= (cast i64 mem) -1))
    (let [n (host-native-code-len) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (set! (index mem (load i)) (cast u8 (host-native-code-byte (load i))))
              (set! i (+ (load i) 1)) 0)))
      (assert (= (mprotect mem 4096 5) 0))
      (sys_icache_invalidate mem n)
      (let [fp (cast (fnptr c [i64] i64) mem) got (primitive/call-ptr fp arg)]
        (assert (= (munmap mem 4096) 0))
        got))))

(defn compile-seed! [(seed i64)] (-> i64)
  (build-independent-arithmetic!)
  (assert (be-select-machine-program!))
  (assert (> (be-schedule-seeded! seed) 0))
  (assert (= (ms-schedule-result) MSCHED-OK))
  (be-color! 10)
  (assert (host-native-encode-checked!))
  (sched-native1 5))

(deftest three_tie_break_seeds_preserve_native_result
  (assert (= (compile-seed! 0) 16))
  (assert (= (compile-seed! 1) 16))
  (assert (= (compile-seed! 2) 16)))

(deftest nonzero_seed_changes_a_ready_tie_without_changing_legality
  (let [(mut zero-left) -1 (mut zero-right) -1 (mut one-left) -1 (mut one-right) -1]
    (let [result (build-independent-arithmetic!) left (n-in result 1) right (n-in result 2)]
      (assert (be-select-machine-program!))
      (assert (> (be-schedule-seeded! 0) 0))
      (store! zero-left (sched-inst-for left))
      (store! zero-right (sched-inst-for right)))
    (let [result (build-independent-arithmetic!) left (n-in result 1) right (n-in result 2)]
      (assert (be-select-machine-program!))
      (assert (> (be-schedule-seeded! 1) 0))
      (store! one-left (sched-inst-for left))
      (store! one-right (sched-inst-for right)))
    (assert (or (!= (load zero-left) (load one-left))
                (!= (load zero-right) (load one-right))))))

(deftest scalar_dependency_reversal_has_a_named_failure
  (let [result (build-independent-arithmetic!)]
    (assert (be-select-machine-program!))
    (assert (> (be-schedule-seeded! 0) 0))
    (let [consumer (sched-inst-for result) producer (ms-def-inst (ms-inst-a consumer))]
      (assert (< producer consumer))
      (ms-corrupt-schedule-swap! producer consumer)
      (assert (not (ms-verify-schedule!)))
      (assert (= (ms-schedule-result) MSCHED-DEPENDENCY)))))

(deftest load_store_anti_dependency_forces_load_first
  (graph-reset! 902)
  (shape-reset!)
  (let [sx (shape-transition SHAPE-ROOT "x" (t-dyn)) ax (shape-field-alias sx 0)
        nw (n-new-obj1! (g-start) sx (mk-mem-in ax)) obj (n-obj-ptr nw)
        mem0 (n-obj-mem nw 0)
        init (n-new4 (Store ax) NO-NODE mem0 obj (sched-const 1))
        loaded (n-new3 (Load ax) NO-NODE init obj)
        later (n-new4 (Store ax) NO-NODE init obj (sched-const 2))
        ret (n-new3 (Return) (g-start) loaded later)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (assert (be-select-machine-program!))
    (assert (> (be-schedule-seeded! 2) 0))
    (let [load-at (sched-inst-for loaded) store-at (sched-inst-for later)]
      (assert (< load-at store-at))
      (ms-corrupt-schedule-swap! load-at store-at)
      (assert (not (ms-verify-schedule!)))
      (assert (= (ms-schedule-result) MSCHED-MEMORY)))))

(deftest property_load_store_anti_dependency_forces_load_first
  (graph-reset! 903)
  (shape-reset!)
  (let [object (n-new1 (Arg (t-obj)) (g-start))
        memory
          (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef)))
                  (g-start))
        loaded (n-prop-load-at! (g-start) memory object "value")
        later (n-prop-store-at! (g-start) memory object (n-box! (sched-const 2)) "value")
        ret (n-new3 (Return) (g-start) loaded later)]
    (n-add-def! (g-stop) ret)
    (g-analyze!)
    (assert (be-select-machine-program!))
    (let [(mut load-at) (sched-inst-for loaded) (mut store-at) (sched-inst-for later)]
      (assert (= (ms-inst-memory-anti-count (load store-at)) 1))
      (assert (= (ms-inst-memory-anti-node (load store-at) 0) loaded))
      (assert (> (be-schedule-seeded! 0) 0))
      (store! load-at (sched-inst-for loaded))
      (store! store-at (sched-inst-for later))
      (assert (< (load load-at) (load store-at)))
      (ms-corrupt-schedule-swap! (load load-at) (load store-at))
      (assert (not (ms-verify-schedule!)))
      (assert (= (ms-schedule-result) MSCHED-MEMORY)))))

(deftest omitted_instruction_via_duplicate_has_a_named_failure
  (build-independent-arithmetic!)
  (assert (be-select-machine-program!))
  (assert (> (be-schedule-seeded! 0) 0))
  (ms-corrupt-schedule-duplicate! 2 1)
  (assert (not (ms-verify-schedule!)))
  (assert (= (ms-schedule-result) MSCHED-EXACTLY-ONCE)))

(deftest entry_label_and_terminator_boundaries_are_verified
  (build-independent-arithmetic!)
  (assert (be-select-machine-program!))
  (assert (> (be-schedule-seeded! 0) 0))
  (let [first (mu-block-inst-first 0) count (mu-block-inst-count 0)
        last (+ first (- count 1))]
    (assert (= (ms-inst-op first) MI-LABEL))
    (assert (mi-desc-terminator? (mi-desc (ms-inst-op last))))
    (ms-corrupt-schedule-swap! first (+ first 1))
    (assert (not (ms-verify-schedule!)))
    (assert (= (ms-schedule-result) MSCHED-DEPENDENCY))))

(deftest sequential_calls_keep_their_effect_order
  (graph-reset! 903)
  (let [identity (n-fun-open! 0) x (n-parm! identity 0)]
    (n-fun-close! identity (n-new2 (Return) (n-fun-entry identity) x))
    (let [first (n-call1! (g-start) identity (sched-const 1))
          second (n-call1! (call-end first) identity (sched-const 2))
          result (sched-bin (Add) (call-value first) (call-value second))
          ret (n-new2 (Return) (call-end second) result)]
      (n-add-def! (g-stop) ret)
      (g-analyze!)
      (assert (be-select-machine-program!))
      (assert (> (be-schedule-seeded! 2) 0))
      (let [first-at (sched-inst-for (call-value first))
            second-at (sched-inst-for (call-value second))]
        (assert (= (ms-inst-op first-at) MI-CALL))
        (assert (= (ms-inst-op second-at) MI-CALL))
        (assert (< first-at second-at))
        (ms-corrupt-schedule-swap! first-at second-at)
        (assert (not (ms-verify-schedule!)))
        (assert (= (ms-schedule-result) MSCHED-DEPENDENCY))))))
