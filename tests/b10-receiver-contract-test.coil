(module b10receivercontracttest)

(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "coil.assert" :use *)
(import "coil.slice" :use *)

(defn c [(x i64)] (-> i64) (n-new1 OP-CONST (t-int-con x) (g-start)))
(defn finish! [(site CallSite)] (-> i64)
  (n-add-def! (g-stop) (n-new2 OP-RETURN 0 (call-end site) (call-value site)))
  (g-analyze!) 0)

(deftest receiver_abi_requires_a_receiver_slot
  (graph-reset! 10901)
  (let [fun (n-fun-open! 0) receiver (n-parm! fun 0)]
    (n-fun-close! fun (n-new2 OP-RETURN 0 (n-fun-entry fun) receiver))
    (let [site (n-call! (g-start) fun (slice-new [i64] (cast (ptr i64) 0) 0))]
      (n-set-aux! (call-value site) CALL-ABI-RECEIVER)
      (finish! site)
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CALL-RECEIVER)))))

(deftest receiver_abi_rejects_a_definite_scalar_receiver
  (graph-reset! 10902)
  (let [fun (n-fun-open! 0) receiver (n-parm! fun 0)]
    (n-fun-close! fun (n-new2 OP-RETURN 0 (n-fun-entry fun) receiver))
    (let [site (n-call-receiver! (g-start) fun (n-new1 OP-CONST (t-undef) (g-start)) (c 7)
                 (slice-new [i64] (cast (ptr i64) 0) 0))]
      (finish! site)
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CALL-RECEIVER-TAG)))))
