(module b10receivercontracttest)

(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "coil.assert" :use *)
(import "coil.slice" :use *)

(defn c [(x i64)] (-> i64) (n-new1 (Const (t-int-con x)) (g-start)))
(defn finish! [(site CallSite)] (-> i64)
  (n-add-def! (g-stop) (n-new2 (Return) (call-end site) (call-value site)))
  (g-analyze!) 0)

(deftest receiver_abi_requires_a_receiver_slot
  (graph-reset! 10901)
  (let [fun (n-fun-open! 0) receiver (n-parm! fun 0)]
    (n-fun-close! fun (n-new2 (Return) (n-fun-entry fun) receiver))
    (let [site (n-call! (g-start) fun (slice-new [i64] (cast (ptr i64) 0) 0))]
      (n-set-op! (call-node site) (Call CALL-ABI-RECEIVER))
      (finish! site)
      (assert (> (g-verify) 0))
      (assert (= (g-verify-code) VERR-CALL-RECEIVER)))))

(deftest strict_receiver_abi_accepts_a_definite_scalar_receiver
  (graph-reset! 10902)
  (let [fun (n-fun-open! 0) receiver (n-parm! fun 0)]
    (n-fun-close! fun (n-new2 (Return) (n-fun-entry fun) receiver))
    (let [site (n-call-receiver! (g-start) fun (n-new1 (Const (t-undef)) (g-start)) (c 7) (c 0)
                 (slice-new [i64] (cast (ptr i64) 0) 0))]
      (finish! site)
      ;; Strict ECMAScript calls preserve primitive receivers. Representation checking still
      ;; requires a tagged value, but an object-kind restriction would be semantically wrong.
      (assert (= (g-verify) 0)))))
