(module nativecapabilitytest)
;; WHAT ACTUALLY COMPILES, DERIVED RATHER THAN LISTED.
;;
;; `docs/STATUS.md` answers a different question -- does a definition exist in `lib/` and does the
;; frontend call it -- and by that measure everything is done. It was generated by a tool that no
;; longer exists, and it has never had anything to say about the BACKEND. The first native execution
;; test found five features it calls done that cannot be compiled at all.
;;
;; A hand-written list of those five would be stale within a week. So this file writes none: the
;; method names come out of the compiler's own dispatch tables by reading `frontend_native_graph.coil`
;; as text -- the same technique `dsl-ownership-test` uses to count opcodes -- and the status of each
;; comes from running it through the real pipeline. Add a method to the frontend and it appears here
;; with no edit; fix `Box` selection and five rows change on their own.
;;
;; THE PROBE IS COMPILE-ONLY. It stops at instruction selection: no linking, no node, no answer
;; checked. "It compiles" is a much weaker claim than "it is correct" and this file must not be read
;; as the stronger one -- `tests/native-execution-test.coil` is where correctness is decided, and it
;; covers a handful of these rows. What this file measures is the ceiling above that work.
(import "ty" :use *)
(import "node" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "frontendnative" :use *)
(import "frontendnativegraph" :use *)
(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "coil.assert" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.control" :use *)
(import "coil.arraylist" :use *)
(import "coil.fs" :use *)
(import "nativeharness" :use *)

(const CAP-ABORTS i64 0)     ; unreachable without a fork; kept so the ladder's order is stable
(const CAP-REFUSED i64 1)    ; the frontend declines to index the program, by name
(const CAP-VERIFIER i64 2)   ; a graph was built and `g-verify` refused it
(const CAP-SELECTION i64 3)  ; verified, and instruction selection has no rule for some node
(const CAP-COMPILES i64 4)   ; machine code was selected, scheduled and register-allocated
(const CAP-COUNT i64 5)

(defn cap-name [(s i64)] (-> (slice u8))
  (case s
    CAP-ABORTS "**compiler aborts**"
    CAP-REFUSED "frontend refuses"
    CAP-VERIFIER "verifier rejects"
    CAP-SELECTION "selection has no rule"
    CAP-COMPILES "compiles"
    "?"))

;; NO FORK HERE, AND THE REASON IS WORTH KEEPING. An unsupported receiver -- `"abc".charAt(0)` with
;; a literal -- makes the frontend `abort`, so the obvious design runs each probe in a forked child
;; and records the crash as a status, the way gtext-test observes `g-parse`'s abort. That was built
;; and then removed: the frontend is the typescript-go bridge, forking a process with a live Go
;; runtime deadlocks, and the run HUNG rather than failing. A hang is worse than a crash -- it has
;; no diagnostic at all.
;;
;; So the probes are chosen to be programs the frontend accepts, and the report carries no `aborts`
;; column. The cost is that a future frontend change could make some probe abort and take this
;; suite down with it. That is loud and traceable to this file, which is the tradeoff taken.
(const CAP-ABORT-NOTE i64 0)

;; ---------------------------------------------------------------------------
;; One probe
;; ---------------------------------------------------------------------------
;; THE RESULT HAS TO BE USED, or the call is dead and the probe measures nothing -- and HOW it is
;; used is itself part of what compiles. The first draft of this file consumed every result with
;; `r === undefined`, and reported `toLowerCase` as broken while `tests/native-execution-test.coil`
;; was compiling and running it: comparing a string against `undefined` is what did not compile.
;; A row must not blame a method for its probe, so each method is tried under BOTH shapes and keeps
;; the better outcome.
(defn probe-shape-count [] (-> i64) 4)
(defn probe-shape-name [(i i64)] (-> (slice u8))
  (case i 0 "converted" 1 "compared" 2 "in arithmetic" 3 "then indexed" "?"))

;; FOUR WAYS A REAL PROGRAM USES A RESULT, because "does it compile" is a property of a PROGRAM and
;; not of a method. The first draft of this file consumed every result one way and was wrong twice
;; for it: with `r === undefined` it reported `toLowerCase` broken while the execution suite was
;; running it, and with `String(r).length` alone it reported all 54 methods fine while a realistic
;; `substring` program does not compile at all. Both were true of the probe, neither of the method.
;; So each method is measured under every shape and every cell is reported.
(defn probe-source! [(buf (ptr i8)) (cap i64) (shape i64) (receiver (slice u8)) (method (slice u8)) (args (slice u8))] (-> (slice u8))
  (let [fb (alloc/stack FixBuf) w (alloc/stack Writer)]
    (set! (.data fb) buf) (set! (.cap fb) cap) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    ;; The receiver is bound to a variable first: a literal receiver -- `"abc".charAt(0)` -- is
    ;; unsupported syntax the frontend ABORTS on, so every probe looks like code a person writes.
    ;; `fmt` takes a literal format, so the shapes are four calls rather than a table.
    (if (= shape 0)
        (fmt w "function main(n: number): number {{ let v = {s}; return (n + String(v.{s}({s})).length) | 0; }}"
             receiver method args)
      (if (= shape 1)
          (fmt w "function main(n: number): number {{ let v = {s}; let r: any = v.{s}({s}); return (n + (r === undefined ? 1 : 2)) | 0; }}"
               receiver method args)
        (if (= shape 2)
            (fmt w "function main(n: number): number {{ let v = {s}; let r: any = v.{s}({s}); return (n + r) | 0; }}"
                 receiver method args)
            (fmt w "function main(n: number): number {{ let v = {s}; v.{s}({s}); let q: any = v[0]; return (n + q) | 0; }}"
                 receiver method args))))
    (slice-new [u8] (cast (ptr u8) buf) (load (field fb len)))))

(defn probe-status [(source (slice u8))] (-> i64)
  (block :done
    (graph-reset! 8101)
    (shape-reset!)
    (jss-reset!)
    (let [(mut fe) (fe-native-new source)]
      (if (!= (fe-native-index! (mut fe)) FE-OK)
          (do (fe-native-free! (mut fe)) (return-from :done CAP-REFUSED))
          0)
      (frontend-native-build! (mut fe) 8101 true)
      (fe-native-free! (mut fe)))
    (if (!= (g-verify) 0) (return-from :done CAP-VERIFIER) 0)
    (if (not (be-select-machine-program!)) (return-from :done CAP-SELECTION) 0)
    (be-use-runtime-allocation! true)
    (be-schedule!)
    (if (< (be-color! 10) 0) (return-from :done CAP-SELECTION) 0)
    CAP-COMPILES))

;; The argument ladder. A method compiles if ANY well-formed call to it compiles, so each is tried
;; until one gets furthest; the arity the frontend enforces rejects the rest at the door, cheaply.
(defn probe-args [(i i64)] (-> (slice u8))
  (case i
    0 ""
    1 "1"
    2 "\"b\""
    3 "1, 2"
    4 "\"b\", \"c\""
    5 "x => x"
    6 "(p, c) => p + c, 0"
    ""))
(defn probe-args-count [] (-> i64) 7)
(defn probe-args-arity [(i i64)] (-> i64)
  (case i 0 0  1 1  2 1  3 2  4 2  5 1  6 2  -1))

(defn best-status [(shape i64) (receiver (slice u8)) (method (slice u8)) (arity i64)] (-> i64)
  (let [buf (alloc/stack (array i8 512))
        (mut best) CAP-ABORTS
        (mut i) 0]
    (loop (if (or (>= (load i) (probe-args-count)) (= (load best) CAP-COMPILES))
              (break)
              (do
                ;; A method whose arity the frontend states is probed at exactly that arity. The
                ;; array chain states none, and there the EMPTY call is the dangerous one -- `v.map()`
                ;; reaches the lowering with no callback and aborts on a child that is not there --
                ;; so an argument is always passed. Array lowerings read `argc` and ignore the extra.
                (if (if (< arity 0)
                        (> (probe-args-arity (load i)) 0)
                        (= (probe-args-arity (load i)) arity))
                    (let [source (probe-source! (cast (ptr i8) buf) 512 shape receiver method (probe-args (load i)))
                          s (probe-status source)]
                      (if (> s (load best)) (set! best s) 0)
                      0)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load best)))

;; ---------------------------------------------------------------------------
;; The report
;; ---------------------------------------------------------------------------
(defn cap-cell [(s i64)] (-> (slice u8))
  (case s
    CAP-ABORTS "**aborts**"
    CAP-REFUSED "refused"
    CAP-VERIFIER "verifier"
    CAP-SELECTION "selection"
    CAP-COMPILES "ok"
    "?"))

(defn render-group! [(w (ptr Writer)) (title (slice u8)) (receiver (slice u8))
                     (names (ArrayList (slice u8))) (arities (ArrayList i64)) (counts (ptr i64))] (-> i64)
  (fmt w "\n## {s}\n\nReceiver `{s}`.\n\n| method | converted | compared | in arithmetic | then indexed |\n|---|---|---|---|---|\n"
       title receiver)
  (let [(mut i) 0]
    (loop (if (>= (load i) (al-len [(slice u8)] names))
              (break)
              (let [name (al-get [(slice u8)] names (load i))
                    arity (al-get [i64] arities (load i))
                    a (best-status 0 receiver name arity)
                    b (best-status 1 receiver name arity)
                    c (best-status 2 receiver name arity)
                    d (best-status 3 receiver name arity)]
                (set! (index counts a) (+ (load (index counts a)) 1))
                (set! (index counts b) (+ (load (index counts b)) 1))
                (set! (index counts c) (+ (load (index counts c)) 1))
                (set! (index counts d) (+ (load (index counts d)) 1))
                (fmt w "| `{s}` | {s} | {s} | {s} | {s} |\n"
                     name (cap-cell a) (cap-cell b) (cap-cell c) (cap-cell d))
                (set! i (+ (load i) 1))
                0))))
  0)

(defn render-report! [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [a (malloc-allocator)
        text (nh-read-text a "src/frontend_native_graph.coil")
        fb (alloc/stack FixBuf) w (alloc/stack Writer)
        counts (alloc/stack (array i64 5))
        (mut strings) (al-new [(slice u8)] (malloc-allocator))
        (mut arrays) (al-new [(slice u8)] (malloc-allocator))
        (mut string-arity) (al-new [i64] (malloc-allocator))
        (mut array-arity) (al-new [i64] (malloc-allocator))]
    (let [(mut k) 0]
      (loop (if (>= (load k) CAP-COUNT) (break)
              (do (set! (index (cast (ptr i64) counts) (load k)) 0) (set! k (+ (load k) 1))))))
    (nh-collect-names! text "(defn fng-string-builtin-arity?" (mut strings) (mut string-arity))
    (nh-collect-names! text "(defn fng-array-builtin?" (mut arrays) (mut array-arity))
    (set! (.data fb) buf) (set! (.cap fb) cap) (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ps w "<!-- GENERATED by tests/native-capability-test.coil. Do not edit. -->\n")
    (ps w "# What compiles\n\n")
    (ps w "The method names are read out of `src/frontend_native_graph.coil`'s own dispatch tables,\n")
    (ps w "and every cell comes from compiling a real program through the frontend, the verifier,\n")
    (ps w "instruction selection and register allocation. Nothing here is hand-maintained: add a\n")
    (ps w "method to the frontend and a row appears.\n\n")
    (ps w "**A METHOD IS NOT WHAT COMPILES -- A PROGRAM IS.** The four columns are four ways a real\n")
    (ps w "program uses a result, and they disagree constantly: `substring` compiles when its result\n")
    (ps w "is converted and fails when the same result reaches arithmetic. Reading only one column\n")
    (ps w "gives an answer that is wrong in one direction or the other, which is what the first two\n")
    (ps w "drafts of this report did.\n\n")
    (ps w "Columns: `converted` = `String(r).length`; `compared` = `r === undefined`;\n")
    (ps w "`in arithmetic` = `n + r`; `then indexed` = call it, then read `v[0]`.\n\n")
    (ps w "READ A COLUMN THAT FAILS EVERYWHERE AS BEING ABOUT THE COLUMN. If every method fails\n")
    (ps w "under one shape, the shape is what is unsupported -- indexing a string, say -- and no\n")
    (ps w "individual method is implicated. The rows that matter are the ones that DISAGREE with\n")
    (ps w "their neighbours in the same column.\n\n")
    (ps w "**`compiles` is not `correct`.** This is the ceiling, not the floor -- correctness is\n")
    (ps w "decided in `tests/native-execution-test.coil`, which links a binary and runs it against\n")
    (ps w "node, and which covers a handful of these rows. A row that says `compiles` has never\n")
    (ps w "necessarily produced a right answer.\n")
    (render-group! w "String.prototype" "\"abcdef\"" (load strings) (load string-arity) (cast (ptr i64) counts))
    (render-group! w "Array.prototype" "[1, 2, 3]" (load arrays) (load array-arity) (cast (ptr i64) counts))
    (fmt w "\n## Totals\n\n| status | count |\n|---|---|\n| compiles | {d} |\n| selection has no rule | {d} |\n| verifier rejects | {d} |\n| frontend refuses | {d} |\n| **compiler aborts** | {d} |\n"
         (load (index (cast (ptr i64) counts) CAP-COMPILES))
         (load (index (cast (ptr i64) counts) CAP-SELECTION))
         (load (index (cast (ptr i64) counts) CAP-VERIFIER))
         (load (index (cast (ptr i64) counts) CAP-REFUSED))
         (load (index (cast (ptr i64) counts) CAP-ABORTS)))
    (al-free! [(slice u8)] (mut strings))
    (al-free! [(slice u8)] (mut arrays))
    (al-free! [i64] (mut string-arity))
    (al-free! [i64] (mut array-arity))
    (slice-new [u8] (cast (ptr u8) buf) (load (field fb len)))))

;; The report is CHECKED IN, and this is what keeps it honest: regenerate, compare, and fail on any
;; difference. A capability that changes -- gained or lost -- shows up as a diff in a file a human
;; reads, rather than as a number nobody looks at.
(deftest what_compiles_is_derived_and_the_checked_in_report_matches
  (let [a (malloc-allocator)
        buf (alloc/stack (array i8 16384))
        fresh (render-report! (cast (ptr i8) buf) 16384)
        recorded (nh-read-text a "docs/NATIVE-CAPABILITY.md")]
    (if (= fresh recorded)
        0
        (do
          (write-file a "/tmp/aotk-capability.md" fresh)
          (fmt (stderr)
               "native-capability: docs/NATIVE-CAPABILITY.md is out of date.\n  The freshly derived report is in /tmp/aotk-capability.md -- diff it, read what changed,\n  and copy it over if the change is one you meant to make.\n")
          0))
    (assert (= fresh recorded)))
  0)
