digraph ecma262_dependencies {
  rankdir=LR;
  graph [overlap=false];
  node [shape=box, fontsize=8];
  "capability:annex-b-profile" [label="Implement Annex B semantics or make a deliberate final product-profile decision with exact tested refusals; temporary omission is not full completion.\ncapability:annex-b-profile", color="#cc0000"];
  "capability:completion-and-spec-record-machinery" [label="Provide typed compile-away specification records, Lists, Completion/Reference/Descriptor forms, and narrow abrupt-completion capture with verified compiler lowering.\ncapability:completion-and-spec-record-machinery", color="#cc0000"];
  "capability:conformance-profile-manifest" [label="Turn ECMA-262 conformance, implementation limit, error-handling, and product-profile prose into explicit manifests, tests, and final report evidence.\ncapability:conformance-profile-manifest", color="#cc0000"];
  "capability:declarative-intrinsic-publication" [label="Generate intrinsic identities, prototype links, properties, attributes, names, lengths, callable adapters, and support entries from one declarative manifest.\ncapability:declarative-intrinsic-publication", color="#cc0000"];
  "capability:evaluation-structure-map" [label="Map evaluation, declaration-instantiation, and module lifecycle structure to frontend handlers while proving every observable semantic suboperation delegates to JSL.\ncapability:evaluation-structure-map", color="#cc0000"];
  "capability:grammar-conformance-map" [label="Map every pinned normative grammar production to parser acceptance and rejection evidence, including parameterized productions and early-error interactions.\ncapability:grammar-conformance-map", color="#cc0000"];
  "capability:host-contract-manifest" [label="Declare each ECMA-262 host hook and implementation-defined choice, then prove its behavior or precise refusal with focused host-policy tests.\ncapability:host-contract-manifest", color="#cc0000"];
  "capability:jsl-abstract-operation-transcription" [label="Transcribe reviewed semantic abstract-operation families into JSL with spec records, dependency-closure lowering, focused differentials, and mapped Test262 evidence.\ncapability:jsl-abstract-operation-transcription", color="#cc0000"];
  "capability:jsl-builtins-transcription" [label="Transcribe every built-in algorithm into JSL, publish it declaratively, and attach Levels 0-5 focused and mapped Test262 evidence.\ncapability:jsl-builtins-transcription", color="#cc0000"];
  "capability:jsl-internal-method-protocol" [label="Implement spec-shaped internal, concrete, and numeric methods in JSL across ordinary and exotic receiver families with representation services below the semantic boundary.\ncapability:jsl-internal-method-protocol", color="#cc0000"];
  "capability:runtime-agent-memory-services" [label="Provide representation-level byte blocks, raw byte conversion, agents, waiter lists, context switching, and GC/weak-retention services beneath JSL policy.\ncapability:runtime-agent-memory-services", color="#cc0000"];
  "capability:runtime-memory-model" [label="Implement or explicitly exclude the agents/shared-memory memory model, including event records, candidate execution relations, tear-free reads, races, and host synchronization boundaries.\ncapability:runtime-memory-model", color="#cc0000"];
  "capability:runtime-object-layout-contract" [label="Provide declarative object-family layouts, compile-away internal-slot lists, generic traced slot storage, GC integration, and generated internal-method family identities beneath canonical JSL allocation semantics.\ncapability:runtime-object-layout-contract", color="#cc0000"];
  "capability:runtime-sdo-delegation-map" [label="Map every syntax-directed Runtime Semantics operation to frontend structural lowering and prove that observable suboperations delegate to JSL.\ncapability:runtime-sdo-delegation-map", color="#cc0000"];
  "capability:runtime-value-representation-contract" [label="Map every ECMAScript language value and data-block representation to runtime tags, storage, identity, numeric domains, GC, and representation invariants.\ncapability:runtime-value-representation-contract", color="#cc0000"];
  "capability:static-semantics-map" [label="Map every syntax-directed Static Semantics operation to resolver, early-error, or parser evidence.\ncapability:static-semantics-map", color="#cc0000"];
  "clause:await" [label="Await\nclause:await", color="#999999"];
