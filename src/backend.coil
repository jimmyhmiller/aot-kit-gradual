(defn a64-fsub-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509622272 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fmul-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509609984 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fdiv-d [(dd i64) (dn i64) (dm i64)] (-> i64)
