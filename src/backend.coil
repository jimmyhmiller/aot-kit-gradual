;; M10 arm64 backend: machine IR, scheduling, register allocation, and encoding.
(module backend)

(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(const MI-MOVI i64 0)
(const MI-ADD  i64 1)
(const MI-SUB  i64 2)
(const MI-MUL  i64 3)
(const MI-SDIV i64 4)
(const MI-NEG  i64 5)
(const MI-RET  i64 6)
(const MI-ARG  i64 7)
(const MI-EQ   i64 8)
(const MI-LT   i64 9)
(const MI-LE   i64 10)
(const MI-LABEL i64 11)
(const MI-CBZ   i64 12)
(const MI-CSEL  i64 13)
(const MI-MOV   i64 14)
(const MI-B     i64 15)
(const MI-NEW   i64 16)
(const MI-LOAD  i64 17)
(const MI-STORE i64 18)
(const MI-CBR   i64 19) ; block conditional: a=predicate, b=true block, imm=false block
(const MI-JMP   i64 20) ; block jump: imm=target block
(const MI-COPY  i64 21) ; resolved edge copy: dst <- a
(const MI-CALL  i64 22) ; direct call: dst=result, a=arg0, imm=machine function
(const MI-STACKARG i64 23) ; callee incoming argument 8+, imm=argument index
(const MI-ABI-COPY i64 24) ; early allocatable copy from a fixed ABI ingress vreg

; Stable public result codes. Success is the only state in which generated code or object bytes
; are consumable. Later milestones may replace an unsupported result with success, but must never
; renumber or reuse an existing code.
(const BER-OK                    i64 0)
(const BER-MALFORMED-GRAPH       i64 1)
(const BER-UNSUPPORTED-OPCODE    i64 2)
(const BER-UNSUPPORTED-CFG       i64 3)
(const BER-UNSUPPORTED-PHI       i64 4)
(const BER-UNSUPPORTED-CALL      i64 5)
(const BER-UNSUPPORTED-CALL-LIVE i64 6)
(const BER-ALLOCATION            i64 7)
(const BER-ENCODING              i64 8)
(const BER-OBJECT                i64 9)

; Machine-CFG verifier results are stable for the same reason as backend phase results: focused
; corruption fixtures must name the broken law instead of collapsing to a generic false.
(const MCFG-OK                    i64 0)
(const MCFG-OWNER                i64 1)
(const MCFG-RECIPROCITY           i64 2)
(const MCFG-PREDECESSOR-SLOT      i64 3)
(const MCFG-TERMINATOR-ARITY      i64 4)
(const MCFG-RPO                   i64 5)
(const MCFG-FUNCTION-ISOLATION    i64 6)
(const MCFG-IDOM                  i64 7)

(const MSEL-OK                    i64 0)
(const MSEL-OWNER                i64 1)
(const MSEL-DUPLICATE            i64 2)
(const MSEL-DEPENDENCY           i64 3)
(const MSEL-TERMINATOR           i64 4)
(const MSEL-UNSUPPORTED          i64 5)
(const MSEL-PHI                  i64 6)
(const MSEL-CALL                 i64 7)
(const MSEL-CALL-LIVE            i64 8)
(const MSEL-PLACEMENT            i64 9)
(const MSEL-MEMORY-ORDER         i64 10)

(const MABI-OK                    i64 0)
(const MABI-FRAME                 i64 1)
(const MABI-SPILL                 i64 2)
(const MABI-ARGUMENT              i64 3)

(const MSCHED-OK                  i64 0)
(const MSCHED-CYCLE               i64 1)
(const MSCHED-DEPENDENCY          i64 2)
(const MSCHED-MEMORY              i64 3)
(const MSCHED-EXACTLY-ONCE        i64 4)
(const MSCHED-BOUNDARY            i64 5)

(const MLIVE-OK                   i64 0)
(const MLIVE-RANGE                i64 1)
(const MLIVE-FIXPOINT             i64 2)
(const MLIVE-PHI                  i64 3)
(const MLIVE-KIND                 i64 4)
(const MLIVE-SAFEPOINT            i64 5)

(const MLK-SCALAR                 i64 0)
(const MLK-RAW-MANAGED            i64 1)
(const MLK-BOXED                  i64 2)
(const MLK-NONMOVING              i64 3)

(const MRA-OK                     i64 0)
(const MRA-INTERFERENCE           i64 1)
(const MRA-FIXED                  i64 2)
(const MRA-LOCATION               i64 3)
(const MRA-SPILL-KIND             i64 4)
(const MRA-COALESCE               i64 5)

(const MOBJ-OK                    i64 0)
(const MOBJ-HEADER                i64 1)
(const MOBJ-FUNCTION-RANGE        i64 2)
(const MOBJ-SYMBOL                i64 3)
(const MOBJ-RELOCATION            i64 4)
(const MOBJ-STACKMAP              i64 5)
(const MOBJ-LAYOUT                i64 6)
(const MOBJ-ATOMIC                i64 7)

(defstruct MInst
  [(op i64) (dst i64) (a i64) (b i64) (imm i64) (node i64)
   (owner i64) (block-id i64)
   (mem-first i64) (mem-count i64)
   (anti-first i64) (anti-count i64)
   (arg-first i64) (arg-count i64)
   (reg i64) (spill i64) (first i64) (last i64)
   (earliest i64) (latest i64) (schedule-order i64)])

(defstruct MOpcodeDesc
  [(inputs i64) (outputs i64) (temporaries i64) (clobbers i64)
   (effects i64) (pinned bool) (memory bool) (terminator bool) (encodable bool)])

; These records intentionally use indexes into unit-owned tables. Stable indexes survive later
; edge splitting and avoid pointers becoming stale when an ArrayList grows.
(defstruct MFunction
  [(id i64) (ideal i64) (entry i64)
   (block-first i64) (block-count i64)
   (return-first i64) (return-count i64)
   (frame-size i64) (callee-mask i64) (callee-count i64)
   (code-start i64) (code-size i64)])

(defstruct MBlock
  [(id i64) (owner i64) (ideal-ctrl i64)
   (pred-first i64) (pred-count i64) (succ-first i64) (succ-count i64)
   (inst-first i64) (inst-count i64) (loop-depth i64) (layout-index i64)])

(defstruct MEdge
  [(id i64) (owner i64) (source i64) (target i64) (target-slot i64)
   (copy-first i64) (copy-count i64) (move-first i64) (move-count i64)])

(const MCOPY-VALUE  i64 0)
(const MCOPY-MEMORY i64 1)

; Phi transport belongs to an incoming edge, not to either endpoint block.  Keeping the ideal
; Phi and its selected source in the record makes target-slot mistakes independently verifiable.
(defstruct MCopy
  [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)])

(defstruct MMove
  [(edge i64) (dst i64) (src i64) (temporary bool)])

(defstruct MachineUnit
  [(functions (ArrayList MFunction))
   (blocks (ArrayList MBlock))
   (edges (ArrayList MEdge))
   (returns (ArrayList i64))
   (pred-edges (ArrayList i64))
   (succ-edges (ArrayList i64))
   (edge-copies (ArrayList MCopy))
   (edge-moves (ArrayList MMove))
   (copy-work-dst (ArrayList i64))
   (copy-work-src (ArrayList i64))
   (copy-work-live (ArrayList i64))
   (symbols (ArrayList i64))
   (runtime-deps (ArrayList i64))
   (ctrl-block (ArrayList i64))
   (block-order (ArrayList i64))
   (block-idom (ArrayList i64))
   (rpo-seen (ArrayList i64))
   (rpo-post (ArrayList i64))
   (selected-values (ArrayList i64))
   (selected-nodes (ArrayList i64))
   (packed-insts (ArrayList MInst))
   (selection-memory-deps (ArrayList i64))
   (memory-anti-deps (ArrayList i64))
   (call-args (ArrayList i64))
   (schedule-work (ArrayList MInst))
   (schedule-done (ArrayList i64))
   (live-use (ArrayList i64)) (live-def (ArrayList i64))
   (live-in (ArrayList i64)) (live-out (ArrayList i64))
   (edge-live (ArrayList i64)) (value-kind (ArrayList i64))
   (alloc-interference (ArrayList i64)) (alloc-live (ArrayList i64))
   (alloc-reg (ArrayList i64)) (alloc-spill (ArrayList i64))
   (alloc-owner (ArrayList i64)) (alloc-forbidden (ArrayList i64))
   (alloc-spill-kind (ArrayList i64))
   (phase i64) (next-vreg i64) (verify-result i64) (verify-item i64)
   (selection-result i64) (selection-item i64)
   (schedule-result i64) (schedule-item i64) (schedule-seed i64)
   (liveness-result i64) (liveness-item i64) (liveness-seed i64)
   (liveness-rounds i64)
   (allocation-result i64) (allocation-item i64) (allocation-seed i64) (inited bool)])

(defn machine-unit [] (-> (ptr MachineUnit))
  (let [u (static MachineUnit)]
    (if (load (field u inited)) 0
      (do
        (store! (field u functions) (al-new [MFunction] (malloc-allocator)))
        (store! (field u blocks) (al-new [MBlock] (malloc-allocator)))
        (store! (field u edges) (al-new [MEdge] (malloc-allocator)))
        (store! (field u returns) (al-new [i64] (malloc-allocator)))
        (store! (field u pred-edges) (al-new [i64] (malloc-allocator)))
        (store! (field u succ-edges) (al-new [i64] (malloc-allocator)))
        (store! (field u edge-copies) (al-new [MCopy] (malloc-allocator)))
        (store! (field u edge-moves) (al-new [MMove] (malloc-allocator)))
        (store! (field u copy-work-dst) (al-new [i64] (malloc-allocator)))
        (store! (field u copy-work-src) (al-new [i64] (malloc-allocator)))
        (store! (field u copy-work-live) (al-new [i64] (malloc-allocator)))
        (store! (field u symbols) (al-new [i64] (malloc-allocator)))
        (store! (field u runtime-deps) (al-new [i64] (malloc-allocator)))
        (store! (field u ctrl-block) (al-new [i64] (malloc-allocator)))
        (store! (field u block-order) (al-new [i64] (malloc-allocator)))
        (store! (field u block-idom) (al-new [i64] (malloc-allocator)))
        (store! (field u rpo-seen) (al-new [i64] (malloc-allocator)))
        (store! (field u rpo-post) (al-new [i64] (malloc-allocator)))
        (store! (field u selected-values) (al-new [i64] (malloc-allocator)))
        (store! (field u selected-nodes) (al-new [i64] (malloc-allocator)))
        (store! (field u packed-insts) (al-new [MInst] (malloc-allocator)))
        (store! (field u selection-memory-deps) (al-new [i64] (malloc-allocator)))
        (store! (field u memory-anti-deps) (al-new [i64] (malloc-allocator)))
        (store! (field u call-args) (al-new [i64] (malloc-allocator)))
        (store! (field u schedule-work) (al-new [MInst] (malloc-allocator)))
        (store! (field u schedule-done) (al-new [i64] (malloc-allocator)))
        (store! (field u live-use) (al-new [i64] (malloc-allocator)))
        (store! (field u live-def) (al-new [i64] (malloc-allocator)))
        (store! (field u live-in) (al-new [i64] (malloc-allocator)))
        (store! (field u live-out) (al-new [i64] (malloc-allocator)))
        (store! (field u edge-live) (al-new [i64] (malloc-allocator)))
        (store! (field u value-kind) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-interference) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-live) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-reg) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-spill) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-owner) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-forbidden) (al-new [i64] (malloc-allocator)))
        (store! (field u alloc-spill-kind) (al-new [i64] (malloc-allocator)))
        (store! (field u inited) true)
        0))
    u))

(defn mu-reset! [] (-> i64)
  (let [u (machine-unit)]
    (al-clear! [MFunction] (field u functions))
    (al-clear! [MBlock] (field u blocks))
    (al-clear! [MEdge] (field u edges))
    (al-clear! [i64] (field u returns))
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (al-clear! [i64] (field u symbols))
    (al-clear! [i64] (field u runtime-deps))
    (al-clear! [i64] (field u ctrl-block))
    (al-clear! [i64] (field u block-order))
    (al-clear! [i64] (field u block-idom))
    (al-clear! [i64] (field u rpo-seen))
    (al-clear! [i64] (field u rpo-post))
    (al-clear! [i64] (field u selected-values))
    (al-clear! [i64] (field u selected-nodes))
    (al-clear! [MInst] (field u packed-insts))
    (al-clear! [i64] (field u selection-memory-deps))
    (al-clear! [i64] (field u memory-anti-deps))
    (al-clear! [i64] (field u call-args))
    (al-clear! [MInst] (field u schedule-work))
    (al-clear! [i64] (field u schedule-done))
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (al-clear! [i64] (field u value-kind))
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (let [(mut i) 0]
      (loop
        (if (>= (load i) (n-count)) (break)
          (do (al-push! [i64] (field u ctrl-block) -1)
              (store! i (+ (load i) 1)) 0))))
    (store! (field u phase) 0)
    (store! (field u next-vreg) 0)
    (store! (field u verify-result) MCFG-OK)
    (store! (field u verify-item) -1)
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (store! (field u schedule-seed) 0)
    (store! (field u liveness-result) MLIVE-OK)
    (store! (field u liveness-item) -1)
    (store! (field u liveness-seed) 0)
    (store! (field u liveness-rounds) 0)
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (store! (field u allocation-seed) 0)
    0))

(defn mu-function-count [] (-> i64)
  (al-len [MFunction] (load (field (machine-unit) functions))))
(defn mu-block-count [] (-> i64)
  (al-len [MBlock] (load (field (machine-unit) blocks))))
(defn mu-edge-count [] (-> i64)
  (al-len [MEdge] (load (field (machine-unit) edges))))
(defn mu-verify-result [] (-> i64) (load (field (machine-unit) verify-result)))
(defn mu-verify-item [] (-> i64) (load (field (machine-unit) verify-item)))

(defn mf-new [(id i64) (ideal i64) (entry i64)] (-> MFunction)
  (let [p (stack MFunction)]
    (store! (field p id) id) (store! (field p ideal) ideal) (store! (field p entry) entry)
    (store! (field p block-first) -1) (store! (field p block-count) 0)
    (store! (field p return-first) -1) (store! (field p return-count) 0)
    (store! (field p frame-size) -1) (store! (field p callee-mask) 0)
    (store! (field p callee-count) 0) (store! (field p code-start) -1)
    (store! (field p code-size) 0) (load p)))

(defn mb-new [(id i64) (owner i64) (ctrl i64)] (-> MBlock)
  (let [p (stack MBlock)]
    (store! (field p id) id) (store! (field p owner) owner)
    (store! (field p ideal-ctrl) ctrl)
    (store! (field p pred-first) -1) (store! (field p pred-count) 0)
    (store! (field p succ-first) -1) (store! (field p succ-count) 0)
    (store! (field p inst-first) -1) (store! (field p inst-count) 0)
    (store! (field p loop-depth) 0) (store! (field p layout-index) -1)
    (load p)))

(defn me-new [(id i64) (owner i64) (source i64) (target i64) (slot i64)] (-> MEdge)
  (let [p (stack MEdge)]
    (store! (field p id) id) (store! (field p owner) owner)
    (store! (field p source) source) (store! (field p target) target)
    (store! (field p target-slot) slot)
    (store! (field p copy-first) -1) (store! (field p copy-count) 0)
    (store! (field p move-first) -1) (store! (field p move-count) 0)
    (load p)))

(defn mc-new [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)] (-> MCopy)
  (let [p (stack MCopy)]
    (store! (field p edge) edge) (store! (field p phi) phi)
    (store! (field p dst) dst) (store! (field p src) src)
    (store! (field p kind) kind) (load p)))

(defn mm-new [(edge i64) (dst i64) (src i64) (temporary bool)] (-> MMove)
  (let [p (stack MMove)]
    (store! (field p edge) edge) (store! (field p dst) dst)
    (store! (field p src) src) (store! (field p temporary) temporary) (load p)))

(defn mu-function [(i i64)] (-> (ptr MFunction))
  (be-al-elem [MFunction] (field (machine-unit) functions) i))
(defn mu-block [(i i64)] (-> (ptr MBlock))
  (be-al-elem [MBlock] (field (machine-unit) blocks) i))
(defn mu-edge [(i i64)] (-> (ptr MEdge))
  (be-al-elem [MEdge] (field (machine-unit) edges) i))
(defn mu-block-owner [(i i64)] (-> i64) (load (field (mu-block i) owner)))
(defn mu-block-control [(i i64)] (-> i64) (load (field (mu-block i) ideal-ctrl)))
(defn mu-edge-source [(i i64)] (-> i64) (load (field (mu-edge i) source)))
(defn mu-edge-target [(i i64)] (-> i64) (load (field (mu-edge i) target)))
(defn mu-edge-target-slot [(i i64)] (-> i64) (load (field (mu-edge i) target-slot)))
(defn mu-edge-copy-count [(i i64)] (-> i64) (load (field (mu-edge i) copy-count)))
(defn mu-edge-copy [(edge i64) (which i64)] (-> (ptr MCopy))
  (let [first (load (field (mu-edge edge) copy-first))]
    (be-al-elem [MCopy] (field (machine-unit) edge-copies) (+ first which))))
(defn mu-copy-phi [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) phi)))
(defn mu-copy-dst [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) dst)))
(defn mu-copy-src [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) src)))
(defn mu-copy-kind [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) kind)))
(defn mu-edge-move-count [(i i64)] (-> i64) (load (field (mu-edge i) move-count)))
(defn mu-edge-move [(edge i64) (which i64)] (-> (ptr MMove))
  (let [first (load (field (mu-edge edge) move-first))]
    (be-al-elem [MMove] (field (machine-unit) edge-moves) (+ first which))))
(defn mu-move-dst [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-move edge which) dst)))
(defn mu-move-src [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-move edge which) src)))
(defn mu-move-temporary? [(edge i64) (which i64)] (-> bool)
  (load (field (mu-edge-move edge which) temporary)))
(defn mu-function-ideal [(i i64)] (-> i64) (load (field (mu-function i) ideal)))
(defn mu-function-block-count [(i i64)] (-> i64)
  (load (field (mu-function i) block-count)))
(defn mu-function-frame-size [(i i64)] (-> i64)
  (load (field (mu-function i) frame-size)))
(defn mu-function-code-start [(i i64)] (-> i64)
  (load (field (mu-function i) code-start)))
(defn mu-function-code-size [(i i64)] (-> i64)
  (load (field (mu-function i) code-size)))
(defn mu-function-callee-mask [(i i64)] (-> i64)
  (load (field (mu-function i) callee-mask)))
(defn mu-function-callee-count [(i i64)] (-> i64)
  (load (field (mu-function i) callee-count)))
(defn mu-function-block [(fun i64) (rpo i64)] (-> i64)
  (let [f (mu-function fun)]
    (al-get (load (field (machine-unit) block-order))
            (+ (load (field f block-first)) rpo))))
(defn mu-function-return-count [(fidx i64)] (-> i64)
  (load (field (mu-function fidx) return-count)))
(defn mu-function-return-block [(fidx i64) (i i64)] (-> i64)
  (let [f (mu-function fidx)]
    (al-get (load (field (machine-unit) returns))
            (+ (load (field f return-first)) i))))
(defn mu-block-layout-index [(i i64)] (-> i64)
  (load (field (mu-block i) layout-index)))
(defn mu-block-loop-depth [(i i64)] (-> i64)
  (load (field (mu-block i) loop-depth)))
(defn mu-block-idom [(i i64)] (-> i64)
  (al-get (load (field (machine-unit) block-idom)) i))
(defn mu-block-inst-first [(i i64)] (-> i64) (load (field (mu-block i) inst-first)))
(defn mu-block-inst-count [(i i64)] (-> i64) (load (field (mu-block i) inst-count)))
(defn mu-block-succ-count [(i i64)] (-> i64) (load (field (mu-block i) succ-count)))
(defn mu-block-succ-edge [(bid i64) (i i64)] (-> i64)
  (let [b (mu-block bid)]
    (al-get (load (field (machine-unit) succ-edges))
            (+ (load (field b succ-first)) i))))
(defn mu-block-succ-target [(bid i64) (i i64)] (-> i64)
  (mu-edge-target (mu-block-succ-edge bid i)))

(defstruct Backend
  [(ins (ArrayList MInst))
   (nval (ArrayList i64))       ; graph node -> virtual register, -1 when unselected
   (mseen (ArrayList i64))
   (clabel (ArrayList i64))
   (code (ArrayList u8))
   (obj (ArrayList u8))
   (spills i64)
   (inloop bool)
   (result i64)
   (result-node i64)
   (verify-code i64)
   (object-result i64)
   (object-item i64)
   (runtime-allocation bool)
   (inited bool)])

(defn backend [] (-> (ptr Backend))
  (let [p (static Backend)]
    (if (load (field p inited)) 0
      (do (store! (field p inited) true)
          (store! (field p ins) (al-new [MInst] (malloc-allocator)))
          (store! (field p nval) (al-new [i64] (malloc-allocator)))
          (store! (field p mseen) (al-new [i64] (malloc-allocator)))
          (store! (field p clabel) (al-new [i64] (malloc-allocator)))
          (store! (field p code) (al-new [u8] (malloc-allocator)))
          (store! (field p obj) (al-new [u8] (malloc-allocator))) 0))
    p))

(defn be-reset! [] (-> i64)
  (let [p (backend) (mut i) 0]
    (al-clear! [MInst] (field p ins))
    (al-clear! [i64] (field p nval))
    (al-clear! [i64] (field p mseen))
    (al-clear! [i64] (field p clabel))
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    (loop
      (if (>= (load i) (n-count)) (break)
        (do (al-push! [i64] (field p nval) -1)
            (al-push! [i64] (field p mseen) 0)
            (al-push! [i64] (field p clabel) -1)
            (store! i (+ (load i) 1)) 0)))
    (store! (field p spills) 0) (store! (field p inloop) false)
    (store! (field p result) BER-OK) (store! (field p result-node) NO-NODE)
    (store! (field p verify-code) VERR-NONE)
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (store! (field p runtime-allocation) false) 0))

(defn be-result [] (-> i64) (load (field (backend) result)))
(defn be-result-node [] (-> i64) (load (field (backend) result-node)))
(defn be-verify-code [] (-> i64) (load (field (backend) verify-code)))
(defn mobj-result [] (-> i64) (load (field (backend) object-result)))
(defn mobj-item [] (-> i64) (load (field (backend) object-item)))
(defn be-use-runtime-allocation! [(enabled bool)] (-> i64)
  (store! (field (backend) runtime-allocation) enabled) 0)
(defn be-runtime-allocation? [] (-> bool)
  (load (field (backend) runtime-allocation)))

(defn be-result-name [(code i64)] (-> (slice u8))
  (case code
    BER-OK "BER-OK"
    BER-MALFORMED-GRAPH "BER-MALFORMED-GRAPH"
    BER-UNSUPPORTED-OPCODE "BER-UNSUPPORTED-OPCODE"
    BER-UNSUPPORTED-CFG "BER-UNSUPPORTED-CFG"
    BER-UNSUPPORTED-PHI "BER-UNSUPPORTED-PHI"
    BER-UNSUPPORTED-CALL "BER-UNSUPPORTED-CALL"
    BER-UNSUPPORTED-CALL-LIVE "BER-UNSUPPORTED-CALL-LIVE"
    BER-ALLOCATION "BER-ALLOCATION"
    BER-ENCODING "BER-ENCODING"
    BER-OBJECT "BER-OBJECT"
    "BER-?"))

(defn be-result-print [(w (ptr Writer))] (-> i64)
  (let [code (be-result) node (be-result-node)]
    (ps w (be-result-name code))
    (if (= node NO-NODE) 0 (do (fmt w " at n{d}" node) 0))
    (if (= code BER-MALFORMED-GRAPH)
        (do (ps w " (") (ps w (verr-name (be-verify-code))) (ps w ")") 0) 0)
    (ps w "\n") 0))

(defn be-fail! [(code i64) (node i64)] (-> bool)
  (let [p (backend)]
    (if (= (load (field p result)) BER-OK)
        (do (store! (field p result) code) (store! (field p result-node) node)) 0)
    ; Publication is atomic: a failure invalidates bytes from this and all prior compilations.
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    false))

(defn be-preflight! [] (-> bool)
  (if (= (g-verify) 0)
    ; Calls are rejected before control-shape walking so CallEnd cannot be misreported as a CFG
    ; accident and no callee/body instructions can leak into the current compilation.
    (let [n (n-count) (mut i) 0 (mut call) NO-NODE]
      (loop
        (if (or (>= (load i) n) (!= (load call) NO-NODE)) (break)
          (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                  (store! call (load i)) 0)
              (store! i (+ (load i) 1)) 0)))
      (if (!= (load call) NO-NODE) (be-fail! BER-UNSUPPORTED-CALL (load call))
        ; The prototype loop selector searches for one loop Phi. More than one is not a
        ; conservative subset: accepting it silently chooses whichever use happens to be last.
        (let [(mut loop-node) NO-NODE (mut cfg-node) NO-NODE]
          (store! i 0)
          (loop
            (if (or (>= (load i) n) (!= (load loop-node) NO-NODE)) (break)
              (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-LOOP))
                      (let [outs (n-nouts (load i)) (mut j) 0 (mut phis) 0]
                        (loop
                          (if (>= (load j) outs) (break)
                            (do (let [u (n-out (load i) (load j))]
                                  (if (and (not (n-dead? u))
                                           (and (= (n-op u) OP-PHI) (not (ty-mem? (n-ty u)))))
                                      (store! phis (+ (load phis) 1)) 0))
                                (store! j (+ (load j) 1)) 0)))
                        (if (> (load phis) 1) (store! loop-node (load i)) 0)
                        ; A Region back edge means control branched inside the loop body. The
                        ; shape walker accepted this and emitted an infinite native loop.
                        (if (and (= (load cfg-node) NO-NODE)
                                 (!= (n-op (n-in (load i) 2)) OP-CPROJ))
                            (store! cfg-node (load i)) 0)) 0)
                  (store! i (+ (load i) 1)) 0)))
          (if (!= (load loop-node) NO-NODE) (be-fail! BER-UNSUPPORTED-PHI (load loop-node))
            (if (!= (load cfg-node) NO-NODE) (be-fail! BER-UNSUPPORTED-CFG (load cfg-node))
              true)))))
    (do (store! (field (backend) verify-code) (g-verify-code))
        (be-fail! BER-MALFORMED-GRAPH (g-verify-node)))))

(defn mi-new [(op i64) (dst i64) (a i64) (b i64) (imm i64) (node i64)] (-> MInst)
  (let [p (stack MInst)]
    (store! (field p op) op) (store! (field p dst) dst)
    (store! (field p a) a) (store! (field p b) b) (store! (field p imm) imm)
    (store! (field p node) node) (store! (field p owner) -1) (store! (field p block-id) -1)
    (store! (field p mem-first) -1) (store! (field p mem-count) 0)
    (store! (field p anti-first) -1) (store! (field p anti-count) 0)
    (store! (field p arg-first) -1) (store! (field p arg-count) 0)
    (store! (field p reg) -1) (store! (field p spill) -1)
    (store! (field p first) -1) (store! (field p last) -1)
    (store! (field p earliest) -1) (store! (field p latest) -1)
    (store! (field p schedule-order) -1) (load p)))

(defn mi-desc-new [(inputs i64) (outputs i64) (effects i64)
                   (pinned bool) (memory bool) (terminator bool) (encodable bool)]
  (-> MOpcodeDesc)
  (let [p (stack MOpcodeDesc)]
    (store! (field p inputs) inputs) (store! (field p outputs) outputs)
    (store! (field p temporaries) 0) (store! (field p clobbers) 0)
    (store! (field p effects) effects) (store! (field p pinned) pinned)
    (store! (field p memory) memory) (store! (field p terminator) terminator)
    (store! (field p encodable) encodable) (load p)))

(defn mi-desc [(op i64)] (-> MOpcodeDesc)
  (case op
    MI-MOVI (mi-desc-new 0 1 0 false false false true)
    MI-ARG  (mi-desc-new 0 1 0 true false false true)
    MI-NEG  (mi-desc-new 1 1 0 false false false true)
    MI-ADD  (mi-desc-new 2 1 0 false false false true)
    MI-SUB  (mi-desc-new 2 1 0 false false false true)
    MI-MUL  (mi-desc-new 2 1 0 false false false true)
    MI-SDIV (mi-desc-new 2 1 0 false false false true)
    MI-EQ   (mi-desc-new 2 1 0 false false false true)
    MI-LT   (mi-desc-new 2 1 0 false false false true)
    MI-LE   (mi-desc-new 2 1 0 false false false true)
    MI-NEW  (mi-desc-new 0 1 3 true true false true)
    MI-LOAD (mi-desc-new 1 1 2 true true false true)
    MI-STORE (mi-desc-new 2 0 2 true true false true)
    MI-RET  (mi-desc-new 1 0 1 true false true true)
    MI-CBR  (mi-desc-new 1 0 1 true false true false)
    MI-JMP  (mi-desc-new 0 0 1 true false true false)
    MI-CBZ  (mi-desc-new 1 0 1 true false true true)
    MI-B    (mi-desc-new 0 0 1 true false true true)
    MI-LABEL (mi-desc-new 0 0 1 true false false true)
    MI-CSEL (mi-desc-new 3 1 0 false false false true)
    MI-MOV  (mi-desc-new 1 1 0 false false false true)
    MI-COPY (mi-desc-new 1 1 0 true false false true)
    MI-CALL (mi-desc-new 1 1 3 true true false true)
    MI-STACKARG (mi-desc-new 0 1 0 true false false true)
    MI-ABI-COPY (mi-desc-new 1 1 0 true false false true)
    (mi-desc-new -1 -1 0 false false false false)))

(defn mi-desc-inputs [(d MOpcodeDesc)] (-> i64) (load (field d inputs)))
(defn mi-desc-outputs [(d MOpcodeDesc)] (-> i64) (load (field d outputs)))
(defn mi-desc-temporaries [(d MOpcodeDesc)] (-> i64) (load (field d temporaries)))
(defn mi-desc-clobbers [(d MOpcodeDesc)] (-> i64)
  ; Effect class 3 is a call/safepoint. x0-x11 are caller-clobbered.
  (if (= (load (field d effects)) 3) 4095 (load (field d clobbers))))
(defn mi-desc-effects [(d MOpcodeDesc)] (-> i64) (load (field d effects)))
(defn mi-desc-pinned? [(d MOpcodeDesc)] (-> bool) (load (field d pinned)))
(defn mi-desc-memory? [(d MOpcodeDesc)] (-> bool) (load (field d memory)))
(defn mi-desc-terminator? [(d MOpcodeDesc)] (-> bool) (load (field d terminator)))
(defn mi-desc-encodable? [(d MOpcodeDesc)] (-> bool) (load (field d encodable)))

(defn be-emit! [(m MInst)] (-> i64)
  (let [p (backend) id (al-len [MInst] (load (field p ins)))]
    (al-push! [MInst] (field p ins) m) id))

(defn be-al-elem [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field p data)) i))

(defn be-vreg-count [] (-> i64)
  (let [len (al-len [MInst] (load (field (backend) ins))) (mut i) 0 (mut n) 0]
    (loop
      (if (>= (load i) len) (break)
        (do (let [d (load (field (be-al-elem [MInst] (field (backend) ins) (load i)) dst))]
              (if (>= d (load n)) (store! n (+ d 1)) 0))
            (store! i (+ (load i) 1)) 0)))
    (load n)))

(defn select-binary! [(n i64) (mop i64)] (-> i64)
  (let [a (select-value! (n-in n 1)) b (select-value! (n-in n 2))]
    (if (or (< a 0) (< b 0)) -1
      (let [vr (be-vreg-count)]
        (be-emit! (mi-new mop vr a b 0 n)) vr))))

(defn graph-arg-index [(n i64)] (-> i64)
  (let [(mut i) 0 (mut idx) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (and (not (n-dead? (load i)))
                     (and (= (n-op (load i)) OP-ARG)
                          (and (not (ty-mem? (n-aux (load i))))
                               (and (> (n-nins (load i)) 0)
                                    (= (n-in (load i) 0) (g-start))))))
                (store! idx (+ (load idx) 1)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load idx)))

(defn graph-new-index [(n i64)] (-> i64)
  (let [(mut i) 0 (mut idx) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-NEW))
                (store! idx (+ (load idx) 1)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load idx)))

(defn be-field-off [(alias i64)] (-> i64)
  (if (shape-alias-defined? alias) (shape-alias-offset alias) (* (% alias 16) 8)))

(defn select-memory-new! [(n i64)] (-> bool)
  (case (n-op n)
    OP-STORE
      (if (not (select-memory! (n-in n 1))) false
        (let [ptr (select-value! (n-in n 2)) val (select-value! (n-in n 3))]
          (if (or (< ptr 0) (< val 0)) false
            (do (be-emit! (mi-new MI-STORE -1 ptr val (be-field-off (n-aux n)) n)) true))))
    OP-PROJ
      (if (= (n-op (n-in n 0)) OP-NEW)
          (do (select-value! (n-in n 0)) true) false)
    OP-ARG true
    ; Memory phis/merges need edge-specific lowering; accepting them here would read an
    ; uninitialised stack slot and turn selector coverage into a miscompile.
    OP-PHI
      (if (= (n-op (n-in n 0)) OP-LOOP) (load (field (backend) inloop))
        (let [len (n-nins n) (mut i) 1 (mut ok) true]
          (loop
            (if (or (>= (load i) len) (not (load ok))) (break)
              (do (if (select-memory! (n-in n (load i))) 0 (store! ok false))
                  (store! i (+ (load i) 1)) 0)))
          (load ok)))
    OP-MEMMERGE
      (let [len (n-nins n) (mut i) 1 (mut ok) true]
        (loop
          (if (or (>= (load i) len) (not (load ok))) (break)
            (do (if (select-memory! (n-in n (load i))) 0 (store! ok false))
                (store! i (+ (load i) 1)) 0)))
        (load ok))
    true))

(defn select-memory! [(n i64)] (-> bool)
  (if (!= (al-get (load (field (backend) mseen)) n) 0) true
    (let [ok (select-memory-new! n)]
      (if ok (al-set! [i64] (field (backend) mseen) n 1) 0)
      ok)))

(defn select-reaching-store-value! [(mem i64) (ptr-node i64) (alias i64)] (-> i64)
  (case (n-op mem)
    OP-STORE
      (if (and (= (n-aux mem) alias) (= (n-in mem 2) ptr-node))
          (select-value! (n-in mem 3))
        (select-reaching-store-value! (n-in mem 1) ptr-node alias))
    -1))

(defn ctrl-entry-proj [(ctrl i64)] (-> i64)
  (case (n-op ctrl)
    OP-CPROJ ctrl
    OP-REGION
      (if (< (n-nins ctrl) 2) NO-NODE
        (let [first (n-in ctrl 1)]
          (if (!= (n-op first) OP-CPROJ) NO-NODE
            (let [iff (n-in first 0)]
              (if (!= (n-op iff) OP-IF) NO-NODE
                ; A nested merge is entered through the control that dominates its inner If.
                (ctrl-entry-proj (n-in iff 0)))))))
    NO-NODE))

(defn phi-diamond-if [(phi i64)] (-> i64)
  (let [r (n-in phi 0)]
    (if (or (!= (n-op r) OP-REGION) (!= (n-nins r) 3)) NO-NODE
      (let [a (ctrl-entry-proj (n-in r 1)) b (ctrl-entry-proj (n-in r 2))]
        (if (and (and (!= a NO-NODE) (!= b NO-NODE))
                 (and (= (n-in a 0) (n-in b 0)) (= (n-op (n-in a 0)) OP-IF)))
            (n-in a 0) NO-NODE)))))

(defn select-value! [(n i64)] (-> i64)
  (let [p (backend) prior (al-get (load (field p nval)) n)]
    (if (>= prior 0) prior
      (let [op (n-op n) (mut vr) -1]
        (case op
          OP-CONST
            (if (or (= (ty-kinds (n-ty n)) VK-NULL)
                    (and (ty-int-only? (n-ty n)) (ty-const? (n-ty n))))
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-MOVI fresh -1 -1
                                    (if (= (ty-kinds (n-ty n)) VK-NULL)
                                        0 (ty-int-lo (n-ty n))) n))
                  (store! vr fresh) 0) 0)
          OP-PARM
            (let [fresh (be-vreg-count)]
              (be-emit! (mi-new MI-ARG fresh -1 -1 (n-aux n) n))
              (store! vr fresh) 0)
          OP-ARG
            (let [fresh (be-vreg-count)]
              (be-emit! (mi-new MI-ARG fresh -1 -1 (graph-arg-index n) n))
              (store! vr fresh) 0)
          OP-NEW
            (let [fresh (be-vreg-count)]
              (be-emit! (mi-new MI-NEW fresh -1 -1 (n-aux n) n))
              (store! vr fresh) 0)
          OP-PROJ
            (if (and (= (n-aux n) 0) (= (n-op (n-in n 0)) OP-NEW))
                (store! vr (select-value! (n-in n 0))) 0)
          OP-LOAD
            (let [mem (n-in n 1)]
              (if (and (= (n-op mem) OP-PHI) (!= (phi-diamond-if mem) NO-NODE))
                  (let [pred (select-value! (n-in (phi-diamond-if mem) 1))
                        av (select-reaching-store-value! (n-in mem 1) (n-in n 2) (n-aux n))
                        bv (select-reaching-store-value! (n-in mem 2) (n-in n 2) (n-aux n))]
                    (if (or (< pred 0) (or (< av 0) (< bv 0))) 0
                      (let [fresh (be-vreg-count)]
                        (if (= (n-aux (ctrl-entry-proj (n-in (n-in mem 0) 1))) 0)
                            (be-emit! (mi-new MI-CSEL fresh av bv pred n))
                          (be-emit! (mi-new MI-CSEL fresh bv av pred n)))
                        (store! vr fresh) 0)))
                (if (not (select-memory! mem)) 0
                  (let [ptr (select-value! (n-in n 2))]
                    (if (< ptr 0) 0
                      (let [fresh (be-vreg-count)]
                        (be-emit! (mi-new MI-LOAD fresh ptr -1 (be-field-off (n-aux n)) n))
                        (store! vr fresh) 0))))))
          OP-ADD (store! vr (select-binary! n MI-ADD))
          OP-SUB (store! vr (select-binary! n MI-SUB))
          OP-MUL (store! vr (select-binary! n MI-MUL))
          OP-DIV (store! vr (select-binary! n MI-SDIV))
          OP-EQ (store! vr (select-binary! n MI-EQ))
          OP-LT (store! vr (select-binary! n MI-LT))
          OP-LE (store! vr (select-binary! n MI-LE))
          OP-CAST (store! vr (select-value! (n-in n 1)))
          OP-BOX (store! vr (select-value! (n-in n 1)))
          OP-UNBOX (store! vr (select-value! (n-in n 1)))
          OP-PHI
            (let [iff (phi-diamond-if n)]
              (if (= iff NO-NODE) (do (be-fail! BER-UNSUPPORTED-PHI n) 0)
                (let [pred (select-value! (n-in iff 1))
                      av (select-value! (n-in n 1)) bv (select-value! (n-in n 2))]
                  (if (or (< pred 0) (or (< av 0) (< bv 0))) 0
                    (let [fresh (be-vreg-count)]
                      ; imm carries the predicate vreg; a/b follow Region input order. CProj 0 is
                      ; the true edge, but raw graphs are allowed to list the Region arms either way.
                      (if (= (n-aux (ctrl-entry-proj (n-in (n-in n 0) 1))) 0)
                          (be-emit! (mi-new MI-CSEL fresh av bv pred n))
                        (be-emit! (mi-new MI-CSEL fresh bv av pred n)))
                      (store! vr fresh) 0)))))
          OP-MINUS
            (let [a (select-value! (n-in n 1))]
              (if (< a 0) 0
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-NEG fresh a -1 0 n)) (store! vr fresh) 0)))
          (if (= op OP-CALL) (do (be-fail! BER-UNSUPPORTED-CALL n) 0)
            (do (be-fail! BER-UNSUPPORTED-OPCODE n) 0)))
        (if (< (load vr) 0) -1
          (do (al-set! [i64] (field p nval) n (load vr)) (load vr)))))))

(defn be-select-return! [(ret i64)] (-> bool)
  (be-reset!)
  (if (not (be-preflight!)) false
    (if (!= (n-op ret) OP-RETURN) (be-fail! BER-MALFORMED-GRAPH ret)
      (let [mem-ok (if (and (> (n-nins ret) 2) (ty-only-obj? (n-ty (n-in ret 1))))
                       (select-memory! (n-in ret 2)) true)
            v (if mem-ok (select-value! (n-in ret 1)) -1)]
        (if (< v 0) (if (= (be-result) BER-OK) (be-fail! BER-UNSUPPORTED-OPCODE ret) false)
          (do (be-emit! (mi-new MI-RET -1 v -1 0 ret)) true))))))

(defn be-select-fun! [(fun i64)] (-> bool)
  (if (or (!= (n-op fun) OP-FUN) (!= (n-nins fun) 2))
      (do (be-reset!) (be-fail! BER-MALFORMED-GRAPH fun))
    (be-select-return! (n-in fun 1))))

(defn be-has-input? [(n i64) (want i64)] (-> bool)
  (let [len (n-nins n) (mut i) 0 (mut yes) false]
    (loop
      (if (or (>= (load i) len) (load yes)) (break)
        (do (if (= (n-in n (load i)) want) (store! yes true) 0)
            (store! i (+ (load i) 1)) 0)))
    (load yes)))

(defn be-cfg-control? [(op i64)] (-> bool)
  (or (or (= op OP-IF) (= op OP-RETURN))
      (or (or (= op OP-LOOP) (= op OP-REGION))
          (or (= op OP-CPROJ) (= op OP-CALLEND)))))

(defn be-ctrl-succ [(ctrl i64)] (-> i64)
  (let [len (n-nouts ctrl) (mut i) 0 (mut found) NO-NODE (mut count) 0]
    (loop
      (if (>= (load i) len) (break)
        (do (let [u (n-out ctrl (load i))]
              (if (and (not (n-dead? u))
                       (and (be-cfg-control? (n-op u)) (> (n-nins u) 0)))
                  (if (be-has-input? u ctrl)
                      (do (store! found u) (store! count (+ (load count) 1)) 0) 0) 0))
            (store! i (+ (load i) 1)) 0)))
    (if (= (load count) 1) (load found) NO-NODE)))

(defn be-if-arm [(iff i64) (slot i64)] (-> i64)
  (let [len (n-nouts iff) (mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) len) (break)
        (do (let [u (n-out iff (load i))]
              (if (and (not (n-dead? u))
                       (and (= (n-op u) OP-CPROJ) (= (n-aux u) slot)))
                  (store! found u) 0))
            (store! i (+ (load i) 1)) 0)))
    (load found)))

; ---------------------------------------------------------------------------
; G1 structural machine CFG. This pass only reads the ideal graph. Selection remains separate
; until G2, so building or verifying this table cannot perturb optimizer or legacy backend state.
; ---------------------------------------------------------------------------

(defn mu-target-slot [(target i64) (incoming i64)] (-> i64)
  (if (or (= (n-op target) OP-REGION) (= (n-op target) OP-LOOP))
    (let [len (n-nins target) (mut i) 1 (mut found) -1]
      (loop
        (if (or (>= (load i) len) (>= (load found) 0)) (break)
          (do (if (= (n-in target (load i)) incoming) (store! found (load i)) 0)
              (store! i (+ (load i) 1)) 0)))
      (load found))
    0))

(defn mu-add-edge! [(owner i64) (source i64) (target i64) (slot i64)] (-> i64)
  (let [u (machine-unit) len (mu-edge-count) (mut i) 0 (mut prior) -1]
    (loop
      (if (or (>= (load i) len) (>= (load prior) 0)) (break)
        (do (let [e (mu-edge (load i))]
              (if (and (= (load (field e source)) source)
                       (and (= (load (field e target)) target)
                            (= (load (field e target-slot)) slot)))
                  (store! prior (load i)) 0))
            (store! i (+ (load i) 1)) 0)))
    (if (>= (load prior) 0) (load prior)
      (do (al-push! [MEdge] (field u edges) (me-new len owner source target slot)) len))))

(defn mu-note-return! [(owner i64) (ret i64)] (-> i64)
  (let [u (machine-unit) f (mu-function owner)]
    (if (< (load (field f return-first)) 0)
        (store! (field f return-first) (al-len [i64] (load (field u returns)))) 0)
    (al-push! [i64] (field u returns)
              (al-get (load (field u ctrl-block)) ret))
    (store! (field f return-count) (+ (load (field f return-count)) 1)) 0))

(defn mu-walk-block! [(owner i64) (head i64)] (-> i64)
  (let [u (machine-unit) known (al-get (load (field u ctrl-block)) head)]
    (if (>= known 0) known
      (let [bid (mu-block-count) (mut ctrl) head (mut done) false]
        (al-push! [MBlock] (field u blocks) (mb-new bid owner head))
        (loop
          (if (load done) (break)
            (let [mapped (al-get (load (field u ctrl-block)) (load ctrl))]
              (if (and (>= mapped 0) (!= mapped bid))
                (do
                  (mu-add-edge! owner bid mapped 0)
                  (store! done true))
                (do
                  (al-set! [i64] (field u ctrl-block) (load ctrl) bid)
                  (case (n-op (load ctrl))
                    OP-RETURN
                      (do (mu-note-return! owner (load ctrl)) (store! done true))
                    OP-IF
                      (let [a (be-if-arm (load ctrl) 0) b (be-if-arm (load ctrl) 1)]
                        (if (!= a NO-NODE)
                            (do (mu-walk-block! owner a)
                                (mu-add-edge! owner bid
                                              (al-get (load (field u ctrl-block)) a) 0) 0) 0)
                        (if (!= b NO-NODE)
                            (do (mu-walk-block! owner b)
                                (mu-add-edge! owner bid
                                              (al-get (load (field u ctrl-block)) b) 0) 0) 0)
                        (store! done true))
                    (let [next (be-ctrl-succ (load ctrl))]
                      (if (= next NO-NODE)
                          (store! done true)
                        (if (or (= (n-op next) OP-REGION)
                                (or (= (n-op next) OP-LOOP) (= (n-op next) OP-CPROJ)))
                          (do
                            (mu-walk-block! owner next)
                            (mu-add-edge! owner
                                          bid
                                          (al-get (load (field u ctrl-block)) next)
                                          (mu-target-slot next (load ctrl)))
                            (store! done true))
                          (store! ctrl next)))))))))
        bid)))))

(defn mu-build-function! [(ideal i64) (entry i64)] (-> i64)
  (let [u (machine-unit) id (mu-function-count) first (mu-block-count)]
    (al-push! [MFunction] (field u functions) (mf-new id ideal entry))
    (al-push! [i64] (field u symbols) (if (= ideal NO-NODE) -1 (n-aux ideal)))
    (mu-walk-block! id entry)
    (let [f (mu-function id)]
      (store! (field f block-first) first)
      (store! (field f block-count) (- (mu-block-count) first)))
    id))

(defn mu-find-function [(ideal i64)] (-> i64)
  (let [n (mu-function-count) (mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) n) (>= (load found) 0)) (break)
        (do (if (= (mu-function-ideal (load i)) ideal) (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn mu-direct-callee [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (case (n-op callee)
      OP-FUN callee
      OP-CLOSURE (n-in callee 0)
      (let [fidx (ty-fun-singleton (n-ty callee))]
        (if (< fidx 0) NO-NODE (n-find-fun-index fidx))))))

(defn mu-build-reachable-function! [(ideal i64)] (-> i64)
  (let [prior (mu-find-function ideal)]
    (if (>= prior 0) prior
      (let [owner (mu-build-function! ideal (n-fun-entry ideal))
            lim (n-count) (mut i) 0]
        ; Function ownership is already recorded on every reachable control in this function.
        ; A call belongs here exactly when its control maps to one of those blocks.
        (loop
          (if (>= (load i) lim) (break)
            (do
              (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                (let [ctrl (n-in (load i) 0)
                      bid (if (= ctrl NO-NODE) -1
                              (al-get (load (field (machine-unit) ctrl-block)) ctrl))]
                  (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                    (let [callee (mu-direct-callee (load i))]
                      (if (!= callee NO-NODE) (mu-build-reachable-function! callee) 0)) 0)) 0)
              (store! i (+ (load i) 1)) 0)))
        owner))))

(defn mu-finalize-adjacency! [] (-> i64)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count) (mut b) 0]
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (loop
      (if (>= (load b) blocks) (break)
        (do
          (let [block (mu-block (load b)) (mut e) 0]
            (store! (field block pred-first) (al-len [i64] (load (field u pred-edges))))
            (store! (field block pred-count) 0)
            (store! (field block succ-first) (al-len [i64] (load (field u succ-edges))))
            (store! (field block succ-count) 0)
            (loop
              (if (>= (load e) edges) (break)
                (do
                  (if (= (mu-edge-target (load e)) (load b))
                      (do (al-push! [i64] (field u pred-edges) (load e))
                          (store! (field block pred-count)
                                  (+ (load (field block pred-count)) 1))) 0)
                  (if (= (mu-edge-source (load e)) (load b))
                      (do (al-push! [i64] (field u succ-edges) (load e))
                          (store! (field block succ-count)
                                  (+ (load (field block succ-count)) 1))) 0)
                  (store! e (+ (load e) 1)) 0))))
          (store! b (+ (load b) 1)) 0)))
    0))

(defn mu-rpo-visit! [(owner i64) (bid i64)] (-> i64)
  (let [u (machine-unit)]
    (if (!= (al-get (load (field u rpo-seen)) bid) 0) 0
      (do
        (al-set! [i64] (field u rpo-seen) bid 1)
        (let [edges (mu-edge-count) (mut i) 0]
          (loop
            (if (>= (load i) edges) (break)
              (do
                (let [e (mu-edge (load i))]
                  (if (and (= (load (field e owner)) owner)
                           (= (load (field e source)) bid))
                      (mu-rpo-visit! owner (load (field e target))) 0))
                (store! i (+ (load i) 1)) 0))))
        (al-push! [i64] (field u rpo-post) bid)
        0))))

(defn mu-compute-rpo! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) funcs (mu-function-count)
        (mut fidx) 0 (mut ok) true]
    (al-clear! [i64] (field u block-order))
    (loop
      (if (>= (load fidx) funcs) (break)
        (do
          (al-clear! [i64] (field u rpo-seen))
          (al-clear! [i64] (field u rpo-post))
          (let [(mut i) 0]
            (loop
              (if (>= (load i) blocks) (break)
                (do (al-push! [i64] (field u rpo-seen) 0)
                    (store! i (+ (load i) 1)) 0))))
          (let [funrec (mu-function (load fidx))
                entry (load (field funrec entry))
                entry-block (al-get (load (field u ctrl-block)) entry)
                first (al-len [i64] (load (field u block-order)))]
            (if (< entry-block 0) (store! ok false)
                (mu-rpo-visit! (load fidx) entry-block))
            (let [n (al-len [i64] (load (field u rpo-post))) (mut i) n]
              (loop
                (if (<= (load i) 0) (break)
                  (do
                    (store! i (- (load i) 1))
                    (let [bid (al-get (load (field u rpo-post)) (load i))
                          layout (- n (+ (load i) 1))]
                      (al-push! [i64] (field u block-order) bid)
                      (store! (field (mu-block bid) layout-index) layout))
                    0)))
              (store! (field funrec block-first) first)
              (store! (field funrec block-count) n)))
          (store! fidx (+ (load fidx) 1)) 0)))
    ; Every built block must be reachable from its declared function entry.
    (and (load ok) (= (al-len [i64] (load (field u block-order))) blocks))))

(defn mu-idom-intersect [(left i64) (right i64)] (-> i64)
  (let [(mut a) left (mut b) right]
    (loop
      (if (= (load a) (load b)) (break)
        (do
          (loop
            (if (<= (mu-block-layout-index (load a))
                    (mu-block-layout-index (load b))) (break)
              (store! a (mu-block-idom (load a)))))
          (loop
            (if (<= (mu-block-layout-index (load b))
                    (mu-block-layout-index (load a))) (break)
              (store! b (mu-block-idom (load b))))) 0)))
    (load a)))

(defn mu-compute-idoms! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) funcs (mu-function-count)
        (mut i) 0 (mut fidx) 0 (mut ok) true]
    (al-clear! [i64] (field u block-idom))
    (loop
      (if (>= (load i) blocks) (break)
        (do (al-push! [i64] (field u block-idom) -1)
            (store! i (+ (load i) 1)) 0)))
    (loop
      (if (or (>= (load fidx) funcs) (not (load ok))) (break)
        (let [count (mu-function-block-count (load fidx))
              entry (mu-function-block (load fidx) 0)
              (mut changed) true (mut rounds) 0]
          (al-set! [i64] (field u block-idom) entry entry)
          (loop
            (if (or (not (load changed)) (> (load rounds) (+ count 1))) (break)
              (do
                (store! changed false)
                (store! i 1)
                (loop
                  (if (>= (load i) count) (break)
                    (do
                      (let [bid (mu-function-block (load fidx) (load i))
                            block (mu-block bid) (mut p) 0 (mut next) -1]
                        (loop
                          (if (>= (load p) (load (field block pred-count))) (break)
                            (do
                              (let [eid (al-get (load (field u pred-edges))
                                                (+ (load (field block pred-first)) (load p)))
                                    pred (mu-edge-source eid)]
                                (if (>= (mu-block-idom pred) 0)
                                    (if (< (load next) 0) (store! next pred)
                                        (store! next (mu-idom-intersect pred (load next)))) 0))
                              (store! p (+ (load p) 1)) 0)))
                        (if (and (>= (load next) 0) (!= (mu-block-idom bid) (load next)))
                            (do (al-set! [i64] (field u block-idom) bid (load next))
                                (store! changed true)) 0))
                      (store! i (+ (load i) 1)) 0)))
                (store! rounds (+ (load rounds) 1)) 0)))
          (store! i 0)
          (loop
            (if (>= (load i) count) (break)
              (do
                (if (< (mu-block-idom (mu-function-block (load fidx) (load i))) 0)
                    (store! ok false) 0)
                (store! i (+ (load i) 1)) 0)))
          (store! fidx (+ (load fidx) 1)) 0)))
    (load ok)))

(defn mu-dominates? [(ancestor i64) (descendant i64)] (-> bool)
  (if (!= (mu-block-owner ancestor) (mu-block-owner descendant)) false
    (let [(mut cursor) descendant]
      (loop
        (if (or (= (load cursor) ancestor)
                (= (mu-block-idom (load cursor)) (load cursor))) (break)
          (store! cursor (mu-block-idom (load cursor)))))
      (= (load cursor) ancestor))))

(defn mu-compute-loop-depth! [] (-> i64)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count) (mut i) 0]
    (loop
      (if (>= (load i) blocks) (break)
        (do (store! (field (mu-block (load i)) loop-depth) 0)
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) edges) (break)
        (do
          (let [back (mu-edge (load i)) header (load (field back target))
                source (load (field back source)) slot (load (field back target-slot))]
            (if (and (= slot 2) (= (n-op (mu-block-control header)) OP-LOOP))
              (do
                (al-clear! [i64] (field u rpo-seen))
                (al-clear! [i64] (field u rpo-post))
                (let [(mut b) 0]
                  (loop
                    (if (>= (load b) blocks) (break)
                      (do (al-push! [i64] (field u rpo-seen) 0)
                          (store! b (+ (load b) 1)) 0))))
                (al-set! [i64] (field u rpo-seen) header 1)
                (if (= source header) 0
                  (do (al-set! [i64] (field u rpo-seen) source 1)
                      (al-push! [i64] (field u rpo-post) source)))
                (loop
                  (let [n (al-len [i64] (load (field u rpo-post)))]
                    (if (= n 0) (break)
                      (let [current (al-get (load (field u rpo-post)) (- n 1))
                            (mut eid) 0]
                        (al-pop! [i64] (field u rpo-post))
                        (loop
                          (if (>= (load eid) edges) (break)
                            (do
                              (let [pred-edge (mu-edge (load eid))]
                                (if (and (= (load (field pred-edge target)) current)
                                         (= (load (field pred-edge owner))
                                            (load (field back owner))))
                                  (let [pred (load (field pred-edge source))]
                                    (if (= (al-get (load (field u rpo-seen)) pred) 0)
                                      (do (al-set! [i64] (field u rpo-seen) pred 1)
                                          (if (= pred header) 0
                                              (al-push! [i64] (field u rpo-post) pred))) 0)) 0))
                              (store! eid (+ (load eid) 1)) 0)))))))
                (let [(mut b) 0]
                  (loop
                    (if (>= (load b) blocks) (break)
                      (do
                        (if (!= (al-get (load (field u rpo-seen)) (load b)) 0)
                            (store! (field (mu-block (load b)) loop-depth)
                                    (+ (load (field (mu-block (load b)) loop-depth)) 1)) 0)
                        (store! b (+ (load b) 1)) 0)))) 0) 0))
          (store! i (+ (load i) 1)) 0)))
    0))

(defn mu-fail-verify! [(code i64) (item i64)] (-> bool)
  (let [u (machine-unit)]
    (store! (field u verify-result) code)
    (store! (field u verify-item) item)
    false))

(defn mu-adj-count [(edge i64) (pred bool)] (-> i64)
  (let [u (machine-unit) len (if pred
                                  (al-len [i64] (load (field u pred-edges)))
                                  (al-len [i64] (load (field u succ-edges))))
        (mut i) 0 (mut count) 0]
    (loop
      (if (>= (load i) len) (break)
        (do
          (if (= (if pred
                     (al-get (load (field u pred-edges)) (load i))
                     (al-get (load (field u succ-edges)) (load i))) edge)
              (store! count (+ (load count) 1)) 0)
          (store! i (+ (load i) 1)) 0)))
    (load count)))

(defn mu-block-adj-valid? [(bid i64) (pred bool)] (-> bool)
  (let [u (machine-unit) b (mu-block bid)
        first (if pred (load (field b pred-first)) (load (field b succ-first)))
        count (if pred (load (field b pred-count)) (load (field b succ-count)))
        list-len (if pred
                     (al-len [i64] (load (field u pred-edges)))
                     (al-len [i64] (load (field u succ-edges))))
        (mut i) 0 (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) list-len))) false
      (do
        (loop
          (if (or (>= (load i) count) (not (load ok))) (break)
            (do
              (let [eid (if pred
                            (al-get (load (field u pred-edges)) (+ first (load i)))
                            (al-get (load (field u succ-edges)) (+ first (load i))))]
                (if (or (< eid 0) (>= eid (mu-edge-count))) (store! ok false)
                  (if (!= (if pred (mu-edge-target eid) (mu-edge-source eid)) bid)
                      (store! ok false) 0)))
              (store! i (+ (load i) 1)) 0)))
        (load ok)))))

(defn mu-slot-valid? [(eid i64)] (-> bool)
  (let [u (machine-unit) e (mu-edge eid) s (load (field e source))
        t (load (field e target)) slot (load (field e target-slot))
        target (mu-block-control t)]
    (if (or (= (n-op target) OP-REGION) (= (n-op target) OP-LOOP))
      (if (or (<= slot 0) (or (>= slot (n-nins target)) (= (n-in target slot) NO-NODE))) false
        (let [incoming (n-in target slot)
              mapped (al-get (load (field u ctrl-block)) incoming)
              edges (mu-edge-count) (mut i) 0 (mut same) 0]
          (loop
            (if (>= (load i) edges) (break)
              (do
                (let [other (mu-edge (load i))]
                  (if (and (= (load (field other target)) t)
                           (= (load (field other target-slot)) slot))
                      (store! same (+ (load same) 1)) 0))
                (store! i (+ (load i) 1)) 0)))
          (and (= mapped s) (= (load same) 1))))
      (= slot 0))))

(defn mu-block-terminator-op [(bid i64)] (-> i64)
  (let [lim (n-count) (mut i) 0 (mut op) -1]
    (loop
      (if (>= (load i) lim) (break)
        (do
          (if (= (al-get (load (field (machine-unit) ctrl-block)) (load i)) bid)
            (let [candidate (n-op (load i))]
              (if (or (= candidate OP-IF) (= candidate OP-RETURN))
                  (store! op candidate) 0)) 0)
          (store! i (+ (load i) 1)) 0)))
    (load op)))

(defn mu-block-terminator [(bid i64)] (-> i64)
  (let [lim (n-count) (mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) lim) (break)
        (do
          (if (= (al-get (load (field (machine-unit) ctrl-block)) (load i)) bid)
            (let [candidate (n-op (load i))]
              (if (or (= candidate OP-IF) (= candidate OP-RETURN))
                  (store! found (load i)) 0)) 0)
          (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn mu-verify-terminators! [] (-> bool)
  (let [blocks (mu-block-count) (mut i) 0]
    (loop
      (if (>= (load i) blocks) (break)
        (do
          (let [op (mu-block-terminator-op (load i))
                succ (load (field (mu-block (load i)) succ-count))]
            (if (or (and (= op OP-IF) (!= succ 2))
                    (and (= op OP-RETURN) (!= succ 0)))
                (do (mu-fail-verify! MCFG-TERMINATOR-ARITY (load i)) (break)) 0))
          (store! i (+ (load i) 1)) 0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-rpo! [] (-> bool)
  (let [u (machine-unit) funcs (mu-function-count) blocks (mu-block-count) (mut fidx) 0]
    (al-clear! [i64] (field u rpo-seen))
    (let [(mut i) 0]
      (loop
        (if (>= (load i) blocks) (break)
          (do (al-push! [i64] (field u rpo-seen) 0)
              (store! i (+ (load i) 1)) 0))))
    (loop
      (if (>= (load fidx) funcs) (break)
        (do
          (let [f (mu-function (load fidx)) n (load (field f block-count)) (mut pos) 0]
            (let [entry-block (al-get (load (field u ctrl-block)) (load (field f entry)))]
              (if (or (= n 0) (!= (mu-function-block (load fidx) 0) entry-block))
                  (do (mu-fail-verify! MCFG-RPO (load fidx)) 0) 0))
            (loop
              (if (or (>= (load pos) n) (!= (mu-verify-result) MCFG-OK)) (break)
                (do
                  (let [bid (mu-function-block (load fidx) (load pos))]
                    (if (or (< bid 0)
                            (or (>= bid blocks)
                                (or (!= (mu-block-owner bid) (load fidx))
                                    (or (!= (mu-block-layout-index bid) (load pos))
                                        (!= (al-get (load (field u rpo-seen)) bid) 0)))))
                        (do (mu-fail-verify! MCFG-RPO bid) (break))
                      (al-set! [i64] (field u rpo-seen) bid 1)))
                  (store! pos (+ (load pos) 1)) 0))))
          (if (!= (mu-verify-result) MCFG-OK) (break) 0)
          (store! fidx (+ (load fidx) 1)) 0)))
    (if (= (mu-verify-result) MCFG-OK)
      (let [(mut i) 0]
        (loop
          (if (>= (load i) blocks) (break)
            (do (if (= (al-get (load (field u rpo-seen)) (load i)) 0)
                    (do (mu-fail-verify! MCFG-RPO (load i)) (break)) 0)
                (store! i (+ (load i) 1)) 0)))) 0)
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-idoms! [] (-> bool)
  (let [blocks (mu-block-count) funcs (mu-function-count) (mut fidx) 0]
    (loop
      (if (or (>= (load fidx) funcs) (!= (mu-verify-result) MCFG-OK)) (break)
        (do
          (let [count (mu-function-block-count (load fidx))
                entry (mu-function-block (load fidx) 0) (mut i) 0]
            (if (!= (mu-block-idom entry) entry)
                (do (mu-fail-verify! MCFG-IDOM entry) 0) 0)
            (store! i 1)
            (loop
              (if (or (>= (load i) count) (!= (mu-verify-result) MCFG-OK)) (break)
                (do
                  (let [bid (mu-function-block (load fidx) (load i)) parent (mu-block-idom bid)]
                    (if (or (< parent 0)
                            (or (>= parent blocks)
                                (or (!= (mu-block-owner parent) (load fidx))
                                    (>= (mu-block-layout-index parent)
                                        (mu-block-layout-index bid)))))
                        (do (mu-fail-verify! MCFG-IDOM bid) 0) 0))
                  (store! i (+ (load i) 1)) 0))))
          (store! fidx (+ (load fidx) 1)) 0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count)
        funcs (mu-function-count) (mut i) 0]
    (store! (field u verify-result) MCFG-OK)
    (store! (field u verify-item) -1)
    (loop
      (if (>= (load i) blocks) (break)
            (do (let [b (mu-block (load i)) owner (load (field b owner))]
              (if (or (!= (load (field b id)) (load i))
                      (or (< owner 0) (>= owner funcs)))
                  (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                (if (or (not (mu-block-adj-valid? (load i) true))
                        (not (mu-block-adj-valid? (load i) false)))
                    (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break)) 0)))
            (store! i (+ (load i) 1)) 0)))
    (if (!= (mu-verify-result) MCFG-OK) false
      (do
        (store! i 0)
        (loop
          (if (>= (load i) edges) (break)
            (do
              (let [e (mu-edge (load i)) s (load (field e source)) t (load (field e target))
                    owner (load (field e owner)) slot (load (field e target-slot))]
                (if (or (< s 0) (or (>= s blocks) (or (< t 0) (>= t blocks))))
                    (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                  (if (or (!= owner (mu-block-owner s)) (!= owner (mu-block-owner t)))
                      (do (mu-fail-verify! MCFG-FUNCTION-ISOLATION (load i)) (break))
                    (if (or (!= (mu-adj-count (load i) false) 1)
                            (!= (mu-adj-count (load i) true) 1))
                        (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                      (if (not (mu-slot-valid? (load i)))
                          (do (mu-fail-verify! MCFG-PREDECESSOR-SLOT (load i)) (break))
                          0)))))
              (store! i (+ (load i) 1)) 0)))
        (if (!= (mu-verify-result) MCFG-OK) false
          (if (not (mu-verify-terminators!)) false
            (if (not (mu-verify-rpo!)) false
                (mu-verify-idoms!))))))))

; Test-only corruption hooks are explicit and narrow; production callers only build and verify.
(defn mu-corrupt-block-owner! [(bid i64) (new-owner i64)] (-> i64)
  (store! (field (mu-block bid) owner) new-owner) 0)
(defn mu-corrupt-edge-target-slot! [(eid i64) (slot i64)] (-> i64)
  (store! (field (mu-edge eid) target-slot) slot) 0)
(defn mu-corrupt-drop-last-pred! [] (-> i64)
  (let [u (machine-unit) n (al-len [i64] (load (field u pred-edges)))]
    (if (> n 0) (store! (field (field u pred-edges) len) (- n 1)) 0) 0))
(defn mu-corrupt-layout! [(bid i64) (layout i64)] (-> i64)
  (store! (field (mu-block bid) layout-index) layout) 0)
(defn mu-corrupt-idom! [(bid i64) (parent i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) block-idom) bid parent) 0)
(defn mu-corrupt-add-return-successor! [(bid i64)] (-> i64)
  (let [owner (mu-block-owner bid)]
    (al-push! [MEdge] (field (machine-unit) edges)
              (me-new (mu-edge-count) owner bid bid 0))
    (mu-finalize-adjacency!) 0))
(defn mu-corrupt-edge-target! [(eid i64) (target i64)] (-> i64)
  (store! (field (mu-edge eid) target) target)
  (mu-finalize-adjacency!) 0)

(defn mu-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count) edges (mu-edge-count) (mut fidx) 0]
    (loop
      (if (>= (load fidx) funcs) (break)
        (do
          (let [f (mu-function (load fidx)) ideal (load (field f ideal))
                nblocks (load (field f block-count))]
            (fmt w "function {d} ideal {d} blocks {d}\n" (load fidx) ideal nblocks)
            (let [(mut rpo) 0]
              (loop
                (if (>= (load rpo) nblocks) (break)
                  (do
                    (let [bid (mu-function-block (load fidx) (load rpo))
                          ctrl (mu-block-control bid)]
                      (fmt w "  b{d} {s}" (load rpo) (op-name (n-op ctrl)))
                      ; Dump successors in target-layout order, independent of discovery order.
                      (let [(mut target-layout) 0]
                        (loop
                          (if (>= (load target-layout) nblocks) (break)
                            (do
                              (let [(mut eid) 0]
                                (loop
                                  (if (>= (load eid) edges) (break)
                                    (do
                                      (let [e (mu-edge (load eid)) target (mu-edge-target (load eid))]
                                        (if (and (= (mu-edge-source (load eid)) bid)
                                                 (and (= (mu-block-owner target) (load fidx))
                                                      (= (mu-block-layout-index target)
                                                         (load target-layout))))
                                            (do (fmt w " ->b{d}[{d}]"
                                                     (load target-layout)
                                                     (mu-edge-target-slot (load eid))) 0) 0))
                                      (store! eid (+ (load eid) 1)) 0))))
                              (store! target-layout (+ (load target-layout) 1)) 0))))
                      (ps w "\n"))
                    (store! rpo (+ (load rpo) 1)) 0)))))
          (store! fidx (+ (load fidx) 1)) 0)))
    0))

(defn mu-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf) w (stack Writer)]
    (store! (field fb data) buf)
    (store! (field fb cap) cap)
    (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (mu-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "mu-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn mu-finish-build! [] (-> bool)
  (mu-finalize-adjacency!)
  (store! (field (machine-unit) phase) 1)
  (if (mu-compute-rpo!)
      (if (mu-compute-idoms!) (do (mu-compute-loop-depth!) (mu-verify!))
          (mu-fail-verify! MCFG-RPO -1))
      (mu-fail-verify! MCFG-RPO -1)))

(defn mu-build-entry! [(entry-fun i64)] (-> bool)
  (mu-reset!)
  (if (or (!= (g-verify) 0) (= (n-op entry-fun) OP-FUNSTART)) false
    (if (!= (n-op entry-fun) OP-FUN) false
      (do (mu-build-reachable-function! entry-fun)
          (mu-finish-build!)))))

(defn mu-build-program! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0) false
    (let [owner (mu-build-function! NO-NODE (g-start)) lim (n-count) (mut i) 0]
      (loop
        (if (>= (load i) lim) (break)
          (do
            (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                (let [ctrl (n-in (load i) 0)
                      bid (if (= ctrl NO-NODE) -1
                            (al-get (load (field (machine-unit) ctrl-block)) ctrl))]
                  (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                      (let [callee (mu-direct-callee (load i))]
                        (if (!= callee NO-NODE) (mu-build-reachable-function! callee) 0)) 0)) 0)
            (store! i (+ (load i) 1)) 0)))
      (mu-finish-build!))))

(defn mu-build! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0) false
    (let [lim (n-count) (mut i) 0 (mut found) false]
      (loop
        (if (>= (load i) lim) (break)
          (do
            (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-FUN))
              (do (mu-build-function! (load i) (n-fun-entry (load i)))
                  (store! found true)) 0)
            (store! i (+ (load i) 1)) 0)))
      ; A graph without explicit Fun nodes is one synthetic top-level machine function.
      (if (not (load found)) (mu-build-function! NO-NODE (g-start)) 0)
      (mu-finish-build!))))

(defn be-loop-phi [(lp i64)] (-> i64)
  (let [len (n-nouts lp) (mut i) 0 (mut found) NO-NODE]
    (loop
      (if (>= (load i) len) (break)
        (do (let [u (n-out lp (load i))]
              (if (and (not (n-dead? u))
                       (and (and (= (n-op u) OP-PHI) (= (n-in u 0) lp))
                            (not (ty-mem? (n-ty u)))))
                  (store! found u) 0))
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn be-select-loop-memory! [(lp i64)] (-> bool)
  (let [len (n-nouts lp) (mut i) 0 (mut ok) true]
    (loop
      (if (or (>= (load i) len) (not (load ok))) (break)
        (do (let [u (n-out lp (load i))]
              (if (and (not (n-dead? u))
                       (and (= (n-op u) OP-PHI) (ty-mem? (n-ty u))))
                  (if (select-memory! (n-in u 2)) 0 (store! ok false)) 0))
            (store! i (+ (load i) 1)) 0)))
    (load ok)))

(defn be-select-loop-memory-init! [(lp i64)] (-> bool)
  (let [len (n-nouts lp) (mut i) 0 (mut ok) true]
    (loop
      (if (or (>= (load i) len) (not (load ok))) (break)
        (do (let [u (n-out lp (load i))]
              (if (and (not (n-dead? u))
                       (and (= (n-op u) OP-PHI) (ty-mem? (n-ty u))))
                  (if (select-memory! (n-in u 1)) 0 (store! ok false)) 0))
            (store! i (+ (load i) 1)) 0)))
    (load ok)))

(defn be-select-loop! [(lp i64) (next-label (ptr i64))] (-> bool)
  (let [phi (be-loop-phi lp) iff (be-ctrl-succ lp)]
    (if (= phi NO-NODE)
        (let [prior (al-get (load (field (backend) clabel)) lp)]
          (if (>= prior 0) (do (be-emit! (mi-new MI-B -1 -1 -1 prior lp)) true)
            (let [head (load next-label)]
              (store! next-label (+ head 1))
              (al-set! [i64] (field (backend) clabel) lp head)
              (be-emit! (mi-new MI-LABEL -1 -1 -1 head lp))
              (if (= iff NO-NODE) (be-fail! BER-UNSUPPORTED-CFG lp)
                (be-select-control! iff next-label)))))
      (if (or (= iff NO-NODE) (!= (n-op iff) OP-IF)) (be-fail! BER-UNSUPPORTED-CFG lp)
      (let [init (select-value! (n-in phi 1))]
        (if (< init 0) false
          (do (al-set! [i64] (field (backend) nval) phi init)
              (let [head (load next-label) exit-label (+ head 1)]
                (store! next-label (+ head 2))
                ; Hoist invariant operands and allocation-derived pointers before the header.
                ; The predicate instruction itself remains below the label and is recomputed.
                (let [pn (n-in iff 1)]
                  (if (> (n-nins pn) 1) (select-value! (n-in pn 1)) 0)
                  (if (> (n-nins pn) 2) (select-value! (n-in pn 2)) 0))
                (let [bn (n-in phi 2)]
                  (if (> (n-nins bn) 1) (select-value! (n-in bn 1)) 0)
                  (if (> (n-nins bn) 2) (select-value! (n-in bn 2)) 0))
                (if (not (be-select-loop-memory-init! lp)) false
                  (do (be-emit! (mi-new MI-LABEL -1 -1 -1 head lp))
                (let [pred (select-value! (n-in iff 1))]
                  (if (< pred 0) false
                    (do (be-emit! (mi-new MI-CBZ -1 pred -1 exit-label iff))
                        (let [back (select-value! (n-in phi 2))]
                          (if (< back 0) false
                            (do (store! (field (backend) inloop) true)
                                (let [mem-ok (be-select-loop-memory! lp)]
                                  (store! (field (backend) inloop) false)
                                  (if (not mem-ok) false
                                    (do (be-emit! (mi-new MI-MOV -1 back -1 init phi))
                                (be-emit! (mi-new MI-B -1 -1 -1 head lp))
                                (be-emit! (mi-new MI-LABEL -1 -1 -1 exit-label lp))
                                (be-select-control! (be-if-arm iff 1) next-label))))))))))))))))))))

(defn be-select-control! [(ctrl i64) (next-label (ptr i64))] (-> bool)
  (let [c (if (or (= (n-op ctrl) OP-RETURN) (= (n-op ctrl) OP-IF)) ctrl (be-ctrl-succ ctrl))]
    (if (= c NO-NODE) (be-fail! BER-UNSUPPORTED-CFG ctrl)
      (case (n-op c)
        OP-RETURN
          (let [mem-ok (if (and (> (n-nins c) 2) (ty-only-obj? (n-ty (n-in c 1))))
                           (select-memory! (n-in c 2)) true)
                v (if mem-ok (select-value! (n-in c 1)) -1)]
            (if (< v 0) false (do (be-emit! (mi-new MI-RET -1 v -1 0 c)) true)))
        OP-IF
          (let [ta (be-if-arm c 0) fa (be-if-arm c 1)
                ts (be-ctrl-succ ta) fs (be-ctrl-succ fa)]
            (if (and (!= ts NO-NODE) (and (= ts fs) (= (n-op ts) OP-REGION)))
                ; Acyclic diamonds become dataflow CSELs. This is both smaller and avoids
                ; manufacturing machine phis before the general loop/block scheduler lands.
                (be-select-control! ts next-label)
              (let [pred (select-value! (n-in c 1)) false-label (load next-label)]
                (store! next-label (+ false-label 1))
                (if (< pred 0) false
                  (do (be-emit! (mi-new MI-CBZ -1 pred -1 false-label c))
                      (if (not (be-select-control! ta next-label)) false
                        (do (be-emit! (mi-new MI-LABEL -1 -1 -1 false-label c))
                            (be-select-control! fa next-label))))))))
        OP-LOOP (be-select-loop! c next-label)
        (if (= (n-op c) OP-CALLEND) (be-fail! BER-UNSUPPORTED-CALL c)
          (be-fail! BER-UNSUPPORTED-CFG c))))))

(defn be-select-program! [] (-> bool)
  (be-reset!)
  (if (not (be-preflight!)) false
    (let [(mut label) 0] (be-select-control! (g-start) (mut label)))))

(defn be-inst-count [] (-> i64) (al-len [MInst] (load (field (backend) ins))))
(defn be-inst [(i i64)] (-> (ptr MInst)) (be-al-elem [MInst] (field (backend) ins) i))

; ---------------------------------------------------------------------------
; G2 block-based selection. This path consumes the verified MachineUnit. It deliberately does
; not call the legacy diamond/loop selectors above; later milestones lower its block terminators.
; ---------------------------------------------------------------------------

(defn ms-result [] (-> i64) (load (field (machine-unit) selection-result)))
(defn ms-result-item [] (-> i64) (load (field (machine-unit) selection-item)))

(defn ms-fail! [(code i64) (item i64)] (-> i64)
  (let [u (machine-unit)]
    (if (= (load (field u selection-result)) MSEL-OK)
        (do (store! (field u selection-result) code)
            (store! (field u selection-item) item)) 0)
    -1))

(defn ms-map-index [(owner i64) (node i64)] (-> i64)
  (+ (* owner (n-count)) node))

(defn ms-map-init! [] (-> i64)
  (let [u (machine-unit) total (* (mu-function-count) (n-count)) (mut i) 0]
    (al-clear! [i64] (field u selected-values))
    (al-clear! [i64] (field u selected-nodes))
    (loop
      (if (>= (load i) total) (break)
        (do (al-push! [i64] (field u selected-values) -1)
            (al-push! [i64] (field u selected-nodes) 0)
            (store! i (+ (load i) 1)) 0)))
    0))

(defn ms-vget [(owner i64) (node i64)] (-> i64)
  (al-get (load (field (machine-unit) selected-values)) (ms-map-index owner node)))
(defn ms-vset! [(owner i64) (node i64) (vreg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) selected-values) (ms-map-index owner node) vreg) 0)
(defn ms-new-vreg! [] (-> i64)
  (let [p (field (machine-unit) next-vreg) v (load p)]
    (store! p (+ v 1)) v))
(defn ms-seen? [(owner i64) (node i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) selected-nodes)) (ms-map-index owner node)) 0))
(defn ms-seen! [(owner i64) (node i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) selected-nodes) (ms-map-index owner node) 1) 0)

(defn ms-node-block [(owner i64) (node i64)] (-> i64)
  (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
    (if (= ctrl NO-NODE) (ms-entry-block owner)
      (let [mapped (al-get (load (field (machine-unit) ctrl-block)) ctrl)]
        (if (and (>= mapped 0) (= (mu-block-owner mapped) owner))
            mapped (ms-entry-block owner))))))

(defn ms-emit! [(owner i64) (bid i64) (m MInst)] (-> i64)
  (let [id (be-emit! m) p (be-inst id)]
    (store! (field p owner) owner)
    (store! (field p block-id) bid)
    id))

(defn ms-add-memory-deps! [(at i64) (node i64) (first-slot i64) (count i64)] (-> i64)
  (let [u (machine-unit) m (be-inst at) first (al-len [i64] (load (field u selection-memory-deps)))
        (mut i) 0]
    (loop
      (if (>= (load i) count) (break)
        (do (al-push! [i64] (field u selection-memory-deps)
                      (n-in node (+ first-slot (load i))))
            (store! i (+ (load i) 1)) 0)))
    (store! (field m mem-first) first)
    (store! (field m mem-count) count)
    0))

(defn ms-add-call-args! [(at i64) (first i64) (count i64)] (-> i64)
  (let [m (be-inst at)]
    (store! (field m arg-first) first) (store! (field m arg-count) count) 0))

(defn ms-entry-block [(owner i64)] (-> i64) (mu-function-block owner 0))

;; A CallEnd is an intra-block control dependency, not merely a block owner. Preserve the chain
;; before selecting a later safepoint/effect; otherwise recursive object construction can schedule
;; the parent New before the calls that compute its fields. Besides changing source evaluation
;; order, that exposes a partially initialized parent to moving collection.
(defn ms-select-control-effects! [(owner i64) (ctrl i64) (bid i64)] (-> bool)
  (if (or (< ctrl 0) (!= (n-op ctrl) OP-CALLEND)) true
    (if (not (ms-select-control-effects! owner (n-in ctrl 0) bid)) false
      (>= (ms-select-value-at! owner (n-in ctrl 1) bid) 0))))

(defn ms-memory-block [(owner i64) (node i64)] (-> i64)
  (let [direct (ms-node-block owner node)]
    (if (!= direct (ms-entry-block owner)) direct
      (case (n-op node)
        OP-STORE (ms-memory-block owner (n-in node 1))
        OP-LOAD (ms-memory-block owner (n-in node 1))
        OP-PROJ
          (if (= (n-op (n-in node 0)) OP-NEW)
              (ms-node-block owner (n-in node 0)) direct)
        direct))))

(defn ms-select-memory-at! [(owner i64) (node i64) (bid i64)] (-> bool)
  (if (ms-seen? owner node) true
    (let [(mut ok) true]
      (case (n-op node)
        OP-STORE
          (if (not (ms-select-memory-at! owner (n-in node 1) bid)) (store! ok false)
            (let [ptr (ms-select-value-at! owner (n-in node 2) bid)
                  value (ms-select-value-at! owner (n-in node 3) bid)]
              (if (or (< ptr 0) (< value 0)) (store! ok false)
                (let [at (ms-emit! owner bid
                                   (mi-new MI-STORE -1 ptr value
                                           (be-field-off (n-aux node)) node))]
                  (ms-add-memory-deps! at node 1 1)))))
        OP-PROJ
          (if (= (n-op (n-in node 0)) OP-NEW)
              (if (< (ms-select-value-at! owner (n-in node 0) bid) 0) (store! ok false) 0)
              0)
        OP-ARG 0
        OP-PARM 0
        OP-MEMMERGE
          (let [len (n-nins node) (mut i) 1]
            (loop
              (if (or (>= (load i) len) (not (load ok))) (break)
                    (do (if (not (ms-select-memory-at! owner (n-in node (load i))
                                                       (ms-memory-block owner
                                                         (n-in node (load i)))))
                        (store! ok false) 0)
                    (store! i (+ (load i) 1)) 0))))
        OP-PHI (do (ms-fail! MSEL-UNSUPPORTED node) (store! ok false))
        0)
      (if (load ok) (do (ms-seen! owner node) true) false))))

(defn ms-select-memory! [(owner i64) (node i64)] (-> bool)
  (ms-select-memory-at! owner node (ms-memory-block owner node)))

(defn ms-select-binary! [(owner i64) (node i64) (mop i64) (bid i64)] (-> i64)
  (let [a (ms-select-value-at! owner (n-in node 1) bid)
        b (ms-select-value-at! owner (n-in node 2) bid)]
    (if (or (< a 0) (< b 0)) -1
      (let [vr (ms-new-vreg!)]
        (ms-emit! owner bid (mi-new mop vr a b 0 node))
        vr))))

(defn ms-select-value-at! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [prior (ms-vget owner node)]
    (if (>= prior 0) prior
      (let [op (n-op node) (mut vr) -1]
        (case op
          OP-CONST
            (if (or (= (ty-kinds (n-ty node)) VK-NULL)
                    (and (ty-int-only? (n-ty node)) (ty-const? (n-ty node))))
              (let [fresh (ms-new-vreg!)]
                (ms-emit! owner (ms-entry-block owner)
                          (mi-new MI-MOVI fresh -1 -1
                                  (if (= (ty-kinds (n-ty node)) VK-NULL)
                                      0 (ty-int-lo (n-ty node))) node))
                (store! vr fresh)) 0)
          OP-ARG
            (let [fixed (ms-new-vreg!) fresh (ms-new-vreg!)]
              (ms-emit! owner (ms-entry-block owner)
                        (mi-new MI-ARG fixed -1 -1 (graph-arg-index node) node))
              (ms-emit! owner (ms-entry-block owner)
                        (mi-new MI-ABI-COPY fresh fixed -1 0 NO-NODE))
              (store! vr fresh))
          OP-PARM
            (let [fixed (ms-new-vreg!) fresh (ms-new-vreg!)]
              (ms-emit! owner (ms-entry-block owner)
                        (mi-new (if (< (n-aux node) 8) MI-ARG MI-STACKARG)
                                fixed -1 -1 (n-aux node) node))
              (ms-emit! owner (ms-entry-block owner)
                        (mi-new MI-ABI-COPY fresh fixed -1 0 NO-NODE))
              (store! vr fresh))
          OP-NEW
            (let [len (n-nins node) (mut i) 1
                  (mut ok) (ms-select-control-effects! owner (n-in node 0)
                              (ms-node-block owner node))]
              (loop
                (if (or (>= (load i) len) (not (load ok))) (break)
                  (do (if (not (ms-select-memory! owner (n-in node (load i))))
                          (store! ok false) 0)
                      (store! i (+ (load i) 1)) 0)))
              (if (load ok)
                (let [fresh (ms-new-vreg!)]
                  (let [at (ms-emit! owner (ms-node-block owner node)
                                     (mi-new MI-NEW fresh -1 -1
                                             (n-aux node) node))]
                    (ms-add-memory-deps! at node 1 (- len 1)))
                  (store! vr fresh)) 0))
          OP-PROJ
            (if (and (= (n-aux node) 0) (= (n-op (n-in node 0)) OP-NEW))
                (store! vr (ms-select-value-at! owner (n-in node 0) bid)) 0)
          OP-LOAD
            (if (not (ms-select-memory! owner (n-in node 1))) 0
              (let [ptr (ms-select-value-at! owner (n-in node 2) (ms-memory-block owner node))]
                (if (< ptr 0) 0
                  (let [fresh (ms-new-vreg!)]
                    (let [at (ms-emit! owner (ms-memory-block owner node)
                                       (mi-new MI-LOAD fresh ptr -1
                                               (be-field-off (n-aux node)) node))]
                      (ms-add-memory-deps! at node 1 1))
                    (store! vr fresh)))))
          OP-ADD (store! vr (ms-select-binary! owner node MI-ADD bid))
          OP-SUB (store! vr (ms-select-binary! owner node MI-SUB bid))
          OP-MUL (store! vr (ms-select-binary! owner node MI-MUL bid))
          OP-DIV (store! vr (ms-select-binary! owner node MI-SDIV bid))
          OP-EQ  (store! vr (ms-select-binary! owner node MI-EQ bid))
          OP-LT  (store! vr (ms-select-binary! owner node MI-LT bid))
          OP-LE  (store! vr (ms-select-binary! owner node MI-LE bid))
          OP-MINUS
            (let [a (ms-select-value-at! owner (n-in node 1) bid)]
              (if (< a 0) 0
                (let [fresh (ms-new-vreg!)]
                  (ms-emit! owner bid
                            (mi-new MI-NEG fresh a -1 0 node))
                  (store! vr fresh))))
          OP-CAST (store! vr (ms-select-value-at! owner (n-in node 1) bid))
          OP-BOX (store! vr (ms-select-value-at! owner (n-in node 1) bid))
          OP-UNBOX (store! vr (ms-select-value-at! owner (n-in node 1) bid))
          OP-PHI 0
          OP-CALL
            (let [callee (mu-direct-callee node) argc (- (n-nins node) 2)
                  call-bid (ms-node-block owner node)]
              (if (not (ms-select-control-effects! owner (n-in node 0) call-bid))
                  (ms-fail! MSEL-CALL node)
                (if (or (!= (n-op (n-in node 1)) OP-FUN)
                      (or (= callee NO-NODE)
                          (or (> argc 16)
                              (and (> argc 0) (ty-mem? (n-ty (n-in node 2)))))))
                  (ms-fail! MSEL-CALL node)
                (let [target (mu-find-function callee)]
                  (if (< target 0) (ms-fail! MSEL-CALL node)
                    (let [u (machine-unit) buf (stack (array i64 16))
                          args (cast (ptr i64) buf) (mut i) 0 (mut ok) true]
                      (loop
                        (if (or (>= (load i) argc) (not (load ok))) (break)
                          (do
                            (let [arg (ms-select-value-at! owner (n-in node (+ 2 (load i)))
                                       call-bid)]
                              (if (< arg 0) (store! ok false)
                                (store! (index args (load i)) arg)))
                            (store! i (+ (load i) 1)) 0)))
                      (if (load ok)
                          (let [first (al-len [i64] (load (field u call-args)))
                                fresh (ms-new-vreg!) (mut j) 0]
                            (loop
                              (if (>= (load j) argc) (break)
                                (do (al-push! [i64] (field u call-args)
                                              (load (index args (load j))))
                                    (store! j (+ (load j) 1)) 0)))
                            (let [
                                a (if (> argc 0) (al-get (load (field u call-args)) first) -1)
                                b (if (> argc 1) (al-get (load (field u call-args)) (+ first 1)) -1)
                                at (ms-emit! owner call-bid
                                     (mi-new MI-CALL fresh a b target node))]
                              (ms-add-call-args! at (if (= argc 0) -1 first) argc)
                              (store! vr fresh))) 0)))))))
          (ms-fail! MSEL-UNSUPPORTED node))
        (if (< (load vr) 0) -1
          (do (ms-vset! owner node (load vr)) (load vr)))))))

(defn ms-select-value! [(owner i64) (node i64)] (-> i64)
  (ms-select-value-at! owner node (ms-entry-block owner)))

(defn ms-phi-block [(owner i64) (phi i64)] (-> i64)
  (if (or (!= (n-op phi) OP-PHI) (= (n-in phi 0) NO-NODE)) -1
    (let [bid (al-get (load (field (machine-unit) ctrl-block)) (n-in phi 0))]
      (if (and (>= bid 0) (= (mu-block-owner bid) owner)) bid -1))))

; Reserve every scalar Phi destination before selecting any incoming expression.  This is the
; essential fixed point for loop-carried and mutually recursive Phis: a back-edge expression can
; refer to a destination whose copy has not been constructed yet without recursing forever.
(defn ms-preallocate-phis! [(owner i64)] (-> i64)
  (let [(mut node) 0]
    (loop
      (if (>= (load node) (n-count)) (break)
        (do
          (if (and (not (n-dead? (load node)))
                   (and (= (n-op (load node)) OP-PHI)
                        (>= (ms-phi-block owner (load node)) 0)))
              (if (ty-mem? (n-ty (load node)))
                  (ms-seen! owner (load node))
                (ms-vset! owner (load node) (ms-new-vreg!))) 0)
          (store! node (+ (load node) 1)) 0)))
    0))

(defn ms-build-edge-copies! [(owner i64)] (-> i64)
  (let [u (machine-unit) edges (mu-edge-count) (mut edge) 0]
    (loop
      (if (or (>= (load edge) edges) (!= (ms-result) MSEL-OK)) (break)
        (do
          (let [e (mu-edge (load edge))]
            (if (!= (load (field e owner)) owner) 0
              (let [first (al-len [MCopy] (load (field u edge-copies)))
                    target (load (field e target)) source (load (field e source))
                    slot (load (field e target-slot)) (mut node) 0]
                (loop
                  (if (or (>= (load node) (n-count)) (!= (ms-result) MSEL-OK)) (break)
                    (do
                      (if (and (not (n-dead? (load node)))
                               (and (= (n-op (load node)) OP-PHI)
                                    (= (ms-phi-block owner (load node)) target)))
                          (if (>= slot (n-nins (load node)))
                              (ms-fail! MSEL-DEPENDENCY (load node))
                            (if (ty-mem? (n-ty (load node)))
                                (if (ms-select-memory-at! owner (n-in (load node) slot) source)
                                    (al-push! [MCopy] (field u edge-copies)
                                      (mc-new (load edge) (load node) (load node)
                                              (n-in (load node) slot) MCOPY-MEMORY)) 0)
                              (let [src (ms-select-value-at! owner
                                          (n-in (load node) slot) source)]
                                (if (< src 0) 0
                                  (al-push! [MCopy] (field u edge-copies)
                                    (mc-new (load edge) (load node)
                                            (ms-vget owner (load node)) src MCOPY-VALUE)))))) 0)
                      (store! node (+ (load node) 1)) 0)))
                (store! (field e copy-first) first)
                (store! (field e copy-count)
                        (- (al-len [MCopy] (load (field u edge-copies))) first)))))
          (store! edge (+ (load edge) 1)) 0)))
    0))

(defn ms-work-dst-used-as-source? [(at i64)] (-> bool)
  (let [u (machine-unit) dst (al-get (load (field u copy-work-dst)) at)
        n (al-len [i64] (load (field u copy-work-live))) (mut i) 0 (mut used) false]
    (loop
      (if (or (>= (load i) n) (load used)) (break)
        (do
          (if (and (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                   (= (al-get (load (field u copy-work-src)) (load i)) dst))
              (store! used true) 0)
          (store! i (+ (load i) 1)) 0)))
    (load used)))

(defn ms-resolve-edge-copies! [(edge i64)] (-> i64)
  (let [u (machine-unit) e (mu-edge edge)
        first (al-len [MMove] (load (field u edge-moves)))
        copies (load (field e copy-count)) (mut i) 0 (mut remaining) 0]
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (loop
      (if (>= (load i) copies) (break)
        (do
          (let [c (mu-edge-copy edge (load i))]
            (if (or (!= (load (field c kind)) MCOPY-VALUE)
                    (= (load (field c dst)) (load (field c src)))) 0
              (do
                (al-push! [i64] (field u copy-work-dst) (load (field c dst)))
                (al-push! [i64] (field u copy-work-src) (load (field c src)))
                (al-push! [i64] (field u copy-work-live) 1)
                (store! remaining (+ (load remaining) 1)))))
          (store! i (+ (load i) 1)) 0)))
    (loop
      (if (<= (load remaining) 0) (break)
        (let [n (al-len [i64] (load (field u copy-work-live)))
              (mut ready) -1 (mut first-live) -1]
          (store! i 0)
          (loop
            (if (>= (load i) n) (break)
              (do
                (if (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                    (do
                      (if (< (load first-live) 0) (store! first-live (load i)) 0)
                      (if (not (ms-work-dst-used-as-source? (load i)))
                          (do (store! ready (load i)) (store! i n)) 0)) 0)
                (store! i (+ (load i) 1)) 0)))
          (if (>= (load ready) 0)
              (do
                (al-push! [MMove] (field u edge-moves)
                  (mm-new edge
                    (al-get (load (field u copy-work-dst)) (load ready))
                    (al-get (load (field u copy-work-src)) (load ready)) false))
                (al-set! [i64] (field u copy-work-live) (load ready) 0)
                (store! remaining (- (load remaining) 1)))
            ; No destination is dead: preserve one source in a fresh vreg, rewrite every use of
            ; that old source, and the cycle becomes an acyclic chain on the next iteration.
            (let [old-src (al-get (load (field u copy-work-src)) (load first-live))
                  temp (ms-new-vreg!)]
              (al-push! [MMove] (field u edge-moves) (mm-new edge temp old-src true))
              (store! i 0)
              (loop
                (if (>= (load i) n) (break)
                  (do
                    (if (and (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                             (= (al-get (load (field u copy-work-src)) (load i)) old-src))
                        (al-set! [i64] (field u copy-work-src) (load i) temp) 0)
                    (store! i (+ (load i) 1)) 0))))))))
    (store! (field e move-first) first)
    (store! (field e move-count) (- (al-len [MMove] (load (field u edge-moves))) first))
    0))

(defn ms-resolve-owner-copies! [(owner i64)] (-> i64)
  (let [(mut edge) 0]
    (loop
      (if (>= (load edge) (mu-edge-count)) (break)
        (do
          (if (= (load (field (mu-edge (load edge)) owner)) owner)
              (ms-resolve-edge-copies! (load edge)) 0)
          (store! edge (+ (load edge) 1)) 0)))
    0))

(defn ms-if-target [(bid i64) (arm i64)] (-> i64)
  (let [n (mu-block-succ-count bid) (mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) n) (>= (load found) 0)) (break)
        (do
          (let [target (mu-block-succ-target bid (load i)) ctrl (mu-block-control target)]
            (if (and (= (n-op ctrl) OP-CPROJ) (= (n-aux ctrl) arm))
                (store! found target) 0))
          (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn ms-preselect-function! [(owner i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner) (mut rpo) 0]
    (loop
      (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK)) (break)
        (do
          (let [bid (mu-function-block owner (load rpo)) term (mu-block-terminator bid)]
            (if (= term NO-NODE) 0
              (case (n-op term)
                OP-IF (ms-select-value-at! owner (n-in term 1) bid)
                OP-RETURN
                  (do
                    (if (> (n-nins term) 2)
                        (do (ms-select-memory! owner (n-in term 2)) 0) 0)
                    (ms-select-value-at! owner (n-in term 1) bid))
                (ms-fail! MSEL-TERMINATOR term))))
          (store! rpo (+ (load rpo) 1)) 0)))
    0))

(defn ms-emit-block-terminator! [(owner i64) (bid i64)] (-> i64)
  (let [term (mu-block-terminator bid)]
    (if (= (mu-block-succ-count bid) 1)
        (let [edge (mu-block-succ-edge bid 0) moves (mu-edge-move-count edge) (mut i) 0]
          (loop
            (if (>= (load i) moves) (break)
              (do
                (ms-emit! owner bid
                  (mi-new MI-COPY (mu-move-dst edge (load i))
                                  (mu-move-src edge (load i)) -1 edge
                                  NO-NODE))
                (store! i (+ (load i) 1)) 0)))) 0)
    (if (= term NO-NODE)
      (if (= (mu-block-succ-count bid) 1)
          (ms-emit! owner bid
                    (mi-new MI-JMP -1 -1 -1 (mu-block-succ-target bid 0)
                            (mu-block-control bid)))
        (ms-fail! MSEL-TERMINATOR bid))
      (case (n-op term)
        OP-IF
          (let [pred (ms-vget owner (n-in term 1))
                yes (ms-if-target bid 0) no (ms-if-target bid 1)]
            (if (or (< pred 0) (or (< yes 0) (< no 0)))
                (ms-fail! MSEL-TERMINATOR term)
              (ms-emit! owner bid (mi-new MI-CBR -1 pred yes no term))))
        OP-RETURN
          (let [value (ms-vget owner (n-in term 1))]
            (if (< value 0) (ms-fail! MSEL-DEPENDENCY term)
              (ms-emit! owner bid (mi-new MI-RET -1 value -1 0 term))))
        (ms-fail! MSEL-TERMINATOR term)))))

(defn ms-emit-function! [(owner i64) (base i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner) entry (ms-entry-block owner) (mut rpo) 0]
    (loop
      (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK)) (break)
        (do
          (let [bid (mu-function-block owner (load rpo)) b (mu-block bid)
                first (if (= bid entry) base (be-inst-count))]
            (store! (field b inst-first) first)
            (ms-emit-block-terminator! owner bid)
            (store! (field b inst-count) (- (be-inst-count) first)))
          (store! rpo (+ (load rpo) 1)) 0)))
    0))

(defn ms-pack-instructions! [] (-> i64)
  (let [u (machine-unit) original (be-inst-count) funcs (mu-function-count) (mut owner) 0]
    (al-clear! [MInst] (field u packed-insts))
    (loop
      (if (>= (load owner) funcs) (break)
        (do
          (let [nblocks (mu-function-block-count (load owner)) (mut rpo) 0]
            (loop
              (if (>= (load rpo) nblocks) (break)
                (do
                  (let [bid (mu-function-block (load owner) (load rpo))
                        b (mu-block bid) first (al-len [MInst] (load (field u packed-insts)))
                        (mut at) 0]
                    (loop
                      (if (>= (load at) original) (break)
                        (do
                          (let [m (be-inst (load at))]
                            (if (and (= (load (field m owner)) (load owner))
                                     (and (= (load (field m block-id)) bid)
                                          (not (mi-desc-terminator?
                                                 (mi-desc (load (field m op)))))))
                                (al-push! [MInst] (field u packed-insts) (load m)) 0))
                          (store! at (+ (load at) 1)) 0)))
                    ; Moving a definition must never put it textually after control transfer.
                    (store! at 0)
                    (loop
                      (if (>= (load at) original) (break)
                        (do
                          (let [m (be-inst (load at))]
                            (if (and (= (load (field m owner)) (load owner))
                                     (and (= (load (field m block-id)) bid)
                                          (mi-desc-terminator?
                                            (mi-desc (load (field m op))))))
                                (al-push! [MInst] (field u packed-insts) (load m)) 0))
                          (store! at (+ (load at) 1)) 0)))
                    (store! (field b inst-first) first)
                    (store! (field b inst-count)
                            (- (al-len [MInst] (load (field u packed-insts))) first)))
                  (store! rpo (+ (load rpo) 1)) 0))))
          (store! owner (+ (load owner) 1)) 0)))
    (al-clear! [MInst] (field (backend) ins))
    (let [n (al-len [MInst] (load (field u packed-insts))) (mut i) 0]
      (loop
        (if (>= (load i) n) (break)
          (do (al-push! [MInst] (field (backend) ins)
                        (al-get (load (field u packed-insts)) (load i)))
              (store! i (+ (load i) 1)) 0))))
    0))

(defn ms-vreg-def-block [(owner i64) (vreg i64)] (-> i64)
  (let [(mut node) 0 (mut phi-block) -1]
    ; Phi copies have several physical definitions. The SSA definition is the target block,
    ; independent of which incoming copy happens to be first in instruction order.
    (loop
      (if (or (>= (load node) (n-count)) (>= (load phi-block) 0)) (break)
        (do
          (if (and (not (n-dead? (load node)))
                   (and (= (n-op (load node)) OP-PHI)
                        (= (ms-vget owner (load node)) vreg)))
              (store! phi-block (ms-phi-block owner (load node))) 0)
          (store! node (+ (load node) 1)) 0)))
    (if (>= (load phi-block) 0) (load phi-block)
      (let [def (ms-def-inst vreg)]
        (if (>= def 0) (ms-inst-block def) -1)))))

(defn ms-gcm-deeper-bound [(current i64) (dependency i64)] (-> i64)
  (if (< dependency 0) current
    (if (mu-dominates? current dependency) dependency
      (if (mu-dominates? dependency current) current -1))))

(defn ms-gcm-input-bound [(owner i64) (current i64) (vreg i64)] (-> i64)
  (if (< vreg 0) current
    (ms-gcm-deeper-bound current (ms-vreg-def-block owner vreg))))

(defn ms-gcm-compute-earliest! [] (-> bool)
  (let [n (be-inst-count) (mut round) 0 (mut ok) true]
    ; A few forward fixed-point rounds also cover definitions emitted out of textual order.
    (loop
      (if (or (>= (load round) (+ n 1)) (not (load ok))) (break)
        (do
          (let [(mut at) 0]
            (loop
              (if (or (>= (load at) n) (not (load ok))) (break)
                (do
                  (let [m (be-inst (load at)) owner (load (field m owner))
                        desc (mi-desc (load (field m op))) bid (load (field m block-id))]
                    (if (mi-desc-pinned? desc)
                        (store! (field m earliest) bid)
                      (let [(mut bound) (ms-entry-block owner)
                            inputs (mi-desc-inputs desc)]
                        (if (> inputs 0)
                            (store! bound (ms-gcm-input-bound owner (load bound)
                                            (load (field m a)))) 0)
                        (if (and (>= (load bound) 0) (> inputs 1))
                            (store! bound (ms-gcm-input-bound owner (load bound)
                                            (load (field m b)))) 0)
                        (if (and (>= (load bound) 0) (= (load (field m op)) MI-CSEL))
                            (store! bound (ms-gcm-input-bound owner (load bound)
                                            (load (field m imm)))) 0)
                        (if (and (>= (load bound) 0) (= (load (field m op)) MI-CALL))
                            (let [(mut arg) 0]
                              (loop
                                (if (or (>= (load arg) (ms-inst-arg-count (load at)))
                                        (< (load bound) 0)) (break)
                                  (do
                                    (store! bound (ms-gcm-input-bound owner (load bound)
                                                    (ms-inst-arg (load at) (load arg))))
                                    (store! arg (+ (load arg) 1)) 0)))) 0)
                        (if (< (load bound) 0) (store! ok false)
                            (store! (field m earliest) (load bound))))))
                  (store! at (+ (load at) 1)) 0))))
          (store! round (+ (load round) 1)) 0)))
    (load ok)))

(defn ms-inst-uses-vreg? [(at i64) (vreg i64)] (-> bool)
  (let [m (be-inst at) desc (mi-desc (load (field m op)))
        inputs (mi-desc-inputs desc) (mut used) false]
    (if (and (> inputs 0) (= (load (field m a)) vreg)) (store! used true) 0)
    (if (and (> inputs 1) (= (load (field m b)) vreg)) (store! used true) 0)
    (if (and (= (load (field m op)) MI-CSEL) (= (load (field m imm)) vreg))
        (store! used true) 0)
    (if (= (load (field m op)) MI-CALL)
        (let [(mut arg) 0]
          (loop
            (if (or (>= (load arg) (ms-inst-arg-count at)) (load used)) (break)
              (do
                (if (= (ms-inst-arg at (load arg)) vreg) (store! used true) 0)
                (store! arg (+ (load arg) 1)) 0)))) 0)
    (load used)))

(defn ms-gcm-lca [(left i64) (right i64)] (-> i64)
  (if (< left 0) right (if (< right 0) left (mu-idom-intersect left right))))

(defn ms-gcm-latest-use-block [(owner i64) (vreg i64)] (-> i64)
  (let [(mut latest) -1 (mut at) 0 (mut edge) 0]
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do
          (if (and (= (ms-inst-owner (load at)) owner)
                   (ms-inst-uses-vreg? (load at) vreg))
              (store! latest (ms-gcm-lca (load latest) (ms-inst-block (load at)))) 0)
          (store! at (+ (load at) 1)) 0)))
    ; A Phi source is used on its incoming edge, hence in the predecessor block.
    (loop
      (if (>= (load edge) (mu-edge-count)) (break)
        (do
          (if (= (mu-block-owner (mu-edge-source (load edge))) owner)
              (let [(mut i) 0]
                (loop
                  (if (>= (load i) (mu-edge-copy-count (load edge))) (break)
                    (do
                      (if (and (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                               (= (mu-copy-src (load edge) (load i)) vreg))
                          (store! latest
                            (ms-gcm-lca (load latest) (mu-edge-source (load edge)))) 0)
                      (store! i (+ (load i) 1)) 0)))) 0)
          (store! edge (+ (load edge) 1)) 0)))
    (load latest)))

(defn ms-gcm-place! [] (-> bool)
  (if (not (ms-gcm-compute-earliest!)) false
    (let [(mut at) (be-inst-count) (mut ok) true]
      (loop
        (if (or (<= (load at) 0) (not (load ok))) (break)
          (do
            (store! at (- (load at) 1))
            (let [m (be-inst (load at)) desc (mi-desc (load (field m op)))
                  owner (load (field m owner)) original (load (field m block-id))
                  earliest (load (field m earliest))]
              (if (mi-desc-pinned? desc)
                  (store! (field m latest) original)
                (let [use-block (if (>= (load (field m dst)) 0)
                                      (ms-gcm-latest-use-block owner (load (field m dst))) -1)
                      latest (if (< use-block 0) earliest use-block)]
                  (store! (field m latest) latest)
                  (if (not (mu-dominates? earliest latest)) (store! ok false)
                    (let [(mut choice) latest (mut cursor) latest]
                      (loop
                        (if (= (load cursor) earliest) (break)
                          (do
                            (store! cursor (mu-block-idom (load cursor)))
                            (if (< (mu-block-loop-depth (load cursor))
                                   (mu-block-loop-depth (load choice)))
                                (store! choice (load cursor)) 0))))
                      (store! (field m block-id) (load choice))))))) 0)))
      (if (load ok) (do (ms-pack-instructions!) true) false))))

(defn ms-build-memory-anti-deps! [] (-> i64)
  (let [u (machine-unit) n (be-inst-count) (mut at) 0]
    (al-clear! [i64] (field u memory-anti-deps))
    (loop
      (if (>= (load at) n) (break)
        (do
          (let [m (be-inst (load at)) first (al-len [i64] (load (field u memory-anti-deps)))]
            (store! (field m anti-first) first)
            (store! (field m anti-count) 0)
            (if (= (load (field m op)) MI-STORE)
                (let [(mut prior) 0]
                  (loop
                    (if (>= (load prior) n) (break)
                      (do
                        (let [candidate (be-inst (load prior))]
                          (if (and (= (load (field candidate owner)) (load (field m owner)))
                                   (and (= (load (field candidate op)) MI-LOAD)
                                        (and (< (load (field candidate node)) (load (field m node)))
                                             (mu-dominates? (load (field candidate block-id))
                                                            (load (field m block-id))))))
                              (do
                                (al-push! [i64] (field u memory-anti-deps)
                                          (load (field candidate node)))
                                (store! (field m anti-count)
                                        (+ (load (field m anti-count)) 1))) 0))
                        (store! prior (+ (load prior) 1)) 0)))) 0))
          (store! at (+ (load at) 1)) 0)))
    0))

(defn ms-select-built-core! [] (-> bool)
  (be-reset!)
  (let [u (machine-unit) funcs (mu-function-count) (mut owner) 0]
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (store! (field u next-vreg) 0)
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u call-args))
    (ms-map-init!)
    (loop
      (if (>= (load owner) funcs) (break)
        (do (ms-preallocate-phis! (load owner))
            (store! owner (+ (load owner) 1)) 0)))
    (store! owner 0)
    (loop
      (if (or (>= (load owner) funcs) (!= (ms-result) MSEL-OK)) (break)
        (do
          (let [base (be-inst-count)]
            (ms-build-edge-copies! (load owner))
            (ms-resolve-owner-copies! (load owner))
            (ms-preselect-function! (load owner))
            (ms-emit-function! (load owner) base))
          (store! owner (+ (load owner) 1)) 0)))
    (if (= (ms-result) MSEL-OK)
        (do (ms-pack-instructions!) (ms-build-memory-anti-deps!) true)
      false)))

(defn ms-place-selected! [] (-> bool)
  (let [u (machine-unit)]
    (if (ms-gcm-place!)
        (do
          (store! (field u phase) 2)
          ; Usually GCM's stable packing is already dependency-topological, and retaining
          ; it keeps selection dumps stable. If a cross-block move put a producer after its use,
          ; repair only that case with the dependency-aware seed-0 scheduler.
          (if (ms-verify!) true
            (if (= (ms-result) MSEL-DEPENDENCY)
                (if (ms-local-schedule! 0) (ms-verify!) false)
              false)))
      false)))

(defn ms-select-built! [] (-> bool)
  (if (ms-select-built-core!) (ms-place-selected!) false))

(defn ms-select! [] (-> bool)
  (if (mu-build!) (ms-select-built!) false))
(defn ms-select-program! [] (-> bool)
  (if (mu-build-program!) (ms-select-built!) false))
(defn ms-select-entry! [(entry-fun i64)] (-> bool)
  (if (mu-build-entry! entry-fun) (ms-select-built!) false))

; Convert verified block terminators to the legacy encodable label/branch vocabulary.  This is a
; separate publication step so the block verifier continues to reason about explicit successors.
(defn ms-lowered-inst [(owner i64) (bid i64) (op i64) (dst i64)
                       (a i64) (b i64) (imm i64) (node i64)] (-> MInst)
  (let [p (stack MInst)]
    (store! p (mi-new op dst a b imm node))
    (store! (field p owner) owner) (store! (field p block-id) bid) (load p)))

(defn ms-lower-encodable! [] (-> bool)
  (if (not (ms-verify!)) false
    (let [u (machine-unit) blocks (mu-block-count) (mut bid) 0]
      (al-clear! [MInst] (field u packed-insts))
      (loop
        (if (>= (load bid) blocks) (break)
          (do
            (let [b (mu-block (load bid)) owner (load (field b owner))
                  first (load (field b inst-first)) count (load (field b inst-count))
                  scheduled-first (al-len [MInst] (load (field u packed-insts))) (mut i) 0]
              (store! (field b inst-first) scheduled-first)
              (al-push! [MInst] (field u packed-insts)
                (ms-lowered-inst owner (load bid) MI-LABEL -1 -1 -1 (load bid) NO-NODE))
              (loop
                (if (>= (load i) count) (break)
                  (do
                    (let [m (be-inst (+ first (load i))) op (load (field m op))]
                      (case op
                        MI-CBR
                          (do
                            (al-push! [MInst] (field u packed-insts)
                              (ms-lowered-inst owner (load bid) MI-CBZ -1
                                (load (field m a)) -1 (load (field m imm))
                                (load (field m node))))
                            (al-push! [MInst] (field u packed-insts)
                              (ms-lowered-inst owner (load bid) MI-B -1 -1 -1
                                (load (field m b)) (load (field m node)))) 0)
                        MI-JMP
                          (al-push! [MInst] (field u packed-insts)
                            (ms-lowered-inst owner (load bid) MI-B -1 -1 -1
                              (load (field m imm)) (load (field m node))))
                        (al-push! [MInst] (field u packed-insts) (load m))))
                    (store! i (+ (load i) 1)) 0)))
              (store! (field b inst-count)
                      (- (al-len [MInst] (load (field u packed-insts))) scheduled-first)))
            (store! bid (+ (load bid) 1)) 0)))
      (al-clear! [MInst] (field (backend) ins))
      (let [n (al-len [MInst] (load (field u packed-insts))) (mut i) 0 (mut ok) true]
        (loop
          (if (>= (load i) n) (break)
            (do
              (let [m (al-get (load (field u packed-insts)) (load i)) p (stack MInst)]
                (store! p m)
                (if (not (mi-desc-encodable? (mi-desc (load (field p op)))))
                    (store! ok false) 0)
                (al-push! [MInst] (field (backend) ins) m))
              (store! i (+ (load i) 1)) 0)))
        (load ok)))))

(defn be-select-machine-program! [] (-> bool)
  (if (not (ms-select-program!))
      (let [code (case (ms-result)
                   MSEL-CALL-LIVE BER-UNSUPPORTED-CALL-LIVE
                   MSEL-CALL BER-UNSUPPORTED-CALL
                   MSEL-UNSUPPORTED BER-UNSUPPORTED-OPCODE
                   BER-MALFORMED-GRAPH)
            item (ms-result-item)
            node (if (and (>= item 0) (< item (be-inst-count)))
                     (ms-inst-node item) item)]
        (be-fail! code node))
    (if (ms-lower-encodable!) true (be-fail! BER-ENCODING NO-NODE))))

(defn ms-inst-owner [(i i64)] (-> i64) (load (field (be-inst i) owner)))
(defn ms-inst-block [(i i64)] (-> i64) (load (field (be-inst i) block-id)))
(defn ms-inst-op [(i i64)] (-> i64) (load (field (be-inst i) op)))
(defn ms-inst-dst [(i i64)] (-> i64) (load (field (be-inst i) dst)))
(defn ms-inst-a [(i i64)] (-> i64) (load (field (be-inst i) a)))
(defn ms-inst-earliest [(i i64)] (-> i64) (load (field (be-inst i) earliest)))
(defn ms-inst-latest [(i i64)] (-> i64) (load (field (be-inst i) latest)))
(defn ms-inst-node [(i i64)] (-> i64) (load (field (be-inst i) node)))
(defn ms-inst-memory-dep-count [(i i64)] (-> i64)
  (load (field (be-inst i) mem-count)))
(defn ms-inst-memory-anti-count [(i i64)] (-> i64)
  (load (field (be-inst i) anti-count)))
(defn ms-inst-memory-anti-node [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (load (field (machine-unit) memory-anti-deps))
            (+ (load (field m anti-first)) which))))
(defn ms-inst-arg-count [(i i64)] (-> i64) (load (field (be-inst i) arg-count)))
(defn ms-inst-arg [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (load (field (machine-unit) call-args))
            (+ (load (field m arg-first)) which))))

(defn ms-def-inst [(vreg i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) n) (>= (load found) 0)) (break)
        (do (if (= (load (field (be-inst (load i)) dst)) vreg)
                (store! found (load i)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn ms-phi-vreg? [(owner i64) (vreg i64)] (-> bool)
  (let [(mut node) 0 (mut found) false]
    (loop
      (if (or (>= (load node) (n-count)) (load found)) (break)
        (do
          (if (and (not (n-dead? (load node)))
                   (and (= (n-op (load node)) OP-PHI)
                        (and (not (ty-mem? (n-ty (load node))))
                             (= (ms-vget owner (load node)) vreg))))
              (store! found true) 0)
          (store! node (+ (load node) 1)) 0)))
    (load found)))

(defn ms-block-dominates? [(def-bid i64) (use-bid i64)] (-> bool)
  (mu-dominates? def-bid use-bid))

(defn ms-input-valid? [(at i64) (vreg i64)] (-> bool)
  (if (< vreg 0) true
    (if (ms-phi-vreg? (load (field (be-inst at) owner)) vreg) true
      (let [def (ms-def-inst vreg)]
      (if (< def 0) (ms-phi-vreg? (load (field (be-inst at) owner)) vreg)
        (if (>= def at) false
        (let [use (be-inst at) producer (be-inst def)
              owner (load (field use owner)) bid (load (field use block-id))
              def-owner (load (field producer owner)) def-bid (load (field producer block-id))]
          (and (= owner def-owner)
               (or (= def-bid (ms-entry-block owner))
                   (or (= def-bid bid) (ms-block-dominates? def-bid bid)))))))))))

(defn ms-node-inst-before [(owner i64) (node i64) (at i64)] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop
      (if (or (>= (load i) at) (>= (load found) 0)) (break)
        (do
          (let [m (be-inst (load i))]
            (if (and (= (load (field m owner)) owner) (= (load (field m node)) node))
                (store! found (load i)) 0))
          (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn ms-memory-node-before? [(owner i64) (node i64) (at i64)] (-> bool)
  (case (n-op node)
    OP-ARG true OP-PARM true
    OP-PROJ
      (if (= (n-op (n-in node 0)) OP-NEW)
          (>= (ms-node-inst-before owner (n-in node 0) at) 0) true)
    OP-STORE (>= (ms-node-inst-before owner node at) 0)
    OP-NEW (>= (ms-node-inst-before owner node at) 0)
    OP-MEMMERGE
      (let [len (n-nins node) (mut i) 1 (mut ok) true]
        (loop
          (if (or (>= (load i) len) (not (load ok))) (break)
            (do (if (not (ms-memory-node-before? owner (n-in node (load i)) at))
                    (store! ok false) 0)
                (store! i (+ (load i) 1)) 0)))
        (load ok))
    OP-PHI (and (ty-mem? (n-ty node)) (>= (ms-phi-block owner node) 0))
    false))

(defn ms-memory-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit) m (be-inst at) owner (load (field m owner))
        first (load (field m mem-first)) count (load (field m mem-count))
        (mut i) 0 (mut ok) true]
    (if (= count 0) true
      (if (or (< first 0)
              (> (+ first count) (al-len [i64] (load (field u selection-memory-deps))))) false
        (do
          (loop
            (if (or (>= (load i) count) (not (load ok))) (break)
              (do
                (if (not (ms-memory-node-before?
                           owner
                           (al-get (load (field u selection-memory-deps)) (+ first (load i)))
                           at))
                    (store! ok false) 0)
                (store! i (+ (load i) 1)) 0)))
          (load ok))))))

(defn ms-memory-anti-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit) m (be-inst at) first (load (field m anti-first))
        count (load (field m anti-count)) total (al-len [i64] (load (field u memory-anti-deps)))
        (mut prior) 0 (mut seen) 0 (mut ok) true]
    (if (= count 0) true
      (if (or (< first 0) (or (< count 0) (> (+ first count) total))) false
      (do
        (loop
          (if (or (>= (load prior) (be-inst-count)) (not (load ok))) (break)
            (do
              (let [candidate (be-inst (load prior))]
                (if (and (= (load (field m op)) MI-STORE)
                         (and (= (load (field candidate owner)) (load (field m owner)))
                              (and (= (load (field candidate op)) MI-LOAD)
                                   (and (< (load (field candidate node)) (load (field m node)))
                                        (mu-dominates? (load (field candidate block-id))
                                                       (load (field m block-id)))))))
                    (do
                      (if (or (>= (load seen) count)
                              (!= (al-get (load (field u memory-anti-deps))
                                          (+ first (load seen)))
                                  (load (field candidate node))))
                          (store! ok false) 0)
                      (store! seen (+ (load seen) 1))) 0))
              (store! prior (+ (load prior) 1)) 0)))
        (and (load ok) (= (load seen) count)))))))

(defn ms-inst-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) op (load (field m op)) a (load (field m a)) b (load (field m b))]
    (case op
      MI-MOVI true MI-ARG true MI-JMP true
      MI-STACKARG true
      MI-ABI-COPY (ms-input-valid? at a)
      MI-NEW true
      MI-LOAD (ms-input-valid? at a)
      MI-STORE (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-NEG (ms-input-valid? at a)
      MI-RET (ms-input-valid? at a)
      MI-CBR (ms-input-valid? at a)
      MI-ADD (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-SUB (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-MUL (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-SDIV (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-EQ (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-LT (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-LE (and (ms-input-valid? at a) (ms-input-valid? at b))
      MI-COPY (ms-input-valid? at a)
      MI-CALL
        (let [count (ms-inst-arg-count at) (mut i) 0 (mut ok) true]
          (loop
            (if (or (>= (load i) count) (not (load ok))) (break)
              (do (if (not (ms-input-valid? at (ms-inst-arg at (load i))))
                      (store! ok false) 0)
                  (store! i (+ (load i) 1)) 0)))
          (load ok))
      false)))

(defn ms-call-target-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) owner (load (field m owner)) target (load (field m imm))
        node (load (field m node))]
    (and (>= target 0)
      (and (< target (mu-function-count))
        (= (mu-function-ideal target) (mu-direct-callee node))))))

(defn ms-call-args-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) first (load (field m arg-first)) count (load (field m arg-count))
        total (al-len [i64] (load (field (machine-unit) call-args)))]
    (and (>= count 0)
      (and (<= count 16)
        (and (if (= count 0) (= first -1) (>= first 0))
          (or (= count 0) (<= (+ first count) total)))))))

(defn ms-vreg-used-after? [(owner i64) (vreg i64) (at i64)] (-> bool)
  (let [n (be-inst-count) (mut i) (+ at 1) (mut used) false]
    (loop
      (if (or (>= (load i) n) (load used)) (break)
        (do
          (let [m (be-inst (load i))]
            (if (and (= (load (field m owner)) owner)
                     (or (= (load (field m a)) vreg) (= (load (field m b)) vreg)))
                (store! used true) 0))
          (store! i (+ (load i) 1)) 0)))
    (load used)))

(defn ms-call-live-valid? [(at i64)] (-> bool)
  (let [call (be-inst at) owner (load (field call owner)) (mut i) 0 (mut ok) true]
    (loop
      (if (or (>= (load i) at) (not (load ok))) (break)
        (do
          (let [m (be-inst (load i)) dst (load (field m dst))]
            (if (and (= (load (field m owner)) owner)
                     (and (>= dst 0) (ms-vreg-used-after? owner dst at)))
                (store! ok false) 0))
          (store! i (+ (load i) 1)) 0)))
    (load ok)))

(defn ms-block-range-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid) count (mu-block-inst-count bid)
        len (be-inst-count) owner (mu-block-owner bid) (mut i) 0]
    (if (or (< first 0) (or (<= count 0) (> (+ first count) len))) false
      (let [(mut ok) true]
        (loop
          (if (or (>= (load i) count) (not (load ok))) (break)
            (do
              (let [m (be-inst (+ first (load i)))]
                (if (or (!= (load (field m owner)) owner)
                        (!= (load (field m block-id)) bid))
                    (store! ok false) 0))
              (store! i (+ (load i) 1)) 0)))
        (load ok)))))

(defn ms-block-terminator-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid) count (mu-block-inst-count bid)
        term (mu-block-terminator bid) succ (mu-block-succ-count bid)
        (mut i) 0 (mut terms) 0 (mut last-op) -1]
    (loop
      (if (>= (load i) count) (break)
        (do
          (let [op (ms-inst-op (+ first (load i)))]
            (if (mi-desc-terminator? (mi-desc op))
                (do (store! terms (+ (load terms) 1)) (store! last-op op)) 0))
          (store! i (+ (load i) 1)) 0)))
    (and (= (load terms) 1)
      (and (mi-desc-terminator? (mi-desc (ms-inst-op (- (+ first count) 1))))
        (if (= term NO-NODE)
            (and (= succ 1) (= (load last-op) MI-JMP))
          (case (n-op term)
            OP-IF (and (= succ 2) (= (load last-op) MI-CBR))
            OP-RETURN (and (= succ 0) (= (load last-op) MI-RET))
            false))))))

(defn ms-definition-unique? [(at i64)] (-> bool)
  (let [m (be-inst at) dst (load (field m dst)) owner (load (field m owner))
        node (load (field m node)) (mut i) 0]
    (if (or (< dst 0) (= (load (field m op)) MI-COPY)) true
      (let [(mut defs) 0 (mut nodes) 0]
        (loop
          (if (>= (load i) (be-inst-count)) (break)
            (do
              (let [other (be-inst (load i))]
                (if (= (load (field other dst)) dst) (store! defs (+ (load defs) 1)) 0)
                (if (and (= (load (field other owner)) owner)
                         (and (= (load (field other node)) node)
                              (>= (load (field other dst)) 0)))
                    (store! nodes (+ (load nodes) 1)) 0))
              (store! i (+ (load i) 1)) 0)))
        (and (= (load defs) 1) (if (< node 0) true (= (load nodes) 1)))))))

(defn ms-inst-membership-count [(at i64)] (-> i64)
  (let [blocks (mu-block-count) (mut bid) 0 (mut count) 0]
    (loop
      (if (>= (load bid) blocks) (break)
        (do
          (let [first (mu-block-inst-first (load bid)) n (mu-block-inst-count (load bid))]
            (if (and (>= at first) (< at (+ first n)))
                (store! count (+ (load count) 1)) 0))
          (store! bid (+ (load bid) 1)) 0)))
    (load count)))

(defn ms-memory-source-on-edge? [(owner i64) (node i64) (bid i64)] (-> bool)
  (let [(mut edge) 0 (mut found) false]
    (loop
      (if (or (>= (load edge) (mu-edge-count)) (load found)) (break)
        (do
          (if (and (= (load (field (mu-edge (load edge)) owner)) owner)
                   (= (mu-edge-source (load edge)) bid))
              (let [n (mu-edge-copy-count (load edge)) (mut i) 0]
                (loop
                  (if (or (>= (load i) n) (load found)) (break)
                    (do
                      (if (and (= (mu-copy-kind (load edge) (load i)) MCOPY-MEMORY)
                               (= (mu-copy-src (load edge) (load i)) node))
                          (store! found true) 0)
                      (store! i (+ (load i) 1)) 0)))) 0)
          (store! edge (+ (load edge) 1)) 0)))
    (load found)))

(defn ms-inst-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) op (load (field m op)) owner (load (field m owner))
        bid (load (field m block-id)) node (load (field m node))]
    (case op
      MI-ARG (= bid (ms-entry-block owner))
      MI-STACKARG (= bid (ms-entry-block owner))
      MI-NEW (= bid (ms-node-block owner node))
      MI-LOAD (= bid (ms-memory-block owner node))
      MI-STORE (or (= bid (ms-memory-block owner node))
                   (ms-memory-source-on-edge? owner node bid))
      MI-COPY (= (mu-edge-source (load (field m imm))) bid)
      MI-CALL (= bid (ms-node-block owner node))
      true)))

(defn ms-gcm-input-earliest-valid? [(owner i64) (earliest i64) (vreg i64)] (-> bool)
  (if (< vreg 0) true
    (let [def (ms-def-inst vreg)
          dependency (if (ms-phi-vreg? owner vreg) (ms-vreg-def-block owner vreg)
                         (if (>= def 0) (ms-inst-earliest def) -1))]
      (and (>= dependency 0) (mu-dominates? dependency earliest)))))

(defn ms-gcm-earliest-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) owner (load (field m owner)) earliest (load (field m earliest))
        desc (mi-desc (load (field m op))) inputs (mi-desc-inputs desc) (mut ok) true]
    (if (> inputs 0)
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m a)))) 0)
    (if (and (load ok) (> inputs 1))
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m b)))) 0)
    (if (and (load ok) (= (load (field m op)) MI-CSEL))
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m imm)))) 0)
    (if (and (load ok) (= (load (field m op)) MI-CALL))
        (let [(mut arg) 0]
          (loop
            (if (or (>= (load arg) (ms-inst-arg-count at)) (not (load ok))) (break)
              (do
                (store! ok (ms-gcm-input-earliest-valid?
                             owner earliest (ms-inst-arg at (load arg))))
                (store! arg (+ (load arg) 1)) 0)))) 0)
    (load ok)))

(defn ms-gcm-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at) owner (load (field m owner)) bid (load (field m block-id))
        earliest (load (field m earliest)) latest (load (field m latest))
        desc (mi-desc (load (field m op)))]
    (if (or (< earliest 0) (or (< latest 0)
            (or (!= (mu-block-owner earliest) owner)
                (!= (mu-block-owner latest) owner)))) false
      (if (mi-desc-pinned? desc) (and (= bid earliest) (= bid latest))
        (let [actual-latest (if (>= (load (field m dst)) 0)
                                  (ms-gcm-latest-use-block owner (load (field m dst))) -1)
              expected-latest (if (< actual-latest 0) earliest actual-latest)]
        (if (or (!= latest expected-latest)
                (or (not (ms-gcm-earliest-dependencies-valid? at))
                    (or (not (mu-dominates? earliest bid))
                        (not (mu-dominates? bid latest))))) false
          (let [(mut expected) latest (mut cursor) latest]
            (loop
              (if (= (load cursor) earliest) (break)
                (do
                  (store! cursor (mu-block-idom (load cursor)))
                  (if (< (mu-block-loop-depth (load cursor))
                         (mu-block-loop-depth (load expected)))
                      (store! expected (load cursor)) 0))))
            (= bid (load expected)))))))))

(defn ms-edge-copies-valid? [(edge i64)] (-> bool)
  (let [u (machine-unit) e (mu-edge edge) first (load (field e copy-first))
        count (load (field e copy-count)) slot (load (field e target-slot))
        target (load (field e target)) owner (load (field e owner))
        total (al-len [MCopy] (load (field u edge-copies)))
        (mut i) 0 (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) total))) false
      (do
        (loop
          (if (or (>= (load i) count) (not (load ok))) (break)
            (do
              (let [c (mu-edge-copy edge (load i)) phi (load (field c phi))
                    kind (load (field c kind))]
                (if (or (!= (load (field c edge)) edge)
                        (or (= phi NO-NODE)
                            (or (!= (n-op phi) OP-PHI)
                                (or (!= (ms-phi-block owner phi) target)
                                    (>= slot (n-nins phi))))))
                    (store! ok false)
                  (if (ty-mem? (n-ty phi))
                      (if (or (!= kind MCOPY-MEMORY)
                              (or (!= (load (field c dst)) phi)
                                  (or (!= (load (field c src)) (n-in phi slot))
                                      (not (ms-memory-node-before?
                                             owner (load (field c src))
                                             (+ (mu-block-inst-first (load (field e source)))
                                                (mu-block-inst-count (load (field e source)))))))))
                          (store! ok false) 0)
                    (if (or (!= kind MCOPY-VALUE)
                            (or (!= (load (field c dst)) (ms-vget owner phi))
                                (!= (load (field c src))
                                    (ms-vget owner (n-in phi slot)))))
                        (store! ok false) 0))))
              (store! i (+ (load i) 1)) 0)))
        ; Every live Phi attached to the target has exactly one record on this edge.
        (let [(mut node) 0]
          (loop
            (if (or (>= (load node) (n-count)) (not (load ok))) (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (= (n-op (load node)) OP-PHI)
                              (= (ms-phi-block owner (load node)) target)))
                    (let [(mut j) 0 (mut matches) 0]
                      (loop
                        (if (>= (load j) count) (break)
                          (do
                            (if (= (load (field (mu-edge-copy edge (load j)) phi)) (load node))
                                (store! matches (+ (load matches) 1)) 0)
                            (store! j (+ (load j) 1)) 0)))
                      (if (!= (load matches) 1) (store! ok false) 0)) 0)
                (store! node (+ (load node) 1)) 0))))
        (load ok)))))

(defn ms-verify! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count) len (be-inst-count)
        (mut bid) 0 (mut edge) 0 (mut at) 0]
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (loop
      (if (or (>= (load bid) blocks) (!= (ms-result) MSEL-OK)) (break)
        (do
          (if (not (ms-block-range-valid? (load bid)))
              (ms-fail! MSEL-OWNER (load bid))
            (if (not (ms-block-terminator-valid? (load bid)))
                (ms-fail! MSEL-TERMINATOR (load bid)) 0))
          (store! bid (+ (load bid) 1)) 0)))
    (loop
      (if (or (>= (load edge) edges) (!= (ms-result) MSEL-OK)) (break)
        (do
          (if (not (ms-edge-copies-valid? (load edge)))
              (ms-fail! MSEL-PHI (load edge)) 0)
          (store! edge (+ (load edge) 1)) 0)))
    (loop
      (if (or (>= (load at) len) (!= (ms-result) MSEL-OK)) (break)
        (do
          (let [op (ms-inst-op (load at)) desc (mi-desc op)]
            (if (or (!= (ms-inst-membership-count (load at)) 1)
                    (not (ms-inst-placement-valid? (load at))))
                (ms-fail! MSEL-OWNER (load at))
              (do
                (if (not (ms-gcm-placement-valid? (load at)))
                    (ms-fail! MSEL-PLACEMENT (load at)) 0)
                (if (and (= (ms-result) MSEL-OK)
                         (not (ms-memory-anti-dependencies-valid? (load at))))
                    (ms-fail! MSEL-MEMORY-ORDER (load at)) 0)
                (if (and (= op MI-CALL) (not (ms-call-target-valid? (load at))))
                    (ms-fail! MSEL-CALL (load at)) 0)
                (if (and (= (ms-result) MSEL-OK)
                         (and (= op MI-CALL) (not (ms-call-args-valid? (load at)))))
                    (ms-fail! MSEL-CALL (load at)) 0)
                (if (!= (ms-result) MSEL-OK) 0
                  (if (< (mi-desc-inputs desc) 0) (ms-fail! MSEL-UNSUPPORTED (load at))
                    (if (or (not (ms-inst-dependencies-valid? (load at)))
                            (not (ms-memory-dependencies-valid? (load at))))
                        (ms-fail! MSEL-DEPENDENCY (load at))
                      (if (not (ms-definition-unique? (load at)))
                          (ms-fail! MSEL-DUPLICATE (load at)) 0)))))))
          (store! at (+ (load at) 1)) 0)))
    (= (ms-result) MSEL-OK)))

(defn ms-corrupt-owner! [(at i64) (owner i64)] (-> i64)
  (store! (field (be-inst at) owner) owner) 0)
(defn ms-corrupt-input! [(at i64) (vreg i64)] (-> i64)
  (store! (field (be-inst at) a) vreg) 0)
(defn ms-corrupt-memory-dep! [(at i64) (node i64)] (-> i64)
  (let [u (machine-unit) m (be-inst at) first (load (field m mem-first))]
    (if (< first 0) 0 (al-set! [i64] (field u selection-memory-deps) first node)) 0))
(defn ms-corrupt-placement! [(at i64) (bid i64)] (-> i64)
  (store! (field (be-inst at) block-id) bid)
  (ms-pack-instructions!) 0)
(defn ms-corrupt-earliest! [(at i64) (bid i64)] (-> i64)
  (store! (field (be-inst at) earliest) bid) 0)
(defn ms-corrupt-memory-anti-dep! [(at i64) (node i64)] (-> i64)
  (let [m (be-inst at) first (load (field m anti-first))]
    (if (> (load (field m anti-count)) 0)
        (al-set! [i64] (field (machine-unit) memory-anti-deps) first node) 0) 0))
(defn ms-corrupt-duplicate-terminator! [(bid i64)] (-> i64)
  (let [b (mu-block bid) last (+ (load (field b inst-first)) (- (load (field b inst-count)) 1))
        copy (load (be-inst last))]
    (ms-emit! (mu-block-owner bid) bid copy)
    (store! (field b inst-count) (+ (load (field b inst-count)) 1)) 0))
(defn ms-corrupt-copy-source! [(edge i64) (which i64) (src i64)] (-> i64)
  (store! (field (mu-edge-copy edge which) src) src) 0)
(defn ms-corrupt-copy-phi! [(edge i64) (which i64) (phi i64)] (-> i64)
  (store! (field (mu-edge-copy edge which) phi) phi) 0)
(defn ms-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (store! (field (be-inst at) imm) target) 0)
(defn ms-corrupt-call-arg! [(at i64) (which i64) (vreg i64)] (-> i64)
  (let [m (be-inst at) first (load (field m arg-first))]
    (if (or (< which 0) (>= which (load (field m arg-count)))) 0
      (al-set! [i64] (field (machine-unit) call-args) (+ first which) vreg)) 0))

(defn mi-op-name [(op i64)] (-> (slice u8))
  (case op
    MI-MOVI "MOVI" MI-ADD "ADD" MI-SUB "SUB" MI-MUL "MUL" MI-SDIV "SDIV"
    MI-NEG "NEG" MI-RET "RET" MI-ARG "ARG" MI-EQ "EQ" MI-LT "LT" MI-LE "LE"
    MI-LABEL "LABEL" MI-CBZ "CBZ" MI-CSEL "CSEL" MI-MOV "MOV" MI-B "B"
    MI-NEW "NEW" MI-LOAD "LOAD" MI-STORE "STORE" MI-CBR "CBR" MI-JMP "JMP"
    MI-COPY "COPY" MI-CALL "CALL" MI-ABI-COPY "ABI-COPY" "?"))

(defn ms-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count) (mut owner) 0]
    (loop
      (if (>= (load owner) funcs) (break)
        (do
          (fmt w "function {d}\n" (load owner))
          (let [nblocks (mu-function-block-count (load owner)) (mut rpo) 0]
            (loop
              (if (>= (load rpo) nblocks) (break)
                (do
                  (let [bid (mu-function-block (load owner) (load rpo))
                        first (mu-block-inst-first bid) n (mu-block-inst-count bid) (mut i) 0]
                    (fmt w "  b{d}:" (load rpo))
                    (loop
                      (if (>= (load i) n) (break)
                        (do (ps w " ") (ps w (mi-op-name (ms-inst-op (+ first (load i)))))
                            (store! i (+ (load i) 1)) 0)))
                    (ps w "\n"))
                  (store! rpo (+ (load rpo) 1)) 0))))
          (store! owner (+ (load owner) 1)) 0)))
    0))

(defn ms-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf) w (stack Writer)]
    (store! (field fb data) buf) (store! (field fb cap) cap) (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (ms-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "ms-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn be-stackmap-count [] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut count) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (if (= (load (field (be-inst (load i)) op)) MI-NEW)
                (store! count (+ (load count) 1)) 0)
            (store! i (+ (load i) 1)) 0)))
    (load count)))

(defn be-stackmap-pc [(which i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut seen) 0 (mut pc) -1]
    (loop
      (if (or (>= (load i) n) (>= (load pc) 0)) (break)
        (do (if (= (load (field (be-inst (load i)) op)) MI-NEW)
                (if (= (load seen) which) (store! pc (load (field (be-inst (load i)) first)))
                  (store! seen (+ (load seen) 1))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load pc)))

(defn be-stackmap-live-count [(which i64)] (-> i64)
  (let [pc (be-stackmap-pc which) n (be-inst-count) (mut i) 0 (mut count) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (let [m (be-inst (load i))]
              (if (and (>= (load (field m dst)) 0)
                       (and (<= (load (field m first)) pc) (>= (load (field m last)) pc)))
                  (store! count (+ (load count) 1)) 0))
            (store! i (+ (load i) 1)) 0)))
    (load count)))

; ---------------------------------------------------------------------------
; G6 CFG liveness over the final scheduled machine code.
; ---------------------------------------------------------------------------

(defn ml-vreg-count [] (-> i64) (load (field (machine-unit) next-vreg)))
(defn ml-index [(bid i64) (vreg i64)] (-> i64) (+ (* bid (ml-vreg-count)) vreg))
(defn ml-edge-index [(edge i64) (vreg i64)] (-> i64) (+ (* edge (ml-vreg-count)) vreg))
(defn ml-use? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-use)) (ml-index bid vreg)) 0))
(defn ml-def? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-def)) (ml-index bid vreg)) 0))
(defn ml-live-in? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-in)) (ml-index bid vreg)) 0))
(defn ml-live-out? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-out)) (ml-index bid vreg)) 0))
(defn ml-edge-live? [(edge i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) edge-live)) (ml-edge-index edge vreg)) 0))
(defn ml-value-kind [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) value-kind)) vreg))
(defn ml-result [] (-> i64) (load (field (machine-unit) liveness-result)))
(defn ml-result-item [] (-> i64) (load (field (machine-unit) liveness-item)))
(defn ml-seed [] (-> i64) (load (field (machine-unit) liveness-seed)))
(defn ml-rounds [] (-> i64) (load (field (machine-unit) liveness-rounds)))

(defn ml-kind-for-type [(t i64)] (-> i64)
  (let [kinds (ty-kinds t) nonmoving (| VK-STR (| VK-SYM (| VK-BIG VK-FUN)))]
    (if (ty-only-obj? t) MLK-RAW-MANAGED
      (if (and (!= kinds 0) (= (& kinds (bits-dual nonmoving VK-MASK)) 0))
          MLK-NONMOVING
        (if (!= (& kinds VK-OBJ) 0) MLK-BOXED MLK-SCALAR)))))

(defn ml-kind-for-vreg [(vreg i64)] (-> i64)
  (let [funcs (mu-function-count) (mut owner) 0 (mut found) MLK-SCALAR (mut done) false]
    (loop
      (if (or (>= (load owner) funcs) (load done)) (break)
        (do
          (let [(mut node) 0]
            (loop
              (if (or (>= (load node) (n-count)) (load done)) (break)
                (do
                  (if (and (not (n-dead? (load node)))
                           (= (ms-vget (load owner) (load node)) vreg))
                      (do (store! found (ml-kind-for-type (n-ty (load node))))
                          (store! done true)) 0)
                  (store! node (+ (load node) 1)) 0))))
          (store! owner (+ (load owner) 1)) 0)))
    (load found)))

(defn ml-kind-for-inst [(at i64)] (-> i64)
  (let [m (be-inst at) op (load (field m op)) node (load (field m node))
        dst (load (field m dst))]
    (if (= op MI-NEW) MLK-RAW-MANAGED
      (if (and (or (= op MI-COPY) (= op MI-ABI-COPY)) (>= dst 0)) (ml-kind-for-vreg dst)
        (if (or (< node 0) (>= node (n-count))) MLK-SCALAR
          (ml-kind-for-type (n-ty node)))))))

(defn ml-inst-uses? [(at i64) (vreg i64)] (-> bool)
  (ms-inst-uses-vreg? at vreg))

(defn ml-init-tables! [] (-> i64)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count)
        vregs (ml-vreg-count) (mut i) 0]
    (al-clear! [i64] (field u live-use)) (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in)) (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live)) (al-clear! [i64] (field u value-kind))
    (loop
      (if (>= (load i) (* blocks vregs)) (break)
        (do (al-push! [i64] (field u live-use) 0)
            (al-push! [i64] (field u live-def) 0)
            (al-push! [i64] (field u live-in) 0)
            (al-push! [i64] (field u live-out) 0)
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) (* edges vregs)) (break)
        (do (al-push! [i64] (field u edge-live) 0)
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) vregs) (break)
        (do (al-push! [i64] (field u value-kind) MLK-SCALAR)
            (store! i (+ (load i) 1)) 0)))
    0))

(defn ml-compute-use-def! [] (-> i64)
  (let [u (machine-unit) blocks (mu-block-count) vregs (ml-vreg-count) (mut bid) 0]
    (loop
      (if (>= (load bid) blocks) (break)
        (do
          (let [first (mu-block-inst-first (load bid)) count (mu-block-inst-count (load bid))
                (mut i) 0]
            (loop
              (if (>= (load i) count) (break)
                (do
                  (let [at (+ first (load i)) m (be-inst (+ first (load i)))
                        dst (load (field m dst)) (mut vr) 0]
                    (loop
                      (if (>= (load vr) vregs) (break)
                        (do
                          (if (and (ml-inst-uses? at (load vr))
                                   (not (ml-def? (load bid) (load vr))))
                              (al-set! [i64] (field u live-use)
                                       (ml-index (load bid) (load vr)) 1) 0)
                          (store! vr (+ (load vr) 1)) 0)))
                    (if (>= dst 0)
                        (do
                          (al-set! [i64] (field u live-def) (ml-index (load bid) dst) 1)
                          (al-set! [i64] (field u value-kind) dst (ml-kind-for-inst at))) 0))
                  (store! i (+ (load i) 1)) 0))))
          (store! bid (+ (load bid) 1)) 0)))
    0))

(defn ml-solve! [(seed i64)] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) vregs (ml-vreg-count)
        (mut changed) true (mut rounds) 0]
    (loop
      (if (or (not (load changed)) (> (load rounds) (+ (* blocks vregs) 1))) (break)
        (do
          (store! changed false)
          (let [(mut pos) 0]
            (loop
              (if (>= (load pos) blocks) (break)
                (do
                  (let [bid (if (= (& seed 1) 0) (- blocks (+ (load pos) 1))
                                (load pos))
                        (mut vr) 0]
                    (loop
                      (if (>= (load vr) vregs) (break)
                        (do
                          (let [(mut s) 0 (mut out) false]
                            (loop
                              (if (>= (load s) (mu-block-succ-count bid)) (break)
                                (do
                                  (if (ml-live-in? (mu-block-succ-target bid (load s)) (load vr))
                                      (store! out true) 0)
                                  (store! s (+ (load s) 1)) 0)))
                            (let [in (or (ml-use? bid (load vr))
                                         (and (load out) (not (ml-def? bid (load vr)))))
                                  idx (ml-index bid (load vr))]
                              (if (!= (al-get (load (field u live-out)) idx)
                                      (if (load out) 1 0))
                                  (do (al-set! [i64] (field u live-out) idx
                                               (if (load out) 1 0))
                                      (store! changed true)) 0)
                              (if (!= (al-get (load (field u live-in)) idx) (if in 1 0))
                                  (do (al-set! [i64] (field u live-in) idx (if in 1 0))
                                      (store! changed true)) 0)))
                          (store! vr (+ (load vr) 1)) 0))))
                  (store! pos (+ (load pos) 1)) 0))))
          (store! rounds (+ (load rounds) 1)) 0)))
    (store! (field u liveness-rounds) (load rounds))
    (not (load changed))))

(defn ml-compute-edge-live! [] (-> i64)
  (let [u (machine-unit) edges (mu-edge-count) vregs (ml-vreg-count) (mut edge) 0]
    (loop
      (if (>= (load edge) edges) (break)
        (do
          (let [target (mu-edge-target (load edge)) (mut vr) 0]
            (loop
              (if (>= (load vr) vregs) (break)
                (do
                  (let [(mut live) (ml-live-in? target (load vr))
                        (mut is-dst) false (mut is-src) false (mut i) 0]
                    (loop
                      (if (>= (load i) (mu-edge-copy-count (load edge))) (break)
                        (do
                          (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                              (do
                                (if (= (mu-copy-dst (load edge) (load i)) (load vr))
                                    (store! is-dst true) 0)
                                (if (= (mu-copy-src (load edge) (load i)) (load vr))
                                    (store! is-src true) 0)) 0)
                          (store! i (+ (load i) 1)) 0)))
                    (if (load is-dst) (store! live false) 0)
                    (if (load is-src) (store! live true) 0)
                    (al-set! [i64] (field u edge-live) (ml-edge-index (load edge) (load vr))
                             (if (load live) 1 0)))
                  (store! vr (+ (load vr) 1)) 0))))
          (store! edge (+ (load edge) 1)) 0)))
    0))

(defn ml-live-before? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at) first (mu-block-inst-first bid)
        count (mu-block-inst-count bid) (mut i) count (mut live) (ml-live-out? bid vreg)]
    (loop
      (if (<= (load i) 0) (break)
        (do
          (store! i (- (load i) 1))
          (let [current (+ first (load i)) dst (ms-inst-dst (+ first (load i)))]
            (if (= dst vreg) (store! live false) 0)
            (if (ml-inst-uses? current vreg) (store! live true) 0))
          (if (= (+ first (load i)) at) (break) 0))))
    (load live)))

(defn ml-live-after? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at) first (mu-block-inst-first bid)
        count (mu-block-inst-count bid) (mut i) count (mut live) (ml-live-out? bid vreg)]
    (loop
      (if (<= (load i) 0) (break)
        (do
          (store! i (- (load i) 1))
          (let [current (+ first (load i))]
            (if (= current at) (break) 0)
            (if (= (ms-inst-dst current) vreg) (store! live false) 0)
            (if (ml-inst-uses? current vreg) (store! live true) 0)))))
    (load live)))

(defn ml-safepoint? [(at i64)] (-> bool)
  (let [op (ms-inst-op at)] (or (= op MI-CALL) (= op MI-NEW))))

(defn ml-verify! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) edges (mu-edge-count)
        vregs (ml-vreg-count) (mut bid) 0]
    (store! (field u liveness-result) MLIVE-OK)
    (store! (field u liveness-item) -1)
    ; Re-derive use/def and the fixed-point equations without mutating the published sets.
    (loop
      (if (or (>= (load bid) blocks) (!= (ml-result) MLIVE-OK)) (break)
        (do
          (let [first (mu-block-inst-first (load bid)) count (mu-block-inst-count (load bid))
                (mut vr) 0]
            (loop
              (if (or (>= (load vr) vregs) (!= (ml-result) MLIVE-OK)) (break)
                (do
                  (let [(mut i) 0 (mut expected-use) false (mut expected-def) false
                        (mut expected-out) false]
                    (loop
                      (if (>= (load i) count) (break)
                        (do
                          (let [at (+ first (load i))]
                            (if (and (ml-inst-uses? at (load vr)) (not (load expected-def)))
                                (store! expected-use true) 0)
                            (if (= (ms-inst-dst at) (load vr)) (store! expected-def true) 0))
                          (store! i (+ (load i) 1)) 0)))
                    (store! i 0)
                    (loop
                      (if (>= (load i) (mu-block-succ-count (load bid))) (break)
                        (do
                          (if (ml-live-in? (mu-block-succ-target (load bid) (load i)) (load vr))
                              (store! expected-out true) 0)
                          (store! i (+ (load i) 1)) 0)))
                    (let [expected-in (or (load expected-use)
                                          (and (load expected-out) (not (load expected-def))))]
                      (if (or (!= (ml-use? (load bid) (load vr)) (load expected-use))
                              (or (!= (ml-def? (load bid) (load vr)) (load expected-def))
                                  (or (!= (ml-live-out? (load bid) (load vr)) (load expected-out))
                                      (!= (ml-live-in? (load bid) (load vr)) expected-in))))
                          (do (store! (field u liveness-result) MLIVE-FIXPOINT)
                              (store! (field u liveness-item)
                                      (ml-index (load bid) (load vr)))) 0)))
                  (store! vr (+ (load vr) 1)) 0))))
          (store! bid (+ (load bid) 1)) 0)))
    (if (= (ml-result) MLIVE-OK)
        (let [(mut edge) 0]
          (loop
            (if (or (>= (load edge) edges) (!= (ml-result) MLIVE-OK)) (break)
              (do
                (let [(mut vr) 0]
                  (loop
                    (if (>= (load vr) vregs) (break)
                      (do
                        (let [(mut expected) (ml-live-in? (mu-edge-target (load edge)) (load vr))
                              (mut dst) false (mut src) false (mut i) 0]
                          (loop
                            (if (>= (load i) (mu-edge-copy-count (load edge))) (break)
                              (do
                                (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                    (do
                                      (if (= (mu-copy-dst (load edge) (load i)) (load vr))
                                          (store! dst true) 0)
                                      (if (= (mu-copy-src (load edge) (load i)) (load vr))
                                          (store! src true) 0)) 0)
                                (store! i (+ (load i) 1)) 0)))
                          (if (load dst) (store! expected false) 0)
                          (if (load src) (store! expected true) 0)
                          (if (!= (ml-edge-live? (load edge) (load vr)) (load expected))
                              (do (store! (field u liveness-result) MLIVE-PHI)
                                  (store! (field u liveness-item)
                                          (ml-edge-index (load edge) (load vr)))) 0))
                        (store! vr (+ (load vr) 1)) 0))))
                (store! edge (+ (load edge) 1)) 0)))) 0)
    (if (= (ml-result) MLIVE-OK)
        (let [(mut at) 0]
          (loop
            (if (or (>= (load at) (be-inst-count)) (!= (ml-result) MLIVE-OK)) (break)
              (do
                (let [dst (ms-inst-dst (load at))]
                  (if (and (>= dst 0) (!= (ml-value-kind dst) (ml-kind-for-inst (load at))))
                      (do (store! (field u liveness-result) MLIVE-KIND)
                          (store! (field u liveness-item) dst)) 0))
                (store! at (+ (load at) 1)) 0)))) 0)
    (= (ml-result) MLIVE-OK)))

(defn ml-compute! [(seed i64)] (-> bool)
  (let [u (machine-unit)]
    (store! (field u liveness-seed) seed)
    (ml-init-tables!)
    (ml-compute-use-def!)
    (if (not (ml-solve! seed))
        (do (store! (field u liveness-result) MLIVE-FIXPOINT)
            (store! (field u liveness-item) -1) false)
      (do (ml-compute-edge-live!) (ml-verify!)))))

(defn ml-corrupt-live-out! [(bid i64) (vreg i64) (live bool)] (-> i64)
  (al-set! [i64] (field (machine-unit) live-out) (ml-index bid vreg) (if live 1 0)) 0)
(defn ml-corrupt-edge-live! [(edge i64) (vreg i64) (live bool)] (-> i64)
  (al-set! [i64] (field (machine-unit) edge-live) (ml-edge-index edge vreg) (if live 1 0)) 0)
(defn ml-corrupt-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) value-kind) vreg kind) 0)

(defn ml-dump-set [(w (ptr Writer)) (kind i64) (id i64)] (-> i64)
  (let [vregs (ml-vreg-count) (mut vr) 0 (mut first) true]
    (ps w "{")
    (loop
      (if (>= (load vr) vregs) (break)
        (do
          (let [live (case kind 0 (ml-use? id (load vr)) 1 (ml-def? id (load vr))
                                  2 (ml-live-in? id (load vr)) 3 (ml-live-out? id (load vr))
                                  (ml-edge-live? id (load vr)))]
            (if live
                (do (if (load first) 0 (ps w ","))
                    (fmt w "v{d}" (load vr)) (store! first false)) 0))
          (store! vr (+ (load vr) 1)) 0)))
    (ps w "}") 0))

(defn ml-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count) (mut owner) 0]
    (loop
      (if (>= (load owner) funcs) (break)
        (do
          (fmt w "function {d}\n" (load owner))
          (let [blocks (mu-function-block-count (load owner)) (mut rpo) 0]
            (loop
              (if (>= (load rpo) blocks) (break)
                (do
                  (let [bid (mu-function-block (load owner) (load rpo))]
                    (fmt w "  b{d} use" (load rpo)) (ml-dump-set w 0 bid)
                    (ps w " def") (ml-dump-set w 1 bid)
                    (ps w " in") (ml-dump-set w 2 bid)
                    (ps w " out") (ml-dump-set w 3 bid) (ps w "\n"))
                  (store! rpo (+ (load rpo) 1)) 0))))
          (store! owner (+ (load owner) 1)) 0)))
    (let [edges (mu-edge-count) (mut edge) 0]
      (loop
        (if (>= (load edge) edges) (break)
          (do
            (fmt w "edge {d} {d}->{d} live" (load edge)
                 (mu-edge-source (load edge)) (mu-edge-target (load edge)))
            (ml-dump-set w 4 (load edge)) (ps w "\n")
            (store! edge (+ (load edge) 1)) 0))))
    0))

(defn ml-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf) w (stack Writer)]
    (store! (field fb data) buf) (store! (field fb cap) cap) (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (ml-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "ml-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn be-note-call-arg-uses! [(at i64) (n i64)] (-> i64)
  (let [m (be-inst at) argc (load (field m arg-count)) (mut argi) 0]
    (loop
      (if (>= (load argi) argc) (break)
        (do
          (let [vr (ms-inst-arg at (load argi)) (mut k) 0]
            (loop
              (if (>= (load k) n) (break)
                (do
                  (if (= (load (field (be-inst (load k)) dst)) vr)
                      (store! (field (be-inst (load k)) last) at) 0)
                  (store! k (+ (load k) 1)) 0))))
          (store! argi (+ (load argi) 1)) 0)))
    0))

(defn ms-schedule-result [] (-> i64) (load (field (machine-unit) schedule-result)))
(defn ms-schedule-item [] (-> i64) (load (field (machine-unit) schedule-item)))
(defn ms-schedule-seed [] (-> i64) (load (field (machine-unit) schedule-seed)))

(defn ms-schedule-memory-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer) first (load (field m mem-first)) count (load (field m mem-count))
        (mut i) 0 (mut found) false]
    (loop
      (if (or (>= (load i) count) (load found)) (break)
        (do
          (if (= (al-get (load (field (machine-unit) selection-memory-deps))
                          (+ first (load i))) node) (store! found true) 0)
          (store! i (+ (load i) 1)) 0)))
    (load found)))

(defn ms-schedule-anti-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer) first (load (field m anti-first)) count (load (field m anti-count))
        (mut i) 0 (mut found) false]
    (loop
      (if (or (>= (load i) count) (load found)) (break)
        (do
          (if (= (al-get (load (field (machine-unit) memory-anti-deps))
                          (+ first (load i))) node) (store! found true) 0)
          (store! i (+ (load i) 1)) 0)))
    (load found)))

; 0=no edge, 1=scalar data, 2=memory/anti, 3=fixed effect/boundary order.
(defn ms-schedule-dependency-kind [(producer i64) (consumer i64)] (-> i64)
  (if (= producer consumer) 0
    (let [p (be-inst producer) c (be-inst consumer) dst (load (field p dst))
          pop (load (field p op)) cop (load (field c op))
          pd (mi-desc pop) cd (mi-desc cop)
          before (< (load (field p schedule-order)) (load (field c schedule-order)))]
      (if (and (>= dst 0)
               (and (ms-inst-uses-vreg? consumer dst)
                    (or (!= pop MI-COPY) before))) 1
        (if (or (ms-schedule-memory-node-dep? consumer (load (field p node)))
                (ms-schedule-anti-node-dep? consumer (load (field p node)))) 2
          (if (or (and before
                       (or (and (> (mi-desc-effects pd) 0) (= cop MI-CALL))
                           (or (and (= pop MI-CALL) (> (mi-desc-effects cd) 0))
                               (and (= pop MI-STORE) (= cop MI-STORE)))))
                  (or (= pop MI-LABEL)
                      (or (and (or (= pop MI-ARG) (= pop MI-STACKARG))
                               (or (and (!= cop MI-LABEL)
                                        (and (not (= cop MI-ARG)) (not (= cop MI-STACKARG))))
                                   before))
                          (or (and (= cop MI-COPY)
                                   (and (not (mi-desc-terminator? pd))
                                        (or (!= pop MI-COPY) before)))
                              (or (and (= pop MI-ABI-COPY)
                                       (and (!= cop MI-LABEL)
                                            (and (!= cop MI-ARG)
                                                 (and (!= cop MI-STACKARG)
                                                      (or (!= cop MI-ABI-COPY) before)))))
                                  (and (mi-desc-terminator? cd)
                                       (or (not (mi-desc-terminator? pd)) before))))))) 3 0))))))

(defn ms-schedule-latency [(op i64)] (-> i64)
  (case op MI-SDIV 8 MI-MUL 4 MI-LOAD 4 MI-CALL 8 MI-NEW 6 1))

(defn ms-schedule-priority [(at i64)] (-> i64)
  (let [m (be-inst at) d (mi-desc (load (field m op)))]
    ; Correctness edges decide readiness. Latency remains separately queryable target metadata;
    ; equal legal priority keeps seed 0 pressure-conservative and lets test seeds perturb ties.
    (if (mi-desc-terminator? d) 0 1)))

(defn ms-schedule-tie [(at i64) (seed i64)] (-> i64)
  (if (= seed 0) (- 2147483647 (load (field (be-inst at) schedule-order)))
    (if (= (& seed 1) 1) (load (field (be-inst at) schedule-order))
      (& (+ (* (+ seed 1) 1103515245)
            (* (+ (load (field (be-inst at) schedule-order)) 1) 2654435761)) 2147483647))))

(defn ms-schedule-ready? [(first i64) (count i64) (candidate i64)] (-> bool)
  (let [u (machine-unit) (mut i) 0 (mut ready) true]
    (loop
      (if (or (>= (load i) count) (not (load ready))) (break)
        (do
          (if (and (= (al-get (load (field u schedule-done)) (load i)) 0)
                   (> (ms-schedule-dependency-kind (+ first (load i)) candidate) 0))
              (store! ready false) 0)
          (store! i (+ (load i) 1)) 0)))
    (load ready)))

(defn ms-schedule-block! [(bid i64) (seed i64)] (-> bool)
  (let [u (machine-unit) b (mu-block bid) first (load (field b inst-first))
        count (load (field b inst-count)) (mut emitted) 0]
    (al-clear! [i64] (field u schedule-done))
    (let [(mut i) 0]
      (loop
        (if (>= (load i) count) (break)
          (do (al-push! [i64] (field u schedule-done) 0)
              (store! i (+ (load i) 1)) 0))))
    (store! (field b inst-first) (al-len [MInst] (load (field u schedule-work))))
    (loop
      (if (>= (load emitted) count) (break)
        (let [(mut i) 0 (mut choice) -1 (mut best-priority) -1 (mut best-tie) -1]
          (loop
            (if (>= (load i) count) (break)
              (do
                (if (and (= (al-get (load (field u schedule-done)) (load i)) 0)
                         (ms-schedule-ready? first count (+ first (load i))))
                    (let [priority (ms-schedule-priority (+ first (load i)))
                          tie (ms-schedule-tie (+ first (load i)) seed)]
                      (if (or (> priority (load best-priority))
                              (and (= priority (load best-priority)) (> tie (load best-tie))))
                          (do (store! choice (load i)) (store! best-priority priority)
                              (store! best-tie tie)) 0)) 0)
                (store! i (+ (load i) 1)) 0)))
          (if (< (load choice) 0)
              (do (store! (field u schedule-result) MSCHED-CYCLE)
                  (store! (field u schedule-item) bid) (break))
            (do
              (al-set! [i64] (field u schedule-done) (load choice) 1)
              (al-push! [MInst] (field u schedule-work)
                        (load (be-inst (+ first (load choice)))))
              (store! emitted (+ (load emitted) 1)))))))
    (= (load emitted) count)))

(defn ms-verify-schedule! [] (-> bool)
  (let [u (machine-unit) blocks (mu-block-count) n (be-inst-count)
        (mut bid) 0 (mut at) 0]
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (loop
      (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK)) (break)
        (do
          (let [b (mu-block (load bid)) first (load (field b inst-first))
                count (load (field b inst-count)) (mut i) 0 (mut seen-term) false]
            (if (or (< first 0) (> (+ first count) n))
                (do (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                    (store! (field u schedule-item) (load bid))) 0)
            (loop
              (if (or (>= (load i) count) (!= (ms-schedule-result) MSCHED-OK)) (break)
                (do
                  (let [current (+ first (load i)) m (be-inst (+ first (load i)))
                        desc (mi-desc (load (field m op))) (mut p) 0]
                    (if (!= (load (field m block-id)) (load bid))
                        (do (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                            (store! (field u schedule-item) current)) 0)
                    (if (mi-desc-terminator? desc) (store! seen-term true)
                      (if (load seen-term)
                          (do (store! (field u schedule-result) MSCHED-BOUNDARY)
                              (store! (field u schedule-item) current)) 0))
                    (if (and (= (ms-schedule-result) MSCHED-OK)
                             (not (ms-memory-anti-dependencies-valid? current)))
                        (do (store! (field u schedule-result) MSCHED-MEMORY)
                            (store! (field u schedule-item) current)) 0)
                    (loop
                      (if (>= (load p) count) (break)
                        (do
                          (let [producer (+ first (load p))
                                kind (ms-schedule-dependency-kind producer current)]
                            (if (and (> kind 0) (>= producer current))
                                (do (store! (field u schedule-result)
                                      (if (= kind 2) MSCHED-MEMORY MSCHED-DEPENDENCY))
                                    (store! (field u schedule-item) current)) 0))
                          (store! p (+ (load p) 1)) 0))))
                  (store! i (+ (load i) 1)) 0))))
          (store! bid (+ (load bid) 1)) 0)))
    ; Ranges must cover every instruction exactly once.
    (store! at 0)
    (loop
      (if (or (>= (load at) n) (!= (ms-schedule-result) MSCHED-OK)) (break)
        (do
          (let [(mut owner-count) 0 (mut order-count) 0 (mut b) 0
                order (load (field (be-inst (load at)) schedule-order))]
            (loop
              (if (>= (load b) blocks) (break)
                (do
                  (let [rec (mu-block (load b)) first (load (field rec inst-first))]
                    (if (and (>= (load at) first)
                             (< (load at) (+ first (load (field rec inst-count)))))
                        (store! owner-count (+ (load owner-count) 1)) 0))
                  (store! b (+ (load b) 1)) 0)))
            (let [(mut other) 0]
              (loop
                (if (>= (load other) n) (break)
                  (do
                    (if (= (load (field (be-inst (load other)) schedule-order)) order)
                        (store! order-count (+ (load order-count) 1)) 0)
                    (store! other (+ (load other) 1)) 0))))
            (if (or (!= (load owner-count) 1)
                    (or (< order 0) (or (>= order n) (!= (load order-count) 1))))
                (do (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                    (store! (field u schedule-item) (load at))) 0))
          (store! at (+ (load at) 1)) 0)))
    (= (ms-schedule-result) MSCHED-OK)))

(defn ms-corrupt-schedule-swap! [(left i64) (right i64)] (-> i64)
  (let [a (load (be-inst left)) b (load (be-inst right))]
    (store! (be-inst left) b) (store! (be-inst right) a) 0))

(defn ms-corrupt-schedule-duplicate! [(target i64) (source i64)] (-> i64)
  (store! (be-inst target) (load (be-inst source))) 0)

(defn ms-local-schedule! [(seed i64)] (-> bool)
  (let [u (machine-unit) n (be-inst-count) blocks (mu-block-count)
        (mut at) 0 (mut bid) 0]
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (store! (field u schedule-seed) seed)
    (al-clear! [MInst] (field u schedule-work))
    (loop
      (if (>= (load at) n) (break)
        (do (store! (field (be-inst (load at)) schedule-order) (load at))
            (store! at (+ (load at) 1)) 0)))
    ; Local scheduling must not silently become block layout. Preserve the already-published block
    ; order and change only instruction order within each range.
    (loop
      (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK)) (break)
        (do
          (ms-schedule-block! (load bid) seed)
          (store! bid (+ (load bid) 1)) 0)))
    (if (!= (ms-schedule-result) MSCHED-OK) false
      (do
        (al-clear! [MInst] (field (backend) ins))
        (let [count (al-len [MInst] (load (field u schedule-work))) (mut i) 0]
          (loop
            (if (>= (load i) count) (break)
              (do (al-push! [MInst] (field (backend) ins)
                            (al-get (load (field u schedule-work)) (load i)))
                  (store! i (+ (load i) 1)) 0))))
        (ms-verify-schedule!)))))

;; Selection emits a dependency-topological order. This explicit scheduler computes live intervals
;; and is the hook where M10's global code motion adds block placement for control graphs.
(defn be-schedule-intervals! [] (-> i64)
  (let [n (be-inst-count) (mut i) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (let [m (be-inst (load i)) d (load (field m dst))]
              (if (< d 0) 0
                (do (store! (field m first)
                            (if (= (load (field m op)) MI-ARG) 0 (load i)))
                    (store! (field m last) (load i)) 0)))
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) n) (break)
        (do (let [m (be-inst (load i)) a (load (field m a)) b (load (field m b))
                  pred (if (= (load (field m op)) MI-CSEL) (load (field m imm)) -1)
                  (mut j) 0]
              (loop
                (if (>= (load j) n) (break)
                  (do (let [d (load (field (be-inst (load j)) dst))]
                        (if (and (>= d 0) (or (or (= d a) (= d b)) (= d pred)))
                            (store! (field (be-inst (load j)) last) (load i)) 0))
                      (store! j (+ (load j) 1)) 0)))
              (if (= (load (field m op)) MI-CALL)
                  (be-note-call-arg-uses! (load i) n) 0))
            (store! i (+ (load i) 1)) 0)))
    ; A linear interval ends at its last textual use, but a preheader value used inside a loop is
    ; live again on every back edge. Extend such ranges through the branch that targets an earlier
    ; label so colouring cannot reuse an invariant's register for a loop-carried temporary.
    (store! i 0)
    (loop
      (if (>= (load i) n) (break)
        (do (let [br (be-inst (load i))]
              (if (!= (load (field br op)) MI-B) 0
                (let [label (load (field br imm)) (mut j) 0 (mut at) -1]
                  (loop
                    (if (>= (load j) (load i)) (break)
                      (do (if (and (= (load (field (be-inst (load j)) op)) MI-LABEL)
                                   (= (load (field (be-inst (load j)) imm)) label))
                              (store! at (load j)) 0)
                          (store! j (+ (load j) 1)) 0)))
                  (if (< (load at) 0) 0
                    (do (store! j 0)
                        (loop
                          (if (>= (load j) (load at)) (break)
                            (do (let [d (be-inst (load j))]
                                  (if (>= (load (field d last)) (load at))
                                      (store! (field d last) (load i)) 0))
                                (store! j (+ (load j) 1)) 0)))))))
            (store! i (+ (load i) 1)) 0))))
    n))

(defn be-schedule-seeded! [(seed i64)] (-> i64)
  (let [n (be-inst-count)]
    (if (and (> n 0) (>= (ms-inst-owner 0) 0))
        (if (ms-local-schedule! seed)
            (let [scheduled (be-schedule-intervals!)]
              (if (ml-compute! seed) scheduled -1)) -1)
      (be-schedule-intervals!))))

(defn be-schedule! [] (-> i64) (be-schedule-seeded! 0))

(defn intervals-overlap? [(a (ptr MInst)) (b (ptr MInst))] (-> bool)
  (and (<= (load (field a first)) (load (field b last)))
       (<= (load (field b first)) (load (field a last)))))

; ---------------------------------------------------------------------------
; G7 CFG interference and constrained allocation.
; ---------------------------------------------------------------------------

(defn mra-result [] (-> i64) (load (field (machine-unit) allocation-result)))
(defn mra-result-item [] (-> i64) (load (field (machine-unit) allocation-item)))
(defn mra-seed [] (-> i64) (load (field (machine-unit) allocation-seed)))
(defn mra-reg [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-reg)) vreg))
(defn mra-spill [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-spill)) vreg))
(defn mra-owner [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-owner)) vreg))
(defn mra-spill-kind [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-spill-kind)) vreg))
(defn mra-safepoint-reg [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-reg vreg) -2))
(defn mra-safepoint-spill [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-spill vreg) -2))
(defn mra-safepoint-kind [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (ml-value-kind vreg) -1))
(defn mra-interferes? [(a i64) (b i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) alloc-interference))
              (+ (* a (ml-vreg-count)) b)) 0))

(defn mra-phys-reg [(color i64)] (-> i64)
  (if (< color 8) color
    ; x28 is the native GC thread-state register.  It is fixed for the whole
    ; generated unit and therefore never participates in graph coloring.
    (if (< color 17) (+ 19 (- color 8))
      (if (< color 24) (+ 8 (- color 17)) -1))))

(defn mra-init! [] (-> i64)
  (let [u (machine-unit) vregs (ml-vreg-count) (mut i) 0]
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (loop
      (if (>= (load i) (* vregs vregs)) (break)
        (do (al-push! [i64] (field u alloc-interference) 0)
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) vregs) (break)
        (do
          (al-push! [i64] (field u alloc-live) 0)
          (al-push! [i64] (field u alloc-reg) -1)
          (al-push! [i64] (field u alloc-spill) -1)
          (al-push! [i64] (field u alloc-owner) -1)
          (al-push! [i64] (field u alloc-forbidden) 0)
          (al-push! [i64] (field u alloc-spill-kind) (ml-value-kind (load i)))
          (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) (be-inst-count)) (break)
        (do
          (let [m (be-inst (load i)) dst (load (field m dst))]
            (if (>= dst 0)
                (do
                  (al-set! [i64] (field u alloc-owner) dst (load (field m owner)))
                  (if (= (load (field m op)) MI-ARG)
                      (al-set! [i64] (field u alloc-reg) dst (load (field m imm))) 0)) 0))
          (store! i (+ (load i) 1)) 0)))
    0))

(defn mra-add-interference! [(a i64) (b i64)] (-> i64)
  (if (or (< a 0) (or (< b 0) (= a b))) 0
    (let [u (machine-unit) n (ml-vreg-count)]
      (al-set! [i64] (field u alloc-interference) (+ (* a n) b) 1)
      (al-set! [i64] (field u alloc-interference) (+ (* b n) a) 1) 0)))

(defn mra-build-interference! [] (-> i64)
  (let [u (machine-unit) blocks (mu-block-count) vregs (ml-vreg-count) (mut bid) 0]
    (loop
      (if (>= (load bid) blocks) (break)
        (do
          (let [(mut vr) 0]
            (loop
              (if (>= (load vr) vregs) (break)
                (do
                  (al-set! [i64] (field u alloc-live) (load vr)
                           (if (ml-live-out? (load bid) (load vr)) 1 0))
                  (store! vr (+ (load vr) 1)) 0))))
          (let [first (mu-block-inst-first (load bid)) count (mu-block-inst-count (load bid))
                (mut i) count (mut vr) 0]
            (loop
              (if (<= (load i) 0) (break)
                (do
                  (store! i (- (load i) 1))
                  (let [at (+ first (load i)) m (be-inst (+ first (load i)))
                        dst (load (field m dst))]
                    ; Values live after any call-like instruction cannot occupy its clobber mask.
                    (if (!= (mi-desc-clobbers (mi-desc (load (field m op)))) 0)
                        (let [(mut vr) 0]
                          (loop
                            (if (>= (load vr) vregs) (break)
                              (do
                                (if (and (!= (load vr) dst)
                                         (!= (al-get (load (field u alloc-live)) (load vr)) 0))
                                    (al-set! [i64] (field u alloc-forbidden) (load vr)
                                      (| (al-get (load (field u alloc-forbidden)) (load vr))
                                         (mi-desc-clobbers
                                           (mi-desc (load (field m op)))))) 0)
                                (store! vr (+ (load vr) 1)) 0)))) 0)
                    (if (>= dst 0)
                        (do
                          (store! vr 0)
                          (loop
                            (if (>= (load vr) vregs) (break)
                              (do
                                (if (!= (al-get (load (field u alloc-live)) (load vr)) 0)
                                    (mra-add-interference! dst (load vr)) 0)
                                (store! vr (+ (load vr) 1)) 0)))
                          (al-set! [i64] (field u alloc-live) dst 0)) 0)
                    (store! vr 0)
                    (loop
                      (if (>= (load vr) vregs) (break)
                        (do
                          (if (ml-inst-uses? at (load vr))
                              (al-set! [i64] (field u alloc-live) (load vr) 1) 0)
                          (store! vr (+ (load vr) 1)) 0))))))))
          (store! bid (+ (load bid) 1)) 0)))
    0))

(defn mra-reg-legal? [(vreg i64) (reg i64)] (-> bool)
  (if (< reg 0) false
    (let [u (machine-unit) forbidden (al-get (load (field u alloc-forbidden)) vreg)
          vregs (ml-vreg-count) (mut other) 0 (mut ok) true]
      (if (!= (& forbidden (<< 1 reg)) 0) false
        (do
          (loop
            (if (or (>= (load other) vregs) (not (load ok))) (break)
              (do
                (if (and (mra-interferes? vreg (load other))
                         (= (mra-reg (load other)) reg)) (store! ok false) 0)
                (store! other (+ (load other) 1)) 0)))
          (load ok))))))

(defn mra-copy-preference [(vreg i64)] (-> i64)
  (let [(mut at) 0 (mut preferred) -1]
    (loop
      (if (or (>= (load at) (be-inst-count)) (>= (load preferred) 0)) (break)
        (do
          (let [m (be-inst (load at))]
            (if (= (load (field m op)) MI-COPY)
                (let [dst (load (field m dst)) src (load (field m a))
                      other (if (= dst vreg) src (if (= src vreg) dst -1))]
                  (if (and (>= other 0)
                           (and (not (mra-interferes? vreg other))
                                (= (ml-value-kind vreg) (ml-value-kind other))))
                      (store! preferred (mra-reg other)) 0)) 0))
          (store! at (+ (load at) 1)) 0)))
    (load preferred)))

(defn mra-assign! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit) vregs (ml-vreg-count) funcs (mu-function-count)
        (mut owner) 0 (mut rank) 0 (mut spills) 0]
    (loop
      (if (>= (load owner) funcs) (break)
        (do (store! (field (mu-function (load owner)) frame-size) 0)
            (store! (field (mu-function (load owner)) callee-mask) 0)
            (store! (field (mu-function (load owner)) callee-count) 0)
            (store! owner (+ (load owner) 1)) 0)))
    (loop
      (if (>= (load rank) vregs) (break)
        (do
          (let [vreg (if (= (& seed 1) 0) (load rank) (- vregs (+ (load rank) 1)))]
            (if (or (< (mra-owner vreg) 0) (>= (mra-reg vreg) 0)) 0
              (let [preferred (mra-copy-preference vreg) (mut color) 0 (mut chosen) -1]
                (if (and (>= preferred 0) (mra-reg-legal? vreg preferred))
                    (store! chosen preferred) 0)
                (loop
                  (if (or (>= (load color) nregs) (>= (load chosen) 0)) (break)
                    (do
                      (let [physical (mra-phys-reg (load color))]
                        (if (mra-reg-legal? vreg physical) (store! chosen physical) 0))
                      (store! color (+ (load color) 1)) 0)))
                (if (>= (load chosen) 0)
                    (al-set! [i64] (field u alloc-reg) vreg (load chosen))
                  (let [fun (mra-owner vreg) slot (load (field (mu-function (mra-owner vreg)) frame-size))]
                    (al-set! [i64] (field u alloc-spill) vreg slot)
                    (store! (field (mu-function fun) frame-size) (+ slot 1))
                    (store! spills (+ (load spills) 1)))))))
          (store! rank (+ (load rank) 1)) 0)))
    ; Derive each function's callee-save area, then convert spill counts to aligned frame bytes.
    (let [(mut vr) 0]
      (loop
        (if (>= (load vr) vregs) (break)
          (do
            (let [fun (mra-owner (load vr)) reg (mra-reg (load vr))]
              (if (and (>= fun 0) (and (>= reg 19) (<= reg 28)))
                  (store! (field (mu-function fun) callee-mask)
                          (| (load (field (mu-function fun) callee-mask)) (<< 1 reg))) 0))
            (store! vr (+ (load vr) 1)) 0))))
    (store! owner 0)
    (loop
      (if (>= (load owner) funcs) (break)
        (do
          (let [slots (load (field (mu-function (load owner)) frame-size))
                saves (popcount64 (load (field (mu-function (load owner)) callee-mask)))]
            (store! (field (mu-function (load owner)) callee-count) saves)
            (store! (field (mu-function (load owner)) frame-size)
                    (& (+ (+ 16 (* (+ saves slots) 8)) 15) -16)))
          (store! owner (+ (load owner) 1)) 0)))
    (load spills)))

(defn mra-publish! [] (-> i64)
  (let [n (be-inst-count) (mut at) 0]
    (loop
      (if (>= (load at) n) (break)
        (do
          (let [m (be-inst (load at)) dst (load (field m dst))]
            (if (>= dst 0)
                (do (store! (field m reg) (mra-reg dst))
                    (store! (field m spill) (mra-spill dst))) 0))
          (store! at (+ (load at) 1)) 0)))
    0))

(defn mra-expected-interferes? [(a i64) (b i64)] (-> bool)
  (if (= a b) false
    (let [blocks (mu-block-count) (mut bid) 0 (mut found) false]
      (loop
        (if (or (>= (load bid) blocks) (load found)) (break)
          (do
            (let [first (mu-block-inst-first (load bid)) count (mu-block-inst-count (load bid))
                  (mut i) count (mut alive) (ml-live-out? (load bid) a)
                  (mut blive) (ml-live-out? (load bid) b)]
              (loop
                (if (or (<= (load i) 0) (load found)) (break)
                  (do
                    (store! i (- (load i) 1))
                    (let [at (+ first (load i)) dst (ms-inst-dst (+ first (load i)))]
                      (if (and (= dst a) (load blive)) (store! found true) 0)
                      (if (and (= dst b) (load alive)) (store! found true) 0)
                      (if (= dst a) (store! alive false) 0)
                      (if (= dst b) (store! blive false) 0)
                      (if (ml-inst-uses? at a) (store! alive true) 0)
                      (if (ml-inst-uses? at b) (store! blive true) 0))))))
            (store! bid (+ (load bid) 1)) 0)))
      (load found))))

(defn mra-verify! [] (-> bool)
  (let [u (machine-unit) vregs (ml-vreg-count) (mut vr) 0]
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (loop
      (if (or (>= (load vr) vregs) (!= (mra-result) MRA-OK)) (break)
        (do
          (if (>= (mra-owner (load vr)) 0)
              (do
                (if (= (>= (mra-reg (load vr)) 0) (>= (mra-spill (load vr)) 0))
                    (do (store! (field u allocation-result) MRA-LOCATION)
                        (store! (field u allocation-item) (load vr))) 0)
                (if (and (>= (mra-reg (load vr)) 0)
                         (not (mra-reg-legal? (load vr) (mra-reg (load vr)))))
                    (do (store! (field u allocation-result) MRA-INTERFERENCE)
                        (store! (field u allocation-item) (load vr))) 0)
                (if (!= (mra-spill-kind (load vr)) (ml-value-kind (load vr)))
                    (do (store! (field u allocation-result) MRA-SPILL-KIND)
                        (store! (field u allocation-item) (load vr))) 0)) 0)
          (store! vr (+ (load vr) 1)) 0)))
    (if (= (mra-result) MRA-OK)
        (let [(mut a) 0]
          (loop
            (if (or (>= (load a) vregs) (!= (mra-result) MRA-OK)) (break)
              (do
                (let [(mut b) (+ (load a) 1)]
                  (loop
                    (if (>= (load b) vregs) (break)
                      (do
                        (if (!= (mra-interferes? (load a) (load b))
                                (mra-expected-interferes? (load a) (load b)))
                            (do (store! (field u allocation-result) MRA-INTERFERENCE)
                                (store! (field u allocation-item) (+ (* (load a) vregs) (load b)))) 0)
                        (store! b (+ (load b) 1)) 0))))
                (store! a (+ (load a) 1)) 0)))) 0)
    ; Every definition of a vreg, including Phi edge copies, publishes the same location.
    (if (= (mra-result) MRA-OK)
        (let [(mut at) 0]
          (loop
            (if (or (>= (load at) (be-inst-count)) (!= (mra-result) MRA-OK)) (break)
              (do
                (let [m (be-inst (load at)) dst (load (field m dst))]
                  (if (and (>= dst 0)
                           (or (!= (load (field m reg)) (mra-reg dst))
                               (!= (load (field m spill)) (mra-spill dst))))
                      (do (store! (field u allocation-result) MRA-LOCATION)
                          (store! (field u allocation-item) (load at))) 0))
                (let [m (be-inst (load at))]
                  (if (and (= (load (field m op)) MI-ARG)
                           (!= (mra-reg (load (field m dst))) (load (field m imm))))
                      (do (store! (field u allocation-result) MRA-FIXED)
                          (store! (field u allocation-item) (load at))) 0))
                (store! at (+ (load at) 1)) 0)))) 0)
    (= (mra-result) MRA-OK)))

(defn mra-corrupt-reg! [(vreg i64) (reg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-reg) vreg reg)
  (al-set! [i64] (field (machine-unit) alloc-spill) vreg -1)
  (mra-publish!) 0)
(defn mra-corrupt-spill-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-spill-kind) vreg kind) 0)
(defn mra-corrupt-interference! [(a i64) (b i64) (present bool)] (-> i64)
  (let [u (machine-unit) n (ml-vreg-count) value (if present 1 0)]
    (al-set! [i64] (field u alloc-interference) (+ (* a n) b) value)
    (al-set! [i64] (field u alloc-interference) (+ (* b n) a) value) 0))

(defn mra-allocate! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)]
    (store! (field u allocation-seed) seed)
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (mra-init!)
    (mra-build-interference!)
    (let [spills (mra-assign! nregs seed)]
      (mra-publish!)
      (if (mra-verify!) spills -1))))

;; Greedy coloring over the exact interval interference graph. Values beyond the register budget
;; receive distinct spill slots; lowering treats each slot boundary as a split point.
(defn be-color-linear! [(nregs i64)] (-> i64)
  (let [p (backend) n (be-inst-count) (mut i) 0]
    (store! (field p spills) 0)
    (let [(mut owner) 0]
      (loop
        (if (>= (load owner) (mu-function-count)) (break)
          (do (store! (field (mu-function (load owner)) frame-size) 0)
              (store! owner (+ (load owner) 1)) 0))))
    (loop
      (if (>= (load i) n) (break)
        (do (store! (field (be-inst (load i)) reg)
                    (if (= (load (field (be-inst (load i)) op)) MI-ARG)
                        (load (field (be-inst (load i)) imm)) -1))
            (store! (field (be-inst (load i)) spill) -1)
            (store! i (+ (load i) 1)) 0)))
    (store! i 0)
    (loop
      (if (>= (load i) n) (break)
        (do (let [m (be-inst (load i))]
              (if (or (< (load (field m dst)) 0) (= (load (field m op)) MI-ARG)) 0
                (let [(mut color) 0 (mut found) false]
                  (loop
                    (if (or (>= (load color) nregs) (load found)) (break)
                      (let [(mut j) 0 (mut conflict) false]
                        (loop
                          (if (>= (load j) n) (break)
                            (do (let [q (be-inst (load j))]
                                  (if (and (!= (load j) (load i))
                                           (and (= (load (field q reg)) (load color))
                                           (intervals-overlap? m q)))
                                      (store! conflict true) 0))
                                (store! j (+ (load j) 1)) 0)))
                        (if (load conflict) (store! color (+ (load color) 1)) (store! found true)))))
                  (if (load found) (store! (field m reg) (load color))
                    (let [owner (load (field m owner))]
                      (if (>= owner 0)
                          (let [slot (load (field (mu-function owner) frame-size))]
                            (store! (field m spill) slot)
                            (store! (field (mu-function owner) frame-size) (+ slot 1)))
                        (do (store! (field m spill) (load (field p spills)))
                            (store! (field p spills) (+ (load (field p spills)) 1)) 0))))))
            (store! i (+ (load i) 1)) 0))))
    (let [funcs (mu-function-count) (mut owner) 0]
      (loop
        (if (>= (load owner) funcs) (break)
          (do
            (let [slots (load (field (mu-function (load owner)) frame-size))
                  bytes (& (+ (+ 16 (* slots 8)) 15) -16)]
              (store! (field (mu-function (load owner)) frame-size) bytes)
              (store! (field p spills) (+ (load (field p spills)) slots)))
            (store! owner (+ (load owner) 1)) 0))))
    (load (field p spills))))

(defn be-color-seeded! [(nregs i64) (seed i64)] (-> i64)
  (if (and (> (be-inst-count) 0) (>= (ms-inst-owner 0) 0))
      (let [spills (mra-allocate! nregs seed)]
        (store! (field (backend) spills) (if (< spills 0) 0 spills))
        spills)
    (be-color-linear! nregs)))

(defn be-color! [(nregs i64)] (-> i64) (be-color-seeded! nregs 0))

; Repack whole function instruction ranges before liveness/allocation. Seeds rotate function text
; order, including moving the exported entry away from offset zero. Block-local scheduled order is
; unchanged.
(defn be-function-layout-seeded! [(seed i64)] (-> i64)
  (let [p (backend) u (machine-unit) funcs (mu-function-count) n (be-inst-count)
        work (field u schedule-work) (mut rank) 0]
    (al-clear! [MInst] work)
    (loop
      (if (>= (load rank) funcs) (break)
        (do
          (let [owner (% (+ (load rank) seed) funcs)
                (mut at) 0]
            (loop
              (if (>= (load at) n) (break)
                (do (if (= (ms-inst-owner (load at)) owner)
                        (al-push! [MInst] work (load (be-inst (load at)))) 0)
                    (store! at (+ (load at) 1)) 0))))
          (store! rank (+ (load rank) 1)) 0)))
    (if (!= (al-len [MInst] (load work)) n) -1
      (do
        (al-clear! [MInst] (field p ins))
        (let [(mut at) 0]
          (loop
            (if (>= (load at) n) (break)
              (do (al-push! [MInst] (field p ins) (load (be-al-elem [MInst] work (load at))))
                  (store! at (+ (load at) 1)) 0))))
        (let [(mut bid) 0]
          (loop
            (if (>= (load bid) (mu-block-count)) (break)
              (do (store! (field (mu-block (load bid)) inst-first) -1)
                  (store! (field (mu-block (load bid)) inst-count) 0)
                  (store! bid (+ (load bid) 1)) 0))))
        (let [(mut at) 0]
          (loop
            (if (>= (load at) n) (break)
              (do
                (let [bid (ms-inst-block (load at))]
                  (if (>= bid 0)
                      (let [b (mu-block bid)]
                        (if (< (load (field b inst-first)) 0)
                            (store! (field b inst-first) (load at)) 0)
                        (store! (field b inst-count) (+ (load (field b inst-count)) 1))) 0))
                (store! at (+ (load at) 1)) 0))) n)))))

(defn be-color-checked! [(nregs i64)] (-> bool)
  (if (<= nregs 0) (be-fail! BER-ALLOCATION NO-NODE)
    (do (be-color! nregs) true)))

(defn be-spills [] (-> i64) (load (field (backend) spills)))

(defn be-verify-abi! [] (-> i64)
  (let [funcs (mu-function-count) n (be-inst-count)
        (mut owner) 0 (mut at) 0 (mut result) MABI-OK]
    (loop
      (if (or (>= (load owner) funcs) (!= (load result) MABI-OK)) (break)
        (do
          (let [frame (mu-function-frame-size (load owner))]
            (if (or (< frame 16) (!= (& frame 15) 0)) (store! result MABI-FRAME) 0))
          (store! owner (+ (load owner) 1)) 0)))
    (loop
      (if (or (>= (load at) n) (!= (load result) MABI-OK)) (break)
        (do
          (let [m (be-inst (load at)) op (load (field m op))
                own (load (field m owner)) spill (load (field m spill))]
            (if (and (>= own 0) (>= spill 0))
                (if (> (+ 16 (* (+ (mu-function-callee-count own) (+ spill 1)) 8))
                       (mu-function-frame-size own))
                    (store! result MABI-SPILL) 0) 0)
            (if (and (= (load result) MABI-OK)
                     (or (and (= op MI-ARG)
                              (or (< (load (field m imm)) 0) (>= (load (field m imm)) 8)))
                         (and (= op MI-STACKARG)
                              (or (< (load (field m imm)) 8) (>= (load (field m imm)) 16)))))
                (store! result MABI-ARGUMENT) 0)
            (if (and (= (load result) MABI-OK)
                     (and (= op MI-CALL) (not (ms-call-args-valid? (load at)))))
                (store! result MABI-ARGUMENT) 0))
          (store! at (+ (load at) 1)) 0)))
    (load result)))

(defn be-corrupt-frame-size! [(owner i64) (bytes i64)] (-> i64)
  (store! (field (mu-function owner) frame-size) bytes) 0)
(defn be-corrupt-spill-slot! [(at i64) (slot i64)] (-> i64)
  (store! (field (be-inst at) spill) slot) (store! (field (be-inst at) reg) -1) 0)
(defn be-corrupt-arg-index! [(at i64) (idx i64)] (-> i64)
  (store! (field (be-inst at) imm) idx) 0)

; Focused phase tests use this after coloring to exercise lowering's spill boundary independent of
; the later CFG allocator milestone. Every definition of a Phi vreg must name the same location.
(defn be-force-spill-vreg! [(vreg i64) (slot i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut owner) -1]
    (loop
      (if (>= (load i) n) (break)
        (do
          (let [m (be-inst (load i))]
            (if (= (load (field m dst)) vreg)
                (do (store! (field m reg) -1) (store! (field m spill) slot)
                    (store! owner (load (field m owner))) 0) 0))
          (store! i (+ (load i) 1)) 0)))
    (if (<= (load (field (backend) spills)) slot)
        (store! (field (backend) spills) (+ slot 1)) 0)
    (if (>= (load owner) 0)
        (let [need (& (+ (+ 16 (* (+ (mu-function-callee-count (load owner))
                                      (+ slot 1)) 8)) 15) -16)]
          (if (< (mu-function-frame-size (load owner)) need)
              (store! (field (mu-function (load owner)) frame-size) need) 0)) 0)
    0))

; AArch64 word encoders used by lowering.
(defn a64-movz [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 2 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-movk [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 3 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-add-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd)))))
(defn a64-sub-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd))))))
(defn a64-mul [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 27 24) (| (<< rm 16) (| (<< 31 10) (| (<< rn 5) rd))))))
(defn a64-sdiv [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 26 24) (| (<< 6 10) (| (<< rm 16) (| (<< rn 5) rd))))))
(defn a64-ret [] (-> i64) 3596551104)
(defn a64-cmp-reg [(rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 1 29) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) 31)))))))
(defn a64-csinc [(rd i64) (rn i64) (rm i64) (cnd i64)] (-> i64)
  (| (<< 1 31) (| (<< 212 21) (| (<< rm 16) (| (<< cnd 12) (| (<< 1 10) (| (<< rn 5) rd)))))))
(defn a64-cset [(rd i64) (cnd i64)] (-> i64) (a64-csinc rd 31 31 (^ cnd 1)))
(defn a64-cbz [(rt i64) (delta-words i64)] (-> i64)
  (| 3019898880 (| (<< (& delta-words 524287) 5) rt)))
(defn a64-cbnz [(rt i64) (delta-words i64)] (-> i64)
  (| 3036676096 (| (<< (& delta-words 524287) 5) rt)))
(defn a64-bcond [(cnd i64) (delta-words i64)] (-> i64)
  (| 1409286144 (| (<< (& delta-words 524287) 5) cnd)))
(defn a64-csel [(rd i64) (rn i64) (rm i64) (cnd i64)] (-> i64)
  (| (<< 1 31) (| (<< 212 21) (| (<< rm 16) (| (<< cnd 12) (| (<< rn 5) rd))))))
(defn a64-b [(delta-words i64)] (-> i64)
  (| 335544320 (& delta-words 67108863)))
(defn a64-bl [(delta-words i64)] (-> i64)
  (| 2483027968 (& delta-words 67108863)))
(defn a64-add-imm [(rd i64) (rn i64) (imm i64)] (-> i64)
  (| (<< 1 31) (| (<< 17 24) (| (<< (& imm 4095) 10) (| (<< rn 5) rd)))))
(defn a64-sub-imm [(rd i64) (rn i64) (imm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 17 24) (| (<< (& imm 4095) 10) (| (<< rn 5) rd))))))
(defn a64-ldr [(rt i64) (rn i64) (off i64)] (-> i64)
  (| 4181721088 (| (<< (/ off 8) 10) (| (<< rn 5) rt))))
(defn a64-str [(rt i64) (rn i64) (off i64)] (-> i64)
  (| 4177526784 (| (<< (/ off 8) 10) (| (<< rn 5) rt))))

(defn be-u32! [(w i64)] (-> i64)
  (let [b (field (backend) code)]
    (al-push! [u8] b (cast u8 (& w 255)))
    (al-push! [u8] b (cast u8 (& (>> w 8) 255)))
    (al-push! [u8] b (cast u8 (& (>> w 16) 255)))
    (al-push! [u8] b (cast u8 (& (>> w 24) 255))) 0))

(defn be-reg-of [(vr i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut r) -1]
    (loop
      (if (or (>= (load i) n) (>= (load r) 0)) (break)
        (do (if (= (load (field (be-inst (load i)) dst)) vr)
                (store! r (load (field (be-inst (load i)) reg))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load r)))

(defn be-spill-of [(vr i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut s) -1]
    (loop
      (if (or (>= (load i) n) (>= (load s) 0)) (break)
        (do (if (= (load (field (be-inst (load i)) dst)) vr)
                (store! s (load (field (be-inst (load i)) spill))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load s)))

(defn be-owner-of [(vr i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut owner) -1]
    (loop
      (if (or (>= (load i) n) (>= (load owner) 0)) (break)
        (do (if (= (load (field (be-inst (load i)) dst)) vr)
                (store! owner (load (field (be-inst (load i)) owner))) 0)
            (store! i (+ (load i) 1)) 0)))
    (load owner)))

(defn be-spill-off [(slot i64)] (-> i64) (+ 1024 (* slot 8)))
(defn be-spill-off-vreg [(vr i64)] (-> i64)
  (let [slot (be-spill-of vr) owner (be-owner-of vr)]
    (if (>= owner 0) (+ 16 (* (+ (mu-function-callee-count owner) slot) 8))
        (be-spill-off slot))))

(defn be-callee-save-off [(owner i64) (reg i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner) (mut r) 19 (mut rank) 0]
    (loop
      (if (>= (load r) reg) (break)
        (do
          (if (!= (& mask (<< 1 (load r))) 0) (store! rank (+ (load rank) 1)) 0)
          (store! r (+ (load r) 1)) 0)))
    (+ 16 (* (load rank) 8))))

(defn be-read-reg! [(vr i64) (scratch i64)] (-> i64)
  (if (< vr 0) -1
    (let [r (be-reg-of vr)]
      (if (>= r 0) r
        (let [s (be-spill-of vr)]
          (if (< s 0) -1 (do (be-u32! (a64-ldr scratch 31 (be-spill-off-vreg vr))) scratch)))))))

(defn be-read-reg-delta! [(vr i64) (scratch i64) (sp-delta i64)] (-> i64)
  (if (< vr 0) -1
    (let [r (be-reg-of vr)]
      (if (>= r 0) r
        (let [s (be-spill-of vr)]
          (if (< s 0) -1
            (do (be-u32! (a64-ldr scratch 31 (+ sp-delta (be-spill-off-vreg vr)))) scratch)))))))

(defn be-write-reg [(vr i64)] (-> i64)
  (let [r (be-reg-of vr)] (if (>= r 0) r 14)))

(defn be-store-written! [(vr i64) (from i64)] (-> i64)
  (let [s (be-spill-of vr)]
    (if (< s 0) 0 (be-u32! (a64-str from 31 (be-spill-off-vreg vr))))))

(defn be-entry-label-owner [(bid i64)] (-> i64)
  (let [funcs (mu-function-count) (mut owner) 0 (mut found) -1]
    (loop
      (if (or (>= (load owner) funcs) (>= (load found) 0)) (break)
        (do (if (= (mu-function-block (load owner) 0) bid) (store! found (load owner)) 0)
            (store! owner (+ (load owner) 1)) 0)))
    (load found)))

(defn be-align16 [(n i64)] (-> i64) (& (+ n 15) -16))
(defn be-call-area [(argc i64)] (-> i64) (be-align16 (* argc 8)))
(defn be-call-spill-loads [(m (ptr MInst))] (-> i64)
  (let [count (load (field m arg-count)) first (load (field m arg-first))
        (mut i) 0 (mut loads) 0]
    (loop
      (if (>= (load i) count) (break)
        (do (let [vr (al-get (load (field (machine-unit) call-args)) (+ first (load i)))]
              (if (< (be-reg-of vr) 0) (store! loads (+ (load loads) 1)) 0))
            (store! i (+ (load i) 1)) 0)))
    (load loads)))

(defn be-mov-imm! [(rd i64) (v i64)] (-> i64)
  (be-u32! (a64-movz rd (& v 65535) 0))
  (let [(mut hw) 1]
    (loop
      (if (>= (load hw) 4) (break)
        (do (let [part (& (>> v (* (load hw) 16)) 65535)]
              (if (= part 0) 0 (be-u32! (a64-movk rd part (load hw)))))
            (store! hw (+ (load hw) 1)) 0))) 0))

(defn be-mov-words [(v i64)] (-> i64)
  (let [(mut words) 1 (mut hw) 1]
    (loop
      (if (>= (load hw) 4) (break)
        (do (if (= (& (>> v (* (load hw) 16)) 65535) 0) 0
              (store! words (+ (load words) 1)))
            (store! hw (+ (load hw) 1)) 0)))
    (load words)))

(defn be-store-barrier? [(m (ptr MInst))] (-> bool)
  (let [node (load (field m node))]
    (and (be-runtime-allocation?)
         (and (>= node 0)
              (and (< node (n-count))
                   (and (= (n-op node) OP-STORE)
                        (and (shape-alias-defined? (n-aux node))
                             (ty-only-obj? (shape-alias-ty (n-aux node))))))))))

(defn be-inst-words [(m (ptr MInst))] (-> i64)
  (let [op (load (field m op)) a (load (field m a)) b (load (field m b))
        dst (load (field m dst))
        base (case op
               MI-ARG 0
               MI-LABEL (let [owner (be-entry-label-owner (load (field m imm)))]
                          (if (>= owner 0) (+ 4 (mu-function-callee-count owner)) 0))
               MI-MOVI (be-mov-words (load (field m imm)))
               MI-NEW (if (be-runtime-allocation?)
                          (let [sw (be-mov-words (shape-size (load (field m imm))))]
                            (+ (+ 19 sw)
                               (* 2 (+ sw (be-mov-words (load (field m imm))))))) 1)
               MI-EQ 2 MI-LT 2 MI-LE 2 MI-CSEL 2
               MI-CALL (+ 5 (+ (load (field m arg-count))
                                  (+ (if (< (load (field m arg-count)) 8)
                                         (load (field m arg-count)) 8)
                                     (be-call-spill-loads m))))
               MI-STACKARG 1
               MI-STORE (if (be-store-barrier? m) 18 1)
               MI-RET (+ (if (= (be-reg-of a) 0) 0 1)
                         (if (< (load (field m owner)) 0) 2
                           (+ 4 (mu-function-callee-count (load (field m owner))))))
               1)
        aload (if (and (!= op MI-CALL) (and (>= a 0) (< (be-reg-of a) 0))) 1 0)
        bload (if (and (!= op MI-CALL) (and (>= b 0) (< (be-reg-of b) 0))) 1 0)
        pload (if (and (= op MI-CSEL) (< (be-reg-of (load (field m imm))) 0)) 1 0)
        dstore (if (and (>= dst 0) (< (be-reg-of dst) 0)) 1 0)]
    (+ base (+ aload (+ bload (+ pload dstore))))))

(defn be-label-off [(label i64)] (-> i64)
  (let [n (be-inst-count) (mut i) 0 (mut off) -1]
    (loop
      (if (or (>= (load i) n) (>= (load off) 0)) (break)
        (do (let [m (be-inst (load i))]
              (if (and (= (load (field m op)) MI-LABEL) (= (load (field m imm)) label))
                  (store! off (load (field m first))) 0))
            (store! i (+ (load i) 1)) 0)))
    (load off)))

(defn be-encode! [] (-> i64)
  (let [p (backend) n (be-inst-count) (mut i) 0]
    (al-clear! [u8] (field p code))
    (do (if (and (> n 0) (< (load (field (be-inst 0) owner)) 0))
            (be-u32! (a64-sub-imm 31 31 2048)) 0)
          (let [(mut off) 0]
            (loop
              (if (>= (load i) n) (break)
                (do (store! (field (be-inst (load i)) first) (load off))
                    (store! off (+ (load off) (* 4 (be-inst-words (be-inst (load i))))))
                    (store! i (+ (load i) 1)) 0))))
          ; Publish exact function text ranges from entry labels. Ranges are structural metadata,
          ; not inferred later from symbol order in the object writer.
          (let [funcs (mu-function-count) (mut owner) 0]
            (loop
              (if (>= (load owner) funcs) (break)
                (do
                  (let [f (mu-function (load owner))
                        start (be-label-off (mu-function-block (load owner) 0))
                        lastm (be-inst (- n 1))
                        (mut end) (+ (load (field lastm first)) (* 4 (be-inst-words lastm)))
                        (mut other) 0]
                    (loop
                      (if (>= (load other) funcs) (break)
                        (do
                          (if (!= (load other) (load owner))
                              (let [candidate (be-label-off (mu-function-block (load other) 0))]
                                (if (and (> candidate start) (< candidate (load end)))
                                    (store! end candidate) 0)) 0)
                          (store! other (+ (load other) 1)) 0)))
                    (store! (field f code-start) start)
                    (store! (field f code-size) (- (load end) start)))
                  (store! owner (+ (load owner) 1)) 0))) 0)
          (store! i 0)
          (loop
            (if (>= (load i) n) (break)
              (do (let [m (be-inst (load i)) op (load (field m op))
                        dst (load (field m dst)) rd (be-write-reg dst)
                        ; Calls marshal their complete argument vector below. Eagerly reading the
                        ; cached a/b mirrors here would emit duplicate spill reloads and make the
                        ; encoded byte count diverge from be-inst-words.
                        ra (if (= op MI-CALL) -1
                             (be-read-reg! (load (field m a)) 15))
                        rb (if (= op MI-CALL) -1
                             (be-read-reg! (load (field m b)) 16))]
                    (case op
                      MI-MOVI (be-mov-imm! rd (load (field m imm)))
                      MI-ADD (be-u32! (a64-add-reg rd ra rb))
                      MI-SUB (be-u32! (a64-sub-reg rd ra rb))
                      MI-MUL (be-u32! (a64-mul rd ra rb))
                      MI-SDIV (be-u32! (a64-sdiv rd ra rb))
                      MI-ARG 0
                      MI-STACKARG
                        (let [frame (mu-function-frame-size (load (field m owner)))]
                          (be-u32! (a64-ldr rd 31 (+ frame (* (load (field m imm)) 8)))))
                      MI-EQ (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 0)) 0)
                      MI-LT (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 11)) 0)
                      MI-LE (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 13)) 0)
                      MI-LABEL
                        (let [owner (be-entry-label-owner (load (field m imm)))]
                          (if (< owner 0) 0
                            (let [frame (mu-function-frame-size owner)]
                              (be-u32! (a64-sub-imm 31 31 frame))
                              (be-u32! (a64-str 29 31 0))
                              (be-u32! (a64-str 30 31 8))
                              (let [mask (mu-function-callee-mask owner) (mut reg) 19]
                                (loop
                                  (if (> (load reg) 28) (break)
                                    (do
                                      (if (!= (& mask (<< 1 (load reg))) 0)
                                          (be-u32! (a64-str (load reg) 31
                                                      (be-callee-save-off owner (load reg)))) 0)
                                      (store! reg (+ (load reg) 1)) 0))))
                              (be-u32! (a64-add-imm 29 31 0)) 0)))
                      MI-CBZ (let [target (be-label-off (load (field m imm)))
                                   ; A spilled predicate is reloaded before the branch. PC-relative
                                   ; displacements are based on the CBZ itself, not the beginning of
                                   ; this expanded machine instruction.
                                   here (+ (load (field m first))
                                           (if (< (be-reg-of (load (field m a))) 0) 4 0))]
                               (if (< target 0) -1
                                 (be-u32! (a64-cbz ra (/ (- target here) 4)))))
                      MI-CSEL (do (be-u32! (a64-cmp-reg (be-read-reg! (load (field m imm)) 17) 31))
                                  (be-u32! (a64-csel rd ra rb 1)) 0)
                      MI-MOV (let [to (be-reg-of (load (field m imm)))]
                               (if (< to 0)
                                   (be-u32! (a64-str ra 31 (be-spill-off-vreg (load (field m imm)))))
                                 (be-u32! (a64-add-reg to ra 31))))
                      MI-COPY (be-u32! (a64-add-reg rd ra 31))
                      MI-ABI-COPY (be-u32! (a64-add-reg rd ra 31))
                      MI-CALL
                        (let [target-label (mu-function-block (load (field m imm)) 0)
                              target (be-label-off target-label) here (load (field m first))
                              argc (load (field m arg-count)) first (load (field m arg-first))
                              area (be-call-area argc) (mut j) 0]
                          (be-u32! (a64-sub-imm 31 31 area))
                          (store! j 0)
                          (loop
                            (if (>= (load j) argc) (break)
                              (do
                                (let [vr (al-get (load (field (machine-unit) call-args))
                                                 (+ first (load j)))
                                      r (be-read-reg-delta! vr 15 area)]
                                  (be-u32! (a64-str r 31 (* (load j) 8))))
                                (store! j (+ (load j) 1)) 0)))
                          (store! j 0)
                          (loop
                            (if (or (>= (load j) argc) (>= (load j) 8)) (break)
                              (do (be-u32! (a64-ldr (load j) 31 (* (load j) 8)))
                                  (store! j (+ (load j) 1)) 0)))
                          ; The BL follows the argument area setup and exact argument moves.
                          ; Values live across calls cannot occupy caller-saved registers: G6/G7
                          ; enforce the clobber mask, so no provisional save envelope is needed.
                          (let [bl-off (+ here (* 4 (+ 1 (+ argc
                                           (+ (be-call-spill-loads m)
                                              (if (< argc 8) argc 8))))))]
                            (if (< target 0) -1
                              (be-u32! (a64-bl (/ (- target bl-off) 4)))))
                          (be-u32! (a64-add-reg 14 0 31))
                          (be-u32! (a64-add-imm 31 31 area))
                          (be-u32! (a64-add-reg rd 14 31)) 0)
                      MI-B (let [target (be-label-off (load (field m imm)))
                                 here (load (field m first))]
                             (if (< target 0) -1
                               (be-u32! (a64-b (/ (- target here) 4)))))
                      ; Allocation is an external runtime safepoint. The object writer relocates
                      ; the slow-path zero BL to `_aot_alloc_slow`. x28 points at
                      ; {cursor,limit,stress}; the ordinary path bumps and writes
                      ; the header without entering C. x0=size, x1=shape, x0=result
                      ; on the slow path.
                      MI-NEW (if (be-runtime-allocation?)
                               (let [size (shape-size (load (field m imm)))
                                     shape (load (field m imm))
                                     sw (be-mov-words size) shw (be-mov-words shape)
                                     cw (+ 6 sw)]
                                 (be-u32! (a64-ldr 9 28 0))
                                 (be-u32! (a64-ldr 10 28 8))
                                 (be-mov-imm! 11 size)
                                 (be-u32! (a64-add-reg 11 9 11))
                                 (be-u32! (a64-cmp-reg 11 10))
                                 (be-u32! (a64-bcond 8 (+ 7 (+ shw cw))))
                                 (be-u32! (a64-ldr 10 28 16))
                                 (be-u32! (a64-cbnz 10 (+ 5 (+ shw cw))))
                                 (be-u32! (a64-str 11 28 0))
                                 (be-u32! (a64-add-reg 0 9 31))
                                 (be-mov-imm! 10 shape)
                                 (be-u32! (a64-str 10 0 0))
                                 ; Exact allocation metrics live in the thread state so the
                                 ; generated fast path and C slow path share one counter domain.
                                 (be-u32! (a64-ldr 15 28 72))
                                 (be-u32! (a64-add-imm 15 15 1))
                                 (be-u32! (a64-str 15 28 72))
                                 (be-u32! (a64-ldr 15 28 80))
                                 (be-mov-imm! 16 size)
                                 (be-u32! (a64-add-reg 15 15 16))
                                 (be-u32! (a64-str 15 28 80))
                                 (be-u32! (a64-b (+ 2 (+ sw shw))))
                                 (be-mov-imm! 0 size)
                                 (be-mov-imm! 1 shape)
                                 (be-u32! (a64-bl 0))
                                   (be-u32! (a64-add-reg rd 0 31)) 0)
                               (be-u32! (a64-add-imm rd 3
                                           (* (graph-new-index (load (field m node))) 128))))
                      MI-LOAD (be-u32! (a64-ldr rd ra (load (field m imm))))
                      MI-STORE
                        (do
                          (be-u32! (a64-str rb ra (load (field m imm))))
                          (if (be-store-barrier? m)
                              (do
                                ; Inline remembered-set barrier. x15/x16 are
                                ; reserved scratch registers; the four range
                                ; checks recognize old-object -> young-value.
                                (be-u32! (a64-ldr 15 28 24))
                                (be-u32! (a64-cmp-reg ra 15))
                                (be-u32! (a64-bcond 3 15))
                                (be-u32! (a64-ldr 16 28 32))
                                (be-u32! (a64-cmp-reg ra 16))
                                (be-u32! (a64-bcond 2 12))
                                (be-u32! (a64-ldr 15 28 40))
                                (be-u32! (a64-cmp-reg rb 15))
                                (be-u32! (a64-bcond 3 9))
                                (be-u32! (a64-ldr 16 28 48))
                                (be-u32! (a64-cmp-reg rb 16))
                                (be-u32! (a64-bcond 2 6))
                                (be-u32! (a64-movz 15 1 0))
                                (be-u32! (a64-str 15 28 56))
                                (be-u32! (a64-ldr 16 28 64))
                                (be-u32! (a64-add-imm 16 16 1))
                                (be-u32! (a64-str 16 28 64)) 0)
                            0))
                      MI-NEG (be-u32! (a64-sub-reg rd 31 ra))
                      MI-RET (do (if (= ra 0) 0 (be-u32! (a64-add-reg 0 ra 31)))
                                 (if (< (load (field m owner)) 0)
                                     (be-u32! (a64-add-imm 31 31 2048))
                                   (let [frame (mu-function-frame-size (load (field m owner)))]
                                     (let [owner (load (field m owner))
                                           mask (mu-function-callee-mask (load (field m owner)))
                                           (mut reg) 19]
                                       (loop
                                         (if (> (load reg) 28) (break)
                                           (do
                                             (if (!= (& mask (<< 1 (load reg))) 0)
                                                 (be-u32! (a64-ldr (load reg) 31
                                                             (be-callee-save-off owner (load reg)))) 0)
                                             (store! reg (+ (load reg) 1)) 0))))
                                     (be-u32! (a64-ldr 29 31 0))
                                     (be-u32! (a64-ldr 30 31 8))
                                     (be-u32! (a64-add-imm 31 31 frame)) 0))
                                 (be-u32! (a64-ret)) 0)
                      0)
                    (if (>= dst 0) (be-store-written! dst rd) 0)
                    (store! i (+ (load i) 1)) 0))))
          (be-code-len))))

(defn be-encode-checked! [] (-> bool)
  (if (!= (be-result) BER-OK) false
    (let [n (be-inst-count) (mut i) 0 (mut bad) NO-NODE]
      (loop
        (if (or (>= (load i) n) (!= (load bad) NO-NODE)) (break)
          (do (let [m (be-inst (load i)) op (load (field m op))]
                (if (not (mi-desc-encodable? (mi-desc op)))
                    (store! bad (load (field m node))) 0))
              (store! i (+ (load i) 1)) 0)))
      (if (!= (load bad) NO-NODE) (be-fail! BER-ENCODING (load bad))
        (do (be-encode!)
            (if (> (be-code-len) 0) true (be-fail! BER-ENCODING NO-NODE)))))))

(defn be-code-len [] (-> i64)
  (if (= (be-result) BER-OK) (al-len [u8] (load (field (backend) code))) 0))
(defn be-code-byte [(i i64)] (-> i64) (cast i64 (al-get (load (field (backend) code)) i)))
(defn be-code-u32 [(at i64)] (-> i64)
  (| (be-code-byte at)
     (| (<< (be-code-byte (+ at 1)) 8)
        (| (<< (be-code-byte (+ at 2)) 16)
           (<< (be-code-byte (+ at 3)) 24)))))

; Minimal arm64 MH_OBJECT writer: one __TEXT,__text section and one external `_kernel` symbol.
(defn obj-u8! [(v i64)] (-> i64)
  (al-push! [u8] (field (backend) obj) (cast u8 (& v 255))) 0)
(defn obj-u32! [(v i64)] (-> i64)
  (obj-u8! v) (obj-u8! (>> v 8)) (obj-u8! (>> v 16)) (obj-u8! (>> v 24)) 0)
(defn obj-u64! [(v i64)] (-> i64) (obj-u32! v) (obj-u32! (>> v 32)) 0)
(defn obj-name16! [(s (slice u8))] (-> i64)
  (let [n (slice-len s) (mut i) 0]
    (loop
      (if (>= (load i) 16) (break)
        (do (obj-u8! (if (< (load i) n) (cast i64 (slice-get s (load i))) 0))
            (store! i (+ (load i) 1)) 0))) 0))
(defn obj-pad-to! [(at i64)] (-> i64)
  (loop
    (if (>= (al-len [u8] (load (field (backend) obj))) at) (break)
      (obj-u8! 0))) 0)
(defn align8 [(n i64)] (-> i64) (& (+ n 7) -8))

(defn obj-ascii! [(s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop
      (if (>= (load i) (slice-len s)) (break)
        (do (obj-u8! (cast i64 (slice-get s (load i))))
            (store! i (+ (load i) 1)) 0))) 0))

(defn obj-hex-digit [(v i64)] (-> i64)
  (if (< v 10) (+ 48 v) (+ 87 v)))

; Fixed-width names make string-table offsets independent of function count and layout order.
(defn obj-local-name! [(owner i64)] (-> i64)
  (obj-ascii! "_aot_")
  (let [(mut shift) 60]
    (loop
      (if (< (load shift) 0) (break)
        (do (obj-u8! (obj-hex-digit (& (>> owner (load shift)) 15)))
            (store! shift (- (load shift) 4)) 0))) 0))

(defn mobj-safepoint-count [] (-> i64)
  (let [(mut at) 0 (mut count) 0]
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do (if (ml-safepoint? (load at)) (store! count (+ (load count) 1)) 0)
            (store! at (+ (load at) 1)) 0)))
    (load count)))

(defn mobj-external-reloc-count [] (-> i64)
  (if (not (be-runtime-allocation?)) 0
   (let [(mut at) 0 (mut count) 0]
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do (if (= (ms-inst-op (load at)) MI-NEW)
                (store! count (+ (load count) 1)) 0)
            (store! at (+ (load at) 1)) 0)))
    (load count))))

(defn mobj-new-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at) shape (load (field m imm))]
    (+ (load (field m first))
       (let [sw (be-mov-words (shape-size shape))]
         (* 4 (+ (+ 17 sw)
                 (* 2 (+ sw (be-mov-words shape)))))))))

(defn mobj-safepoint-pc [(at i64)] (-> i64)
  (let [m (be-inst at) op (load (field m op))]
    (case op
      MI-NEW (if (be-runtime-allocation?) (+ (mobj-new-branch-pc at) 4)
               (load (field m first)))
      MI-CALL
        (let [argc (load (field m arg-count)) here (load (field m first))]
          (+ (+ here (* 4 (+ 1 (+ argc (+ (be-call-spill-loads m)
                                      (if (< argc 8) argc 8)))))) 4))
      -1)))

(defn mobj-branch-reloc-info [(symbol i64)] (-> i64)
  (| symbol (| (<< 1 24) (| (<< 2 25) (| (<< 1 27) (<< 2 28))))))

(defn mobj-root? [(at i64) (vr i64)] (-> bool)
  (and (if (= (ms-inst-op at) MI-CALL)
           (and (!= (ms-inst-dst at) vr) (ml-live-after? at vr))
         (ml-live-before? at vr))
       (!= (ml-value-kind vr) MLK-SCALAR)))

(defn mobj-root-count [] (-> i64)
  (let [(mut at) 0 (mut roots) 0]
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do
          (if (ml-safepoint? (load at))
              (let [(mut vr) 0]
                (loop
                  (if (>= (load vr) (ml-vreg-count)) (break)
                    (do (if (mobj-root? (load at) (load vr))
                            (store! roots (+ (load roots) 1)) 0)
                        (store! vr (+ (load vr) 1)) 0)))) 0)
          (store! at (+ (load at) 1)) 0)))
    (load roots)))

(defn mobj-stackmap-size [] (-> i64)
  (+ 24 (+ (* (mu-function-count) 32)
           (+ (* (mobj-safepoint-count) 24) (* (mobj-root-count) 16)))))
(defn mobj-layout-size [] (-> i64) (+ 16 (* (shape-count) 32)))

(defn mobj-write-stackmaps! [] (-> i64)
  (let [sites (mobj-safepoint-count) roots (mobj-root-count)
        (mut at) 0 (mut root-first) 0]
    (obj-u32! 1398034241) (obj-u32! 2) (obj-u32! sites) (obj-u32! roots)
    (obj-u32! (mu-function-count)) (obj-u32! 32)
    (let [(mut owner) 0]
      (loop
        (if (>= (load owner) (mu-function-count)) (break)
          (do
            (obj-u32! (load owner)) (obj-u32! (mu-function-code-start (load owner)))
            (obj-u32! (mu-function-code-size (load owner)))
            (obj-u32! (mu-function-frame-size (load owner)))
            (obj-u64! (mu-function-callee-mask (load owner)))
            (obj-u32! (mu-function-callee-count (load owner))) (obj-u32! 0)
            (store! owner (+ (load owner) 1)) 0))))
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do
          (if (ml-safepoint? (load at))
              (let [m (be-inst (load at)) (mut vr) 0 (mut count) 0]
                (loop
                  (if (>= (load vr) (ml-vreg-count)) (break)
                    (do (if (mobj-root? (load at) (load vr))
                            (store! count (+ (load count) 1)) 0)
                        (store! vr (+ (load vr) 1)) 0)))
                (obj-u32! (mobj-safepoint-pc (load at)))
                (obj-u32! (load (field m owner)))
                (obj-u32! (load at)) (obj-u32! (load root-first))
                (obj-u32! (load count)) (obj-u32! (load (field m op)))
                (store! root-first (+ (load root-first) (load count)))) 0)
          (store! at (+ (load at) 1)) 0)))
    (store! at 0)
    (loop
      (if (>= (load at) (be-inst-count)) (break)
        (do
          (if (ml-safepoint? (load at))
              (let [(mut vr) 0]
                (loop
                  (if (>= (load vr) (ml-vreg-count)) (break)
                    (do
                      (if (mobj-root? (load at) (load vr))
                          (let [reg (mra-reg (load vr)) spill (mra-spill (load vr))]
                            (obj-u32! (load vr)) (obj-u32! (ml-value-kind (load vr)))
                            (obj-u32! (if (>= reg 0) 0 1))
                            (obj-u32! (if (>= reg 0) reg (be-spill-off-vreg (load vr))))) 0)
                      (store! vr (+ (load vr) 1)) 0)))) 0)
          (store! at (+ (load at) 1)) 0))) 0))

(defn mobj-shape-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0 (mut bits) 0]
    (loop
      (if (>= (load field) (shape-field-count shape)) (break)
        (do (if (ty-only-obj? (shape-field-ty shape (load field)))
                (store! bits (| (load bits) (<< 1 (load field)))) 0)
            (store! field (+ (load field) 1)) 0)))
    (load bits)))

(defn mobj-write-layouts! [] (-> i64)
  (obj-u32! 1280593729) (obj-u32! 1) (obj-u32! (shape-count)) (obj-u32! 32)
  (let [(mut shape) 0]
    (loop
      (if (>= (load shape) (shape-count)) (break)
        (do (obj-u32! (load shape)) (obj-u32! (shape-size (load shape)))
            (obj-u32! 8) (obj-u32! (shape-field-count (load shape)))
            (obj-u64! (mobj-shape-bitmap (load shape))) (obj-u64! 0)
            (store! shape (+ (load shape) 1)) 0))) 0))

(defn mobj-fail! [(code i64) (item i64)] (-> bool)
  (let [p (backend)]
    (store! (field p object-result) code)
    (store! (field p object-item) item)
    false))

; Validate the phase-owned object model before a byte is published. The serialized-byte parser
; below repeats the bounds checks after publication; neither verifier trusts the other.
(defn mobj-verify-model! [] (-> bool)
  (let [p (backend) funcs (mu-function-count) textlen (be-code-len)
        (mut owner) 0 (mut ok) true]
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (if (<= textlen 0)
        (do (store! ok false) (mobj-fail! MOBJ-HEADER -1)) false)
    (loop
      (if (or (>= (load owner) funcs) (not (load ok))) (break)
        (do
          (let [start (mu-function-code-start (load owner))
                size (mu-function-code-size (load owner))]
            (if (or (< start 0) (or (<= size 0) (> (+ start size) textlen)))
                (do (store! ok false)
                    (mobj-fail! MOBJ-FUNCTION-RANGE (load owner))) false))
          (store! owner (+ (load owner) 1)) 0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop
            (if (or (>= (load at) (be-inst-count)) (not (load ok))) (break)
              (do
                (if (= (ms-inst-op (load at)) MI-CALL)
                    (let [target (load (field (be-inst (load at)) imm))]
                      (if (or (< target 0) (>= target funcs))
                          (do (store! ok false)
                              (mobj-fail! MOBJ-RELOCATION (load at))) false)) false)
                (store! at (+ (load at) 1)) 0))) 0) 0)
    (load ok)))

(defn mobj-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (store! (field (be-inst at) imm) target) 0)

(defn mobj-corrupt-function-range! [(owner i64) (start i64) (size i64)] (-> i64)
  (store! (field (mu-function owner) code-start) start)
  (store! (field (mu-function owner) code-size) size) 0)

(defn mobj-byte [(at i64)] (-> i64)
  (cast i64 (al-get (load (field (backend) obj)) at)))
(defn mobj-u32 [(at i64)] (-> i64)
  (| (mobj-byte at)
     (| (<< (mobj-byte (+ at 1)) 8)
        (| (<< (mobj-byte (+ at 2)) 16) (<< (mobj-byte (+ at 3)) 24)))))
(defn mobj-u64 [(at i64)] (-> i64)
  (| (mobj-u32 at) (<< (mobj-u32 (+ at 4)) 32)))

; Repository-local structural parser for the exact object schema emitted below. It validates raw
; bytes and cross-checks them against phase-owned function ranges.
(defn mobj-verify-bytes! [] (-> bool)
  (let [p (backend) len (al-len [u8] (load (field p obj))) funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1) nreloc (mobj-external-reloc-count)
        externs (if (> nreloc 0) 1 0) nsyms (+ basesyms externs) (mut ok) true]
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (if (< len 472)
        (do (store! ok false) (mobj-fail! MOBJ-HEADER 0)) false)
    (if (and (load ok)
             (or (!= (mobj-u32 0) 4277009103)
                 (or (!= (mobj-u32 16) 4) (!= (mobj-u32 20) 440))))
        (do (store! ok false) (mobj-fail! MOBJ-HEADER 0)) false)
    (if (load ok)
        (let [textlen (mobj-u64 144) textoff (mobj-u32 152)
              relocoff (mobj-u32 160) actual-nreloc (mobj-u32 164)
              stackaddr (mobj-u64 216) stacklen (mobj-u64 224) stackoff (mobj-u32 232)
              layoutaddr (mobj-u64 296) layoutlen (mobj-u64 304) layoutoff (mobj-u32 312)
              symoff (mobj-u32 352) actual-nsyms (mobj-u32 356)
              stroff (mobj-u32 360) strsize (mobj-u32 364)]
          (if (or (!= textoff 472)
                  (or (> (+ textoff textlen) len)
                      (or (> (+ stackoff stacklen) len)
                          (or (!= stackaddr (align8 textlen))
                              (or (!= layoutaddr (align8 (+ stackaddr stacklen)))
                               (or (> (+ layoutoff layoutlen) len)
                              (or (!= actual-nreloc nreloc)
                                  (or (> (+ relocoff (* actual-nreloc 8)) len)
                                      (or (!= actual-nsyms nsyms)
                                          (or (> (+ symoff (* actual-nsyms 16)) len)
                                              (> (+ stroff strsize) len)))))))))))
              (do (store! ok false) (mobj-fail! MOBJ-HEADER 1)) false)
          (if (and (load ok)
                   (or (!= (mobj-u32 stackoff) 1398034241)
                       (or (!= (mobj-u32 (+ stackoff 4)) 2)
                           (or (!= (mobj-u32 (+ stackoff 8)) (mobj-safepoint-count))
                               (or (!= (mobj-u32 (+ stackoff 12)) (mobj-root-count))
                                   (or (!= (mobj-u32 (+ stackoff 16)) (mu-function-count))
                                       (or (!= (mobj-u32 (+ stackoff 20)) 32)
                                           (!= stacklen (mobj-stackmap-size)))))))))
              (do (store! ok false) (mobj-fail! MOBJ-STACKMAP 0)) false)
          (if (and (load ok)
                   (or (!= (mobj-u32 layoutoff) 1280593729)
                       (or (!= (mobj-u32 (+ layoutoff 4)) 1)
                           (or (!= (mobj-u32 (+ layoutoff 8)) (shape-count))
                               (!= layoutlen (mobj-layout-size))))))
              (do (store! ok false) (mobj-fail! MOBJ-LAYOUT 0)) false)
          (if (load ok)
              (let [functions (mobj-u32 (+ stackoff 16)) (mut owner) 0]
                (loop
                  (if (or (>= (load owner) functions) (not (load ok))) (break)
                    (do
                      (let [rec (+ (+ stackoff 24) (* (load owner) 32))]
                        (if (or (!= (mobj-u32 rec) (load owner))
                                (or (!= (mobj-u32 (+ rec 4))
                                        (mu-function-code-start (load owner)))
                                    (or (!= (mobj-u32 (+ rec 8))
                                            (mu-function-code-size (load owner)))
                                        (or (!= (mobj-u32 (+ rec 12))
                                                (mu-function-frame-size (load owner)))
                                            (or (!= (mobj-u64 (+ rec 16))
                                                    (mu-function-callee-mask (load owner)))
                                                (!= (mobj-u32 (+ rec 24))
                                                    (mu-function-callee-count (load owner))))))))
                            (do (store! ok false)
                                (mobj-fail! MOBJ-STACKMAP (load owner))) false))
                      (store! owner (+ (load owner) 1)) 0))) 0) 0)
          (if (load ok)
              (let [sites (mobj-u32 (+ stackoff 8)) roots (mobj-u32 (+ stackoff 12))
                    sitebase (+ (+ stackoff 24) (* (mu-function-count) 32))
                    (mut site) 0]
                (loop
                  (if (or (>= (load site) sites) (not (load ok))) (break)
                    (do
                      (let [rec (+ sitebase (* (load site) 24))
                            pc (mobj-u32 rec) owner (mobj-u32 (+ rec 4))
                            at (mobj-u32 (+ rec 8)) root-first (mobj-u32 (+ rec 12))
                            root-count (mobj-u32 (+ rec 16)) op (mobj-u32 (+ rec 20))
                            (mut vr) 0 (mut expected-count) 0]
                        (if (< at (be-inst-count))
                            (loop
                              (if (>= (load vr) (ml-vreg-count)) (break)
                                (do (if (mobj-root? at (load vr))
                                        (store! expected-count (+ (load expected-count) 1)) 0)
                                    (store! vr (+ (load vr) 1)) 0))) 0)
                        (if (or (>= at (be-inst-count))
                                (or (not (ml-safepoint? at))
                                    (or (!= pc (mobj-safepoint-pc at))
                                        (or (!= owner (load (field (be-inst at) owner)))
                                            (or (!= op (load (field (be-inst at) op)))
                                                (or (!= root-count (load expected-count))
                                                    (> (+ root-first root-count) roots)))))))
                            (do (store! ok false)
                                (mobj-fail! MOBJ-STACKMAP (load site))) false)
                        (if (load ok)
                            (do
                              (store! vr 0)
                              (let [(mut ordinal) 0]
                                (loop
                                  (if (or (>= (load vr) (ml-vreg-count))
                                          (not (load ok))) (break)
                                    (do
                                      (if (mobj-root? at (load vr))
                                          (let [rootrec (+ sitebase
                                                         (+ (* sites 24)
                                                            (* (+ root-first (load ordinal)) 16)))
                                                reg (mra-reg (load vr))]
                                            (if (or (!= (mobj-u32 rootrec) (load vr))
                                                    (or (!= (mobj-u32 (+ rootrec 4))
                                                            (ml-value-kind (load vr)))
                                                        (or (!= (mobj-u32 (+ rootrec 8))
                                                                (if (>= reg 0) 0 1))
                                                            (!= (mobj-u32 (+ rootrec 12))
                                                                (if (>= reg 0) reg
                                                                  (be-spill-off-vreg (load vr)))))))
                                                (do (store! ok false)
                                                    (mobj-fail! MOBJ-STACKMAP (load site))) false)
                                            (store! ordinal (+ (load ordinal) 1))) 0)
                                      (store! vr (+ (load vr) 1)) 0)))) 0) 0))
                      (store! site (+ (load site) 1)) 0))) 0) 0)
          (if (load ok)
              (let [count (mobj-u32 (+ layoutoff 8)) (mut shape) 0]
                (loop
                  (if (or (>= (load shape) count) (not (load ok))) (break)
                    (do
                      (let [rec (+ (+ layoutoff 16) (* (load shape) 32))]
                        (if (or (!= (mobj-u32 rec) (load shape))
                                (or (!= (mobj-u32 (+ rec 4)) (shape-size (load shape)))
                                    (or (!= (mobj-u32 (+ rec 8)) 8)
                                        (or (!= (mobj-u32 (+ rec 12))
                                                (shape-field-count (load shape)))
                                            (!= (mobj-u64 (+ rec 16))
                                                (mobj-shape-bitmap (load shape)))))))
                            (do (store! ok false)
                                (mobj-fail! MOBJ-LAYOUT (load shape))) false))
                      (store! shape (+ (load shape) 1)) 0))) 0) 0)
          (if (load ok)
              (let [(mut reloc) 0]
                (loop
                  (if (or (>= (load reloc) actual-nreloc) (not (load ok))) (break)
                    (do
                      (let [rec (+ relocoff (* (load reloc) 8)) address (mobj-u32 rec)
                            info (mobj-u32 (+ rec 4))]
                        (if (or (>= address textlen)
                                (or (!= (& info 16777215) basesyms)
                                    (!= (& (>> info 24) 255) 45)))
                            (do (store! ok false)
                                (mobj-fail! MOBJ-RELOCATION (load reloc))) false))
                      (store! reloc (+ (load reloc) 1)) 0))) 0) 0)
          (if (load ok)
              (let [(mut s) 0]
                (loop
                  (if (or (>= (load s) actual-nsyms) (not (load ok))) (break)
                    (do
                      (let [at (+ symoff (* (load s) 16)) strx (mobj-u32 at)
                            typ (mobj-byte (+ at 4)) sect (mobj-byte (+ at 5))
                            value (mobj-u64 (+ at 8))
                            owner (if (= (load s) (- basesyms 1)) 0 (+ (load s) 1))
                            undef (>= (load s) basesyms)]
                        (if (or (>= strx strsize)
                                (if undef (or (!= typ 1) (or (!= sect 0) (!= value 0)))
                                  (or (!= sect 1)
                                      (or (!= typ (if (= owner 0) 15 14))
                                          (and (> funcs 0)
                                               (!= value (mu-function-code-start owner)))))))
                            (do (store! ok false) (mobj-fail! MOBJ-SYMBOL (load s))) false))
                      (store! s (+ (load s) 1)) 0))) 0) 0)) 0)
    (load ok)))

(defn mobj-corrupt-byte! [(at i64) (value i64)] (-> i64)
  (al-set! [u8] (field (backend) obj) at (cast u8 value)) 0)

(defn be-macho! [] (-> i64)
  (let [p (backend) textlen (be-code-len) funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1) locals (if (> funcs 0) (- funcs 1) 0)
        nreloc (mobj-external-reloc-count) externs (if (> nreloc 0) 1 0)
        nsyms (+ basesyms externs)
        stacklen (mobj-stackmap-size) layoutlen (mobj-layout-size)
        textoff 472 stackoff (align8 (+ textoff textlen))
        stackaddr (align8 textlen) layoutaddr (align8 (+ stackaddr stacklen))
        layoutoff (align8 (+ stackoff stacklen)) relocoff (align8 (+ layoutoff layoutlen))
        symoff (+ relocoff (* nreloc 8)) stroff (+ symoff (* nsyms 16))
        strsize (+ (+ 9 (* locals 22)) (* externs 16))]
    (al-clear! [u8] (field p obj))
    ; mach_header_64
    (obj-u32! 4277009103) (obj-u32! 16777228) (obj-u32! 0) (obj-u32! 1)
    (obj-u32! 4) (obj-u32! 440) (obj-u32! 0) (obj-u32! 0)
    ; LC_SEGMENT_64 + text and two versioned metadata sections.
    (obj-u32! 25) (obj-u32! 312) (obj-name16! "")
    (obj-u64! 0) (obj-u64! (+ layoutaddr layoutlen))
    (obj-u64! textoff) (obj-u64! (- (+ layoutoff layoutlen) textoff))
    (obj-u32! 7) (obj-u32! 7) (obj-u32! 3) (obj-u32! 0)
    (obj-name16! "__text") (obj-name16! "__TEXT")
    (obj-u64! 0) (obj-u64! textlen) (obj-u32! textoff) (obj-u32! 2)
    (obj-u32! relocoff) (obj-u32! nreloc) (obj-u32! 2147484672)
    (obj-u32! 0) (obj-u32! 0) (obj-u32! 0)
    (obj-name16! "__aot_stackmap") (obj-name16! "__DATA")
    (obj-u64! stackaddr) (obj-u64! stacklen) (obj-u32! stackoff) (obj-u32! 3)
    (obj-u32! 0) (obj-u32! 0) (obj-u32! 0)
    (obj-u32! 0) (obj-u32! 0) (obj-u32! 0)
    (obj-name16! "__aot_layout") (obj-name16! "__DATA")
    (obj-u64! layoutaddr) (obj-u64! layoutlen)
    (obj-u32! layoutoff) (obj-u32! 3)
    (obj-u32! 0) (obj-u32! 0) (obj-u32! 0)
    (obj-u32! 0) (obj-u32! 0) (obj-u32! 0)
    ; LC_SYMTAB
    (obj-u32! 2) (obj-u32! 24) (obj-u32! symoff) (obj-u32! nsyms)
    (obj-u32! stroff) (obj-u32! strsize)
    ; LC_DYSYMTAB: local function symbols first, then the exported `_kernel` definition.
    (obj-u32! 11) (obj-u32! 80)
    (obj-u32! 0) (obj-u32! locals)
    (obj-u32! locals) (obj-u32! 1)
    (obj-u32! basesyms) (obj-u32! externs)
    (let [(mut z) 0]
      (loop (if (>= (load z) 12) (break)
              (do (obj-u32! 0) (store! z (+ (load z) 1)) 0))))
    ; LC_BUILD_VERSION: macOS, minimum 11.0, SDK 11.0, no tool records.
    (obj-u32! 50) (obj-u32! 24) (obj-u32! 1) (obj-u32! 720896)
    (obj-u32! 720896) (obj-u32! 0)
    (obj-pad-to! textoff)
    (let [(mut i) 0]
      (loop
        (if (>= (load i) textlen) (break)
          (do (obj-u8! (be-code-byte (load i))) (store! i (+ (load i) 1)) 0))))
    (obj-pad-to! stackoff) (mobj-write-stackmaps!)
    (obj-pad-to! layoutoff) (mobj-write-layouts!)
    (obj-pad-to! relocoff)
    (let [(mut at) 0]
      (loop
        (if (>= (load at) (be-inst-count)) (break)
          (do
            (if (and (be-runtime-allocation?) (= (ms-inst-op (load at)) MI-NEW))
                (do
                  (obj-u32! (mobj-new-branch-pc (load at)))
                  ; ARM64_RELOC_BRANCH26, extern, 32-bit, pc-relative, symbol `basesyms`.
                  (obj-u32! (mobj-branch-reloc-info basesyms)) 0) 0)
            (store! at (+ (load at) 1)) 0))) 0)
    (obj-pad-to! symoff)
    ; Local nlist_64 records precede the exported entry as required by LC_DYSYMTAB.
    (let [(mut owner) 1 (mut strx) 9]
      (loop
        (if (>= (load owner) funcs) (break)
          (do
            (obj-u32! (load strx)) (obj-u8! 14) (obj-u8! 1)
            (obj-u8! 0) (obj-u8! 0) (obj-u64! (mu-function-code-start (load owner)))
            (store! strx (+ (load strx) 22))
            (store! owner (+ (load owner) 1)) 0))))
    ; `_kernel` is the sole externally visible definition.
    (obj-u32! 1) (obj-u8! 15) (obj-u8! 1) (obj-u8! 0) (obj-u8! 0)
    (obj-u64! (if (> funcs 0) (mu-function-code-start 0) 0))
    (if (> externs 0)
        (do (obj-u32! (+ 9 (* locals 22)))
            (obj-u8! 1) (obj-u8! 0) (obj-u8! 0) (obj-u8! 0) (obj-u64! 0) 0) 0)
    ; String table: leading NUL, `_kernel`, then fixed-width local names.
    (obj-u8! 0) (obj-ascii! "_kernel") (obj-u8! 0)
    (let [(mut owner) 1]
      (loop
        (if (>= (load owner) funcs) (break)
          (do (obj-local-name! (load owner)) (obj-u8! 0)
              (store! owner (+ (load owner) 1)) 0))))
    (if (> externs 0) (do (obj-ascii! "_aot_alloc_slow") (obj-u8! 0) 0) 0)
    (al-len [u8] (load (field p obj)))))

(defn be-macho-checked! [] (-> bool)
  (let [p (backend)]
    ; Never let a previous successful publication survive a new validation attempt.
    (al-clear! [u8] (field p obj))
    (if (or (!= (be-result) BER-OK) (= (be-code-len) 0))
        (be-fail! BER-OBJECT NO-NODE)
      (if (not (mobj-verify-model!))
          (be-fail! BER-OBJECT (mobj-item))
        (if (<= (be-macho!) (be-code-len)) (be-fail! BER-OBJECT NO-NODE)
          (if (mobj-verify-bytes!) true (be-fail! BER-OBJECT (mobj-item))))))))

(defn be-object-len [] (-> i64)
  (if (= (be-result) BER-OK) (al-len [u8] (load (field (backend) obj))) 0))
(defn be-object-byte [(i i64)] (-> i64) (cast i64 (al-get (load (field (backend) obj)) i)))
(defn be-object-data [] (-> (ptr u8)) (load (field (field (backend) obj) data)))
