(defn a64-cmp-reg [(rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 1 29) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) 31)))))))
(defn a64-csinc [(rd i64) (rn i64) (rm i64) (cnd i64)] (-> i64)
  (| (<< 1 31) (| (<< 212 21) (| (<< rm 16) (| (<< cnd 12) (| (<< 1 10) (| (<< rn 5) rd)))))))
