;; M10 arm64 backend: machine IR, scheduling, register allocation, and encoding.
(module backend)

(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(const MI-MOVI i64 0)
(const MI-ADD i64 1)
(const MI-SUB i64 2)
(const MI-MUL i64 3)
(const MI-SDIV i64 4)
(const MI-NEG i64 5)
(const MI-RET i64 6)
(const MI-ARG i64 7)
(const MI-EQ i64 8)
(const MI-LT i64 9)
(const MI-LE i64 10)
(const MI-LABEL i64 11)
(const MI-CBZ i64 12)
(const MI-CSEL i64 13)
(const MI-MOV i64 14)
(const MI-B i64 15)
(const MI-NEW i64 16)
(const MI-LOAD i64 17)
(const MI-STORE i64 18)
(const MI-CBR i64 19)  ; block conditional: a=predicate, b=true block, imm=false block
(const MI-JMP i64 20)  ; block jump: imm=target block
(const MI-COPY i64 21)  ; resolved edge copy: dst <- a
(const MI-CALL i64 22)  ; direct call: dst=result, a=arg0, imm=machine function
(const MI-STACKARG i64 23)  ; callee incoming stack argument, imm=contiguous stack slot
(const MI-ABI-COPY i64 24)  ; early allocatable copy from a fixed ABI ingress vreg
(const MI-JSBOX i64 25)
(const MI-JSUNBOX i64 26)
(const MI-JSTEST i64 27)
(const MI-FMOVI i64 28)  ; exact IEEE bits -> FP vreg
(const MI-SCVTF i64 29)  ; signed i64 -> f64
(const MI-FADD i64 30)
(const MI-FSUB i64 31)
(const MI-FMUL i64 32)
(const MI-FDIV i64 33)
(const MI-FNEG i64 34)
(const MI-FEQ i64 35)  ; FP inputs, boolean GPR output
(const MI-FLT i64 36)
(const MI-FLE i64 37)
(const MI-FTRUTH i64 38)  ; FP Number truthiness -> boolean GPR
(const MI-MOD i64 39)
(const MI-BITAND i64 40)
(const MI-BITOR i64 41)
(const MI-BITXOR i64 42)
(const MI-SHL i64 43)
(const MI-SHR i64 44)
(const MI-USHR i64 45)
(const MI-BITNOT i64 46)
(const MI-I32FROMFP i64 47)  ; JavaScript ToInt32/ToUint32 residue: f64 -> low 32 bits
(const MI-FMOD i64 48)  ; JavaScript Number remainder, including signed zero
(const MI-JSPROP i64 49)  ; external named-property runtime: a=owner, b=value/prototype, imm=operation
(const MI-JSARRAY i64 50)  ; external dense-array runtime: a=owner, b=index, arg0=boxed value, imm=operation
(const MI-JSSTRING i64 51)  ; external immutable UTF-16 runtime: a,b,arg0 plus operation
(const JSSOP-NEW i64 0)
(const JSSOP-SET-UNIT i64 1)
(const JSSOP-LENGTH i64 2)
(const JSSOP-EQUAL i64 3)
(const JSSOP-CONCAT i64 4)
(const JSSOP-CHAR-CODE i64 5)
(const JSSOP-SUBSTRING i64 6)
(const JSSOP-FROM-INT i64 10)
(const JSSOP-FROM-BOOL i64 11)
(const JSSOP-FROM-NULL i64 12)
(const JSSOP-FROM-UNDEFINED i64 13)
(const JSSOP-PARSE-INT i64 14)
(const JSSOP-IS-NAN i64 15)
(const JSSOP-SPLIT i64 16)
(const JSSOP-IS-NAN-VALUE i64 17)
(const JSSOP-FROM-CODE-UNIT i64 18)
(const JSSOP-FROM-INT-RADIX i64 19)
(const JSSOP-FROM-DOUBLE-BITS i64 20)
(const JSSOP-LOWER i64 21)
(const JSSOP-UPPER i64 22)
(const JSSOP-INDEX-OF i64 23)
(const JSSOP-COMPARE i64 24)
(const JSSOP-FROM-VALUE i64 25)
(const JSSOP-VALUE-EQUAL i64 26)
(const JSSOP-VALUE-TRUTHY i64 27)
(const JSSOP-BUILTIN-BASE i64 100)

; Stable public result codes. Success is the only state in which generated code or object bytes
; are consumable. Later milestones may replace an unsupported result with success, but must never
; renumber or reuse an existing code.
(const BER-OK i64 0)
(const BER-MALFORMED-GRAPH i64 1)
(const BER-UNSUPPORTED-OPCODE i64 2)
(const BER-UNSUPPORTED-CFG i64 3)
(const BER-UNSUPPORTED-PHI i64 4)
(const BER-UNSUPPORTED-CALL i64 5)
(const BER-UNSUPPORTED-CALL-LIVE i64 6)
(const BER-ALLOCATION i64 7)
(const BER-ENCODING i64 8)
(const BER-OBJECT i64 9)

; Machine-CFG verifier results are stable for the same reason as backend phase results: focused
; corruption fixtures must name the broken law instead of collapsing to a generic false.
(const MCFG-OK i64 0)
(const MCFG-OWNER i64 1)
(const MCFG-RECIPROCITY i64 2)
(const MCFG-PREDECESSOR-SLOT i64 3)
(const MCFG-TERMINATOR-ARITY i64 4)
(const MCFG-RPO i64 5)
(const MCFG-FUNCTION-ISOLATION i64 6)
(const MCFG-IDOM i64 7)

(const MSEL-OK i64 0)
(const MSEL-OWNER i64 1)
(const MSEL-DUPLICATE i64 2)
(const MSEL-DEPENDENCY i64 3)
(const MSEL-TERMINATOR i64 4)
(const MSEL-UNSUPPORTED i64 5)
(const MSEL-PHI i64 6)
(const MSEL-CALL i64 7)
(const MSEL-CALL-LIVE i64 8)
(const MSEL-PLACEMENT i64 9)
(const MSEL-MEMORY-ORDER i64 10)

(const MABI-OK i64 0)
(const MABI-FRAME i64 1)
(const MABI-SPILL i64 2)
(const MABI-ARGUMENT i64 3)

(const MSCHED-OK i64 0)
(const MSCHED-CYCLE i64 1)
(const MSCHED-DEPENDENCY i64 2)
(const MSCHED-MEMORY i64 3)
(const MSCHED-EXACTLY-ONCE i64 4)
(const MSCHED-BOUNDARY i64 5)

(const MLIVE-OK i64 0)
(const MLIVE-RANGE i64 1)
(const MLIVE-FIXPOINT i64 2)
(const MLIVE-PHI i64 3)
(const MLIVE-KIND i64 4)
(const MLIVE-SAFEPOINT i64 5)
(const MLIVE-CLASS i64 6)

(const MLK-SCALAR i64 0)
(const MLK-RAW-MANAGED i64 1)
(const MLK-BOXED i64 2)
(const MLK-NONMOVING i64 3)
(const JSV-RAW-NULLABLE-OBJECT i64 -2)


;; Register classes are independent of GC kinds: an f64 is a scalar for stack-map purposes but
;; cannot share a physical register or an interference color with an integer scalar.
(const MRC-GPR i64 0)
(const MRC-FPR i64 1)

(const MRA-OK i64 0)
(const MRA-INTERFERENCE i64 1)
(const MRA-FIXED i64 2)
(const MRA-LOCATION i64 3)
(const MRA-SPILL-KIND i64 4)
(const MRA-COALESCE i64 5)

(const MOBJ-OK i64 0)
(const MOBJ-HEADER i64 1)
(const MOBJ-FUNCTION-RANGE i64 2)
(const MOBJ-SYMBOL i64 3)
(const MOBJ-RELOCATION i64 4)
(const MOBJ-STACKMAP i64 5)
(const MOBJ-LAYOUT i64 6)
(const MOBJ-ATOMIC i64 7)

(defstruct MInst
  [(op i64)
   (dst i64)
   (a i64)
   (b i64)
   (imm i64)
   (node i64)
   (owner i64)
   (block-id i64)
   (mem-first i64)
   (mem-count i64)
   (anti-first i64)
   (anti-count i64)
   (arg-first i64)
   (arg-count i64)
   (reg i64)
   (spill i64)
   (first i64)
   (last i64)
   (earliest i64)
   (latest i64)
   (schedule-order i64)])

(defstruct MOpcodeDesc
  [(inputs i64)
   (outputs i64)
   (temporaries i64)
   (clobbers i64)
   (effects i64)
   (pinned bool)
   (memory bool)
   (terminator bool)
   (encodable bool)])

; These records intentionally use indexes into unit-owned tables. Stable indexes survive later
; edge splitting and avoid pointers becoming stale when an ArrayList grows.
(defstruct MFunction
  [(id i64)
   (ideal i64)
   (entry i64)
   (block-first i64)
   (block-count i64)
   (return-first i64)
   (return-count i64)
   (frame-size i64)
   (callee-mask i64)
   (callee-count i64)
   (code-start i64)
   (code-size i64)])

(defstruct MBlock
  [(id i64)
   (owner i64)
   (ideal-ctrl i64)
   (pred-first i64)
   (pred-count i64)
   (succ-first i64)
   (succ-count i64)
   (inst-first i64)
   (inst-count i64)
   (loop-depth i64)
   (layout-index i64)])

(defstruct MEdge
  [(id i64)
   (owner i64)
   (source i64)
   (target i64)
   (target-slot i64)
   (copy-first i64)
   (copy-count i64)
   (move-first i64)
   (move-count i64)])

(const MCOPY-VALUE i64 0)
(const MCOPY-MEMORY i64 1)

; Phi transport belongs to an incoming edge, not to either endpoint block.  Keeping the ideal
; Phi and its selected source in the record makes target-slot mistakes independently verifiable.
(defstruct MCopy
  [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)])

(defstruct MMove
  [(edge i64) (dst i64) (src i64) (temporary bool)])

(defstruct MachineUnit
  [(functions (ArrayList MFunction))
   (blocks (ArrayList MBlock))
   (edges (ArrayList MEdge))
   (returns (ArrayList i64))
   (pred-edges (ArrayList i64))
   (succ-edges (ArrayList i64))
   (edge-copies (ArrayList MCopy))
   (edge-moves (ArrayList MMove))
   (copy-work-dst (ArrayList i64))
   (copy-work-src (ArrayList i64))
   (copy-work-live (ArrayList i64))
   (symbols (ArrayList i64))
   (runtime-deps (ArrayList i64))
   (ctrl-block (ArrayList i64))
   (block-order (ArrayList i64))
   (block-idom (ArrayList i64))
   (rpo-seen (ArrayList i64))
   (rpo-post (ArrayList i64))
   (selected-values (ArrayList i64))
   (selected-nodes (ArrayList i64))
   (packed-insts (ArrayList MInst))
   (selection-memory-deps (ArrayList i64))
   (memory-anti-deps (ArrayList i64))
   (call-args (ArrayList i64))
   (schedule-work (ArrayList MInst))
   (schedule-done (ArrayList i64))
   (vreg-new-def (ArrayList i64))
   ;; vreg -> target block for Phi definitions, or -1 for ordinary instruction definitions.
   ;; GCM queries this for nearly every operand; deriving it by rescanning all edge-copy tables
   ;; makes large Phi-heavy programs quadratic.
   (vreg-phi-block (ArrayList i64))
   (live-use (ArrayList i64))
   (live-def (ArrayList i64))
   (live-in (ArrayList i64))
   (live-out (ArrayList i64))
   (edge-live (ArrayList i64))
   (value-kind (ArrayList i64))
   (register-class (ArrayList i64))
   (alloc-interference (ArrayList i64))
   (alloc-expected (ArrayList i64))
   (alloc-live (ArrayList i64))
   (alloc-reg (ArrayList i64))
   (alloc-spill (ArrayList i64))
   (alloc-owner (ArrayList i64))
   (alloc-forbidden (ArrayList i64))
   (alloc-spill-kind (ArrayList i64))
   (phase i64)
   (next-vreg i64)
   (verify-result i64)
   (verify-item i64)
   (selection-result i64)
   (selection-item i64)
   (schedule-result i64)
   (schedule-item i64)
   (schedule-seed i64)
   (liveness-result i64)
   (liveness-item i64)
   (liveness-seed i64)
   (liveness-rounds i64)
   (allocation-result i64)
   (allocation-item i64)
   (allocation-seed i64)
   (inited bool)])

(defn machine-unit [] (-> (ptr MachineUnit))
  (let [u (static MachineUnit)]
    (if (load (field u inited))
        0
        (do
          (store! (field u functions) (al-new [MFunction] (malloc-allocator)))
          (store! (field u blocks) (al-new [MBlock] (malloc-allocator)))
          (store! (field u edges) (al-new [MEdge] (malloc-allocator)))
          (store! (field u returns) (al-new [i64] (malloc-allocator)))
          (store! (field u pred-edges) (al-new [i64] (malloc-allocator)))
          (store! (field u succ-edges) (al-new [i64] (malloc-allocator)))
          (store! (field u edge-copies) (al-new [MCopy] (malloc-allocator)))
          (store! (field u edge-moves) (al-new [MMove] (malloc-allocator)))
          (store! (field u copy-work-dst) (al-new [i64] (malloc-allocator)))
          (store! (field u copy-work-src) (al-new [i64] (malloc-allocator)))
          (store! (field u copy-work-live) (al-new [i64] (malloc-allocator)))
          (store! (field u symbols) (al-new [i64] (malloc-allocator)))
          (store! (field u runtime-deps) (al-new [i64] (malloc-allocator)))
          (store! (field u ctrl-block) (al-new [i64] (malloc-allocator)))
          (store! (field u block-order) (al-new [i64] (malloc-allocator)))
          (store! (field u block-idom) (al-new [i64] (malloc-allocator)))
          (store! (field u rpo-seen) (al-new [i64] (malloc-allocator)))
          (store! (field u rpo-post) (al-new [i64] (malloc-allocator)))
          (store! (field u selected-values) (al-new [i64] (malloc-allocator)))
          (store! (field u selected-nodes) (al-new [i64] (malloc-allocator)))
          (store! (field u packed-insts) (al-new [MInst] (malloc-allocator)))
          (store! (field u selection-memory-deps) (al-new [i64] (malloc-allocator)))
          (store! (field u memory-anti-deps) (al-new [i64] (malloc-allocator)))
          (store! (field u call-args) (al-new [i64] (malloc-allocator)))
          (store! (field u schedule-work) (al-new [MInst] (malloc-allocator)))
          (store! (field u schedule-done) (al-new [i64] (malloc-allocator)))
          (store! (field u vreg-new-def) (al-new [i64] (malloc-allocator)))
          (store! (field u vreg-phi-block) (al-new [i64] (malloc-allocator)))
          (store! (field u live-use) (al-new [i64] (malloc-allocator)))
          (store! (field u live-def) (al-new [i64] (malloc-allocator)))
          (store! (field u live-in) (al-new [i64] (malloc-allocator)))
          (store! (field u live-out) (al-new [i64] (malloc-allocator)))
          (store! (field u edge-live) (al-new [i64] (malloc-allocator)))
          (store! (field u value-kind) (al-new [i64] (malloc-allocator)))
          (store! (field u register-class) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-interference) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-expected) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-live) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-reg) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-spill) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-owner) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-forbidden) (al-new [i64] (malloc-allocator)))
          (store! (field u alloc-spill-kind) (al-new [i64] (malloc-allocator)))
          (store! (field u inited) true)
          0))
    u))

(defn mu-reset! [] (-> i64)
  (let [u (machine-unit)]
    (al-clear! [MFunction] (field u functions))
    (al-clear! [MBlock] (field u blocks))
    (al-clear! [MEdge] (field u edges))
    (al-clear! [i64] (field u returns))
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (al-clear! [i64] (field u symbols))
    (al-clear! [i64] (field u runtime-deps))
    (al-clear! [i64] (field u ctrl-block))
    (al-clear! [i64] (field u block-order))
    (al-clear! [i64] (field u block-idom))
    (al-clear! [i64] (field u rpo-seen))
    (al-clear! [i64] (field u rpo-post))
    (al-clear! [i64] (field u selected-values))
    (al-clear! [i64] (field u selected-nodes))
    (al-clear! [MInst] (field u packed-insts))
    (al-clear! [i64] (field u selection-memory-deps))
    (al-clear! [i64] (field u memory-anti-deps))
    (al-clear! [i64] (field u call-args))
    (al-clear! [MInst] (field u schedule-work))
    (al-clear! [i64] (field u schedule-done))
    (al-clear! [i64] (field u vreg-new-def))
    (al-clear! [i64] (field u vreg-phi-block))
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (al-clear! [i64] (field u value-kind))
    (al-clear! [i64] (field u register-class))
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-expected))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (let [(mut i) 0]
      (loop (if (>= (load i) (n-count))
                (break)
                (do
                  (al-push! [i64] (field u ctrl-block) -1)
                  (store! i (+ (load i) 1))
                  0))))
    (store! (field u phase) 0)
    (store! (field u next-vreg) 0)
    (store! (field u verify-result) MCFG-OK)
    (store! (field u verify-item) -1)
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (store! (field u schedule-seed) 0)
    (store! (field u liveness-result) MLIVE-OK)
    (store! (field u liveness-item) -1)
    (store! (field u liveness-seed) 0)
    (store! (field u liveness-rounds) 0)
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (store! (field u allocation-seed) 0)
    0))

(defn mu-function-count [] (-> i64)
  (al-len [MFunction] (load (field (machine-unit) functions))))
(defn mu-block-count [] (-> i64)
  (al-len [MBlock] (load (field (machine-unit) blocks))))
(defn mu-edge-count [] (-> i64)
  (al-len [MEdge] (load (field (machine-unit) edges))))
(defn mu-verify-result [] (-> i64)
  (load (field (machine-unit) verify-result)))
(defn mu-verify-item [] (-> i64)
  (load (field (machine-unit) verify-item)))

(defn mf-new [(id i64) (ideal i64) (entry i64)] (-> MFunction)
  (let [p (stack MFunction)]
    (store! (field p id) id)
    (store! (field p ideal) ideal)
    (store! (field p entry) entry)
    (store! (field p block-first) -1)
    (store! (field p block-count) 0)
    (store! (field p return-first) -1)
    (store! (field p return-count) 0)
    (store! (field p frame-size) -1)
    (store! (field p callee-mask) 0)
    (store! (field p callee-count) 0)
    (store! (field p code-start) -1)
    (store! (field p code-size) 0)
    (load p)))

(defn mb-new [(id i64) (owner i64) (ctrl i64)] (-> MBlock)
  (let [p (stack MBlock)]
    (store! (field p id) id)
    (store! (field p owner) owner)
    (store! (field p ideal-ctrl) ctrl)
    (store! (field p pred-first) -1)
    (store! (field p pred-count) 0)
    (store! (field p succ-first) -1)
    (store! (field p succ-count) 0)
    (store! (field p inst-first) -1)
    (store! (field p inst-count) 0)
    (store! (field p loop-depth) 0)
    (store! (field p layout-index) -1)
    (load p)))

(defn me-new [(id i64) (owner i64) (source i64) (target i64) (slot i64)] (-> MEdge)
  (let [p (stack MEdge)]
    (store! (field p id) id)
    (store! (field p owner) owner)
    (store! (field p source) source)
    (store! (field p target) target)
    (store! (field p target-slot) slot)
    (store! (field p copy-first) -1)
    (store! (field p copy-count) 0)
    (store! (field p move-first) -1)
    (store! (field p move-count) 0)
    (load p)))

(defn mc-new [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)] (-> MCopy)
  (let [p (stack MCopy)]
    (store! (field p edge) edge)
    (store! (field p phi) phi)
    (store! (field p dst) dst)
    (store! (field p src) src)
    (store! (field p kind) kind)
    (load p)))

(defn mm-new [(edge i64) (dst i64) (src i64) (temporary bool)] (-> MMove)
  (let [p (stack MMove)]
    (store! (field p edge) edge)
    (store! (field p dst) dst)
    (store! (field p src) src)
    (store! (field p temporary) temporary)
    (load p)))

(defn mu-function [(i i64)] (-> (ptr MFunction))
  (be-al-elem [MFunction] (field (machine-unit) functions) i))
(defn mu-block [(i i64)] (-> (ptr MBlock))
  (be-al-elem [MBlock] (field (machine-unit) blocks) i))
(defn mu-edge [(i i64)] (-> (ptr MEdge))
  (be-al-elem [MEdge] (field (machine-unit) edges) i))
(defn mu-block-owner [(i i64)] (-> i64)
  (load (field (mu-block i) owner)))
(defn mu-block-control [(i i64)] (-> i64)
  (load (field (mu-block i) ideal-ctrl)))
(defn mu-edge-source [(i i64)] (-> i64)
  (load (field (mu-edge i) source)))
(defn mu-edge-target [(i i64)] (-> i64)
  (load (field (mu-edge i) target)))
(defn mu-edge-target-slot [(i i64)] (-> i64)
  (load (field (mu-edge i) target-slot)))
(defn mu-edge-copy-count [(i i64)] (-> i64)
  (load (field (mu-edge i) copy-count)))
(defn mu-edge-copy [(edge i64) (which i64)] (-> (ptr MCopy))
  (let [first (load (field (mu-edge edge) copy-first))]
    (be-al-elem [MCopy] (field (machine-unit) edge-copies) (+ first which))))
(defn mu-copy-phi [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) phi)))
(defn mu-copy-dst [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) dst)))
(defn mu-copy-src [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) src)))
(defn mu-copy-kind [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-copy edge which) kind)))
(defn mu-edge-move-count [(i i64)] (-> i64)
  (load (field (mu-edge i) move-count)))
(defn mu-edge-move [(edge i64) (which i64)] (-> (ptr MMove))
  (let [first (load (field (mu-edge edge) move-first))]
    (be-al-elem [MMove] (field (machine-unit) edge-moves) (+ first which))))
(defn mu-move-dst [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-move edge which) dst)))
(defn mu-move-src [(edge i64) (which i64)] (-> i64)
  (load (field (mu-edge-move edge which) src)))
(defn mu-move-temporary? [(edge i64) (which i64)] (-> bool)
  (load (field (mu-edge-move edge which) temporary)))
(defn mu-function-ideal [(i i64)] (-> i64)
  (load (field (mu-function i) ideal)))
(defn mu-function-block-count [(i i64)] (-> i64)
  (load (field (mu-function i) block-count)))
(defn mu-function-frame-size [(i i64)] (-> i64)
  (load (field (mu-function i) frame-size)))
(defn mu-function-code-start [(i i64)] (-> i64)
  (load (field (mu-function i) code-start)))
(defn mu-function-code-size [(i i64)] (-> i64)
  (load (field (mu-function i) code-size)))
(defn mu-function-callee-mask [(i i64)] (-> i64)
  (load (field (mu-function i) callee-mask)))
(defn mu-function-callee-count [(i i64)] (-> i64)
  (load (field (mu-function i) callee-count)))
(defn mu-function-block [(fun i64) (rpo i64)] (-> i64)
  (let [f (mu-function fun)]
    (al-get (load (field (machine-unit) block-order))
            (+ (load (field f block-first)) rpo))))
(defn mu-function-return-count [(fidx i64)] (-> i64)
  (load (field (mu-function fidx) return-count)))
(defn mu-function-return-block [(fidx i64) (i i64)] (-> i64)
  (let [f (mu-function fidx)]
    (al-get (load (field (machine-unit) returns))
            (+ (load (field f return-first)) i))))
(defn mu-block-layout-index [(i i64)] (-> i64)
  (load (field (mu-block i) layout-index)))
(defn mu-block-loop-depth [(i i64)] (-> i64)
  (load (field (mu-block i) loop-depth)))
(defn mu-block-idom [(i i64)] (-> i64)
  (al-get (load (field (machine-unit) block-idom)) i))
(defn mu-block-inst-first [(i i64)] (-> i64)
  (load (field (mu-block i) inst-first)))
(defn mu-block-inst-count [(i i64)] (-> i64)
  (load (field (mu-block i) inst-count)))
(defn mu-block-succ-count [(i i64)] (-> i64)
  (load (field (mu-block i) succ-count)))
(defn mu-block-succ-edge [(bid i64) (i i64)] (-> i64)
  (let [b (mu-block bid)]
    (al-get (load (field (machine-unit) succ-edges))
            (+ (load (field b succ-first)) i))))
(defn mu-block-succ-target [(bid i64) (i i64)] (-> i64)
  (mu-edge-target (mu-block-succ-edge bid i)))

(defstruct Backend
  [(ins (ArrayList MInst))
   (nval (ArrayList i64))  ; graph node -> virtual register, -1 when unselected
   (mseen (ArrayList i64))
   (clabel (ArrayList i64))
   (code (ArrayList u8))
   (obj (ArrayList u8))
   (spills i64)
   (inloop bool)
   (result i64)
   (result-node i64)
   (verify-code i64)
   (object-result i64)
   (object-item i64)
   (runtime-allocation bool)
   (inited bool)])

(defn backend [] (-> (ptr Backend))
  (let [p (static Backend)]
    (if (load (field p inited))
        0
        (do
          (store! (field p inited) true)
          (store! (field p ins) (al-new [MInst] (malloc-allocator)))
          (store! (field p nval) (al-new [i64] (malloc-allocator)))
          (store! (field p mseen) (al-new [i64] (malloc-allocator)))
          (store! (field p clabel) (al-new [i64] (malloc-allocator)))
          (store! (field p code) (al-new [u8] (malloc-allocator)))
          (store! (field p obj) (al-new [u8] (malloc-allocator)))
          0))
    p))

(defn be-reset! [] (-> i64)
  (let [p (backend)
        (mut i) 0]
    (al-clear! [MInst] (field p ins))
    (al-clear! [i64] (field p nval))
    (al-clear! [i64] (field p mseen))
    (al-clear! [i64] (field p clabel))
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    (loop (if (>= (load i) (n-count))
              (break)
              (do
                (al-push! [i64] (field p nval) -1)
                (al-push! [i64] (field p mseen) 0)
                (al-push! [i64] (field p clabel) -1)
                (store! i (+ (load i) 1))
                0)))
    (store! (field p spills) 0)
    (store! (field p inloop) false)
    (store! (field p result) BER-OK)
    (store! (field p result-node) NO-NODE)
    (store! (field p verify-code) VERR-NONE)
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (store! (field p runtime-allocation) false)
    0))

(defn be-result [] (-> i64)
  (load (field (backend) result)))
(defn be-result-node [] (-> i64)
  (load (field (backend) result-node)))
(defn be-verify-code [] (-> i64)
  (load (field (backend) verify-code)))
(defn mobj-result [] (-> i64)
  (load (field (backend) object-result)))
(defn mobj-item [] (-> i64)
  (load (field (backend) object-item)))
(defn be-use-runtime-allocation! [(enabled bool)] (-> i64)
  (store! (field (backend) runtime-allocation) enabled)
  0)
(defn be-runtime-allocation? [] (-> bool)
  (load (field (backend) runtime-allocation)))

(defn be-result-name [(code i64)] (-> (slice u8))
  (case code BER-OK
        "BER-OK" BER-MALFORMED-GRAPH
        "BER-MALFORMED-GRAPH" BER-UNSUPPORTED-OPCODE
        "BER-UNSUPPORTED-OPCODE" BER-UNSUPPORTED-CFG
        "BER-UNSUPPORTED-CFG" BER-UNSUPPORTED-PHI
        "BER-UNSUPPORTED-PHI" BER-UNSUPPORTED-CALL
        "BER-UNSUPPORTED-CALL" BER-UNSUPPORTED-CALL-LIVE
        "BER-UNSUPPORTED-CALL-LIVE" BER-ALLOCATION
        "BER-ALLOCATION" BER-ENCODING
        "BER-ENCODING" BER-OBJECT
        "BER-OBJECT" "BER-?"))

(defn be-result-print [(w (ptr Writer))] (-> i64)
  (let [code (be-result)
        node (be-result-node)]
    (ps w (be-result-name code))
    (if (= node NO-NODE) 0 (do (fmt w " at n{d}" node) 0))
    (if (= code BER-MALFORMED-GRAPH)
        (do (ps w " (") (ps w (verr-name (be-verify-code))) (ps w ")") 0)
        0)
    (ps w "\n")
    0))

(defn be-fail! [(code i64) (node i64)] (-> bool)
  (let [p (backend)]
    (if (= (load (field p result)) BER-OK)
        (do (store! (field p result) code) (store! (field p result-node) node))
        0)
    ; Publication is atomic: a failure invalidates bytes from this and all prior compilations.
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    false))

(defn be-preflight! [] (-> bool)
  (if (= (g-verify) 0)
      ; Calls are rejected before control-shape walking so CallEnd cannot be misreported as a CFG
      ; accident and no callee/body instructions can leak into the current compilation.
      (let [n (n-count)
            (mut i) 0
            (mut call) NO-NODE]
        (loop (if (or (>= (load i) n) (!= (load call) NO-NODE))
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                        (store! call (load i))
                        0)
                    (store! i (+ (load i) 1))
                    0)))
        (if (!= (load call) NO-NODE)
            (be-fail! BER-UNSUPPORTED-CALL (load call))
            ; The prototype loop selector searches for one loop Phi. More than one is not a
            ; conservative subset: accepting it silently chooses whichever use happens to be last.
            (let [(mut loop-node) NO-NODE
                  (mut cfg-node) NO-NODE]
              (store! i 0)
              (loop (if (or (>= (load i) n) (!= (load loop-node) NO-NODE))
                        (break)
                        (do
                          (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-LOOP))
                              (let [outs (n-nouts (load i))
                                    (mut j) 0
                                    (mut phis) 0]
                                (loop (if (>= (load j) outs)
                                          (break)
                                          (do
                                            (let [u (n-out (load i) (load j))]
                                              (if (and (not (n-dead? u))
                                                       (and (= (n-op u) OP-PHI) (not (ty-mem? (n-ty u)))))
                                                  (store! phis (+ (load phis) 1))
                                                  0))
                                            (store! j (+ (load j) 1))
                                            0)))
                                (if (> (load phis) 1) (store! loop-node (load i)) 0)
                                ; A Region back edge means control branched inside the loop body. The
                                ; shape walker accepted this and emitted an infinite native loop.
                                (if (and (= (load cfg-node) NO-NODE)
                                         (!= (n-op (n-in (load i) 2)) OP-CPROJ))
                                    (store! cfg-node (load i))
                                    0))
                              0)
                          (store! i (+ (load i) 1))
                          0)))
              (if (!= (load loop-node) NO-NODE)
                  (be-fail! BER-UNSUPPORTED-PHI (load loop-node))
                  (if (!= (load cfg-node) NO-NODE)
                      (be-fail! BER-UNSUPPORTED-CFG (load cfg-node))
                      true)))))
      (do
        (store! (field (backend) verify-code) (g-verify-code))
        (be-fail! BER-MALFORMED-GRAPH (g-verify-node)))))

(defn mi-new [(op i64) (dst i64) (a i64) (b i64) (imm i64) (node i64)] (-> MInst)
  (let [p (stack MInst)]
    (store! (field p op) op)
    (store! (field p dst) dst)
    (store! (field p a) a)
    (store! (field p b) b)
    (store! (field p imm) imm)
    (store! (field p node) node)
    (store! (field p owner) -1)
    (store! (field p block-id) -1)
    (store! (field p mem-first) -1)
    (store! (field p mem-count) 0)
    (store! (field p anti-first) -1)
    (store! (field p anti-count) 0)
    (store! (field p arg-first) -1)
    (store! (field p arg-count) 0)
    (store! (field p reg) -1)
    (store! (field p spill) -1)
    (store! (field p first) -1)
    (store! (field p last) -1)
    (store! (field p earliest) -1)
    (store! (field p latest) -1)
    (store! (field p schedule-order) -1)
    (load p)))

(defn mi-desc-new [(inputs i64)
                   (outputs i64)
                   (effects i64)
                   (pinned bool)
                   (memory bool)
                   (terminator bool)
                   (encodable bool)] (-> MOpcodeDesc)
  (let [p (stack MOpcodeDesc)]
    (store! (field p inputs) inputs)
    (store! (field p outputs) outputs)
    (store! (field p temporaries) 0)
    (store! (field p clobbers) 0)
    (store! (field p effects) effects)
    (store! (field p pinned) pinned)
    (store! (field p memory) memory)
    (store! (field p terminator) terminator)
    (store! (field p encodable) encodable)
    (load p)))

(defn mi-desc [(op i64)] (-> MOpcodeDesc)
  (case op MI-MOVI
        (mi-desc-new 0 1 0 false false false true) MI-ARG
        (mi-desc-new 0 1 0 true false false true) MI-NEG
        (mi-desc-new 1 1 0 false false false true) MI-ADD
        (mi-desc-new 2 1 0 false false false true) MI-SUB
        (mi-desc-new 2 1 0 false false false true) MI-MUL
        (mi-desc-new 2 1 0 false false false true) MI-SDIV
        (mi-desc-new 2 1 0 false false false true) MI-EQ
        (mi-desc-new 2 1 0 false false false true) MI-LT
        (mi-desc-new 2 1 0 false false false true) MI-LE
        (mi-desc-new 2 1 0 false false false true) MI-NEW
        (mi-desc-new 0 1 3 true true false true) MI-LOAD
        (mi-desc-new 1 1 2 true true false true) MI-STORE
        (mi-desc-new 2 0 2 true true false true) MI-RET
        (mi-desc-new 1 0 1 true false true true) MI-CBR
        (mi-desc-new 1 0 1 true false true false) MI-JMP
        (mi-desc-new 0 0 1 true false true false) MI-CBZ
        (mi-desc-new 1 0 1 true false true true) MI-B
        (mi-desc-new 0 0 1 true false true true) MI-LABEL
        (mi-desc-new 0 0 1 true false false true) MI-CSEL
        (mi-desc-new 3 1 0 false false false true) MI-MOV
        (mi-desc-new 1 1 0 false false false true) MI-COPY
        (mi-desc-new 1 1 0 true false false true) MI-CALL
        (mi-desc-new 1 1 3 true true false true) MI-STACKARG
        (mi-desc-new 0 1 0 true false false true) MI-ABI-COPY
        (mi-desc-new 1 1 0 true false false true) MI-JSBOX
        (mi-desc-new 1 1 0 false false false true) MI-JSUNBOX
        (mi-desc-new 1 1 0 false false false true) MI-JSTEST
        (mi-desc-new 1 1 0 false false false true) MI-FMOVI
        (mi-desc-new 0 1 0 false false false true) MI-SCVTF
        (mi-desc-new 1 1 0 false false false true) MI-FADD
        (mi-desc-new 2 1 0 false false false true) MI-FSUB
        (mi-desc-new 2 1 0 false false false true) MI-FMUL
        (mi-desc-new 2 1 0 false false false true) MI-FDIV
        (mi-desc-new 2 1 0 false false false true) MI-FNEG
        (mi-desc-new 1 1 0 false false false true) MI-FEQ
        (mi-desc-new 2 1 0 false false false true) MI-FLT
        (mi-desc-new 2 1 0 false false false true) MI-FLE
        (mi-desc-new 2 1 0 false false false true) MI-FTRUTH
        (mi-desc-new 1 1 0 false false false true) MI-MOD
        (mi-desc-new 2 1 0 false false false true) MI-BITAND
        (mi-desc-new 2 1 0 false false false true) MI-BITOR
        (mi-desc-new 2 1 0 false false false true) MI-BITXOR
        (mi-desc-new 2 1 0 false false false true) MI-SHL
        (mi-desc-new 2 1 0 false false false true) MI-SHR
        (mi-desc-new 2 1 0 false false false true) MI-USHR
        (mi-desc-new 2 1 0 false false false true) MI-BITNOT
        (mi-desc-new 1 1 0 false false false true) MI-I32FROMFP
        (mi-desc-new 1 1 0 false false false true) MI-FMOD
        (mi-desc-new 2 1 0 false false false true) MI-JSPROP
        (mi-desc-new 2 1 3 true true false true) MI-JSARRAY
        (mi-desc-new 2 1 3 false false false true) MI-JSSTRING
        (mi-desc-new 2 1 3 false false false true) (mi-desc-new -1 -1 0 false false false false)))

(defn mi-desc-inputs [(d MOpcodeDesc)] (-> i64)
  (load (field d inputs)))
(defn mi-desc-outputs [(d MOpcodeDesc)] (-> i64)
  (load (field d outputs)))
(defn mi-desc-temporaries [(d MOpcodeDesc)] (-> i64)
  (load (field d temporaries)))
(defn mi-desc-clobbers [(d MOpcodeDesc)] (-> i64)
  ; Effect class 3 is a call/safepoint. x0-x11, d0-d7, and d16-d31 are caller-clobbered.
  ; Physical FP locations occupy bits 32..63 in allocator masks.
  (if (= (load (field d effects)) 3) -280379760046081 (load (field d clobbers))))
(defn mi-desc-effects [(d MOpcodeDesc)] (-> i64)
  (load (field d effects)))
(defn mi-desc-pinned? [(d MOpcodeDesc)] (-> bool)
  (load (field d pinned)))
(defn mi-desc-memory? [(d MOpcodeDesc)] (-> bool)
  (load (field d memory)))
(defn mi-desc-terminator? [(d MOpcodeDesc)] (-> bool)
  (load (field d terminator)))
(defn mi-desc-encodable? [(d MOpcodeDesc)] (-> bool)
  (load (field d encodable)))

; Keep struct-valued descriptor temporaries out of large compiler loops. Coil currently lowers a
; struct result bound inside a loop as dynamic stack storage whose lifetime is the surrounding
; function; these scalar wrappers bound that storage to one ordinary call frame.
(defn mi-op-inputs [(op i64)] (-> i64)
  (mi-desc-inputs (mi-desc op)))
(defn mi-op-pinned? [(op i64)] (-> bool)
  (mi-desc-pinned? (mi-desc op)))
(defn mi-op-terminator? [(op i64)] (-> bool)
  (mi-desc-terminator? (mi-desc op)))
(defn mi-op-effects [(op i64)] (-> i64)
  (mi-desc-effects (mi-desc op)))

(defn be-emit! [(m MInst)] (-> i64)
  (let [p (backend)
        id (al-len [MInst] (load (field p ins)))]
    (al-push! [MInst] (field p ins) m)
    id))

(defn be-js-tag-for-type [(t i64)] (-> i64)
  (case (ty-kinds t) VK-UNDEF
        JSV-UNDEFINED VK-NULL
        JSV-NULL VK-BOOL
        JSV-BOOLEAN VK-INT
        JSV-INTEGER VK-FLT
        0 VK-STR
        JSV-STRING VK-OBJ
        JSV-OBJECT VK-FUN
        JSV-FUNCTION -1))

;; Arrays deliberately retain the ordinary object lattice type: indexing capability is an IR
;; property, not a new source-language nominal type.  Boxing must therefore preserve ArrayMark
;; provenance instead of deriving the tag from the lattice alone.  Casts and homogeneous value
;; Phis retain that provenance; a mixed or unresolved Phi conservatively remains an Object.
(defn be-array-value? [(node i64) (fuel i64)] (-> bool)
  (if (or (= node NO-NODE) (or (<= fuel 0) (n-dead? node)))
      false
      (case (n-op node) OP-ARRAYMARK
            true OP-CAST
            (be-array-value? (n-in node 1) (- fuel 1)) OP-PHI
            (let [(mut input) 1
                  (mut evidence) false
                  (mut valid) true]
              (loop (if (or (>= (load input) (n-nins node)) (not (load valid)))
                        (break)
                        (let [value (n-in node (load input))]
                          (if (= value node)
                              0
                              (if (be-array-value? value (- fuel 1))
                                  (store! evidence true)
                                  (store! valid false)))
                          (store! input (+ (load input) 1)))))
              (and (load evidence) (load valid)))
              false)))

(defn be-function-return-kind-fuel [(owner i64) (fuel i64)] (-> i64)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut answer) -1
        (mut boxable) true
        (mut consistent) true]
    (loop (if (or (>= (load i) count) (not (load consistent)))
              (break)
              (let [bid (mu-function-return-block owner (load i))
                    term (mu-block-terminator bid)]
                (if (and (!= term NO-NODE) (= (n-op term) OP-RETURN))
                    (let [value (n-in term 1)]
                      (if (= (n-op value) OP-CALL)
                          ;; Call nodes have lattice type `dyn` regardless of their eventual native
                          ;; ABI. Looking only at that type labels every delegated numeric return as
                          ;; boxed. Follow the bounded call graph instead; recursive edges exhaust
                          ;; their fuel and contribute no evidence until a concrete return arm does.
                          (let [kind
                                  (if (> fuel 0)
                                      (be-call-return-kind-fuel value (- fuel 1))
                                      -1)]
                            (if (>= kind 0)
                                (if (< (load answer) 0)
                                    (store! answer kind)
                                    (if (!= (load answer) kind)
                                        (if (load boxable)
                                            (store! answer MLK-BOXED)
                                            (store! consistent false))
                                        0))
                                0))
                          (let [kind (if (be-node-fp-value? value)
                                         MLK-SCALAR
                                         (ml-kind-for-source-representation value))]
                            (if (or (be-box-input-already-tagged? value)
                                    (!= (be-js-tag-for-value value) -1))
                                0
                                (store! boxable false))
                            (if (< kind 0)
                                (store! consistent false)
                                (if (< (load answer) 0)
                                    (store! answer kind)
                                    (if (!= (load answer) kind)
                                        (if (load boxable)
                                            ;; Heterogeneous but individually taggable source
                                            ;; returns share the boxed JavaScript return ABI.
                                            (store! answer MLK-BOXED)
                                            (store! consistent false))
                                        0))))))
                    0)
                (store! i (+ (load i) 1)))))
    (if (load consistent) (load answer) -1)))

(defn be-function-return-kind [(owner i64)] (-> i64)
  (be-function-return-kind-fuel owner 32))

(defn be-call-return-kind-fuel [(call i64) (fuel i64)] (-> i64)
  (let [targets (infer-call-targets call)
        funcs (mu-function-count)
        (mut owner) 0
        (mut answer) -1
        (mut saw) false
        (mut consistent) true]
    (loop (if (or (>= (load owner) funcs) (not (load consistent)))
              (break)
              (let [fun (mu-function-ideal (load owner))]
                (if (and (!= fun NO-NODE)
                         (and (= (n-op fun) OP-FUN)
                              (and (>= (n-aux fun) 0)
                                   (and (< (n-aux fun) 63)
                                        (!= (& targets (<< 1 (n-aux fun))) 0)))))
                    (let [kind (be-function-return-kind-fuel (load owner) fuel)]
                      (store! saw true)
                      (if (< kind 0)
                          (store! consistent false)
                          (if (< (load answer) 0)
                              (store! answer kind)
                              (if (!= (load answer) kind) (store! consistent false) 0))))
                    0)
                (store! owner (+ (load owner) 1)))))
    (if (and (load saw) (load consistent)) (load answer) -1)))

(defn be-call-return-kind [(call i64)] (-> i64)
  (be-call-return-kind-fuel call 32))

(defn be-function-return-mixed? [(owner i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut first) -1
        (mut mixed) false]
    (loop (if (or (>= (load i) count) (load mixed))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load i)))]
                (if (and (!= term NO-NODE) (= (n-op term) OP-RETURN))
                    (let [value (n-in term 1)]
                      (if (= (n-op value) OP-CALL)
                          0
                          (let [kind (if (be-node-fp-value? value)
                                         MLK-SCALAR
                                         (ml-kind-for-source-representation value))]
                            (if (< (load first) 0)
                                (store! first kind)
                                (if (!= (load first) kind) (store! mixed true) 0)))))
                    0)
                (store! i (+ (load i) 1)))))
    (load mixed)))

(defn be-function-return-tag-fuel [(owner i64) (fuel i64)] (-> i64)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut answer) -1
        (mut consistent) true]
    (loop (if (or (>= (load i) count) (not (load consistent)))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load i)))]
                (if (and (!= term NO-NODE) (= (n-op term) OP-RETURN))
                    (let [value (n-in term 1)]
                      (if (= (n-op value) OP-CALL)
                          (let [tag
                                  (if (> fuel 0)
                                      (be-call-return-tag-fuel value (- fuel 1))
                                      -1)]
                            (if (>= tag 0)
                                (if (< (load answer) 0)
                                    (store! answer tag)
                                    (if (!= (load answer) tag)
                                        (store! consistent false)
                                        0))
                                0))
                          (let [tag (if (be-node-fp-value? value)
                                        0
                                        (be-js-tag-for-type (n-ty value)))]
                            (if (< tag 0)
                                (store! consistent false)
                                (if (< (load answer) 0)
                                    (store! answer tag)
                                    (if (!= (load answer) tag)
                                        (store! consistent false)
                                        0))))))
                    0)
                (store! i (+ (load i) 1)))))
    (if (load consistent) (load answer) -1)))

(defn be-function-return-tag [(owner i64)] (-> i64)
  (be-function-return-tag-fuel owner 32))

(defn be-call-return-tag-fuel [(call i64) (fuel i64)] (-> i64)
  (let [targets (infer-call-targets call)
        funcs (mu-function-count)
        (mut owner) 0
        (mut answer) -1
        (mut saw) false
        (mut consistent) true]
    (loop (if (or (>= (load owner) funcs) (not (load consistent)))
              (break)
              (let [fun (mu-function-ideal (load owner))]
                (if (and (!= fun NO-NODE)
                         (and (= (n-op fun) OP-FUN)
                              (and (>= (n-aux fun) 0)
                                   (and (< (n-aux fun) 63)
                                        (!= (& targets (<< 1 (n-aux fun))) 0)))))
                    (let [tag (be-function-return-tag-fuel (load owner) fuel)]
                      (store! saw true)
                      (if (< tag 0)
                          (store! consistent false)
                          (if (< (load answer) 0)
                              (store! answer tag)
                              (if (!= (load answer) tag) (store! consistent false) 0))))
                    0)
                (store! owner (+ (load owner) 1)))))
    (if (and (load saw) (load consistent)) (load answer) -1)))

(defn be-call-return-tag [(call i64)] (-> i64)
  (be-call-return-tag-fuel call 32))

(defn be-js-tag-for-value [(node i64)] (-> i64)
  (if (be-array-value? node 64)
      JSV-ARRAY
      (if (ml-raw-nullable-value? node 32)
          JSV-RAW-NULLABLE-OBJECT
          (if (and (= (n-op node) OP-CALL) (!= (be-call-return-kind node) MLK-BOXED))
              (be-call-return-tag node)
          (if (and (= (n-op node) OP-PARM)
               (= (ml-kind-for-parm-representation node) MLK-RAW-MANAGED))
          JSV-OBJECT
          (let [tag (be-js-tag-for-type (n-ty node))]
            ;; The numeric lattice includes int|float, but each selected value still has one
            ;; concrete machine representation. Arithmetic with integer inputs is an integer word;
            ;; arithmetic selected onto FP registers is an untagged IEEE double (tag zero in the
            ;; JavaScript ABI). Derive this case from selection representation rather than rejecting
            ;; a sound numeric join as unboxable.
            (if (and (= tag -1) (ty-numeric? (n-ty node)))
                (if (be-node-fp-value? node) 0 JSV-INTEGER)
                tag)))))))

(defn be-box-input-already-tagged? [(node i64)] (-> bool)
  (if (= (n-op node) OP-CALL)
      (= (be-call-return-kind node) MLK-BOXED)
      (= (ml-kind-for-node node) MLK-BOXED)))

(defn be-al-elem [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field p data)) i))

(defn be-vreg-count [] (-> i64)
  (let [len (al-len [MInst] (load (field (backend) ins)))
        (mut i) 0
        (mut n) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [d (load (field (be-al-elem [MInst] (field (backend) ins) (load i)) dst))]
                  (if (>= d (load n)) (store! n (+ d 1)) 0))
                (store! i (+ (load i) 1))
                0)))
    (load n)))

(defn be-float-only? [(t i64)] (-> bool)
  (= (ty-kinds t) VK-FLT))
(defn be-float-bits [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-fbits v))
    (TBot [] 0)
    (TTop [] 0)
    (TCtrl [] 0)
    (TXCtrl [] 0)
    (TTuple [o l] 0)
    (TMem [a c] 0)))

(defn be-fp-op [(op i64)] (-> i64)
  (case op OP-ADD
        MI-FADD OP-SUB
        MI-FSUB OP-MUL
        MI-FMUL OP-DIV
        MI-FDIV OP-EQ
        MI-FEQ OP-LT
        MI-FLT OP-LE
        MI-FLE -1))

(defn be-parm-fp-value? [(node i64)] (-> bool)
  (let [fun (n-in node 0)
        slot (n-aux node)
        (mut at) 0
        (mut found) false]
    (loop (if (or (>= (load at) (n-count)) (load found))
              (break)
              (do
                (if (and (not (n-dead? (load at)))
                         (and (= (n-op (load at)) OP-CALL)
                              (and (> (n-nins (load at)) (+ slot 2))
                                   (= (n-in (load at) 1) fun))))
                    (let [actual (n-in (load at) (+ slot 2))]
                      (if (be-float-only? (n-ty actual)) (store! found true) 0))
                    0)
                (store! at (+ (load at) 1))
                0)))
    (load found)))

(defn be-node-fp-value? [(node i64)] (-> bool)
  (let [op (n-op node)]
    (if (= op OP-MOD)
        true
        (if (= op OP-PARM)
            (be-parm-fp-value? node)
            (if (be-float-only? (n-ty node))
                true
                (if (or (= op OP-ADD) (or (= op OP-SUB) (or (= op OP-MUL) (= op OP-DIV))))
                    (or (and (= op OP-DIV) (not (ty-int-only? (n-ty node))))
                        (or (be-node-fp-value? (n-in node 1))
                            (be-node-fp-value? (n-in node 2))))
                    (if (= op OP-MINUS)
                        (be-node-fp-value? (n-in node 1))
                        (if (= op OP-CALL)
                            (let [callee (n-in node 1)]
                              (and (= (n-op callee) OP-FUN)
                                   (and (> (n-nins callee) 1)
                                        (be-node-fp-value? (n-in (n-in callee 1) 1)))))
                            false))))))))

; Frontend dynamic values cross the JavaScript-value ABI at these nodes. Hand-written
; backend fixtures also use t-dyn for unconstrained machine integers, so type alone is
; not enough to justify a runtime JavaScript equality or truthiness call.
(defn be-js-dynamic-boundary? [(node i64)] (-> bool)
  (let [op (n-op node)]
    (or (= op OP-CALL)
        (or (= op OP-PROPLOAD)
            (or (= op OP-ARRAYLOAD)
                (or (= op OP-BOX)
                    (= op OP-PHI)))))))

(defn be-fp-input! [(node i64) (vreg i64)] (-> i64)
  (if (be-node-fp-value? node)
      vreg
      (let [fresh (be-vreg-count)]
        (be-emit! (mi-new MI-SCVTF fresh vreg -1 0 NO-NODE))
        fresh)))

(defn select-numeric-binary! [(n i64) (integer-op i64)] (-> i64)
  (if (or (be-node-fp-value? n)
          (or (be-node-fp-value? (n-in n 1)) (be-node-fp-value? (n-in n 2))))
      (let [raw-a (select-value! (n-in n 1))
            raw-b (select-value! (n-in n 2))]
        (if (or (< raw-a 0) (< raw-b 0))
            -1
            (let [a (be-fp-input! (n-in n 1) raw-a)
                  b (be-fp-input! (n-in n 2) raw-b)
                  vr (be-vreg-count)]
              (be-emit! (mi-new (be-fp-op (n-op n)) vr a b 0 n))
              vr)))
      (select-binary! n integer-op)))

(defn select-binary! [(n i64) (mop i64)] (-> i64)
  (let [a (select-value! (n-in n 1))
        b (select-value! (n-in n 2))]
    (if (or (< a 0) (< b 0))
        -1
        (let [vr (be-vreg-count)]
          (be-emit! (mi-new mop vr a b 0 n))
          vr))))

(defn select-int32-binary! [(n i64) (mop i64)] (-> i64)
  (let [an (n-in n 1)
        bn (n-in n 2)
        raw-a (select-value! an)
        raw-b (select-value! bn)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a
                (if (be-node-fp-value? an)
                    (let [fresh (be-vreg-count)]
                      (be-emit! (mi-new MI-I32FROMFP fresh raw-a -1 0 NO-NODE))
                      fresh)
                    raw-a)
              b
                (if (be-node-fp-value? bn)
                    (let [fresh (be-vreg-count)]
                      (be-emit! (mi-new MI-I32FROMFP fresh raw-b -1 0 NO-NODE))
                      fresh)
                    raw-b)
              vr (be-vreg-count)]
          (be-emit! (mi-new mop vr a b 0 n))
          vr))))

(defn select-mod! [(n i64)] (-> i64)
  (let [an (n-in n 1)
        bn (n-in n 2)
        raw-a (select-value! an)
        raw-b (select-value! bn)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a (be-fp-input! an raw-a)
              b (be-fp-input! bn raw-b)
              vr (be-vreg-count)]
          (be-emit! (mi-new MI-FMOD vr a b 0 n))
          vr))))

(defn graph-arg-index [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut idx) 0
        want-fp (be-float-only? (n-ty n))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (= (n-op (load i)) OP-ARG)
                              (and (not (ty-mem? (n-aux (load i))))
                                   (and (> (n-nins (load i)) 0)
                                        (and (= (n-in (load i) 0) (g-start))
                                             (= (be-float-only? (n-ty (load i))) want-fp))))))
                    (store! idx (+ (load idx) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load idx)))

(defn graph-parm-abi-index [(n i64)] (-> i64)
  (let [fun (n-in n 0)
        want-fp (be-node-fp-value? n)
        (mut i) 0
        (mut idx) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (= (n-op (load i)) OP-PARM)
                              (and (= (n-in (load i) 0) fun)
                                   (= (be-node-fp-value? (load i)) want-fp))))
                    (store! idx (+ (load idx) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load idx)))

(defn graph-parm-stack-index [(n i64)] (-> i64)
  (let [fun (n-in n 0)
        (mut i) 0
        (mut idx) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (= (n-op (load i)) OP-PARM)
                              (and (= (n-in (load i) 0) fun)
                                   (>= (graph-parm-abi-index (load i)) 8))))
                    (store! idx (+ (load idx) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load idx)))

(defn graph-new-index [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut idx) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-NEW))
                    (store! idx (+ (load idx) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load idx)))

(defn be-field-off [(alias i64)] (-> i64)
  (if (shape-alias-defined? alias) (shape-alias-offset alias) (* (% alias 16) 8)))

(defn select-memory-new! [(n i64)] (-> bool)
  (case (n-op n) OP-STORE
        (if (not (select-memory! (n-in n 1)))
            false
            (let [ptr (select-value! (n-in n 2))
                  val (select-value! (n-in n 3))]
              (if (or (< ptr 0) (< val 0))
                  false
                  (do (be-emit! (mi-new MI-STORE -1 ptr val (be-field-off (n-aux n)) n)) true))))
          OP-PROJ
        (if (= (n-op (n-in n 0)) OP-NEW)
            (do (select-value! (n-in n 0)) true)
            false)
          OP-ARG
        true
        ; Memory phis/merges need edge-specific lowering; accepting them here would read an
        ; uninitialised stack slot and turn selector coverage into a miscompile.
        OP-PHI
          (if (= (n-op (n-in n 0)) OP-LOOP)
              (load (field (backend) inloop))
              (let [len (n-nins n)
                    (mut i) 1
                    (mut ok) true]
                (loop (if (or (>= (load i) len) (not (load ok)))
                          (break)
                          (do
                            (if (select-memory! (n-in n (load i))) 0 (store! ok false))
                            (store! i (+ (load i) 1))
                            0)))
                (load ok)))
        OP-MEMMERGE
          (let [len (n-nins n)
                (mut i) 1
                (mut ok) true]
            (loop (if (or (>= (load i) len) (not (load ok)))
                      (break)
                      (do
                        (if (select-memory! (n-in n (load i))) 0 (store! ok false))
                        (store! i (+ (load i) 1))
                        0)))
            (load ok))
        true))

(defn select-memory! [(n i64)] (-> bool)
  (if (!= (al-get (load (field (backend) mseen)) n) 0)
      true
      (let [ok (select-memory-new! n)]
        (if ok (al-set! [i64] (field (backend) mseen) n 1) 0)
        ok)))

(defn select-reaching-store-value! [(mem i64) (ptr-node i64) (alias i64)] (-> i64)
  (case (n-op mem) OP-STORE
        (if (and (= (n-aux mem) alias) (= (n-in mem 2) ptr-node))
            (select-value! (n-in mem 3))
            (select-reaching-store-value! (n-in mem 1) ptr-node alias))
          -1))

(defn ctrl-entry-proj [(ctrl i64)] (-> i64)
  (case (n-op ctrl) OP-CPROJ
        ctrl OP-REGION
        (if (< (n-nins ctrl) 2)
            NO-NODE
            (let [first (n-in ctrl 1)]
              (if (!= (n-op first) OP-CPROJ)
                  NO-NODE
                  (let [iff (n-in first 0)]
                    (if (!= (n-op iff) OP-IF)
                        NO-NODE
                        ; A nested merge is entered through the control that dominates its inner If.
                        (ctrl-entry-proj (n-in iff 0)))))))
          NO-NODE))

(defn phi-diamond-if [(phi i64)] (-> i64)
  (let [r (n-in phi 0)]
    (if (or (!= (n-op r) OP-REGION) (!= (n-nins r) 3))
        NO-NODE
        (let [a (ctrl-entry-proj (n-in r 1))
              b (ctrl-entry-proj (n-in r 2))]
          (if (and (and (!= a NO-NODE) (!= b NO-NODE))
                   (and (= (n-in a 0) (n-in b 0)) (= (n-op (n-in a 0)) OP-IF)))
              (n-in a 0)
              NO-NODE)))))

(defn select-value! [(n i64)] (-> i64)
  (let [p (backend)
        prior (al-get (load (field p nval)) n)]
    (if (>= prior 0)
        prior
        (let [op (n-op n)
              (mut vr) -1]
          (case op OP-CONST
                (if (or (= (ty-kinds (n-ty n)) VK-NULL)
                        (or (= (ty-kinds (n-ty n)) VK-UNDEF)
                            (or (and (= (ty-kinds (n-ty n)) VK-BOOL)
                                     (ty-const? (n-ty n)))
                                (and (ty-int-only? (n-ty n)) (ty-const? (n-ty n))))))
                    (let [fresh (be-vreg-count)]
                      (be-emit! (mi-new MI-MOVI
                                        fresh
                                        -1
                                        -1
                                        (if (or (= (ty-kinds (n-ty n)) VK-NULL)
                                                (= (ty-kinds (n-ty n)) VK-UNDEF))
                                            0
                                            (ty-int-lo (n-ty n)))
                                        n))
                      (store! vr fresh)
                      0)
                    (if (and (be-float-only? (n-ty n)) (ty-const? (n-ty n)))
                        (let [fresh (be-vreg-count)]
                          (be-emit! (mi-new MI-FMOVI fresh -1 -1 (be-float-bits (n-ty n)) n))
                          (store! vr fresh)
                          0)
                        0))
                  OP-FUN
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-MOVI fresh -1 -1 (n-aux n) n))
                  (store! vr fresh))
                  OP-PARM
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-ARG fresh -1 -1 (graph-parm-abi-index n) n))
                  (store! vr fresh)
                  0)
                  OP-ARG
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-ARG fresh -1 -1 (graph-arg-index n) n))
                  (store! vr fresh)
                  0)
                  OP-NEW
                (let [fresh (be-vreg-count)]
                  (be-emit! (mi-new MI-NEW fresh -1 -1 (n-aux n) n))
                  (store! vr fresh)
                  0)
                  OP-PROJ
                (if (and (= (n-aux n) 0) (= (n-op (n-in n 0)) OP-NEW))
                    (store! vr (select-value! (n-in n 0)))
                    0)
                  OP-LOAD
                (let [mem (n-in n 1)]
                  (if (and (= (n-op mem) OP-PHI) (!= (phi-diamond-if mem) NO-NODE))
                      (let [pred (select-value! (n-in (phi-diamond-if mem) 1))
                            av (select-reaching-store-value! (n-in mem 1) (n-in n 2) (n-aux n))
                            bv (select-reaching-store-value! (n-in mem 2) (n-in n 2) (n-aux n))]
                        (if (or (< pred 0) (or (< av 0) (< bv 0)))
                            0
                            (let [fresh (be-vreg-count)]
                              (if (= (n-aux (ctrl-entry-proj (n-in (n-in mem 0) 1))) 0)
                                  (be-emit! (mi-new MI-CSEL fresh av bv pred n))
                                  (be-emit! (mi-new MI-CSEL fresh bv av pred n)))
                              (store! vr fresh)
                              0)))
                      (if (not (select-memory! mem))
                          0
                          (let [ptr (select-value! (n-in n 2))]
                            (if (< ptr 0)
                                0
                                (let [fresh (be-vreg-count)]
                                  (be-emit! (mi-new MI-LOAD fresh ptr -1 (be-field-off (n-aux n)) n))
                                  (store! vr fresh)
                                  0))))))
                  OP-ADD
                (store! vr (select-numeric-binary! n MI-ADD)) OP-SUB
                (store! vr (select-numeric-binary! n MI-SUB)) OP-MUL
                (store! vr (select-numeric-binary! n MI-MUL)) OP-DIV
                (store! vr (select-numeric-binary! n MI-SDIV)) OP-EQ
                (if (or (and (= (n-ty (n-in n 1)) (t-dyn))
                             (be-js-dynamic-boundary? (n-in n 1)))
                        (and (= (n-ty (n-in n 2)) (t-dyn))
                             (be-js-dynamic-boundary? (n-in n 2))))
                    (let [a (select-value! (n-in n 1))
                          b (select-value! (n-in n 2))]
                      (if (or (< a 0) (< b 0))
                          (store! vr -1)
                          (let [fresh (be-vreg-count)
                                zero (be-vreg-count)]
                            (be-emit! (mi-new MI-MOVI zero -1 -1 0 NO-NODE))
                            (let [at (be-emit! (mi-new MI-JSSTRING fresh a b JSSOP-VALUE-EQUAL n))]
                              (ms-add-single-arg! at zero))
                            (store! vr fresh))))
                    (store! vr (select-numeric-binary! n MI-EQ))) OP-LT
                (store! vr (select-numeric-binary! n MI-LT)) OP-LE
                (store! vr (select-numeric-binary! n MI-LE)) OP-MOD
                (store! vr (select-mod! n)) OP-BITAND
                (store! vr (select-int32-binary! n MI-BITAND)) OP-BITOR
                (store! vr (select-int32-binary! n MI-BITOR)) OP-BITXOR
                (store! vr (select-int32-binary! n MI-BITXOR)) OP-SHL
                (store! vr (select-int32-binary! n MI-SHL)) OP-SHR
                (store! vr (select-int32-binary! n MI-SHR)) OP-USHR
                (store! vr (select-int32-binary! n MI-USHR)) OP-BITNOT
                (let [an (n-in n 1)
                      raw-a (select-value! an)]
                  (if (< raw-a 0)
                      0
                      (let [a
                              (if (be-node-fp-value? an)
                                  (let [converted (be-vreg-count)]
                                    (be-emit! (mi-new MI-I32FROMFP converted raw-a -1 0 NO-NODE))
                                    converted)
                                  raw-a)
                            fresh (be-vreg-count)]
                        (be-emit! (mi-new MI-BITNOT fresh a -1 0 n))
                        (store! vr fresh)
                        0)))
                  OP-CAST
                (store! vr (select-value! (n-in n 1))) OP-BOX
                (let [a (select-value! (n-in n 1))
                      tag (be-js-tag-for-value (n-in n 1))]
                  (if (and (>= a 0)
                           (and (not (be-node-fp-value? (n-in n 1)))
                                (be-box-input-already-tagged? (n-in n 1))))
                      (store! vr a)
                      (if (or (< a 0) (= tag -1))
                          (do (be-fail! BER-UNSUPPORTED-OPCODE n) 0)
                          (let [fresh (be-vreg-count)]
                            (be-emit! (mi-new MI-JSBOX fresh a -1 tag n))
                            (store! vr fresh)
                            0))))
                  OP-UNBOX
                (let [a (select-value! (n-in n 1))
                      tag (be-js-tag-for-type (n-aux n))]
                  (if (or (< a 0) (= tag -1))
                      (do (be-fail! BER-UNSUPPORTED-OPCODE n) 0)
                      (let [fresh (be-vreg-count)]
                        (be-emit! (mi-new MI-JSUNBOX fresh a -1 tag n))
                        (store! vr fresh)
                        0)))
                  OP-TYPETEST
                (let [a (select-value! (n-in n 1))
                      tag (be-js-tag-for-type (n-aux n))]
                  (if (or (< a 0) (= tag -1))
                      (do (be-fail! BER-UNSUPPORTED-OPCODE n) 0)
                      (let [fresh (be-vreg-count)]
                        (be-emit! (mi-new MI-JSTEST fresh a -1 tag n))
                        (store! vr fresh)
                        0)))
                  OP-PHI
                (let [iff (phi-diamond-if n)]
                  (if (= iff NO-NODE)
                      (do (be-fail! BER-UNSUPPORTED-PHI n) 0)
                      (let [pred (select-value! (n-in iff 1))
                            av (select-value! (n-in n 1))
                            bv (select-value! (n-in n 2))]
                        (if (or (< pred 0) (or (< av 0) (< bv 0)))
                            0
                            (let [fresh (be-vreg-count)]
                              ; imm carries the predicate vreg; a/b follow Region input order. CProj 0 is
                              ; the true edge, but raw graphs are allowed to list the Region arms either way.
                              (if (= (n-aux (ctrl-entry-proj (n-in (n-in n 0) 1))) 0)
                                  (be-emit! (mi-new MI-CSEL fresh av bv pred n))
                                  (be-emit! (mi-new MI-CSEL fresh bv av pred n)))
                              (store! vr fresh)
                              0)))))
                  OP-MINUS
                (let [a (select-value! (n-in n 1))]
                  (if (< a 0)
                      0
                      (let [fresh (be-vreg-count)]
                        (be-emit! (mi-new (if (be-node-fp-value? (n-in n 1)) MI-FNEG MI-NEG)
                                          fresh
                                          a
                                          -1
                                          0
                                          n))
                        (store! vr fresh)
                        0)))
                  (if (= op OP-CALL)
                      (do (be-fail! BER-UNSUPPORTED-CALL n) 0)
                      (do (be-fail! BER-UNSUPPORTED-OPCODE n) 0)))
          (if (< (load vr) 0)
              -1
              (do (al-set! [i64] (field p nval) n (load vr)) (load vr)))))))

(defn be-select-return! [(ret i64)] (-> bool)
  (be-reset!)
  (if (not (be-preflight!))
      false
      (if (!= (n-op ret) OP-RETURN)
          (be-fail! BER-MALFORMED-GRAPH ret)
          (let [mem-ok
                  (if (and (> (n-nins ret) 2) (ty-only-obj? (n-ty (n-in ret 1))))
                      (select-memory! (n-in ret 2))
                      true)
                v (if mem-ok (select-value! (n-in ret 1)) -1)]
            (if (< v 0)
                (if (= (be-result) BER-OK) (be-fail! BER-UNSUPPORTED-OPCODE ret) false)
                (do (be-emit! (mi-new MI-RET -1 v -1 0 ret)) true))))))

(defn be-select-fun! [(fun i64)] (-> bool)
  (if (or (!= (n-op fun) OP-FUN) (!= (n-nins fun) 2))
      (do (be-reset!) (be-fail! BER-MALFORMED-GRAPH fun))
      (be-select-return! (n-in fun 1))))

(defn be-has-input? [(n i64) (want i64)] (-> bool)
  (let [len (n-nins n)
        (mut i) 0
        (mut yes) false]
    (loop (if (or (>= (load i) len) (load yes))
              (break)
              (do
                (if (= (n-in n (load i)) want) (store! yes true) 0)
                (store! i (+ (load i) 1))
                0)))
    (load yes)))

(defn be-cfg-control? [(op i64)] (-> bool)
  (or (or (= op OP-IF) (= op OP-RETURN))
      (or (or (= op OP-LOOP) (= op OP-REGION))
          (or (= op OP-CPROJ) (= op OP-CALLEND)))))

(defn be-ctrl-succ [(ctrl i64)] (-> i64)
  (let [len (n-nouts ctrl)
        (mut i) 0
        (mut found) NO-NODE
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out ctrl (load i))]
                  (if (and (not (n-dead? u))
                           (and (be-cfg-control? (n-op u)) (> (n-nins u) 0)))
                      (if (be-has-input? u ctrl)
                          (do (store! found u) (store! count (+ (load count) 1)) 0)
                          0)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (if (= (load count) 1) (load found) NO-NODE)))

(defn be-if-arm [(iff i64) (slot i64)] (-> i64)
  (let [len (n-nouts iff)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out iff (load i))]
                  (if (and (not (n-dead? u))
                           (and (= (n-op u) OP-CPROJ) (= (n-aux u) slot)))
                      (store! found u)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load found)))

; ---------------------------------------------------------------------------
; G1 structural machine CFG. This pass only reads the ideal graph. Selection remains separate
; until G2, so building or verifying this table cannot perturb optimizer or legacy backend state.
; ---------------------------------------------------------------------------

(defn mu-target-slot [(target i64) (incoming i64)] (-> i64)
  (if (or (= (n-op target) OP-REGION) (= (n-op target) OP-LOOP))
      (let [len (n-nins target)
            (mut i) 1
            (mut found) -1]
        (loop (if (or (>= (load i) len) (>= (load found) 0))
                  (break)
                  (do
                    (if (= (n-in target (load i)) incoming) (store! found (load i)) 0)
                    (store! i (+ (load i) 1))
                    0)))
        (load found))
      0))

(defn mu-add-edge! [(owner i64) (source i64) (target i64) (slot i64)] (-> i64)
  (let [u (machine-unit)
        len (mu-edge-count)
        (mut i) 0
        (mut prior) -1]
    (loop (if (or (>= (load i) len) (>= (load prior) 0))
              (break)
              (do
                (let [e (mu-edge (load i))]
                  (if (and (= (load (field e source)) source)
                           (and (= (load (field e target)) target)
                                (= (load (field e target-slot)) slot)))
                      (store! prior (load i))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (if (>= (load prior) 0)
        (load prior)
        (do (al-push! [MEdge] (field u edges) (me-new len owner source target slot)) len))))

(defn mu-note-return! [(owner i64) (ret i64)] (-> i64)
  (let [u (machine-unit)
        f (mu-function owner)]
    (if (< (load (field f return-first)) 0)
        (store! (field f return-first) (al-len [i64] (load (field u returns))))
        0)
    (al-push! [i64]
              (field u returns)
              (al-get (load (field u ctrl-block)) ret))
    (store! (field f return-count) (+ (load (field f return-count)) 1))
    0))

(defn mu-walk-block! [(owner i64) (head i64)] (-> i64)
  (let [u (machine-unit)
        known (al-get (load (field u ctrl-block)) head)]
    (if (>= known 0)
        known
        (let [bid (mu-block-count)
              (mut ctrl) head
              (mut done) false]
          (al-push! [MBlock] (field u blocks) (mb-new bid owner head))
          (loop (if (load done)
                    (break)
                    (let [mapped (al-get (load (field u ctrl-block)) (load ctrl))]
                      (if (and (>= mapped 0) (!= mapped bid))
                          (do
                            (mu-add-edge! owner bid mapped 0)
                            (store! done true))
                          (do
                            (al-set! [i64] (field u ctrl-block) (load ctrl) bid)
                            (case (n-op (load ctrl)) OP-RETURN
                                  (do (mu-note-return! owner (load ctrl)) (store! done true)) OP-IF
                                  (let [a (be-if-arm (load ctrl) 0)
                                        b (be-if-arm (load ctrl) 1)]
                                    (if (!= a NO-NODE)
                                        (do
                                          (mu-walk-block! owner a)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (load (field u ctrl-block)) a)
                                                        0)
                                          0)
                                        0)
                                    (if (!= b NO-NODE)
                                        (do
                                          (mu-walk-block! owner b)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (load (field u ctrl-block)) b)
                                                        0)
                                          0)
                                        0)
                                    (store! done true))
                                    (let [next (be-ctrl-succ (load ctrl))]
                                      (if (= next NO-NODE)
                                          (store! done true)
                                          (if (or (= (n-op next) OP-REGION)
                                                  (or (= (n-op next) OP-LOOP) (= (n-op next) OP-CPROJ)))
                                              (do
                                                (mu-walk-block! owner next)
                                                (mu-add-edge! owner
                                                              bid
                                                              (al-get (load (field u ctrl-block)) next)
                                                              (mu-target-slot next (load ctrl)))
                                                (store! done true))
                                              (store! ctrl next)))))))))
            bid)))))

(defn mu-build-function! [(ideal i64) (entry i64)] (-> i64)
  (let [u (machine-unit)
        id (mu-function-count)
        first (mu-block-count)]
    (al-push! [MFunction] (field u functions) (mf-new id ideal entry))
    (al-push! [i64] (field u symbols) (if (= ideal NO-NODE) -1 (n-aux ideal)))
    (mu-walk-block! id entry)
    (let [f (mu-function id)]
      (store! (field f block-first) first)
      (store! (field f block-count) (- (mu-block-count) first)))
    id))

(defn mu-find-function [(ideal i64)] (-> i64)
  (let [n (mu-function-count)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (= (mu-function-ideal (load i)) ideal) (store! found (load i)) 0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn mu-find-function-symbol [(symbol i64)] (-> i64)
  (let [(mut owner) 0
        (mut found) -1]
    (loop (if (or (>= (load owner) (mu-function-count)) (>= (load found) 0))
              (break)
              (do
                (if (= (al-get (load (field (machine-unit) symbols)) (load owner)) symbol)
                    (store! found (load owner))
                    0)
                (store! owner (+ (load owner) 1)))))
    (load found)))

(defn mu-direct-callee [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (case (n-op callee) OP-FUN
          callee OP-CLOSURE
          (n-in callee 0)
            (let [fidx (ty-fun-singleton (n-ty callee))]
              (if (< fidx 0) NO-NODE (n-find-fun-index fidx))))))

(defn mu-build-call-targets! [(call i64)] (-> i64)
  (let [direct (mu-direct-callee call)
        targets (ty-fun-targets (n-ty (n-in call 1)))
        (mut fidx) 0]
    (if (!= direct NO-NODE) (mu-build-reachable-function! direct) 0)
    (loop (if (>= (load fidx) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load fidx))) 0)
                    (let [fun (n-find-fun-index (load fidx))]
                      (if (!= fun NO-NODE) (mu-build-reachable-function! fun) 0))
                    0)
                (store! fidx (+ (load fidx) 1)))))
    0))

(defn mu-build-reachable-function! [(ideal i64)] (-> i64)
  (let [prior (mu-find-function ideal)]
    (if (>= prior 0)
        prior
        (let [owner (mu-build-function! ideal (n-fun-entry ideal))
              lim (n-count)
              (mut i) 0]
          ; Function ownership is already recorded on every reachable control in this function.
          ; A call belongs here exactly when its control maps to one of those blocks.
          (loop (if (>= (load i) lim)
                    (break)
                    (do
                      (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                          (let [ctrl (n-in (load i) 0)
                                bid
                                  (if (= ctrl NO-NODE)
                                      -1
                                      (al-get (load (field (machine-unit) ctrl-block)) ctrl))]
                            (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                                (mu-build-call-targets! (load i))
                                0))
                          0)
                      (store! i (+ (load i) 1))
                      0)))
          owner))))

(defn mu-finalize-adjacency! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut b) 0]
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (loop (if (>= (load b) blocks)
              (break)
              (do
                (let [block (mu-block (load b))
                      (mut e) 0]
                  (store! (field block pred-first) (al-len [i64] (load (field u pred-edges))))
                  (store! (field block pred-count) 0)
                  (store! (field block succ-first) (al-len [i64] (load (field u succ-edges))))
                  (store! (field block succ-count) 0)
                  (loop (if (>= (load e) edges)
                            (break)
                            (do
                              (if (= (mu-edge-target (load e)) (load b))
                                  (do
                                    (al-push! [i64] (field u pred-edges) (load e))
                                    (store! (field block pred-count)
                                            (+ (load (field block pred-count)) 1)))
                                  0)
                              (if (= (mu-edge-source (load e)) (load b))
                                  (do
                                    (al-push! [i64] (field u succ-edges) (load e))
                                    (store! (field block succ-count)
                                            (+ (load (field block succ-count)) 1)))
                                  0)
                              (store! e (+ (load e) 1))
                              0))))
                (store! b (+ (load b) 1))
                0)))
    0))

(defn mu-rpo-visit! [(owner i64) (bid i64)] (-> i64)
  (let [u (machine-unit)]
    (if (!= (al-get (load (field u rpo-seen)) bid) 0)
        0
        (do
          (al-set! [i64] (field u rpo-seen) bid 1)
          (let [edges (mu-edge-count)
                (mut i) 0]
            (loop (if (>= (load i) edges)
                      (break)
                      (do
                        (let [e (mu-edge (load i))]
                          (if (and (= (load (field e owner)) owner)
                                   (= (load (field e source)) bid))
                              (mu-rpo-visit! owner (load (field e target)))
                              0))
                        (store! i (+ (load i) 1))
                        0))))
          (al-push! [i64] (field u rpo-post) bid)
          0))))

(defn mu-compute-rpo! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-order))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (al-clear! [i64] (field u rpo-seen))
                (al-clear! [i64] (field u rpo-post))
                (let [(mut i) 0]
                  (loop (if (>= (load i) blocks)
                            (break)
                            (do
                              (al-push! [i64] (field u rpo-seen) 0)
                              (store! i (+ (load i) 1))
                              0))))
                (let [funrec (mu-function (load fidx))
                      entry (load (field funrec entry))
                      entry-block (al-get (load (field u ctrl-block)) entry)
                      first (al-len [i64] (load (field u block-order)))]
                  (if (< entry-block 0)
                      (store! ok false)
                      (mu-rpo-visit! (load fidx) entry-block))
                  (let [n (al-len [i64] (load (field u rpo-post)))
                        (mut i) n]
                    (loop (if (<= (load i) 0)
                              (break)
                              (do
                                (store! i (- (load i) 1))
                                (let [bid (al-get (load (field u rpo-post)) (load i))
                                      layout (- n (+ (load i) 1))]
                                  (al-push! [i64] (field u block-order) bid)
                                  (store! (field (mu-block bid) layout-index) layout))
                                0)))
                    (store! (field funrec block-first) first)
                    (store! (field funrec block-count) n)))
                (store! fidx (+ (load fidx) 1))
                0)))
    ; Every built block must be reachable from its declared function entry.
    (and (load ok) (= (al-len [i64] (load (field u block-order))) blocks))))

(defn mu-idom-intersect [(left i64) (right i64)] (-> i64)
  (let [(mut a) left
        (mut b) right]
    (loop (if (= (load a) (load b))
              (break)
              (do
                (loop (if (<= (mu-block-layout-index (load a))
                              (mu-block-layout-index (load b)))
                          (break)
                          (store! a (mu-block-idom (load a)))))
                (loop (if (<= (mu-block-layout-index (load b))
                              (mu-block-layout-index (load a)))
                          (break)
                          (store! b (mu-block-idom (load b)))))
                0)))
    (load a)))

(defn mu-compute-idoms! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut i) 0
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-idom))
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (al-push! [i64] (field u block-idom) -1)
                (store! i (+ (load i) 1))
                0)))
    (loop (if (or (>= (load fidx) funcs) (not (load ok)))
              (break)
              (let [count (mu-function-block-count (load fidx))
                    entry (mu-function-block (load fidx) 0)
                    (mut changed) true
                    (mut rounds) 0]
                (al-set! [i64] (field u block-idom) entry entry)
                (loop (if (or (not (load changed)) (> (load rounds) (+ count 1)))
                          (break)
                          (do
                            (store! changed false)
                            (store! i 1)
                            (loop (if (>= (load i) count)
                                      (break)
                                      (do
                                        (let [bid (mu-function-block (load fidx) (load i))
                                              block (mu-block bid)
                                              (mut p) 0
                                              (mut next) -1]
                                          (loop (if (>= (load p) (load (field block pred-count)))
                                                    (break)
                                                    (do
                                                      (let [eid
                                                              (al-get (load (field u pred-edges))
                                                                      (+ (load (field block pred-first)) (load p)))
                                                            pred (mu-edge-source eid)]
                                                        (if (>= (mu-block-idom pred) 0)
                                                            (if (< (load next) 0)
                                                                (store! next pred)
                                                                (store! next (mu-idom-intersect pred (load next))))
                                                            0))
                                                      (store! p (+ (load p) 1))
                                                      0)))
                                          (if (and (>= (load next) 0) (!= (mu-block-idom bid) (load next)))
                                              (do
                                                (al-set! [i64] (field u block-idom) bid (load next))
                                                (store! changed true))
                                              0))
                                        (store! i (+ (load i) 1))
                                        0)))
                            (store! rounds (+ (load rounds) 1))
                            0)))
                (store! i 0)
                (loop (if (>= (load i) count)
                          (break)
                          (do
                            (if (< (mu-block-idom (mu-function-block (load fidx) (load i))) 0)
                                (store! ok false)
                                0)
                            (store! i (+ (load i) 1))
                            0)))
                (store! fidx (+ (load fidx) 1))
                0)))
    (load ok)))

(defn mu-dominates? [(ancestor i64) (descendant i64)] (-> bool)
  (if (!= (mu-block-owner ancestor) (mu-block-owner descendant))
      false
      (let [(mut cursor) descendant]
        (loop (if (or (= (load cursor) ancestor)
                      (= (mu-block-idom (load cursor)) (load cursor)))
                  (break)
                  (store! cursor (mu-block-idom (load cursor)))))
        (= (load cursor) ancestor))))

(defn mu-compute-loop-depth! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (store! (field (mu-block (load i)) loop-depth) 0)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) edges)
              (break)
              (do
                (let [back (mu-edge (load i))
                      header (load (field back target))
                      source (load (field back source))
                      slot (load (field back target-slot))]
                  (if (and (= slot 2) (= (n-op (mu-block-control header)) OP-LOOP))
                      (do
                        (al-clear! [i64] (field u rpo-seen))
                        (al-clear! [i64] (field u rpo-post))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (al-push! [i64] (field u rpo-seen) 0)
                                      (store! b (+ (load b) 1))
                                      0))))
                        (al-set! [i64] (field u rpo-seen) header 1)
                        (if (= source header)
                            0
                            (do
                              (al-set! [i64] (field u rpo-seen) source 1)
                              (al-push! [i64] (field u rpo-post) source)))
                        (loop (let [n (al-len [i64] (load (field u rpo-post)))]
                                (if (= n 0)
                                    (break)
                                    (let [current (al-get (load (field u rpo-post)) (- n 1))
                                          (mut eid) 0]
                                      (al-pop! [i64] (field u rpo-post))
                                      (loop (if (>= (load eid) edges)
                                                (break)
                                                (do
                                                  (let [pred-edge (mu-edge (load eid))]
                                                    (if (and (= (load (field pred-edge target)) current)
                                                             (= (load (field pred-edge owner))
                                                                (load (field back owner))))
                                                        (let [pred (load (field pred-edge source))]
                                                          (if (= (al-get (load (field u rpo-seen)) pred) 0)
                                                              (do
                                                                (al-set! [i64] (field u rpo-seen) pred 1)
                                                                (if (= pred header)
                                                                    0
                                                                    (al-push! [i64] (field u rpo-post) pred)))
                                                              0))
                                                        0))
                                                  (store! eid (+ (load eid) 1))
                                                  0)))))))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (if (!= (al-get (load (field u rpo-seen)) (load b)) 0)
                                          (store! (field (mu-block (load b)) loop-depth)
                                                  (+ (load (field (mu-block (load b)) loop-depth)) 1))
                                          0)
                                      (store! b (+ (load b) 1))
                                      0))))
                        0)
                      0))
                (store! i (+ (load i) 1))
                0)))
    0))

(defn mu-fail-verify! [(code i64) (item i64)] (-> bool)
  (let [u (machine-unit)]
    (store! (field u verify-result) code)
    (store! (field u verify-item) item)
    false))

(defn mu-adj-count [(edge i64) (pred bool)] (-> i64)
  (let [u (machine-unit)
        len
          (if pred
              (al-len [i64] (load (field u pred-edges)))
              (al-len [i64] (load (field u succ-edges))))
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (if (= (if pred
                           (al-get (load (field u pred-edges)) (load i))
                           (al-get (load (field u succ-edges)) (load i)))
                       edge)
                    (store! count (+ (load count) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load count)))

(defn mu-block-adj-valid? [(bid i64) (pred bool)] (-> bool)
  (let [u (machine-unit)
        b (mu-block bid)
        first (if pred (load (field b pred-first)) (load (field b succ-first)))
        count (if pred (load (field b pred-count)) (load (field b succ-count)))
        list-len
          (if pred
              (al-len [i64] (load (field u pred-edges)))
              (al-len [i64] (load (field u succ-edges))))
        (mut i) 0
        (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) list-len)))
        false
        (do
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [eid
                              (if pred
                                  (al-get (load (field u pred-edges)) (+ first (load i)))
                                  (al-get (load (field u succ-edges)) (+ first (load i))))]
                        (if (or (< eid 0) (>= eid (mu-edge-count)))
                            (store! ok false)
                            (if (!= (if pred (mu-edge-target eid) (mu-edge-source eid)) bid)
                                (store! ok false)
                                0)))
                      (store! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn mu-slot-valid? [(eid i64)] (-> bool)
  (let [u (machine-unit)
        e (mu-edge eid)
        s (load (field e source))
        t (load (field e target))
        slot (load (field e target-slot))
        target (mu-block-control t)]
    (if (or (= (n-op target) OP-REGION) (= (n-op target) OP-LOOP))
        (if (or (<= slot 0) (or (>= slot (n-nins target)) (= (n-in target slot) NO-NODE)))
            false
            (let [incoming (n-in target slot)
                  mapped (al-get (load (field u ctrl-block)) incoming)
                  edges (mu-edge-count)
                  (mut i) 0
                  (mut same) 0]
              (loop (if (>= (load i) edges)
                        (break)
                        (do
                          (let [other (mu-edge (load i))]
                            (if (and (= (load (field other target)) t)
                                     (= (load (field other target-slot)) slot))
                                (store! same (+ (load same) 1))
                                0))
                          (store! i (+ (load i) 1))
                          0)))
              (and (= mapped s) (= (load same) 1))))
        (= slot 0))))

(defn mu-block-terminator-op [(bid i64)] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut op) -1]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (= (al-get (load (field (machine-unit) ctrl-block)) (load i)) bid)
                    (let [candidate (n-op (load i))]
                      (if (or (= candidate OP-IF) (= candidate OP-RETURN))
                          (store! op candidate)
                          0))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load op)))

(defn mu-block-terminator [(bid i64)] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (= (al-get (load (field (machine-unit) ctrl-block)) (load i)) bid)
                    (let [candidate (n-op (load i))]
                      (if (or (= candidate OP-IF) (= candidate OP-RETURN))
                          (store! found (load i))
                          0))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn mu-verify-terminators! [] (-> bool)
  (let [blocks (mu-block-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [op (mu-block-terminator-op (load i))
                      succ (load (field (mu-block (load i)) succ-count))]
                  (if (or (and (= op OP-IF) (!= succ 2))
                          (and (= op OP-RETURN) (!= succ 0)))
                      (do (mu-fail-verify! MCFG-TERMINATOR-ARITY (load i)) (break))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-rpo! [] (-> bool)
  (let [u (machine-unit)
        funcs (mu-function-count)
        blocks (mu-block-count)
        (mut fidx) 0]
    (al-clear! [i64] (field u rpo-seen))
    (let [(mut i) 0]
      (loop (if (>= (load i) blocks)
                (break)
                (do
                  (al-push! [i64] (field u rpo-seen) 0)
                  (store! i (+ (load i) 1))
                  0))))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      n (load (field f block-count))
                      (mut pos) 0]
                  (let [entry-block (al-get (load (field u ctrl-block)) (load (field f entry)))]
                    (if (or (= n 0) (!= (mu-function-block (load fidx) 0) entry-block))
                        (do (mu-fail-verify! MCFG-RPO (load fidx)) 0)
                        0))
                  (loop (if (or (>= (load pos) n) (!= (mu-verify-result) MCFG-OK))
                            (break)
                            (do
                              (let [bid (mu-function-block (load fidx) (load pos))]
                                (if (or (< bid 0)
                                        (or (>= bid blocks)
                                            (or (!= (mu-block-owner bid) (load fidx))
                                                (or (!= (mu-block-layout-index bid) (load pos))
                                                    (!= (al-get (load (field u rpo-seen)) bid) 0)))))
                                    (do (mu-fail-verify! MCFG-RPO bid) (break))
                                    (al-set! [i64] (field u rpo-seen) bid 1)))
                              (store! pos (+ (load pos) 1))
                              0))))
                (if (!= (mu-verify-result) MCFG-OK) (break) 0)
                (store! fidx (+ (load fidx) 1))
                0)))
    (if (= (mu-verify-result) MCFG-OK)
        (let [(mut i) 0]
          (loop (if (>= (load i) blocks)
                    (break)
                    (do
                      (if (= (al-get (load (field u rpo-seen)) (load i)) 0)
                          (do (mu-fail-verify! MCFG-RPO (load i)) (break))
                          0)
                      (store! i (+ (load i) 1))
                      0))))
        0)
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-idoms! [] (-> bool)
  (let [blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0]
    (loop (if (or (>= (load fidx) funcs) (!= (mu-verify-result) MCFG-OK))
              (break)
              (do
                (let [count (mu-function-block-count (load fidx))
                      entry (mu-function-block (load fidx) 0)
                      (mut i) 0]
                  (if (!= (mu-block-idom entry) entry)
                      (do (mu-fail-verify! MCFG-IDOM entry) 0)
                      0)
                  (store! i 1)
                  (loop (if (or (>= (load i) count) (!= (mu-verify-result) MCFG-OK))
                            (break)
                            (do
                              (let [bid (mu-function-block (load fidx) (load i))
                                    parent (mu-block-idom bid)]
                                (if (or (< parent 0)
                                        (or (>= parent blocks)
                                            (or (!= (mu-block-owner parent) (load fidx))
                                                (>= (mu-block-layout-index parent)
                                                    (mu-block-layout-index bid)))))
                                    (do (mu-fail-verify! MCFG-IDOM bid) 0)
                                    0))
                              (store! i (+ (load i) 1))
                              0))))
                (store! fidx (+ (load fidx) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        funcs (mu-function-count)
        (mut i) 0]
    (store! (field u verify-result) MCFG-OK)
    (store! (field u verify-item) -1)
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [b (mu-block (load i))
                      owner (load (field b owner))]
                  (if (or (!= (load (field b id)) (load i))
                          (or (< owner 0) (>= owner funcs)))
                      (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                      (if (or (not (mu-block-adj-valid? (load i) true))
                              (not (mu-block-adj-valid? (load i) false)))
                          (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                          0)))
                (store! i (+ (load i) 1))
                0)))
    (if (!= (mu-verify-result) MCFG-OK)
        false
        (do
          (store! i 0)
          (loop (if (>= (load i) edges)
                    (break)
                    (do
                      (let [e (mu-edge (load i))
                            s (load (field e source))
                            t (load (field e target))
                            owner (load (field e owner))
                            slot (load (field e target-slot))]
                        (if (or (< s 0) (or (>= s blocks) (or (< t 0) (>= t blocks))))
                            (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                            (if (or (!= owner (mu-block-owner s)) (!= owner (mu-block-owner t)))
                                (do (mu-fail-verify! MCFG-FUNCTION-ISOLATION (load i)) (break))
                                (if (or (!= (mu-adj-count (load i) false) 1)
                                        (!= (mu-adj-count (load i) true) 1))
                                    (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                                    (if (not (mu-slot-valid? (load i)))
                                        (do (mu-fail-verify! MCFG-PREDECESSOR-SLOT (load i)) (break))
                                        0)))))
                      (store! i (+ (load i) 1))
                      0)))
          (if (!= (mu-verify-result) MCFG-OK)
              false
              (if (not (mu-verify-terminators!))
                  false
                  (if (not (mu-verify-rpo!))
                      false
                      (mu-verify-idoms!))))))))

; Test-only corruption hooks are explicit and narrow; production callers only build and verify.
(defn mu-corrupt-block-owner! [(bid i64) (new-owner i64)] (-> i64)
  (store! (field (mu-block bid) owner) new-owner)
  0)
(defn mu-corrupt-edge-target-slot! [(eid i64) (slot i64)] (-> i64)
  (store! (field (mu-edge eid) target-slot) slot)
  0)
(defn mu-corrupt-drop-last-pred! [] (-> i64)
  (let [u (machine-unit)
        n (al-len [i64] (load (field u pred-edges)))]
    (if (> n 0) (store! (field (field u pred-edges) len) (- n 1)) 0)
    0))
(defn mu-corrupt-layout! [(bid i64) (layout i64)] (-> i64)
  (store! (field (mu-block bid) layout-index) layout)
  0)
(defn mu-corrupt-idom! [(bid i64) (parent i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) block-idom) bid parent)
  0)
(defn mu-corrupt-add-return-successor! [(bid i64)] (-> i64)
  (let [owner (mu-block-owner bid)]
    (al-push! [MEdge]
              (field (machine-unit) edges)
              (me-new (mu-edge-count) owner bid bid 0))
    (mu-finalize-adjacency!)
    0))
(defn mu-corrupt-edge-target! [(eid i64) (target i64)] (-> i64)
  (store! (field (mu-edge eid) target) target)
  (mu-finalize-adjacency!)
  0)

(defn mu-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        edges (mu-edge-count)
        (mut fidx) 0]
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      ideal (load (field f ideal))
                      nblocks (load (field f block-count))]
                  (fmt w "function {d} ideal {d} blocks {d}\n" (load fidx) ideal nblocks)
                  (let [(mut rpo) 0]
                    (loop (if (>= (load rpo) nblocks)
                              (break)
                              (do
                                (let [bid (mu-function-block (load fidx) (load rpo))
                                      ctrl (mu-block-control bid)]
                                  (fmt w "  b{d} {s}" (load rpo) (op-name (n-op ctrl)))
                                  ; Dump successors in target-layout order, independent of discovery order.
                                  (let [(mut target-layout) 0]
                                    (loop (if (>= (load target-layout) nblocks)
                                              (break)
                                              (do
                                                (let [(mut eid) 0]
                                                  (loop (if (>= (load eid) edges)
                                                            (break)
                                                            (do
                                                              (let [e (mu-edge (load eid))
                                                                    target (mu-edge-target (load eid))]
                                                                (if (and (= (mu-edge-source (load eid)) bid)
                                                                         (and (= (mu-block-owner target) (load fidx))
                                                                              (= (mu-block-layout-index target)
                                                                                 (load target-layout))))
                                                                    (do
                                                                      (fmt w
                                                                           " ->b{d}[{d}]"
                                                                           (load target-layout)
                                                                           (mu-edge-target-slot (load eid)))
                                                                      0)
                                                                    0))
                                                              (store! eid (+ (load eid) 1))
                                                              0))))
                                                (store! target-layout (+ (load target-layout) 1))
                                                0))))
                                  (ps w "\n"))
                                (store! rpo (+ (load rpo) 1))
                                0)))))
                (store! fidx (+ (load fidx) 1))
                0)))
    0))

(defn mu-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf)
        w (stack Writer)]
    (store! (field fb data) buf)
    (store! (field fb cap) cap)
    (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (mu-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "mu-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn mu-finish-build! [] (-> bool)
  (mu-finalize-adjacency!)
  (store! (field (machine-unit) phase) 1)
  (if (mu-compute-rpo!)
      (if (mu-compute-idoms!)
          (do (mu-compute-loop-depth!) (mu-verify!))
          (mu-fail-verify! MCFG-RPO -1))
      (mu-fail-verify! MCFG-RPO -1)))

(defn mu-build-entry! [(entry-fun i64)] (-> bool)
  (mu-reset!)
  (if (or (!= (g-verify) 0) (= (n-op entry-fun) OP-FUNSTART))
      false
      (if (!= (n-op entry-fun) OP-FUN)
          false
          (do
            (mu-build-reachable-function! entry-fun)
            (mu-finish-build!)))))

(defn mu-build-program! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0)
      false
      (let [owner (mu-build-function! NO-NODE (g-start))
            lim (n-count)
            (mut i) 0]
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-CALL))
                        (let [ctrl (n-in (load i) 0)
                              bid
                                (if (= ctrl NO-NODE)
                                    -1
                                    (al-get (load (field (machine-unit) ctrl-block)) ctrl))]
                          (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                              (mu-build-call-targets! (load i))
                              0))
                        0)
                    (store! i (+ (load i) 1))
                    0)))
        (mu-finish-build!))))

(defn mu-build! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0)
      false
      (let [lim (n-count)
            (mut i) 0
            (mut found) false]
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (= (n-op (load i)) OP-FUN))
                        (do
                          (mu-build-function! (load i) (n-fun-entry (load i)))
                          (store! found true))
                        0)
                    (store! i (+ (load i) 1))
                    0)))
        ; A graph without explicit Fun nodes is one synthetic top-level machine function.
        (if (not (load found)) (mu-build-function! NO-NODE (g-start)) 0)
        (mu-finish-build!))))

(defn be-loop-phi [(lp i64)] (-> i64)
  (let [len (n-nouts lp)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out lp (load i))]
                  (if (and (not (n-dead? u))
                           (and (and (= (n-op u) OP-PHI) (= (n-in u 0) lp))
                                (not (ty-mem? (n-ty u)))))
                      (store! found u)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn be-select-loop-memory! [(lp i64)] (-> bool)
  (let [len (n-nouts lp)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) len) (not (load ok)))
              (break)
              (do
                (let [u (n-out lp (load i))]
                  (if (and (not (n-dead? u))
                           (and (= (n-op u) OP-PHI) (ty-mem? (n-ty u))))
                      (if (select-memory! (n-in u 2)) 0 (store! ok false))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load ok)))

(defn be-select-loop-memory-init! [(lp i64)] (-> bool)
  (let [len (n-nouts lp)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) len) (not (load ok)))
              (break)
              (do
                (let [u (n-out lp (load i))]
                  (if (and (not (n-dead? u))
                           (and (= (n-op u) OP-PHI) (ty-mem? (n-ty u))))
                      (if (select-memory! (n-in u 1)) 0 (store! ok false))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load ok)))

(defn be-select-loop! [(lp i64) (next-label (ptr i64))] (-> bool)
  (let [phi (be-loop-phi lp)
        iff (be-ctrl-succ lp)]
    (if (= phi NO-NODE)
        (let [prior (al-get (load (field (backend) clabel)) lp)]
          (if (>= prior 0)
              (do (be-emit! (mi-new MI-B -1 -1 -1 prior lp)) true)
              (let [head (load next-label)]
                (store! next-label (+ head 1))
                (al-set! [i64] (field (backend) clabel) lp head)
                (be-emit! (mi-new MI-LABEL -1 -1 -1 head lp))
                (if (= iff NO-NODE)
                    (be-fail! BER-UNSUPPORTED-CFG lp)
                    (be-select-control! iff next-label)))))
        (if (or (= iff NO-NODE) (!= (n-op iff) OP-IF))
            (be-fail! BER-UNSUPPORTED-CFG lp)
            (let [init (select-value! (n-in phi 1))]
              (if (< init 0)
                  false
                  (do
                    (al-set! [i64] (field (backend) nval) phi init)
                    (let [head (load next-label)
                          exit-label (+ head 1)]
                      (store! next-label (+ head 2))
                      ; Hoist invariant operands and allocation-derived pointers before the header.
                      ; The predicate instruction itself remains below the label and is recomputed.
                      (let [pn (n-in iff 1)]
                        (if (> (n-nins pn) 1) (select-value! (n-in pn 1)) 0)
                        (if (> (n-nins pn) 2) (select-value! (n-in pn 2)) 0))
                      (let [bn (n-in phi 2)]
                        (if (> (n-nins bn) 1) (select-value! (n-in bn 1)) 0)
                        (if (> (n-nins bn) 2) (select-value! (n-in bn 2)) 0))
                      (if (not (be-select-loop-memory-init! lp))
                          false
                          (do
                            (be-emit! (mi-new MI-LABEL -1 -1 -1 head lp))
                            (let [pred (select-value! (n-in iff 1))]
                              (if (< pred 0)
                                  false
                                  (do
                                    (be-emit! (mi-new MI-CBZ -1 pred -1 exit-label iff))
                                    (let [back (select-value! (n-in phi 2))]
                                      (if (< back 0)
                                          false
                                          (do
                                            (store! (field (backend) inloop) true)
                                            (let [mem-ok (be-select-loop-memory! lp)]
                                              (store! (field (backend) inloop) false)
                                              (if (not mem-ok)
                                                  false
                                                  (do
                                                    (be-emit! (mi-new MI-MOV -1 back -1 init phi))
                                                    (be-emit! (mi-new MI-B -1 -1 -1 head lp))
                                                    (be-emit! (mi-new MI-LABEL -1 -1 -1 exit-label lp))
                                                    (be-select-control! (be-if-arm iff 1) next-label))))))))))))))))))))

(defn be-select-control! [(ctrl i64) (next-label (ptr i64))] (-> bool)
  (let [c (if (or (= (n-op ctrl) OP-RETURN) (= (n-op ctrl) OP-IF)) ctrl (be-ctrl-succ ctrl))]
    (if (= c NO-NODE)
        (be-fail! BER-UNSUPPORTED-CFG ctrl)
        (case (n-op c) OP-RETURN
              (let [mem-ok
                      (if (and (> (n-nins c) 2) (ty-only-obj? (n-ty (n-in c 1))))
                          (select-memory! (n-in c 2))
                          true)
                    v (if mem-ok (select-value! (n-in c 1)) -1)]
                (if (< v 0) false (do (be-emit! (mi-new MI-RET -1 v -1 0 c)) true)))
                OP-IF
              (let [ta (be-if-arm c 0)
                    fa (be-if-arm c 1)
                    ts (be-ctrl-succ ta)
                    fs (be-ctrl-succ fa)]
                (if (and (!= ts NO-NODE) (and (= ts fs) (= (n-op ts) OP-REGION)))
                    ; Acyclic diamonds become dataflow CSELs. This is both smaller and avoids
                    ; manufacturing machine phis before the general loop/block scheduler lands.
                    (be-select-control! ts next-label)
                    (let [pred (select-value! (n-in c 1))
                          false-label (load next-label)]
                      (store! next-label (+ false-label 1))
                      (if (< pred 0)
                          false
                          (do
                            (be-emit! (mi-new MI-CBZ -1 pred -1 false-label c))
                            (if (not (be-select-control! ta next-label))
                                false
                                (do
                                  (be-emit! (mi-new MI-LABEL -1 -1 -1 false-label c))
                                  (be-select-control! fa next-label))))))))
                OP-LOOP
              (be-select-loop! c next-label)
                (if (= (n-op c) OP-CALLEND)
                    (be-fail! BER-UNSUPPORTED-CALL c)
                    (be-fail! BER-UNSUPPORTED-CFG c))))))

(defn be-select-program! [] (-> bool)
  (be-reset!)
  (if (not (be-preflight!))
      false
      (let [(mut label) 0] (be-select-control! (g-start) (mut label)))))

(defn be-inst-count [] (-> i64)
  (al-len [MInst] (load (field (backend) ins))))
(defn be-inst [(i i64)] (-> (ptr MInst))
  (be-al-elem [MInst] (field (backend) ins) i))

; ---------------------------------------------------------------------------
; G2 block-based selection. This path consumes the verified MachineUnit. It deliberately does
; not call the legacy diamond/loop selectors above; later milestones lower its block terminators.
; ---------------------------------------------------------------------------

(defn ms-result [] (-> i64)
  (load (field (machine-unit) selection-result)))
(defn ms-result-item [] (-> i64)
  (load (field (machine-unit) selection-item)))

(defn ms-fail! [(code i64) (item i64)] (-> i64)
  (let [u (machine-unit)]
    (if (= (load (field u selection-result)) MSEL-OK)
        (do
          (store! (field u selection-result) code)
          (store! (field u selection-item) item))
        0)
    -1))

(defn ms-map-index [(owner i64) (node i64)] (-> i64)
  (+ (* owner (n-count)) node))

(defn ms-map-init! [] (-> i64)
  (let [u (machine-unit)
        total (* (mu-function-count) (n-count))
        (mut i) 0]
    (al-clear! [i64] (field u selected-values))
    (al-clear! [i64] (field u selected-nodes))
    (loop (if (>= (load i) total)
              (break)
              (do
                (al-push! [i64] (field u selected-values) -1)
                (al-push! [i64] (field u selected-nodes) 0)
                (store! i (+ (load i) 1))
                0)))
    0))

(defn ms-vget [(owner i64) (node i64)] (-> i64)
  (al-get (load (field (machine-unit) selected-values)) (ms-map-index owner node)))
(defn ms-vset! [(owner i64) (node i64) (vreg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) selected-values) (ms-map-index owner node) vreg)
  0)
(defn ms-new-vreg! [] (-> i64)
  (let [u (machine-unit)
        p (field u next-vreg)
        v (load p)]
    (store! p (+ v 1))
    (al-push! [i64] (field u vreg-phi-block) -1)
    v))
(defn ms-seen? [(owner i64) (node i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) selected-nodes)) (ms-map-index owner node)) 0))
(defn ms-seen! [(owner i64) (node i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) selected-nodes) (ms-map-index owner node) 1)
  0)

;; The whole-program graph root is the kernel's entry control. Other unmapped or foreign controls
;; must remain rejected so instructions cannot leak across function owners.
(defn ms-node-block [(owner i64) (node i64)] (-> i64)
  (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
    (if (= ctrl NO-NODE)
        (ms-entry-block owner)
        (if (and (= owner 0) (= ctrl (g-start)))
            (ms-entry-block owner)
            (let [mapped (al-get (load (field (machine-unit) ctrl-block)) ctrl)]
              (if (and (>= mapped 0) (= (mu-block-owner mapped) owner))
                  mapped
                  -1))))))

(defn ms-emit! [(owner i64) (bid i64) (m MInst)] (-> i64)
  (let [id (be-emit! m)
        p (be-inst id)]
    (store! (field p owner) owner)
    (store! (field p block-id) bid)
    id))

(defn ms-push-memory-dep-tree! [(first i64) (node i64) (fuel i64)] (-> i64)
  (if (or (< node 0) (<= fuel 0))
      0
      (let [deps (field (machine-unit) selection-memory-deps)
            (mut scan) first
            (mut seen) false]
        (loop (if (or (>= (load scan) (al-len [i64] (load deps))) (load seen))
                  (break)
                  (do
                    (if (= (al-get [i64] (load deps) (load scan)) node)
                        (store! seen true)
                        0)
                    (store! scan (+ (load scan) 1)))))
        (if (load seen)
            0
            (do
              (al-push! [i64] (mut deps) node)
              (case (n-op node) OP-MEMMERGE
                    (let [(mut i) 1]
                      (loop (if (>= (load i) (n-nins node))
                                (break)
                                (do
                                  (ms-push-memory-dep-tree!
                                    first (n-in node (load i)) (- fuel 1))
                                  (store! i (+ (load i) 1))))))
                    OP-STORE
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-PROPSTORE
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-SETPROTO
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-ARRAYSTORE
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-ARRAYRESIZE
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-ARRAYCOPY
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    OP-STRINGSPLIT
                    (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1))
                    0)
              0)))))

(defn ms-add-memory-deps! [(at i64) (node i64) (first-slot i64) (count i64)] (-> i64)
  (let [u (machine-unit)
        m (be-inst at)
        first (al-len [i64] (load (field u selection-memory-deps)))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (ms-push-memory-dep-tree! first
                                          (n-in node (+ first-slot (load i)))
                                          16384)
                (store! i (+ (load i) 1))
                0)))
    (store! (field m mem-first) first)
    (store! (field m mem-count)
            (- (al-len [i64] (load (field u selection-memory-deps))) first))
    0))

(defn ms-add-call-args! [(at i64) (first i64) (count i64)] (-> i64)
  (let [m (be-inst at)]
    (store! (field m arg-first) first)
    (store! (field m arg-count) count)
    0))

(defn ms-add-single-arg! [(at i64) (value i64)] (-> i64)
  (let [u (machine-unit)
        first (al-len [i64] (load (field u call-args)))]
    (al-push! [i64] (field u call-args) value)
    (ms-add-call-args! at first 1)))

(defn ms-entry-block [(owner i64)] (-> i64)
  (mu-function-block owner 0))

;; A CallEnd is an intra-block control dependency, not merely a block owner. Preserve the chain
;; before selecting a later safepoint/effect; otherwise recursive object construction can schedule
;; the parent New before the calls that compute its fields. Besides changing source evaluation
;; order, that exposes a partially initialized parent to moving collection.
(defn ms-select-control-effects! [(owner i64) (ctrl i64) (bid i64)] (-> bool)
  (if (or (< ctrl 0) (!= (n-op ctrl) OP-CALLEND))
      true
      (if (not (ms-select-control-effects! owner (n-in ctrl 0) bid))
          false
          (>= (ms-select-value-at! owner (n-in ctrl 1) bid) 0))))

(defn ms-memory-block [(owner i64) (node i64)] (-> i64)
  ;; Memory operations put their memory dependency, not control, in input 0. Placing one from
  ;; ms-node-block would therefore confuse a loop Memory Phi with the operation's control block
  ;; and can sink a preheader store into the loop. Follow the ordered memory chain first; only
  ;; control-bearing roots and ordinary values use their direct block mapping.
  (let [pinned
          (if (and (> (n-nins node) 0) (!= (n-in node 0) NO-NODE))
              (ms-node-block owner node)
              -1)
        (mut current) node
        (mut answer) -1
        (mut done) false]
    ;; Real programs have long property-memory chains, so walk iteratively instead of consuming
    ;; the native compiler stack once per source effect.
    (if (>= pinned 0) (do (store! answer pinned) (store! done true)) 0)
    (loop (if (load done)
              (break)
              (case (n-op (load current)) OP-STORE
                    (store! current (n-in (load current) 1)) OP-LOAD
                    (store! current (n-in (load current) 1)) OP-PROPSTORE
                    (store! current (n-in (load current) 1)) OP-SETPROTO
                    (store! current (n-in (load current) 1)) OP-PROPLOAD
                    (store! current (n-in (load current) 1)) OP-ARRAYSTORE
                    (store! current (n-in (load current) 1)) OP-ARRAYRESIZE
                    (store! current (n-in (load current) 1)) OP-ARRAYLOAD
                    (store! current (n-in (load current) 1)) OP-ARRAYLEN
                    (store! current (n-in (load current) 1)) OP-ARRAYCOPY
                    (store! current (n-in (load current) 1)) OP-STRINGSPLIT
                    (store! current (n-in (load current) 1)) OP-PROJ
                    (do
                      (store! answer
                              (if (= (n-op (n-in (load current) 0)) OP-NEW)
                                  (ms-node-block owner (n-in (load current) 0))
                                  (ms-node-block owner (load current))))
                      (store! done true))
                      (do
                        (store! answer (ms-node-block owner (load current)))
                        (store! done true)))))
    (load answer)))

(defn ms-memory-chain-phi? [(node i64)] (-> bool)
  (if (< node 0)
      false
      (case (n-op node) OP-PHI
            true OP-STORE
            (ms-memory-chain-phi? (n-in node 1)) OP-PROPSTORE
            (ms-memory-chain-phi? (n-in node 1)) OP-SETPROTO
            (ms-memory-chain-phi? (n-in node 1)) OP-ARRAYSTORE
            (ms-memory-chain-phi? (n-in node 1)) OP-ARRAYRESIZE
            (ms-memory-chain-phi? (n-in node 1)) OP-ARRAYCOPY
            (ms-memory-chain-phi? (n-in node 1)) OP-STRINGSPLIT
            (ms-memory-chain-phi? (n-in node 1)) OP-MEMMERGE
            (let [(mut i) 1
                  (mut found) false]
              (loop (if (or (>= (load i) (n-nins node)) (load found))
                        (break)
                        (do
                          (store! found (ms-memory-chain-phi? (n-in node (load i))))
                          (store! i (+ (load i) 1)))))
              (load found))
              false)))

(defn ms-array-owner-block [(owner i64) (array i64)] (-> i64)
  (if (= (n-op array) OP-ARRAYMARK)
      (let [ptr (n-in array 1)]
        (if (and (= (n-op ptr) OP-PROJ) (= (n-op (n-in ptr 0)) OP-NEW))
            (ms-node-block owner (n-in ptr 0))
            (ms-node-block owner ptr)))
      (ms-node-block owner array)))

(defn ms-selected-effect-node-block [(owner i64) (node i64) (fallback i64)] (-> i64)
  (case (n-op node) OP-PROPSTORE
        (let [value-block (ms-node-block owner (n-in node 3))
              object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= value-block 0) (!= value-block (ms-entry-block owner)))
              value-block
              (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
                  object-block
                  fallback))) OP-SETPROTO
        (let [prototype-block (ms-node-block owner (n-in node 3))
              object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= prototype-block 0) (!= prototype-block (ms-entry-block owner)))
              prototype-block
              (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
                  object-block
                  fallback)))
          fallback))

(defn ms-array-effect-block [(owner i64) (memory i64) (array i64) (fallback i64)] (-> i64)
  (let [(mut at) 0
        (mut selected) -1]
    ;; Once the ordered predecessor has been selected, its actual placement is a hard lower bound.
    ;; The ideal memory node itself has no control input, so ms-memory-block can only name its chain
    ;; root and may otherwise place a consumer above a branch-local predecessor.
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load at))]
                  (if (and (= (load (field m owner)) owner)
                           (= (load (field m node)) memory))
                      (store! selected (load (field m block-id)))
                      0))
                (store! at (+ (load at) 1)))))
    (let [base
            (if (>= (load selected) 0)
                (load selected)
                (ms-selected-effect-node-block owner memory fallback))]
      (if (ms-memory-chain-phi? memory)
          base
          (ms-selection-deeper-block base (ms-array-owner-block owner array))))))

(defn ms-selection-deeper-block [(current i64) (candidate i64)] (-> i64)
  (if (< candidate 0)
      current
      (if (mu-dominates? current candidate) candidate current)))

(defn ms-selection-value-block-fuel [(owner i64) (fallback i64) (vreg i64) (fuel i64)] (-> i64)
  (let [def (ms-def-inst vreg)]
    (if (or (< def 0) (<= fuel 0))
        fallback
        (let [m (be-inst def)
              desc (mi-desc (load (field m op)))
              inputs (mi-desc-inputs desc)
              (mut block) (ms-selection-deeper-block fallback (load (field m block-id)))]
          ; Follow pure producer chains so provisional entry/fallback placement cannot hide a
          ; branch-local operand from the effect that consumes it.
          (if (> inputs 0)
              (store! block
                      (ms-selection-value-block-fuel
                        owner (load block) (load (field m a)) (- fuel 1)))
              0)
          (if (> inputs 1)
              (store! block
                      (ms-selection-value-block-fuel
                        owner (load block) (load (field m b)) (- fuel 1)))
              0)
          (load block)))))

(defn ms-selection-value-block [(owner i64) (fallback i64) (vreg i64)] (-> i64)
  (ms-selection-value-block-fuel owner fallback vreg 64))

;; Heap reads with an explicit control input are pinned to that control block. A value user in a
;; dominating block must not pull the read above its guard (for example, packet.kind above
;; `packet != null`). Unpinned legacy reads retain their demand placement.
(defn ms-pinned-read-block [(owner i64) (node i64) (fallback i64)] (-> i64)
  (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
    (if (< ctrl 0)
        fallback
        (let [mapped (al-get (load (field (machine-unit) ctrl-block)) ctrl)]
          (if (and (>= mapped 0) (= (mu-block-owner mapped) owner)) mapped fallback)))))

(defn ms-linear-memory-effect? [(node i64)] (-> bool)
  (let [op (n-op node)]
    (or (= op OP-STORE)
        (or (= op OP-PROPSTORE)
            (or (= op OP-SETPROTO)
                (or (= op OP-ARRAYSTORE)
                    (or (= op OP-ARRAYRESIZE)
                        (or (= op OP-ARRAYCOPY) (= op OP-STRINGSPLIT)))))))))

(defn ms-select-memory-at! [(owner i64) (node i64) (bid i64)] (-> bool)
  (if (ms-seen? owner node)
      true
      (let [(mut pending) (al-new [i64] (malloc-allocator))
            (mut current) node
            (mut ok) true]
        ;; Heap effects form long predecessor chains in real JavaScript programs. Walk that spine
        ;; iteratively, select its base once, then publish effects oldest-to-newest.
        (loop (if (or (ms-seen? owner (load current))
                      (not (ms-linear-memory-effect? (load current))))
                  (break)
                  (do
                    (al-push! [i64] (mut pending) (load current))
                    (store! current (n-in (load current) 1)))))
        (if (not (ms-seen? owner (load current)))
            (let [placement (ms-memory-block owner (load current))]
              (store! ok
                      (ms-select-memory-at-core! owner
                                                 (load current)
                                                 (if (>= placement 0) placement bid))))
            0)
        (let [(mut index) (al-len [i64] (load pending))]
          (loop (if (or (<= (load index) 0) (not (load ok)))
                    (break)
                    (do
                      (store! index (- (load index) 1))
                      (store! ok
                              (let [effect
                                      (al-get [i64] (load pending) (load index))]
                                (let [placement (ms-memory-block owner effect)]
                                  (ms-select-memory-at-core! owner
                                                             effect
                                                             (if (>= placement 0)
                                                                 placement
                                                                 bid)))))))))
        (al-free! [i64] (mut pending))
        (load ok))))

(defn ms-select-memory-at-core! [(owner i64) (node i64) (bid i64)] (-> bool)
  (if (ms-seen? owner node)
      true
      (let [(mut ok) true]
        (case (n-op node) OP-STORE
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [ptr (ms-select-value-at! owner (n-in node 2) bid)
                        value (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< ptr 0) (< value 0))
                        (store! ok false)
                        (let [at
                                (ms-emit! owner
                                          bid
                                          (mi-new MI-STORE
                                                  -1
                                                  ptr
                                                  value
                                                  (be-field-off (n-aux node))
                                                  node))]
                          (ms-add-memory-deps! at node 1 1)))))
                OP-PROJ
              (if (= (n-op (n-in node 0)) OP-NEW)
                  (if (< (ms-select-value-at! owner (n-in node 0) bid) 0) (store! ok false) 0)
                  0)
                OP-PROPSTORE
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        value (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< object 0) (< value 0))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid bid
                              at (ms-emit! owner effect-bid (mi-new MI-JSPROP fresh object value 1 node))]
                          (ms-add-memory-deps! at node 1 1)))))
                OP-ARRAYSTORE
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        index (ms-select-value-at! owner (n-in node 3) bid)
                        value (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< object 0) (or (< index 0) (< value 0)))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 2) bid)
                                      object)
                                    index)
                                  value)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh object index 2 node))]
                          (ms-add-single-arg! at value)
                          (ms-add-memory-deps! at node 1 1)))))
                OP-ARRAYRESIZE
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        length (ms-select-value-at! owner (n-in node 3) bid)
                        ordered (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< object 0) (or (< length 0) (< ordered 0)))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 2) bid)
                                      object)
                                    length)
                                  ordered)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh object length 4 node))]
                          (ms-add-single-arg! at ordered)
                          (ms-add-memory-deps! at node 1 1)))))
                OP-ARRAYCOPY
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [source (ms-select-value-at! owner (n-in node 2) bid)
                        result (ms-select-value-at! owner (n-in node 3) bid)
                        start (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< source 0) (or (< result 0) (< start 0)))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 3) bid)
                                      source)
                                    result)
                                  start)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh source start 5 node))]
                          (ms-add-single-arg! at result)
                          (ms-add-memory-deps! at node 1 1)))))
                OP-STRINGSPLIT
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [string (ms-select-value-at! owner (n-in node 2) bid)
                        delimiter (ms-select-value-at! owner (n-in node 3) bid)
                        result (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< string 0) (or (< delimiter 0) (< result 0)))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              at
                                (ms-emit! owner
                                          bid
                                          (mi-new MI-JSSTRING
                                                  fresh
                                                  string
                                                  delimiter
                                                  JSSOP-SPLIT
                                                  node))]
                          (ms-add-single-arg! at result)
                          (ms-add-memory-deps! at node 1 1)))))
                OP-SETPROTO
              (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (store! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        prototype (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< object 0) (< prototype 0))
                        (store! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid bid
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSPROP fresh object prototype 2 node))]
                          (ms-add-memory-deps! at node 1 1)))))
                OP-ARG
              0 OP-PARM
              0 OP-MEMMERGE
              (let [len (n-nins node)
                    (mut i) 1]
                (loop (if (or (>= (load i) len) (not (load ok)))
                          (break)
                          (do
                            (if (not (ms-select-memory-at! owner
                                                           (n-in node (load i))
                                                           (ms-memory-block owner
                                                                            (n-in node (load i)))))
                                (store! ok false)
                                0)
                            (store! i (+ (load i) 1))
                            0))))
                OP-PHI
              (do (ms-fail! MSEL-UNSUPPORTED node) (store! ok false)) 0)
        (if (load ok) (do (ms-seen! owner node) true) false))))

(defn ms-select-memory! [(owner i64) (node i64)] (-> bool)
  (ms-select-memory-at! owner node (ms-memory-block owner node)))

(defn ms-select-binary! [(owner i64) (node i64) (mop i64) (bid i64)] (-> i64)
  (let [a (ms-select-value-at! owner (n-in node 1) bid)
        b (ms-select-value-at! owner (n-in node 2) bid)]
    (if (or (< a 0) (< b 0))
        -1
        (let [vr (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new mop vr a b 0 node))
          vr))))

(defn ms-select-int32-binary! [(owner i64) (node i64) (mop i64) (bid i64)] (-> i64)
  (let [an (n-in node 1)
        bn (n-in node 2)
        raw-a (ms-select-value-at! owner an bid)
        raw-b (ms-select-value-at! owner bn bid)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a
                (if (be-node-fp-value? an)
                    (let [fresh (ms-new-vreg!)]
                      (ms-emit! owner bid (mi-new MI-I32FROMFP fresh raw-a -1 0 NO-NODE))
                      fresh)
                    raw-a)
              b
                (if (be-node-fp-value? bn)
                    (let [fresh (ms-new-vreg!)]
                      (ms-emit! owner bid (mi-new MI-I32FROMFP fresh raw-b -1 0 NO-NODE))
                      fresh)
                    raw-b)
              fresh (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new mop fresh a b 0 node))
          fresh))))

(defn ms-fp-input! [(owner i64) (node i64) (vreg i64) (bid i64)] (-> i64)
  (if (be-node-fp-value? node)
      vreg
      (let [fresh (ms-new-vreg!)]
        (ms-emit! owner bid (mi-new MI-SCVTF fresh vreg -1 0 NO-NODE))
        fresh)))

(defn ms-select-numeric-binary! [(owner i64) (node i64) (integer-op i64) (bid i64)] (-> i64)
  (if (or (be-node-fp-value? node)
          (or (be-node-fp-value? (n-in node 1))
              (be-node-fp-value? (n-in node 2))))
      (let [raw-a (ms-select-value-at! owner (n-in node 1) bid)
            raw-b (ms-select-value-at! owner (n-in node 2) bid)]
        (if (or (< raw-a 0) (< raw-b 0))
            -1
            (let [a (ms-fp-input! owner (n-in node 1) raw-a bid)
                  b (ms-fp-input! owner (n-in node 2) raw-b bid)
                  fresh (ms-new-vreg!)]
              (ms-emit! owner bid (mi-new (be-fp-op (n-op node)) fresh a b 0 node))
              fresh)))
      (ms-select-binary! owner node integer-op bid)))

(defn ms-select-mod! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [an (n-in node 1)
        bn (n-in node 2)
        raw-a (ms-select-value-at! owner an bid)
        raw-b (ms-select-value-at! owner bn bid)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a (ms-fp-input! owner an raw-a bid)
              b (ms-fp-input! owner bn raw-b bid)
              fresh (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new MI-FMOD fresh a b 0 node))
          fresh))))

(defn ms-immediate! [(owner i64) (bid i64) (value i64)] (-> i64)
  (let [fresh (ms-new-vreg!)]
    (ms-emit! owner bid (mi-new MI-MOVI fresh -1 -1 value NO-NODE))
    fresh))

(defn ms-jsstring! [(owner i64)
                    (bid i64)
                    (node i64)
                    (a i64)
                    (b i64)
                    (value i64)
                    (operation i64)] (-> i64)
  (let [fresh (ms-new-vreg!)
        at (ms-emit! owner bid (mi-new MI-JSSTRING fresh a b operation node))]
    (ms-add-single-arg! at value)
    fresh))

(defn ms-select-string-const! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [string (n-aux node)
        length (jss-length string)
        zero (ms-immediate! owner bid 0)
        length-value (ms-immediate! owner bid length)
        (mut result) (ms-jsstring! owner bid (if (= length 0) node NO-NODE) zero length-value zero JSSOP-NEW)
        (mut index) 0]
    (loop (if (>= (load index) length)
              (break)
              (let [at (ms-immediate! owner bid (load index))
                    unit (ms-immediate! owner bid (jss-code-unit string (load index)))]
                (store! result
                        (ms-jsstring! owner
                                      bid
                                      (if (= (+ (load index) 1) length) node NO-NODE)
                                      (load result)
                                      at
                                      unit
                                      JSSOP-SET-UNIT))
                (store! index (+ (load index) 1)))))
    (load result)))

(defn ms-select-string-binary! [(owner i64) (node i64) (bid i64) (operation i64)] (-> i64)
  (let [left (ms-select-value-at! owner (n-in node 1) bid)
        right (ms-select-value-at! owner (n-in node 2) bid)]
    (if (or (< left 0) (< right 0))
        -1
        (ms-jsstring! owner bid node left right (ms-immediate! owner bid 0) operation))))

(defn ms-select-value-at! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [prior (ms-vget owner node)]
    (if (>= prior 0)
        prior
        (let [op (n-op node)
              (mut vr) -1]
          (case op OP-CONST
