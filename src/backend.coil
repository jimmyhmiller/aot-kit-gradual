(defn be-u32! [(w i64)] (-> i64)
  (let [b (field (backend) code)]
    (al-push! [u8] b (cast u8 (& w 255)))
    (al-push! [u8] b (cast u8 (& (>> w 8) 255)))
    (al-push! [u8] b (cast u8 (& (>> w 16) 255)))
    (al-push! [u8] b (cast u8 (& (>> w 24) 255)))
    0))

(defn be-reg-of [(vr i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut r) -1]
    (loop (if (or (>= (load i) n) (>= (load r) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) dst)) vr)
                    (store! r (load (field (be-inst (load i)) reg)))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load r)))

(defn be-spill-of [(vr i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut s) -1]
    (loop (if (or (>= (load i) n) (>= (load s) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) dst)) vr)
                    (store! s (load (field (be-inst (load i)) spill)))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load s)))

(defn be-owner-of [(vr i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut owner) -1]
    (loop (if (or (>= (load i) n) (>= (load owner) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) dst)) vr)
                    (store! owner (load (field (be-inst (load i)) owner)))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load owner)))

(defn be-spill-off [(slot i64)] (-> i64)
  (+ 1024 (* slot 8)))
(defn be-spill-off-vreg [(vr i64)] (-> i64)
  (let [slot (be-spill-of vr)
        owner (be-owner-of vr)]
    (if (>= owner 0)
        (+ 16 (* (+ (mu-function-callee-count owner) slot) 8))
        (be-spill-off slot))))

;; Legacy single-return selection predates machine liveness and therefore has no class table. Its
;; existing values are all GPRs; machine-program selection always publishes the explicit class.
(defn be-register-class [(vr i64)] (-> i64)
  (let [classes (load (field (machine-unit) register-class))]
    (if (or (< vr 0) (or (< (be-owner-of vr) 0) (>= vr (al-len [i64] classes))))
        MRC-GPR
        (al-get classes vr))))

(defn be-callee-save-off [(owner i64) (reg i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner)
        (mut r) 19
        (mut rank) 0]
    (loop (if (>= (load r) reg)
              (break)
              (do
                (if (!= (& mask (<< 1 (load r))) 0) (store! rank (+ (load rank) 1)) 0)
                (store! r (+ (load r) 1))
                0)))
    (+ 16 (* (load rank) 8))))

(defn be-read-reg! [(vr i64) (scratch i64)] (-> i64)
  (if (< vr 0)
      -1
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)]
              (if (< s 0) -1 (do (be-u32! (a64-ldr scratch 31 (be-spill-off-vreg vr))) scratch)))))))

(defn be-read-value! [(vr i64) (scratch i64)] (-> i64)
  (if (or (< vr 0) (= (be-register-class vr) MRC-GPR))
      (be-read-reg! vr scratch)
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)
                  ds (if (= scratch 15) 30 31)]
              (if (< s 0)
                  -1
                  (do (be-u32! (a64-ldr-d ds 31 (be-spill-off-vreg vr))) (+ ds 32))))))))

(defn be-read-reg-delta! [(vr i64) (scratch i64) (sp-delta i64)] (-> i64)
  (if (< vr 0)
      -1
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)]
              (if (< s 0)
                  -1
                  (do (be-u32! (a64-ldr scratch 31 (+ sp-delta (be-spill-off-vreg vr)))) scratch)))))))

(defn be-read-value-delta! [(vr i64) (scratch i64) (sp-delta i64)] (-> i64)
  (if (= (be-register-class vr) MRC-GPR)
      (be-read-reg-delta! vr scratch sp-delta)
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)
                  ds (if (= scratch 15) 30 31)]
              (if (< s 0)
                  -1
                  (do
                    (be-u32! (a64-ldr-d ds 31 (+ sp-delta (be-spill-off-vreg vr))))
                    (+ ds 32))))))))

(defn be-write-reg [(vr i64)] (-> i64)
  (let [r (be-reg-of vr)]
    (if (>= r 0) r (if (= (be-register-class vr) MRC-FPR) 62 14))))

(defn be-store-written! [(vr i64) (from i64)] (-> i64)
  (let [s (be-spill-of vr)]
    (if (< s 0)
        0
        (if (= (be-register-class vr) MRC-FPR)
            (be-u32! (a64-str-d (- from 32) 31 (be-spill-off-vreg vr)))
            (be-u32! (a64-str from 31 (be-spill-off-vreg vr)))))))

(defn be-entry-label-owner [(bid i64)] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0
        (mut found) -1]
    (loop (if (or (>= (load owner) funcs) (>= (load found) 0))
              (break)
              (do
                (if (= (mu-function-block (load owner) 0) bid) (store! found (load owner)) 0)
                (store! owner (+ (load owner) 1))
                0)))
    (load found)))

(defn be-align16 [(n i64)] (-> i64)
  (& (+ n 15) -16))
(defn be-call-area [(argc i64)] (-> i64)
  (be-align16 (* argc 8)))
(defn be-call-spill-loads [(m (ptr MInst))] (-> i64)
  (let [count (load (field m arg-count))
        first (load (field m arg-first))
        (mut i) 0
        (mut loads) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (let [vr (al-get (load (field (machine-unit) call-args)) (+ first (load i)))]
                  (if (< (be-reg-of vr) 0) (store! loads (+ (load loads) 1)) 0))
                (store! i (+ (load i) 1))
                0)))
    (load loads)))

(defn be-call-arg-class-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [first (load (field m arg-first))
        vr (al-get (load (field (machine-unit) call-args)) (+ first which))
        class (be-register-class vr)
        (mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do
                (let [prior (al-get (load (field (machine-unit) call-args)) (+ first (load i)))]
                  (if (= (be-register-class prior) class) (store! index (+ (load index) 1)) 0))
                (store! i (+ (load i) 1))
                0)))
    (load index)))

(defn be-call-register-loads [(m (ptr MInst))] (-> i64)
  (let [count (load (field m arg-count))
        (mut i) 0
        (mut loads) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (< (be-call-arg-class-index m (load i)) 8)
                    (store! loads (+ (load loads) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load loads)))

(defn be-call-stack-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [(mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do
                (if (>= (be-call-arg-class-index m (load i)) 8)
                    (store! index (+ (load index) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load index)))

(defn be-call-stack-count [(m (ptr MInst))] (-> i64)
  (let [count (load (field m arg-count))
        (mut i) 0
        (mut stack) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (>= (be-call-arg-class-index m (load i)) 8)
                    (store! stack (+ (load stack) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load stack)))

(defn be-mov-imm! [(rd i64) (v i64)] (-> i64)
  (be-u32! (a64-movz rd (& v 65535) 0))
  (let [(mut hw) 1]
    (loop (if (>= (load hw) 4)
              (break)
              (do
                (let [part (& (>> v (* (load hw) 16)) 65535)]
                  (if (= part 0) 0 (be-u32! (a64-movk rd part (load hw)))))
                (store! hw (+ (load hw) 1))
                0)))
    0))

(defn be-mov-words [(v i64)] (-> i64)
  (let [(mut words) 1
        (mut hw) 1]
    (loop (if (>= (load hw) 4)
              (break)
              (do
                (if (= (& (>> v (* (load hw) 16)) 65535) 0)
                    0
                    (store! words (+ (load words) 1)))
                (store! hw (+ (load hw) 1))
                0)))
    (load words)))

(defn be-store-barrier-kind [(m (ptr MInst))] (-> i64)
  (let [node (load (field m node))]
    (if (and (be-runtime-allocation?)
             (and (>= node 0)
                  (and (< node (n-count))
                       (and (= (n-op node) OP-STORE)
                            (shape-alias-defined? (n-aux node))))))
        (ml-kind-for-type (shape-alias-ty (n-aux node)))
        MLK-SCALAR)))
(defn be-store-barrier? [(m (ptr MInst))] (-> bool)
  (let [kind (be-store-barrier-kind m)]
    (or (= kind MLK-RAW-MANAGED) (= kind MLK-BOXED))))

(defn be-js-managed-tag? [(tag i64)] (-> bool)
  (or (= tag JSV-OBJECT)
      (or (= tag JSV-ARRAY) (or (= tag JSV-CLOSURE) (= tag JSV-REGEXP)))))
(defn be-js-unbox-validation-words [(tag i64)] (-> i64)
  (if (or (= tag JSV-UNDEFINED) (= tag JSV-NULL))
      3
      (if (= tag JSV-BOOLEAN) 4 (if (be-js-managed-tag? tag) 6 0))))

(defn be-poly-call? [(m (ptr MInst))] (-> bool)
  (and (= (load (field m op)) MI-CALL) (< (load (field m imm)) 0)))
(defn be-poly-call-targets [(m (ptr MInst))] (-> i64)
  (if (be-poly-call? m) (^ (load (field m imm)) -1) 0))
(defn be-poly-call-dispatch-words [(m (ptr MInst))] (-> i64)
  (let [targets (be-poly-call-targets m)
        (mut fidx) 0
        (mut words) 0]
    (loop (if (>= (load fidx) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load fidx))) 0)
                    (store! words (+ (load words) (+ (be-mov-words (load fidx)) 3)))
                    0)
                (store! fidx (+ (load fidx) 1)))))
    (load words)))

(defn be-inst-words [(m (ptr MInst))] (-> i64)
  (let [op (load (field m op))
        a (load (field m a))
        b (load (field m b))
        dst (load (field m dst))
        base
          (case op MI-ARG
                0 MI-LABEL
                (let [owner (be-entry-label-owner (load (field m imm)))]
                  (if (>= owner 0) (+ 4 (mu-function-callee-count owner)) 0))
                  MI-MOVI
                (be-mov-words (load (field m imm))) MI-FMOVI
                (+ (be-mov-words (load (field m imm))) 1) MI-SCVTF
                1 MI-I32FROMFP
                (+ (be-mov-words 4751297606875873280) 8) MI-FADD
                1 MI-FSUB
                1 MI-FMUL
                1 MI-FDIV
                1 MI-FNEG
                1 MI-FMOD
                (+ 20
                   (+ (be-mov-words -9223372036854775808)
                      (be-mov-words JSV-NAN))) MI-FEQ
                2 MI-FLT
                2 MI-FLE
                2 MI-FTRUTH
                4 MI-MOD
                5 MI-BITAND
                2 MI-BITOR
                2 MI-BITXOR
                2 MI-BITNOT
                2 MI-SHL
                4 MI-SHR
                5 MI-USHR
                5 MI-JSBOX
                (if (= (load (field m imm)) JSV-RAW-NULLABLE-OBJECT)
                    11
                    (if (= (load (field m imm)) 0)
                        1
                        (+ 2 (+ (be-mov-words JSV-PAYLOAD-MASK)
                                (be-mov-words (load (field m imm))))))) MI-JSUNBOX
                (if (= (load (field m imm)) 0)
                    (+ 25
                       (+ (be-mov-words JSV-TAG-MASK)
                          (be-mov-words JSV-INTEGER)))
                    (+ 5
                       (+ (be-mov-words JSV-TAG-MASK)
                          (+ (be-mov-words (load (field m imm)))
                             (+ (be-mov-words JSV-PAYLOAD-MASK)
                                (be-js-unbox-validation-words (load (field m imm))))))))
                  MI-JSTEST
                (if (= (load (field m imm)) 0)
                    19
                    (+ 3
                       (+ (be-mov-words JSV-TAG-MASK)
                          (be-mov-words (load (field m imm))))))
                  MI-NEW
                (if (be-runtime-allocation?)
                    (let [sw (be-mov-words (shape-size (load (field m imm))))]
                      (+ (+ 19 sw)
                         (* 2 (+ sw (be-mov-words (load (field m imm)))))))
                    1)
                  MI-EQ
                2 MI-LT
                2 MI-LE
                2 MI-CSEL
                2 MI-CALL
                (+ (if (be-poly-call? m)
                       (+ 15
                          (+ (if (< (be-reg-of (load (field m a))) 0) 1 0)
                             (+ (be-mov-words JSV-TAG-MASK)
                                (+ (be-mov-words JSV-FUNCTION)
                                   (+ (be-mov-words JSV-PAYLOAD-MASK)
                                      (be-poly-call-dispatch-words m))))))
                       5)
                   (+ (load (field m arg-count))
                      (+ (be-call-register-loads m)
                         (+ (be-call-spill-loads m)
                            (* 2 (be-call-stack-count m))))))
                  MI-JSPROP
                (+ 9
                   (+ (be-mov-words (n-aux (load (field m node))))
                      (be-mov-words (load (field m imm)))))
                  MI-JSARRAY
                (+ 11
                   (+ (be-mov-words (load (field m imm)))
                      (let [value
                              (al-get (load (field (machine-unit) call-args))
                                      (load (field m arg-first)))]
                        (if (< (be-reg-of value) 0) 1 0))))
                  MI-JSSTRING
                (+ 11
                   (+ (if (= (load (field m imm)) JSSOP-FROM-DOUBLE-BITS) 1 0)
                      (+ (be-mov-words (load (field m imm)))
                         (let [value
                                 (al-get (load (field (machine-unit) call-args))
                                         (load (field m arg-first)))]
                           (if (< (be-reg-of value) 0) 1 0)))))
                  MI-STACKARG
                1 MI-STORE
                (case (be-store-barrier-kind m) MLK-RAW-MANAGED
                      18 MLK-BOXED
                      12 1)
                  MI-RET
                (+ (if (= (be-reg-of a)
                          (if (= (be-register-class a) MRC-FPR) 32 0))
                       0
                       1)
                   (if (< (load (field m owner)) 0)
                       2
                       (+ 4 (mu-function-callee-count (load (field m owner))))))
                  1)
        aload (if (and (!= op MI-CALL) (and (>= a 0) (< (be-reg-of a) 0))) 1 0)
        bload (if (and (!= op MI-CALL) (and (>= b 0) (< (be-reg-of b) 0))) 1 0)
        pload (if (and (= op MI-CSEL) (< (be-reg-of (load (field m imm))) 0)) 1 0)
        dstore (if (and (>= dst 0) (< (be-reg-of dst) 0)) 1 0)]
    (+ base (+ aload (+ bload (+ pload dstore))))))

(defn be-label-off [(label i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut off) -1]
    (loop (if (or (>= (load i) n) (>= (load off) 0))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (and (= (load (field m op)) MI-LABEL) (= (load (field m imm)) label))
                      (store! off (load (field m first)))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load off)))

(defn be-encode! [] (-> i64)
  (let [p (backend)
        n (be-inst-count)
        legacy-entry (and (> n 0) (< (load (field (be-inst 0) owner)) 0))
        (mut i) 0]
    (al-clear! [u8] (field p code))
    (do
      (if legacy-entry
          (be-u32! (a64-sub-imm 31 31 2048))
          0)
      ; Legacy single-entry selection has one unmodeled stack prologue before its first machine
      ; instruction. Instruction, branch, relocation, and stack-map offsets are absolute within
      ; the published text, so account for that word in the same offset model used by encoding.
      (let [(mut off) (if legacy-entry 4 0)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (store! (field (be-inst (load i)) first) (load off))
                    (store! off (+ (load off) (* 4 (be-inst-words (be-inst (load i))))))
                    (store! i (+ (load i) 1))
                    0))))
      ; Publish exact function text ranges from entry labels. Ranges are structural metadata,
      ; not inferred later from symbol order in the object writer.
      (let [funcs (mu-function-count)
            (mut owner) 0]
        (loop (if (>= (load owner) funcs)
                  (break)
                  (do
                    (let [f (mu-function (load owner))
                          start (be-label-off (mu-function-block (load owner) 0))
                          lastm (be-inst (- n 1))
                          (mut end) (+ (load (field lastm first)) (* 4 (be-inst-words lastm)))
                          (mut other) 0]
                      (loop (if (>= (load other) funcs)
                                (break)
                                (do
                                  (if (!= (load other) (load owner))
                                      (let [candidate (be-label-off (mu-function-block (load other) 0))]
                                        (if (and (> candidate start) (< candidate (load end)))
                                            (store! end candidate)
                                            0))
                                      0)
                                  (store! other (+ (load other) 1))
                                  0)))
                      (store! (field f code-start) start)
                      (store! (field f code-size) (- (load end) start)))
                    (store! owner (+ (load owner) 1))
                    0)))
        0)
      (store! i 0)
      (loop (if (or (>= (load i) n) (!= (be-result) BER-OK))
                (break)
                (do
                  (let [m0 (be-inst (load i))]
                    (if (!= (be-code-len) (load (field m0 first)))
                        (do
                          (fmt (stderr)
                               "encoding-offset-mismatch inst={d} ideal={d} op={d} expected={d} actual={d} words={d} prev-op={d} prev-ideal={d} prev-words={d} prev-imm={d}\n"
                               (load i) (load (field m0 node)) (load (field m0 op))
                               (load (field m0 first)) (be-code-len) (be-inst-words m0)
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) op)) -1)
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) node)) -1)
                               (if (> (load i) 0) (be-inst-words (be-inst (- (load i) 1))) -1)
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) imm)) -1))
                          ; A size-model disagreement makes every following PC-relative value
                          ; suspect. Fail atomically instead of publishing bytes after a warning.
                          (be-fail! BER-ENCODING (load (field m0 node)))
                          0)
                        0))
                  (if (!= (be-result) BER-OK)
                      0
                      (let [m (be-inst (load i))
                            op (load (field m op))
                            dst (load (field m dst))
                            rd (be-write-reg dst)
                        ; Calls marshal their complete argument vector below. Eagerly reading the
                        ; cached a/b mirrors here would emit duplicate spill reloads and make the
                        ; encoded byte count diverge from be-inst-words.
                        ra
                          (if (= op MI-CALL)
                              -1
                              (be-read-value! (load (field m a))
                                              (if (= op MI-I32FROMFP) 16 15)))
                        rb
                          (if (= op MI-CALL)
                              -1
                              (be-read-value! (load (field m b)) 16))]
                    (case op MI-MOVI
                          (be-mov-imm! rd (load (field m imm))) MI-FMOVI
                          (do
                            (be-mov-imm! 15 (load (field m imm)))
                            (be-u32! (a64-fmov-d-x (- rd 32) 15))
                            0)
                            MI-SCVTF
                          (be-u32! (a64-scvtf-d-x (- rd 32) ra)) MI-I32FROMFP
                          (do
                            (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                            (be-mov-imm! 17 4751297606875873280)
                            (be-u32! (a64-fmov-d-x 30 17))
                            (be-u32! (a64-fdiv-d 31 (- ra 32) 30))
                            (be-u32! (a64-frintz-d 31 31))
                            (be-u32! (a64-fmul-d 31 31 30))
                            (be-u32! (a64-fmov-d-x 30 15))
                            (be-u32! (a64-fsub-d 31 30 31))
                            (be-u32! (a64-fcvtzs-x-d rd 31))
                            0)
                            MI-FADD
                          (be-u32! (a64-fadd-d (- rd 32) (- ra 32) (- rb 32))) MI-FSUB
                          (be-u32! (a64-fsub-d (- rd 32) (- ra 32) (- rb 32))) MI-FMUL
                          (be-u32! (a64-fmul-d (- rd 32) (- ra 32) (- rb 32))) MI-FDIV
                          (be-u32! (a64-fdiv-d (- rd 32) (- ra 32) (- rb 32))) MI-FMOD
                          (let [nw (be-mov-words JSV-NAN)]
                            (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                            (be-u32! (a64-fmov-x-d 16 (- rb 32)))
                            (be-u32! (a64-fmov-d-x 30 15))
                            (be-u32! (a64-fmov-d-x 31 16))
                            (be-u32! (a64-fdiv-d 31 30 31))
                            (be-u32! (a64-frintz-d 31 31))
                            (be-u32! (a64-fcmp-zero-d 31))
                            (be-u32! (a64-bcond 0 (+ 13 nw)))
                            (be-u32! (a64-fmov-d-x 30 16))
                            (be-u32! (a64-fmul-d 31 31 30))
                            (be-u32! (a64-fmov-d-x 30 15))
                            (be-u32! (a64-fsub-d 31 30 31))
                            (be-u32! (a64-fcmp-zero-d 31))
                            (be-mov-imm! 17 -9223372036854775808)
                            (be-u32! (a64-and-reg 17 15 17))
                            (be-u32! (a64-fmov-d-x 30 17))
                            (be-u32! (a64-fcsel-d 31 31 30 1))
                            (be-mov-imm! 17 JSV-NAN)
                            (be-u32! (a64-fmov-d-x 30 17))
                            (be-u32! (a64-fcsel-d (- rd 32) 31 30 7))
                            (be-u32! (a64-b 2))
                            (be-u32! (a64-fmov-d-x (- rd 32) 15))
                            0)
                            MI-FNEG
                          (be-u32! (a64-fneg-d (- rd 32) (- ra 32))) MI-FEQ
                          (do
                            (be-u32! (a64-fcmp-d (- ra 32) (- rb 32)))
                            (be-u32! (a64-cset rd 0))
                            0)
                            MI-FLT
                          (do
                            (be-u32! (a64-fcmp-d (- ra 32) (- rb 32)))
                            (be-u32! (a64-cset rd 4))
                            0)
                            MI-FLE
                          (do
                            (be-u32! (a64-fcmp-d (- ra 32) (- rb 32)))
                            (be-u32! (a64-cset rd 9))
                            0)
                            MI-FTRUTH
                          (do
                            (be-u32! (a64-fcmp-zero-d (- ra 32)))
                            (be-u32! (a64-cset rd 1))
                            (be-u32! (a64-cset 16 7))
                            (be-u32! (a64-and-reg rd rd 16))
                            0)
                            MI-MOD
                          (do
                            (be-u32! (a64-sxtw 15 ra))
                            (be-u32! (a64-sxtw 16 rb))
                            (be-u32! (a64-sdiv 17 15 16))
                            (be-u32! (a64-msub rd 17 16 15))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-BITAND
                          (do
                            (be-u32! (a64-and-reg rd ra rb))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-BITOR
                          (do
                            (be-u32! (a64-orr-reg rd ra rb))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-BITXOR
                          (do
                            (be-u32! (a64-eor-reg rd ra rb))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-BITNOT
                          (do
                            (be-u32! (a64-mvn rd ra))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-SHL
                          (do
                            (be-mov-imm! 17 (if (load (be-falsify-shift-mask-ptr)) 63 31))
                            (be-u32! (a64-and-reg 16 rb 17))
                            (be-u32! (a64-lslv rd ra 16))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-SHR
                          (do
                            (be-u32! (a64-sxtw 15 ra))
                            (be-mov-imm! 17 (if (load (be-falsify-shift-mask-ptr)) 63 31))
                            (be-u32! (a64-and-reg 16 rb 17))
                            (be-u32! (a64-asrv rd 15 16))
                            (be-u32! (a64-sxtw rd rd))
                            0)
                            MI-USHR
                          (do
                            (be-u32! (if (load (be-falsify-unsigned-shift-ptr))
                                         (a64-sxtw 15 ra)
                                         (a64-uxtw 15 ra)))
                            (be-mov-imm! 17 (if (load (be-falsify-shift-mask-ptr)) 63 31))
                            (be-u32! (a64-and-reg 16 rb 17))
                            (be-u32! (if (load (be-falsify-unsigned-shift-ptr))
                                         (a64-asrv rd 15 16)
                                         (a64-lsrv rd 15 16)))
                            (be-u32! (a64-uxtw rd rd))
                            0)
                            MI-JSBOX
                          (let [tag (load (field m imm))]
                            (if (= tag 0)
                                (be-u32! (a64-fmov-x-d rd (- ra 32)))
                                (if (= tag JSV-RAW-NULLABLE-OBJECT)
                                    (do
                                      (be-mov-imm! 16 JSV-PAYLOAD-MASK)
                                      (be-u32! (a64-and-reg rd ra 16))
                                      (be-mov-imm! 17 JSV-OBJECT)
                                      (be-u32! (a64-orr-reg rd rd 17))
                                      (be-mov-imm! 17 JSV-NULL)
                                      (be-u32! (a64-cmp-reg ra 31))
                                      (be-u32! (a64-csel rd 17 rd 0))
                                      0)
                                    (do
                                  (be-mov-imm! 16 JSV-PAYLOAD-MASK)
                                  (be-u32! (a64-and-reg rd ra 16))
                                  (be-mov-imm! 17 tag)
                                  (be-u32! (a64-orr-reg rd rd 17))
                                  0))))
                            MI-JSUNBOX
                          (let [tag (load (field m imm))]
                            (if (= tag 0)
                                (do
                                  ;; ToNumber accepts the immediate-integer arm of the tagged ABI
                                  ;; as well as raw IEEE doubles.
                                  (be-mov-imm! 16 JSV-TAG-MASK)
                                  (be-u32! (a64-and-reg 16 ra 16))
                                  (be-mov-imm! 17 JSV-INTEGER)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 1 4))
                                  (be-u32! (a64-sxt48 15 ra))
                                  (be-u32! (a64-scvtf-d-x (- rd 32) 15))
                                  (be-u32! (a64-b 20))
                                  (be-u32! (a64-lsr48 16 ra))
                                  (be-mov-imm! 17 32760)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 3 10))
                                  (be-u32! (a64-bcond 1 6))
                                  (be-mov-imm! 17 JSV-NAN)
                                  (be-u32! (a64-cmp-reg ra 17))
                                  (be-u32! (a64-bcond 0 9))
                                  (be-u32! (a64-b 7))
                                  (be-mov-imm! 17 32767)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 9 4))
                                  (be-mov-imm! 17 65528)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 3 2))
                                  (be-u32! (a64-brk))
                                  (be-u32! (a64-add-reg 15 ra 31))
                                  (be-u32! (a64-fmov-d-x (- rd 32) 15))
                                  0)
                                (do
                                  (be-mov-imm! 16 JSV-TAG-MASK)
                                  (be-u32! (a64-and-reg 16 ra 16))
                                  (be-mov-imm! 17 tag)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 0 2))
                                  (be-u32! (a64-brk))
                                  (be-mov-imm! 16 JSV-PAYLOAD-MASK)
                                  (be-u32! (if (= tag JSV-INTEGER)
                                               (a64-sxt48 rd ra)
                                               (a64-and-reg rd ra 16)))
                                  (if (or (= tag JSV-UNDEFINED) (= tag JSV-NULL))
                                      (do
                                        (be-u32! (a64-cmp-reg rd 31))
                                        (be-u32! (a64-bcond 0 2))
                                        (be-u32! (a64-brk))
                                        0)
                                      (if (= tag JSV-BOOLEAN)
                                          (do
                                            (be-mov-imm! 16 1)
                                            (be-u32! (a64-cmp-reg rd 16))
                                            (be-u32! (a64-bcond 9 2))
                                            (be-u32! (a64-brk))
                                            0)
                                          (if (be-js-managed-tag? tag)
                                              (do
                                                (be-u32! (a64-cbz rd 5))
                                                (be-mov-imm! 16 7)
                                                (be-u32! (a64-and-reg 16 rd 16))
                                                (be-u32! (a64-cbnz 16 2))
                                                (be-u32! (a64-b 2))
                                                (be-u32! (a64-brk))
                                                0)
                                              0)))
                                  0)))
                            MI-JSTEST
                          (let [tag (load (field m imm))]
                            (if (= tag 0)
                                (do
                                  (be-u32! (a64-lsr48 16 ra))
                                  (be-u32! (a64-add-reg 15 ra 31))
                                  (be-mov-imm! rd 1)
                                  (be-mov-imm! 17 32760)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 3 10))
                                  (be-u32! (a64-bcond 1 6))
                                  (be-mov-imm! 17 JSV-NAN)
                                  (be-u32! (a64-cmp-reg 15 17))
                                  (be-u32! (a64-bcond 0 9))
                                  (be-u32! (a64-b 7))
                                  (be-mov-imm! 17 32767)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 9 4))
                                  (be-mov-imm! 17 65528)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-bcond 3 2))
                                  (be-mov-imm! rd 0)
                                  0)
                                (do
                                  (be-mov-imm! 16 JSV-TAG-MASK)
                                  (be-u32! (a64-and-reg 16 ra 16))
                                  (be-mov-imm! 17 tag)
                                  (be-u32! (a64-cmp-reg 16 17))
                                  (be-u32! (a64-cset rd 0))
                                  0)))
                            MI-ADD
                          (be-u32! (a64-add-reg rd ra rb)) MI-SUB
                          (be-u32! (a64-sub-reg rd ra rb)) MI-MUL
                          (be-u32! (a64-mul rd ra rb)) MI-SDIV
                          (be-u32! (a64-sdiv rd ra rb)) MI-ARG
                          0 MI-STACKARG
                          (let [frame (mu-function-frame-size (load (field m owner)))]
                            (if (= (be-register-class dst) MRC-FPR)
                                (be-u32! (a64-ldr-d (- rd 32)
                                                    31
                                                    (+ frame (* (load (field m imm)) 8))))
                                (be-u32! (a64-ldr rd
                                                  31
                                                  (+ frame (* (load (field m imm)) 8))))))
                            MI-EQ
                          (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 0)) 0) MI-LT
                          (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 11)) 0) MI-LE
                          (do (be-u32! (a64-cmp-reg ra rb)) (be-u32! (a64-cset rd 13)) 0) MI-LABEL
                          (let [owner (be-entry-label-owner (load (field m imm)))]
                            (if (< owner 0)
                                0
                                (let [frame (mu-function-frame-size owner)]
                                  (be-u32! (a64-sub-imm 31 31 frame))
                                  (be-u32! (a64-str 29 31 0))
                                  (be-u32! (a64-str 30 31 8))
                                  (let [mask (mu-function-callee-mask owner)
                                        (mut reg) 19]
                                    (loop (if (> (load reg) 28)
                                              (break)
                                              (do
                                                (if (!= (& mask (<< 1 (load reg))) 0)
                                                    (be-u32! (a64-str (load reg)
                                                                      31
                                                                      (be-callee-save-off owner (load reg))))
                                                    0)
                                                (store! reg (+ (load reg) 1))
                                                0))))
                                  (let [mask (mu-function-callee-mask owner)
                                        (mut reg) 40]
                                    (loop (if (> (load reg) 47)
                                              (break)
                                              (do
                                                (if (!= (& mask (<< 1 (load reg))) 0)
                                                    (be-u32! (a64-str-d (- (load reg) 32)
                                                                        31
                                                                        (be-callee-save-off owner (load reg))))
                                                    0)
                                                (store! reg (+ (load reg) 1))
                                                0))))
                                  (be-u32! (a64-add-imm 29 31 0))
                                  0)))
                            MI-CBZ
                          (let [target (be-label-off (load (field m imm)))
                                ; A spilled predicate is reloaded before the branch. PC-relative
                                ; displacements are based on the CBZ itself, not the beginning of
                                ; this expanded machine instruction.
                                here
                                  (+ (load (field m first))
                                     (if (< (be-reg-of (load (field m a))) 0) 4 0))]
                            (if (< target 0)
                                -1
                                (be-u32! (a64-cbz ra (/ (- target here) 4)))))
                            MI-CSEL
                          (do
                            (be-u32! (a64-cmp-reg (be-read-reg! (load (field m imm)) 17) 31))
                            (be-u32! (a64-csel rd ra rb 1))
                            0)
                            MI-MOV
                          (let [to (be-reg-of (load (field m imm)))]
                            (if (< to 0)
                                (if (= (be-register-class (load (field m imm))) MRC-FPR)
                                    (be-u32! (a64-str-d (- ra 32)
                                                        31
                                                        (be-spill-off-vreg (load (field m imm)))))
                                    (be-u32! (a64-str ra
                                                      31
                                                      (be-spill-off-vreg (load (field m imm))))))
                                (if (= (be-register-class (load (field m imm))) MRC-FPR)
                                    (be-u32! (a64-fmov-d (- to 32) (- ra 32)))
                                    (be-u32! (a64-add-reg to ra 31)))))
                            MI-COPY
                          (if (= (be-register-class dst) MRC-FPR)
                              (be-u32! (a64-fmov-d (- rd 32) (- ra 32)))
                              (be-u32! (a64-add-reg rd ra 31)))
                            MI-ABI-COPY
                          (if (= (be-register-class dst) MRC-FPR)
                              (be-u32! (a64-fmov-d (- rd 32) (- ra 32)))
                              (be-u32! (a64-add-reg rd ra 31)))
                            MI-CALL
                          (let [polymorphic (be-poly-call? m)
                                target-label
                                  (if polymorphic -1 (mu-function-block (load (field m imm)) 0))
                                target (if polymorphic -1 (be-label-off target-label))
                                here (load (field m first))
                                argc (load (field m arg-count))
                                first (load (field m arg-first))
                                callee-reg
                                  (if polymorphic
                                      (be-read-value! (load (field m a)) 15)
                                      -1)
                                area (be-call-area (+ argc (if polymorphic 1 0)))
                                (mut j) 0]
                            (be-u32! (a64-sub-imm 31 31 area))
                            (if polymorphic (be-u32! (a64-str callee-reg 31 (* argc 8))) 0)
                            (store! j 0)
                            (loop (if (>= (load j) argc)
                                      (break)
                                      (do
                                        (let [vr
                                                (al-get (load (field (machine-unit) call-args))
                                                        (+ first (load j)))
                                              r (be-read-value-delta! vr 15 area)]
                                          (if (= (be-register-class vr) MRC-FPR)
                                              (be-u32! (a64-str-d (- r 32) 31 (* (load j) 8)))
                                              (be-u32! (a64-str r 31 (* (load j) 8)))))
                                        (store! j (+ (load j) 1))
                                        0)))
                            (store! j 0)
                            (loop (if (>= (load j) argc)
                                      (break)
                                      (do
                                        (let [vr
                                                (al-get (load (field (machine-unit) call-args))
                                                        (+ first (load j)))
                                              abi-index (be-call-arg-class-index m (load j))]
                                          (if (< abi-index 8)
                                              (if (= (be-register-class vr) MRC-FPR)
                                                  (be-u32! (a64-ldr-d abi-index 31 (* (load j) 8)))
                                                  (be-u32! (a64-ldr abi-index 31 (* (load j) 8))))
                                              0))
                                        (store! j (+ (load j) 1))
                                        0)))
                            ; Register arguments have been captured, so compact only overflow
                            ; arguments into the ABI's contiguous stack area at sp+0.
                            (store! j 0)
                            (loop (if (>= (load j) argc)
                                      (break)
                                      (do
                                        (let [vr
                                                (al-get (load (field (machine-unit) call-args))
                                                        (+ first (load j)))
                                              abi-index (be-call-arg-class-index m (load j))]
                                          (if (>= abi-index 8)
                                              (let [slot (be-call-stack-index m (load j))]
                                                (if (= (be-register-class vr) MRC-FPR)
                                                    (do
                                                      (be-u32! (a64-ldr-d 30 31 (* (load j) 8)))
                                                      (be-u32! (a64-str-d 30 31 (* slot 8)))
                                                      0)
                                                    (do
                                                      (be-u32! (a64-ldr 15 31 (* (load j) 8)))
                                                      (be-u32! (a64-str 15 31 (* slot 8)))
                                                      0)))
                                              0))
                                        (store! j (+ (load j) 1))
                                        0)))
                            ; The BL follows the argument area setup and exact argument moves.
                            ; Values live across calls cannot occupy caller-saved registers: G6/G7
                            ; enforce the clobber mask, so no provisional save envelope is needed.
                            (if polymorphic
                                (let [targets (be-poly-call-targets m)
                                      (mut fidx) 0]
                                  (be-u32! (a64-ldr 16 31 (* argc 8)))
                                  (be-mov-imm! 17 JSV-TAG-MASK)
                                  (be-u32! (a64-and-reg 17 16 17))
                                  (be-mov-imm! 15 JSV-FUNCTION)
                                  (be-u32! (a64-cmp-reg 17 15))
                                  (be-u32! (a64-bcond 0 2))
                                  (be-u32! (a64-brk))
                                  (be-mov-imm! 17 JSV-PAYLOAD-MASK)
                                  (be-u32! (a64-and-reg 16 16 17))
                                  (be-u32! (a64-add-reg 13 31 31))
                                  (loop (if (>= (load fidx) 63)
                                            (break)
                                            (do
                                              (if (!= (& targets (<< 1 (load fidx))) 0)
                                                  (let [target-owner (mu-find-function-symbol (load fidx))
                                                        target-block
                                                          (if (< target-owner 0)
                                                              -1
                                                              (mu-function-block target-owner 0))
                                                        target-off
                                                          (if (< target-block 0)
                                                              -1
                                                              (be-label-off target-block))]
                                                    (be-mov-imm! 15 (load fidx))
                                                    (be-u32! (a64-cmp-reg 16 15))
                                                    (if (< target-off 0)
                                                        (be-u32! (a64-brk))
                                                        (be-u32! (a64-adr 17 (- target-off (be-code-len)))))
                                                    (be-u32! (a64-csel 13 17 13 0)))
                                                  0)
                                              (store! fidx (+ (load fidx) 1)))))
                                  (be-u32! (a64-cbnz 13 2))
                                  (be-u32! (a64-brk))
                                  (be-u32! (a64-blr 13)))
                                (let [spill-loads (be-call-spill-loads m)
                                      register-loads (be-call-register-loads m)
                                      stack-moves (* 2 (be-call-stack-count m))
                                      bl-off
                                        (+ here
                                           (* 4
                                              (+ 1
                                                 (+ argc
                                                    (+ spill-loads (+ register-loads stack-moves))))))]
                                  (if (< target 0)
                                      -1
                                      (be-u32! (a64-bl (/ (- target bl-off) 4))))))
                            (if (= (be-register-class dst) MRC-FPR)
                                (be-u32! (a64-fmov-d 30 0))
                                (be-u32! (a64-add-reg 14 0 31)))
                            (be-u32! (a64-add-imm 31 31 area))
                            (if (= (be-register-class dst) MRC-FPR)
                                (be-u32! (a64-fmov-d (- rd 32) 30))
                                (be-u32! (a64-add-reg rd 14 31)))
                            0)
                            MI-JSPROP
                          (do
                            ; Preserve both inputs before assigning the external C ABI registers:
                            ; x0=owner, x1=name-id, x2=boxed-value/raw-prototype, x3=operation.
                            (be-u32! (a64-sub-imm 31 31 16))
                            (be-u32! (a64-str ra 31 0))
                            (be-u32! (a64-str rb 31 8))
                            (be-u32! (a64-ldr 0 31 0))
                            (be-mov-imm! 1 (n-aux (load (field m node))))
                            (be-u32! (a64-ldr 2 31 8))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-imm 31 31 16))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-JSARRAY
                          (let [value (ms-inst-arg (load i) 0)
                                rv (be-read-value! value 17)]
                            ; x0=owner, x1=dynamic integer index, x2=boxed value,
                            ; x3=operation. Preserve every source before assigning ABI registers.
                            (be-u32! (a64-sub-imm 31 31 32))
                            (be-u32! (a64-str ra 31 0))
                            (be-u32! (a64-str rb 31 8))
                            (be-u32! (a64-str rv 31 16))
                            (be-u32! (a64-ldr 0 31 0))
                            (be-u32! (a64-ldr 1 31 8))
                            (be-u32! (a64-ldr 2 31 16))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-imm 31 31 32))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-JSSTRING
                          (let [value (ms-inst-arg (load i) 0)
                                rv (be-read-value! value 17)]
                            ; x0=a, x1=b, x2=third value, x3=operation.
                            (be-u32! (a64-sub-imm 31 31 32))
                            (if (= (load (field m imm)) JSSOP-FROM-DOUBLE-BITS)
                                (do
                                  (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                                  (be-u32! (a64-str 15 31 0))
                                  0)
                                (be-u32! (a64-str ra 31 0)))
                            (be-u32! (a64-str rb 31 8))
                            (be-u32! (a64-str rv 31 16))
                            (be-u32! (a64-ldr 0 31 0))
                            (be-u32! (a64-ldr 1 31 8))
                            (be-u32! (a64-ldr 2 31 16))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-imm 31 31 32))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-B
                          (let [target (be-label-off (load (field m imm)))
                                here (load (field m first))]
                            (if (< target 0)
                                -1
                                (be-u32! (a64-b (/ (- target here) 4)))))
                          ; Allocation is an external runtime safepoint. The object writer relocates
                          ; the slow-path zero BL to `_aot_alloc_slow`. x28 points at
                          ; {cursor,limit,stress}; the ordinary path bumps and writes
                          ; the header without entering C. x0=size, x1=shape, x0=result
                          ; on the slow path.
                          MI-NEW
                            (if (be-runtime-allocation?)
                                (let [size (shape-size (load (field m imm)))
                                      shape (load (field m imm))
                                      sw (be-mov-words size)
                                      shw (be-mov-words shape)
                                      cw (+ 6 sw)]
                                  (be-u32! (a64-ldr 9 28 0))
                                  (be-u32! (a64-ldr 10 28 8))
                                  (be-mov-imm! 11 size)
                                  (be-u32! (a64-add-reg 11 9 11))
                                  (be-u32! (a64-cmp-reg 11 10))
                                  (be-u32! (a64-bcond 8 (+ 7 (+ shw cw))))
                                  (be-u32! (a64-ldr 10 28 16))
                                  (be-u32! (a64-cbnz 10 (+ 5 (+ shw cw))))
                                  (be-u32! (a64-str 11 28 0))
                                  (be-u32! (a64-add-reg 0 9 31))
                                  (be-mov-imm! 10 shape)
                                  (be-u32! (a64-str 10 0 0))
                                  ; Exact allocation metrics live in the thread state so the
                                  ; generated fast path and C slow path share one counter domain.
                                  (be-u32! (a64-ldr 15 28 72))
                                  (be-u32! (a64-add-imm 15 15 1))
                                  (be-u32! (a64-str 15 28 72))
                                  (be-u32! (a64-ldr 15 28 80))
                                  (be-mov-imm! 16 size)
                                  (be-u32! (a64-add-reg 15 15 16))
                                  (be-u32! (a64-str 15 28 80))
                                  (be-u32! (a64-b (+ 2 (+ sw shw))))
                                  (be-mov-imm! 0 size)
                                  (be-mov-imm! 1 shape)
                                  (be-u32! (a64-bl 0))
                                  (be-u32! (a64-add-reg rd 0 31))
                                  0)
                                (be-u32! (a64-add-imm rd
                                                      3
                                                      (* (graph-new-index (load (field m node))) 128))))
                          MI-LOAD (be-u32! (a64-ldr rd ra (load (field m imm))))
                          MI-STORE
                            (do
                              (be-u32! (a64-str rb ra (load (field m imm))))
                              (if (= (be-store-barrier-kind m) MLK-BOXED)
                                  (do
                                    ; A dynamic store dirties an old receiver conservatively. The
                                    ; collector subsequently decodes only exact managed tags, so
                                    ; scalar boxed values cannot become roots.
                                    (be-u32! (a64-ldr 15 28 24))
                                    (be-u32! (a64-cmp-reg ra 15))
                                    (be-u32! (a64-bcond 3 9))
                                    (be-u32! (a64-ldr 16 28 32))
                                    (be-u32! (a64-cmp-reg ra 16))
                                    (be-u32! (a64-bcond 2 6))
                                    (be-u32! (a64-movz 15 1 0))
                                    (be-u32! (a64-str 15 28 56))
                                    (be-u32! (a64-ldr 16 28 64))
                                    (be-u32! (a64-add-imm 16 16 1))
                                    (be-u32! (a64-str 16 28 64))
                                    0)
                                  (if (be-store-barrier? m)
                                      (do
                                        ; Inline remembered-set barrier. x15/x16 are
                                        ; reserved scratch registers; the four range
                                        ; checks recognize old-object -> young-value.
                                        (be-u32! (a64-ldr 15 28 24))
                                        (be-u32! (a64-cmp-reg ra 15))
                                        (be-u32! (a64-bcond 3 15))
                                        (be-u32! (a64-ldr 16 28 32))
                                        (be-u32! (a64-cmp-reg ra 16))
                                        (be-u32! (a64-bcond 2 12))
                                        (be-u32! (a64-ldr 15 28 40))
                                        (be-u32! (a64-cmp-reg rb 15))
                                        (be-u32! (a64-bcond 3 9))
                                        (be-u32! (a64-ldr 16 28 48))
                                        (be-u32! (a64-cmp-reg rb 16))
                                        (be-u32! (a64-bcond 2 6))
                                        (be-u32! (a64-movz 15 1 0))
                                        (be-u32! (a64-str 15 28 56))
                                        (be-u32! (a64-ldr 16 28 64))
                                        (be-u32! (a64-add-imm 16 16 1))
                                        (be-u32! (a64-str 16 28 64))
                                        0)
                                      0))
                              0)
                          MI-NEG (be-u32! (a64-sub-reg rd 31 ra))
                          MI-RET
                            (do
                              (if (= (be-register-class (load (field m a))) MRC-FPR)
                                  (if (= ra 32)
                                      0
                                      (be-u32! (a64-fmov-d 0 (- ra 32))))
                                  (if (= ra 0) 0 (be-u32! (a64-add-reg 0 ra 31))))
                              (if (< (load (field m owner)) 0)
                                  (be-u32! (a64-add-imm 31 31 2048))
                                  (let [frame (mu-function-frame-size (load (field m owner)))]
                                    (let [owner (load (field m owner))
                                          mask (mu-function-callee-mask (load (field m owner)))
                                          (mut reg) 19]
                                      (loop (if (> (load reg) 28)
                                                (break)
                                                (do
                                                  (if (!= (& mask (<< 1 (load reg))) 0)
                                                      (be-u32! (a64-ldr (load reg)
                                                                        31
                                                                        (be-callee-save-off owner (load reg))))
                                                      0)
                                                  (store! reg (+ (load reg) 1))
                                                  0))))
                                    (let [owner (load (field m owner))
                                          mask (mu-function-callee-mask (load (field m owner)))
                                          (mut reg) 40]
                                      (loop (if (> (load reg) 47)
                                                (break)
                                                (do
                                                  (if (!= (& mask (<< 1 (load reg))) 0)
                                                      (be-u32! (a64-ldr-d (- (load reg) 32)
                                                                          31
                                                                          (be-callee-save-off owner (load reg))))
                                                      0)
                                                  (store! reg (+ (load reg) 1))
                                                  0))))
                                    (be-u32! (a64-ldr 29 31 0))
                                    (be-u32! (a64-ldr 30 31 8))
                                    (be-u32! (a64-add-imm 31 31 frame))
                                    0))
                              (be-u32! (a64-ret))
                              0)
                          0)
                        (if (>= dst 0) (be-store-written! dst rd) 0)
                        (store! i (+ (load i) 1))
                        0)))))
      (be-code-len))))

(defn be-encode-checked! [] (-> bool)
  (if (!= (be-result) BER-OK)
      false
      (let [n (be-inst-count)
            (mut i) 0
            (mut bad) NO-NODE]
        (loop (if (or (>= (load i) n) (!= (load bad) NO-NODE))
                  (break)
                  (do
                    (let [m (be-inst (load i))
                          op (load (field m op))]
                      (if (not (mi-desc-encodable? (mi-desc op)))
                          (store! bad (load (field m node)))
                          0))
                    (store! i (+ (load i) 1))
                    0)))
        (if (!= (load bad) NO-NODE)
            (be-fail! BER-ENCODING (load bad))
            (do
              (be-encode!)
              (if (> (be-code-len) 0) true (be-fail! BER-ENCODING NO-NODE)))))))

(defn be-code-len [] (-> i64)
  (if (= (be-result) BER-OK) (al-len [u8] (load (field (backend) code))) 0))
(defn be-code-byte [(i i64)] (-> i64)
  (cast i64 (al-get (load (field (backend) code)) i)))
(defn be-code-u32 [(at i64)] (-> i64)
  (| (be-code-byte at)
     (| (<< (be-code-byte (+ at 1)) 8)
        (| (<< (be-code-byte (+ at 2)) 16)
           (<< (be-code-byte (+ at 3)) 24)))))

(defn be-code-set-u32! [(at i64) (word i64)] (-> i64)
  (let [code (field (backend) code)]
    (al-set! [u8] code at (cast u8 (& word 255)))
    (al-set! [u8] code (+ at 1) (cast u8 (& (>> word 8) 255)))
    (al-set! [u8] code (+ at 2) (cast u8 (& (>> word 16) 255)))
    (al-set! [u8] code (+ at 3) (cast u8 (& (>> word 24) 255)))
    0))

;; Focused B05 mutation hooks operate on already encoded bytes. They are deliberately exact: each
;; returns 1 only when it found and replaced the intended instruction, so a stale falsification
;; cannot quietly pass after lowering changes.
(defn be-falsify-first-fp-reload! [] (-> i64)
  (let [(mut at) 0
        (mut changed) 0]
    (loop (if (or (> (+ (load at) 4) (be-code-len)) (!= (load changed) 0))
              (break)
              (do
                (let [word (be-code-u32 (load at))]
                  ; LDR Dt,[SP,#imm] with the unsigned scaled immediate ignored.
                  (if (= (& word 4290772992) 4248829952)
                      (do
                        ; Corrupt the value the reload defines. Writing an unrelated register
                        ; merely deleted the load, which can be observationally neutral when the
                        ; destination still contains the value stored immediately beforehand.
                        (be-code-set-u32! (load at) (a64-fmov-d (& word 31) 0))
                        (store! changed 1))
                      0))
                (store! at (+ (load at) 4))
                0)))
    (load changed)))

(defn be-falsify-fp-lt-unordered! [] (-> i64)
  (let [(mut at) 0
        (mut rd) 0
        (mut changed) 0]
    (loop (if (or (> (+ (load at) 4) (be-code-len)) (!= (load changed) 0))
              (break)
              (do
                (store! rd 0)
                (loop (if (or (>= (load rd) 32) (!= (load changed) 0))
                          (break)
                          (do
                            (if (= (be-code-u32 (load at)) (a64-cset (load rd) 4))
                                (do
                                  (be-code-set-u32! (load at) (a64-cset (load rd) 11))
                                  (store! changed 1))
                                0)
                            (store! rd (+ (load rd) 1))
                            0)))
                (store! at (+ (load at) 4))
                0)))
    (load changed)))

; Minimal arm64 MH_OBJECT writer: one __TEXT,__text section and one external `_kernel` symbol.
(defn obj-u8! [(v i64)] (-> i64)
  (al-push! [u8] (field (backend) obj) (cast u8 (& v 255)))
  0)
(defn obj-u32! [(v i64)] (-> i64)
  (obj-u8! v)
  (obj-u8! (>> v 8))
  (obj-u8! (>> v 16))
  (obj-u8! (>> v 24))
  0)
(defn obj-u64! [(v i64)] (-> i64)
  (obj-u32! v)
  (obj-u32! (>> v 32))
  0)
(defn obj-name16! [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) 16)
              (break)
              (do
                (obj-u8! (if (< (load i) n) (cast i64 (slice-get s (load i))) 0))
                (store! i (+ (load i) 1))
                0)))
    0))
(defn obj-pad-to! [(at i64)] (-> i64)
  (loop (if (>= (al-len [u8] (load (field (backend) obj))) at)
            (break)
            (obj-u8! 0)))
  0)
(defn align8 [(n i64)] (-> i64)
  (& (+ n 7) -8))

(defn obj-ascii! [(s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (do
                (obj-u8! (cast i64 (slice-get s (load i))))
                (store! i (+ (load i) 1))
                0)))
    0))

(defn obj-hex-digit [(v i64)] (-> i64)
  (if (< v 10) (+ 48 v) (+ 87 v)))

; Fixed-width names make string-table offsets independent of function count and layout order.
(defn obj-local-name! [(owner i64)] (-> i64)
  (obj-ascii! "_aot_")
  (let [(mut shift) 60]
    (loop (if (< (load shift) 0)
              (break)
              (do
                (obj-u8! (obj-hex-digit (& (>> owner (load shift)) 15)))
                (store! shift (- (load shift) 4))
                0)))
    0))

(defn mobj-safepoint-count [] (-> i64)
  (let [(mut at) 0
        (mut count) 0]
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at)) (store! count (+ (load count) 1)) 0)
                (store! at (+ (load at) 1))
                0)))
    (load count)))

(defn mobj-external-reloc-count [] (-> i64)
  (let [(mut at) 0
        (mut count) 0]
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (or (= (ms-inst-op (load at)) MI-JSPROP)
                        (or (= (ms-inst-op (load at)) MI-JSARRAY)
                            (or (= (ms-inst-op (load at)) MI-JSSTRING)
                                (and (be-runtime-allocation?) (= (ms-inst-op (load at)) MI-NEW)))))
                    (store! count (+ (load count) 1))
                    0)
                (store! at (+ (load at) 1))
                0)))
    (load count)))

(defn mobj-has-external-op? [(wanted i64)] (-> bool)
  (let [(mut at) 0
        (mut found) false]
    (loop (if (or (>= (load at) (be-inst-count)) (load found))
              (break)
              (do
                (if (and (= (ms-inst-op (load at)) wanted)
                         (or (!= wanted MI-NEW) (be-runtime-allocation?)))
                    (store! found true)
                    0)
                (store! at (+ (load at) 1))
                0)))
    (load found)))

(defn mobj-external-symbol-count [] (-> i64)
  (+ (if (mobj-has-external-op? MI-NEW) 1 0)
     (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
        (+ (if (mobj-has-external-op? MI-JSARRAY) 1 0)
           (if (mobj-has-external-op? MI-JSSTRING) 1 0)))))

(defn mobj-external-symbol [(basesyms i64) (op i64)] (-> i64)
  (if (= op MI-NEW)
      basesyms
      (if (= op MI-JSPROP)
          (+ basesyms (if (mobj-has-external-op? MI-NEW) 1 0))
          (if (= op MI-JSARRAY)
              (+ basesyms
                 (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                    (if (mobj-has-external-op? MI-JSPROP) 1 0)))
              (+ basesyms
                 (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                    (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
                       (if (mobj-has-external-op? MI-JSARRAY) 1 0))))))))

(defn mobj-new-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        shape (load (field m imm))]
    (+ (load (field m first))
       (let [sw (be-mov-words (shape-size shape))]
         (* 4
            (+ (+ 17 sw)
               (* 2 (+ sw (be-mov-words shape)))))))))

(defn mobj-jsprop-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        spill-loads
          (+ (if (< (be-reg-of (load (field m a))) 0) 1 0)
             (if (< (be-reg-of (load (field m b))) 0) 1 0))]
    (+ (load (field m first))
       (* 4
          (+ spill-loads
             (+ 5
                (+ (be-mov-words (n-aux (load (field m node))))
                   (be-mov-words (load (field m imm))))))))))

(defn mobj-jsarray-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        value (ms-inst-arg at 0)
        spill-loads
          (+ (if (< (be-reg-of (load (field m a))) 0) 1 0)
             (+ (if (< (be-reg-of (load (field m b))) 0) 1 0)
                (if (< (be-reg-of value) 0) 1 0)))]
    (+ (load (field m first))
       (* 4 (+ spill-loads (+ 7 (be-mov-words (load (field m imm)))))))))

(defn mobj-jsstring-branch-pc [(at i64)] (-> i64)
  (+ (mobj-jsarray-branch-pc at)
     (if (= (load (field (be-inst at) imm)) JSSOP-FROM-DOUBLE-BITS) 4 0)))

(defn mobj-safepoint-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (load (field m op))]
    (case op MI-NEW
          (if (be-runtime-allocation?)
              (+ (mobj-new-branch-pc at) 4)
              (load (field m first)))
            MI-CALL
          (let [argc (load (field m arg-count))
                here (load (field m first))
                common
                  (+ argc
                     (+ (be-call-spill-loads m)
                        (+ (be-call-register-loads m)
                           (* 2 (be-call-stack-count m)))))
                setup
                  (if (be-poly-call? m)
                      (+ 12
                         (+ common
                            (+ (if (< (be-reg-of (load (field m a))) 0) 1 0)
                               (+ (be-mov-words JSV-TAG-MASK)
                                  (+ (be-mov-words JSV-FUNCTION)
                                     (+ (be-mov-words JSV-PAYLOAD-MASK)
                                        (be-poly-call-dispatch-words m)))))))
                      (+ 2 common))]
            ;; setup includes the call instruction itself; stack maps name its return PC.
            (+ here (* 4 setup)))
            -1)))

(defn mobj-branch-reloc-info [(symbol i64)] (-> i64)
  (| symbol (| (<< 1 24) (| (<< 2 25) (| (<< 1 27) (<< 2 28))))))

(defn mobj-root? [(at i64) (vr i64)] (-> bool)
  (and (if (= (ms-inst-op at) MI-CALL)
           (and (!= (ms-inst-dst at) vr) (ml-live-after? at vr))
           (ml-live-before? at vr))
       (!= (ml-value-kind vr) MLK-SCALAR)))

(defn mobj-root-count [] (-> i64)
  (let [(mut at) 0
        (mut roots) 0]
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at))
                    (let [(mut vr) 0]
                      (loop (if (>= (load vr) (ml-vreg-count))
                                (break)
                                (do
                                  (if (mobj-root? (load at) (load vr))
                                      (store! roots (+ (load roots) 1))
                                      0)
                                  (store! vr (+ (load vr) 1))
                                  0))))
                    0)
                (store! at (+ (load at) 1))
                0)))
    (load roots)))

(defn mobj-stackmap-size [] (-> i64)
  (+ 24
     (+ (* (mu-function-count) 32)
        (+ (* (mobj-safepoint-count) 24) (* (mobj-root-count) 16)))))
(defn mobj-layout-size [] (-> i64)
  (+ 16 (* (shape-count) 32)))

(defn mobj-write-stackmaps! [] (-> i64)
  (let [sites (mobj-safepoint-count)
        roots (mobj-root-count)
        (mut at) 0
        (mut root-first) 0]
    (obj-u32! 1398034241)
    (obj-u32! 2)
    (obj-u32! sites)
    (obj-u32! roots)
    (obj-u32! (mu-function-count))
    (obj-u32! 32)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (obj-u32! (load owner))
                  (obj-u32! (mu-function-code-start (load owner)))
                  (obj-u32! (mu-function-code-size (load owner)))
                  (obj-u32! (mu-function-frame-size (load owner)))
                  (obj-u64! (mu-function-callee-mask (load owner)))
                  (obj-u32! (mu-function-callee-count (load owner)))
                  (obj-u32! 0)
                  (store! owner (+ (load owner) 1))
                  0))))
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at))
                    (let [m (be-inst (load at))
                          (mut vr) 0
                          (mut count) 0]
                      (loop (if (>= (load vr) (ml-vreg-count))
                                (break)
                                (do
                                  (if (mobj-root? (load at) (load vr))
                                      (store! count (+ (load count) 1))
                                      0)
                                  (store! vr (+ (load vr) 1))
                                  0)))
                      (obj-u32! (mobj-safepoint-pc (load at)))
                      (obj-u32! (load (field m owner)))
                      (obj-u32! (load at))
                      (obj-u32! (load root-first))
                      (obj-u32! (load count))
                      (obj-u32! (load (field m op)))
                      (store! root-first (+ (load root-first) (load count))))
                    0)
                (store! at (+ (load at) 1))
                0)))
    (store! at 0)
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at))
                    (let [(mut vr) 0]
                      (loop (if (>= (load vr) (ml-vreg-count))
                                (break)
                                (do
                                  (if (mobj-root? (load at) (load vr))
                                      (let [reg (mra-reg (load vr))
                                            spill (mra-spill (load vr))]
                                        (obj-u32! (load vr))
                                        (obj-u32! (ml-value-kind (load vr)))
                                        (obj-u32! (if (>= reg 0) 0 1))
                                        (obj-u32! (if (>= reg 0) reg (be-spill-off-vreg (load vr)))))
                                      0)
                                  (store! vr (+ (load vr) 1))
                                  0))))
                    0)
                (store! at (+ (load at) 1))
                0)))
    0))

(defn mobj-shape-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (ty-only-obj? (shape-field-ty shape (load field)))
                    (store! bits (| (load bits) (<< 1 (load field))))
                    0)
                (store! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-shape-boxed-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (= (ml-kind-for-type (shape-field-ty shape (load field))) MLK-BOXED)
                    (store! bits (| (load bits) (<< 1 (load field))))
                    0)
                (store! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-write-layouts! [] (-> i64)
  (obj-u32! 1280593729)
  (obj-u32! 1)
  (obj-u32! (shape-count))
  (obj-u32! 32)
  (let [(mut shape) 0]
    (loop (if (>= (load shape) (shape-count))
              (break)
              (do
                (obj-u32! (load shape))
                (obj-u32! (shape-size (load shape)))
                (obj-u32! 8)
                (obj-u32! (shape-field-count (load shape)))
                (obj-u64! (mobj-shape-bitmap (load shape)))
                (obj-u64! (mobj-shape-boxed-bitmap (load shape)))
                (store! shape (+ (load shape) 1))
                0)))
    0))

(defn mobj-fail! [(code i64) (item i64)] (-> bool)
  (let [p (backend)]
    (store! (field p object-result) code)
    (store! (field p object-item) item)
    false))

; Validate the phase-owned object model before a byte is published. The serialized-byte parser
; below repeats the bounds checks after publication; neither verifier trusts the other.
(defn mobj-verify-model! [] (-> bool)
  (let [p (backend)
        funcs (mu-function-count)
        textlen (be-code-len)
        (mut owner) 0
        (mut ok) true]
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (if (<= textlen 0)
        (do (store! ok false) (mobj-fail! MOBJ-HEADER -1))
        false)
    (loop (if (or (>= (load owner) funcs) (not (load ok)))
              (break)
              (do
                (let [start (mu-function-code-start (load owner))
                      size (mu-function-code-size (load owner))]
                  (if (or (< start 0) (or (<= size 0) (> (+ start size) textlen)))
                      (do
                        (store! ok false)
                        (mobj-fail! MOBJ-FUNCTION-RANGE (load owner)))
                      false))
                (store! owner (+ (load owner) 1))
                0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (not (load ok)))
                    (break)
                    (do
                      (if (= (ms-inst-op (load at)) MI-CALL)
                          (let [target (load (field (be-inst (load at)) imm))]
                            (if (if (< target 0)
                                    (not (ms-call-target-valid? (load at)))
                                    (>= target funcs))
                                (do
                                  (store! ok false)
                                  (mobj-fail! MOBJ-RELOCATION (load at)))
                                false))
                          false)
                      (store! at (+ (load at) 1))
                      0)))
          0)
        0)
    (load ok)))

(defn mobj-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (store! (field (be-inst at) imm) target)
  0)

(defn mobj-corrupt-function-range! [(owner i64) (start i64) (size i64)] (-> i64)
  (store! (field (mu-function owner) code-start) start)
  (store! (field (mu-function owner) code-size) size)
  0)

(defn mobj-byte [(at i64)] (-> i64)
  (cast i64 (al-get (load (field (backend) obj)) at)))
(defn mobj-u32 [(at i64)] (-> i64)
  (| (mobj-byte at)
     (| (<< (mobj-byte (+ at 1)) 8)
        (| (<< (mobj-byte (+ at 2)) 16) (<< (mobj-byte (+ at 3)) 24)))))
(defn mobj-u64 [(at i64)] (-> i64)
  (| (mobj-u32 at) (<< (mobj-u32 (+ at 4)) 32)))

; Repository-local structural parser for the exact object schema emitted below. It validates raw
; bytes and cross-checks them against phase-owned function ranges.
(defn mobj-verify-bytes! [] (-> bool)
  (let [p (backend)
        len (al-len [u8] (load (field p obj)))
        funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1)
        nreloc (mobj-external-reloc-count)
        externs (mobj-external-symbol-count)
        nsyms (+ basesyms externs)
        (mut ok) true]
    (store! (field p object-result) MOBJ-OK)
    (store! (field p object-item) -1)
    (if (< len 472)
        (do (store! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (and (load ok)
             (or (!= (mobj-u32 0) 4277009103)
                 (or (!= (mobj-u32 16) 4) (!= (mobj-u32 20) 440))))
        (do (store! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (load ok)
        (let [textlen (mobj-u64 144)
              textoff (mobj-u32 152)
              relocoff (mobj-u32 160)
              actual-nreloc (mobj-u32 164)
              stackaddr (mobj-u64 216)
              stacklen (mobj-u64 224)
              stackoff (mobj-u32 232)
              layoutaddr (mobj-u64 296)
              layoutlen (mobj-u64 304)
              layoutoff (mobj-u32 312)
              symoff (mobj-u32 352)
              actual-nsyms (mobj-u32 356)
              stroff (mobj-u32 360)
              strsize (mobj-u32 364)]
          (if (or (!= textoff 472)
                  (or (> (+ textoff textlen) len)
                      (or (> (+ stackoff stacklen) len)
                          (or (!= stackaddr (align8 textlen))
                              (or (!= layoutaddr (align8 (+ stackaddr stacklen)))
                                  (or (> (+ layoutoff layoutlen) len)
                                      (or (!= actual-nreloc nreloc)
                                          (or (> (+ relocoff (* actual-nreloc 8)) len)
                                              (or (!= actual-nsyms nsyms)
                                                  (or (> (+ symoff (* actual-nsyms 16)) len)
                                                      (> (+ stroff strsize) len)))))))))))
              (do (store! ok false) (mobj-fail! MOBJ-HEADER 1))
              false)
          (if (and (load ok)
                   (or (!= (mobj-u32 stackoff) 1398034241)
                       (or (!= (mobj-u32 (+ stackoff 4)) 2)
                           (or (!= (mobj-u32 (+ stackoff 8)) (mobj-safepoint-count))
                               (or (!= (mobj-u32 (+ stackoff 12)) (mobj-root-count))
                                   (or (!= (mobj-u32 (+ stackoff 16)) (mu-function-count))
                                       (or (!= (mobj-u32 (+ stackoff 20)) 32)
                                           (!= stacklen (mobj-stackmap-size)))))))))
              (do (store! ok false) (mobj-fail! MOBJ-STACKMAP 0))
              false)
          (if (and (load ok)
                   (or (!= (mobj-u32 layoutoff) 1280593729)
                       (or (!= (mobj-u32 (+ layoutoff 4)) 1)
                           (or (!= (mobj-u32 (+ layoutoff 8)) (shape-count))
                               (!= layoutlen (mobj-layout-size))))))
              (do (store! ok false) (mobj-fail! MOBJ-LAYOUT 0))
              false)
          (if (load ok)
              (let [functions (mobj-u32 (+ stackoff 16))
                    (mut owner) 0]
                (loop (if (or (>= (load owner) functions) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ (+ stackoff 24) (* (load owner) 32))]
                              (if (or (!= (mobj-u32 rec) (load owner))
                                      (or (!= (mobj-u32 (+ rec 4))
                                              (mu-function-code-start (load owner)))
                                          (or (!= (mobj-u32 (+ rec 8))
                                                  (mu-function-code-size (load owner)))
                                              (or (!= (mobj-u32 (+ rec 12))
                                                      (mu-function-frame-size (load owner)))
                                                  (or (!= (mobj-u64 (+ rec 16))
                                                          (mu-function-callee-mask (load owner)))
                                                      (!= (mobj-u32 (+ rec 24))
                                                          (mu-function-callee-count (load owner))))))))
                                  (do
                                    (store! ok false)
                                    (mobj-fail! MOBJ-STACKMAP (load owner)))
                                  false))
                            (store! owner (+ (load owner) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [sites (mobj-u32 (+ stackoff 8))
                    roots (mobj-u32 (+ stackoff 12))
                    sitebase (+ (+ stackoff 24) (* (mu-function-count) 32))
                    (mut site) 0]
                (loop (if (or (>= (load site) sites) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ sitebase (* (load site) 24))
                                  pc (mobj-u32 rec)
                                  owner (mobj-u32 (+ rec 4))
                                  at (mobj-u32 (+ rec 8))
                                  root-first (mobj-u32 (+ rec 12))
                                  root-count (mobj-u32 (+ rec 16))
                                  op (mobj-u32 (+ rec 20))
                                  (mut vr) 0
                                  (mut expected-count) 0]
                              (if (< at (be-inst-count))
                                  (loop (if (>= (load vr) (ml-vreg-count))
                                            (break)
                                            (do
                                              (if (mobj-root? at (load vr))
                                                  (store! expected-count (+ (load expected-count) 1))
                                                  0)
                                              (store! vr (+ (load vr) 1))
                                              0)))
                                  0)
                              (if (or (>= at (be-inst-count))
                                      (or (not (ml-safepoint? at))
                                          (or (!= pc (mobj-safepoint-pc at))
                                              (or (!= owner (load (field (be-inst at) owner)))
                                                  (or (!= op (load (field (be-inst at) op)))
                                                      (or (!= root-count (load expected-count))
                                                          (> (+ root-first root-count) roots)))))))
                                  (do
                                    (store! ok false)
                                    (mobj-fail! MOBJ-STACKMAP (load site)))
                                  false)
                              (if (load ok)
                                  (do
                                    (store! vr 0)
                                    (let [(mut ordinal) 0]
                                      (loop (if (or (>= (load vr) (ml-vreg-count))
                                                    (not (load ok)))
                                                (break)
                                                (do
                                                  (if (mobj-root? at (load vr))
                                                      (let [rootrec
                                                              (+ sitebase
                                                                 (+ (* sites 24)
                                                                    (* (+ root-first (load ordinal)) 16)))
                                                            reg (mra-reg (load vr))]
                                                        (if (or (!= (mobj-u32 rootrec) (load vr))
                                                                (or (!= (mobj-u32 (+ rootrec 4))
                                                                        (ml-value-kind (load vr)))
                                                                    (or (!= (mobj-u32 (+ rootrec 8))
                                                                            (if (>= reg 0) 0 1))
                                                                        (!= (mobj-u32 (+ rootrec 12))
                                                                            (if (>= reg 0)
                                                                                reg
                                                                                (be-spill-off-vreg (load vr)))))))
                                                            (do
                                                              (store! ok false)
                                                              (mobj-fail! MOBJ-STACKMAP (load site)))
                                                            false)
                                                        (store! ordinal (+ (load ordinal) 1)))
                                                      0)
                                                  (store! vr (+ (load vr) 1))
                                                  0))))
                                    0)
                                  0))
                            (store! site (+ (load site) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [count (mobj-u32 (+ layoutoff 8))
                    (mut shape) 0]
                (loop (if (or (>= (load shape) count) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ (+ layoutoff 16) (* (load shape) 32))]
                              (if (or (!= (mobj-u32 rec) (load shape))
                                      (or (!= (mobj-u32 (+ rec 4)) (shape-size (load shape)))
                                          (or (!= (mobj-u32 (+ rec 8)) 8)
                                              (or (!= (mobj-u32 (+ rec 12))
                                                      (shape-field-count (load shape)))
                                                  (or (!= (mobj-u64 (+ rec 16))
                                                          (mobj-shape-bitmap (load shape)))
                                                      (!= (mobj-u64 (+ rec 24))
                                                          (mobj-shape-boxed-bitmap (load shape))))))))
                                  (do
                                    (store! ok false)
                                    (mobj-fail! MOBJ-LAYOUT (load shape)))
                                  false))
                            (store! shape (+ (load shape) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [(mut reloc) 0]
                (loop (if (or (>= (load reloc) actual-nreloc) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ relocoff (* (load reloc) 8))
                                  address (mobj-u32 rec)
                                  info (mobj-u32 (+ rec 4))]
                              (if (or (>= address textlen)
                                      (or (or (< (& info 16777215) basesyms)
                                              (>= (& info 16777215) (+ basesyms externs)))
                                          (!= (& (>> info 24) 255) 45)))
                                  (do
                                    (store! ok false)
                                    (mobj-fail! MOBJ-RELOCATION (load reloc)))
                                  false))
                            (store! reloc (+ (load reloc) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [(mut s) 0]
                (loop (if (or (>= (load s) actual-nsyms) (not (load ok)))
                          (break)
                          (do
                            (let [at (+ symoff (* (load s) 16))
                                  strx (mobj-u32 at)
                                  typ (mobj-byte (+ at 4))
                                  sect (mobj-byte (+ at 5))
                                  value (mobj-u64 (+ at 8))
                                  owner (if (= (load s) (- basesyms 1)) 0 (+ (load s) 1))
                                  undef (>= (load s) basesyms)]
                              (if (or (>= strx strsize)
                                      (if undef
                                          (or (!= typ 1) (or (!= sect 0) (!= value 0)))
                                          (or (!= sect 1)
                                              (or (!= typ (if (= owner 0) 15 14))
                                                  (and (> funcs 0)
                                                       (!= value (mu-function-code-start owner)))))))
                                  (do (store! ok false) (mobj-fail! MOBJ-SYMBOL (load s)))
                                  false))
                            (store! s (+ (load s) 1))
                            0)))
                0)
              0))
        0)
    (load ok)))

(defn mobj-corrupt-byte! [(at i64) (value i64)] (-> i64)
  (al-set! [u8] (field (backend) obj) at (cast u8 value))
  0)

(defn be-macho! [] (-> i64)
  (let [p (backend)
        textlen (be-code-len)
        funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1)
        locals (if (> funcs 0) (- funcs 1) 0)
        nreloc (mobj-external-reloc-count)
        externs (mobj-external-symbol-count)
        nsyms (+ basesyms externs)
        stacklen (mobj-stackmap-size)
        layoutlen (mobj-layout-size)
        textoff 472
        stackoff (align8 (+ textoff textlen))
        stackaddr (align8 textlen)
        layoutaddr (align8 (+ stackaddr stacklen))
        layoutoff (align8 (+ stackoff stacklen))
        relocoff (align8 (+ layoutoff layoutlen))
        symoff (+ relocoff (* nreloc 8))
        stroff (+ symoff (* nsyms 16))
        strsize
          (+ (+ 9 (* locals 22))
             (+ (if (mobj-has-external-op? MI-NEW) 16 0)
                (+ (if (mobj-has-external-op? MI-JSPROP) 17 0)
                   (+ (if (mobj-has-external-op? MI-JSARRAY) 14 0)
                      (if (mobj-has-external-op? MI-JSSTRING) 15 0)))))]
    (al-clear! [u8] (field p obj))
    ; mach_header_64
    (obj-u32! 4277009103)
    (obj-u32! 16777228)
    (obj-u32! 0)
    (obj-u32! 1)
    (obj-u32! 4)
    (obj-u32! 440)
    (obj-u32! 0)
    (obj-u32! 0)
    ; LC_SEGMENT_64 + text and two versioned metadata sections.
    (obj-u32! 25)
    (obj-u32! 312)
    (obj-name16! "")
    (obj-u64! 0)
    (obj-u64! (+ layoutaddr layoutlen))
    (obj-u64! textoff)
    (obj-u64! (- (+ layoutoff layoutlen) textoff))
    (obj-u32! 7)
    (obj-u32! 7)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-name16! "__text")
    (obj-name16! "__TEXT")
    (obj-u64! 0)
    (obj-u64! textlen)
    (obj-u32! textoff)
    (obj-u32! 2)
    (obj-u32! relocoff)
    (obj-u32! nreloc)
    (obj-u32! 2147484672)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-name16! "__aot_stackmap")
    (obj-name16! "__DATA")
    (obj-u64! stackaddr)
    (obj-u64! stacklen)
    (obj-u32! stackoff)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-name16! "__aot_layout")
    (obj-name16! "__DATA")
    (obj-u64! layoutaddr)
    (obj-u64! layoutlen)
    (obj-u32! layoutoff)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    ; LC_SYMTAB
    (obj-u32! 2)
    (obj-u32! 24)
    (obj-u32! symoff)
    (obj-u32! nsyms)
    (obj-u32! stroff)
    (obj-u32! strsize)
    ; LC_DYSYMTAB: local function symbols first, then the exported `_kernel` definition.
    (obj-u32! 11)
    (obj-u32! 80)
    (obj-u32! 0)
    (obj-u32! locals)
    (obj-u32! locals)
    (obj-u32! 1)
    (obj-u32! basesyms)
    (obj-u32! externs)
    (let [(mut z) 0]
      (loop (if (>= (load z) 12)
                (break)
                (do (obj-u32! 0) (store! z (+ (load z) 1)) 0))))
    ; LC_BUILD_VERSION: macOS, minimum 11.0, SDK 11.0, no tool records.
    (obj-u32! 50)
    (obj-u32! 24)
    (obj-u32! 1)
    (obj-u32! 720896)
    (obj-u32! 720896)
    (obj-u32! 0)
    (obj-pad-to! textoff)
    (let [(mut i) 0]
      (loop (if (>= (load i) textlen)
                (break)
                (do (obj-u8! (be-code-byte (load i))) (store! i (+ (load i) 1)) 0))))
    (obj-pad-to! stackoff)
    (mobj-write-stackmaps!)
    (obj-pad-to! layoutoff)
    (mobj-write-layouts!)
    (obj-pad-to! relocoff)
    (let [(mut at) 0]
      (loop (if (>= (load at) (be-inst-count))
                (break)
