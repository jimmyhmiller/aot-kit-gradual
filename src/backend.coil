                                              0)))
                                  (if (load ok)
                                      (let [first (al-len [i64] (load (field u call-args)))
                                            fresh (ms-new-vreg!)
                                            (mut j) 0]
                                        (loop (if (>= (load j) argc)
                                                  (break)
                                                  (do
                                                    (al-push! [i64]
                                                              (field u call-args)
                                                              (load (index args (load j))))
                                                    (store! j (+ (load j) 1))
                                                    0)))
                                        (let [a (if polymorphic callee-value
                                                   (if (> argc 0) (al-get (load (field u call-args)) first) -1))
                                              b (if (> argc 1) (al-get (load (field u call-args)) (+ first 1)) -1)
                                              at
                                                (ms-emit! owner
                                                          call-bid
                                                          (mi-new MI-CALL fresh a b
                                                                  (if polymorphic (^ targets -1) target)
                                                                  node))]
                                          (ms-add-call-args! at (if (= argc 0) -1 first) argc)
                                          (if has-memory
                                              (ms-add-memory-deps! at node (- (n-nins node) 1) 1)
                                              0)
                                          (store! vr fresh)))
                                      0)))))))
                  (ms-fail! MSEL-UNSUPPORTED node))
          (if (< (load vr) 0)
              -1
              (do (ms-vset! owner node (load vr)) (load vr)))))))

(defn ms-select-value! [(owner i64) (node i64)] (-> i64)
  (ms-select-value-at! owner node (ms-entry-block owner)))

(defn ms-phi-block [(owner i64) (phi i64)] (-> i64)
  (if (or (!= (n-op phi) OP-PHI) (= (n-in phi 0) NO-NODE))
      -1
      (let [bid (al-get (load (field (machine-unit) ctrl-block)) (n-in phi 0))]
        (if (and (>= bid 0) (= (mu-block-owner bid) owner)) bid -1))))

; Reserve every scalar Phi destination before selecting any incoming expression.  This is the
; essential fixed point for loop-carried and mutually recursive Phis: a back-edge expression can
; refer to a destination whose copy has not been constructed yet without recursing forever.
(defn ms-preallocate-phis! [(owner i64)] (-> i64)
  (let [(mut node) 0]
    (loop (if (>= (load node) (n-count))
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (= (n-op (load node)) OP-PHI)
                              (>= (ms-phi-block owner (load node)) 0)))
                    (if (ty-mem? (n-ty (load node)))
                        (ms-seen! owner (load node))
                        (let [vreg (ms-new-vreg!)]
                          (ms-vset! owner (load node) vreg)
                          (al-set! [i64] (field (machine-unit) vreg-phi-block)
                                   vreg
                                   (ms-phi-block owner (load node)))))
                    0)
                (store! node (+ (load node) 1))
                0)))
    0))

(defn ms-build-edge-copies! [(owner i64)] (-> i64)
  (let [u (machine-unit)
        edges (mu-edge-count)
        (mut edge) 0]
    (loop (if (or (>= (load edge) edges) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [e (mu-edge (load edge))]
                  (if (!= (load (field e owner)) owner)
                      0
                      (let [first (al-len [MCopy] (load (field u edge-copies)))
                            target (load (field e target))
                            source (load (field e source))
                            slot (load (field e target-slot))
                            (mut node) 0]
                        (loop (if (or (>= (load node) (n-count)) (!= (ms-result) MSEL-OK))
                                  (break)
                                  (do
                                    (if (and (not (n-dead? (load node)))
                                             (and (= (n-op (load node)) OP-PHI)
                                                  (= (ms-phi-block owner (load node)) target)))
                                        (if (>= slot (n-nins (load node)))
                                            (ms-fail! MSEL-DEPENDENCY (load node))
                                            (if (ty-mem? (n-ty (load node)))
                                                (if (ms-select-memory-at! owner (n-in (load node) slot) source)
                                                    (al-push! [MCopy]
                                                              (field u edge-copies)
                                                              (mc-new (load edge)
                                                                      (load node)
                                                                      (load node)
                                                                      (n-in (load node) slot)
                                                                      MCOPY-MEMORY))
                                                    0)
                                                (let [input (n-in (load node) slot)
                                                      raw (ms-select-value-at! owner input source)
                                                      src
                                                        (if (and (>= raw 0)
                                                                 (be-node-fp-value? (load node)))
                                                            (ms-fp-input! owner input raw source)
                                                            raw)]
                                                  (if (< src 0)
                                                      0
                                                      (al-push! [MCopy]
                                                                (field u edge-copies)
                                                                (mc-new (load edge)
                                                                        (load node)
                                                                        (ms-vget owner (load node))
                                                                        src
                                                                        MCOPY-VALUE))))))
                                        0)
                                    (store! node (+ (load node) 1))
                                    0)))
                        (store! (field e copy-first) first)
                        (store! (field e copy-count)
                                (- (al-len [MCopy] (load (field u edge-copies))) first)))))
                (store! edge (+ (load edge) 1))
                0)))
    0))

(defn ms-work-dst-used-as-source? [(at i64)] (-> bool)
  (let [u (machine-unit)
        dst (al-get (load (field u copy-work-dst)) at)
        n (al-len [i64] (load (field u copy-work-live)))
        (mut i) 0
        (mut used) false]
    (loop (if (or (>= (load i) n) (load used))
              (break)
              (do
                (if (and (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                         (= (al-get (load (field u copy-work-src)) (load i)) dst))
                    (store! used true)
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load used)))

(defn ms-resolve-edge-copies! [(edge i64)] (-> i64)
  (let [u (machine-unit)
        e (mu-edge edge)
        first (al-len [MMove] (load (field u edge-moves)))
        copies (load (field e copy-count))
        (mut i) 0
        (mut remaining) 0]
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (loop (if (>= (load i) copies)
              (break)
              (do
                (let [c (mu-edge-copy edge (load i))]
                  (if (or (!= (load (field c kind)) MCOPY-VALUE)
                          (= (load (field c dst)) (load (field c src))))
                      0
                      (do
                        (al-push! [i64] (field u copy-work-dst) (load (field c dst)))
                        (al-push! [i64] (field u copy-work-src) (load (field c src)))
                        (al-push! [i64] (field u copy-work-live) 1)
                        (store! remaining (+ (load remaining) 1)))))
                (store! i (+ (load i) 1))
                0)))
    (loop (if (<= (load remaining) 0)
              (break)
              (let [n (al-len [i64] (load (field u copy-work-live)))
                    (mut ready) -1
                    (mut first-live) -1]
                (store! i 0)
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (if (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                                (do
                                  (if (< (load first-live) 0) (store! first-live (load i)) 0)
                                  (if (not (ms-work-dst-used-as-source? (load i)))
                                      (do (store! ready (load i)) (store! i n))
                                      0))
                                0)
                            (store! i (+ (load i) 1))
                            0)))
                (if (>= (load ready) 0)
                    (do
                      (al-push! [MMove]
                                (field u edge-moves)
                                (mm-new edge
                                        (al-get (load (field u copy-work-dst)) (load ready))
                                        (al-get (load (field u copy-work-src)) (load ready))
                                        false))
                      (al-set! [i64] (field u copy-work-live) (load ready) 0)
                      (store! remaining (- (load remaining) 1)))
                    ; No destination is dead: preserve one source in a fresh vreg, rewrite every use of
                    ; that old source, and the cycle becomes an acyclic chain on the next iteration.
                    (let [old-src (al-get (load (field u copy-work-src)) (load first-live))
                          temp (ms-new-vreg!)]
                      (al-push! [MMove] (field u edge-moves) (mm-new edge temp old-src true))
                      (store! i 0)
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (if (and (!= (al-get (load (field u copy-work-live)) (load i)) 0)
                                           (= (al-get (load (field u copy-work-src)) (load i)) old-src))
                                      (al-set! [i64] (field u copy-work-src) (load i) temp)
                                      0)
                                  (store! i (+ (load i) 1))
                                  0))))))))
    (store! (field e move-first) first)
    (store! (field e move-count) (- (al-len [MMove] (load (field u edge-moves))) first))
    0))

(defn ms-resolve-owner-copies! [(owner i64)] (-> i64)
  (let [(mut edge) 0]
    (loop (if (>= (load edge) (mu-edge-count))
              (break)
              (do
                (if (= (load (field (mu-edge (load edge)) owner)) owner)
                    (ms-resolve-edge-copies! (load edge))
                    0)
                (store! edge (+ (load edge) 1))
                0)))
    0))

(defn ms-if-target [(bid i64) (arm i64)] (-> i64)
  (let [n (mu-block-succ-count bid)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (let [target (mu-block-succ-target bid (load i))
                      ctrl (mu-block-control target)]
                  (if (and (= (n-op ctrl) OP-CPROJ) (= (n-aux ctrl) arm))
                      (store! found target)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn ms-function-fp-return? [(owner i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut fp) false]
    (loop (if (or (>= (load i) count) (load fp))
              (break)
              (do
                (let [bid (mu-function-return-block owner (load i))
                      term (mu-block-terminator bid)]
                  (if (and (!= term NO-NODE)
                           (and (= (n-op term) OP-RETURN)
                                (be-node-fp-value? (n-in term 1))))
                      (store! fp true)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load fp)))

(defn ms-ingress-owned-by? [(owner i64) (node i64)] (-> bool)
  (if (= (n-op node) OP-PARM)
      (= (mu-find-function (n-in node 0)) owner)
      (let [ctrl (n-in node 0)]
        (if (= (n-op ctrl) OP-START)
            (= owner 0)
            (and (= (n-op ctrl) OP-FUNSTART)
                 (= (mu-find-function (n-in ctrl 0)) owner))))))

(defn ms-preselect-function! [(owner i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner)
        (mut node) 0
        (mut rpo) 0]
    ;; ABI ingress exists only at function entry. Select source arguments before recursively
    ;; selecting a body whose allocations/calls may clobber their physical ingress registers.
    ;; Memory Args are effect tokens and never become machine arguments.
    (loop (if (or (>= (load node) (n-count)) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (or (= (n-op (load node)) OP-ARG) (= (n-op (load node)) OP-PARM))
                              (not (ty-mem? (n-ty (load node))))))
                    (let [bid (ms-node-block owner (load node))]
                      (if (and (ms-ingress-owned-by? owner (load node))
                               (and (>= bid 0) (= (load (field (mu-block bid) owner)) owner)))
                          (ms-select-value-at! owner (load node) bid)
                          0))
                    0)
                (store! node (+ (load node) 1)))))
    (loop (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      term (mu-block-terminator bid)]
                  (if (= term NO-NODE)
                      0
                      (case (n-op term) OP-IF
                            (ms-select-value-at! owner (n-in term 1) bid) OP-RETURN
                            (do
                              (ms-select-control-effects! owner (n-in term 0) bid)
                              (if (> (n-nins term) 2)
                                  (do (ms-select-memory! owner (n-in term 2)) 0)
                                  0)
                              (let [node (n-in term 1)
                                    raw (ms-select-value-at! owner node bid)
                                    return-kind (be-function-return-kind owner)
                                    value
                                      (if (and (>= raw 0)
                                               (and (be-function-return-mixed? owner)
                                                    (and (= return-kind MLK-BOXED)
                                                         (not (be-box-input-already-tagged? node)))))
                                          (let [tag (if (be-node-fp-value? node)
                                                        0
                                                        (be-js-tag-for-value node))]
                                            (if (= tag -1)
                                                -1
                                                (let [boxed (ms-new-vreg!)]
                                                  (ms-emit! owner
                                                            bid
                                                            (mi-new MI-JSBOX boxed raw -1 tag term))
                                                  boxed)))
                                          raw)]
                                (if (< value 0)
                                    (ms-fail! MSEL-UNSUPPORTED term)
                                    (if (and (= return-kind MLK-BOXED)
                                             (be-function-return-mixed? owner))
                                        (do (ms-vset! owner term value) value)
                                        value))))
                              (ms-fail! MSEL-TERMINATOR term))))
                (store! rpo (+ (load rpo) 1))
                0)))
    ;; Dynamic JavaScript effects are not represented in a function's fixed-field Return memory
    ;; tuple. Select them after control predicates and returns have established the earliest shared
    ;; value placements; an effect-only branch must not pin a common predicate below its use.
    (store! node 0)
    (loop (if (or (>= (load node) (n-count)) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (not (n-dead? (load node)))
                    (if (= (n-op (load node)) OP-CALL)
                        (let [bid (ms-node-block owner (load node))]
                          (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                              (do (ms-select-value-at! owner (load node) bid) 0)
                              0))
                        (if (ms-linear-memory-effect? (load node))
                            (let [bid (ms-memory-block owner (load node))]
                              (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                                  (do (ms-select-memory-at! owner (load node) bid) 0)
                                  0))
                            0))
                    0)
                (store! node (+ (load node) 1)))))
    0))

(defn ms-emit-block-terminator! [(owner i64) (bid i64)] (-> i64)
  (let [term (mu-block-terminator bid)]
    (if (= (mu-block-succ-count bid) 1)
        (let [edge (mu-block-succ-edge bid 0)
              moves (mu-edge-move-count edge)
              (mut i) 0]
          (loop (if (>= (load i) moves)
                    (break)
                    (do
                      (ms-emit! owner
                                bid
                                (mi-new MI-COPY
                                        (mu-move-dst edge (load i))
                                        (mu-move-src edge (load i))
                                        -1
                                        edge
                                        NO-NODE))
                      (store! i (+ (load i) 1))
                      0))))
        0)
    (if (= term NO-NODE)
        (if (= (mu-block-succ-count bid) 1)
            (ms-emit! owner
                      bid
                      (mi-new MI-JMP
                              -1
                              -1
                              -1
                              (mu-block-succ-target bid 0)
                              (mu-block-control bid)))
            (ms-fail! MSEL-TERMINATOR bid))
        (case (n-op term) OP-IF
              (let [pred-node (n-in term 1)
                    raw-pred (ms-vget owner pred-node)
                    pred
                      (if (and (>= raw-pred 0)
                               (and (= (n-ty pred-node) (t-dyn))
                                    (be-js-dynamic-boundary? pred-node)))
                          (let [zero (ms-immediate! owner bid 0)]
                            (ms-jsstring! owner bid NO-NODE raw-pred zero zero JSSOP-VALUE-TRUTHY))
                          (if (and (>= raw-pred 0) (be-node-fp-value? pred-node))
                          (let [fresh (ms-new-vreg!)]
                            (ms-emit! owner
                                      bid
                                      (mi-new MI-FTRUTH fresh raw-pred -1 0 NO-NODE))
                            fresh)
                          raw-pred))
                    yes (ms-if-target bid 0)
                    no (ms-if-target bid 1)]
                (if (or (< pred 0) (or (< yes 0) (< no 0)))
                    (ms-fail! MSEL-TERMINATOR term)
                    (ms-emit! owner bid (mi-new MI-CBR -1 pred yes no term))))
                OP-RETURN
              (let [node (n-in term 1)
                    raw (ms-vget owner node)
                    normalized (ms-vget owner term)
                    value
                      (if (>= normalized 0)
                          normalized
                          (if (and (>= raw 0) (ms-function-fp-return? owner))
                              (ms-fp-input! owner node raw bid)
                              raw))]
                (if (< value 0)
                    (ms-fail! MSEL-DEPENDENCY term)
                    (ms-emit! owner bid (mi-new MI-RET -1 value -1 0 term))))
                (ms-fail! MSEL-TERMINATOR term)))))

(defn ms-emit-function! [(owner i64) (base i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner)
        entry (ms-entry-block owner)
        (mut rpo) 0]
    (loop (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      b (mu-block bid)
                      first (if (= bid entry) base (be-inst-count))]
                  (store! (field b inst-first) first)
                  (ms-emit-block-terminator! owner bid)
                  (store! (field b inst-count) (- (be-inst-count) first)))
                (store! rpo (+ (load rpo) 1))
                0)))
    0))

(defn ms-pack-instructions! [] (-> i64)
  (let [u (machine-unit)
        original (be-inst-count)
        funcs (mu-function-count)
        (mut owner) 0]
    (al-clear! [MInst] (field u packed-insts))
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (let [nblocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) nblocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))
                                    b (mu-block bid)
                                    first (al-len [MInst] (load (field u packed-insts)))
                                    (mut at) 0]
                                (loop (if (>= (load at) original)
                                          (break)
                                          (do
                                            (let [m (be-inst (load at))]
                                              (if (and (= (load (field m owner)) (load owner))
                                                       (and (= (load (field m block-id)) bid)
                                                            (not (mi-op-terminator? (load (field m op))))))
                                                  (al-push! [MInst] (field u packed-insts) (load m))
                                                  0))
                                            (store! at (+ (load at) 1))
                                            0)))
                                ; Moving a definition must never put it textually after control transfer.
                                (store! at 0)
                                (loop (if (>= (load at) original)
                                          (break)
                                          (do
                                            (let [m (be-inst (load at))]
                                              (if (and (= (load (field m owner)) (load owner))
                                                       (and (= (load (field m block-id)) bid)
                                                            (mi-op-terminator? (load (field m op)))))
                                                  (al-push! [MInst] (field u packed-insts) (load m))
                                                  0))
                                            (store! at (+ (load at) 1))
                                            0)))
                                (store! (field b inst-first) first)
                                (store! (field b inst-count)
                                        (- (al-len [MInst] (load (field u packed-insts))) first)))
                              (store! rpo (+ (load rpo) 1))
                              0))))
                (store! owner (+ (load owner) 1))
                0)))
    (al-clear! [MInst] (field (backend) ins))
    (let [n (al-len [MInst] (load (field u packed-insts)))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! [MInst]
                            (field (backend) ins)
                            (al-get (load (field u packed-insts)) (load i)))
                  (store! i (+ (load i) 1))
                  0))))
    0))

(defn ms-phi-vreg-block [(owner i64) (vreg i64)] (-> i64)
  (let [u (machine-unit)]
    (if (or (< vreg 0) (>= vreg (al-len [i64] (load (field u vreg-phi-block)))))
        -1
        (let [block (al-get [i64] (load (field u vreg-phi-block)) vreg)]
          (if (and (>= block 0) (= (mu-block-owner block) owner)) block -1)))))

(defn ms-owner-def-inst [(owner i64) (vreg i64)] (-> i64)
  (let [(mut rpo) 0 (mut found) -1]
    (loop (if (or (>= (load rpo) (mu-function-block-count owner)) (>= (load found) 0))
              (break)
              (let [bid (mu-function-block owner (load rpo))
                    first (mu-block-inst-first bid)
                    count (mu-block-inst-count bid)
                    (mut at) first]
                (loop (if (or (>= (load at) (+ first count)) (>= (load found) 0))
                          (break)
                          (do
                            (if (= (load (field (be-inst (load at)) dst)) vreg)
                                (store! found (load at))
                                0)
                            (store! at (+ (load at) 1)))))
                (store! rpo (+ (load rpo) 1)))))
    (load found)))

(defn ms-vreg-def-block [(owner i64) (vreg i64)] (-> i64)
  (let [phi-block (ms-phi-vreg-block owner vreg)]
    ; Phi copies have several physical definitions. The SSA definition is the target block,
    ; independent of which incoming copy happens to be first in instruction order.
    (if (>= phi-block 0)
        phi-block
        (let [def (ms-owner-def-inst owner vreg)]
          (if (>= def 0) (ms-inst-block def) -1)))))

(defn ms-gcm-deeper-bound [(current i64) (dependency i64)] (-> i64)
  (if (< dependency 0)
      current
      (if (mu-dominates? current dependency)
          dependency
          (if (mu-dominates? dependency current) current -1))))

(defn ms-gcm-input-bound [(owner i64) (current i64) (vreg i64)] (-> i64)
  (if (< vreg 0)
      current
      (let [block (ms-vreg-def-block owner vreg)
            def (ms-owner-def-inst owner vreg)
            ;; Demand-driven selection may first emit a pure producer in one consumer's block.
            ;; Once GCM has computed that producer's true earliest block, depend on that bound rather
            ;; than treating the provisional emission block as semantic control.
            dependency
              (if (or (< def 0) (ms-phi-vreg? owner vreg))
                  block
                  (let [earliest (ms-inst-earliest def)]
                    (if (>= earliest 0) earliest -1)))]
        (ms-gcm-deeper-bound current dependency))))

(defn ms-gcm-refresh-earliest! [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (load (field m owner))
        desc (mi-desc (load (field m op)))
        inputs (mi-desc-inputs desc)
        (mut bound) (ms-entry-block owner)]
    (if (> inputs 0)
        (store! bound (ms-gcm-input-bound owner (load bound) (load (field m a))))
        0)
    (if (and (>= (load bound) 0) (> inputs 1))
        (store! bound (ms-gcm-input-bound owner (load bound) (load (field m b))))
        0)
    (if (and (>= (load bound) 0) (= (load (field m op)) MI-CSEL))
        (store! bound (ms-gcm-input-bound owner (load bound) (load (field m imm))))
        0)
    (if (and (>= (load bound) 0) (> (ms-inst-arg-count at) 0))
        (let [(mut arg) 0]
          (loop (if (or (>= (load arg) (ms-inst-arg-count at)) (< (load bound) 0))
                    (break)
                    (do
                      (store! bound
                              (ms-gcm-input-bound owner
                                                  (load bound)
                                                  (ms-inst-arg at (load arg))))
                      (store! arg (+ (load arg) 1))))))
        0)
    (if (< (load bound) 0)
        false
        (do (store! (field m earliest) (load bound)) true))))

(defn ms-gcm-compute-earliest! [] (-> bool)
  (let [n (be-inst-count)
        (mut round) 0
        (mut ok) true]
    (let [(mut at) 0]
      (loop (if (>= (load at) n)
                (break)
                (do
                  (store! (field (be-inst (load at)) earliest) -1)
                  (store! (field (be-inst (load at)) latest) -1)
                  (store! at (+ (load at) 1))))))
    ; A few forward fixed-point rounds also cover definitions emitted out of textual order.
    (loop (if (or (>= (load round) (+ n 1)) (not (load ok)))
              (break)
              (do
                (let [(mut at) 0]
                  (loop (if (or (>= (load at) n) (not (load ok)))
                            (break)
                            (do
                              (let [m (be-inst (load at))
                                    owner (load (field m owner))
                                    op (load (field m op))
                                    bid (load (field m block-id))]
                                (if (mi-op-pinned? op)
                                    (store! (field m earliest) bid)
                                    (let [(mut bound) (ms-entry-block owner)
                                          inputs (mi-op-inputs op)]
                                      (if (> inputs 0)
                                          (store! bound
                                                  (ms-gcm-input-bound owner
                                                                      (load bound)
                                                                      (load (field m a))))
                                          0)
                                      (if (and (>= (load bound) 0) (> inputs 1))
                                          (store! bound
                                                  (ms-gcm-input-bound owner
                                                                      (load bound)
                                                                      (load (field m b))))
                                          0)
                                      (if (and (>= (load bound) 0) (= (load (field m op)) MI-CSEL))
                                          (store! bound
                                                  (ms-gcm-input-bound owner
                                                                      (load bound)
                                                                      (load (field m imm))))
                                          0)
                                      (if (and (>= (load bound) 0) (> (ms-inst-arg-count (load at)) 0))
                                          (let [(mut arg) 0]
                                            (loop (if (or (>= (load arg) (ms-inst-arg-count (load at)))
                                                          (< (load bound) 0))
                                                      (break)
                                                      (do
                                                        (store! bound
                                                                (ms-gcm-input-bound owner
                                                                                    (load bound)
                                                                                    (ms-inst-arg (load at) (load arg))))
                                                        (store! arg (+ (load arg) 1))
                                                        0))))
                                          0)
                                      ; A definition may have been emitted later than this use. Leave
                                      ; the use unresolved for this round; the forward fixed point will
                                      ; revisit it after the definition acquires an earliest block.
                                      (if (>= (load bound) 0)
                                          (store! (field m earliest) (load bound))
                                          0))))
                              (store! at (+ (load at) 1))
                              0))))
                (store! round (+ (load round) 1))
                0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) n) (not (load ok)))
                    (break)
                    (do
                      (if (< (load (field (be-inst (load at)) earliest)) 0)
                          (do
                            (ms-fail! MSEL-DEPENDENCY (load at))
                            (store! ok false))
                          0)
                      (store! at (+ (load at) 1))))))
        0)
    (load ok)))

(defn ms-inst-uses-vreg? [(at i64) (vreg i64)] (-> bool)
  (let [m (be-inst at)
        desc (mi-desc (load (field m op)))
        inputs (mi-desc-inputs desc)
        (mut used) false]
    (if (and (> inputs 0) (= (load (field m a)) vreg)) (store! used true) 0)
    (if (and (> inputs 1) (= (load (field m b)) vreg)) (store! used true) 0)
    (if (and (= (load (field m op)) MI-CSEL) (= (load (field m imm)) vreg))
        (store! used true)
        0)
    (if (> (ms-inst-arg-count at) 0)
        (let [(mut arg) 0]
          (loop (if (or (>= (load arg) (ms-inst-arg-count at)) (load used))
                    (break)
                    (do
                      (if (= (ms-inst-arg at (load arg)) vreg) (store! used true) 0)
                      (store! arg (+ (load arg) 1))
                      0))))
        0)
    (load used)))

(defn ms-gcm-lca [(left i64) (right i64)] (-> i64)
  (if (< left 0) right (if (< right 0) left (mu-idom-intersect left right))))

(defn ms-gcm-latest-use-block [(owner i64) (vreg i64)] (-> i64)
  (let [(mut latest) -1
        (mut rpo) 0
        (mut edge) 0]
    ;; Instructions are already packed into per-function block ranges. Walking the entire program
    ;; for every definition made GCM quadratic in unrelated functions (DeltaBlue has 76 of them).
    ;; Restrict the use scan to the owning function; cross-function vreg uses are invalid anyway.
    (loop (if (>= (load rpo) (mu-function-block-count owner))
              (break)
              (let [bid (mu-function-block owner (load rpo))
                    first (mu-block-inst-first bid)
                    count (mu-block-inst-count bid)
                    (mut at) first]
                (loop (if (>= (load at) (+ first count))
                          (break)
                          (do
                            (if (ms-inst-uses-vreg? (load at) vreg)
                                (store! latest
                                        (ms-gcm-lca (load latest)
                                                    (ms-inst-block (load at))))
                                0)
                            (store! at (+ (load at) 1)))))
                (store! rpo (+ (load rpo) 1)))))
    ; A Phi source is used on its incoming edge, hence in the predecessor block.
    (loop (if (>= (load edge) (mu-edge-count))
              (break)
              (do
                (if (= (mu-block-owner (mu-edge-source (load edge))) owner)
                    (let [(mut i) 0]
                      (loop (if (>= (load i) (mu-edge-copy-count (load edge)))
                                (break)
                                (do
                                  (if (and (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                           (= (mu-copy-src (load edge) (load i)) vreg))
                                      (store! latest
                                              (ms-gcm-lca (load latest) (mu-edge-source (load edge))))
                                      0)
                                  (store! i (+ (load i) 1))
                                  0))))
                    0)
                (store! edge (+ (load edge) 1))
                0)))
    (load latest)))

(defn ms-gcm-place! [] (-> bool)
  (if (not (ms-gcm-compute-earliest!))
      false
      (let [(mut at) (be-inst-count)
            (mut ok) true]
        (loop (if (or (<= (load at) 0) (not (load ok)))
                  (break)
                  (do
                    (store! at (- (load at) 1))
                    (let [m (be-inst (load at))
                          desc (mi-desc (load (field m op)))
                          owner (load (field m owner))
                          original (load (field m block-id))
                          refreshed
                            (if (mi-desc-pinned? desc)
                                true
                                (ms-gcm-refresh-earliest! (load at)))
                          earliest (load (field m earliest))]
                      (if (not refreshed)
                          (do (ms-fail! MSEL-DEPENDENCY (load at)) (store! ok false))
                          (if (mi-desc-pinned? desc)
                          (store! (field m latest) original)
                          (let [use-block
                                  (if (>= (load (field m dst)) 0)
                                      (ms-gcm-latest-use-block owner (load (field m dst)))
                                      -1)
                                latest (if (< use-block 0) earliest use-block)]
                            (store! (field m latest) latest)
                            (if (not (mu-dominates? earliest latest))
                                (do (ms-fail! MSEL-DEPENDENCY (load at)) (store! ok false))
                                (let [(mut choice) latest
                                      (mut cursor) latest]
                                  (loop (if (= (load cursor) earliest)
                                            (break)
                                            (do
                                              (store! cursor (mu-block-idom (load cursor)))
                                              (if (< (mu-block-loop-depth (load cursor))
                                                     (mu-block-loop-depth (load choice)))
                                                  (store! choice (load cursor))
                                                  0))))
                                  (store! (field m block-id) (load choice))))))))
                    0)))
        (if (load ok) (do (ms-pack-instructions!) true) false))))

(defn ms-cache-new-defs! [] (-> i64)
  (let [u (machine-unit) (mut vreg) 0 (mut at) 0]
    (al-clear! [i64] (field u vreg-new-def))
    (loop (if (>= (load vreg) (load (field u next-vreg)))
              (break)
              (do
                (al-push! [i64] (field u vreg-new-def) -1)
                (store! vreg (+ (load vreg) 1)))))
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (let [m (be-inst (load at)) dst (load (field m dst))]
                (if (and (>= dst 0) (= (load (field m op)) MI-NEW))
                    (al-set! [i64] (field u vreg-new-def) dst (load at))
                    0)
                (store! at (+ (load at) 1)))))
    0))

(defn ms-memory-operands-may-alias? [(left (ptr MInst)) (right (ptr MInst))] (-> bool)
  (let [defs (load (field (machine-unit) vreg-new-def))
        a (load (field left a))
        b (load (field right a))]
    (if (= a b)
        true
        ;; Separate native allocations cannot alias. The cached definition classification keeps
        ;; this hot memory-pair query constant-time while every other value remains conservative.
        (not (and (>= a 0)
                  (and (< a (al-len [i64] defs))
                       (and (>= b 0)
                            (and (< b (al-len [i64] defs))
                                 (and (>= (al-get [i64] defs a) 0)
                                      (>= (al-get [i64] defs b) 0))))))))))

(defn ms-machine-memory-read? [(m (ptr MInst))] (-> bool)
  (or (= (load (field m op)) MI-LOAD)
      (or (and (= (load (field m op)) MI-JSPROP) (= (load (field m imm)) 0))
          (and (= (load (field m op)) MI-JSARRAY)
               (or (= (load (field m imm)) 1) (= (load (field m imm)) 3))))))

(defn ms-machine-memory-write? [(m (ptr MInst))] (-> bool)
  (or (= (load (field m op)) MI-STORE)
      (or (and (= (load (field m op)) MI-JSPROP)
               (or (= (load (field m imm)) 1) (= (load (field m imm)) 2)))
          (and (= (load (field m op)) MI-JSARRAY)
               (or (= (load (field m imm)) 2)
                   (or (= (load (field m imm)) 4) (= (load (field m imm)) 5)))))))

(defn ms-build-memory-anti-deps! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        (mut at) 0]
    (al-clear! [i64] (field u memory-anti-deps))
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      first (al-len [i64] (load (field u memory-anti-deps)))]
                  (store! (field m anti-first) first)
                  (store! (field m anti-count) 0)
                  (if (ms-machine-memory-write? m)
                      (let [(mut prior) 0]
                        (loop (if (>= (load prior) n)
                                  (break)
                                  (do
                                    (let [candidate (be-inst (load prior))]
                                      (if (and (= (load (field candidate owner)) (load (field m owner)))
                                               (and (ms-memory-operands-may-alias? candidate m)
                                                    (and (ms-machine-memory-read? candidate)
                                                    (and (< (load (field candidate node)) (load (field m node)))
                                                         (mu-dominates? (load (field candidate block-id))
                                                                        (load (field m block-id)))))))
                                          (do
                                            (al-push! [i64]
                                                      (field u memory-anti-deps)
                                                      (load (field candidate node)))
                                            (store! (field m anti-count)
                                                    (+ (load (field m anti-count)) 1)))
                                          0))
                                    (store! prior (+ (load prior) 1))
                                    0))))
                      0))
                (store! at (+ (load at) 1))
                0)))
    0))

(defn ms-find-node-inst-after [(owner i64) (node i64) (after i64)] (-> i64)
  (let [(mut at) (+ after 1)
        (mut found) -1]
    (loop (if (or (>= (load at) (be-inst-count)) (>= (load found) 0))
              (break)
              (do
                (let [m (be-inst (load at))]
                  (if (and (= (load (field m owner)) owner)
                           (= (load (field m node)) node))
                      (store! found (load at))
                      0))
                (store! at (+ (load at) 1)))))
    (load found)))

;; GCM preserves provisional instruction order within each destination block. Demand-driven
;; selection can nevertheless emit a consumer before an already-ordered memory predecessor. Move
;; that predecessor ahead of the consumer before the ordinary scalar/data scheduler runs.
(defn ms-repair-late-memory-deps! [] (-> bool)
  (let [limit (* (be-inst-count) (be-inst-count))
        (mut moves) 0
        (mut changed) true
        (mut ok) true]
    (loop (if (or (not (load changed)) (not (load ok)))
              (break)
              (do
                (store! changed false)
                (let [(mut consumer) 0]
                  (loop (if (or (>= (load consumer) (be-inst-count)) (load changed))
                            (break)
                            (let [m (be-inst (load consumer))
                                  owner (load (field m owner))
                                  count (load (field m mem-count))
                                  (mut dep) 0]
                              (loop (if (or (>= (load dep) count) (load changed))
                                        (break)
                                        (let [memory-node
                                                (al-get
                                                  (load (field (machine-unit) selection-memory-deps))
                                                  (+ (load (field m mem-first)) (load dep)))
                                              producer
                                                (ms-find-node-inst-after
                                                  owner memory-node (load consumer))]
                                          (if (and (>= producer 0)
                                                   (= (ms-inst-block producer)
                                                      (ms-inst-block (load consumer))))
                                              (let [saved (load (be-inst producer))
                                                    (mut at) producer]
                                                (loop (if (<= (load at) (load consumer))
                                                          (break)
                                                          (do
                                                            (store! (be-inst (load at))
                                                                    (load (be-inst (- (load at) 1))))
                                                            (store! at (- (load at) 1)))))
                                                (store! (be-inst (load consumer)) saved)
                                                (store! moves (+ (load moves) 1))
                                                (store! changed true)
                                                (if (> (load moves) limit) (store! ok false) 0))
                                              0)
                                          (store! dep (+ (load dep) 1)))))
                              (store! consumer (+ (load consumer) 1)))))))))
    (load ok)))

(defn ms-select-built-core! [] (-> bool)
  (be-reset!)
  (let [u (machine-unit)
        funcs (mu-function-count)
        (mut owner) 0]
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (store! (field u next-vreg) 0)
    (al-clear! [i64] (field u vreg-phi-block))
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u call-args))
    (ms-map-init!)
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (ms-preallocate-phis! (load owner))
                (store! owner (+ (load owner) 1))
                0)))
    (store! owner 0)
    (loop (if (or (>= (load owner) funcs) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [base (be-inst-count)]
                  ; Establish control-rooted placement before edge copies request shared Phi
                  ; inputs. Otherwise a loop-header value first seen through its backedge copy can
                  ; be pinned to the backedge even when the branch condition consumes it in-header.
                  (ms-preselect-function! (load owner))
                  (ms-build-edge-copies! (load owner))
                  (ms-resolve-owner-copies! (load owner))
                  (ms-emit-function! (load owner) base))
                (store! owner (+ (load owner) 1))
                0)))
    (if (= (ms-result) MSEL-OK)
        (do (ms-pack-instructions!) (ms-cache-new-defs!) (ms-build-memory-anti-deps!) true)
        false)))

(defn ms-place-selected! [] (-> bool)
  (let [u (machine-unit)]
    (if (ms-gcm-place!)
        (do
          (store! (field u phase) 2)
          ; Usually GCM's stable packing is already dependency-topological, and retaining
          ; it keeps selection dumps stable. If a cross-block move put a producer after its use,
          ; repair only that case with the dependency-aware seed-0 scheduler.
          (if (ms-verify!)
              true
              (if (= (ms-result) MSEL-DEPENDENCY)
                  (if (and (ms-repair-late-memory-deps!) (ms-local-schedule! 0))
                      (ms-verify!)
                      false)
                  false)))
        false)))

(defn ms-select-built! [] (-> bool)
  (if (ms-select-built-core!) (ms-place-selected!) false))

(defn ms-select! [] (-> bool)
  (if (mu-build!) (ms-select-built!) false))
(defn ms-select-program! [] (-> bool)
  (if (mu-build-program!) (ms-select-built!) false))
(defn ms-select-entry! [(entry-fun i64)] (-> bool)
  (if (mu-build-entry! entry-fun) (ms-select-built!) false))

; Convert verified block terminators to the legacy encodable label/branch vocabulary.  This is a
; separate publication step so the block verifier continues to reason about explicit successors.
(defn ms-lowered-inst [(owner i64)
                       (bid i64)
                       (op i64)
                       (dst i64)
                       (a i64)
                       (b i64)
                       (imm i64)
                       (node i64)] (-> MInst)
  (let [p (stack MInst)]
    (store! p (mi-new op dst a b imm node))
    (store! (field p owner) owner)
    (store! (field p block-id) bid)
    (load p)))

(defn ms-lower-encodable! [] (-> bool)
  (if (not (ms-verify!))
      false
      (let [u (machine-unit)
            blocks (mu-block-count)
            (mut bid) 0]
        (al-clear! [MInst] (field u packed-insts))
        (loop (if (>= (load bid) blocks)
                  (break)
                  (do
                    (let [b (mu-block (load bid))
                          owner (load (field b owner))
                          first (load (field b inst-first))
                          count (load (field b inst-count))
                          scheduled-first (al-len [MInst] (load (field u packed-insts)))
                          (mut i) 0]
                      (store! (field b inst-first) scheduled-first)
                      (al-push! [MInst]
                                (field u packed-insts)
                                (ms-lowered-inst owner (load bid) MI-LABEL -1 -1 -1 (load bid) NO-NODE))
                      (loop (if (>= (load i) count)
                                (break)
                                (do
                                  (let [m (be-inst (+ first (load i)))
                                        op (load (field m op))]
                                    (case op MI-CBR
                                          (do
                                            (al-push! [MInst]
                                                      (field u packed-insts)
                                                      (ms-lowered-inst owner
                                                                       (load bid)
                                                                       MI-CBZ
                                                                       -1
                                                                       (load (field m a))
                                                                       -1
                                                                       (load (field m imm))
                                                                       (load (field m node))))
                                            (al-push! [MInst]
                                                      (field u packed-insts)
                                                      (ms-lowered-inst owner
                                                                       (load bid)
                                                                       MI-B
                                                                       -1
                                                                       -1
                                                                       -1
                                                                       (load (field m b))
                                                                       (load (field m node))))
                                            0)
                                            MI-JMP
                                          (al-push! [MInst]
                                                    (field u packed-insts)
                                                    (ms-lowered-inst owner
                                                                     (load bid)
                                                                     MI-B
                                                                     -1
                                                                     -1
                                                                     -1
                                                                     (load (field m imm))
                                                                     (load (field m node))))
                                            (al-push! [MInst] (field u packed-insts) (load m))))
                                  (store! i (+ (load i) 1))
                                  0)))
                      (store! (field b inst-count)
                              (- (al-len [MInst] (load (field u packed-insts))) scheduled-first)))
                    (store! bid (+ (load bid) 1))
                    0)))
        (al-clear! [MInst] (field (backend) ins))
        (let [n (al-len [MInst] (load (field u packed-insts)))
              (mut i) 0
              (mut ok) true]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [m (al-get (load (field u packed-insts)) (load i))
                            p (stack MInst)]
                        (store! p m)
                        (if (not (mi-desc-encodable? (mi-desc (load (field p op)))))
                            (store! ok false)
                            0)
                        (al-push! [MInst] (field (backend) ins) m))
                      (store! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn be-select-machine-program! [] (-> bool)
  (if (not (ms-select-program!))
      (let [code
              (case (ms-result) MSEL-CALL-LIVE
                    BER-UNSUPPORTED-CALL-LIVE MSEL-CALL
                    BER-UNSUPPORTED-CALL MSEL-UNSUPPORTED
                    BER-UNSUPPORTED-OPCODE BER-MALFORMED-GRAPH)
            item (ms-result-item)
            node
              (if (and (>= item 0) (< item (be-inst-count)))
                  (ms-inst-node item)
                  item)]
        (be-fail! code node))
      (if (ms-lower-encodable!) true (be-fail! BER-ENCODING NO-NODE))))

(defn ms-inst-owner [(i i64)] (-> i64)
  (load (field (be-inst i) owner)))
(defn ms-inst-block [(i i64)] (-> i64)
  (load (field (be-inst i) block-id)))
(defn ms-inst-op [(i i64)] (-> i64)
  (load (field (be-inst i) op)))
(defn ms-inst-dst [(i i64)] (-> i64)
  (load (field (be-inst i) dst)))
(defn ms-inst-a [(i i64)] (-> i64)
  (load (field (be-inst i) a)))
(defn ms-inst-earliest [(i i64)] (-> i64)
  (load (field (be-inst i) earliest)))
(defn ms-inst-latest [(i i64)] (-> i64)
  (load (field (be-inst i) latest)))
(defn ms-inst-node [(i i64)] (-> i64)
  (load (field (be-inst i) node)))
(defn ms-inst-memory-dep-count [(i i64)] (-> i64)
  (load (field (be-inst i) mem-count)))
(defn ms-inst-memory-dep-node [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (load (field (machine-unit) selection-memory-deps))
            (+ (load (field m mem-first)) which))))
(defn ms-inst-memory-anti-count [(i i64)] (-> i64)
  (load (field (be-inst i) anti-count)))
(defn ms-inst-memory-anti-node [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (load (field (machine-unit) memory-anti-deps))
            (+ (load (field m anti-first)) which))))
(defn ms-inst-arg-count [(i i64)] (-> i64)
  (load (field (be-inst i) arg-count)))
(defn ms-inst-arg [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (load (field (machine-unit) call-args))
            (+ (load (field m arg-first)) which))))

(defn ms-def-inst [(vreg i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) dst)) vreg)
                    (store! found (load i))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn ms-phi-vreg? [(owner i64) (vreg i64)] (-> bool)
  (>= (ms-phi-vreg-block owner vreg) 0))

(defn ms-block-dominates? [(def-bid i64) (use-bid i64)] (-> bool)
  (mu-dominates? def-bid use-bid))

(defn ms-input-valid? [(at i64) (vreg i64)] (-> bool)
  (if (< vreg 0)
      true
      (if (ms-phi-vreg? (load (field (be-inst at) owner)) vreg)
          true
          (let [def (ms-owner-def-inst (load (field (be-inst at) owner)) vreg)]
            (if (< def 0)
                (ms-phi-vreg? (load (field (be-inst at) owner)) vreg)
                (if (>= def at)
                    false
                    (let [use (be-inst at)
                          producer (be-inst def)
                          owner (load (field use owner))
                          bid (load (field use block-id))
                          def-owner (load (field producer owner))
                          def-bid (load (field producer block-id))]
                      (and (= owner def-owner)
                           (or (= def-bid (ms-entry-block owner))
                               (or (= def-bid bid) (ms-block-dominates? def-bid bid)))))))))))

(defn ms-node-inst-before [(owner i64) (node i64) (at i64)] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) at) (>= (load found) 0))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (and (= (load (field m owner)) owner) (= (load (field m node)) node))
                      (store! found (load i))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn ms-memory-node-before? [(owner i64) (node i64) (at i64)] (-> bool)
  (case (n-op node) OP-ARG
        ;; A memory argument rooted at CallEnd is the post-call heap state. It is not an
        ;; entry-like root: consumers must remain after the call that produced that state.
        (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
          (if (and (>= ctrl 0) (= (n-op ctrl) OP-CALLEND))
              (>= (ms-node-inst-before owner (n-in ctrl 1) at) 0)
              true)) OP-PARM
        true OP-PROJ
        (if (= (n-op (n-in node 0)) OP-NEW)
            (>= (ms-node-inst-before owner (n-in node 0) at) 0)
            true)
          OP-STORE
        (>= (ms-node-inst-before owner node at) 0) OP-PROPSTORE
        (>= (ms-node-inst-before owner node at) 0) OP-SETPROTO
        (>= (ms-node-inst-before owner node at) 0) OP-ARRAYSTORE
        (>= (ms-node-inst-before owner node at) 0) OP-ARRAYRESIZE
        (>= (ms-node-inst-before owner node at) 0) OP-ARRAYCOPY
        (>= (ms-node-inst-before owner node at) 0) OP-STRINGSPLIT
        (>= (ms-node-inst-before owner node at) 0) OP-NEW
        (>= (ms-node-inst-before owner node at) 0) OP-MEMMERGE
        (let [len (n-nins node)
              (mut i) 1
              (mut ok) true]
          (loop (if (or (>= (load i) len) (not (load ok)))
                    (break)
                    (do
                      (if (not (ms-memory-node-before? owner (n-in node (load i)) at))
                          (store! ok false)
                          0)
                      (store! i (+ (load i) 1))
                      0)))
          (load ok))
          OP-PHI
        (and (ty-mem? (n-ty node)) (>= (ms-phi-block owner node) 0)) false))

(defn ms-memory-node-on-incoming-edge? [(owner i64) (node i64) (at i64)] (-> bool)
  (let [consumer-block (ms-inst-block at)
        (mut producer) 0
        (mut found) false]
    (loop (if (or (>= (load producer) (be-inst-count)) (load found))
              (break)
              (do
                (let [m (be-inst (load producer))]
                  (if (and (= (load (field m owner)) owner)
                           (= (load (field m node)) node))
                      (let [(mut edge) 0]
                        (loop (if (or (>= (load edge) (mu-edge-count)) (load found))
                                  (break)
                                  (do
                                    (if (and (= (mu-edge-source (load edge))
                                                (load (field m block-id)))
                                             (= (mu-edge-target (load edge)) consumer-block))
                                        (store! found true)
                                        0)
                                    (store! edge (+ (load edge) 1))))))
                      0))
                (store! producer (+ (load producer) 1)))))
    (load found)))

(defn ms-block-reaches? [(source i64) (target i64)] (-> bool)
  (let [(mut seen) (al-new [i64] (malloc-allocator))
        blocks (mu-block-count)
        (mut i) 0
        (mut changed) true]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (al-push! [i64] (mut seen) (if (= (load i) source) 1 0))
                (store! i (+ (load i) 1)))))
    (loop (if (not (load changed))
              (break)
              (do
                (store! changed false)
                (store! i 0)
                (loop (if (>= (load i) (mu-edge-count))
                          (break)
                          (let [from (mu-edge-source (load i))
                                to (mu-edge-target (load i))]
                            (if (and (!= (al-get [i64] (load seen) from) 0)
                                     (= (al-get [i64] (load seen) to) 0))
                                (do
                                  (al-set! [i64] (mut seen) to 1)
                                  (store! changed true))
                                0)
                            (store! i (+ (load i) 1))))))))
    (let [answer (!= (al-get [i64] (load seen) target) 0)]
      (al-free! [i64] (mut seen))
      answer)))

(defn ms-memory-node-on-loop-backedge? [(owner i64) (node i64) (at i64)] (-> bool)
  (let [consumer-block (ms-inst-block at)
        (mut producer) 0
        (mut found) false]
    (loop (if (or (>= (load producer) (be-inst-count)) (load found))
              (break)
              (do
                (let [m (be-inst (load producer))
                      producer-block (load (field m block-id))]
                  (if (and (= (load (field m owner)) owner)
                           (and (= (load (field m node)) node)
                                (and (!= producer-block consumer-block)
                                     (or (= (ms-memory-block owner node) consumer-block)
                                         (and (mu-dominates? consumer-block producer-block)
                                              (ms-block-reaches? producer-block consumer-block))))))
                      (store! found true)
                      0))
                (store! producer (+ (load producer) 1)))))
    (load found)))

(defn ms-memory-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit)
        m (be-inst at)
        owner (load (field m owner))
        first (load (field m mem-first))
        count (load (field m mem-count))
        (mut i) 0
        (mut ok) true]
    (if (= count 0)
        true
        (if (or (< first 0)
                (> (+ first count) (al-len [i64] (load (field u selection-memory-deps)))))
            false
            (do
              (loop (if (or (>= (load i) count) (not (load ok)))
                        (break)
                        (do
                          (let [node
                                  (al-get (load (field u selection-memory-deps))
                                          (+ first (load i)))]
                            (if (or (ms-memory-node-before? owner node at)
                                    (or (ms-memory-node-on-incoming-edge? owner node at)
                                        (ms-memory-node-on-loop-backedge? owner node at)))
                                0
                                (store! ok false)))
                          (store! i (+ (load i) 1))
                          0)))
              (load ok))))))

(defn ms-memory-anti-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit)
        m (be-inst at)
        first (load (field m anti-first))
        count (load (field m anti-count))
        total (al-len [i64] (load (field u memory-anti-deps)))
        (mut prior) 0
        (mut seen) 0
        (mut ok) true]
    (if (= count 0)
        true
        (if (or (< first 0) (or (< count 0) (> (+ first count) total)))
            false
            (do
              (loop (if (or (>= (load prior) (be-inst-count)) (not (load ok)))
                        (break)
                        (do
                          (let [candidate (be-inst (load prior))]
                            (if (and (ms-machine-memory-write? m)
                                     (and (= (load (field candidate owner)) (load (field m owner)))
                                          (and (ms-memory-operands-may-alias? candidate m)
                                               (and (ms-machine-memory-read? candidate)
                                               (and (< (load (field candidate node)) (load (field m node)))
                                                    (mu-dominates? (load (field candidate block-id))
                                                                   (load (field m block-id))))))))
                                (do
                                  ;; Scheduling may reorder independent reads. The anti-dependency
                                  ;; vector is a set of required read nodes, not a second schedule;
                                  ;; validate membership without imposing its construction order.
                                  (let [(mut dep) 0 (mut listed) false]
                                    (loop
                                      (if (or (>= (load dep) count) (load listed))
                                          (break)
                                          (do
                                            (if (= (al-get
                                                     (load (field u memory-anti-deps))
                                                     (+ first (load dep)))
                                                   (load (field candidate node)))
                                                (store! listed true)
                                                0)
                                            (store! dep (+ (load dep) 1))
                                            0)))
                                    (if (not (load listed)) (store! ok false) 0))
                                  (store! seen (+ (load seen) 1)))
                                0))
                          (store! prior (+ (load prior) 1))
                          0)))
              (and (load ok) (= (load seen) count)))))))

(defn ms-inst-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (load (field m op))
        a (load (field m a))
        b (load (field m b))]
    (case op MI-MOVI
          true MI-FMOVI
          true MI-ARG
          true MI-JMP
          true MI-STACKARG
          true MI-ABI-COPY
          (ms-input-valid? at a) MI-NEW
          true MI-JSPROP
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-JSARRAY
          (and (and (ms-input-valid? at a) (ms-input-valid? at b))
               (ms-call-args-valid? at))
            MI-JSSTRING
          (and (and (ms-input-valid? at a) (ms-input-valid? at b))
               (ms-call-args-valid? at))
            MI-LOAD
          (ms-input-valid? at a) MI-STORE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-NEG
          (ms-input-valid? at a) MI-SCVTF
          (ms-input-valid? at a) MI-I32FROMFP
          (ms-input-valid? at a) MI-FNEG
          (ms-input-valid? at a) MI-FTRUTH
          (ms-input-valid? at a) MI-JSBOX
          (ms-input-valid? at a) MI-JSUNBOX
          (ms-input-valid? at a) MI-JSTEST
          (ms-input-valid? at a) MI-RET
          (ms-input-valid? at a) MI-CBR
          (ms-input-valid? at a) MI-ADD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SUB
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-MUL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SDIV
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-EQ
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-LT
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-LE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FADD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FSUB
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FMUL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FDIV
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FMOD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FEQ
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FLT
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FLE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-MOD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITAND
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITOR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITXOR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SHL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SHR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-USHR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITNOT
          (ms-input-valid? at a) MI-COPY
          (ms-input-valid? at a) MI-CALL
          (let [count (ms-inst-arg-count at)
                (mut i) 0
                (mut ok) true]
            (loop (if (or (>= (load i) count) (not (load ok)))
                      (break)
                      (do
                        (if (not (ms-input-valid? at (ms-inst-arg at (load i))))
                            (store! ok false)
                            0)
                        (store! i (+ (load i) 1))
                        0)))
            (load ok))
            false)))

(defn ms-call-target-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (load (field m owner))
        target (load (field m imm))
        node (load (field m node))]
    (if (>= target 0)
        (and (< target (mu-function-count))
             (= (mu-function-ideal target) (mu-direct-callee node)))
        (let [targets (^ target -1)
              expected (ty-fun-targets (n-ty (n-in node 1)))
              (mut fidx) 0
              (mut valid) (= targets expected)]
          (loop (if (or (>= (load fidx) 63) (not (load valid)))
                    (break)
                    (do
                      (if (!= (& targets (<< 1 (load fidx))) 0)
                          (let [(mut owner-index) 0
                                (mut found) false]
                            (loop (if (or (>= (load owner-index) (mu-function-count)) (load found))
                                      (break)
                                      (do
                                        (if (= (al-get (load (field (machine-unit) symbols))
                                                       (load owner-index))
                                               (load fidx))
                                            (store! found true)
                                            0)
                                        (store! owner-index (+ (load owner-index) 1)))))
                            (if (not (load found)) (store! valid false) 0))
                          0)
                      (store! fidx (+ (load fidx) 1)))))
          (load valid)))))

(defn ms-call-args-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        first (load (field m arg-first))
        count (load (field m arg-count))
        total (al-len [i64] (load (field (machine-unit) call-args)))]
    (and (>= count 0)
         (and (<= count 16)
              (and (if (= count 0) (= first -1) (>= first 0))
                   (or (= count 0) (<= (+ first count) total)))))))

(defn ms-vreg-used-after? [(owner i64) (vreg i64) (at i64)] (-> bool)
  (let [n (be-inst-count)
        (mut i) (+ at 1)
        (mut used) false]
    (loop (if (or (>= (load i) n) (load used))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (and (= (load (field m owner)) owner)
                           (or (= (load (field m a)) vreg) (= (load (field m b)) vreg)))
                      (store! used true)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load used)))

(defn ms-call-live-valid? [(at i64)] (-> bool)
  (let [call (be-inst at)
        owner (load (field call owner))
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) at) (not (load ok)))
              (break)
              (do
                (let [m (be-inst (load i))
                      dst (load (field m dst))]
                  (if (and (= (load (field m owner)) owner)
                           (and (>= dst 0) (ms-vreg-used-after? owner dst at)))
                      (store! ok false)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load ok)))

(defn ms-block-range-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        len (be-inst-count)
        owner (mu-block-owner bid)
        (mut i) 0]
    (if (or (< first 0) (or (<= count 0) (> (+ first count) len)))
        false
        (let [(mut ok) true]
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [m (be-inst (+ first (load i)))]
                        (if (or (!= (load (field m owner)) owner)
                                (!= (load (field m block-id)) bid))
                            (store! ok false)
                            0))
                      (store! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn ms-block-terminator-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        term (mu-block-terminator bid)
        succ (mu-block-succ-count bid)
        (mut i) 0
        (mut terms) 0
        (mut last-op) -1]
    (loop (if (>= (load i) count)
              (break)
              (do
                (let [op (ms-inst-op (+ first (load i)))]
                  (if (mi-op-terminator? op)
                      (do (store! terms (+ (load terms) 1)) (store! last-op op))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (and (= (load terms) 1)
         (and (mi-op-terminator? (ms-inst-op (- (+ first count) 1)))
              (if (= term NO-NODE)
                  (and (= succ 1) (= (load last-op) MI-JMP))
                  (case (n-op term) OP-IF
                        (and (= succ 2) (= (load last-op) MI-CBR)) OP-RETURN
                        (and (= succ 0) (= (load last-op) MI-RET)) false))))))

(defn ms-definition-unique? [(at i64)] (-> bool)
  (let [m (be-inst at)
        dst (load (field m dst))
        owner (load (field m owner))
        node (load (field m node))
        (mut i) 0]
    (if (or (< dst 0) (= (load (field m op)) MI-COPY))
        true
        (let [(mut defs) 0
              (mut nodes) 0]
          (loop (if (>= (load i) (be-inst-count))
                    (break)
                    (do
                      (let [other (be-inst (load i))]
                        (if (= (load (field other dst)) dst) (store! defs (+ (load defs) 1)) 0)
                        (if (and (= (load (field other owner)) owner)
                                 (and (= (load (field other node)) node)
                                      (and (>= (load (field other dst)) 0)
                                           (!= (load (field other op)) MI-LOAD))))
                            (store! nodes (+ (load nodes) 1))
                            0))
                      (store! i (+ (load i) 1))
                      0)))
          ; Materialized closure environments may reload the same logical capture at distinct call
          ; sites. Those are distinct machine definitions but intentionally share the capture node
          ; so GC kind classification remains exact.
          (and (= (load defs) 1)
               (if (or (< node 0) (= (load (field m op)) MI-LOAD))
                   true
                   (= (load nodes) 1)))))))

(defn ms-inst-membership-count [(at i64)] (-> i64)
  (let [blocks (mu-block-count)
        (mut bid) 0
        (mut count) 0]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      n (mu-block-inst-count (load bid))]
                  (if (and (>= at first) (< at (+ first n)))
                      (store! count (+ (load count) 1))
                      0))
                (store! bid (+ (load bid) 1))
                0)))
    (load count)))

(defn ms-memory-source-on-edge? [(owner i64) (node i64) (bid i64)] (-> bool)
  (let [(mut edge) 0
        (mut found) false]
    (loop (if (or (>= (load edge) (mu-edge-count)) (load found))
              (break)
              (do
                (if (and (= (load (field (mu-edge (load edge)) owner)) owner)
                         (= (mu-edge-source (load edge)) bid))
                    (let [n (mu-edge-copy-count (load edge))
                          (mut i) 0]
                      (loop (if (or (>= (load i) n) (load found))
                                (break)
                                (do
                                  (if (and (= (mu-copy-kind (load edge) (load i)) MCOPY-MEMORY)
                                           (= (mu-copy-src (load edge) (load i)) node))
                                      (store! found true)
                                      0)
                                  (store! i (+ (load i) 1))
                                  0))))
                    0)
                (store! edge (+ (load edge) 1))
                0)))
    (load found)))

(defn ms-inst-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (load (field m op))
        owner (load (field m owner))
        bid (load (field m block-id))
        node (load (field m node))]
    (case op MI-ARG
          (= bid (ms-entry-block owner)) MI-STACKARG
          (= bid (ms-entry-block owner)) MI-NEW
          ; Ideal Loads have no explicit control input, and closure-environment
          ; reloads may retain a captured Parm/Arg as logical identity. Selection
          ; derives their block from memory and pointer dependencies; GCM verifies it.
          true MI-STORE
          (or (= bid (ms-memory-block owner node))
              (ms-memory-source-on-edge? owner node bid))
            MI-JSPROP
          ; Dynamic property operations have no explicit ideal control input. Selection derives
          ; their branch block from memory order and data dependencies; GCM and dependency
          ; verification below validate that derived placement.
          true
            MI-JSSTRING
          true MI-COPY
          (= (mu-edge-source (load (field m imm))) bid) MI-CALL
          (= bid (ms-node-block owner node)) MI-JMP
          ; A fallthrough block is commonly rooted at a CProj. ms-node-block follows
          ; input 0 and therefore names the predecessor If block; the jump belongs to
          ; the block mapped by the control root itself.
          (= bid (al-get (load (field (machine-unit) ctrl-block)) node)) true)))

(defn ms-gcm-input-earliest-valid? [(owner i64) (earliest i64) (vreg i64)] (-> bool)
  (if (< vreg 0)
      true
      (let [def (ms-owner-def-inst owner vreg)
            dependency
              (if (ms-phi-vreg? owner vreg)
                  (ms-vreg-def-block owner vreg)
                  (if (>= def 0) (ms-inst-earliest def) -1))]
        (and (>= dependency 0) (mu-dominates? dependency earliest)))))

(defn ms-gcm-earliest-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (load (field m owner))
        earliest (load (field m earliest))
        inputs (mi-op-inputs (load (field m op)))
        (mut ok) true]
    (if (> inputs 0)
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m a))))
        0)
    (if (and (load ok) (> inputs 1))
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m b))))
        0)
    (if (and (load ok) (= (load (field m op)) MI-CSEL))
        (store! ok (ms-gcm-input-earliest-valid? owner earliest (load (field m imm))))
        0)
    (if (and (load ok) (> (ms-inst-arg-count at) 0))
        (let [(mut arg) 0]
          (loop (if (or (>= (load arg) (ms-inst-arg-count at)) (not (load ok)))
                    (break)
                    (do
                      (store! ok
                              (ms-gcm-input-earliest-valid? owner
                                                            earliest
                                                            (ms-inst-arg at (load arg))))
                      (store! arg (+ (load arg) 1))
                      0))))
        0)
    (load ok)))

(defn ms-gcm-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (load (field m owner))
        bid (load (field m block-id))
        earliest (load (field m earliest))
        latest (load (field m latest))
        pinned (mi-op-pinned? (load (field m op)))]
    (if (or (< earliest 0)
            (or (< latest 0)
                (or (!= (mu-block-owner earliest) owner)
                    (!= (mu-block-owner latest) owner))))
        false
        (if pinned
            (and (= bid earliest) (= bid latest))
            (let [actual-latest
                    (if (>= (load (field m dst)) 0)
                        (ms-gcm-latest-use-block owner (load (field m dst)))
                        -1)
                  expected-latest (if (< actual-latest 0) earliest actual-latest)]
              (if (or (!= latest expected-latest)
                      (or (not (ms-gcm-earliest-dependencies-valid? at))
                          (or (not (mu-dominates? earliest bid))
                              (not (mu-dominates? bid latest)))))
                  false
                  (let [(mut expected) latest
                        (mut cursor) latest]
                    (loop (if (= (load cursor) earliest)
                              (break)
                              (do
                                (store! cursor (mu-block-idom (load cursor)))
                                (if (< (mu-block-loop-depth (load cursor))
                                       (mu-block-loop-depth (load expected)))
                                    (store! expected (load cursor))
                                    0))))
                    (= bid (load expected)))))))))

(defn ms-edge-copies-valid? [(edge i64)] (-> bool)
  (let [u (machine-unit)
        e (mu-edge edge)
        first (load (field e copy-first))
        count (load (field e copy-count))
        slot (load (field e target-slot))
        target (load (field e target))
        owner (load (field e owner))
        total (al-len [MCopy] (load (field u edge-copies)))
        (mut i) 0
        (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) total)))
        false
        (do
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [c (mu-edge-copy edge (load i))
                            phi (load (field c phi))
                            kind (load (field c kind))]
                        (if (or (!= (load (field c edge)) edge)
                                (or (= phi NO-NODE)
                                    (or (!= (n-op phi) OP-PHI)
                                        (or (!= (ms-phi-block owner phi) target)
                                            (>= slot (n-nins phi))))))
                            (store! ok false)
                            (if (ty-mem? (n-ty phi))
                                (if (or (!= kind MCOPY-MEMORY)
                                        (or (!= (load (field c dst)) phi)
                                            (or (!= (load (field c src)) (n-in phi slot))
                                                (not (ms-memory-node-before? owner
                                                                             (load (field c src))
                                                                             (+ (mu-block-inst-first (load (field e
                                                                                                                  source)))
                                                                                (mu-block-inst-count (load (field e
                                                                                                                  source)))))))))
                                    (store! ok false)
                                    0)
                                (if (or (!= kind MCOPY-VALUE)
                                        (or (!= (load (field c dst)) (ms-vget owner phi))
                                            (let [src (load (field c src))
                                                  input (ms-vget owner (n-in phi slot))
                                                  def (ms-owner-def-inst owner src)]
                                              (and (!= src input)
                                                   (or (< def 0)
                                                       (or (!= (ms-inst-op def) MI-SCVTF)
                                                           (!= (ms-inst-a def) input)))))))
                                    (store! ok false)
                                    0))))
                      (store! i (+ (load i) 1))
                      0)))
          ; Every live Phi attached to the target has exactly one record on this edge.
          (let [(mut node) 0]
            (loop (if (or (>= (load node) (n-count)) (not (load ok)))
                      (break)
                      (do
                        (if (and (not (n-dead? (load node)))
                                 (and (= (n-op (load node)) OP-PHI)
                                      (= (ms-phi-block owner (load node)) target)))
                            (let [(mut j) 0
                                  (mut matches) 0]
                              (loop (if (>= (load j) count)
                                        (break)
                                        (do
                                          (if (= (load (field (mu-edge-copy edge (load j)) phi)) (load node))
                                              (store! matches (+ (load matches) 1))
                                              0)
                                          (store! j (+ (load j) 1))
                                          0)))
                              (if (!= (load matches) 1) (store! ok false) 0))
                            0)
                        (store! node (+ (load node) 1))
                        0))))
          (load ok)))))

(defn ms-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        len (be-inst-count)
        (mut bid) 0
        (mut edge) 0
        (mut at) 0]
    (store! (field u selection-result) MSEL-OK)
    (store! (field u selection-item) -1)
    (loop (if (or (>= (load bid) blocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (not (ms-block-range-valid? (load bid)))
                    (ms-fail! MSEL-OWNER (load bid))
                    (if (not (ms-block-terminator-valid? (load bid)))
                        (ms-fail! MSEL-TERMINATOR (load bid))
                        0))
                (store! bid (+ (load bid) 1))
                0)))
    (loop (if (or (>= (load edge) edges) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (not (ms-edge-copies-valid? (load edge)))
                    (ms-fail! MSEL-PHI (load edge))
                    0)
                (store! edge (+ (load edge) 1))
                0)))
    (loop (if (or (>= (load at) len) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [op (ms-inst-op (load at))
                      membership (ms-inst-membership-count (load at))
                      placement (ms-inst-placement-valid? (load at))]
                  (if (or (!= membership 1) (not placement))
                      (ms-fail! MSEL-OWNER (load at))
                      (do
                        (if (not (ms-gcm-placement-valid? (load at)))
                            (ms-fail! MSEL-PLACEMENT (load at))
                            0)
                        (if (and (= (ms-result) MSEL-OK)
                                 (not (ms-memory-anti-dependencies-valid? (load at))))
                            (ms-fail! MSEL-MEMORY-ORDER (load at))
                            0)
                        (if (and (= op MI-CALL) (not (ms-call-target-valid? (load at))))
                            (ms-fail! MSEL-CALL (load at))
                            0)
                        (if (and (= (ms-result) MSEL-OK)
                                 (and (> (ms-inst-arg-count (load at)) 0)
                                      (not (ms-call-args-valid? (load at)))))
                            (ms-fail! MSEL-CALL (load at))
                            0)
                        (if (!= (ms-result) MSEL-OK)
                            0
                            ; Keep the descriptor aggregate inside a scalar wrapper. Constructing
                            ; it directly in this whole-program loop consumes dynamic stack space
                            ; in Coil and eventually corrupts large-program verification.
                            (if (< (mi-op-inputs op) 0)
                                (ms-fail! MSEL-UNSUPPORTED (load at))
                                (if (or (not (ms-inst-dependencies-valid? (load at)))
                                        (not (ms-memory-dependencies-valid? (load at))))
                                    (ms-fail! MSEL-DEPENDENCY (load at))
                                    (if (not (ms-definition-unique? (load at)))
                                        (ms-fail! MSEL-DUPLICATE (load at))
                                        0)))))))
                (store! at (+ (load at) 1))
                0)))
    (= (ms-result) MSEL-OK)))

(defn ms-corrupt-owner! [(at i64) (owner i64)] (-> i64)
  (store! (field (be-inst at) owner) owner)
  0)
(defn ms-corrupt-input! [(at i64) (vreg i64)] (-> i64)
  (store! (field (be-inst at) a) vreg)
  0)
(defn ms-corrupt-memory-dep! [(at i64) (node i64)] (-> i64)
  (let [u (machine-unit)
        m (be-inst at)
        first (load (field m mem-first))]
    (if (< first 0) 0 (al-set! [i64] (field u selection-memory-deps) first node))
    0))
(defn ms-corrupt-placement! [(at i64) (bid i64)] (-> i64)
  (store! (field (be-inst at) block-id) bid)
  (ms-pack-instructions!)
  0)
(defn ms-corrupt-earliest! [(at i64) (bid i64)] (-> i64)
  (store! (field (be-inst at) earliest) bid)
  0)
(defn ms-corrupt-memory-anti-dep! [(at i64) (node i64)] (-> i64)
  (let [m (be-inst at)
        first (load (field m anti-first))]
    (if (> (load (field m anti-count)) 0)
        (al-set! [i64] (field (machine-unit) memory-anti-deps) first node)
        0)
    0))
(defn ms-corrupt-duplicate-terminator! [(bid i64)] (-> i64)
  (let [b (mu-block bid)
        last (+ (load (field b inst-first)) (- (load (field b inst-count)) 1))
        copy (load (be-inst last))]
    (ms-emit! (mu-block-owner bid) bid copy)
    (store! (field b inst-count) (+ (load (field b inst-count)) 1))
    0))
(defn ms-corrupt-copy-source! [(edge i64) (which i64) (src i64)] (-> i64)
  (store! (field (mu-edge-copy edge which) src) src)
  0)
(defn ms-corrupt-copy-phi! [(edge i64) (which i64) (phi i64)] (-> i64)
  (store! (field (mu-edge-copy edge which) phi) phi)
  0)
(defn ms-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (store! (field (be-inst at) imm) target)
  0)
(defn ms-corrupt-call-arg! [(at i64) (which i64) (vreg i64)] (-> i64)
  (let [m (be-inst at)
        first (load (field m arg-first))]
    (if (or (< which 0) (>= which (load (field m arg-count))))
        0
        (al-set! [i64] (field (machine-unit) call-args) (+ first which) vreg))
    0))

(defn mi-op-name [(op i64)] (-> (slice u8))
  (case op MI-MOVI
        "MOVI" MI-ADD
        "ADD" MI-SUB
        "SUB" MI-MUL
        "MUL" MI-SDIV
        "SDIV" MI-NEG
        "NEG" MI-RET
        "RET" MI-ARG
        "ARG" MI-EQ
        "EQ" MI-LT
        "LT" MI-LE
        "LE" MI-LABEL
        "LABEL" MI-CBZ
        "CBZ" MI-CSEL
        "CSEL" MI-MOV
        "MOV" MI-B
        "B" MI-NEW
        "NEW" MI-LOAD
        "LOAD" MI-STORE
        "STORE" MI-CBR
        "CBR" MI-JMP
        "JMP" MI-COPY
        "COPY" MI-CALL
        "CALL" MI-ABI-COPY
        "ABI-COPY" MI-FMOVI
        "FMOVI" MI-SCVTF
        "SCVTF" MI-FADD
        "FADD" MI-FSUB
        "FSUB" MI-FMUL
        "FMUL" MI-FDIV
        "FDIV" MI-FNEG
        "FNEG" MI-FEQ
        "FEQ" MI-FLT
        "FLT" MI-FLE
        "FLE" MI-FTRUTH
        "FTRUTH" MI-MOD
        "MOD" MI-BITAND
        "BITAND" MI-BITOR
        "BITOR" MI-BITXOR
        "BITXOR" MI-SHL
        "SHL" MI-SHR
        "SHR" MI-USHR
        "USHR" MI-BITNOT
        "BITNOT" MI-I32FROMFP
        "I32FROMFP" MI-FMOD
        "FMOD" MI-JSPROP
        "JSPROP" MI-JSARRAY
        "JSARRAY" MI-JSSTRING
        "JSSTRING" "?"))

(defn ms-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [nblocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) nblocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))
                                    first (mu-block-inst-first bid)
                                    n (mu-block-inst-count bid)
                                    (mut i) 0]
                                (fmt w "  b{d}:" (load rpo))
                                (loop (if (>= (load i) n)
                                          (break)
                                          (do
                                            (ps w " ")
                                            (ps w (mi-op-name (ms-inst-op (+ first (load i)))))
                                            (store! i (+ (load i) 1))
                                            0)))
                                (ps w "\n"))
                              (store! rpo (+ (load rpo) 1))
                              0))))
                (store! owner (+ (load owner) 1))
                0)))
    0))

(defn ms-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf)
        w (stack Writer)]
    (store! (field fb data) buf)
    (store! (field fb cap) cap)
    (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (ms-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "ms-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn be-stackmap-count [] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (load (field (be-inst (load i)) op)) MI-NEW)
                    (store! count (+ (load count) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load count)))

(defn be-stackmap-pc [(which i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut seen) 0
        (mut pc) -1]
    (loop (if (or (>= (load i) n) (>= (load pc) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) op)) MI-NEW)
                    (if (= (load seen) which)
                        (store! pc (load (field (be-inst (load i)) first)))
                        (store! seen (+ (load seen) 1)))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load pc)))

(defn be-stackmap-live-count [(which i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut seen) 0
        (mut safepoint) -1
        (mut count) 0]
    ; `MInst.first` becomes an encoded byte offset after be-encode!, while `last` remains a
    ; scheduled instruction index. Find the allocation in that latter domain instead of comparing
    ; byte PCs with liveness indices.
    (loop (if (or (>= (load i) n) (>= (load safepoint) 0))
              (break)
              (do
                (if (= (load (field (be-inst (load i)) op)) MI-NEW)
                    (if (= (load seen) which)
                        (store! safepoint (load i))
                        (store! seen (+ (load seen) 1)))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (and (>= (load safepoint) 0)
                           (and (>= (load (field m dst)) 0)
                                (and (<= (load i) (load safepoint))
                                     (>= (load (field m last)) (load safepoint)))))
                      (store! count (+ (load count) 1))
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load count)))

; ---------------------------------------------------------------------------
; G6 CFG liveness over the final scheduled machine code.
; ---------------------------------------------------------------------------

(defn ml-vreg-count [] (-> i64)
  (load (field (machine-unit) next-vreg)))
(defn ml-index [(bid i64) (vreg i64)] (-> i64)
  (+ (* bid (ml-vreg-count)) vreg))
(defn ml-edge-index [(edge i64) (vreg i64)] (-> i64)
  (+ (* edge (ml-vreg-count)) vreg))
(defn ml-use? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-use)) (ml-index bid vreg)) 0))
(defn ml-def? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-def)) (ml-index bid vreg)) 0))
(defn ml-live-in? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-in)) (ml-index bid vreg)) 0))
(defn ml-live-out? [(bid i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) live-out)) (ml-index bid vreg)) 0))
(defn ml-edge-live? [(edge i64) (vreg i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) edge-live)) (ml-edge-index edge vreg)) 0))
(defn ml-value-kind [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) value-kind)) vreg))
(defn ml-register-class [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) register-class)) vreg))
(defn ml-result [] (-> i64)
  (load (field (machine-unit) liveness-result)))
(defn ml-result-item [] (-> i64)
  (load (field (machine-unit) liveness-item)))
(defn ml-seed [] (-> i64)
  (load (field (machine-unit) liveness-seed)))
(defn ml-rounds [] (-> i64)
  (load (field (machine-unit) liveness-rounds)))

(defn ml-kind-for-type [(t i64)] (-> i64)
  (let [kinds (ty-kinds t)
        nonmoving (| VK-STR (| VK-SYM (| VK-BIG VK-FUN)))]
    (if (ty-only-obj? t)
        MLK-RAW-MANAGED
        (if (and (!= kinds 0) (= (& kinds (bits-dual nonmoving VK-MASK)) 0))
            MLK-NONMOVING
            (if (!= (& kinds VK-OBJ) 0) MLK-BOXED MLK-SCALAR)))))

;; Parm lattice types describe JavaScript values, not necessarily their machine representation.
;; In particular, receiver-aware calls intentionally pass typed object receivers as raw pointers;
;; several raw receiver shapes can meet to `dyn`. Derive the root kind from the actual incoming
;; call operands so a moving collection never interprets that raw pointer as an already-tagged word.
(defn ml-kind-for-source-representation [(node i64)] (-> i64)
  (let [(mut current) node (mut fuel) 64]
    (loop (if (or (<= (load fuel) 0) (!= (n-op (load current)) OP-CAST))
              (break)
              (do
                (store! current (n-in (load current) 1))
                (store! fuel (- (load fuel) 1))
                0)))
    (if (= (n-op (load current)) OP-CALL)
        ;; Call nodes deliberately retain the open `dyn` lattice type, but their native return ABI
        ;; is a closed-world property of the target set. Publish that representation to liveness
        ;; and stack maps so a raw managed result held across another safepoint is relocated as a
        ;; pointer instead of being mistaken for an already-tagged JavaScript word.
        (let [kind (be-call-return-kind (load current))]
          (if (>= kind 0) kind (ml-kind-for-type (n-ty (load current)))))
    (if (or (= (n-op (load current)) OP-ADD)
            (or (= (n-op (load current)) OP-SUB)
                (or (= (n-op (load current)) OP-MUL)
                    (or (= (n-op (load current)) OP-DIV)
                        (or (= (n-op (load current)) OP-MOD)
                            (or (= (n-op (load current)) OP-EQ)
                                (or (= (n-op (load current)) OP-LT)
                                    (or (= (n-op (load current)) OP-LE)
                                        (or (= (n-op (load current)) OP-BITAND)
                                            (or (= (n-op (load current)) OP-BITOR)
                                                (or (= (n-op (load current)) OP-BITXOR)
                                                    (or (= (n-op (load current)) OP-SHL)
                                                        (or (= (n-op (load current)) OP-SHR)
                                                            (or (= (n-op (load current)) OP-USHR)
                                                                (= (n-op (load current)) OP-BITNOT)))))))))))))))
        ;; These nodes always select to an unboxed GPR/FPR result even when a dynamic input makes
        ;; their lattice type broad. In particular, recursive numeric calls must not turn an
        ;; enclosing arithmetic result into the boxed return ABI merely because its type is dyn.
        MLK-SCALAR
        (if (ml-raw-nullable-value? (load current) 32)
        MLK-RAW-MANAGED
        (if (= (n-op (load current)) OP-BOX)
        MLK-BOXED
        (ml-kind-for-type (n-ty (load current)))))))))

(defn ml-raw-nullable-value? [(node i64) (fuel i64)] (-> bool)
  (if (or (<= fuel 0) (or (= node NO-NODE) (n-dead? node)))
      false
      (if (= (n-op node) OP-PHI)
          (let [kinds (ty-kinds (n-ty node))]
            (if (= kinds (| VK-NULL VK-OBJ))
                true
                (let [(mut i) 1 (mut saw-null) false (mut saw-raw) false (mut ok) true]
            (loop (if (or (>= (load i) (n-nins node)) (not (load ok)))
                      (break)
                      (let [value (n-in node (load i))]
                        (if (= value node)
                            0
                            (if (= (ty-kinds (n-ty value)) VK-NULL)
                                (store! saw-null true)
                                (if (or (ty-only-obj? (n-ty value))
                                        (ml-raw-nullable-value? value (- fuel 1)))
                                    (store! saw-raw true)
                                    (store! ok false))))
                        (store! i (+ (load i) 1)))))
                  (and (load ok) (and (load saw-null) (load saw-raw))))))
          false)))

(defn ml-kind-for-parm-representation [(parm i64)] (-> i64)
  (let [fun (n-in parm 0)
        fidx (n-aux fun)
        idx (n-aux parm)
        lim (n-count)
        (mut call) 0
        (mut answer) -1
        (mut consistent) true]
    (loop (if (or (>= (load call) lim) (not (load consistent)))
              (break)
              (do
                (if (or (n-dead? (load call)) (!= (n-op (load call)) OP-CALL))
                    0
                    (if (= (& (infer-call-targets (load call)) (<< 1 fidx)) 0)
                        0
                        (let [source (infer-parm-source (load call) fun idx)]
                          (if (= source NO-NODE)
                              0
                              (let [kind (ml-kind-for-source-representation source)]
                                (if (< (load answer) 0)
                                    (store! answer kind)
                                    (if (!= (load answer) kind)
                                        (store! consistent false)
                                        0)))))))
                (store! call (+ (load call) 1))
                0)))
    (if (and (load consistent) (>= (load answer) 0))
        (load answer)
        (ml-kind-for-type (n-ty parm)))))

(defn ml-kind-for-node [(node i64)] (-> i64)
  (if (= (n-op node) OP-PARM)
      (ml-kind-for-parm-representation node)
      (ml-kind-for-source-representation node)))

(defn ml-kind-for-vreg [(vreg i64)] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0
        (mut found) MLK-SCALAR
        (mut done) false]
    (loop (if (or (>= (load owner) funcs) (load done))
              (break)
              (do
                (let [(mut node) 0]
                  (loop (if (or (>= (load node) (n-count)) (load done))
                            (break)
                            (do
                              (if (and (not (n-dead? (load node)))
                                       (= (ms-vget (load owner) (load node)) vreg))
                                  (do
                                    (store! found (ml-kind-for-node (load node)))
                                    (store! done true))
                                  0)
                              (store! node (+ (load node) 1))
                              0))))
                (store! owner (+ (load owner) 1))
                0)))
    (load found)))

(defn ml-kind-for-inst [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (load (field m op))
        node (load (field m node))
        dst (load (field m dst))]
    (if (= (ml-class-for-inst at) MRC-FPR)
        MLK-SCALAR
        (if (= op MI-NEW)
            MLK-RAW-MANAGED
            (if (and (or (= op MI-COPY) (= op MI-ABI-COPY)) (>= dst 0))
                (ml-kind-for-vreg dst)
                (if (or (< node 0) (>= node (n-count)))
                    MLK-SCALAR
                    (ml-kind-for-node node)))))))

(defn ml-fp-producing-op? [(op i64)] (-> bool)
  (or (or (= op MI-FMOVI) (= op MI-SCVTF))
      (or (or (= op MI-FADD) (= op MI-FSUB))
          (or (or (= op MI-FMUL) (= op MI-FDIV))
              (or (= op MI-FNEG) (= op MI-FMOD))))))

(defn ml-class-for-inst [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (load (field m op))
        a (load (field m a))
        node (load (field m node))]
    (if (or (= op MI-FTRUTH) (= op MI-I32FROMFP))
        MRC-GPR
        (if (ml-fp-producing-op? op)
            MRC-FPR
            (if (and (or (= op MI-COPY) (= op MI-ABI-COPY)) (>= a 0))
                (ml-register-class a)
                (if (and (>= node 0) (and (< node (n-count)) (be-node-fp-value? node)))
                    MRC-FPR
                    MRC-GPR))))))

(defn ml-vreg-class-is? [(vreg i64) (class i64)] (-> bool)
  (or (< vreg 0) (= (ml-register-class vreg) class)))

(defn ml-inst-classes-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (load (field m op))
        dst (load (field m dst))
        a (load (field m a))
        b (load (field m b))]
    (case op MI-SCVTF
          (and (ml-vreg-class-is? a MRC-GPR) (ml-vreg-class-is? dst MRC-FPR)) MI-I32FROMFP
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FADD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FSUB
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMUL
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FDIV
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMOD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FNEG
          (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? dst MRC-FPR)) MI-FEQ
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLT
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLE
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FTRUTH
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-MOD
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITAND
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITXOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHL
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-USHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITNOT
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-COPY
          (= (ml-register-class dst) (ml-register-class a)) MI-ABI-COPY
          (= (ml-register-class dst) (ml-register-class a)) true)))

(defn ml-inst-uses? [(at i64) (vreg i64)] (-> bool)
  (ms-inst-uses-vreg? at vreg))

(defn ml-init-tables! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut i) 0]
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (al-clear! [i64] (field u value-kind))
    (al-clear! [i64] (field u register-class))
    (loop (if (>= (load i) (* blocks vregs))
              (break)
              (do
                (al-push! [i64] (field u live-use) 0)
                (al-push! [i64] (field u live-def) 0)
                (al-push! [i64] (field u live-in) 0)
                (al-push! [i64] (field u live-out) 0)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) (* edges vregs))
              (break)
              (do
                (al-push! [i64] (field u edge-live) 0)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u value-kind) MLK-SCALAR)
                (al-push! [i64] (field u register-class) MRC-GPR)
                (store! i (+ (load i) 1))
                0)))
    0))

(defn ml-compute-use-def! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) 0]
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (load (field m dst))
                                    (mut vr) 0]
                                (loop (if (>= (load vr) vregs)
                                          (break)
                                          (do
                                            (if (and (ml-inst-uses? at (load vr))
                                                     (not (ml-def? (load bid) (load vr))))
                                                (al-set! [i64]
                                                         (field u live-use)
                                                         (ml-index (load bid) (load vr))
                                                         1)
                                                0)
                                            (store! vr (+ (load vr) 1))
                                            0)))
                                (if (>= dst 0)
                                    (do
                                      (al-set! [i64] (field u live-def) (ml-index (load bid) dst) 1)
                                      (al-set! [i64] (field u value-kind) dst (ml-kind-for-inst at))
                                      (al-set! [i64] (field u register-class) dst (ml-class-for-inst at)))
                                    0))
                              (store! i (+ (load i) 1))
                              0))))
                (store! bid (+ (load bid) 1))
                0)))
    0))

;; Phi resolution can place a synthetic copy before the instruction that defines its source.
;; Seed all explicit definitions first, then propagate classes through copies to a fixed point so
;; class publication is independent of scheduled instruction order.
(defn ml-propagate-register-classes! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        (mut changed) true
        (mut rounds) 0]
    (loop (if (or (not (load changed)) (> (load rounds) n))
              (break)
              (do
                (store! changed false)
                (let [(mut at) 0]
                  (loop (if (>= (load at) n)
                            (break)
                            (do
                              (let [m (be-inst (load at))
                                    op (load (field m op))
                                    dst (load (field m dst))
                                    src (load (field m a))]
                                (if (and (or (= op MI-COPY) (= op MI-ABI-COPY))
                                         (and (>= dst 0) (>= src 0)))
                                    (let [class (al-get (load (field u register-class)) src)]
                                      (if (!= (al-get (load (field u register-class)) dst) class)
                                          (do
                                            (al-set! [i64] (field u register-class) dst class)
                                            (store! changed true))
                                          0))
                                    0))
                              (store! at (+ (load at) 1))
                              0))))
                (store! rounds (+ (load rounds) 1))
                0)))
    (load rounds)))

(defn ml-solve! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut changed) true
        (mut rounds) 0]
    (loop (if (or (not (load changed)) (> (load rounds) (+ (* blocks vregs) 1)))
              (break)
              (do
                (store! changed false)
                (let [(mut pos) 0]
                  (loop (if (>= (load pos) blocks)
                            (break)
                            (do
                              (let [bid
                                      (if (= (& seed 1) 0)
                                          (- blocks (+ (load pos) 1))
                                          (load pos))
                                    (mut vr) 0]
                                (loop (if (>= (load vr) vregs)
                                          (break)
                                          (do
                                            (let [(mut s) 0
                                                  (mut out) false]
                                              (loop (if (>= (load s) (mu-block-succ-count bid))
                                                        (break)
                                                        (do
                                                          (if (ml-live-in? (mu-block-succ-target bid (load s))
                                                                           (load vr))
                                                              (store! out true)
                                                              0)
                                                          (store! s (+ (load s) 1))
                                                          0)))
                                              (let [in
                                                      (or (ml-use? bid (load vr))
                                                          (and (load out) (not (ml-def? bid (load vr)))))
                                                    idx (ml-index bid (load vr))]
                                                (if (!= (al-get (load (field u live-out)) idx)
                                                        (if (load out) 1 0))
                                                    (do
                                                      (al-set! [i64]
                                                               (field u live-out)
                                                               idx
                                                               (if (load out) 1 0))
                                                      (store! changed true))
                                                    0)
                                                (if (!= (al-get (load (field u live-in)) idx) (if in 1 0))
                                                    (do
                                                      (al-set! [i64] (field u live-in) idx (if in 1 0))
                                                      (store! changed true))
                                                    0)))
                                            (store! vr (+ (load vr) 1))
                                            0))))
                              (store! pos (+ (load pos) 1))
                              0))))
                (store! rounds (+ (load rounds) 1))
                0)))
    (store! (field u liveness-rounds) (load rounds))
    (not (load changed))))

(defn ml-compute-edge-live! [] (-> i64)
  (let [u (machine-unit)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut edge) 0]
    (loop (if (>= (load edge) edges)
              (break)
              (do
                (let [target (mu-edge-target (load edge))
                      (mut vr) 0]
                  (loop (if (>= (load vr) vregs)
                            (break)
                            (do
                              (let [(mut live) (ml-live-in? target (load vr))
                                    (mut is-dst) false
                                    (mut is-src) false
                                    (mut i) 0]
                                (loop (if (>= (load i) (mu-edge-copy-count (load edge)))
                                          (break)
                                          (do
                                            (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                                (do
                                                  (if (= (mu-copy-dst (load edge) (load i)) (load vr))
                                                      (store! is-dst true)
                                                      0)
                                                  (if (= (mu-copy-src (load edge) (load i)) (load vr))
                                                      (store! is-src true)
                                                      0))
                                                0)
                                            (store! i (+ (load i) 1))
                                            0)))
                                (if (load is-dst) (store! live false) 0)
                                (if (load is-src) (store! live true) 0)
                                (al-set! [i64]
                                         (field u edge-live)
                                         (ml-edge-index (load edge) (load vr))
                                         (if (load live) 1 0)))
                              (store! vr (+ (load vr) 1))
                              0))))
                (store! edge (+ (load edge) 1))
                0)))
    0))

(defn ml-live-before? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (store! i (- (load i) 1))
                (let [current (+ first (load i))
                      dst (ms-inst-dst (+ first (load i)))]
                  (if (= dst vreg) (store! live false) 0)
                  (if (ml-inst-uses? current vreg) (store! live true) 0))
                (if (= (+ first (load i)) at) (break) 0))))
    (load live)))

(defn ml-live-after? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (store! i (- (load i) 1))
                (let [current (+ first (load i))]
                  (if (= current at) (break) 0)
                  (if (= (ms-inst-dst current) vreg) (store! live false) 0)
                  (if (ml-inst-uses? current vreg) (store! live true) 0)))))
    (load live)))

(defn ml-safepoint? [(at i64)] (-> bool)
  (let [op (ms-inst-op at)] (or (= op MI-CALL) (= op MI-NEW))))

(defn ml-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut bid) 0]
    (store! (field u liveness-result) MLIVE-OK)
    (store! (field u liveness-item) -1)
    ; Re-derive use/def and the fixed-point equations without mutating the published sets.
    (loop (if (or (>= (load bid) blocks) (!= (ml-result) MLIVE-OK))
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut vr) 0]
                  (loop (if (or (>= (load vr) vregs) (!= (ml-result) MLIVE-OK))
                            (break)
                            (do
                              (let [(mut i) 0
                                    (mut expected-use) false
                                    (mut expected-def) false
                                    (mut expected-out) false]
                                (loop (if (>= (load i) count)
                                          (break)
                                          (do
                                            (let [at (+ first (load i))]
                                              (if (and (ml-inst-uses? at (load vr)) (not (load expected-def)))
                                                  (store! expected-use true)
                                                  0)
                                              (if (= (ms-inst-dst at) (load vr)) (store! expected-def true) 0))
                                            (store! i (+ (load i) 1))
                                            0)))
                                (store! i 0)
                                (loop (if (>= (load i) (mu-block-succ-count (load bid)))
                                          (break)
                                          (do
                                            (if (ml-live-in? (mu-block-succ-target (load bid) (load i)) (load vr))
                                                (store! expected-out true)
                                                0)
                                            (store! i (+ (load i) 1))
                                            0)))
                                (let [expected-in
                                        (or (load expected-use)
                                            (and (load expected-out) (not (load expected-def))))]
                                  (if (or (!= (ml-use? (load bid) (load vr)) (load expected-use))
                                          (or (!= (ml-def? (load bid) (load vr)) (load expected-def))
                                              (or (!= (ml-live-out? (load bid) (load vr)) (load expected-out))
                                                  (!= (ml-live-in? (load bid) (load vr)) expected-in))))
                                      (do
                                        (store! (field u liveness-result) MLIVE-FIXPOINT)
                                        (store! (field u liveness-item)
                                                (ml-index (load bid) (load vr))))
                                      0)))
                              (store! vr (+ (load vr) 1))
                              0))))
                (store! bid (+ (load bid) 1))
                0)))
    (if (= (ml-result) MLIVE-OK)
        (let [(mut edge) 0]
          (loop (if (or (>= (load edge) edges) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [(mut vr) 0]
                        (loop (if (>= (load vr) vregs)
                                  (break)
                                  (do
                                    (let [(mut expected) (ml-live-in? (mu-edge-target (load edge)) (load vr))
                                          (mut dst) false
                                          (mut src) false
                                          (mut i) 0]
                                      (loop (if (>= (load i) (mu-edge-copy-count (load edge)))
                                                (break)
                                                (do
                                                  (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                                      (do
                                                        (if (= (mu-copy-dst (load edge) (load i)) (load vr))
                                                            (store! dst true)
                                                            0)
                                                        (if (= (mu-copy-src (load edge) (load i)) (load vr))
                                                            (store! src true)
                                                            0))
                                                      0)
                                                  (store! i (+ (load i) 1))
                                                  0)))
                                      (if (load dst) (store! expected false) 0)
                                      (if (load src) (store! expected true) 0)
                                      (if (!= (ml-edge-live? (load edge) (load vr)) (load expected))
                                          (do
                                            (store! (field u liveness-result) MLIVE-PHI)
                                            (store! (field u liveness-item)
                                                    (ml-edge-index (load edge) (load vr))))
                                          0))
                                    (store! vr (+ (load vr) 1))
                                    0))))
                      (store! edge (+ (load edge) 1))
                      0))))
        0)
    (if (= (ml-result) MLIVE-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [dst (ms-inst-dst (load at))]
                        (if (and (>= dst 0) (!= (ml-value-kind dst) (ml-kind-for-inst (load at))))
                            (do
                              (store! (field u liveness-result) MLIVE-KIND)
                              (store! (field u liveness-item) dst))
                            0)
                        (if (and (and (>= dst 0) (= (ml-result) MLIVE-OK))
                                 (!= (ml-register-class dst) (ml-class-for-inst (load at))))
                            (do
                              (store! (field u liveness-result) MLIVE-CLASS)
                              (store! (field u liveness-item) dst))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ml-inst-classes-valid? (load at))))
                            (do
                              (store! (field u liveness-result) MLIVE-CLASS)
                              (store! (field u liveness-item) (load at)))
                            0))
                      (store! at (+ (load at) 1))
                      0))))
        0)
    (= (ml-result) MLIVE-OK)))

(defn ml-compute! [(seed i64)] (-> bool)
  (let [u (machine-unit)]
    (store! (field u liveness-seed) seed)
    (ml-init-tables!)
    (ml-compute-use-def!)
    (ml-propagate-register-classes!)
    (if (not (ml-solve! seed))
        (do
          (store! (field u liveness-result) MLIVE-FIXPOINT)
          (store! (field u liveness-item) -1)
          false)
        (do (ml-compute-edge-live!) (ml-verify!)))))

(defn ml-corrupt-live-out! [(bid i64) (vreg i64) (live bool)] (-> i64)
  (al-set! [i64] (field (machine-unit) live-out) (ml-index bid vreg) (if live 1 0))
  0)
(defn ml-corrupt-edge-live! [(edge i64) (vreg i64) (live bool)] (-> i64)
  (al-set! [i64] (field (machine-unit) edge-live) (ml-edge-index edge vreg) (if live 1 0))
  0)
(defn ml-corrupt-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) value-kind) vreg kind)
  0)
(defn ml-corrupt-register-class! [(vreg i64) (class i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) register-class) vreg class)
  0)

(defn ml-dump-set [(w (ptr Writer)) (kind i64) (id i64)] (-> i64)
  (let [vregs (ml-vreg-count)
        (mut vr) 0
        (mut first) true]
    (ps w "{")
    (loop (if (>= (load vr) vregs)
              (break)
              (do
                (let [live
                        (case kind 0
                              (ml-use? id (load vr)) 1
                              (ml-def? id (load vr)) 2
                              (ml-live-in? id (load vr)) 3
                              (ml-live-out? id (load vr)) (ml-edge-live? id (load vr)))]
                  (if live
                      (do
                        (if (load first) 0 (ps w ","))
                        (fmt w "v{d}" (load vr))
                        (store! first false))
                      0))
                (store! vr (+ (load vr) 1))
                0)))
    (ps w "}")
    0))

(defn ml-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [blocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) blocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))]
                                (fmt w "  b{d} use" (load rpo))
                                (ml-dump-set w 0 bid)
                                (ps w " def")
                                (ml-dump-set w 1 bid)
                                (ps w " in")
                                (ml-dump-set w 2 bid)
                                (ps w " out")
                                (ml-dump-set w 3 bid)
                                (ps w "\n"))
                              (store! rpo (+ (load rpo) 1))
                              0))))
                (store! owner (+ (load owner) 1))
                0)))
    (let [edges (mu-edge-count)
          (mut edge) 0]
      (loop (if (>= (load edge) edges)
                (break)
                (do
                  (fmt w
                       "edge {d} {d}->{d} live"
                       (load edge)
                       (mu-edge-source (load edge))
                       (mu-edge-target (load edge)))
                  (ml-dump-set w 4 (load edge))
                  (ps w "\n")
                  (store! edge (+ (load edge) 1))
                  0))))
    0))

(defn ml-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (stack FixBuf)
        w (stack Writer)]
    (store! (field fb data) buf)
    (store! (field fb cap) cap)
    (store! (field fb len) 0)
    (fixed-buffer-writer w fb)
    (ml-dump w)
    (let [n (load (field fb len))]
      (if (>= n cap) (do (panic-corrupt "ml-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn be-note-call-arg-uses! [(at i64) (n i64)] (-> i64)
  (let [m (be-inst at)
        argc (load (field m arg-count))
        (mut argi) 0]
    (loop (if (>= (load argi) argc)
              (break)
              (do
                (let [vr (ms-inst-arg at (load argi))
                      (mut k) 0]
                  (loop (if (>= (load k) n)
                            (break)
                            (do
                              (if (= (load (field (be-inst (load k)) dst)) vr)
                                  (store! (field (be-inst (load k)) last) at)
                                  0)
                              (store! k (+ (load k) 1))
                              0))))
                (store! argi (+ (load argi) 1))
                0)))
    0))

(defn ms-schedule-result [] (-> i64)
  (load (field (machine-unit) schedule-result)))
(defn ms-schedule-item [] (-> i64)
  (load (field (machine-unit) schedule-item)))
(defn ms-schedule-seed [] (-> i64)
  (load (field (machine-unit) schedule-seed)))

(defn ms-schedule-memory-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (load (field m mem-first))
        count (load (field m mem-count))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (if (= (al-get (load (field (machine-unit) selection-memory-deps))
                               (+ first (load i)))
                       node)
                    (store! found true)
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

;; Memory roots created after a call name CallEnd rather than the call node directly. Resolve
;; that anchor here so local scheduling sees the call -> heap-read edge even when value demand
;; selected the read first.
(defn ms-schedule-post-call-memory-dep? [(consumer i64) (producer-node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (load (field m mem-first))
        count (load (field m mem-count))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (let [memory
                        (al-get (load (field (machine-unit) selection-memory-deps))
                                (+ first (load i)))
                      ctrl (if (and (>= memory 0)
                                    (and (= (n-op memory) OP-ARG)
                                         (> (n-nins memory) 0)))
                               (n-in memory 0)
                               NO-NODE)]
                  (if (and (>= ctrl 0)
                           (and (= (n-op ctrl) OP-CALLEND)
                                (= (n-in ctrl 1) producer-node)))
                      (store! found true)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (load found)))

(defn ms-schedule-anti-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (load (field m anti-first))
        count (load (field m anti-count))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (if (= (al-get (load (field (machine-unit) memory-anti-deps))
                               (+ first (load i)))
                       node)
                    (store! found true)
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load found)))

; 0=no edge, 1=scalar data, 2=memory/anti, 3=fixed effect/boundary order.
(defn ms-schedule-dependency-kind [(producer i64) (consumer i64)] (-> i64)
  (if (= producer consumer)
      0
      (let [p (be-inst producer)
            c (be-inst consumer)
            dst (load (field p dst))
            pop (load (field p op))
            cop (load (field c op))
            before (< (load (field p schedule-order)) (load (field c schedule-order)))]
        (if (and (>= dst 0)
                 (and (ms-inst-uses-vreg? consumer dst)
                      (or (!= pop MI-COPY) before)))
            1
            (if (or (ms-schedule-memory-node-dep? consumer (load (field p node)))
                    (or (ms-schedule-post-call-memory-dep? consumer
                                                          (load (field p node)))
                    (and (ms-schedule-anti-node-dep? consumer (load (field p node)))
                         (ms-memory-operands-may-alias? p c))))
                2
                (if (or (and before
                             (or (and (> (mi-op-effects pop) 0) (= cop MI-CALL))
                                 (or (and (= pop MI-CALL) (> (mi-op-effects cop) 0))
                                     (and (= pop MI-STORE) (= cop MI-STORE)))))
                        (or (= pop MI-LABEL)
                            (or (and (or (= pop MI-ARG) (= pop MI-STACKARG))
                                     (or (and (!= cop MI-LABEL)
                                              (and (not (= cop MI-ARG)) (not (= cop MI-STACKARG))))
                                         before))
                                (or (and (= cop MI-COPY)
                                         (and (not (mi-op-terminator? pop))
                                              (or (!= pop MI-COPY) before)))
                                    (or (and (= pop MI-ABI-COPY)
                                             (and (!= cop MI-LABEL)
                                                  (and (!= cop MI-ARG)
                                                       (and (!= cop MI-STACKARG)
                                                            (or (!= cop MI-ABI-COPY) before)))))
                                        (and (mi-op-terminator? cop)
                                             (or (not (mi-op-terminator? pop)) before)))))))
                    3
                    0))))))

(defn ms-schedule-latency [(op i64)] (-> i64)
  (case op MI-SDIV 8 MI-MUL 4 MI-LOAD 4 MI-CALL 8 MI-NEW 6 1))

(defn ms-schedule-priority [(at i64)] (-> i64)
  (let [m (be-inst at)]
    ; Correctness edges decide readiness. Latency remains separately queryable target metadata;
    ; equal legal priority keeps seed 0 pressure-conservative and lets test seeds perturb ties.
    (if (mi-op-terminator? (load (field m op))) 0 1)))

(defn ms-schedule-tie [(at i64) (seed i64)] (-> i64)
  (if (= seed 0)
      (- 2147483647 (load (field (be-inst at) schedule-order)))
      (if (= (& seed 1) 1)
          (load (field (be-inst at) schedule-order))
          (& (+ (* (+ seed 1) 1103515245)
                (* (+ (load (field (be-inst at) schedule-order)) 1) 2654435761))
             2147483647))))

(defn ms-schedule-ready? [(first i64) (count i64) (candidate i64)] (-> bool)
  (let [u (machine-unit)
        (mut i) 0
        (mut ready) true]
    (loop (if (or (>= (load i) count) (not (load ready)))
              (break)
              (do
                (if (and (= (al-get (load (field u schedule-done)) (load i)) 0)
                         (> (ms-schedule-dependency-kind (+ first (load i)) candidate) 0))
                    (store! ready false)
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load ready)))

(defn ms-schedule-block! [(bid i64) (seed i64)] (-> bool)
  (let [u (machine-unit)
        b (mu-block bid)
        first (load (field b inst-first))
        count (load (field b inst-count))
        (mut emitted) 0]
    (al-clear! [i64] (field u schedule-done))
    (let [(mut i) 0]
      (loop (if (>= (load i) count)
                (break)
                (do
                  (al-push! [i64] (field u schedule-done) 0)
                  (store! i (+ (load i) 1))
                  0))))
    ;; Dependency kinds are invariant during this block schedule. Publish each candidate's
    ;; indegree once; the former ready check rebuilt the same answer for every candidate after
    ;; every emission, making a large straight-line block cubic.
    (let [(mut consumer) 0]
      (loop (if (>= (load consumer) count)
                (break)
                (let [(mut producer) 0 (mut degree) 0]
                  (loop (if (>= (load producer) count)
                            (break)
                            (do
                              (if (> (ms-schedule-dependency-kind
                                       (+ first (load producer))
                                       (+ first (load consumer)))
                                     0)
                                  (store! degree (+ (load degree) 1))
                                  0)
                              (store! producer (+ (load producer) 1)))))
                  (al-set! [i64] (field u schedule-done) (load consumer) (load degree))
                  (store! consumer (+ (load consumer) 1))))))
    (store! (field b inst-first) (al-len [MInst] (load (field u schedule-work))))
    (loop (if (>= (load emitted) count)
              (break)
              (let [(mut i) 0
                    (mut choice) -1
                    (mut best-priority) -1
                    (mut best-tie) -1]
                (loop (if (>= (load i) count)
                          (break)
                          (do
                            (if (= (al-get (load (field u schedule-done)) (load i)) 0)
                                (let [priority (ms-schedule-priority (+ first (load i)))
                                      tie (ms-schedule-tie (+ first (load i)) seed)]
                                  (if (or (> priority (load best-priority))
                                          (and (= priority (load best-priority)) (> tie (load best-tie))))
                                      (do
                                        (store! choice (load i))
                                        (store! best-priority priority)
                                        (store! best-tie tie))
                                      0))
                                0)
                            (store! i (+ (load i) 1))
                            0)))
                (if (< (load choice) 0)
                    (do
                      (store! (field u schedule-result) MSCHED-CYCLE)
                      (store! (field u schedule-item) bid)
                      (break))
                    (do
                      (al-set! [i64] (field u schedule-done) (load choice) -1)
                      (al-push! [MInst]
                                (field u schedule-work)
                                (load (be-inst (+ first (load choice)))))
                      (let [(mut consumer) 0]
                        (loop (if (>= (load consumer) count)
                                  (break)
                                  (do
                                    (let [degree
                                            (al-get (load (field u schedule-done))
                                                    (load consumer))]
                                      (if (and (> degree 0)
                                               (> (ms-schedule-dependency-kind
                                                    (+ first (load choice))
                                                    (+ first (load consumer)))
                                                  0))
                                          (al-set! [i64]
                                                   (field u schedule-done)
                                                   (load consumer)
                                                   (- degree 1))
                                          0))
                                    (store! consumer (+ (load consumer) 1))))))
                      (store! emitted (+ (load emitted) 1)))))))
    (= (load emitted) count)))

(defn ms-verify-schedule! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        n (be-inst-count)
        (mut bid) 0
        (mut at) 0]
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (loop (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (let [b (mu-block (load bid))
                      first (load (field b inst-first))
                      count (load (field b inst-count))
                      (mut i) 0
                      (mut seen-term) false]
                  (if (or (< first 0) (> (+ first count) n))
                      (do
                        (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                        (store! (field u schedule-item) (load bid)))
                      0)
                  (loop (if (or (>= (load i) count) (!= (ms-schedule-result) MSCHED-OK))
                            (break)
                            (do
                              (let [current (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    (mut p) 0]
                                (if (!= (load (field m block-id)) (load bid))
                                    (do
                                      (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                                      (store! (field u schedule-item) current))
                                    0)
                                (if (mi-op-terminator? (load (field m op)))
                                    (store! seen-term true)
                                    (if (load seen-term)
                                        (do
                                          (store! (field u schedule-result) MSCHED-BOUNDARY)
                                          (store! (field u schedule-item) current))
                                        0))
                                (if (and (= (ms-schedule-result) MSCHED-OK)
                                         (not (ms-memory-anti-dependencies-valid? current)))
                                    (do
                                      (store! (field u schedule-result) MSCHED-MEMORY)
                                      (store! (field u schedule-item) current))
                                    0)
                                (loop (if (>= (load p) count)
                                          (break)
                                          (do
                                            (let [producer (+ first (load p))
                                                  kind (ms-schedule-dependency-kind producer current)]
                                              (if (and (> kind 0) (>= producer current))
                                                  (do
                                                    (store! (field u schedule-result)
                                                            (if (= kind 2) MSCHED-MEMORY MSCHED-DEPENDENCY))
                                                    (store! (field u schedule-item) current))
                                                  0))
                                            (store! p (+ (load p) 1))
                                            0))))
                              (store! i (+ (load i) 1))
                              0))))
                (store! bid (+ (load bid) 1))
                0)))
    ; Ranges must cover every instruction exactly once.
    (store! at 0)
    (loop (if (or (>= (load at) n) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (let [(mut owner-count) 0
                      (mut order-count) 0
                      (mut b) 0
                      order (load (field (be-inst (load at)) schedule-order))]
                  (loop (if (>= (load b) blocks)
                            (break)
                            (do
                              (let [rec (mu-block (load b))
                                    first (load (field rec inst-first))]
                                (if (and (>= (load at) first)
                                         (< (load at) (+ first (load (field rec inst-count)))))
                                    (store! owner-count (+ (load owner-count) 1))
                                    0))
                              (store! b (+ (load b) 1))
                              0)))
                  (let [(mut other) 0]
                    (loop (if (>= (load other) n)
                              (break)
                              (do
                                (if (= (load (field (be-inst (load other)) schedule-order)) order)
                                    (store! order-count (+ (load order-count) 1))
                                    0)
                                (store! other (+ (load other) 1))
                                0))))
                  (if (or (!= (load owner-count) 1)
                          (or (< order 0) (or (>= order n) (!= (load order-count) 1))))
                      (do
                        (store! (field u schedule-result) MSCHED-EXACTLY-ONCE)
                        (store! (field u schedule-item) (load at)))
                      0))
                (store! at (+ (load at) 1))
                0)))
    (= (ms-schedule-result) MSCHED-OK)))

(defn ms-corrupt-schedule-swap! [(left i64) (right i64)] (-> i64)
  (let [a (load (be-inst left))
        b (load (be-inst right))]
    (store! (be-inst left) b)
    (store! (be-inst right) a)
    0))

(defn ms-corrupt-schedule-duplicate! [(target i64) (source i64)] (-> i64)
  (store! (be-inst target) (load (be-inst source)))
  0)

(defn ms-local-schedule! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        n (be-inst-count)
        blocks (mu-block-count)
        (mut at) 0
        (mut bid) 0]
    (store! (field u schedule-result) MSCHED-OK)
    (store! (field u schedule-item) -1)
    (store! (field u schedule-seed) seed)
    (al-clear! [MInst] (field u schedule-work))
    (loop (if (>= (load at) n)
              (break)
              (do
                (store! (field (be-inst (load at)) schedule-order) (load at))
                (store! at (+ (load at) 1))
                0)))
    ; Local scheduling must not silently become block layout. Preserve the already-published block
    ; order and change only instruction order within each range.
    (loop (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (ms-schedule-block! (load bid) seed)
                (store! bid (+ (load bid) 1))
                0)))
    (if (!= (ms-schedule-result) MSCHED-OK)
        false
        (do
          (al-clear! [MInst] (field (backend) ins))
          (let [count (al-len [MInst] (load (field u schedule-work)))
                (mut i) 0]
            (loop (if (>= (load i) count)
                      (break)
                      (do
                        (al-push! [MInst]
                                  (field (backend) ins)
                                  (al-get (load (field u schedule-work)) (load i)))
                        (store! i (+ (load i) 1))
                        0))))
          (ms-verify-schedule!)))))

;; Selection emits a dependency-topological order. This explicit scheduler computes live intervals
;; and is the hook where M10's global code motion adds block placement for control graphs.
(defn be-schedule-intervals! [] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))
                      d (load (field m dst))]
                  (if (< d 0)
                      0
                      (do
                        (store! (field m first)
                                (if (= (load (field m op)) MI-ARG) 0 (load i)))
                        (store! (field m last) (load i))
                        0)))
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))
                      a (load (field m a))
                      b (load (field m b))
                      pred (if (= (load (field m op)) MI-CSEL) (load (field m imm)) -1)
                      (mut j) 0]
                  (loop (if (>= (load j) n)
                            (break)
                            (do
                              (let [d (load (field (be-inst (load j)) dst))]
                                (if (and (>= d 0) (or (or (= d a) (= d b)) (= d pred)))
                                    (store! (field (be-inst (load j)) last) (load i))
                                    0))
                              (store! j (+ (load j) 1))
                              0)))
                  (if (> (ms-inst-arg-count (load i)) 0)
                      (be-note-call-arg-uses! (load i) n)
                      0))
                (store! i (+ (load i) 1))
                0)))
    ; A linear interval ends at its last textual use, but a preheader value used inside a loop is
    ; live again on every back edge. Extend such ranges through the branch that targets an earlier
    ; label so colouring cannot reuse an invariant's register for a loop-carried temporary.
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [br (be-inst (load i))]
                  (if (!= (load (field br op)) MI-B)
                      0
                      (let [label (load (field br imm))
                            (mut j) 0
                            (mut at) -1]
                        (loop (if (>= (load j) (load i))
                                  (break)
                                  (do
                                    (if (and (= (load (field (be-inst (load j)) op)) MI-LABEL)
                                             (= (load (field (be-inst (load j)) imm)) label))
                                        (store! at (load j))
                                        0)
                                    (store! j (+ (load j) 1))
                                    0)))
                        (if (< (load at) 0)
                            0
                            (do
                              (store! j 0)
                              (loop (if (>= (load j) (load at))
                                        (break)
                                        (do
                                          (let [d (be-inst (load j))]
                                            (if (>= (load (field d last)) (load at))
                                                (store! (field d last) (load i))
                                                0))
                                          (store! j (+ (load j) 1))
                                          0)))))))
                  (store! i (+ (load i) 1))
                  0))))
    n))

(defn be-schedule-seeded! [(seed i64)] (-> i64)
  (let [n (be-inst-count)]
    (if (and (> n 0) (>= (ms-inst-owner 0) 0))
        ;; Run the legality scheduler for production seed zero as well as perturbation seeds. GCM
        ;; placement alone does not order a heap read before a later aliasing write; the explicit
        ;; memory anti-edge is enforced here.
        (if (ms-local-schedule! seed)
            (let [scheduled (be-schedule-intervals!)]
              (if (ml-compute! seed) scheduled -1))
            -1)
        (be-schedule-intervals!))))

(defn be-schedule! [] (-> i64)
  (be-schedule-seeded! 0))

(defn intervals-overlap? [(a (ptr MInst)) (b (ptr MInst))] (-> bool)
  (and (<= (load (field a first)) (load (field b last)))
       (<= (load (field b first)) (load (field a last)))))

; ---------------------------------------------------------------------------
; G7 CFG interference and constrained allocation.
; ---------------------------------------------------------------------------

(defn mra-result [] (-> i64)
  (load (field (machine-unit) allocation-result)))
(defn mra-result-item [] (-> i64)
  (load (field (machine-unit) allocation-item)))
(defn mra-seed [] (-> i64)
  (load (field (machine-unit) allocation-seed)))
(defn mra-reg [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-reg)) vreg))
(defn mra-spill [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-spill)) vreg))
(defn mra-owner [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-owner)) vreg))
(defn mra-spill-kind [(vreg i64)] (-> i64)
  (al-get (load (field (machine-unit) alloc-spill-kind)) vreg))
(defn mra-safepoint-reg [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-reg vreg) -2))
(defn mra-safepoint-spill [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-spill vreg) -2))
(defn mra-safepoint-kind [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (ml-value-kind vreg) -1))
(defn mra-interferes? [(a i64) (b i64)] (-> bool)
  (!= (al-get (load (field (machine-unit) alloc-interference))
              (+ (* a (ml-vreg-count)) b))
      0))

(defn mra-phys-reg [(color i64)] (-> i64)
  (if (< color 8)
      color
      ; x28 is the native GC thread-state register.  It is fixed for the whole
      ; generated unit and therefore never participates in graph coloring.
      (if (< color 17)
          (+ 19 (- color 8))
          (if (< color 24) (+ 8 (- color 17)) -1))))

(defn mra-phys-reg-for-class [(class i64) (color i64)] (-> i64)
  (if (= class MRC-FPR)
      ; d0-d7 are ABI ingress/egress, d8-d15 callee-saved, and d16-d31 caller-saved.
      (if (< color 32) (+ 32 color) -1)
      (mra-phys-reg color)))

(defn mra-init! [] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut i) 0]
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (loop (if (>= (load i) (* vregs vregs))
              (break)
              (do
                (al-push! [i64] (field u alloc-interference) 0)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u alloc-live) 0)
                (al-push! [i64] (field u alloc-reg) -1)
                (al-push! [i64] (field u alloc-spill) -1)
                (al-push! [i64] (field u alloc-owner) -1)
                (al-push! [i64] (field u alloc-forbidden) 0)
                (al-push! [i64] (field u alloc-spill-kind) (ml-value-kind (load i)))
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))
                      dst (load (field m dst))]
                  (if (>= dst 0)
                      (do
                        (al-set! [i64] (field u alloc-owner) dst (load (field m owner)))
                        (if (= (load (field m op)) MI-ARG)
                            (al-set! [i64]
                                     (field u alloc-reg)
                                     dst
                                     (+ (load (field m imm))
                                        (if (= (ml-register-class dst) MRC-FPR) 32 0)))
                            0))
                      0))
                (store! i (+ (load i) 1))
                0)))
    ;; Ingress copies are sequential moves. A fresh destination must avoid every still-fixed
    ;; ingress register in its function, or one copy can overwrite another argument before that
    ;; argument has been copied. Calls/safepoints remain governed by ordinary liveness masks.
    (store! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (load (field m op)) MI-ABI-COPY)
                      (let [source-def (ms-owner-def-inst (load (field m owner))
                                                          (load (field m a)))
                            dst (load (field m dst))
                            owner (load (field m owner))
                            (mut at) 0
                            (mut mask) 0]
                        (if (and (>= source-def 0)
                                 (or (= (ms-inst-op source-def) MI-ARG)
                                     (= (ms-inst-op source-def) MI-STACKARG)))
                            (do
                              (loop (if (>= (load at) (be-inst-count))
                                        (break)
                                        (do
                                          (let [arg (be-inst (load at))]
                                            (if (and (= (load (field arg owner)) owner)
                                                     (= (load (field arg op)) MI-ARG))
                                                (store! mask
                                                        (| (load mask)
                                                           (<< 1
                                                               (+ (load (field arg imm))
                                                                  (if (= (ml-register-class (load (field arg dst)))
                                                                         MRC-FPR)
                                                                      32
                                                                      0)))))
                                                0))
                                          (store! at (+ (load at) 1)))))
                              (al-set! [i64] (field u alloc-forbidden) dst (load mask)))
                            0))
                      0))
                (store! i (+ (load i) 1)))))
    0))

(defn mra-add-interference! [(a i64) (b i64)] (-> i64)
  (if (or (< a 0) (or (< b 0) (= a b)))
      0
      (let [u (machine-unit)
            n (ml-vreg-count)]
        (al-set! [i64] (field u alloc-interference) (+ (* a n) b) 1)
        (al-set! [i64] (field u alloc-interference) (+ (* b n) a) 1)
        0)))

(defn mra-build-interference! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [(mut vr) 0]
                  (loop (if (>= (load vr) vregs)
                            (break)
                            (do
                              (al-set! [i64]
                                       (field u alloc-live)
                                       (load vr)
                                       (if (ml-live-out? (load bid) (load vr)) 1 0))
                              (store! vr (+ (load vr) 1))
                              0))))
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) count
                      (mut vr) 0]
                  (loop (if (<= (load i) 0)
                            (break)
                            (do
                              (store! i (- (load i) 1))
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (load (field m dst))]
                                ; Values live after any call-like instruction cannot occupy its clobber mask.
                                (if (!= (mi-desc-clobbers (mi-desc (load (field m op)))) 0)
                                    (let [(mut vr) 0]
                                      (loop (if (>= (load vr) vregs)
                                                (break)
                                                (do
                                                  (if (and (!= (load vr) dst)
                                                           (!= (al-get (load (field u alloc-live)) (load vr)) 0))
                                                      (al-set! [i64]
                                                               (field u alloc-forbidden)
                                                               (load vr)
                                                               (| (al-get (load (field u alloc-forbidden)) (load vr))
                                                                  (mi-desc-clobbers (mi-desc (load (field m op))))))
                                                      0)
                                                  (store! vr (+ (load vr) 1))
                                                  0))))
                                    0)
                                (if (>= dst 0)
                                    (do
                                      (store! vr 0)
                                      (loop (if (>= (load vr) vregs)
                                                (break)
                                                (do
                                                  (if (!= (al-get (load (field u alloc-live)) (load vr)) 0)
                                                      (mra-add-interference! dst (load vr))
                                                      0)
                                                  (store! vr (+ (load vr) 1))
                                                  0)))
                                      (al-set! [i64] (field u alloc-live) dst 0))
                                    0)
                                (store! vr 0)
                                (loop (if (>= (load vr) vregs)
                                          (break)
                                          (do
                                            (if (ml-inst-uses? at (load vr))
                                                (al-set! [i64] (field u alloc-live) (load vr) 1)
                                                0)
                                            (store! vr (+ (load vr) 1))
                                            0))))))))
                (store! bid (+ (load bid) 1))
                0)))
    0))

(defn mra-reg-legal? [(vreg i64) (reg i64)] (-> bool)
  (if (< reg 0)
      false
      (let [u (machine-unit)
            forbidden (al-get (load (field u alloc-forbidden)) vreg)
            vregs (ml-vreg-count)
            (mut other) 0
            (mut ok) true]
        (if (or (!= (= (ml-register-class vreg) MRC-FPR) (>= reg 32))
                (!= (& forbidden (<< 1 reg)) 0))
            false
            (do
              (loop (if (or (>= (load other) vregs) (not (load ok)))
                        (break)
                        (do
                          (if (and (mra-interferes? vreg (load other))
                                   (= (mra-reg (load other)) reg))
                              (store! ok false)
                              0)
                          (store! other (+ (load other) 1))
                          0)))
              (load ok))))))

(defn mra-copy-preference [(vreg i64)] (-> i64)
  (let [(mut at) 0
        (mut preferred) -1]
    (loop (if (or (>= (load at) (be-inst-count)) (>= (load preferred) 0))
              (break)
              (do
                (let [m (be-inst (load at))]
                  (if (= (load (field m op)) MI-COPY)
                      (let [dst (load (field m dst))
                            src (load (field m a))
                            other (if (= dst vreg) src (if (= src vreg) dst -1))]
                        (if (and (>= other 0)
                                 (and (not (mra-interferes? vreg other))
                                      (= (ml-value-kind vreg) (ml-value-kind other))))
                            (store! preferred (mra-reg other))
                            0))
                      0))
                (store! at (+ (load at) 1))
                0)))
    (load preferred)))

(defn mra-assign! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        funcs (mu-function-count)
        (mut owner) 0
        (mut rank) 0
        (mut spills) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (store! (field (mu-function (load owner)) frame-size) 0)
                (store! (field (mu-function (load owner)) callee-mask) 0)
                (store! (field (mu-function (load owner)) callee-count) 0)
                (store! owner (+ (load owner) 1))
                0)))
    (loop (if (>= (load rank) vregs)
              (break)
              (do
                (let [vreg (if (= (& seed 1) 0) (load rank) (- vregs (+ (load rank) 1)))]
                  (if (or (< (mra-owner vreg) 0) (>= (mra-reg vreg) 0))
                      0
                      (let [preferred (mra-copy-preference vreg)
                            (mut color) 0
                            (mut chosen) -1]
                        (if (and (>= preferred 0) (mra-reg-legal? vreg preferred))
                            (store! chosen preferred)
                            0)
                        (loop (if (or (>= (load color) nregs) (>= (load chosen) 0))
                                  (break)
                                  (do
                                    (let [physical
                                            (mra-phys-reg-for-class (ml-register-class vreg)
                                                                    (load color))]
                                      (if (mra-reg-legal? vreg physical) (store! chosen physical) 0))
                                    (store! color (+ (load color) 1))
                                    0)))
                        (if (>= (load chosen) 0)
                            (al-set! [i64] (field u alloc-reg) vreg (load chosen))
                            (let [fun (mra-owner vreg)
                                  slot (load (field (mu-function (mra-owner vreg)) frame-size))]
                              (al-set! [i64] (field u alloc-spill) vreg slot)
                              (store! (field (mu-function fun) frame-size) (+ slot 1))
                              (store! spills (+ (load spills) 1)))))))
                (store! rank (+ (load rank) 1))
                0)))
    ; Derive each function's callee-save area, then convert spill counts to aligned frame bytes.
    (let [(mut vr) 0]
      (loop (if (>= (load vr) vregs)
                (break)
                (do
                  (let [fun (mra-owner (load vr))
                        reg (mra-reg (load vr))]
                    (if (and (>= fun 0)
                             (or (and (>= reg 19) (<= reg 28))
                                 (and (>= reg 40) (<= reg 47))))
                        (store! (field (mu-function fun) callee-mask)
                                (| (load (field (mu-function fun) callee-mask)) (<< 1 reg)))
                        0))
                  (store! vr (+ (load vr) 1))
                  0))))
    (store! owner 0)
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (let [slots (load (field (mu-function (load owner)) frame-size))
                      saves (popcount64 (load (field (mu-function (load owner)) callee-mask)))]
                  (store! (field (mu-function (load owner)) callee-count) saves)
                  (store! (field (mu-function (load owner)) frame-size)
                          (& (+ (+ 16 (* (+ saves slots) 8)) 15) -16)))
                (store! owner (+ (load owner) 1))
                0)))
    (load spills)))

(defn mra-publish! [] (-> i64)
  (let [n (be-inst-count)
        (mut at) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      dst (load (field m dst))]
                  (if (>= dst 0)
                      (do
                        (store! (field m reg) (mra-reg dst))
                        (store! (field m spill) (mra-spill dst)))
                      0))
                (store! at (+ (load at) 1))
                0)))
    0))

(defn mra-expected-interferes? [(a i64) (b i64)] (-> bool)
  (if (= a b)
      false
      (let [blocks (mu-block-count)
            (mut bid) 0
            (mut found) false]
        (loop (if (or (>= (load bid) blocks) (load found))
                  (break)
                  (do
                    (let [first (mu-block-inst-first (load bid))
                          count (mu-block-inst-count (load bid))
                          (mut i) count
                          (mut alive) (ml-live-out? (load bid) a)
                          (mut blive) (ml-live-out? (load bid) b)]
                      (loop (if (or (<= (load i) 0) (load found))
                                (break)
                                (do
                                  (store! i (- (load i) 1))
                                  (let [at (+ first (load i))
                                        dst (ms-inst-dst (+ first (load i)))]
                                    (if (and (= dst a) (load blive)) (store! found true) 0)
                                    (if (and (= dst b) (load alive)) (store! found true) 0)
                                    (if (= dst a) (store! alive false) 0)
                                    (if (= dst b) (store! blive false) 0)
                                    (if (ml-inst-uses? at a) (store! alive true) 0)
                                    (if (ml-inst-uses? at b) (store! blive true) 0))))))
                    (store! bid (+ (load bid) 1))
                    0)))
        (load found))))

(defn mra-verify! [] (-> bool)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut vr) 0]
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (loop (if (or (>= (load vr) vregs) (!= (mra-result) MRA-OK))
              (break)
              (do
                (if (>= (mra-owner (load vr)) 0)
                    (do
                      (if (= (>= (mra-reg (load vr)) 0) (>= (mra-spill (load vr)) 0))
                          (do
                            (store! (field u allocation-result) MRA-LOCATION)
                            (store! (field u allocation-item) (load vr)))
                          0)
                      (if (and (>= (mra-reg (load vr)) 0)
                               (not (mra-reg-legal? (load vr) (mra-reg (load vr)))))
                          (do
                            (store! (field u allocation-result) MRA-INTERFERENCE)
                            (store! (field u allocation-item) (load vr)))
                          0)
                      (if (!= (mra-spill-kind (load vr)) (ml-value-kind (load vr)))
                          (do
                            (store! (field u allocation-result) MRA-SPILL-KIND)
                            (store! (field u allocation-item) (load vr)))
                          0))
                    0)
                (store! vr (+ (load vr) 1))
                0)))
    (if (= (mra-result) MRA-OK)
        (let [cells (* vregs vregs) (mut cell) 0]
          ;; Snapshot the published graph, rebuild it with the same reverse-liveness construction,
          ;; and compare matrices linearly. Calling mra-expected-interferes? for every pair scanned
          ;; every block again, making verification quartic on whole benchmark programs.
          (al-clear! [i64] (field u alloc-expected))
          (loop (if (>= (load cell) cells)
                    (break)
                    (do
                      (al-push! [i64]
                                (field u alloc-expected)
                                (al-get (load (field u alloc-interference)) (load cell)))
                      (al-set! [i64] (field u alloc-interference) (load cell) 0)
                      (store! cell (+ (load cell) 1)))))
          (mra-build-interference!)
          (store! cell 0)
          (loop (if (or (>= (load cell) cells) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (if (!= (al-get (load (field u alloc-interference)) (load cell))
                              (al-get (load (field u alloc-expected)) (load cell)))
                          (do
                            (store! (field u allocation-result) MRA-INTERFERENCE)
                            (store! (field u allocation-item) (load cell)))
                          0)
                      (store! cell (+ (load cell) 1))))))
        0)
    ; Every definition of a vreg, including Phi edge copies, publishes the same location.
    (if (= (mra-result) MRA-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (let [m (be-inst (load at))
                            dst (load (field m dst))]
                        (if (and (>= dst 0)
                                 (or (!= (load (field m reg)) (mra-reg dst))
                                     (!= (load (field m spill)) (mra-spill dst))))
                            (do
                              (store! (field u allocation-result) MRA-LOCATION)
                              (store! (field u allocation-item) (load at)))
                            0))
                      (let [m (be-inst (load at))]
                        (if (and (= (load (field m op)) MI-ARG)
                                 (!= (mra-reg (load (field m dst)))
                                     (+ (load (field m imm))
                                        (if (= (ml-register-class (load (field m dst))) MRC-FPR)
                                            32
                                            0))))
                            (do
                              (store! (field u allocation-result) MRA-FIXED)
                              (store! (field u allocation-item) (load at)))
                            0))
                      (store! at (+ (load at) 1))
                      0))))
        0)
    (= (mra-result) MRA-OK)))

(defn mra-corrupt-reg! [(vreg i64) (reg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-reg) vreg reg)
  (al-set! [i64] (field (machine-unit) alloc-spill) vreg -1)
  (mra-publish!)
  0)
(defn mra-corrupt-spill-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-spill-kind) vreg kind)
  0)
(defn mra-corrupt-interference! [(a i64) (b i64) (present bool)] (-> i64)
  (let [u (machine-unit)
        n (ml-vreg-count)
        value (if present 1 0)]
    (al-set! [i64] (field u alloc-interference) (+ (* a n) b) value)
    (al-set! [i64] (field u alloc-interference) (+ (* b n) a) value)
    0))

(defn mra-allocate! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)]
    (store! (field u allocation-seed) seed)
    (store! (field u allocation-result) MRA-OK)
    (store! (field u allocation-item) -1)
    (mra-init!)
    (mra-build-interference!)
    (let [spills (mra-assign! nregs seed)]
      (mra-publish!)
      (if (mra-verify!) spills -1))))

;; Greedy coloring over the exact interval interference graph. Values beyond the register budget
;; receive distinct spill slots; lowering treats each slot boundary as a split point.
(defn be-color-linear! [(nregs i64)] (-> i64)
  (let [p (backend)
        n (be-inst-count)
        (mut i) 0]
    (store! (field p spills) 0)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (store! (field (mu-function (load owner)) frame-size) 0)
                  (store! owner (+ (load owner) 1))
                  0))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (field (be-inst (load i)) reg)
                        (if (= (load (field (be-inst (load i)) op)) MI-ARG)
                            (load (field (be-inst (load i)) imm))
                            -1))
                (store! (field (be-inst (load i)) spill) -1)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (or (< (load (field m dst)) 0) (= (load (field m op)) MI-ARG))
                      0
                      (let [(mut color) 0
                            (mut found) false]
                        (loop (if (or (>= (load color) nregs) (load found))
                                  (break)
                                  (let [(mut j) 0
                                        (mut conflict) false]
                                    (loop (if (>= (load j) n)
                                              (break)
                                              (do
                                                (let [q (be-inst (load j))]
                                                  (if (and (!= (load j) (load i))
                                                           (and (= (load (field q reg)) (load color))
                                                                (intervals-overlap? m q)))
                                                      (store! conflict true)
                                                      0))
                                                (store! j (+ (load j) 1))
                                                0)))
                                    (if (load conflict) (store! color (+ (load color) 1)) (store! found true)))))
                        (if (load found)
                            (store! (field m reg) (load color))
                            (let [owner (load (field m owner))]
                              (if (>= owner 0)
                                  (let [slot (load (field (mu-function owner) frame-size))]
                                    (store! (field m spill) slot)
                                    (store! (field (mu-function owner) frame-size) (+ slot 1)))
                                  (do
                                    (store! (field m spill) (load (field p spills)))
                                    (store! (field p spills) (+ (load (field p spills)) 1))
                                    0))))))
                  (store! i (+ (load i) 1))
                  0))))
    (let [funcs (mu-function-count)
          (mut owner) 0]
      (loop (if (>= (load owner) funcs)
                (break)
                (do
                  (let [slots (load (field (mu-function (load owner)) frame-size))
                        bytes (& (+ (+ 16 (* slots 8)) 15) -16)]
                    (store! (field (mu-function (load owner)) frame-size) bytes)
                    (store! (field p spills) (+ (load (field p spills)) slots)))
                  (store! owner (+ (load owner) 1))
                  0))))
    (load (field p spills))))

(defn be-color-seeded! [(nregs i64) (seed i64)] (-> i64)
  (if (and (> (be-inst-count) 0) (>= (ms-inst-owner 0) 0))
      (let [spills (mra-allocate! nregs seed)]
        (store! (field (backend) spills) (if (< spills 0) 0 spills))
        spills)
      (be-color-linear! nregs)))

(defn be-color! [(nregs i64)] (-> i64)
  (be-color-seeded! nregs 0))

; Repack whole function instruction ranges before liveness/allocation. Seeds rotate function text
; order, including moving the exported entry away from offset zero. Block-local scheduled order is
; unchanged.
(defn be-function-layout-seeded! [(seed i64)] (-> i64)
  (let [p (backend)
        u (machine-unit)
        funcs (mu-function-count)
        n (be-inst-count)
        work (field u schedule-work)
        (mut rank) 0]
    (al-clear! [MInst] work)
    (loop (if (>= (load rank) funcs)
              (break)
              (do
                (let [owner (% (+ (load rank) seed) funcs)
                      (mut at) 0]
                  (loop (if (>= (load at) n)
                            (break)
                            (do
                              (if (= (ms-inst-owner (load at)) owner)
                                  (al-push! [MInst] work (load (be-inst (load at))))
                                  0)
                              (store! at (+ (load at) 1))
                              0))))
                (store! rank (+ (load rank) 1))
                0)))
    (if (!= (al-len [MInst] (load work)) n)
        -1
        (do
          (al-clear! [MInst] (field p ins))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (al-push! [MInst] (field p ins) (load (be-al-elem [MInst] work (load at))))
                        (store! at (+ (load at) 1))
                        0))))
          (let [(mut bid) 0]
            (loop (if (>= (load bid) (mu-block-count))
                      (break)
                      (do
                        (store! (field (mu-block (load bid)) inst-first) -1)
                        (store! (field (mu-block (load bid)) inst-count) 0)
                        (store! bid (+ (load bid) 1))
                        0))))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (let [bid (ms-inst-block (load at))]
                          (if (>= bid 0)
                              (let [b (mu-block bid)]
                                (if (< (load (field b inst-first)) 0)
                                    (store! (field b inst-first) (load at))
                                    0)
                                (store! (field b inst-count) (+ (load (field b inst-count)) 1)))
                              0))
                        (store! at (+ (load at) 1))
                        0)))
            n)))))

(defn be-color-checked! [(nregs i64)] (-> bool)
  (if (<= nregs 0)
      (be-fail! BER-ALLOCATION NO-NODE)
      (do (be-color! nregs) true)))

(defn be-spills [] (-> i64)
  (load (field (backend) spills)))

(defn be-verify-abi! [] (-> i64)
  (let [funcs (mu-function-count)
        n (be-inst-count)
        (mut owner) 0
        (mut at) 0
        (mut result) MABI-OK]
    (loop (if (or (>= (load owner) funcs) (!= (load result) MABI-OK))
              (break)
              (do
                (let [frame (mu-function-frame-size (load owner))]
                  (if (or (< frame 16) (!= (& frame 15) 0)) (store! result MABI-FRAME) 0))
                (store! owner (+ (load owner) 1))
                0)))
    (loop (if (or (>= (load at) n) (!= (load result) MABI-OK))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (load (field m op))
                      own (load (field m owner))
                      spill (load (field m spill))]
                  (if (and (>= own 0) (>= spill 0))
                      (if (> (+ 16 (* (+ (mu-function-callee-count own) (+ spill 1)) 8))
                             (mu-function-frame-size own))
                          (store! result MABI-SPILL)
                          0)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (or (and (= op MI-ARG)
                                    (or (< (load (field m imm)) 0) (>= (load (field m imm)) 8)))
                               (and (= op MI-STACKARG)
                                    (or (< (load (field m imm)) 0) (>= (load (field m imm)) 16)))))
                      (store! result MABI-ARGUMENT)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (and (> (ms-inst-arg-count (load at)) 0)
                                (not (ms-call-args-valid? (load at)))))
                      (store! result MABI-ARGUMENT)
                      0))
                (store! at (+ (load at) 1))
                0)))
    (load result)))

(defn be-corrupt-frame-size! [(owner i64) (bytes i64)] (-> i64)
  (store! (field (mu-function owner) frame-size) bytes)
  0)
(defn be-corrupt-spill-slot! [(at i64) (slot i64)] (-> i64)
  (store! (field (be-inst at) spill) slot)
  (store! (field (be-inst at) reg) -1)
  0)
(defn be-corrupt-arg-index! [(at i64) (idx i64)] (-> i64)
  (store! (field (be-inst at) imm) idx)
  0)

(defn be-falsify-shift-mask-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))
(defn be-falsify-unsigned-shift-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))
(defn be-falsify-shift-mask! [] (-> i64)
  (store! (be-falsify-shift-mask-ptr) true)
  0)
(defn be-falsify-unsigned-shift! [] (-> i64)
  (store! (be-falsify-unsigned-shift-ptr) true)
  0)

; Focused phase tests use this after coloring to exercise lowering's spill boundary independent of
; the later CFG allocator milestone. Every definition of a Phi vreg must name the same location.
(defn be-force-spill-vreg! [(vreg i64) (slot i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut owner) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (load (field m dst)) vreg)
                      (do
                        (store! (field m reg) -1)
                        (store! (field m spill) slot)
                        (store! owner (load (field m owner)))
                        0)
                      0))
                (store! i (+ (load i) 1))
                0)))
    (if (<= (load (field (backend) spills)) slot)
        (store! (field (backend) spills) (+ slot 1))
        0)
    (if (>= (load owner) 0)
        (let [need
                (& (+ (+ 16
                         (* (+ (mu-function-callee-count (load owner))
                               (+ slot 1))
                            8))
                      15)
                   -16)]
          (if (< (mu-function-frame-size (load owner)) need)
              (store! (field (mu-function (load owner)) frame-size) need)
              0))
        0)
    0))

; AArch64 word encoders used by lowering.
(defn a64-movz [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 2 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-movk [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 3 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-add-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd)))))
(defn a64-sub-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd))))))
(defn a64-and-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
