                          (ms-emit! owner
                                    (ms-entry-block owner)
                                    (mi-new MI-FMOVI fresh -1 -1 (be-float-bits (n-ty node)) node))
                          (store! vr fresh))
                        0))
                  OP-STRINGCONST
                (store! vr (ms-select-string-const! owner node bid)) OP-STRINGLEN
                (let [string (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= string 0)
                      (store! vr
                              (ms-jsstring! owner
                                            bid
