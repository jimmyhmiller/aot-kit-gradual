(module jsobject)

(import "coil.arraylist" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.slice" :use *)
(import "shape" :use *)
(import "ty" :use *)
(import "jsvalue" :use *)

(const JSO-NONE i64 -1)
(const JSO-OK i64 0)
(const JSO-CYCLE i64 1)
(const JSO-BAD-OBJECT i64 2)

(defstruct JsObject
  [(shape i64) (prototype i64) (property-head i64) (frozen bool)
   (internal-kind i64) (internal-target i64) (internal-index i64)])
(defstruct JsProperty [(owner i64) (name i64) (value i64) (next i64)])
(defstruct JsObjectHeap
  [(objects (ArrayList JsObject))
   (properties (ArrayList JsProperty))
   (status i64)
   (track-shapes bool)
   (inited bool)])

(defn jso-heap [] (-> (ptr JsObjectHeap))
  (let [heap (alloc/static JsObjectHeap)]
    (if (.inited heap) 0
      (do (set! (.inited heap) true)
          (set! (.objects heap) (al-new [JsObject] (malloc-allocator)))
          (set! (.properties heap) (al-new [JsProperty] (malloc-allocator)))
          (set! (.track-shapes heap) true)
          0))
    heap))

(defn jso-reset! [] (-> i64)
  (let [heap (jso-heap)]
    (al-clear! [JsObject] (field heap objects))
    (al-clear! [JsProperty] (field heap properties))
    (set! (.status heap) JSO-OK)
    (set! (.track-shapes heap) true)
    0))

;; The compiler's shape arena is a 64-bit type lattice, not an unbounded runtime hidden-class
;; table. The ideal evaluator can disable runtime shape transitions while retaining property and
;; prototype semantics for whole programs with more than 64 insertion histories.
(defn jso-track-shapes! [(enabled bool)] (-> i64)
  (set! (.track-shapes (jso-heap)) enabled)
  0)

(defn jso-object-make [(prototype i64)] (-> JsObject)
  (JsObject :shape
            SHAPE-ROOT
            :prototype
            prototype
            :property-head
            JSO-NONE
            :frozen
            false
            :internal-kind
            JSO-NONE
            :internal-target
            0
            :internal-index
            0))

(defn jso-property-make [(owner i64) (name i64) (value i64) (next i64)] (-> JsProperty)
  (JsProperty :owner owner :name name :value value :next next))

(defn jso-valid? [(object i64)] (-> bool)
  (and (>= object 0) (< object (al-len [JsObject] (.objects (jso-heap))))))

(defn jso-new! [(prototype i64)] (-> i64)
  (let [heap (jso-heap) id (al-len [JsObject] (.objects heap))]
    (if (or (= prototype JSO-NONE) (jso-valid? prototype))
        (do (al-push! [JsObject] (field heap objects) (jso-object-make prototype)) id)
      (do (set! (.status heap) JSO-BAD-OBJECT) JSO-NONE))))

(defn jso-shape [(object i64)] (-> i64)
  (if (jso-valid? object)
      (let [record (al-get [JsObject] (.objects (jso-heap)) object)]
        (.shape record))
      SHAPE-ROOT))

(defn jso-frozen? [(object i64)] (-> bool)
  (if (jso-valid? object)
      (let [record (al-get [JsObject]
                           (.objects (jso-heap)) object)]
        (.frozen record))
      false))

(defn jso-freeze! [(object i64)] (-> i64)
  (if (not (jso-valid? object)) JSO-BAD-OBJECT
      (let [heap (jso-heap)
            (mut record) (al-get [JsObject] (.objects heap) object)]
        (set! (.frozen record) true)
        (al-set! [JsObject] (field heap objects) object (load record))
        JSO-OK)))

;; Engine-owned slots are not properties: enumeration and user PropertyKey access cannot observe
;; them. This is the runtime representation seam corresponding to a Torque `extern class` field.
(defn jso-internal-init! [(object i64) (target i64) (kind i64)] (-> i64)
  (if (not (jso-valid? object)) JSO-BAD-OBJECT
      (let [heap (jso-heap)
            (mut record) (al-get [JsObject] (.objects heap) object)]
        (set! (.internal-kind record) kind)
        (set! (.internal-target record) target)
        (set! (.internal-index record) 0)
        (al-set! [JsObject] (field heap objects) object (load record))
        JSO-OK)))

(defn jso-internal-kind [(object i64)] (-> i64)
  (if (jso-valid? object)
      (let [record (al-get [JsObject] (.objects (jso-heap)) object)]
        (.internal-kind record))
      JSO-NONE))
(defn jso-internal-target [(object i64)] (-> i64)
  (if (jso-valid? object)
      (let [record (al-get [JsObject] (.objects (jso-heap)) object)]
        (.internal-target record))
      0))
(defn jso-internal-index [(object i64)] (-> i64)
  (if (jso-valid? object)
      (let [record (al-get [JsObject] (.objects (jso-heap)) object)]
        (.internal-index record))
      JSO-NONE))
(defn jso-internal-set-index! [(object i64) (index i64)] (-> i64)
  (if (not (jso-valid? object)) JSO-BAD-OBJECT
      (let [heap (jso-heap)
            (mut record) (al-get [JsObject] (.objects heap) object)]
        (set! (.internal-index record) index)
        (al-set! [JsObject] (field heap objects) object (load record))
        JSO-OK)))

(defn jso-prototype [(object i64)] (-> i64)
  (if (jso-valid? object)
      (let [record (al-get [JsObject] (.objects (jso-heap)) object)]
        (.prototype record))
      JSO-NONE))

(defn jso-own-index-nid [(object i64) (name i64)] (-> i64)
  (let [heap (jso-heap)
        properties (.properties heap)
        record (al-get [JsObject] (.objects heap) object)
        (mut index) (.property-head record)
        (mut found) JSO-NONE]
    (loop (if (or (= (load index) JSO-NONE) (!= (load found) JSO-NONE)) (break)
      (let [entry (al-get [JsProperty] properties (load index))]
        (if (= (.name entry) name)
            (set! found (load index)) 0)
        (set! index (.next entry)))))
    (load found)))

(defn jso-own? [(object i64) (name (slice u8))] (-> bool)
  (let [nid (shape-name-find name)]
    (and (!= nid SHAPE-NO-NAME) (!= (jso-own-index-nid object nid) JSO-NONE))))

;; ECMAScript's ordinary own-key order: canonical array-index strings in ascending numeric order,
;; then the remaining strings in insertion order. Symbols become a third partition when the
;; runtime gains them. These are Torque-style runtime intrinsics: JSL owns the Object.keys loop,
;; while the heap representation owns how an ordinal is resolved to a key.
(defn jso-name-array-index [(name i64)] (-> i64)
  (let [bytes (shape-name-bytes name)
        length (slice-len bytes)
        (mut at) 0
        (mut value) 0
        (mut valid) (> length 0)]
    (if (and (> length 1) (= (cast i64 (slice-get bytes 0)) 48)) (set! valid false) 0)
    (loop (if (or (>= (load at) length) (not (load valid)))
              (break)
              (let [byte (cast i64 (slice-get bytes (load at)))]
                (if (or (< byte 48) (> byte 57))
                    (set! valid false)
                    (do (set! value (+ (* (load value) 10) (- byte 48)))
                        (if (>= (load value) 4294967295) (set! valid false) 0)))
                (set! at (+ (load at) 1)))))
    (if (load valid) (load value) -1)))

(defn jso-own-key-count [(object i64)] (-> i64)
  (if (not (jso-valid? object)) 0
      (let [properties (.properties (jso-heap))
            record (al-get [JsObject] (.objects (jso-heap)) object)
            (mut current) (.property-head record)
            (mut count) 0]
        (loop (if (= (load current) JSO-NONE) (break)
                  (let [entry (al-get [JsProperty] properties (load current))]
                    (set! count (+ (load count) 1))
                    (set! current (.next entry)))))
        (load count))))

;; Returns an interned shape-name id, or SHAPE-NO-NAME when ordinal is out of range.
(defn jso-own-key-at [(object i64) (ordinal i64)] (-> i64)
  (if (or (not (jso-valid? object)) (< ordinal 0)) SHAPE-NO-NAME
      (let [properties (.properties (jso-heap))
            record (al-get [JsObject] (.objects (jso-heap)) object)
            head (.property-head record)
            (mut current) head
            (mut numeric-count) 0]
        (loop (if (= (load current) JSO-NONE) (break)
                  (let [entry (al-get [JsProperty] properties (load current))]
                    (if (>= (jso-name-array-index (.name entry)) 0)
                        (set! numeric-count (+ (load numeric-count) 1)) 0)
                    (set! current (.next entry)))))
        (if (< ordinal (load numeric-count))
            ;; Find the numeric key whose number of smaller numeric keys equals `ordinal`.
            (let [(mut candidate) head (mut answer) SHAPE-NO-NAME]
              (loop (if (or (= (load candidate) JSO-NONE)
                            (!= (load answer) SHAPE-NO-NAME))
                        (break)
                        (let [entry (al-get [JsProperty] properties (load candidate))
                              name (.name entry)
                              index (jso-name-array-index name)]
                          (if (>= index 0)
                              (let [(mut scan) head (mut rank) 0]
                                (loop (if (= (load scan) JSO-NONE) (break)
                                          (let [other (al-get [JsProperty] properties (load scan))
                                                other-index
                                                  (jso-name-array-index (.name other))]
                                            (if (and (>= other-index 0) (< other-index index))
                                                (set! rank (+ (load rank) 1)) 0)
                                            (set! scan (.next other)))))
                                (if (= (load rank) ordinal) (set! answer name) 0)) 0)
                          (set! candidate (.next entry)))))
              (load answer))
            ;; The list is newest-first, so reverse only the non-index string partition.
            (let [string-ordinal (- ordinal (load numeric-count))
                  string-count (- (jso-own-key-count object) (load numeric-count))
                  target (- (- string-count 1) string-ordinal)
                  (mut seen) 0
                  (mut scan) head
                  (mut answer) SHAPE-NO-NAME]
              (loop (if (or (= (load scan) JSO-NONE)
                            (!= (load answer) SHAPE-NO-NAME))
                        (break)
                        (let [entry (al-get [JsProperty] properties (load scan))]
                          (if (< (jso-name-array-index (.name entry)) 0)
                              (do (if (= (load seen) target)
                                      (set! answer (.name entry)) 0)
                                  (set! seen (+ (load seen) 1))) 0)
                          (set! scan (.next entry)))))
              (load answer))))))

(defn jso-store! [(object i64) (name (slice u8)) (value i64)] (-> i64)
  (let [heap (jso-heap)]
    (if (not (jso-valid? object))
        (do (set! (.status heap) JSO-BAD-OBJECT) JSO-BAD-OBJECT)
      (let [nid (shape-name-intern! name) index (jso-own-index-nid object nid)]
      (if (!= index JSO-NONE)
          (let [(mut entry) (al-get [JsProperty] (.properties heap) index)]
            (set! (.value entry) value)
            (al-set! [JsProperty] (field heap properties) index (load entry)))
        (let [(mut record) (al-get [JsObject] (.objects heap) object)]
          (if (.track-shapes heap)
              (if (shape-has-field? (.shape record) name)
                  0
                  (do
                    (set! (.shape record) (shape-transition (.shape record) name (t-dyn)))
                    (al-set! [JsObject] (field heap objects) object (load record))
                    0))
              0)
          (let [property-index (al-len [JsProperty] (.properties heap))]
            (al-push! [JsProperty] (field heap properties)
                      (jso-property-make object nid value (.property-head record)))
            (set! (.property-head record) property-index)
            (al-set! [JsObject] (field heap objects) object (load record)))))
      (set! (.status heap) JSO-OK)
      JSO-OK))))

;; Shapes record allocation/layout history and remain monotone; deletion removes the property-table
;; entry rather than pretending its value became undefined. A later store creates a fresh entry and
;; may reuse the already-known layout transition without making the deleted property observable.
(defn jso-delete! [(object i64) (name (slice u8))] (-> bool)
  (if (not (jso-valid? object)) false
    (let [heap (jso-heap)
          nid (shape-name-find name)]
      (if (= nid SHAPE-NO-NAME) true
        (let [(mut record) (al-get [JsObject] (.objects heap) object)
              (mut current) (.property-head record)
              (mut prior) JSO-NONE
              (mut done) false]
          (loop (if (or (= (load current) JSO-NONE) (load done)) (break true)
            (let [entry (al-get [JsProperty] (.properties heap) (load current))]
              (if (= (.name entry) nid)
                  (do
                    (if (= (load prior) JSO-NONE)
                        (set! (.property-head record) (.next entry))
                        (let [(mut previous)
                                (al-get [JsProperty] (.properties heap) (load prior))]
                          (set! (.next previous) (.next entry))
                          (al-set! [JsProperty] (field heap properties) (load prior) (load previous))))
                    (al-set! [JsObject] (field heap objects) object (load record))
                    (set! done true))
                  (do (set! prior (load current))
                      (set! current (.next entry))))))
          true))))))

(defn jso-load-own-nid [(object i64) (name i64)] (-> i64)
  (let [index (jso-own-index-nid object name)]
    (if (= index JSO-NONE) JSV-UNDEFINED
      (let [entry (al-get [JsProperty] (.properties (jso-heap)) index)]
        (.value entry)))))

(defn jso-load [(object i64) (name (slice u8))] (-> i64)
  (let [nid (shape-name-find name) (mut current) object (mut answer) JSV-UNDEFINED]
    (if (= nid SHAPE-NO-NAME) JSV-UNDEFINED
      (do
        (loop (if (= (load current) JSO-NONE) (break)
          (let [index (jso-own-index-nid (load current) nid)]
            (if (!= index JSO-NONE)
                (let [entry (al-get [JsProperty] (.properties (jso-heap)) index)]
                  (set! answer (.value entry))
                    (set! current JSO-NONE))
              (set! current (jso-prototype (load current)))))))
        (load answer)))))

(defn jso-has? [(object i64) (name (slice u8))] (-> bool)
  (let [nid (shape-name-find name) (mut current) object (mut found) false]
    (if (= nid SHAPE-NO-NAME) false
      (do
        (loop (if (or (= (load current) JSO-NONE) (load found)) (break)
          (do
            (if (!= (jso-own-index-nid (load current) nid) JSO-NONE)
                (set! found true)
                (set! current (jso-prototype (load current)))))))
        (load found)))))

(defn jso-prototype-reaches? [(start i64) (target i64)] (-> bool)
  (let [(mut current) start (mut steps) 0 (mut found) false
        limit (al-len [JsObject] (.objects (jso-heap)))]
    (loop (if (or (= (load current) JSO-NONE) (load found)) (break)
      (do (if (= (load current) target) (set! found true) 0)
          (set! current (jso-prototype (load current)))
          (set! steps (+ (load steps) 1))
          (if (> (load steps) limit) (do (set! found true) (break)) 0))))
    (load found)))

(defn jso-set-prototype! [(object i64) (prototype i64)] (-> i64)
  (let [heap (jso-heap)]
    (if (or (not (jso-valid? object))
            (and (!= prototype JSO-NONE) (not (jso-valid? prototype))))
        (do (set! (.status heap) JSO-BAD-OBJECT) JSO-BAD-OBJECT)
      (if (or (= object prototype) (jso-prototype-reaches? prototype object))
          (do (set! (.status heap) JSO-CYCLE) JSO-CYCLE)
        (let [(mut record) (al-get [JsObject] (.objects heap) object)]
          (set! (.prototype record) prototype)
          (al-set! [JsObject] (field heap objects) object (load record))
          (set! (.status heap) JSO-OK)
          JSO-OK)))))

(defn jso-status [] (-> i64) (.status (jso-heap)))
