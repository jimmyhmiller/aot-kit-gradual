;; Shared deterministic pressure dimensions. Production code does not import this module; parity,
;; phase, stress, and extended suites do so that no individual suite can silently weaken a matrix.
(module testmatrix)

(const MATRIX-NORMAL-SEEDS i64 3)
(const MATRIX-EXTENDED-SEEDS i64 12)
(const MATRIX-REGISTER-BUDGETS i64 3)
(const MATRIX-COLLECTOR-MODES i64 2)

(defn matrix-normal-seed [(i i64)] (-> i64)
  (case i 0 1 1 5 2 7919 -1))

(defn matrix-extended-seed [(i i64)] (-> i64)
  (case i 0
        1 1
        5 2
        7919 3
        15838 4
        23757 5
        31676 6
        39595 7
        47514 8
        55433 9
        63352 10
        71271 11
        79190 -1))

(defn matrix-register-budget [(i i64)] (-> i64)
  (case i 0 8 1 2 2 1 -1))

(defn matrix-collector-mode [(i i64)] (-> i64)
  ; 0 is normal allocation; 1 is collect-before-every-allocation.
  (case i 0 0 1 1 -1))
