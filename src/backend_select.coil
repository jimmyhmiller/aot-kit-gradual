;; Legacy and block-based instruction selection, placement, and selected-IR verification.
(module backend_select)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "monotonic" :as monotonic)

(defn ms-profile-now [] (-> i64)
  (if (be-profiling?) (monotonic/monotonic-now-ns) 0))
(defn ms-profile-note! [(name (slice u8)) (started i64)] (-> i64)
  (if (be-profiling?)
      (let [now (ms-profile-now)]
        (fmt (stderr) "AOTK_PROFILE phase={s} ns={d} nodes={d} functions={d} blocks={d} insts={d} vregs={d}\n"
             name (- now started) (n-count) (mu-function-count) (mu-block-count)
             (be-inst-count) (.next-vreg (machine-unit)))
        now)
      0))

(const BE-EXCEPTION-RETURN-DESCRIPTOR i64 104)

(defn be-exception-return? [(term i64)] (-> bool)
  (and (op-is? term Return [])
       (match (n-op (n-in term 1))
         (JsBuiltin [descriptor] (= descriptor BE-EXCEPTION-RETURN-DESCRIPTOR))
         (_ false))))

;; `-1` MEANS "NO SINGLE TAG", NOT "UNSUPPORTED". The numeric union has two tags and is selected
;; as two tests and an OR at the `TypeTest` site; every other union genuinely has no encoding.
(defn be-js-tag-for-type [(t i64)] (-> i64)
  (case (ty-kinds t) VK-UNDEF
        JSV-UNDEFINED VK-NULL
        JSV-NULL VK-BOOL
        JSV-BOOLEAN VK-INT
        JSV-INTEGER VK-FLT
        0 VK-STR
        JSV-STRING VK-OBJ
        JSV-OBJECT VK-FUN
        JSV-FUNCTION -1))

;; Arrays deliberately retain the ordinary object lattice type: indexing capability is an IR
;; property, not a new source-language nominal type.  Boxing must therefore preserve ArrayMark
;; provenance instead of deriving the tag from the lattice alone.  Casts and homogeneous value
;; Phis retain that provenance; a mixed or unresolved Phi conservatively remains an Object.
;; A CALL'S TARGET SET, AS THE 63 BITS IT ACTUALLY OCCUPIES.
;;
;; A polymorphic call is encoded in `MInst.imm` as the COMPLEMENT of its target set, and
;; `be-poly-call?` recovers which kind of call it is from the SIGN: a negative `imm` is a dispatch,
;; a non-negative one names the owner to call directly. That is injective for every 63-bit set --
;; the complement always has bit 63 set -- and it COLLIDES for exactly one input. An unconstrained
;; `fun` type carries `fidxs` of -1, its complement is 0, and 0 reads as "direct call to owner 0",
;; which is always the entry function.
;;
;; A callable LOADED FROM THE HEAP has precisely that type: nothing narrows it, because closed-world
;; inference does not follow a function through a store. So every such call branched into `main`
;; instead of dispatching -- `{get: () => 7}` then `o.get()` answered 0, and so did every object
;; method in the language, and `[function () { return 42; }][0]()` with it. It was invisible to both
;; derived reports, which sweep methods on built-in receivers and never put a function in the heap.
;;
;; AN UNCONSTRAINED SET IS NOT A SUMMARY, and the encoder already has a value that says so: a
;; recovered `targets` of 0 means "no summary, dispatch over every function in the unit", which is
;; what `be-poly-call-targets` documents and what this case needs. Mapping -1 to 0 makes the
;; complement -1 -- negative, so still a dispatch -- and leaves `ms-call-target-valid?`'s loop over
;; set bits vacuous instead of demanding a function for all 63 indices.
;;
;; Emission and `ms-call-target-valid?` MUST agree on this, which is why it is one function and not
;; two expressions that can drift.
(defn be-call-target-summary [(t i64)] (-> i64)
  (let [fidxs (ty-fun-targets t)]
    (if (< fidxs 0) 0 fidxs)))

(defn be-array-value? [(node i64) (fuel i64)] (-> bool)
  (if (or (= node NO-NODE) (or (<= fuel 0) (n-dead? node)))
      false
      (match (n-op node)
        (ArrayMark [] true)
        (Cast [target] (be-array-value? (n-in node 1) (- fuel 1)))
        ;; AN ARRAY RETURNED FROM A FUNCTION IS STILL AN ARRAY, and nothing here could see that. A
        ;; `Call` has lattice type `dyn`, and the `Cast` the frontend puts on its result carries the
        ;; declared `obj` -- so `(x) => [x, x]` handed back a value this function called an ordinary
        ;; object, the `Box` above it chose `JSV-OBJECT`, and every runtime tag test then disagreed
        ;; with JavaScript: `r instanceof Array` was false and `String(r)` printed "[object Object]"
        ;; where node prints "1,1". `Array.prototype.flatMap` could not be written correctly at all,
        ;; because its append-or-spread step asks exactly this question about a callback's result.
        ;;
        ;; Follow the bounded call graph instead, the way `be-function-return-kind-fuel` does for the
        ;; return ABI and for the same reason. Every reachable target must return an array; a call
        ;; that might land on something else is an ordinary object, which is the conservative answer.
        (Call [_] (be-call-returns-array? node (- fuel 1)))
        (Phi [declared]
            (let [(mut input) 1
                  (mut evidence) false
                  (mut valid) true]
              (loop (if (or (>= (load input) (n-nins node)) (not (load valid)))
                        (break)
                        (let [value (n-in node (load input))]
                          (if (= value node)
                              0
                              (if (be-array-value? value (- fuel 1))
                                  (set! evidence true)
                                  (set! valid false)))
                          (set! input (+ (load input) 1)))))
              (and (load evidence) (load valid))))
        (_ false))))

(defn be-function-returns-array? [(owner i64) (fuel i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut saw) false
        (mut all) true]
    (loop (if (or (>= (load i) count) (not (load all)))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load i)))]
                (if (and (!= term NO-NODE) (op-is? term Return []))
                    (if (be-exception-return? term)
                        0
                        (do (set! saw true)
                            (if (be-array-value? (n-in term 1) fuel) 0 (set! all false))))
                    (set! all false))
                (set! i (+ (load i) 1)))))
    (and (load saw) (load all))))

(defn be-call-returns-array? [(call i64) (fuel i64)] (-> bool)
  (if (<= fuel 0)
      false
      (let [funcs (mu-function-count)
            (mut owner) 0
            (mut saw) false
            (mut all) true]
        (loop (if (or (>= (load owner) funcs) (not (load all)))
                  (break)
                  (let [fun (mu-function-ideal (load owner))]
                    (if (and (!= fun NO-NODE)
                             (and (op-is? fun Fun [_]) (infer-call-reaches-fun? call fun)))
                        (do (set! saw true)
                            (if (be-function-returns-array? (load owner) (- fuel 1))
                                0
                                (set! all false)))
                        0)
                    (set! owner (+ (load owner) 1)))))
        (and (load saw) (load all)))))

(defn be-function-return-kind-fuel [(owner i64) (fuel i64)] (-> i64)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut answer) -1
        (mut exceptional) false
        (mut boxable) true
        (mut consistent) true]
    (loop (if (or (>= (load i) count) (not (load consistent)))
              (break)
              (let [bid (mu-function-return-block owner (load i))
                    term (mu-block-terminator bid)]
                (if (and (!= term NO-NODE) (op-is? term Return []))
                    (if (be-exception-return? term)
                        (set! exceptional true)
                    (let [value (n-in term 1)]
                      (if (op-is? value Call [_])
                          ;; Call nodes have lattice type `dyn` regardless of their eventual native
                          ;; ABI. Looking only at that type labels every delegated numeric return as
                          ;; boxed. Follow the bounded call graph instead; recursive edges exhaust
                          ;; their fuel and contribute no evidence until a concrete return arm does.
                          (let [kind
                                  (if (> fuel 0)
                                      (be-call-return-kind-fuel value (- fuel 1))
                                      -1)]
                            (if (>= kind 0)
                                (if (< (load answer) 0)
                                    (set! answer kind)
                                    (if (!= (load answer) kind)
                                        (if (load boxable)
                                            (set! answer MLK-BOXED)
                                            (set! consistent false))
                                        0))
                                0))
                          (let [kind (if (be-node-fp-value? value)
                                         MLK-SCALAR
                                         (ml-kind-for-source-representation value))]
                            (if (or (be-box-input-already-tagged? value)
                                    (!= (be-js-tag-for-value value) -1))
                                0
                                (set! boxable false))
                            (if (< kind 0)
                                (set! consistent false)
                                (if (< (load answer) 0)
                                    (set! answer kind)
                                    (if (!= (load answer) kind)
                                        (if (load boxable)
                                            ;; Heterogeneous but individually taggable source
                                            ;; returns share the boxed JavaScript return ABI.
                                            (set! answer MLK-BOXED)
                                            (set! consistent false))
                                        0)))))))
                    0)
                (set! i (+ (load i) 1)))))
    (if (load consistent)
        (if (and (< (load answer) 0) (load exceptional)) MLK-BOXED (load answer))
        -1)))

(defn be-function-return-kind [(owner i64)] (-> i64)
  (be-function-return-kind-fuel owner 32))

(defn be-function-fp-return? [(owner i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) count) (load found))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load index)))]
                (if (and (!= term NO-NODE)
                         (and (op-is? term Return [])
                              (and (not (be-exception-return? term))
                              (be-node-fp-value? (n-in term 1)))))
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

(defn be-call-return-kind-fuel [(call i64) (fuel i64)] (-> i64)
  (let [direct (infer-direct-callee-fun call)
        funcs (mu-function-count)
        (mut owner) 0
        (mut answer) -1
        (mut saw) false
        (mut consistent) true]
    ;; An indirect call can dispatch to functions with different natural native return ABIs.
    ;; The backend normalizes each selected result to a tagged JavaScript value after the call.
    (if (= direct NO-NODE)
        (do (set! answer MLK-BOXED) (set! saw true))
        0)
    (loop (if (or (= direct NO-NODE)
                  (or (>= (load owner) funcs) (not (load consistent))))
              (break)
              (let [fun (mu-function-ideal (load owner))]
                (if (and (!= fun NO-NODE)
                         (and (op-is? fun Fun [_])
                              (infer-call-reaches-fun? call fun)))
                    (let [kind (be-function-return-kind-fuel (load owner) fuel)]
                      (set! saw true)
                      (if (< kind 0)
                          (set! consistent false)
                          (if (< (load answer) 0)
                              (set! answer kind)
                              (if (!= (load answer) kind) (set! consistent false) 0))))
                    0)
                (set! owner (+ (load owner) 1)))))
    (if (and (load saw) (load consistent)) (load answer) -1)))

(defn be-call-return-kind [(call i64)] (-> i64)
  (be-call-return-kind-fuel call 32))

(defn be-function-return-mixed? [(owner i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut first) -1
        (mut mixed) false]
    (loop (if (or (>= (load i) count) (load mixed))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load i)))]
                (if (and (!= term NO-NODE) (op-is? term Return []))
                    (if (be-exception-return? term)
                        0
                    (let [value (n-in term 1)]
                      (if (op-is? value Call [_])
                          0
                          (let [kind (if (be-node-fp-value? value)
                                         MLK-SCALAR
                                         (ml-kind-for-source-representation value))]
                            (if (< (load first) 0)
                                (set! first kind)
                                (if (!= (load first) kind) (set! mixed true) 0))))))
                    0)
                (set! i (+ (load i) 1)))))
    (load mixed)))

(defn be-function-return-tag-fuel [(owner i64) (fuel i64)] (-> i64)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut answer) -1
        (mut exceptional) false
        (mut consistent) true]
    (loop (if (or (>= (load i) count) (not (load consistent)))
              (break)
              (let [term (mu-block-terminator (mu-function-return-block owner (load i)))]
                (if (and (!= term NO-NODE) (op-is? term Return []))
                    (if (be-exception-return? term)
                        (set! exceptional true)
                    (let [value (n-in term 1)]
                      (if (op-is? value Call [_])
                          (let [tag
                                  (if (> fuel 0)
                                      (be-call-return-tag-fuel value (- fuel 1))
                                      -1)]
                            (if (>= tag 0)
                                (if (< (load answer) 0)
                                    (set! answer tag)
                                    (if (!= (load answer) tag)
                                        (set! consistent false)
                                        0))
                                0))
                          ;; A lattice type is not a machine representation. `num` has no single
                          ;; static JavaScript tag, but selection has already normalized its Phi
                          ;; to either a GPR integer or an FPR double. Ask the representation-aware
                          ;; value classifier, which makes the same decision used when boxing the
                          ;; return at the call boundary.
                          (let [tag (be-js-tag-for-value value)]
                            (if (< tag 0)
                                (set! consistent false)
                                (if (< (load answer) 0)
                                    (set! answer tag)
                                    (if (!= (load answer) tag)
                                        (set! consistent false)
                                        0)))))))
                    0)
                (set! i (+ (load i) 1)))))
    (if (load consistent)
        (if (and (< (load answer) 0) (load exceptional)) JSV-UNDEFINED (load answer))
        -1)))

(defn be-function-return-tag [(owner i64)] (-> i64)
  (be-function-return-tag-fuel owner 32))

(defn be-call-return-tag-fuel [(call i64) (fuel i64)] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0
        (mut answer) -1
        (mut saw) false
        (mut consistent) true]
    (loop (if (or (>= (load owner) funcs) (not (load consistent)))
              (break)
              (let [fun (mu-function-ideal (load owner))]
                (if (and (!= fun NO-NODE)
                         (and (op-is? fun Fun [_])
                              (infer-call-reaches-fun? call fun)))
                    (let [tag (be-function-return-tag-fuel (load owner) fuel)]
                      (set! saw true)
                      (if (< tag 0)
                          (set! consistent false)
                          (if (< (load answer) 0)
                              (set! answer tag)
                              (if (!= (load answer) tag) (set! consistent false) 0))))
                    0)
                (set! owner (+ (load owner) 1)))))
    (if (and (load saw) (load consistent)) (load answer) -1)))

(defn be-call-return-tag [(call i64)] (-> i64)
  (be-call-return-tag-fuel call 32))

;; A VALUE THAT SPANS REPRESENTATION CLASSES CANNOT BE RAW, and that is a fact about machines
;; rather than a heuristic. There are three raw forms -- a number in a register, a string pointer,
;; an object pointer -- and `undefined`, `null` and `true` have no raw form at all. So a kind set
;; touching two of these classes, or touching the class that has no raw form, describes a value that
;; can only be a TAGGED word, whatever the type lattice says beyond that.
;;
;; This is what lets `String(x)` compile for `undefined|number`, the shape every `codePointAt` and
;; `at` produces: the frontend is right that the value is not a plain number, and the runtime's
;; tag dispatch is exactly the thing that can print it.
(defn be-kinds-must-be-tagged? [(t i64)] (-> bool)
  (let [k (ty-kinds t)
        numeric (if (!= (& k VK-NUM) 0) 1 0)
        string (if (!= (& k VK-STR) 0) 1 0)
        pointer (if (!= (& k (| VK-OBJ VK-FUN)) 0) 1 0)
        ;; `undefined`, `null` and `true` are their own class: each has an immediate form that a
        ;; `Box` turns into the tagged word, so ALONE they are not already tagged.
        tagonly (if (!= (& k (| (| VK-UNDEF VK-NULL) (| VK-BOOL (| VK-SYM VK-BIG)))) 0) 1 0)]
    ;; STRICTLY MORE THAN ONE CLASS. The first version of this said `tagonly` alone was enough and
    ;; was wrong in the way that matters: `Box(Const undefined)` became a no-op, the immediate
    ;; flowed on untagged, and `String(v.at(99))` printed one character where node prints
    ;; "undefined". It compiled, ran, and answered 7 instead of 15 --
    ;; `tests/native-execution-test.coil` is what said so. One class means a raw form exists and
    ;; the box is doing real work; two or more means no raw form covers the value at all.
    (> (+ numeric (+ string (+ pointer tagonly))) 1)))

(defn be-js-tag-for-value [(node i64)] (-> i64)
  ;; A materialized closure's VALUE is its environment object pointer; boxing it must produce
  ;; a CLOSURE-tagged word. The generic dispatcher recognizes that tag and reads the callable id
  ;; from the environment's __closure_target field — a function tag would send the environment
  ;; pointer down the bare-function payload path, while an object tag makes `typeof` and IsCallable
  ;; deny that it is a function at all.
  (if (match (n-op node)
        (Closure [captures] (= (n-nins node) (+ captures 3)))
        (_ false))
      JSV-CLOSURE
  (if (be-array-value? node 64)
      JSV-ARRAY
      (if (ml-raw-nullable-value? node 32)
          JSV-RAW-NULLABLE-OBJECT
          (if (and (op-is? node Call [_]) (!= (be-call-return-kind node) MLK-BOXED))
              (be-call-return-tag node)
          (if (and (op-is? node Parm [_])
               (= (ml-kind-for-parm-representation node) MLK-RAW-MANAGED))
          JSV-OBJECT
          (let [tag (be-js-tag-for-type (n-ty node))]
            ;; The numeric lattice includes int|float, but each selected value still has one
            ;; concrete machine representation. Arithmetic with integer inputs is an integer word;
            ;; arithmetic selected onto FP registers is an untagged IEEE double (tag zero in the
            ;; JavaScript ABI). Derive this case from selection representation rather than rejecting
            ;; a sound numeric join as unboxable.
            (if (and (= tag -1) (ty-numeric? (n-ty node)))
                (if (be-node-fp-value? node) 0 JSV-INTEGER)
                tag))))))))

(defn be-box-input-already-tagged? [(node i64)] (-> bool)
  ;; A raw managed pointer remains raw regardless of the liveness class assigned to values that
  ;; eventually cross a dynamic boundary.
  (if (= (n-rep-of node 32) REP-RAW-PTR)
      false
  (if (op-is? node Box [_])
      true
  (if (op-is? node Call [_])
      (= (be-call-return-kind node) MLK-BOXED)
      (or (be-kinds-must-be-tagged? (n-ty node))
          (= (ml-kind-for-node node) MLK-BOXED))))))

(defn be-float-only? [(t i64)] (-> bool)
  (= (ty-kinds t) VK-FLT))
(defn be-float-bits [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-fbits v))
    (TBot [] 0)
    (TTop [] 0)
    (TCtrl [] 0)
    (TXCtrl [] 0)
    (TTuple [o l] 0)
    (TMem [a c] 0)))

(defn be-fp-op [(op Op)] (-> i64)
  (match op
    (Add [] MI-FADD)
    (Sub [] MI-FSUB)
    (Mul [] MI-FMUL)
    (Div [] MI-FDIV)
    (Eq [] MI-FEQ)
    (Lt [] MI-FLT)
    (Le [] MI-FLE)
    (_ -1)))

(defn be-parm-fp-value? [(node i64)] (-> bool)
  (let [fun (n-in node 0)
        slot (n-parm-index node)
        (mut at) 0
        (mut found) false
        (mut all-fp) true]
    ;; Machine CFG discovery already retains every live ideal Call in node order. Scanning that
    ;; compact list preserves the exact query while avoiding one whole-graph pass per Parm.
    (loop (if (>= (load at) (al-len [i64] (.ideal-calls (machine-unit))))
              (break)
              (do
                (let [call (al-get [i64] (.ideal-calls (machine-unit)) (load at))]
                  (if (and (> (n-nins call) (+ slot 2)) (= (n-in call 1) fun))
                    (let [actual (n-in call (+ slot 2))]
                      (do
                        (set! found true)
                        (if (not (be-float-only? (n-ty actual))) (set! all-fp false) 0)
                        0))
                    0))
                (set! at (+ (load at) 1))
                0)))
    ;; A parameter whose declared lattice admits tagged JavaScript values must preserve that ABI
    ;; even if one exact caller happens to pass a float. JavaScript-callable JSL adapters are reused
    ;; by heterogeneous dynamic sites; choosing FP from ANY caller made FunctionCall2 unbox later
    ;; function-valued arguments as doubles. Only an untagged parameter with uniformly FP actuals
    ;; may use an FPR.
    (let [kinds (ty-kinds (n-ty node))]
      (and (!= (& kinds VK-NUM) 0)
           (and (= (& kinds (^ VK-NUM -1)) 0)
                (and (load found) (load all-fp)))))))

(defn be-fp-grow! [] (-> i64)
  (let [u (machine-unit)
        need (n-count)]
    (loop (if (>= (al-len [i64] (.fp-mark u)) need)
              (break)
              (do
                (al-push! [i64] (field u fp-mark) 0)
                (al-push! [bool] (field u fp-known) false)
                (al-push! [bool] (field u fp-value) false)
                0)))
    0))

;; A node is floating-point at the source: nothing below it needs looking at. `OPTAG-PARM` is terminal
;; either way — a parameter's representation comes from the actual arguments, not from its own type.
(defn be-fp-source? [(node i64)] (-> bool)
  (match (n-op node)
    (Mod [] true)
    (Parm [_] (be-parm-fp-value? node))
    (Div [] (or (be-float-only? (n-ty node)) (not (ty-int-only? (n-ty node)))))
    (_ (be-float-only? (n-ty node)))))

;; The operands whose representation this node's own representation is derived from.
(defn be-fp-push-operands! [(node i64)] (-> i64)
  (let [u (machine-unit)]
    (if (op-is? node Phi [_])
        ;; Loop Phis are initially bounded by the declared TypeScript type. A numeric backedge can
        ;; nevertheless require an FPR (for example an integer accumulator updated by a
        ;; floating-point call result), so every incoming value counts. The mark array terminates
        ;; the loop-carried cycle.
        (let [(mut input) 1]
          (loop (if (>= (load input) (n-nins node))
                    (break)
                    (do
                      (al-push! [i64] (field u fp-stack) (n-in node (load input)))
                      (set! input (+ (load input) 1))
                      0)))
          0)
        (if (or (op-is? node Add []) (or (op-is? node Sub [])
                (or (op-is? node Mul []) (op-is? node Div []))))
            (do
              (al-push! [i64] (field u fp-stack) (n-in node 1))
              (al-push! [i64] (field u fp-stack) (n-in node 2))
              0)
            (if (op-is? node Minus [])
                (do (al-push! [i64] (field u fp-stack) (n-in node 1)) 0)
                (if (op-is? node Call [_])
                    (let [callee (n-in node 1)
                          target (if (op-is? callee Closure [_]) (n-in callee 0) callee)]
                      (if (op-is? target Fun [_])
                          (let [(mut input) 1]
                            (loop (if (>= (load input) (n-nins target))
                                      (break)
                                      (do
                                        (let [ret (n-in target (load input))]
                                          (if (and (!= ret NO-NODE) (op-is? ret Return []))
                                              (do
                                                (al-push! [i64] (field u fp-stack) (n-in ret 1))
                                                0)
                                              0))
                                        (set! input (+ (load input) 1))
                                        0)))
                            0)
                          0))
                    0))))))

;; Does a floating-point value reach `node`? That is REACHABILITY over the operand graph, and the
;; marked walk below answers it for an expression of any depth. It used to be a recursion carrying
;; eight units of fuel, which answered "no" as soon as the chain was longer than that — and the
;; answer decides the representation, so the two sides of one expression could disagree about it.
;; A sum of ten terms whose first was a boxed array element selected floating-point ADDs for the
;; accumulator and then an SCVTF on the register already holding it, so the arithmetic read a
;; general-purpose register nothing had written: wrong, and differently wrong on each run. Depth is
;; not something a representation may depend on, so there is no bound here to raise.
(defn be-node-fp-value? [(node i64)] (-> bool)
  (block :done
  (let [u (machine-unit)]
    (be-fp-grow!)
    (if (al-get [bool] (.fp-known u) node)
        (return-from :done (al-get [bool] (.fp-value u) node))
        0)
    ;; The mark array and the stack are ONE buffer shared by every call, so a walk inside a walk
    ;; would truncate the outer one and answer from a graph it never finished looking at. Nothing
    ;; reentrant calls this today, and a named abort is what keeps that true rather than remembered.
    (if (.fp-busy u)
        (do (panic-corrupt "be-node-fp-value?: reentrant operand walk; the mark and stack are shared") 0)
        0)
    (set! (.fp-busy u) true)
    (set! (.fp-gen u) (+ (.fp-gen u) 1))
    (let [gen (.fp-gen u)
          (mut found) false]
      (al-clear! [i64] (field u fp-stack))
      (al-push! [i64] (field u fp-stack) node)
      (loop (let [depth (al-len [i64] (.fp-stack u))]
              (if (or (load found) (= depth 0))
                  (break)
                  (let [m (al-get (.fp-stack u) (- depth 1))]
                    (al-pop! [i64] (field u fp-stack))
                    (if (or (= m NO-NODE) (= (al-get (.fp-mark u) m) gen))
                        0
                        (do
                          (al-set! [i64] (field u fp-mark) m gen)
                          (if (be-fp-source? m)
                              (set! found true)
                              (be-fp-push-operands! m))
                          0))))))
      (set! (.fp-busy u) false)
      (al-set! [bool] (field u fp-known) node true)
      (al-set! [bool] (field u fp-value) node (load found))
      (load found)))))

; Frontend dynamic values cross the JavaScript-value ABI at these nodes. Hand-written
; backend fixtures also use t-dyn for unconstrained machine integers, so type alone is
; not enough to justify a runtime JavaScript equality or truthiness call.
;
; THE FIRST QUESTION IS `n-rep-of`, and the hand-written list below is only what it cannot answer.
; A value that is certainly TAGGED is a JavaScript value by construction, so keeping a second,
; shorter list of "which ops produce one" was a copy that drifted -- and it did: `PropLoadKey` sat
; beside `PropLoad` in `n-rep-of` as REP-TAGGED and was missing here, so `o[k]` read back a stored
; `false`, took the RAW word as an If predicate, and a tagged false is a non-zero bit pattern.
; `o[k] ? 100 : 200` answered 100 while `String(o[k])` printed "false" and `o.a` was right.
;
; The list survives for the ops `n-rep-of` leaves UNKNOWN because their representation is not
; structural: a `Call`'s result is whatever the callee returns, and a `Phi` with an absent or mixed
; arm has no single answer yet.
(defn be-js-dynamic-boundary? [(node i64)] (-> bool)
  (if (= (n-rep-of node 8) REP-TAGGED)
      true
      (match (n-op node)
        (Call [_] true) (PropLoad [_] true) (ArrayLoad [_] true) (Box [_] true) (Phi [_] true)
        (_ false))))

(defn graph-arg-index [(n i64)] (-> i64)
  (al-get [i64] (.arg-abi-index (machine-unit)) n))

(defn graph-parm-position-fp? [(fun i64) (position i64)] (-> bool)
  (block :done
    ;; Prefer a surviving Parm. If optimization removed that parameter, recover its ABI class from
    ;; a closed-world call argument: dead parameters still occupy their declared register slot.
    (let [(mut i) 0]
      (loop (if (>= (load i) (n-nouts fun)) (break)
              (do
                (let [use (n-out fun (load i))]
                  (if (and (not (n-dead? use))
                           (and (op-is? use Parm [_]) (= (n-parm-index use) position)))
                    (return-from :done (be-node-fp-value? use))
                    0)
                  0)
                (store! i (+ (load i) 1))))))
    (let [(mut call) 0]
      (loop (if (>= (load call) (al-len [i64] (.ideal-calls (machine-unit)))) (break)
              (do
                (let [call-node (al-get [i64] (.ideal-calls (machine-unit)) (load call))
                      source (infer-parm-source call-node fun position)]
                  (if (!= source NO-NODE)
                      (return-from :done (be-node-fp-value? source))
                      0))
                (store! call (+ (load call) 1))))))
    false))

(defn graph-parm-abi-index [(n i64)] (-> i64)
  (let [u (machine-unit)
        cached (al-get [i64] (.parm-abi-index u) n)]
    (if (>= cached 0)
        cached
        (let [fun (n-in n 0)
              want-fp (be-node-fp-value? n)
              limit (n-parm-index n)
              (mut position) 0
              (mut idx) 0]
          (loop (if (>= (load position) limit)
                    (break)
                    (do
                      (if (= (graph-parm-position-fp? fun (load position)) want-fp)
                          (set! idx (+ (load idx) 1))
                          0)
                      (set! position (+ (load position) 1)))))
          (al-set! [i64] (field u parm-abi-index) n (load idx))
          (load idx)))))

(defn graph-parm-stack-index [(n i64)] (-> i64)
  (let [u (machine-unit)
        cached (al-get [i64] (.parm-stack-index u) n)]
    (if (>= cached 0)
        cached
        (let [fun (n-in n 0)
              (mut i) 0
              (mut idx) 0]
          (loop (if (>= (load i) (n-nouts fun))
                    (break)
                    (do
                      (let [use (n-out fun (load i))]
                        (if (and (not (n-dead? use))
                                 (and (op-is? use Parm [_])
                                      (and (< use n)
                                           (>= (graph-parm-abi-index use) 8))))
                            (set! idx (+ (load idx) 1))
                            0))
                      (set! i (+ (load i) 1)))))
          (al-set! [i64] (field u parm-stack-index) n (load idx))
          (load idx)))))

(defn graph-new-index [(n i64)] (-> i64)
  (al-get [i64] (.new-index (machine-unit)) n))

(defn be-field-off [(alias i64)] (-> i64)
  (if (shape-alias-defined? alias) (shape-alias-offset alias) (* (% alias 16) 8)))

(defn be-inst-count [] (-> i64)
  (al-len [MInst] (.ins (backend))))
(defn be-inst [(i i64)] (-> (ptr MInst))
  (be-al-elem [MInst] (field (backend) ins) i))

; ---------------------------------------------------------------------------
; G2 block-based selection. This path consumes the verified MachineUnit. It deliberately does
; not call the legacy diamond/loop selectors above; later milestones lower its block terminators.
; ---------------------------------------------------------------------------

(defn ms-result [] (-> i64)
  (.selection-result (machine-unit)))
(defn ms-result-item [] (-> i64)
  (.selection-item (machine-unit)))
(defn ms-result-item-is-machine? [] (-> bool)
  ;; Phase 2 begins only after construction and GCM have completed, immediately before optional
  ;; machine verification. Construction failures carry ideal nodes (or CFG items); verifier
  ;; failures carry machine-instruction indices. Numeric range cannot distinguish those domains.
  (= (.phase (machine-unit)) 2))

(defn ms-fail! [(code i64) (item i64)] (-> i64)
  (let [u (machine-unit)]
    (if (= (.selection-result u) MSEL-OK)
        (do
          (set! (.selection-result u) code)
          (set! (.selection-item u) item))
        0)
    -1))

(defn ms-map-index [(owner i64) (node i64)] (-> i64)
  node)

(defn ms-map-init! [] (-> i64)
  (let [u (machine-unit)
        total (n-count)
        (mut i) 0
        (mut arg-gpr) 0
        (mut arg-fp) 0
        (mut next-new) 0]
    (al-clear! [i64] (field u selected-value-owners))
    (al-clear! [i64] (field u selected-node-owners))
    (al-clear! [i64] (field u selected-block-owners))
    (al-clear! [i64] (field u arg-abi-index))
    (al-clear! [i64] (field u parm-abi-index))
    (al-clear! [i64] (field u parm-stack-index))
    (al-clear! [i64] (field u new-index))
    ;; Keep value storage at its high-water mark. Only owner tags need resetting, and those are
    ;; node-dense rather than function*node-dense.
    (set! i (al-len [i64] (.selected-values u)))
    (loop (if (>= (load i) total)
              (break)
              (do
                (al-push! [i64] (field u selected-values) -1)
                (al-push! [i64] (field u selected-nodes) 0)
                (al-push! [i64] (field u selected-blocks) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) total)
              (break)
              (do
                (al-push! [i64] (field u selected-value-owners) -1)
                (al-push! [i64] (field u selected-node-owners) -1)
                (al-push! [i64] (field u selected-block-owners) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) (n-count))
              (break)
              (do
                (let [node (load i)
                      arg-index
                        (if (and (not (n-dead? node))
                                 (and (op-is? node Arg [_])
                                      (and (not (ty-mem? (n-arg-type node)))
                                           (and (> (n-nins node) 0)
                                                (= (n-in node 0) (g-start))))))
                            (if (be-float-only? (n-ty node))
                                (let [index (load arg-fp)]
                                  (set! arg-fp (+ index 1))
                                  index)
                                (let [index (load arg-gpr)]
                                  (set! arg-gpr (+ index 1))
                                  index))
                            -1)
                      allocation-index
                        (if (and (not (n-dead? node)) (op-is? node New [_]))
                            (let [index (load next-new)]
                              (set! next-new (+ index 1))
                              index)
                            -1)]
                  (al-push! [i64] (field u arg-abi-index) arg-index)
                  (al-push! [i64] (field u parm-abi-index) -1)
                  (al-push! [i64] (field u parm-stack-index) -1)
                  (al-push! [i64] (field u new-index) allocation-index))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn ms-vget [(owner i64) (node i64)] (-> i64)
  (let [u (machine-unit) index (ms-map-index owner node)]
    (if (= (al-get (.selected-value-owners u) index) owner)
        (al-get (.selected-values u) index)
        -1)))
(defn ms-vset! [(owner i64) (node i64) (vreg i64)] (-> i64)
  (let [u (machine-unit) index (ms-map-index owner node)]
    (al-set! [i64] (field u selected-values) index vreg)
    (al-set! [i64] (field u selected-value-owners) index owner)
    (if (and (>= vreg 0) (< vreg (al-len [i64] (.vreg-node u))))
        (do
          (al-set! [i64] (field u vreg-node) vreg node)
          (al-set! [i64] (field u vreg-node-owner) vreg owner)
          0)
        0))
  0)
(defn ms-new-vreg! [] (-> i64)
  (let [u (machine-unit)
        p (field u next-vreg)
        v (load p)]
    (set! p (+ v 1))
    (al-push! [i64] (field u vreg-phi-block) -1)
    (al-push! [i64] (field u vreg-node) -1)
    (al-push! [i64] (field u vreg-node-owner) -1)
    (al-push! [i64] (field u vreg-def-inst) -1)
    v))

;; The dense-array runtime takes an INTEGER index in a GPR. An index computed in floating
;; point (NavierStokes' j*rowSize chains) selects into an FPR vreg, and encoding that FPR's
;; number in the instruction's GPR field silently truncated d8 (physical 40) to x8. Convert
;; through the JavaScript ToInt32 residue instead.
(defn ms-array-index! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [raw (ms-select-value-at! owner node bid)]
    (if (or (< raw 0) (not (be-node-fp-value? node)))
        raw
        (let [fresh (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new MI-I32FROMFP fresh raw -1 0 NO-NODE))
          fresh))))
(defn ms-seen? [(owner i64) (node i64)] (-> bool)
  (let [u (machine-unit)]
    (= (al-get (.selected-node-owners u) (ms-map-index owner node)) owner)))
(defn ms-seen! [(owner i64) (node i64)] (-> i64)
  (let [u (machine-unit)]
    (al-set! [i64] (field u selected-node-owners) (ms-map-index owner node) owner))
  0)

(defn ms-selected-block [(owner i64) (node i64)] (-> i64)
  (let [u (machine-unit) index (ms-map-index owner node)]
    (if (= (al-get (.selected-block-owners u) index) owner)
        (al-get (.selected-blocks u) index)
        -1)))

(defn ms-record-selected-block! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [u (machine-unit) index (ms-map-index owner node)]
    (al-set! [i64] (field u selected-blocks) index bid)
    (al-set! [i64] (field u selected-block-owners) index owner)
    0))

;; The whole-program graph root is the kernel's entry control. Other unmapped or foreign controls
;; must remain rejected so instructions cannot leak across function owners.
(defn ms-node-block [(owner i64) (node i64)] (-> i64)
  (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
    (if (= ctrl NO-NODE)
        (ms-entry-block owner)
        (if (and (= owner 0) (= ctrl (g-start)))
            (ms-entry-block owner)
            (let [mapped (al-get (.ctrl-block (machine-unit)) ctrl)]
              (if (and (>= mapped 0) (= (mu-block-owner mapped) owner))
                  mapped
                  -1))))))

(defn ms-emit! [(owner i64) (bid i64) (m MInst)] (-> i64)
  (let [u (machine-unit)
        id (be-emit! m)
        p (be-inst id)]
    (set! (.owner p) owner)
    (set! (.block-id p) bid)
    (if (and (>= (.dst p) 0)
             (= (al-get [i64] (.vreg-def-inst u) (.dst p)) -1))
        (al-set! [i64] (field u vreg-def-inst) (.dst p) id)
        0)
    id))

(defn ms-push-memory-dep-tree! [(first i64) (node i64) (fuel i64)] (-> i64)
  (if (or (< node 0) (<= fuel 0))
      0
      (let [deps (field (machine-unit) selection-memory-deps)
            (mut scan) first
            (mut seen) false]
        (loop (if (or (>= (load scan) (al-len [i64] (load deps))) (load seen))
                  (break)
                  (do
                    (if (= (al-get [i64] (load deps) (load scan)) node)
                        (set! seen true)
                        0)
                    (set! scan (+ (load scan) 1)))))
        (if (load seen)
            0
            (do
              (al-push! [i64] (mut deps) node)
              (match (n-op node)
                (MemMerge [] (let [(mut i) 1]
                      (loop (if (>= (load i) (n-nins node))
                                (break)
                                (do
                                  (ms-push-memory-dep-tree!
                                    first (n-in node (load i)) (- fuel 1))
                                  (set! i (+ (load i) 1)))))))
                (Store [alias] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (PropStore [name] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (PropDelete [name] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (PropStoreKey [_] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (PropDeleteKey [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (SetProto [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (ObjectFreeze [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (InternalStore [operation] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (ArrayStore [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (ArrayResize [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (ArrayCopy [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (StringSplit [] (ms-push-memory-dep-tree! first (n-in node 1) (- fuel 1)))
                (_ 0))
              0)))))

(defn ms-add-memory-deps! [(at i64) (node i64) (first-slot i64) (count i64)] (-> i64)
  (let [u (machine-unit)
        m (be-inst at)
        first (al-len [i64] (.selection-memory-deps u))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (ms-push-memory-dep-tree! first
                                          (n-in node (+ first-slot (load i)))
                                          16384)
                (set! i (+ (load i) 1))
                0)))
    (set! (.mem-first m) first)
    (set! (.mem-count m) (- (al-len [i64] (.selection-memory-deps u)) first))
    0))

(defn ms-add-call-args! [(at i64) (first i64) (count i64)] (-> i64)
  (let [m (be-inst at)]
    (set! (.arg-first m) first)
    (set! (.arg-count m) count)
    0))

(defn ms-add-single-arg! [(at i64) (value i64)] (-> i64)
  (let [u (machine-unit)
        first (al-len [i64] (.call-args u))]
    (al-push! [i64] (field u call-args) value)
    (ms-add-call-args! at first 1)))

(defn ms-entry-block [(owner i64)] (-> i64)
  (mu-function-block owner 0))

;; A CallEnd is an intra-block control dependency, not merely a block owner. Preserve the chain
;; before selecting a later safepoint/effect; otherwise recursive object construction can schedule
;; the parent New before the calls that compute its fields. Besides changing source evaluation
;; order, that exposes a partially initialized parent to moving collection.
(defn ms-select-control-effects! [(owner i64) (ctrl i64) (bid i64)] (-> bool)
  (if (or (< ctrl 0) (not (op-is? ctrl CallEnd [])))
      true
      (if (not (ms-select-control-effects! owner (n-in ctrl 0) bid))
          false
          (>= (ms-select-value-at! owner (n-in ctrl 1) bid) 0))))

;; The nearest control anchor a VALUE is pinned under: its own control input when it has one,
;; through Proj to the allocation, else the deepest anchor among its inputs. Floating chains
;; (constants, pure arithmetic over Parms) answer -1 and constrain nothing.
(defn ms-value-anchor-block [(owner i64) (node i64) (fuel i64)] (-> i64)
  (if (or (= node NO-NODE) (<= fuel 0))
      -1
      (if (op-is? node Proj [_])
          (ms-value-anchor-block owner (n-in node 0) (- fuel 1))
          (if (and (> (n-nins node) 0) (!= (n-in node 0) NO-NODE))
              (ms-node-block owner node)
              (let [(mut best) -1 (mut i) 1]
                (loop (if (>= (load i) (n-nins node))
                          (break)
                          (do
                            (let [ib (ms-value-anchor-block owner (n-in node (load i)) (- fuel 1))]
                              (if (and (>= ib 0)
                                       (or (< (load best) 0)
                                           (and (!= ib (load best))
                                                (mu-dominates? (load best) ib))))
                                  (set! best ib)
                                  0))
                            (set! i (+ (load i) 1))
                            0)))
                (load best))))))

;; A floating memory op's chain root can DOMINATE one of its value operands — NavierStokes
;; stores each `new Array` allocation into a capture cell whose alias chain roots at function
;; entry, so the Store's chain block sat ABOVE the allocation it stores. The op cannot execute
;; before its operands exist; lower the placement to the deepest operand anchor the chain block
;; dominates.
(defn ms-memory-operand-bound [(owner i64) (node i64) (chain i64)] (-> i64)
  (if (< chain 0)
      chain
      (let [(mut best) chain (mut i) 2]
        (loop (if (>= (load i) (n-nins node))
                  (break)
                  (do
                    (let [ib (ms-value-anchor-block owner (n-in node (load i)) 16)]
                      (if (and (>= ib 0)
                               (and (!= ib (load best)) (mu-dominates? (load best) ib)))
                          (set! best ib)
                          0))
                    (set! i (+ (load i) 1))
                    0)))
        (load best))))

;; WHICH FUNCTION A MEMORY STATE BELONGS TO, or -1 when nothing in its chain says.
;;
;; `ms-node-block` answers "this owner's entry block" for any node with NO control input, and a
;; memory node usually has none -- slot 0 of `Store`/`Load`/`MemMerge` is a control anchor that is
;; null in practice. That is a sensible PLACEMENT default and a useless OWNERSHIP test, and
;; `ms-preselect-function!`'s dynamic-effect sweep was using it as one: it walks every node in the
;; graph, so a store belonging to `main` answered "entry block of owner 1" and was adopted by a
;; JSL builtin. Selecting it there then walked a chain into a memory `Phi` on one of `main`'s
;; loops, which `ms-preallocate-phis!` had marked seen for `main` and not for that owner, and the
;; whole program was refused with MSEL-UNSUPPORTED. `forEach` and `flatMap` in one function was
;; the witness.
;;
;; The chain DOES say, one step further along: a `Phi`'s region, an `Arg`'s anchor and any pinned
;; effect's control all map to a block, and a block names its function. `MemMerge` has no control
;; of its own, so ask its inputs.
(defn ms-memory-chain-owner-fuel [(node i64) (fuel i64)] (-> i64)
  (if (or (< node 0) (<= fuel 0))
      -1
      (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)
            direct
              (if (= ctrl NO-NODE)
                  -1
                  (let [mapped (al-get (.ctrl-block (machine-unit)) ctrl)]
                    (if (>= mapped 0) (mu-block-owner mapped) -1)))]
        (if (>= direct 0)
            direct
            (match (n-op node)
              (MemMerge []
                (let [(mut i) 1
                      (mut answer) -1]
                  (loop (if (or (>= (load i) (n-nins node)) (>= (load answer) 0))
                            (break)
                            (do
                              (set! answer
                                    (ms-memory-chain-owner-fuel (n-in node (load i)) (- fuel 1)))
                              (set! i (+ (load i) 1))
                              0)))
                  (load answer)))
              (_ (if (and (ms-linear-memory-effect? node) (> (n-nins node) 1))
                     (ms-memory-chain-owner-fuel (n-in node 1) (- fuel 1))
                     -1)))))))

(defn ms-memory-chain-owner [(node i64)] (-> i64)
  (ms-memory-chain-owner-fuel node 64))

(defn ms-memory-block [(owner i64) (node i64)] (-> i64)
  ;; Memory operations put their memory dependency, not control, in input 0. Placing one from
  ;; ms-node-block would therefore confuse a loop Memory Phi with the operation's control block
  ;; and can sink a preheader store into the loop. Follow the ordered memory chain first; only
  ;; control-bearing roots and ordinary values use their direct block mapping.
  (let [pinned
          (if (and (> (n-nins node) 0) (!= (n-in node 0) NO-NODE))
              (ms-node-block owner node)
              -1)
        (mut current) node
        (mut answer) -1
        (mut done) false]
    ;; Real programs have long property-memory chains, so walk iteratively instead of consuming
    ;; the native compiler stack once per source effect.
    (if (>= pinned 0) (do (set! answer pinned) (set! done true)) 0)
    (loop (if (load done)
              (break)
              (match (n-op (load current))
                (Store [alias] (set! current (n-in (load current) 1)))
                (Load [alias] (set! current (n-in (load current) 1)))
                (PropStore [name] (set! current (n-in (load current) 1)))
                (PropDelete [name] (set! current (n-in (load current) 1)))
                (SetProto [] (set! current (n-in (load current) 1)))
                (PropLoad [name] (set! current (n-in (load current) 1)))
                (PropHas [name] (set! current (n-in (load current) 1)))
                (ProtoHas [] (set! current (n-in (load current) 1)))
                (PropLoadKey [_] (set! current (n-in (load current) 1)))
                (PropHasKey [] (set! current (n-in (load current) 1)))
                (OwnKeyCount [] (set! current (n-in (load current) 1)))
                (OwnKeyAt [] (set! current (n-in (load current) 1)))
                (PropStoreKey [_] (set! current (n-in (load current) 1)))
                (PropDeleteKey [] (set! current (n-in (load current) 1)))
                (ObjectFreeze [] (set! current (n-in (load current) 1)))
                (InternalLoad [slot] (set! current (n-in (load current) 1)))
                (InternalStore [operation] (set! current (n-in (load current) 1)))
                (ArrayStore [] (set! current (n-in (load current) 1)))
                (ArrayResize [] (set! current (n-in (load current) 1)))
                (ArrayLoad [alias] (set! current (n-in (load current) 1)))
                (ArrayLen [] (set! current (n-in (load current) 1)))
                (ArrayCopy [] (set! current (n-in (load current) 1)))
                (StringSplit [] (set! current (n-in (load current) 1)))
                (Proj [slot] (do
                      (set! answer
                            (if (match (n-op (n-in (load current) 0)) (New [shape] true) (_ false))
                                (ms-node-block owner (n-in (load current) 0))
                                (ms-node-block owner (load current))))
                      (set! done true)))
                (_ (do
                        (set! answer (ms-node-block owner (load current)))
                        (set! done true))))))
    ; Only shaped cell/field stores take the operand bound: their alias chains legitimately
    ; root at function entry while the stored allocation is pinned deeper. Property-table ops
    ; can carry values from a SIBLING branch arm (the value crosses the merge in a register),
    ; and lowering them to that arm breaks the memory Phi they feed. A reader chained directly
    ; after a sunk store must then sink with it, so its chain PREDECESSOR bounds it too.
    (if (>= pinned 0)
        (load answer)
        (let [bounded
                (if (op-is? node Store [_])
                    (ms-memory-operand-bound owner node (load answer))
                    (load answer))
              mem-in (if (> (n-nins node) 1) (n-in node 1) NO-NODE)
              pred-block
                (if (and (!= mem-in NO-NODE)
                         (and (!= mem-in node) (op-is? mem-in Store [_])))
                    (ms-memory-block owner mem-in)
                    -1)]
          (if (and (>= pred-block 0)
                   (and (>= bounded 0)
                        (and (!= pred-block bounded)
                             (mu-dominates? bounded pred-block))))
              pred-block
              bounded)))))

(defn ms-memory-chain-phi? [(node i64)] (-> bool)
  (if (< node 0)
      false
      (match (n-op node)
        (Phi [declared] true)
        (Store [alias] (ms-memory-chain-phi? (n-in node 1)))
        (PropStore [name] (ms-memory-chain-phi? (n-in node 1)))
        (PropDelete [name] (ms-memory-chain-phi? (n-in node 1)))
        (PropStoreKey [_] (ms-memory-chain-phi? (n-in node 1)))
        (PropDeleteKey [] (ms-memory-chain-phi? (n-in node 1)))
        (SetProto [] (ms-memory-chain-phi? (n-in node 1)))
        (ObjectFreeze [] (ms-memory-chain-phi? (n-in node 1)))
        (InternalStore [operation] (ms-memory-chain-phi? (n-in node 1)))
        (ArrayStore [] (ms-memory-chain-phi? (n-in node 1)))
        (ArrayResize [] (ms-memory-chain-phi? (n-in node 1)))
        (ArrayCopy [] (ms-memory-chain-phi? (n-in node 1)))
        (StringSplit [] (ms-memory-chain-phi? (n-in node 1)))
        (MemMerge [] (let [(mut i) 1
                  (mut found) false]
              (loop (if (or (>= (load i) (n-nins node)) (load found))
                        (break)
                        (do
                          (set! found (ms-memory-chain-phi? (n-in node (load i))))
                          (set! i (+ (load i) 1)))))
              (load found)))
        (_ false))))

(defn ms-array-owner-block [(owner i64) (array i64)] (-> i64)
  (match (n-op array)
    (ArrayMark []
      (let [ptr (n-in array 1)]
        (match (n-op ptr)
          (Proj [slot]
            (let [parent (n-in ptr 0)]
              (if (and (!= parent NO-NODE)
                       (match (n-op parent) (New [shape] true) (_ false)))
                  (ms-node-block owner parent)
                  (ms-node-block owner ptr))))
          (_ (ms-node-block owner ptr)))))
    (_ (ms-node-block owner array))))

(defn ms-selected-effect-node-block [(owner i64) (node i64) (fallback i64)] (-> i64)
  (match (n-op node)
    (PropStore [name] (let [value-block (ms-node-block owner (n-in node 3))
              object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= value-block 0) (!= value-block (ms-entry-block owner)))
              value-block
              (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
                  object-block
                  fallback))))
    (PropDelete [name] (let [object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
              object-block fallback)))
    (PropStoreKey [_] (let [value-block (ms-node-block owner (n-in node 4))
              key-block (ms-node-block owner (n-in node 3))]
          (if (and (>= value-block 0) (!= value-block (ms-entry-block owner)))
              value-block
              (if (and (>= key-block 0) (!= key-block (ms-entry-block owner)))
                  key-block fallback))))
    (PropDeleteKey [] (let [key-block (ms-node-block owner (n-in node 3))]
          (if (and (>= key-block 0) (!= key-block (ms-entry-block owner)))
              key-block fallback)))
    (SetProto [] (let [prototype-block (ms-node-block owner (n-in node 3))
              object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= prototype-block 0) (!= prototype-block (ms-entry-block owner)))
              prototype-block
              (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
                  object-block
                  fallback))))
    (ObjectFreeze [] (let [object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
              object-block fallback)))
    (InternalLoad [slot] (let [object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
              object-block fallback)))
    (InternalStore [operation] (let [object-block (ms-node-block owner (n-in node 2))]
          (if (and (>= object-block 0) (!= object-block (ms-entry-block owner)))
              object-block fallback)))
    (_ fallback)))

(defn ms-array-effect-block [(owner i64) (memory i64) (array i64) (fallback i64)] (-> i64)
  (let [selected (if (and (>= memory 0) (< memory (n-count)))
                     (ms-selected-block owner memory)
                     -1)]
    ;; Once the ordered predecessor has been selected, its actual placement is a hard lower bound.
    ;; The ideal memory node itself has no control input, so ms-memory-block can only name its chain
    ;; root and may otherwise place a consumer above a branch-local predecessor.
    (let [base
            (if (>= selected 0)
                selected
                (ms-selected-effect-node-block owner memory fallback))]
      (if (ms-memory-chain-phi? memory)
          base
          (ms-selection-deeper-block base (ms-array-owner-block owner array))))))

(defn ms-selection-deeper-block [(current i64) (candidate i64)] (-> i64)
  (if (< candidate 0)
      current
          (if (mu-dominates? current candidate) candidate current)))

(defn ms-selection-value-block-fuel [(owner i64) (fallback i64) (vreg i64) (fuel i64)] (-> i64)
  (let [def (ms-def-inst vreg)]
    (if (or (< def 0) (<= fuel 0))
        fallback
        (let [m (be-inst def)
              desc (mi-desc (.op m))
              inputs (mi-desc-inputs desc)
              (mut block) (ms-selection-deeper-block fallback (.block-id m))]
          ; Follow pure producer chains so provisional entry/fallback placement cannot hide a
          ; branch-local operand from the effect that consumes it.
          (if (> inputs 0)
              (set! block
                    (ms-selection-value-block-fuel
                      owner (load block) (.a m) (- fuel 1)))
              0)
          (if (> inputs 1)
              (set! block
                    (ms-selection-value-block-fuel
                      owner (load block) (.b m) (- fuel 1)))
              0)
          (load block)))))

(defn ms-selection-value-block [(owner i64) (fallback i64) (vreg i64)] (-> i64)
  (ms-selection-value-block-fuel owner fallback vreg 64))

;; Heap reads with an explicit control input are pinned to that control block. A value user in a
;; dominating block must not pull the read above its guard (for example, packet.kind above
;; `packet != null`). Unpinned legacy reads retain their demand placement.
(defn ms-pinned-read-block [(owner i64) (node i64) (fallback i64)] (-> i64)
  (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
    (if (< ctrl 0)
        fallback
        (let [mapped (al-get (.ctrl-block (machine-unit)) ctrl)]
          (if (and (>= mapped 0) (= (mu-block-owner mapped) owner)) mapped fallback)))))

(defn ms-linear-memory-effect? [(node i64)] (-> bool)
  (match (n-op node)
    (Store [alias] true)
    (PropStore [name] true)
    (PropDelete [name] true)
    (PropStoreKey [_] true)
    (PropDeleteKey [] true)
    (SetProto [] true)
    (ObjectFreeze [] true)
    (InternalStore [operation] true)
    (ArrayStore [] true)
    (ArrayResize [] true)
    (ArrayCopy [] true)
    (StringSplit [] true)
    (_ false)))

(defn ms-select-memory-at! [(owner i64) (node i64) (bid i64)] (-> bool)
  (if (ms-seen? owner node)
      true
      (let [u (machine-unit)
            pending (field u selection-memory-pending)
            base (al-len [i64] (load pending))
            (mut current) node
            (mut ok) true]
        ;; Heap effects form long predecessor chains in real JavaScript programs. Walk that spine
        ;; iteratively, select its base once, then publish effects oldest-to-newest.
        (loop (if (or (ms-seen? owner (load current))
                      (not (ms-linear-memory-effect? (load current))))
                  (break)
                  (do
                    (al-push! [i64] pending (load current))
                    (set! current (n-in (load current) 1)))))
        (if (not (ms-seen? owner (load current)))
            (let [placement (ms-memory-block owner (load current))]
              (set! ok
                    (ms-select-memory-at-core! owner
                                               (load current)
                                               (if (>= placement 0) placement bid))))
            0)
        (let [(mut index) (al-len [i64] (load pending))]
          (loop (if (or (<= (load index) base) (not (load ok)))
                    (break)
                    (do
                      (set! index (- (load index) 1))
                      (set! ok
                            (let [effect
                                    (al-get [i64] (load pending) (load index))]
                              (let [placement (ms-memory-block owner effect)]
                                (ms-select-memory-at-core! owner
                                                           effect
                                                           (if (>= placement 0)
                                                               placement
                                                               bid)))))))))
        ;; This ArrayList is a reentrant stack. Nested memory selection restores its own suffix;
        ;; restoring our base retains the caller's pending chain and all allocated capacity.
        (store! (field pending len) base)
        (load ok))))

(defn ms-select-memory-at-core! [(owner i64) (node i64) (bid i64)] (-> bool)
  (if (ms-seen? owner node)
      true
      (let [(mut ok) true]
        (match (n-op node)
            (Store [alias] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [ptr (ms-select-value-at! owner (n-in node 2) bid)
                        raw-value (ms-select-value-at! owner (n-in node 3) bid)
                        value
                          (if (and (>= raw-value 0)
                                   (and (= (shape-alias-ty alias) (t-flt))
                                        (not (be-node-fp-value? (n-in node 3)))))
                              (ms-fp-input! owner (n-in node 3) raw-value bid)
                              raw-value)]
                    (if (or (< ptr 0) (< value 0))
                        (set! ok false)
                        (let [at
                                (ms-emit! owner
                                          bid
                                          (mi-new MI-STORE
                                                  -1
                                                  ptr
                                                  value
                                                  (be-field-off alias)
                                                  node))]
                          (ms-add-memory-deps! at node 1 1))))))
            (Proj [slot] (if (op-is? (n-in node 0) New [_])
                  (if (< (ms-select-value-at! owner (n-in node 0) bid) 0) (set! ok false) 0)
                  0))
            (PropStore [name] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        value (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< object 0) (< value 0))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid bid
                              key (ms-select-property-key! owner node effect-bid)
                              at (ms-emit! owner effect-bid (mi-new MI-JSPROP fresh object value 1 node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (PropDelete [name] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)]
                    (if (< object 0)
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid bid
                              key (ms-select-property-key! owner node effect-bid)
                              at (ms-emit! owner effect-bid
                                           (mi-new MI-JSPROP fresh object object 4 node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (PropStoreKey [operation] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        key (ms-select-value-at! owner (n-in node 3) bid)
                        value (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< object 0) (or (< key 0) (< value 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              at (ms-emit! owner bid
                                           (mi-new MI-JSPROP fresh object value operation node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (PropDeleteKey [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        key (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< object 0) (< key 0))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              at (ms-emit! owner bid
                                           (mi-new MI-JSPROP fresh object object 4 node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (ArrayStore [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        index (ms-array-index! owner (n-in node 3) bid)
                        value (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< object 0) (or (< index 0) (< value 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 2) bid)
                                      object)
                                    index)
                                  value)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh object index 2 node))]
                          (ms-add-single-arg! at value)
                          (ms-add-memory-deps! at node 1 1))))))
            (ArrayResize [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        length (ms-array-index! owner (n-in node 3) bid)
                        ordered (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< object 0) (or (< length 0) (< ordered 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 2) bid)
                                      object)
                                    length)
                                  ordered)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh object length 4 node))]
                          (ms-add-single-arg! at ordered)
                          (ms-add-memory-deps! at node 1 1))))))
            (ArrayCopy [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [source (ms-select-value-at! owner (n-in node 2) bid)
                        result (ms-select-value-at! owner (n-in node 3) bid)
                        start (ms-array-index! owner (n-in node 4) bid)]
                    (if (or (< source 0) (or (< result 0) (< start 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-selection-value-block
                                      owner
                                      (ms-array-effect-block owner (n-in node 1) (n-in node 3) bid)
                                      source)
                                    result)
                                  start)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSARRAY fresh source start 5 node))]
                          (ms-add-single-arg! at result)
                          (ms-add-memory-deps! at node 1 1))))))
            (StringSplit [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [string (ms-select-value-at! owner (n-in node 2) bid)
                        delimiter (ms-select-value-at! owner (n-in node 3) bid)
                        result (ms-select-value-at! owner (n-in node 4) bid)]
                    (if (or (< string 0) (or (< delimiter 0) (< result 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              at
                                (ms-emit! owner
                                          bid
                                          (mi-new MI-JSSTRING
                                                  fresh
                                                  string
                                                  delimiter
                                                  JSSOP-SPLIT
                                                  node))]
                          (ms-add-single-arg! at result)
                          (ms-add-memory-deps! at node 1 1))))))
            (SetProto [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        prototype (ms-select-value-at! owner (n-in node 3) bid)]
                    (if (or (< object 0) (< prototype 0))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              effect-bid
                                (ms-selection-value-block
                                  owner
                                  (ms-selection-value-block
                                    owner
                                    (ms-array-effect-block owner (n-in node 1) (n-in node 2) bid)
                                    object)
                                  prototype)
                              key (ms-immediate! owner effect-bid 0)
                              at
                                (ms-emit! owner
                                          effect-bid
                                          (mi-new MI-JSPROP fresh object prototype 2 node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (ObjectFreeze [] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)]
                    (if (< object 0)
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              key (ms-immediate! owner bid 0)
                              at (ms-emit! owner bid
                                           (mi-new MI-JSPROP fresh object object 8 node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (InternalStore [operation] (if (not (ms-select-memory-at! owner (n-in node 1) bid))
                  (set! ok false)
                  (let [object (ms-select-value-at! owner (n-in node 2) bid)
                        value (ms-select-value-at! owner (n-in node 3) bid)
                        extra (if (= operation INTERNAL-INIT)
                                  (ms-select-value-at! owner (n-in node 4) bid)
                                  value)]
                    (if (or (< object 0) (or (< value 0) (< extra 0)))
                        (set! ok false)
                        (let [fresh (ms-new-vreg!)
                              machine-opcode (if (= operation INTERNAL-INIT) 9 13)
                              key (if (= operation INTERNAL-INIT)
                                      value
                                      (ms-immediate! owner bid 0))
                              at (ms-emit! owner bid
                                           (mi-new MI-JSPROP fresh object extra machine-opcode node))]
                          (ms-add-single-arg! at key)
                          (ms-add-memory-deps! at node 1 1))))))
            (Arg [ty] 0)
            (Parm [index] 0)
            (MemMerge [] (let [len (n-nins node)
                    (mut i) 1]
                (loop (if (or (>= (load i) len) (not (load ok)))
                          (break)
                          (do
                            (if (not (ms-select-memory-at! owner
                                                           (n-in node (load i))
                                                           (ms-memory-block owner
                                                                            (n-in node (load i)))))
                                (set! ok false)
                                0)
                            (set! i (+ (load i) 1))
                            0)))))
            (Phi [declared] (do (ms-fail! MSEL-UNSUPPORTED node) (set! ok false)))
            (_ 0))
        (if (load ok)
            (do
              (ms-record-selected-block! owner node bid)
              (ms-seen! owner node)
              true)
            false))))

(defn ms-select-memory! [(owner i64) (node i64)] (-> bool)
  (ms-select-memory-at! owner node (ms-memory-block owner node)))

(defn ms-select-int32-binary! [(owner i64) (node i64) (mop i64) (bid i64)] (-> i64)
  (let [an (n-in node 1)
        bn (n-in node 2)
        raw-a (ms-select-value-at! owner an bid)
        raw-b (ms-select-value-at! owner bn bid)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a
                (if (be-node-fp-value? an)
                    (let [fresh (ms-new-vreg!)]
                      (ms-emit! owner bid (mi-new MI-I32FROMFP fresh raw-a -1 0 NO-NODE))
                      fresh)
                    raw-a)
              b
                (if (be-node-fp-value? bn)
                    (let [fresh (ms-new-vreg!)]
                      (ms-emit! owner bid (mi-new MI-I32FROMFP fresh raw-b -1 0 NO-NODE))
                      fresh)
                    raw-b)
              fresh (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new mop fresh a b 0 node))
          fresh))))

;; Widen a value to a double so it can be an operand of floating-point arithmetic.
;;
;; "Not floating-point" is NOT the same as "a machine integer". A `dyn` value arriving here — an
;; array element, a property, a call result — is a TAGGED JavaScript word, and `SCVTF` on one
;; converts the tag bits along with the payload. `JSUNBOX` with tag 0 is the conversion that reads
;; either payload as a double and traps on anything that is not a number; it is what an explicit
;; `Unbox : flt` in the graph selects to, and the two must agree. They did not: an accumulator
;; seeded with `values[0]` and added to in a loop is a `dyn` Phi whose back edge makes it
;; floating-point, so the loop-entry copy converted the boxed element with `SCVTF` while the body
;; unboxed its own load properly. The seed was read as its own tag word and the sum came out 0.
;;
;; The evidence has to be that the value IS tagged, not that its lattice type admits it. A `dyn`
;; type is not evidence — hand-written backend fixtures and the JSL library both give unconstrained
;; machine integers that type, and unboxing one of those traps on a word nothing ever tagged. These
;; four produce a tagged word by construction, and a call does when its return crosses the same
;; boundary. A Phi is deliberately absent: a Phi of `dyn` machine words is exactly the fixture case.
;;
;; A raw managed pointer has no numeric value at all, so selection refuses it by name rather than
;; converting something. The refusal is recorded and a well-formed instruction still emitted, so
;; the rest of selection walks a consistent program on its way to reporting the failure.
(defn ms-value-is-tagged? [(node i64)] (-> bool)
  (or (op-is? node ArrayLoad [_])
      (or (op-is? node PropLoad [_])
          (or (op-is? node Box [_])
          (or (and (op-is? node Phi [_]) (be-box-input-already-tagged? node))
          (or (op-is? node ToNumber [])
          (or (op-is? node ToInteger [])
              (ms-call-returns-tagged? node))))))))

(defn ms-fp-input! [(owner i64) (node i64) (vreg i64) (bid i64)] (-> i64)
  (if (be-node-fp-value? node)
      vreg
      (let [tagged (ms-value-is-tagged? node)]
        (if (or tagged (!= (ml-kind-for-node node) MLK-RAW-MANAGED))
            0
            (ms-fail! MSEL-UNSUPPORTED node))
        (let [fresh (ms-new-vreg!)]
          (ms-emit! owner bid
                    (if tagged
                        (mi-new MI-JSUNBOX fresh vreg -1 0 NO-NODE)
                        (mi-new MI-SCVTF fresh vreg -1 0 NO-NODE)))
          fresh))))

;; Narrow a tagged JavaScript word to the machine integer that integer arithmetic needs.
;;
;; The frontend unboxes a dynamic value before using it as a number — `values[9] + 1` is an
;; `Unbox : flt` and a floating-point add — but it EXEMPTS call results, betting that a call hands
;; back a raw machine number. That is true only when the callee's return ABI is unboxed, which the
;; frontend cannot see. `function tenth(v) { return v[9]; }` returns a tagged word, and
;; `tenth(values) + 1` became an integer ADD on the TAG: right by accident when the only consumer
;; masks the sum back to an int32, and garbage the moment anything reads it as a number.
;;
;; The callee's ABI IS known here, so the value is unboxed here. The integer tag is the one the
;; arithmetic is being selected for; a payload that is not an integer trips the unbox's own check
;; rather than being computed on, which is the same bargain every other `JSUNBOX` in this backend
;; makes.
;;
;; ONLY a call whose result is genuinely tagged is repaired, and `MLK-BOXED` alone does not say
;; that. Hand-written backend fixtures and the JSL library both give unconstrained MACHINE integers
;; the `dyn` lattice type, and a callee returning one of those is reported boxed while its result
;; was never tagged; unboxing it traps. `be-js-dynamic-boundary?` is this file's existing name for
;; the nodes where a value actually crosses the JavaScript-value ABI, and a return through one of
;; those is the evidence the lattice type cannot supply.
(defn ms-call-returns-tagged? [(node i64)] (-> bool)
  (and (op-is? node Call [_])
       (and (= (be-call-return-kind node) MLK-BOXED)
            (let [callee (n-in node 1)
                  target (if (op-is? callee Closure [_]) (n-in callee 0) callee)]
              (and (op-is? target Fun [_])
                   (let [(mut input) 1
                         (mut found) false]
                     (loop (if (or (>= (load input) (n-nins target)) (load found))
                               (break)
                               (do
                                 (let [ret (n-in target (load input))]
                                   (if (and (!= ret NO-NODE)
                                            (and (op-is? ret Return [])
                                                 (be-js-dynamic-boundary? (n-in ret 1))))
                                       (set! found true)
                                       0))
                                 (set! input (+ (load input) 1))
                                 0)))
                     (load found)))))))

(defn ms-integer-input! [(owner i64) (node i64) (vreg i64) (bid i64)] (-> i64)
  (if (ms-call-returns-tagged? node)
      (let [fresh (ms-new-vreg!)]
        (ms-emit! owner bid (mi-new MI-JSUNBOX fresh vreg -1 JSV-INTEGER NO-NODE))
        fresh)
      vreg))

(defn ms-select-numeric-binary! [(owner i64) (node i64) (integer-op i64) (bid i64)] (-> i64)
  (if (or (be-node-fp-value? node)
          (or (be-node-fp-value? (n-in node 1))
              (be-node-fp-value? (n-in node 2))))
      (let [raw-a (ms-select-value-at! owner (n-in node 1) bid)
            raw-b (ms-select-value-at! owner (n-in node 2) bid)]
        (if (or (< raw-a 0) (< raw-b 0))
            -1
            (let [a (ms-fp-input! owner (n-in node 1) raw-a bid)
                  b (ms-fp-input! owner (n-in node 2) raw-b bid)
                  fresh (ms-new-vreg!)]
              (ms-emit! owner bid (mi-new (be-fp-op (n-op node)) fresh a b 0 node))
              fresh)))
      (let [raw-a (ms-select-value-at! owner (n-in node 1) bid)
            raw-b (ms-select-value-at! owner (n-in node 2) bid)]
        (if (or (< raw-a 0) (< raw-b 0))
            -1
            (let [a (ms-integer-input! owner (n-in node 1) raw-a bid)
                  b (ms-integer-input! owner (n-in node 2) raw-b bid)
                  fresh (ms-new-vreg!)]
              (ms-emit! owner bid (mi-new integer-op fresh a b 0 node))
              fresh)))))

(defn ms-select-mod! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [an (n-in node 1)
        bn (n-in node 2)
        raw-a (ms-select-value-at! owner an bid)
        raw-b (ms-select-value-at! owner bn bid)]
    (if (or (< raw-a 0) (< raw-b 0))
        -1
        (let [a (ms-fp-input! owner an raw-a bid)
              b (ms-fp-input! owner bn raw-b bid)
              fresh (ms-new-vreg!)]
          (ms-emit! owner bid (mi-new MI-FMOD fresh a b 0 node))
          fresh))))

(defn ms-immediate! [(owner i64) (bid i64) (value i64)] (-> i64)
  (let [fresh (ms-new-vreg!)]
    (ms-emit! owner bid (mi-new MI-MOVI fresh -1 -1 value NO-NODE))
    fresh))

(defn ms-jsstring! [(owner i64)
                    (bid i64)
                    (node i64)
                    (a i64)
                    (b i64)
                    (value i64)
                    (operation i64)] (-> i64)
  (let [fresh (ms-new-vreg!)
        at (ms-emit! owner bid (mi-new MI-JSSTRING fresh a b operation node))]
    (ms-add-single-arg! at value)
    fresh))

(defn ms-select-string-id! [(owner i64) (string i64) (node i64) (bid i64)] (-> i64)
  (let [
        length (jss-length string)
        zero (ms-immediate! owner bid 0)
        length-value (ms-immediate! owner bid length)
        (mut result) (ms-jsstring! owner bid (if (= length 0) node NO-NODE) zero length-value zero JSSOP-NEW)
        (mut index) 0]
    (loop (if (>= (load index) length)
              (break)
              (let [at (ms-immediate! owner bid (load index))
                    unit (ms-immediate! owner bid (jss-code-unit string (load index)))]
                (set! result
                      (ms-jsstring! owner
                                    bid
                                    (if (= (+ (load index) 1) length) node NO-NODE)
                                    (load result)
                                    at
                                    unit
                                    JSSOP-SET-UNIT))
                (set! index (+ (load index) 1)))))
    (load result)))

(defn ms-select-string-const! [(owner i64) (node i64) (bid i64)] (-> i64)
  (ms-select-string-id! owner (n-stringconst-id node) node bid))

;; Static property names enter the same runtime string-key space as computed keys. The ideal IR
;; keeps compact interned ids in AUX; selection materializes their UTF-16 key at the call boundary.
(defn ms-select-property-key! [(owner i64) (node i64) (bid i64)] (-> i64)
  (ms-select-string-id! owner
                        (jss-from-utf8!
                          (shape-name-bytes
                            (match (n-op node)
                              (PropLoad [name] name) (PropStore [name] name)
                              (PropHas [name] name) (PropDelete [name] name)
                              (_ (do (panic-corrupt "expected named property Op") 0)))))
                        NO-NODE
                        bid))

(defn ms-select-string-binary! [(owner i64) (node i64) (bid i64) (operation i64)] (-> i64)
  (let [left (ms-select-value-at! owner (n-in node 1) bid)
        right (ms-select-value-at! owner (n-in node 2) bid)]
    (if (or (< left 0) (< right 0))
        -1
        (ms-jsstring! owner bid node left right (ms-immediate! owner bid 0) operation))))

(defn ms-select-value-at! [(owner i64) (node i64) (bid i64)] (-> i64)
  (let [prior (ms-vget owner node)]
    (if (>= prior 0)
        prior
        (let [(mut vr) -1]
          (match (n-op node)
            (Const [ty] (if (or (= (ty-kinds (n-ty node)) VK-NULL)
                        (or (= (ty-kinds (n-ty node)) VK-UNDEF)
                            (or (and (= (ty-kinds (n-ty node)) VK-BOOL)
                                     (ty-const? (n-ty node)))
                                (and (ty-int-only? (n-ty node)) (ty-const? (n-ty node))))))
                    (let [fresh (ms-new-vreg!)]
                      (ms-emit! owner
                                (ms-entry-block owner)
                                (mi-new MI-MOVI
                                        fresh
                                        -1
                                        -1
                                        (cond (= (ty-kinds (n-ty node)) VK-NULL) JSV-NULL
                                              (= (ty-kinds (n-ty node)) VK-UNDEF) JSV-UNDEFINED
                                              :else (ty-int-lo (n-ty node)))
                                        node))
                      (set! vr fresh))
                    (if (and (be-float-only? (n-ty node)) (ty-const? (n-ty node)))
                        (let [fresh (ms-new-vreg!)]
                          (ms-emit! owner
                                    (ms-entry-block owner)
                                    (mi-new MI-FMOVI fresh -1 -1 (be-float-bits (n-ty node)) node))
                          (set! vr fresh))
                        0)))
            (StringConst [id] (set! vr (ms-select-string-const! owner node bid)))
            (StringLen [] (let [string (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= string 0)
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          string
                                          (ms-immediate! owner bid 0)
                                          (ms-immediate! owner bid 0)
                                          JSSOP-LENGTH))
                      0)))
            (StringEq [] (set! vr (ms-select-string-binary! owner node bid JSSOP-EQUAL)))
            (StringConcat [] (set! vr (ms-select-string-binary! owner node bid JSSOP-CONCAT)))
            (StringCharCode [] (let [string (ms-select-value-at! owner (n-in node 1) bid)
                      index (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< string 0) (< index 0))
                      0
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          string
                                          index
                                          (ms-immediate! owner bid 0)
                                          JSSOP-CHAR-CODE)))))
            (StringSubstring [mode] (let [string (ms-select-value-at! owner (n-in node 1) bid)
                      start (ms-select-value-at! owner (n-in node 2) bid)
                      end (ms-select-value-at! owner (n-in node 3) bid)]
                  (if (or (< string 0) (or (< start 0) (< end 0)))
                      0
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          string
                                          start
                                          end
                                          (+ JSSOP-SUBSTRING mode))))))
            (ToString [] (let [value-node (n-in node 1)
                      selected (ms-select-value-at! owner value-node bid)
                      ;; A RAW OBJECT POINTER HAS NO TAG, and the runtime's ToString is a dispatch
                      ;; on one. An object reaches here as a bare pointer -- `ArrayMark`, or the
                      ;; `Proj` of a `New` -- so it is tagged HERE, with the same tag
                      ;; `be-js-tag-for-value` derives for an explicit `Box`, and the runtime then
                      ;; answers "[object Object]" for it. The array case never gets this far:
                      ;; `ToStringValue` in lib/ tests `%IsArray` first and joins.
                      value
                        (if (and (>= selected 0) (= (n-rep-of value-node 32) REP-RAW-PTR))
                            (let [tag (be-js-tag-for-value value-node)]
                              ;; `-1` IS THE FAILURE, and a tag is not a small number: `JSV-ARRAY`
                              ;; is a negative 64-bit pattern, so testing `< 0` rejects every
                              ;; object tag there is.
                              (if (= tag -1)
                                  -1
                                  (let [fresh (ms-new-vreg!)]
                                    ;; NO-NODE: the ToString node itself is claimed by the
                                    ;; `ms-jsstring!` below, and two instructions naming one node
                                    ;; is MSEL-DUPLICATE.
                                    (ms-emit! owner bid (mi-new MI-JSBOX fresh selected -1 tag NO-NODE))
                                    fresh)))
                            selected)
                      operation
                        (let [kinds (ty-kinds (n-ty value-node))
                              rep (n-rep-of value-node 32)]
                          (cond
                                (= rep REP-RAW-PTR) JSSOP-FROM-VALUE
                                ;; REPRESENTATION IS THE FIRST QUESTION, not the last. Every arm
                                ;; below reads the TYPE to pick a machine word, and a tagged value
                                ;; with a narrow type walks straight into the wrong one: a NaN out
                                ;; of `charCodeAt` is typed float-only and IS a tagged word, so it
                                ;; reached `FROM-DOUBLE-BITS`, which reinterpreted the NaN box as an
                                ;; IEEE double and printed nineteen characters where node prints
                                ;; "NaN". The runtime's tag dispatch is exactly the thing that reads
                                ;; a tagged word correctly, whatever its type says.
                                (= rep REP-TAGGED) JSSOP-FROM-VALUE
                                (= kinds VK-STR) -1
                                (ty-int-only? (n-ty value-node)) JSSOP-FROM-INT
                                (= kinds VK-BOOL) JSSOP-FROM-BOOL
                                (= kinds VK-NULL) JSSOP-FROM-NULL
                                (= kinds VK-UNDEF) JSSOP-FROM-UNDEFINED
                                (be-float-only? (n-ty value-node)) JSSOP-FROM-DOUBLE-BITS
                                (= (n-ty value-node) (t-dyn)) JSSOP-FROM-VALUE
                                ;; NARROWING A TYPE MUST NOT LOSE A CAPABILITY, and it did: every
                                ;; arm above asks the TYPE which machine word this is, so a value
                                ;; the analysis proved is `num` -- strictly more than `dyn` knows --
                                ;; fell to `-2` and the whole program failed to compile. `String(x)`
                                ;; on anything the frontend could not pin to int-only or float-only
                                ;; was unreachable, which is most of `docs/NATIVE-CAPABILITY.md`.
                                ;;
                                ;; A TYPE IS NOT A REPRESENTATION. `n-rep-of` is the one answer to
                                ;; which machine word this is: a tagged word goes to the runtime's
                                ;; tag dispatch exactly as `dyn` does, and a raw number is an
                                ;; integer or a double according to the register class selection
                                ;; already chose for it -- the same derivation
                                ;; `be-js-tag-for-value` makes three hundred lines up.
                                (ty-numeric? (n-ty value-node))
                                  (if (be-node-fp-value? value-node)
                                      JSSOP-FROM-DOUBLE-BITS
                                      JSSOP-FROM-INT)
                                (be-kinds-must-be-tagged? (n-ty value-node)) JSSOP-FROM-VALUE
                                :else -2))]
                  (if (= operation -1)
                      (set! vr value)
                      (if (or (< value 0) (= operation -2))
                          0
                          (set! vr
                                (ms-jsstring! owner
                                              bid
                                              node
                                              value
                                              (ms-immediate! owner bid 0)
                                              (ms-immediate! owner bid 0)
                                              operation))))))
            (ParseInt [] (let [value-node (n-in node 1)
                      value (ms-select-value-at! owner value-node bid)
                      radix (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< value 0) (< radix 0))
                      0
                      (let [string
                              (if (ty-int-only? (n-ty value-node))
                                  (ms-jsstring! owner
                                                bid
                                                NO-NODE
                                                value
                                                (ms-immediate! owner bid 0)
                                                (ms-immediate! owner bid 0)
                                                JSSOP-FROM-INT)
                                  (if (be-float-only? (n-ty value-node))
                                      (ms-jsstring! owner
                                                    bid
                                                    NO-NODE
                                                    value
                                                    (ms-immediate! owner bid 0)
                                                    (ms-immediate! owner bid 0)
                                                    JSSOP-FROM-DOUBLE-BITS)
                                      value))]
                        (if (>= string 0)
                            (set! vr
                                  (ms-jsstring! owner
                                                bid
                                                node
                                                string
                                                radix
                                                (ms-immediate! owner bid 0)
                                                JSSOP-PARSE-INT))
                            0)))))
            (ParseFloat [] (let [string (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= string 0)
                      (set! vr
                            (ms-jsstring! owner bid node string
                                          (ms-immediate! owner bid 0)
                                          (ms-immediate! owner bid 0)
                                          JSSOP-PARSE-FLOAT))
                      0)))
            (IsNaN [] (let [value-node (n-in node 1)
                      value (ms-select-value-at! owner value-node bid)
                      kinds (ty-kinds (n-ty value-node))]
                  (if (< value 0)
                      0
                      (if (= kinds VK-STR)
                          (set! vr
                                (ms-jsstring! owner
                                              bid
                                              node
                                              value
                                              (ms-immediate! owner bid 0)
                                              (ms-immediate! owner bid 0)
                                              JSSOP-IS-NAN))
                          (if (op-is? value-node StringCharCode [])
                              (set! vr
                                    (ms-jsstring! owner
                                                  bid
                                                  node
                                                  value
                                                  (ms-immediate! owner bid 0)
                                                  (ms-immediate! owner bid 0)
                                                  JSSOP-IS-NAN-VALUE))
                              (if (or (ty-int-only? (n-ty value-node))
                                      (or (= kinds VK-BOOL) (= kinds VK-NULL)))
                                  (set! vr (ms-immediate! owner bid 0))
                                  (if (= kinds VK-UNDEF)
                                      (set! vr (ms-immediate! owner bid 1))
                                      (if (ms-value-is-tagged? value-node)
                                          (let [zero (ms-immediate! owner bid 0)]
                                            ;; The DSL's arithmetic operations return tagged
                                            ;; JavaScript Numbers. Preserve that boundary and ask
                                            ;; the runtime about the encoded value rather than
                                            ;; mistaking its bits for a raw f64 register.
                                            (set! vr
                                                  (ms-jsstring! owner bid node value zero zero
                                                                JSSOP-IS-NAN-VALUE)))
                                      (if (be-node-fp-value? value-node)
                                          (let [fp (ms-fp-input! owner value-node value bid)
                                                ordered (ms-new-vreg!)
                                                zero (ms-immediate! owner bid 0)
                                                result (ms-new-vreg!)]
                                            ;; A Number is NaN exactly when it is not equal to
                                            ;; itself. MI-FEQ performs an ordered comparison, so
                                            ;; invert that boolean with the ordinary integer EQ.
                                            (ms-emit! owner bid
                                                      (mi-new MI-FEQ ordered fp fp 0 NO-NODE))
                                            (ms-emit! owner bid
                                                      (mi-new MI-EQ result ordered zero 0 node))
                                            (set! vr result))
                                          0)))))))))
            (StringFromCodeUnit [] (let [value (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= value 0)
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          value
                                          (ms-immediate! owner bid 0)
                                          (ms-immediate! owner bid 0)
                                          JSSOP-FROM-CODE-UNIT))
                      0)))
            (NumberToString [] (let [value (ms-select-value-at! owner (n-in node 1) bid)
                      radix (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< value 0) (< radix 0))
                      0
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          value
                                          radix
                                          (ms-immediate! owner bid 0)
                                          JSSOP-FROM-INT-RADIX)))))
            (ToFixed [] (let [value (ms-select-value-at! owner (n-in node 1) bid)
                      digits (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< value 0) (< digits 0))
                      0
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          value
                                          digits
                                          (ms-immediate! owner bid 0)
                                          JSSOP-TO-FIXED)))))
            ;; The two atoms. `JSSOP-NEW` reads its length from the SECOND argument (`b`), which
            ;; is why the first is an immediate zero -- `ms-select-string-id!` materialises string
            ;; constants through the same instruction.
            (StringAlloc [] (let [length (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= length 0)
                      (set! vr
                            (ms-jsstring! owner
                                          bid
                                          node
                                          (ms-immediate! owner bid 0)
                                          length
                                          (ms-immediate! owner bid 0)
                                          JSSOP-NEW))
                      0)))
            (StringSetUnit [] (let [string (ms-select-value-at! owner (n-in node 1) bid)
                      index (ms-select-value-at! owner (n-in node 2) bid)
                      unit (ms-select-value-at! owner (n-in node 3) bid)]
                  (if (or (< string 0) (or (< index 0) (< unit 0)))
                      0
                      (set! vr (ms-jsstring! owner bid node string index unit JSSOP-SET-UNIT)))))
            (StringIndexOf [] (let [value (ms-select-value-at! owner (n-in node 1) bid)
                      needle (ms-select-value-at! owner (n-in node 2) bid)
                      start (ms-select-value-at! owner (n-in node 3) bid)]
                  (if (or (< value 0) (or (< needle 0) (< start 0)))
                      0
                      (set! vr (ms-jsstring! owner bid node value needle start JSSOP-INDEX-OF)))))
            (StringCompare [] (let [left (ms-select-value-at! owner (n-in node 1) bid)
                      right (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< left 0) (< right 0))
                      0
                      (set! vr
                            (ms-jsstring! owner bid node left right
                                          (ms-immediate! owner bid 0) JSSOP-COMPARE)))))
            (StringNormalize [] (let [string (ms-select-value-at! owner (n-in node 1) bid)
                      form (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< string 0) (< form 0))
                      0
                      (set! vr
                            (ms-jsstring! owner bid node string form
                                          (ms-immediate! owner bid 0) JSSOP-NORMALIZE)))))
            (JsBuiltin [descriptor] (let [left (ms-select-value-at! owner (n-in node 1) bid)
                      right (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< left 0) (< right 0))
                      0
                      (set! vr
                            (ms-jsstring! owner bid node left right
                                          (ms-immediate! owner bid 0)
                                          (+ JSSOP-BUILTIN-BASE descriptor))))))
            (JsThrow [] (let [throw-bid (ms-node-block owner node)
                      value (if (< throw-bid 0) -1
                                (ms-select-value-at! owner (n-in node 1) throw-bid))]
                  (if (or (< throw-bid 0) (< value 0))
                      0
                      (set! vr
                            (ms-jsstring! owner throw-bid node value
                                          (ms-immediate! owner throw-bid 0)
                                          (ms-immediate! owner throw-bid 0) 200)))))
            (Fun [index] (let [fresh (ms-new-vreg!)]
                  (ms-emit! owner
                            (ms-entry-block owner)
                            (mi-new MI-MOVI fresh -1 -1 index node))
                  (set! vr fresh)))
            (Arg [ty] (let [fixed (ms-new-vreg!)
                      fresh (ms-new-vreg!)]
                  (ms-emit! owner
                            (ms-entry-block owner)
                            (mi-new MI-ARG fixed -1 -1 (graph-arg-index node) node))
                  (ms-emit! owner
                            (ms-entry-block owner)
                            (mi-new MI-ABI-COPY fresh fixed -1 0 NO-NODE))
                  (set! vr fresh)))
            (Parm [index] (let [fixed (ms-new-vreg!)
                      fresh (ms-new-vreg!)
                      abi-index (graph-parm-abi-index node)]
                  (ms-emit! owner
                            (ms-entry-block owner)
                            (mi-new (if (< abi-index 8) MI-ARG MI-STACKARG)
                                    fixed
                                    -1
                                    -1
                                    (if (< abi-index 8)
                                        abi-index
                                        (graph-parm-stack-index node))
                                    node))
                  (ms-emit! owner
                            (ms-entry-block owner)
                            (mi-new MI-ABI-COPY fresh fixed -1 0 NO-NODE))
                  (set! vr fresh)))
            (New [shape] (let [len (n-nins node)
                      (mut i) 1
                      (mut ok)
                        (ms-select-control-effects! owner
                                                    (n-in node 0)
                                                    (ms-node-block owner node))]
                  (loop (if (or (>= (load i) len) (not (load ok)))
                            (break)
                            (do
                              (if (not (ms-select-memory! owner (n-in node (load i))))
                                  (set! ok false)
                                  0)
                              (set! i (+ (load i) 1))
                              0)))
                  (if (load ok)
                      (let [fresh (ms-new-vreg!)]
                        (let [at
                                (ms-emit! owner
                                          (ms-node-block owner node)
                                          (mi-new MI-NEW
                                                  fresh
                                                  -1
                                                  -1
                                                  shape
                                                  node))]
                          (ms-add-memory-deps! at node 1 (- len 1)))
                        (set! vr fresh))
                      0)))
            (Proj [slot] (if (and (= slot 0) (op-is? (n-in node 0) New [_]))
                    (set! vr (ms-select-value-at! owner (n-in node 0) bid))
                    0))
            (Load [alias] (if (not (ms-select-memory! owner (n-in node 1)))
                    0
                    (let [ptr (ms-select-value-at! owner (n-in node 2) (ms-memory-block owner node))]
                      (if (< ptr 0)
                          0
                          (let [fresh (ms-new-vreg!)]
                            (let [at
                                    (ms-emit! owner
                                              (ms-memory-block owner node)
                                              (mi-new MI-LOAD
                                                      fresh
                                                      ptr
                                                      -1
                                                      (be-field-off alias)
                                                      node))]
                              (ms-add-memory-deps! at node 1 1))
                            (set! vr fresh))))))
            (Add [] (set! vr (ms-select-numeric-binary! owner node MI-ADD bid)))
            (Sub [] (set! vr (ms-select-numeric-binary! owner node MI-SUB bid)))
            (Mul [] (set! vr (ms-select-numeric-binary! owner node MI-MUL bid)))
            (Div [] (set! vr (ms-select-numeric-binary! owner node MI-SDIV bid)))
            (Eq [] (if (or (and (= (n-ty (n-in node 1)) (t-dyn))
                             (be-js-dynamic-boundary? (n-in node 1))
                             (and (ty-int-only? (n-ty (n-in node 2)))
                                  (and (ty-const? (n-ty (n-in node 2)))
                                       (= (ty-int-lo (n-ty (n-in node 2))) 0))))
                        (and (= (n-ty (n-in node 2)) (t-dyn))
                             (be-js-dynamic-boundary? (n-in node 2))
                             (and (ty-int-only? (n-ty (n-in node 1)))
                                  (and (ty-const? (n-ty (n-in node 1)))
                                       (= (ty-int-lo (n-ty (n-in node 1))) 0)))))
                    (let [dynamic-node (if (= (n-ty (n-in node 1)) (t-dyn))
                                           (n-in node 1)
                                           (n-in node 2))
                          dynamic-value (ms-select-value-at! owner dynamic-node bid)
                          zero (ms-immediate! owner bid 0)]
                      (if (< dynamic-value 0)
                          (set! vr -1)
                          (let [truthy (ms-jsstring! owner bid NO-NODE dynamic-value zero zero JSSOP-VALUE-TRUTHY)
                                result (ms-new-vreg!)]
                            (ms-emit! owner bid (mi-new MI-EQ result truthy zero 0 node))
                            (set! vr result))))
                    (if (or (and (= (n-ty (n-in node 1)) (t-dyn))
                                 (be-js-dynamic-boundary? (n-in node 1)))
                            (and (= (n-ty (n-in node 2)) (t-dyn))
                                 (be-js-dynamic-boundary? (n-in node 2))))
                        (set! vr (ms-select-string-binary! owner node bid JSSOP-VALUE-EQUAL))
                        (set! vr (ms-select-numeric-binary! owner node MI-EQ bid)))))
            (Lt [] (set! vr (ms-select-numeric-binary! owner node MI-LT bid)))
            (Le [] (set! vr (ms-select-numeric-binary! owner node MI-LE bid)))
            (Mod [] (set! vr (ms-select-mod! owner node bid)))
            (BitAnd [] (set! vr (ms-select-int32-binary! owner node MI-BITAND bid)))
            (BitOr [] (set! vr (ms-select-int32-binary! owner node MI-BITOR bid)))
            (BitXor [] (set! vr (ms-select-int32-binary! owner node MI-BITXOR bid)))
            (Shl [] (set! vr (ms-select-int32-binary! owner node MI-SHL bid)))
            (Shr [] (set! vr (ms-select-int32-binary! owner node MI-SHR bid)))
            (UShr [] (set! vr (ms-select-int32-binary! owner node MI-USHR bid)))
            (BitNot [] (let [an (n-in node 1)
                      raw-a (ms-select-value-at! owner an bid)]
                  (if (< raw-a 0)
                      0
                      (let [a
                              (if (be-node-fp-value? an)
                                  (let [converted (ms-new-vreg!)]
                                    (ms-emit! owner
                                              bid
                                              (mi-new MI-I32FROMFP converted raw-a -1 0 NO-NODE))
                                    converted)
                                  raw-a)
                            fresh (ms-new-vreg!)]
                        (ms-emit! owner bid (mi-new MI-BITNOT fresh a -1 0 node))
                        (set! vr fresh)))))
            (ToNumber [] (let [a (ms-select-value-at! owner (n-in node 1) bid)
                      zero (ms-immediate! owner bid 0)]
                  (if (< a 0) 0
                    (set! vr (ms-jsstring! owner bid node a zero zero JSSOP-TO-NUMBER)))))
            (ToInteger [] (let [a (ms-select-value-at! owner (n-in node 1) bid)
                      zero (ms-immediate! owner bid 0)]
                  (if (< a 0) 0
                    (set! vr (ms-jsstring! owner bid node a zero zero JSSOP-TO-INTEGER)))))
            (Not [] (let [an (n-in node 1)
                      a (ms-select-value-at! owner an bid)
                      zero (ms-immediate! owner bid 0)]
                  (if (< a 0)
                      0
                      (let [operand
                              ;; Ideal type does not decide representation: `%Box false` is still
                              ;; typed Boolean but carries the tagged JavaScript word. Only a raw
                              ;; numeric representation may be compared directly with zero;
                              ;; tagged booleans and references need the runtime truthiness seam.
                              (if (= (n-rep-of an 32) REP-RAW-NUM)
                                  a
                                  (ms-jsstring! owner bid NO-NODE a zero zero JSSOP-VALUE-TRUTHY))
                            fresh (ms-new-vreg!)]
                        (ms-emit! owner bid (mi-new MI-EQ fresh operand zero 0 node))
                        (set! vr fresh)))))
            (Minus [] (let [a (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (< a 0)
                      0
                      (let [fresh (ms-new-vreg!)]
                        (ms-emit! owner
                                  bid
                                  (mi-new (if (be-node-fp-value? (n-in node 1)) MI-FNEG MI-NEG)
                                          fresh
                                          a
                                          -1
                                          0
                                          node))
                        (set! vr fresh)))))
            (Cast [target] (set! vr (ms-select-value-at! owner (n-in node 1) bid)))
            (PropLoad [name] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)]
                      (if (< object 0)
                          (ms-fail! MSEL-UNSUPPORTED node)
                          (let [fresh (ms-new-vreg!)
                                key (ms-select-property-key! owner node pinned-bid)
                                at
                                  (ms-emit! owner
                                            pinned-bid
                                            (mi-new MI-JSPROP fresh object object 0 node))]
                            (ms-add-single-arg! at key)
                            (ms-add-memory-deps! at node 1 1)
                            (set! vr fresh)))))))
            (PropHas [name] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)]
                        (if (< object 0)
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  key (ms-select-property-key! owner node pinned-bid)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object 3 node))]
                              (ms-add-single-arg! at key)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (ProtoHas [] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)
                            prototype (ms-select-value-at! owner (n-in node 3) pinned-bid)]
                        (if (or (< object 0) (< prototype 0))
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  key (ms-immediate! owner pinned-bid 0)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object prototype 5 node))]
                              (ms-add-single-arg! at key)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (PropLoadKey [operation] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)
                            key (ms-select-value-at! owner (n-in node 3) pinned-bid)]
                        (if (or (< object 0) (< key 0))
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object operation node))]
                              (ms-add-single-arg! at key)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (PropHasKey [] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)
                            key (ms-select-value-at! owner (n-in node 3) pinned-bid)]
                        (if (or (< object 0) (< key 0))
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object 3 node))]
                              (ms-add-single-arg! at key)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (OwnKeyCount [] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)]
                        (if (< object 0)
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  zero (ms-immediate! owner pinned-bid 0)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object 6 node))]
                              (ms-add-single-arg! at zero)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (OwnKeyAt [] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)
                            ordinal (ms-select-value-at! owner (n-in node 3) pinned-bid)]
                        (if (or (< object 0) (< ordinal 0))
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object 7 node))]
                              (ms-add-single-arg! at ordinal)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (InternalLoad [slot] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                  (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                          (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)]
                        (if (< object 0)
                            (ms-fail! MSEL-UNSUPPORTED node)
                            (let [fresh (ms-new-vreg!)
                                  zero (ms-immediate! owner pinned-bid 0)
                                  operation (+ 10 slot)
                                  at (ms-emit! owner pinned-bid
                                               (mi-new MI-JSPROP fresh object object operation node))]
                              (ms-add-single-arg! at zero)
                              (ms-add-memory-deps! at node 1 1)
                              (set! vr fresh)))))))
            (ArrayMark [] (let [ptr (n-in node 1)
                      source
                        (if (and (op-is? ptr Proj [_])
                                 (op-is? (n-in ptr 0) New [_]))
                            (n-in ptr 0)
                            ptr)
                      ; Prefer the mark's own control anchor; fall back to the allocation's
                      ; block for hand-built graphs that still float it.
                      mark-bid
                        (if (!= (n-in node 0) NO-NODE)
                            (ms-node-block owner node)
                            (ms-node-block owner source))
                      ; CLAIM THE VREG BEFORE SELECTING THE INPUT. Selecting the allocation
                      ; walks its memory chain, which can reach an ArrayStore whose array
                      ; input is THIS mark; without the early registration that re-entry
                      ; selected the mark a second time, and two instructions defining one
                      ; node cannot be scheduled.
                      fresh (ms-new-vreg!)]
                  (ms-vset! owner node fresh)
                  (ms-record-selected-block! owner node mark-bid)
                  (let [object (ms-select-value-at! owner (n-in node 1) mark-bid)]
                    (if (< object 0)
                        (ms-fail! MSEL-UNSUPPORTED node)
                        (let [at
                                (ms-emit! owner
                                          mark-bid
                                          (mi-new MI-JSARRAY fresh object object 0 node))]
                          (ms-add-single-arg! at object)
                          (set! vr fresh))))))
            (ArrayLoad [alias] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                        (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                    (ms-fail! MSEL-UNSUPPORTED node)
                    (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)
                          index (ms-array-index! owner (n-in node 3) pinned-bid)]
                      (if (or (< object 0) (< index 0))
                          (ms-fail! MSEL-UNSUPPORTED node)
                          (let [fresh (ms-new-vreg!)
                                effect-bid
                                  (if (>= (n-in node 0) 0)
                                      pinned-bid
                                      (ms-selection-value-block
                                        owner
                                        (ms-selection-value-block
                                          owner
                                          (ms-array-effect-block
                                            owner (n-in node 1) (n-in node 2) pinned-bid)
                                          object)
                                        index))
                                at
                                  (ms-emit! owner
                                            effect-bid
                                            (mi-new MI-JSARRAY fresh object index 1 node))]
                            (ms-add-single-arg! at object)
                            (ms-add-memory-deps! at node 1 1)
                            (set! vr fresh)))))))
            (ArrayLen [] (let [pinned-bid (ms-pinned-read-block owner node bid)]
                (if (or (not (ms-select-control-effects! owner (n-in node 0) pinned-bid))
                        (not (ms-select-memory-at! owner (n-in node 1) pinned-bid)))
                    (ms-fail! MSEL-UNSUPPORTED node)
                    (let [object (ms-select-value-at! owner (n-in node 2) pinned-bid)]
                      (if (< object 0)
                          (ms-fail! MSEL-UNSUPPORTED node)
                          (let [fresh (ms-new-vreg!)
                                effect-bid
                                  (if (>= (n-in node 0) 0)
                                      pinned-bid
                                      (ms-selection-value-block
                                        owner
                                        (ms-array-effect-block
                                          owner (n-in node 1) (n-in node 2) pinned-bid)
                                        object))
                                at
                                  (ms-emit! owner
                                            effect-bid
                                            (mi-new MI-JSARRAY fresh object object 3 node))]
                            (ms-add-single-arg! at object)
                            (ms-add-memory-deps! at node 1 1)
                            (set! vr fresh)))))))
            (Box [mode] (let [a (ms-select-value-at! owner (n-in node 1) bid)
                      tag (if (= mode BOX-AUX-ARRAY)
                              JSV-ARRAY
                              (if (be-node-fp-value? (n-in node 1))
                                  0
                                  (be-js-tag-for-value (n-in node 1))))]
                  (if (and (= mode BOX-AUX-INFER)
                           (and (>= a 0)
                           (and (not (be-node-fp-value? (n-in node 1)))
                                (be-box-input-already-tagged? (n-in node 1)))))
                      (set! vr a)
                      (if (or (< a 0) (= tag -1))
                          (do (ms-fail! MSEL-UNSUPPORTED node) 0)
                          (let [fresh (ms-new-vreg!)]
                            (ms-emit! owner bid (mi-new MI-JSBOX fresh a -1 tag node))
                            (set! vr fresh))))))
            (Unbox [target] (let [a (ms-select-value-at! owner (n-in node 1) bid)
                      tag (be-js-tag-for-type target)]
                  (if (or (< a 0) (= tag -1))
                      (do (ms-fail! MSEL-UNSUPPORTED node) 0)
                      (let [fresh (ms-new-vreg!)]
                        (ms-emit! owner bid (mi-new MI-JSUNBOX fresh a -1 tag node))
                        (set! vr fresh)))))
            (TypeTest [target] (let [a (ms-select-value-at! owner (n-in node 1) bid)
                      tag (be-js-tag-for-type target)
                      numeric (= target (t-num))]
                  (if (or (< a 0) (and (= tag -1) (not numeric)))
                      (do (ms-fail! MSEL-UNSUPPORTED node) 0)
                      ;; A NUMBER IS TWO TAGS. An immediate integer and an IEEE double are
                      ;; genuinely different NaN-box tags, so `be-js-tag-for-type` has no single
                      ;; answer for `int|flt` and used to refuse the test outright -- which is why
                      ;; `IsNumber` in `lib/` is written as `%IsInt` OR `%IsFlt` and why neither
                      ;; half can ever prove on a boxed operand.
                      ;;
                      ;; Selecting it as two tests and an OR needs no new instruction: it is the
                      ;; same shape the callable test three lines down already uses for
                      ;; function-or-closure. The double arm is `MI-JSTEST` with tag 0, which is
                      ;; the NaN-box range check rather than a tag compare.
                      ;; See docs/DSL-OWNERSHIP.md.
                      (if numeric
                          (let [as-int (ms-new-vreg!)]
                            (ms-emit! owner bid (mi-new MI-JSTEST as-int a -1 JSV-INTEGER NO-NODE))
                            (let [as-flt (ms-new-vreg!)]
                              (ms-emit! owner bid (mi-new MI-JSTEST as-flt a -1 0 NO-NODE))
                              (let [fresh (ms-new-vreg!)]
                                (ms-emit! owner bid (mi-new MI-BITOR fresh as-int as-flt 0 node))
                                (set! vr fresh))))
                      (if (= target (t-fun))
                          (let [direct (ms-new-vreg!)]
                            (ms-emit! owner bid (mi-new MI-JSTEST direct a -1 JSV-FUNCTION NO-NODE))
                            (let [closure (ms-new-vreg!)]
                              (ms-emit! owner bid (mi-new MI-JSTEST closure a -1 JSV-CLOSURE NO-NODE))
                              (let [fresh (ms-new-vreg!)]
                                (ms-emit! owner bid (mi-new MI-BITOR fresh direct closure 0 node))
                                (set! vr fresh))))
                          (let [fresh (ms-new-vreg!)]
                            (ms-emit! owner bid (mi-new MI-JSTEST fresh a -1 tag node))
                            (set! vr fresh)))))))
            (ArrayTest [] (let [a (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (< a 0)
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [fresh (ms-new-vreg!)]
                        (ms-emit! owner bid (mi-new MI-JSTEST fresh a -1 JSV-ARRAY node))
                        (set! vr fresh)))))
            (ArrayUnbox [] (let [a (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (< a 0)
                      (ms-fail! MSEL-UNSUPPORTED node)
                      (let [fresh (ms-new-vreg!)]
                        (ms-emit! owner bid (mi-new MI-JSUNBOX fresh a -1 JSV-ARRAY node))
                        (set! vr fresh)))))
            (Closure [captures]
              (if (= (n-nins node) (+ captures 3))
                  (if (ms-select-memory-at! owner (n-in node 2) bid)
                      (set! vr (ms-select-value-at! owner (n-in node 1) bid))
                      (ms-fail! MSEL-UNSUPPORTED node))
                  (ms-fail! MSEL-UNSUPPORTED node)))
            (Phi [declared]
              (if (be-profiling?)
                  (let [index (ms-map-index owner node)]
                    (do
                      (fmt (stderr)
                           "AOTK_PROFILE phase=selection_phi_miss owner={d} node={d} bid={d} ctrl={d} phi_block={d} memo_owner={d}\n"
                           owner node bid (n-in node 0) (ms-phi-block owner node)
                           (al-get (.selected-value-owners (machine-unit)) index))
                      0))
                  0))
            (Call [abi] (let [callee-node (n-in node 1)
                      callee (mu-direct-callee node)
                      targets (ty-fun-targets (n-ty callee-node))
                      ;; A dynamic JSL call must validate and dispatch the runtime callee even when
                      ;; closed-world analysis finds one possible target. Treating a singleton as
                      ;; direct silently ignored the heap-loaded value and called that target for
                      ;; `undefined` and non-callable properties alike.
                      polymorphic (or (= abi CALL-ABI-DYNAMIC-RECEIVER)
                                      (and (= callee NO-NODE)
                                           (> (popcount64 targets) 1)))
                      raw-argc (- (n-nins node) 2)
                      has-memory
                        (and (> raw-argc 0)
                             (ty-mem? (n-ty (n-in node (- (n-nins node) 1)))))
                      source-argc (- raw-argc (if has-memory 1 0))
                      ; Captured-receiver calls carry their normalized capture prefix directly on
                      ; the Call node.  Do not also prepend the Closure inputs or the receiver is
                      ; shifted by the capture count (for four captures, from x4 to x8).
                      explicit-captures (>= abi CALL-ABI-CAPTURE-BASE)
                      capturec
                        (if (and (op-is? callee-node Closure [_])
                                 (and (not explicit-captures)
                                      ; The uniform receiver ABI passes captures through the
                                      ; hidden environment argument; prepending the Closure's
                                      ; capture inputs as registers would shift the receiver
                                      ; and every declared argument.
                                      (!= abi CALL-ABI-RECEIVER)))
                            (n-closure-capture-count callee-node)
                            0)
                      materialized
                        (and (op-is? callee-node Closure [_])
                             (= (n-nins callee-node) (+ capturec 3)))
                      argc (+ capturec source-argc)
                      call-bid (ms-node-block owner node)]
                  (if (not (ms-select-control-effects! owner (n-in node 0) call-bid))
                      (ms-fail! MSEL-CALL node)
                      (if (and has-memory
                               (not (ms-select-memory-at! owner
                                                          (n-in node (- (n-nins node) 1))
                                                          call-bid)))
                      (ms-fail! MSEL-CALL (n-in node (- (n-nins node) 1)))
                      ; Capture-threading direct calls (a nested function receiving a dozen parent
                      ; cells plus its arguments) legitimately exceed the old 16-slot bound; the
                      ; ABI already spills past eight registers to the stack area.
                      (if (or (and (= callee NO-NODE) (not polymorphic)) (> argc 32))
                          (ms-fail! MSEL-CALL node)
                          (let [target (if polymorphic -1 (mu-find-function callee))
                                callee-value
                                  (if polymorphic
                                      (ms-select-value-at! owner callee-node call-bid)
                                      -1)]
                            (if (or (and (not polymorphic) (< target 0))
                                    (and polymorphic (< callee-value 0)))
                                (ms-fail! MSEL-CALL
                                          (if polymorphic callee-node node))
                                (let [u (machine-unit)
                                      buf (primitive/alloc-stack (array i64 32))
                                      args (cast (ptr i64) buf)
                                      (mut i) 0
                                      (mut ok) true]
                                  (loop (if (or (>= (load i) argc) (not (load ok)))
                                            (break)
                                            (do
                                              (let [source
                                                      (if (< (load i) capturec)
                                                          (n-in callee-node
                                                                (+ (- (n-nins callee-node) capturec)
                                                                   (load i)))
                                                          (n-in node (+ 2 (- (load i) capturec))))
                                                    ; A direct call has the exact logical capture
                                                    ; inputs on its Closure node. They are already
                                                    ; call uses (and therefore moving-GC roots).
                                                    ; Reloading them from the materialized closure
                                                    ; object can race its field initialization in
                                                    ; local scheduling and read allocator zeros.
                                                    selected (ms-select-value-at! owner source call-bid)
                                                    js-value-slot
                                                      (or (and (or (= abi CALL-ABI-RECEIVER)
                                                                   (= abi CALL-ABI-DYNAMIC-RECEIVER))
                                                               (or (= (load i) 1) (>= (load i) 3)))
                                                          (and (>= abi CALL-ABI-CAPTURE-BASE)
                                                               (>= (load i) capturec)))
                                                    tag (if (and js-value-slot
                                                                 (not (be-box-input-already-tagged?
                                                                        source)))
                                                            (be-js-tag-for-value source)
                                                            -1)
                                                    arg
                                                      (if (!= tag -1)
                                                          (let [boxed (ms-new-vreg!)]
                                                            (ms-emit! owner call-bid
                                                                      (mi-new MI-JSBOX boxed selected
                                                                              -1 tag NO-NODE))
                                                            boxed)
                                                          selected)]
                                                (if (< arg 0)
                                                    (set! ok false)
                                                    (set! (index args (load i)) arg)))
                                              (set! i (+ (load i) 1))
                                              0)))
                                  (if (load ok)
                                      (let [first (al-len [i64] (.call-args u))
                                            fresh (ms-new-vreg!)
                                            (mut j) 0]
                                        (loop (if (>= (load j) argc)
                                                  (break)
                                                  (do
                                                    (al-push! [i64]
                                                              (field u call-args)
                                                              (load (index args (load j))))
                                                    (set! j (+ (load j) 1))
                                                    0)))
                                        (let [a (if polymorphic callee-value
                                                   (if (> argc 0) (al-get (.call-args u) first) -1))
                                              b (if (> argc 1) (al-get (.call-args u) (+ first 1)) -1)
                                              at
                                                (ms-emit! owner
                                                          call-bid
                                                          (mi-new MI-CALL fresh a b
                                                                  (if polymorphic
                                                                      (^ (be-call-target-summary (n-ty callee-node)) -1)
                                                                      target)
                                                                  node))]
                                          (ms-add-call-args! at (if (= argc 0) -1 first) argc)
                                          (if has-memory
                                              (ms-add-memory-deps! at node (- (n-nins node) 1) 1)
                                              0)
                                          (set! vr fresh)))
                                      0)))))))))
            (_ (ms-fail! MSEL-UNSUPPORTED node)))
          (if (< (load vr) 0)
              -1
              (do
                (ms-vset! owner node (load vr))
                (ms-record-selected-block! owner node bid)
                (load vr)))))))

(defn ms-phi-block [(owner i64) (phi i64)] (-> i64)
  (if (or (not (op-is? phi Phi [_])) (= (n-in phi 0) NO-NODE))
      -1
      (let [bid (al-get (.ctrl-block (machine-unit)) (n-in phi 0))]
        (if (and (>= bid 0) (= (mu-block-owner bid) owner)) bid -1))))

(defn ms-cache-block-phis! [] (-> i64)
  (let [u (machine-unit)
        (mut i) 0
        (mut node) (n-count)]
    (al-clear! [i64] (field u block-phi-head))
    (al-clear! [i64] (field u node-phi-next))
    (loop (if (>= (load i) (mu-block-count))
              (break)
              (do
                (al-push! [i64] (field u block-phi-head) -1)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (n-count))
              (break)
              (do
                (al-push! [i64] (field u node-phi-next) -1)
                (set! i (+ (load i) 1)))))
    ;; Prepend in reverse node order so each block list preserves the old ascending graph scan.
    (loop (if (<= (load node) 0)
              (break)
              (do
                (set! node (- (load node) 1))
                (if (and (not (n-dead? (load node)))
                         (and (op-is? (load node) Phi [_]) (> (n-nins (load node)) 0)))
                    (let [ctrl (n-in (load node) 0)
                          bid (if (= ctrl NO-NODE) -1 (al-get (.ctrl-block u) ctrl))]
                      (if (and (>= bid 0) (< bid (mu-block-count)))
                          (do
                            (al-set! [i64] (field u node-phi-next) (load node)
                                     (al-get (.block-phi-head u) bid))
                            (al-set! [i64] (field u block-phi-head) bid (load node)))
                          0))
                    0))))
    0))

; Reserve every scalar Phi destination before selecting any incoming expression.  This is the
; essential fixed point for loop-carried and mutually recursive Phis: a back-edge expression can
; refer to a destination whose copy has not been constructed yet without recursing forever.
(defn ms-preallocate-phis! [(owner i64)] (-> i64)
  (let [u (machine-unit)
        nblocks (mu-function-block-count owner)
        (mut rpo) 0]
    (loop (if (>= (load rpo) nblocks)
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      (mut node) (al-get (.block-phi-head u) bid)]
                  (loop (if (< (load node) 0)
                            (break)
                            (do
                              (if (ty-mem? (n-ty (load node)))
                                  (ms-seen! owner (load node))
                                  (let [vreg (ms-new-vreg!)]
                                    (ms-vset! owner (load node) vreg)
                                    (al-set! [i64] (field (machine-unit) vreg-phi-block)
                                             vreg
                                             bid)))
                              (set! node (al-get (.node-phi-next u) (load node)))))))
                (set! rpo (+ (load rpo) 1))
                0)))
    0))

(defn ms-build-edge-copies! [(owner i64)] (-> i64)
  (let [u (machine-unit)
        nblocks (mu-function-block-count owner)
        (mut rpo) 0]
    (loop (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      succs (mu-block-succ-count bid)
                      (mut succ) 0]
                  (loop (if (or (>= (load succ) succs) (!= (ms-result) MSEL-OK))
                            (break)
                            (do
                      (let [edge (mu-block-succ-edge bid (load succ))
                            e (mu-edge edge)
                            first (al-len [MCopy] (.edge-copies u))
                            target (.target e)
                            source (.source e)
                            slot (.target-slot e)
                            (mut node) (al-get (.block-phi-head u) target)]
                        (loop (if (or (< (load node) 0) (!= (ms-result) MSEL-OK))
                                  (break)
                                  (do
                                    (if (>= slot (n-nins (load node)))
                                        (ms-fail! MSEL-DEPENDENCY (load node))
                                        (if (ty-mem? (n-ty (load node)))
                                            (if (ms-select-memory-at! owner
                                                                      (n-in (load node) slot)
                                                                      source)
                                                (al-push! [MCopy]
                                                          (field u edge-copies)
                                                          (mc-new edge
                                                                  (load node)
                                                                  (load node)
                                                                  (n-in (load node) slot)
                                                                  MCOPY-MEMORY))
                                                0)
                                            (let [input (n-in (load node) slot)
                                                  raw (ms-select-value-at! owner input source)
                                                  src
                                                    (if (and (>= raw 0)
                                                             (be-node-fp-value? (load node)))
                                                        (ms-fp-input! owner input raw source)
                                                        raw)]
                                              (if (< src 0)
                                                  (ms-fail! MSEL-DEPENDENCY input)
                                                  (al-push! [MCopy]
                                                            (field u edge-copies)
                                                            (mc-new edge
                                                                    (load node)
                                                                    (ms-vget owner (load node))
                                                                    src
                                                                    MCOPY-VALUE))))))
                                    (set! node (al-get (.node-phi-next u) (load node)))
                                    0)))
                        (set! (.copy-first e) first)
                        (set! (.copy-count e) (- (al-len [MCopy] (.edge-copies u)) first)))
                      (set! succ (+ (load succ) 1))))))
                (set! rpo (+ (load rpo) 1))
                0)))
    0))

(defn ms-work-dst-used-as-source? [(at i64)] (-> bool)
  (let [u (machine-unit)
        dst (al-get (.copy-work-dst u) at)
        n (al-len [i64] (.copy-work-live u))
        (mut i) 0
        (mut used) false]
    (loop (if (or (>= (load i) n) (load used))
              (break)
              (do
                (if (and (!= (al-get (.copy-work-live u) (load i)) 0)
                         (= (al-get (.copy-work-src u) (load i)) dst))
                    (set! used true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load used)))

(defn ms-resolve-edge-copies! [(edge i64)] (-> i64)
  (let [u (machine-unit)
        e (mu-edge edge)
        first (al-len [MMove] (.edge-moves u))
        copies (.copy-count e)
        (mut i) 0
        (mut remaining) 0]
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (loop (if (>= (load i) copies)
              (break)
              (do
                (let [c (mu-edge-copy edge (load i))]
                  (if (or (!= (.kind c) MCOPY-VALUE)
                          (= (.dst c) (.src c)))
                      0
                      (do
                        (al-push! [i64] (field u copy-work-dst) (.dst c))
                        (al-push! [i64] (field u copy-work-src) (.src c))
                        (al-push! [i64] (field u copy-work-live) 1)
                        (set! remaining (+ (load remaining) 1)))))
                (set! i (+ (load i) 1))
                0)))
    (loop (if (<= (load remaining) 0)
              (break)
              (let [n (al-len [i64] (.copy-work-live u))
                    (mut ready) -1
                    (mut first-live) -1]
                (set! i 0)
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (if (!= (al-get (.copy-work-live u) (load i)) 0)
                                (do
                                  (if (< (load first-live) 0) (set! first-live (load i)) 0)
                                  (if (not (ms-work-dst-used-as-source? (load i)))
                                      (do (set! ready (load i)) (set! i n))
                                      0))
                                0)
                            (set! i (+ (load i) 1))
                            0)))
                (if (>= (load ready) 0)
                    (do
                      (al-push! [MMove]
                                (field u edge-moves)
                                (mm-new edge
                                        (al-get (.copy-work-dst u) (load ready))
                                        (al-get (.copy-work-src u) (load ready))
                                        false))
                      (al-set! [i64] (field u copy-work-live) (load ready) 0)
                      (set! remaining (- (load remaining) 1)))
                    ; No destination is dead: preserve one source in a fresh vreg, rewrite every use of
                    ; that old source, and the cycle becomes an acyclic chain on the next iteration.
                    (let [old-src (al-get (.copy-work-src u) (load first-live))
                          temp (ms-new-vreg!)]
                      (al-push! [MMove] (field u edge-moves) (mm-new edge temp old-src true))
                      (set! i 0)
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (if (and (!= (al-get (.copy-work-live u) (load i)) 0)
                                           (= (al-get (.copy-work-src u) (load i)) old-src))
                                      (al-set! [i64] (field u copy-work-src) (load i) temp)
                                      0)
                                  (set! i (+ (load i) 1))
                                  0))))))))
    (set! (.move-first e) first)
    (set! (.move-count e) (- (al-len [MMove] (.edge-moves u)) first))
    0))

(defn ms-resolve-owner-copies! [(owner i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner)
        (mut rpo) 0]
    (loop (if (>= (load rpo) nblocks)
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      succs (mu-block-succ-count bid)
                      (mut succ) 0]
                  (loop (if (>= (load succ) succs)
                            (break)
                            (do
                              (ms-resolve-edge-copies! (mu-block-succ-edge bid (load succ)))
                              (set! succ (+ (load succ) 1))))))
                (set! rpo (+ (load rpo) 1))
                0)))
    0))

(defn ms-if-target [(bid i64) (arm i64)] (-> i64)
  (let [n (mu-block-succ-count bid)
        (mut i) 0
        (mut found) -1
        (mut fallthrough) -1
        (mut fallthrough-count) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [target (mu-block-succ-target bid (load i))
                      ctrl (mu-block-control target)]
                  (if (match (n-op ctrl) (CProj [label] (= label arm)) (_ false))
                      (set! found target)
                      (if (not (op-is? ctrl CProj [_]))
                          (do (set! fallthrough target)
                              (set! fallthrough-count (+ (load fallthrough-count) 1))
                              0)
                          0)))
                (set! i (+ (load i) 1))
                0)))
    (if (>= (load found) 0)
        (load found)
        (if (and (= n 2) (= (load fallthrough-count) 1))
            (load fallthrough)
            -1))))

(defn ms-function-fp-return? [(owner i64)] (-> bool)
  (let [count (mu-function-return-count owner)
        (mut i) 0
        (mut fp) false]
    (loop (if (or (>= (load i) count) (load fp))
              (break)
              (do
                (let [bid (mu-function-return-block owner (load i))
                      term (mu-block-terminator bid)]
                  (if (and (!= term NO-NODE)
                           (and (op-is? term Return [])
                                (and (not (be-exception-return? term))
                                (be-node-fp-value? (n-in term 1)))))
                      (set! fp true)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load fp)))

(defn ms-ingress-owned-by? [(owner i64) (node i64)] (-> bool)
  (if (op-is? node Parm [_])
      (= (mu-find-function (n-in node 0)) owner)
      (let [ctrl (n-in node 0)]
        (if (op-is? ctrl Start [])
            (= owner 0)
            (and (op-is? ctrl FunStart [])
                 (= (mu-find-function (n-in ctrl 0)) owner))))))

(defn ms-build-preselect-candidates! [] (-> i64)
  (let [u (machine-unit) (mut node) 0]
    (al-clear! [i64] (field u selection-ingress-candidates))
    (al-clear! [i64] (field u selection-effect-candidates))
    (loop (if (>= (load node) (n-count))
              (break)
              (do
                (if (not (n-dead? (load node)))
                    (do
                      (if (and (or (op-is? (load node) Arg [_])
                                   (op-is? (load node) Parm [_]))
                               (not (ty-mem? (n-ty (load node)))))
                          (al-push! [i64] (field u selection-ingress-candidates) (load node))
                          0)
                      (if (or (op-is? (load node) Call [_])
                              (ms-linear-memory-effect? (load node)))
                          (al-push! [i64] (field u selection-effect-candidates) (load node))
                          0))
                    0)
                (set! node (+ (load node) 1)))))
    0))

(defn ms-preselect-function! [(owner i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner)
        (mut node) 0
        (mut rpo) 0]
    ;; ABI ingress exists only at function entry. Select source arguments before recursively
    ;; selecting a body whose allocations/calls may clobber their physical ingress registers.
    ;; Memory Args are effect tokens and never become machine arguments.
    (loop (if (or (>= (load node) (al-len [i64] (.selection-ingress-candidates (machine-unit))))
                  (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [candidate (al-get [i64]
                                        (.selection-ingress-candidates (machine-unit))
                                        (load node))
                      bid (ms-node-block owner candidate)]
                      (if (and (ms-ingress-owned-by? owner candidate)
                               (and (>= bid 0) (= (.owner (mu-block bid)) owner)))
                          (ms-select-value-at! owner candidate bid)
                          0))
                (set! node (+ (load node) 1)))))
    (loop (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      term (mu-block-terminator bid)]
                  (if (= term NO-NODE)
                      0
                      (match (n-op term)
                        (If [] (ms-select-value-at! owner (n-in term 1) bid))
                        (Return [] (do
                              (ms-select-control-effects! owner (n-in term 0) bid)
                              (if (> (n-nins term) 2)
                                  (do (ms-select-memory! owner (n-in term 2)) 0)
                                  0)
                              (let [node (n-in term 1)
                                    raw (ms-select-value-at! owner node bid)
                                    return-kind (be-function-return-kind owner)
                                    normalized
                                      (if (and (>= raw 0)
                                               (and (= return-kind MLK-SCALAR)
                                                    (and (be-function-fp-return? owner)
                                                         (not (be-node-fp-value? node)))))
                                          (let [converted (ms-new-vreg!)]
                                            (ms-emit! owner bid
                                                      (mi-new MI-SCVTF converted raw -1 0 NO-NODE))
                                            converted)
                                          raw)
                                    ;; The KERNEL returns to the C harness through x0. An integer
                                    ;; result is already a raw x0 word, but a FLOAT result sits in
                                    ;; d0 and the harness reads whatever scratch is left in x0
                                    ;; (repro: `readX(p) * 4` returned the literal 4). So for
                                    ;; JS-frontend graphs (g-rep-strict) the kernel materializes
                                    ;; FP results into x0 as raw IEEE bits (JSBOX tag 0) — and
                                    ;; nothing else changes, so raw-integer harness contracts and
                                    ;; raw Coil test graphs keep their exact results.
                                    kernel-fp-return
                                      (and (= owner 0)
                                           (and (> (g-rep-strict?) 0)
                                                (if (op-is? node Call [_])
                                                    (let [direct (infer-direct-callee-fun node)
                                                          towner (if (= direct NO-NODE)
                                                                     -1
                                                                     (mu-find-function direct))]
                                                      (and (>= towner 0)
                                                           (and (= (be-function-return-kind towner)
                                                                   MLK-SCALAR)
                                                                (be-function-fp-return? towner))))
                                                    (be-node-fp-value? node))))
                                    boxed-return
                                      (and (be-function-return-mixed? owner)
                                           (= return-kind MLK-BOXED))
                                    value
                                      (if (< normalized 0)
                                          normalized
                                          (if kernel-fp-return
                                              (let [boxed (ms-new-vreg!)]
                                                (ms-emit! owner
                                                          bid
                                                          (mi-new MI-JSBOX boxed normalized -1 0 term))
                                                boxed)
                                              (if (and boxed-return
                                                       (not (be-box-input-already-tagged? node)))
                                                  (let [tag (if (be-node-fp-value? node)
                                                                0
                                                                (be-js-tag-for-value node))]
                                                    (if (= tag -1)
                                                        -1
                                                        (let [boxed (ms-new-vreg!)]
                                                          (ms-emit! owner
                                                                    bid
                                                                    (mi-new MI-JSBOX boxed normalized -1 tag term))
                                                          boxed)))
                                                  normalized)))]
                                (if (< value 0)
                                    (ms-fail! MSEL-UNSUPPORTED term)
                                    (if (or kernel-fp-return boxed-return)
                                        (do (ms-vset! owner term value) value)
                                        value)))))
                        (_ (ms-fail! MSEL-TERMINATOR term)))))
                (set! rpo (+ (load rpo) 1))
                0)))
    ;; Dynamic JavaScript effects are not represented in a function's fixed-field Return memory
    ;; tuple. Select them after control predicates and returns have established the earliest shared
    ;; value placements; an effect-only branch must not pin a common predicate below its use.
    (set! node 0)
    (loop (if (or (>= (load node) (al-len [i64] (.selection-effect-candidates (machine-unit))))
                  (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [candidate (al-get [i64]
                                        (.selection-effect-candidates (machine-unit))
                                        (load node))]
                    (if (op-is? candidate Call [_])
                        (let [bid (ms-node-block owner candidate)]
                          (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                              (do (ms-select-value-at! owner candidate bid) 0)
                              0))
                        (if (ms-linear-memory-effect? candidate)
                            ;; THIS SWEEP WALKS THE WHOLE GRAPH, so the block query alone is not an
                            ;; ownership test -- see `ms-memory-chain-owner`. When the chain names a
                            ;; function, only that function adopts the effect; when it names none,
                            ;; the block fallback still decides, exactly as before.
                            (let [bid (ms-memory-block owner candidate)
                                  chain-owner (ms-memory-chain-owner candidate)]
                              (if (and (>= bid 0)
                                       (and (= (mu-block-owner bid) owner)
                                            (or (< chain-owner 0) (= chain-owner owner))))
                                  (do (ms-select-memory-at! owner candidate bid) 0)
                                  0))
                            0)))
                (set! node (+ (load node) 1)))))
    0))

(defn ms-emit-block-terminator! [(owner i64) (bid i64)] (-> i64)
  (let [term (mu-block-terminator bid)]
    (if (= (mu-block-succ-count bid) 1)
        (let [edge (mu-block-succ-edge bid 0)
              moves (mu-edge-move-count edge)
              (mut i) 0]
          (loop (if (>= (load i) moves)
                    (break)
                    (do
                      (ms-emit! owner
                                bid
                                (mi-new MI-COPY
                                        (mu-move-dst edge (load i))
                                        (mu-move-src edge (load i))
                                        -1
                                        edge
                                        NO-NODE))
                      (set! i (+ (load i) 1))
                      0))))
        0)
    ;; Reachability can collapse an ideal If to one machine-CFG successor. The CFG is authoritative:
    ;; emit its sole edge as an unconditional jump instead of requiring a target for the dead arm.
    (if (= (mu-block-succ-count bid) 1)
        (ms-emit! owner
                  bid
                  (mi-new MI-JMP
                          -1
                          -1
                          -1
                          (mu-block-succ-target bid 0)
                          (mu-block-control bid)))
        (if (= term NO-NODE)
            (do
              (if (be-profiling?)
                  (let [(mut out) 0
                        ctrl (mu-block-control bid)]
                    (fmt (stderr)
                         "AOTK_PROFILE phase=selection_missing_terminator owner={d} bid={d} ctrl={d} succ={d} pred={d}\n"
                         owner bid ctrl (mu-block-succ-count bid)
                         (mu-block-pred-count bid))
                    (loop (if (>= (load out) (n-nouts ctrl))
                              (break)
                              (do
                                (let [next (n-out ctrl (load out))
                                      (mut nested) 0]
                                  (n-print-flat (stderr) next)
                                  (loop (if (>= (load nested) (n-nouts next))
                                            (break)
                                            (do
                                              (n-print-flat (stderr)
                                                            (n-out next (load nested)))
                                              (set! nested (+ (load nested) 1))
                                              0))))
                                (set! out (+ (load out) 1)))))
                    0)
                  0)
              (ms-fail! MSEL-TERMINATOR (mu-block-control bid)))
        (match (n-op term)
          (If [] (let [pred-node (n-in term 1)
                    raw-pred (ms-vget owner pred-node)
                    pred
                      (if (and (>= raw-pred 0)
                               (and (= (n-ty pred-node) (t-dyn))
                                    (be-js-dynamic-boundary? pred-node)))
                          (let [zero (ms-immediate! owner bid 0)]
                            (ms-jsstring! owner bid NO-NODE raw-pred zero zero JSSOP-VALUE-TRUTHY))
                          (if (and (>= raw-pred 0) (be-node-fp-value? pred-node))
                          (let [fresh (ms-new-vreg!)]
                            (ms-emit! owner
                                      bid
                                      (mi-new MI-FTRUTH fresh raw-pred -1 0 NO-NODE))
                            fresh)
                          raw-pred))
                    yes (ms-if-target bid 0)
                    no (ms-if-target bid 1)]
                (if (or (< pred 0) (or (< yes 0) (< no 0)))
                    (do
                      (if (be-profiling?)
                          (do
                            (fmt (stderr)
                                 "AOTK_PROFILE phase=selection_terminator_miss owner={d} bid={d} term={d} raw_pred={d} pred={d} yes={d} no={d} succ={d}\n"
                                 owner bid term raw-pred pred yes no (mu-block-succ-count bid))
                            0)
                          0)
                      (ms-fail! MSEL-TERMINATOR term))
                    (ms-emit! owner bid (mi-new MI-CBR -1 pred yes no term)))))
          (Return [] (let [node (n-in term 1)
                    raw (ms-vget owner node)
                    normalized (ms-vget owner term)
                    value
                      (if (>= normalized 0)
                          normalized
                          (if (and (>= raw 0) (ms-function-fp-return? owner))
                              (ms-fp-input! owner node raw bid)
                              raw))]
                (if (< value 0)
                    (ms-fail! MSEL-DEPENDENCY term)
                    (ms-emit! owner bid (mi-new MI-RET -1 value -1 0 term)))))
          (_ (ms-fail! MSEL-TERMINATOR term)))))))

(defn ms-emit-function! [(owner i64) (base i64)] (-> i64)
  (let [nblocks (mu-function-block-count owner)
        entry (ms-entry-block owner)
        (mut rpo) 0]
    (loop (if (or (>= (load rpo) nblocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [bid (mu-function-block owner (load rpo))
                      b (mu-block bid)
                      first (if (= bid entry) base (be-inst-count))
                      succs (mu-block-succ-count bid)
                      (mut succ) 0]
                  ;; Copy descriptions for the whole owner are complete. Resolve this block's
                  ;; outgoing edges immediately before emitting its terminator, so control
                  ;; materialization and edge post-selection share one adjacency walk.
                  (loop (if (>= (load succ) succs)
                            (break)
                            (do
                              (ms-resolve-edge-copies! (mu-block-succ-edge bid (load succ)))
                              (set! succ (+ (load succ) 1)))))
                  (set! (.inst-first b) first)
                  (ms-emit-block-terminator! owner bid)
                  (set! (.inst-count b) (- (be-inst-count) first)))
                (set! rpo (+ (load rpo) 1))
                0)))
    0))

(defn ms-cache-def-insts! [] (-> i64)
  (let [u (machine-unit)
        nodes (n-count)
        funcs (mu-function-count)
        (mut at) 0]
    (al-clear! [i64] (field u vreg-def-inst))
    (al-clear! [i64] (field u node-inst-head))
    (al-clear! [i64] (field u node-inst-next))
    (loop (if (>= (load at) (.next-vreg u))
              (break)
              (do (al-push! [i64] (field u vreg-def-inst) -1)
                  (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) (* funcs nodes))
              (break)
              (do (al-push! [i64] (field u node-inst-head) -1)
                  (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load at))
                      dst (.dst m)
                      owner (.owner m)
                      node (.node m)]
                  (if (and (>= dst 0)
                           (= (al-get [i64] (.vreg-def-inst u) dst) -1))
                      (al-set! [i64] (field u vreg-def-inst) dst (load at))
                      0)
                  (al-push! [i64] (field u node-inst-next) -1)
                  (if (and (>= node 0) (and (< node nodes)
                           (and (>= owner 0) (< owner funcs))))
                      (let [key (+ (* owner nodes) node)]
                        (al-set! [i64] (field u node-inst-next) (load at)
                                 (al-get [i64] (.node-inst-head u) key))
                        (al-set! [i64] (field u node-inst-head) key (load at)))
                      0))
                (set! at (+ (load at) 1)))))
    0))

(defn ms-pack-instructions! [] (-> i64)
  (let [u (machine-unit)
        original (be-inst-count)
        blocks (mu-block-count)
        (mut bid) 0
        (mut at) 0]
    (al-clear! [MInst] (field u packed-insts))
    (al-clear! [i64] (field u pack-next))
    (al-clear! [i64] (field u pack-term-next))
    ;; Count ordinary and terminator instructions per block in one instruction pass.
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (set! (.inst-count (mu-block (load bid))) 0)
                (al-push! [i64] (field u pack-next) 0)
                (al-push! [i64] (field u pack-term-next) 0)
                (set! bid (+ (load bid) 1)))))
    (loop (if (>= (load at) original)
              (break)
              (do
                (let [m (be-inst (load at))
                      block (.block-id m)]
                  (if (mi-op-terminator? (.op m))
                      (al-set! [i64] (field u pack-next) block
                               (+ (al-get (.pack-next u) block) 1))
                      (set! (.inst-count (mu-block block))
                            (+ (.inst-count (mu-block block)) 1))))
                (set! at (+ (load at) 1)))))
    ;; Prefix block ranges in function/RPO block order. pack-next and pack-term-next become the
    ;; ordinary/terminator write cursors after their counts have established both starts.
    (let [(mut first) 0
          (mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (let [nblocks (mu-function-block-count (load owner))
                        (mut rpo) 0]
                    (loop (if (>= (load rpo) nblocks)
                              (break)
                              (do
                                (let [block (mu-function-block (load owner) (load rpo))
                                      b (mu-block block)
                                      nonterms (.inst-count b)
                                      terms (al-get (.pack-next u) block)]
                                  (set! (.inst-first b) (load first))
                                  (set! (.inst-count b) (+ nonterms terms))
                                  (al-set! [i64] (field u pack-next) block (load first))
                                  (al-set! [i64] (field u pack-term-next) block
                                           (+ (load first) nonterms))
                                  (set! first (+ (+ (load first) nonterms) terms)))
                                (set! rpo (+ (load rpo) 1)))))
                  (set! owner (+ (load owner) 1)))))))
    ;; Reserve exact output length, then scatter in original order into each block's two ranges.
    (set! at 0)
    (loop (if (>= (load at) original)
              (break)
              (do
                (al-push! [MInst] (field u packed-insts) (load (be-inst (load at))))
                (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) original)
              (break)
              (do
                (let [m (be-inst (load at))
                      block (.block-id m)
                      cursor (if (mi-op-terminator? (.op m))
                                 (.pack-term-next u)
                                 (.pack-next u))
                      out (al-get cursor block)]
                  (al-set! [MInst] (field u packed-insts) out (load m))
                  (if (mi-op-terminator? (.op m))
                      (al-set! [i64] (field u pack-term-next) block (+ out 1))
                      (al-set! [i64] (field u pack-next) block (+ out 1))))
                (set! at (+ (load at) 1)))))
    (al-clear! [MInst] (field (backend) ins))
    (let [n (al-len [MInst] (.packed-insts u))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! [MInst]
                            (field (backend) ins)
                            (al-get (.packed-insts u) (load i)))
                  (set! i (+ (load i) 1))
                  0))))
    ;; Cache the first physical definition, matching the old RPO/textual lookup exactly.
    (ms-cache-def-insts!)))

(defn ms-phi-vreg-block [(owner i64) (vreg i64)] (-> i64)
  (let [u (machine-unit)]
    (if (or (< vreg 0) (>= vreg (al-len [i64] (.vreg-phi-block u))))
        -1
        (let [block (al-get [i64] (.vreg-phi-block u) vreg)]
          (if (and (>= block 0) (= (mu-block-owner block) owner)) block -1)))))

(defn ms-owner-def-inst [(owner i64) (vreg i64)] (-> i64)
  (let [defs (.vreg-def-inst (machine-unit))]
    (if (or (< vreg 0) (>= vreg (al-len [i64] defs)))
        -1
        (let [at (al-get [i64] defs vreg)]
          (if (and (>= at 0) (= (ms-inst-owner at) owner)) at -1)))))

(defn ms-vreg-def-block [(owner i64) (vreg i64)] (-> i64)
  (let [phi-block (ms-phi-vreg-block owner vreg)]
    ; Phi copies have several physical definitions. The SSA definition is the target block,
    ; independent of which incoming copy happens to be first in instruction order.
    (if (>= phi-block 0)
        phi-block
        (let [def (ms-owner-def-inst owner vreg)]
          (if (>= def 0) (ms-inst-block def) -1)))))

(defn ms-gcm-deeper-bound [(current i64) (dependency i64)] (-> i64)
  (if (< dependency 0)
      current
      (if (mu-dominates? current dependency)
          dependency
          (if (mu-dominates? dependency current) current -1))))

(defn ms-gcm-input-bound [(owner i64) (current i64) (vreg i64)] (-> i64)
  (if (< vreg 0)
      current
      (let [block (ms-vreg-def-block owner vreg)
            def (ms-owner-def-inst owner vreg)
            ;; Demand-driven selection may first emit a pure producer in one consumer's block.
            ;; Once GCM has computed that producer's true earliest block, depend on that bound rather
            ;; than treating the provisional emission block as semantic control.
            dependency
              (if (or (< def 0) (ms-phi-vreg? owner vreg))
                  block
                  (let [earliest (ms-inst-earliest def)]
                    (if (>= earliest 0) earliest -1)))]
        (ms-gcm-deeper-bound current dependency))))

;; A HEAP OPERATION MUST NOT FLOAT OFF THE CONTROL IT WAS ANCHORED TO. `n-array-store-at!` and its
;; siblings take a real control input precisely to say which block the operation belongs to, and
;; global code motion computed `earliest` from VALUE inputs alone — so an anchor deeper than every
;; operand was simply discarded.
;;
;; What that cost: a store whose result vreg has no consumer gets `latest = earliest`, there being no
;; use to bound it from below, so GCM placed it at its earliest block. For a store in a loop body
;; whose operands are the loop-header Phis, that block is the LOOP HEADER, and the store then ran
;; once per header visit rather than once per body visit — one time too many, on the trip that
;; exits. `ArrayIota 3` built an array of length four, and every JSL definition that writes an array
;; in a loop was wrong by one. Nothing caught it because no gate had ever read a JSL-built array's
;; length back as machine code.
;;
;; BOTH DIRECTIONS COUNT. A read that floats past a write of the same memory answers the wrong thing
;; just as surely as a write that floats past a read: `ArrayShift` loads element 0 and then a loop
;; moves every element down over it, and because the load's only consumers are after the loop, GCM
;; sank it there and `shift` answered the SECOND element.
;;
;; So an anchor is honoured for any heap operation that HAS one. Nothing is lost by that: the
;; `-at!`-less builders exist for the reads that genuinely may float, they pass NO-NODE, and the
;; loop-invariant motion this pass is for is over pure ops like `%StringIndexOf`, which have no
;; control input at all.
;; WHICH OPERATIONS BELONG TO THE BLOCK THEIR CONTROL NAMES, rather than to wherever global code
;; motion would rather have them. Every heap read and write is one, because a read hoisted above its
;; guard reads a value the guard exists to prevent.
;;
;; `JsThrow` IS ONE TOO, AND IT IS NOT A HEAP OPERATION. It lowers to a runtime call that never
;; returns -- `exit(70)` -- and its only consumer is the Phi that joins its arm with the other one,
;; so nothing keeps it inside its guard: `ms-gcm-place!` moved it to the shallowest block between
;; its inputs and that Phi, which for `for (const x of xs)` inside another loop is OUTSIDE both
;; loops. Every such program aborted with "uncaught JavaScript throw" before the first iteration,
;; including one whose outer loop ran ZERO times, while the guard that should have skipped it sat
;; correctly in the loop body two thousand instructions later reading the already-thrown result.
;; A value may be computed early; an operation that ENDS THE PROCESS may not.
(defn ms-anchored-memory-op? [(node i64)] (-> bool)
  (or (ms-linear-memory-effect? node)
      (match (n-op node)
        (Load [_] true) (PropLoad [_] true) (PropHas [_] true) (ProtoHas [] true)
        (PropLoadKey [_] true) (PropHasKey [] true) (InternalLoad [_] true)
        (ArrayLoad [_] true) (ArrayLen [] true) (JsThrow [] true)
        ;; Checked unboxing can trap. Its explicit ideal node must remain below the guard carried
        ;; by its Cast/value chain; backend-inserted conversion instructions have NO-NODE and stay
        ;; freely schedulable.
        (Unbox [_] true) (ArrayUnbox [] true)
        ;; Exception transport descriptors are process state reads/writes and must remain after
        ;; the call or throw whose status they inspect. Ordinary numeric JsBuiltins remain pure.
        (JsBuiltin [descriptor] (>= descriptor 101))
        (_ false))))

;; The block a control-anchored heap operation belongs to, or -1 when it has none.
(defn ms-inst-anchor-block [(owner i64) (at i64)] (-> i64)
  (let [n (.node (be-inst at))]
    (if (or (< n 0) (not (ms-anchored-memory-op? n)))
        -1
        (ms-value-anchor-block owner n 16))))

(defn ms-inst-anchored? [(owner i64) (at i64)] (-> bool)
  (>= (ms-inst-anchor-block owner at) 0))

(defn ms-gcm-anchor-bound [(owner i64) (at i64) (bound i64)] (-> i64)
  (let [anchor (ms-inst-anchor-block owner at)]
    (if (or (< bound 0) (< anchor 0)) bound anchor)))

(defn ms-gcm-refresh-earliest! [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (.owner m)
        desc (mi-desc (.op m))
        inputs (mi-desc-inputs desc)
        (mut bound) (ms-entry-block owner)]
    (if (> inputs 0)
        (set! bound (ms-gcm-input-bound owner (load bound) (.a m)))
        0)
    (if (and (>= (load bound) 0) (> inputs 1))
        (set! bound (ms-gcm-input-bound owner (load bound) (.b m)))
        0)
    (if (and (>= (load bound) 0) (= (.op m) MI-CSEL))
        (set! bound (ms-gcm-input-bound owner (load bound) (.imm m)))
        0)
    (if (and (>= (load bound) 0) (> (ms-inst-arg-count at) 0))
        (let [(mut arg) 0]
          (loop (if (or (>= (load arg) (ms-inst-arg-count at)) (< (load bound) 0))
                    (break)
                    (do
                      (set! bound
                            (ms-gcm-input-bound owner
                                                (load bound)
                                                (ms-inst-arg at (load arg))))
                      (set! arg (+ (load arg) 1))))))
        0)
    (set! bound (ms-gcm-anchor-bound owner at (load bound)))
    (if (< (load bound) 0)
        false
        (do (set! (.earliest m) (load bound)) true))))

(defn ms-gcm-compute-earliest! [] (-> bool)
  (let [n (be-inst-count)
        started (ms-profile-now)
        (mut round) 0
        (mut changed) true
        (mut ok) true]
    (let [(mut at) 0]
      (loop (if (>= (load at) n)
                (break)
                (do
                  (set! (.earliest (be-inst (load at))) -1)
                  (set! (.latest (be-inst (load at))) -1)
                  (set! at (+ (load at) 1))))))
    ; A few forward fixed-point rounds also cover definitions emitted out of textual order.
    ; The round bound is a backstop; the fixed point converges within a handful of rounds, and a
    ; round that changes nothing proves every later round would change nothing too. Without this
    ; break the pass ran be-inst-count full rounds — hours on DeltaBlue-sized programs.
    (loop (if (or (>= (load round) (+ n 1)) (or (not (load ok)) (not (load changed))))
              (break)
              (do
                (set! changed false)
                (let [(mut at) 0]
                  (loop (if (or (>= (load at) n) (not (load ok)))
                            (break)
                            (do
                              (let [m (be-inst (load at))
                                    owner (.owner m)
                                    op (.op m)
                                    bid (.block-id m)]
                                (if (mi-op-pinned? op)
                                    (if (!= (.earliest m) bid)
                                        (set! (.earliest m) bid)
                                        0)
                                    (let [(mut bound) (ms-entry-block owner)
                                          inputs (mi-op-inputs op)]
                                      (if (> inputs 0)
                                          (set! bound
                                                (ms-gcm-input-bound owner
                                                                    (load bound)
                                                                    (.a m)))
                                          0)
                                      (if (and (>= (load bound) 0) (> inputs 1))
                                          (set! bound
                                                (ms-gcm-input-bound owner
                                                                    (load bound)
                                                                    (.b m)))
                                          0)
                                      (if (and (>= (load bound) 0) (= (.op m) MI-CSEL))
                                          (set! bound
                                                (ms-gcm-input-bound owner
                                                                    (load bound)
                                                                    (.imm m)))
                                          0)
                                      (if (and (>= (load bound) 0) (> (ms-inst-arg-count (load at)) 0))
                                          (let [(mut arg) 0]
                                            (loop (if (or (>= (load arg) (ms-inst-arg-count (load at)))
                                                          (< (load bound) 0))
                                                      (break)
                                                      (do
                                                        (set! bound
                                                              (ms-gcm-input-bound owner
                                                                                  (load bound)
                                                                                  (ms-inst-arg (load at) (load arg))))
                                                        (set! arg (+ (load arg) 1))
                                                        0))))
                                          0)
                                      (set! bound (ms-gcm-anchor-bound owner (load at) (load bound)))
                                      ; A definition may have been emitted later than this use. Leave
                                      ; the use unresolved for this round; the forward fixed point will
                                      ; revisit it after the definition acquires an earliest block.
                                      (if (>= (load bound) 0)
                                          (if (!= (.earliest m) (load bound))
                                              (set! (.earliest m) (load bound))
                                              0)
                                          ;; A use emitted before its definition is the only reason
                                          ;; another def-first round is needed. Ordinary ordered
                                          ;; graphs finish in one pass, as Simple's schedEarly does.
                                          (set! changed true)))))
                              (set! at (+ (load at) 1))
                              0))))
                (set! round (+ (load round) 1))
                0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) n) (not (load ok)))
                    (break)
                    (do
                      (if (< (.earliest (be-inst (load at))) 0)
                          (do
                            (if (be-profiling?)
                                (let [m (be-inst (load at))]
                                  (do
                                    (fmt (stderr)
                                         "AOTK_PROFILE phase=selection_unresolved_earliest at={d} op={d} node={d} owner={d} block={d} a={d} b={d} argc={d}\n"
                                         (load at) (.op m) (.node m) (.owner m) (.block-id m)
                                         (.a m) (.b m) (ms-inst-arg-count (load at)))
                                    0))
                                0)
                            (ms-fail! MSEL-DEPENDENCY (load at))
                            (set! ok false))
                          0)
                      (set! at (+ (load at) 1))))))
        0)
    (if (be-profiling?)
        (do (fmt (stderr) "AOTK_PROFILE phase=selection_gcm_early ns={d} rounds={d}\n"
                 (- (ms-profile-now) started) (load round))
            0)
        0)
    (load ok)))

;; Sits in the scheduler's instruction-pair loops: one be-inst, direct field reads, and the raw
;; input-count table, instead of a descriptor copy and an accessor chain per argument.
(defn ms-inst-uses-vreg? [(at i64) (vreg i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)]
    (if (and (> inputs 0) (= (.a m) vreg))
        true
        (if (and (> inputs 1) (= (.b m) vreg))
            true
            (if (and (= op MI-CSEL) (= (.imm m) vreg))
                true
                (let [args (.arg-count m)]
                  (if (<= args 0)
                      false
                      (let [call-args (.call-args (machine-unit))
                            base (.arg-first m)
                            (mut k) 0
                            (mut used) false]
                        (loop (if (or (>= (load k) args) (load used))
                                  (break)
                                  (do
                                    (if (= (al-get call-args (+ base (load k))) vreg)
                                        (set! used true)
                                        0)
                                    (set! k (+ (load k) 1))
                                    0)))
                        (load used)))))))))

(defn ms-gcm-lca [(left i64) (right i64)] (-> i64)
  (if (< left 0) right (if (< right 0) left (mu-idom-intersect left right))))

(defn ms-gcm-note-use! [(vreg i64) (entry i64)] (-> i64)
  (let [u (machine-unit)]
    (if (and (>= vreg 0) (< vreg (al-len [i64] (.vreg-use-head u))))
        (do
          (al-push! [i64] (field u vreg-use-entry) entry)
          (al-push! [i64] (field u vreg-use-next)
                    (al-get [i64] (.vreg-use-head u) vreg))
          (al-set! [i64] (field u vreg-use-head) vreg
                   (- (al-len [i64] (.vreg-use-entry u)) 1))
          0)
        0)))

;; Rebuild the per-vreg use lists. Called at the start of each pass that queries
;; ms-gcm-latest-use-block (placement and verification), so the lists always describe the
;; instructions and edge copies as that pass sees them; block assignments read at query time.
(defn ms-gcm-build-use-lists! [] (-> i64)
  (let [u (machine-unit)
        started (ms-profile-now)
        vregs (.next-vreg u)
        (mut i) 0]
    (al-clear! [i64] (field u vreg-use-head))
    (al-clear! [i64] (field u vreg-use-entry))
    (al-clear! [i64] (field u vreg-use-next))
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u vreg-use-head) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))
                      inputs (mi-desc-inputs (mi-desc (.op m)))]
                  (if (> inputs 0) (ms-gcm-note-use! (.a m) (load i)) 0)
                  (if (> inputs 1) (ms-gcm-note-use! (.b m) (load i)) 0)
                  (if (= (.op m) MI-CSEL)
                      (ms-gcm-note-use! (.imm m) (load i))
                      0)
                  (let [args (ms-inst-arg-count (load i))
                        (mut k) 0]
                    (loop (if (>= (load k) args)
                              (break)
                              (do
                                (ms-gcm-note-use! (ms-inst-arg (load i) (load k)) (load i))
                                (set! k (+ (load k) 1))
                                0)))))
                (set! i (+ (load i) 1))
                0)))
    (let [(mut e) 0]
      (loop (if (>= (load e) (mu-edge-count))
                (break)
                (do
                  (let [(mut k) 0]
                    (loop (if (>= (load k) (mu-edge-copy-count (load e)))
                              (break)
                              (do
                                (if (= (mu-copy-kind (load e) (load k)) MCOPY-VALUE)
                                    (ms-gcm-note-use! (mu-copy-src (load e) (load k))
                                                      (- 0 (+ (mu-edge-source (load e)) 2)))
                                    0)
                                (set! k (+ (load k) 1))
                                0))))
                  (set! e (+ (load e) 1))
                  0))))
    (if (be-profiling?)
        (do (fmt (stderr) "AOTK_PROFILE phase=selection_gcm_uses ns={d} entries={d}\n"
                 (- (ms-profile-now) started) (al-len [i64] (.vreg-use-entry u)))
            0)
        0)
    0))

(defn ms-gcm-latest-use-block [(owner i64) (vreg i64)] (-> i64)
  (let [u (machine-unit)
        (mut latest) -1
        (mut e) (if (and (>= vreg 0) (< vreg (al-len [i64] (.vreg-use-head u))))
                    (al-get [i64] (.vreg-use-head u) vreg)
                    -1)]
    (loop (if (< (load e) 0)
              (break)
              (do
                (let [entry (al-get [i64] (.vreg-use-entry u) (load e))]
                  (if (>= entry 0)
                      (if (= (ms-inst-owner entry) owner)
                          (set! latest (ms-gcm-lca (load latest) (ms-inst-block entry)))
                          0)
                      ; A Phi source is used on its incoming edge, hence in the predecessor block.
                      (let [block (- (- 0 entry) 2)]
                        (if (= (mu-block-owner block) owner)
                            (set! latest (ms-gcm-lca (load latest) block))
                            0))))
                (set! e (al-get [i64] (.vreg-use-next u) (load e)))
                0)))
    (load latest)))

;; A reverse late-scheduling pass sees ordinary producer-before-consumer instruction order in the
;; useful direction: the consumer moves first and its producer has not yet been visited. Only an
;; out-of-order definition after this use can invalidate work already completed in this pass.
(defn ms-gcm-vreg-def-after? [(owner i64) (vreg i64) (at i64)] (-> bool)
  (if (or (< vreg 0) (ms-phi-vreg? owner vreg))
      false
      (> (ms-owner-def-inst owner vreg) at)))

(defn ms-gcm-move-needs-repeat? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (.owner m)
        inputs (mi-op-inputs (.op m))
        (mut repeat) false]
    (if (and (> inputs 0) (ms-gcm-vreg-def-after? owner (.a m) at))
        (set! repeat true)
        0)
    (if (and (not (load repeat))
             (and (> inputs 1) (ms-gcm-vreg-def-after? owner (.b m) at)))
        (set! repeat true)
        0)
    (if (and (not (load repeat))
             (and (= (.op m) MI-CSEL)
                  (ms-gcm-vreg-def-after? owner (.imm m) at)))
        (set! repeat true)
        0)
    (if (not (load repeat))
        (let [(mut arg) 0]
          (loop (if (or (load repeat) (>= (load arg) (ms-inst-arg-count at)))
                    (break)
                    (do
                      (if (ms-gcm-vreg-def-after? owner (ms-inst-arg at (load arg)) at)
                          (set! repeat true)
                          0)
                      (set! arg (+ (load arg) 1))))))
        0)
    (load repeat)))

;; Validate EARLIEST -> LATEST dominance and choose the lowest-loop-depth block in one idom walk.
;; Returning -1 preserves the old dependency failure without paying for a separate dominates walk.
(defn ms-gcm-best-late-block [(earliest i64) (latest i64)] (-> i64)
  (let [(mut choice) latest
        (mut cursor) latest
        (mut valid) true]
    (loop (if (or (= (load cursor) earliest) (not (load valid)))
              (break)
              (let [next (mu-block-idom (load cursor))]
                (if (= next (load cursor))
                    (set! valid false)
                    (do
                      (set! cursor next)
                      (if (< (mu-block-loop-depth next)
                             (mu-block-loop-depth (load choice)))
                          (set! choice next)
                          0))))))
    (if (load valid) (load choice) -1)))

(defn ms-gcm-place! [] (-> bool)
  (ms-gcm-build-use-lists!)
  (if (not (ms-gcm-compute-earliest!))
      false
      (let [(mut round) 0
            (mut moved) true
            (mut at) 0
            (mut ok) true
            late-start (ms-profile-now)]
      ;; ONE BACKWARD PASS IS NOT A FIXPOINT. Placement walks instructions from last to first, so a
      ;; value's uses are normally settled before the value itself -- but not always: the deferred
      ;; phi boxes `fng-distribute-deferred-phi-boxes!` creates are NEW instructions consumed by
      ;; OLD ones, so a use sits at a lower index and moves after the def has already read its
      ;; block. `for (const x of xs)` with two `continue`s produced exactly that, and
      ;; `ms-gcm-placement-valid?` -- which recomputes the latest use -- then refused the program
      ;; with MSEL-PLACEMENT: latest 6 at placement, 4 at verification.
      ;;
      ;; Repeating until nothing moves is what makes the two agree. The bound is a backstop, not an
      ;; expectation: each round can only move an instruction toward a shallower loop depth or a
      ;; block its inputs still dominate, and in practice the second round is already quiet.
      (loop (if (or (not (load moved)) (or (not (load ok)) (>= (load round) 8)))
                (break)
                (do
                  (set! moved false)
                  (set! round (+ (load round) 1))
                  (set! at (be-inst-count))
        (loop (if (or (<= (load at) 0) (not (load ok)))
                  (break)
                  (do
                    (set! at (- (load at) 1))
                    (let [m (be-inst (load at))
                          op (.op m)
                          owner (.owner m)
                          anchor (ms-inst-anchor-block owner (load at))
                          fixed (or (mi-op-pinned? op) (>= anchor 0))
                          original (if (>= anchor 0) anchor (.block-id m))
                          ;; Early scheduling is already at a fixed point. Simple likewise finishes
                          ;; schedEarly once, then performs late scheduling solely from use
                          ;; placement. Recomputing the same input bound in every late round was a
                          ;; redundant full instruction pass hidden inside this loop.
                          refreshed true
                          earliest (.earliest m)]
                      (if (not refreshed)
                          (do (ms-fail! MSEL-DEPENDENCY (load at)) (set! ok false))
                          (if fixed
                          (do (set! (.block-id m) original)
                              (set! (.earliest m) original)
                              (set! (.latest m) original)
                              0)
                          (let [use-block
                                  (if (>= (.dst m) 0)
                                      (ms-gcm-latest-use-block owner (.dst m))
                                      -1)
                                latest (if (< use-block 0) earliest use-block)]
                            (set! (.latest m) latest)
                            (let [choice (ms-gcm-best-late-block earliest latest)]
                              (if (< choice 0)
                                  (do (ms-fail! MSEL-DEPENDENCY (load at)) (set! ok false))
                                  (do
                                  (if (and (!= (.block-id m) choice)
                                           (ms-gcm-move-needs-repeat? (load at)))
                                      (set! moved true)
                                      0)
                                  (set! (.block-id m) choice))))))))
                    0)))
                  0)))
        (if (load ok)
            (let [pack-start (ms-profile-now)]
              (if (be-profiling?)
                  (do (fmt (stderr) "AOTK_PROFILE phase=selection_gcm_late ns={d} rounds={d}\n"
                           (- pack-start late-start) (load round))
                      0)
                  0)
              (ms-pack-instructions!)
              (if (be-profiling?)
                  (do (fmt (stderr) "AOTK_PROFILE phase=selection_gcm_pack ns={d}\n"
                           (- (ms-profile-now) pack-start))
                      0)
                  0)
              true)
            false))))

(defn ms-cache-new-defs! [] (-> i64)
  (let [u (machine-unit) (mut vreg) 0 (mut at) 0]
    (al-clear! [i64] (field u vreg-new-def))
    (loop (if (>= (load vreg) (.next-vreg u))
              (break)
              (do
                (al-push! [i64] (field u vreg-new-def) -1)
                (set! vreg (+ (load vreg) 1)))))
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (let [m (be-inst (load at)) dst (.dst m)]
                (if (and (>= dst 0) (= (.op m) MI-NEW))
                    (al-set! [i64] (field u vreg-new-def) dst (load at))
                    0)
                (set! at (+ (load at) 1)))))
    0))

(defn ms-memory-operands-may-alias? [(left (ptr MInst)) (right (ptr MInst))] (-> bool)
  (let [defs (.vreg-new-def (machine-unit))
        a (.a left)
        b (.a right)]
    (if (= a b)
        true
        ;; Separate native allocations cannot alias. The cached definition classification keeps
        ;; this hot memory-pair query constant-time while every other value remains conservative.
        (not (and (>= a 0)
                  (and (< a (al-len [i64] defs))
                       (and (>= b 0)
                            (and (< b (al-len [i64] defs))
                                 (and (>= (al-get [i64] defs a) 0)
                                      (>= (al-get [i64] defs b) 0))))))))))

(defn ms-machine-memory-read? [(m (ptr MInst))] (-> bool)
  (or (= (.op m) MI-LOAD)
      (or (and (= (.op m) MI-JSPROP)
               (or (= (.imm m) 0)
                   (or (= (.imm m) 3)
                       (or (= (.imm m) 5)
                           (or (= (.imm m) 6) (= (.imm m) 7))))))
          (and (= (.op m) MI-JSARRAY)
               (or (= (.imm m) 1) (= (.imm m) 3))))))

(defn ms-machine-memory-write? [(m (ptr MInst))] (-> bool)
  (or (= (.op m) MI-STORE)
      (or (and (= (.op m) MI-JSPROP)
               (or (= (.imm m) 1)
                   (or (= (.imm m) 2)
                       (or (= (.imm m) 4) (= (.imm m) 8)))))
          (and (= (.op m) MI-JSARRAY)
               (or (= (.imm m) 2)
                   (or (= (.imm m) 4) (= (.imm m) 5)))))))

;; A memory Phi can expose the same read through more than one dependency arm. Anti-dependencies
;; are a set of required reads, not a path-counted multiset; duplicate nodes make the independent
;; verifier observe one machine read but a larger declared count.
(defn ms-add-memory-anti-dep! [(m (ptr MInst)) (first i64) (node i64)] (-> i64)
  (let [u (machine-unit)
        (mut at) first
        (mut found) false]
    (loop (if (or (load found) (>= (load at) (al-len [i64] (.memory-anti-deps u))))
              (break)
              (do
                (if (= (al-get [i64] (.memory-anti-deps u) (load at)) node)
                    (set! found true)
                    0)
                (set! at (+ (load at) 1)))))
    (if (load found)
        0
        (do
          (al-push! [i64] (field u memory-anti-deps) node)
          (set! (.anti-count m) (+ (.anti-count m) 1))
          0))))

(defn ms-build-memory-anti-deps! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        (mut at) 0]
    (al-clear! [i64] (field u memory-anti-deps))
    (al-clear! [i64] (field u memory-read-head))
    (al-clear! [i64] (field u memory-read-next))
    ;; Heads are keyed by IDEAL MEMORY DEFINITION, matching Simple's `load.mem().outs()` walk.
    (loop (if (>= (load at) (n-count))
              (break)
              (do (al-push! [i64] (field u memory-read-head) -1)
                  (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) n)
              (break)
              (do
                (al-push! [i64] (field u memory-read-next) -1)
                (let [m (be-inst (load at))]
                  (if (and (ms-machine-memory-read? m)
                           (and (>= (.node m) 0) (> (n-nins (.node m)) 1)))
                      (let [memory (n-in (.node m) 1)]
                        (if (and (>= memory 0) (< memory (al-len [i64] (.memory-read-head u))))
                          (do
                        (al-set! [i64] (field u memory-read-next) (load at)
                                     (al-get (.memory-read-head u) memory))
                            (al-set! [i64] (field u memory-read-head) memory (load at)))
                          0))
                      0))
                (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      first (al-len [i64] (.memory-anti-deps u))]
                  (set! (.anti-first m) first)
                  (set! (.anti-count m) 0)
                  (if (ms-machine-memory-write? m)
                      (do
                        (let [(mut dep) 0]
                        (loop (if (>= (load dep) (.mem-count m))
                                  (break)
                                  (do
                                    (let [memory (al-get [i64]
                                                         (.selection-memory-deps u)
                                                         (+ (.mem-first m) (load dep)))
                                          (mut prior)
                                            (if (and (>= memory 0)
                                                     (< memory (al-len [i64] (.memory-read-head u))))
                                                (al-get (.memory-read-head u) memory)
                                                -1)]
                                      (loop (if (< (load prior) 0)
                                                (break)
                                                (do
                                                  (let [candidate (be-inst (load prior))]
                                                    (if (and (= (.owner candidate) (.owner m))
                                                             (and (ms-memory-operands-may-alias?
                                                                    candidate m)
                                                                  (and (< (.node candidate) (.node m))
                                                                       (mu-dominates?
                                                                         (.block-id candidate)
                                                                         (.block-id m)))))
                                                        (ms-add-memory-anti-dep!
                                                          m first (.node candidate))
                                                        0))
                                                  (set! prior
                                                        (al-get (.memory-read-next u) (load prior)))))))
                                    (set! dep (+ (load dep) 1))))))
                        ;; Exact ideal-memory users are only a fast seed. A read can precede this
                        ;; write through a different arm of a memory Phi and still dominate it;
                        ;; that is a real read-before-write ordering constraint. Complete the set
                        ;; from this owner's machine reads using the same semantic predicate the
                        ;; independent verifier applies.
                        (let [(mut candidate-at) 0]
                          (loop (if (>= (load candidate-at) n)
                                    (break)
                                    (let [candidate (be-inst (load candidate-at))]
                                      (if (and (= (.owner candidate) (.owner m))
                                               (and (ms-machine-memory-read? candidate)
                                                    (and (ms-memory-operands-may-alias? candidate m)
                                                         (and (< (.node candidate) (.node m))
                                                              (mu-dominates? (.block-id candidate)
                                                                             (.block-id m))))))
                                          (ms-add-memory-anti-dep! m first (.node candidate))
                                          0)
                                      (set! candidate-at (+ (load candidate-at) 1)))))
                        ))
                      0))
                (set! at (+ (load at) 1))
                0)))
    0))

(defn ms-find-node-inst-after [(owner i64) (node i64) (after i64)] (-> i64)
  (let [u (machine-unit)
        nodes (n-count)
        key (+ (* owner nodes) node)
        (mut at) (if (or (< owner 0) (or (< node 0)
                                          (>= key (al-len [i64] (.node-inst-head u)))))
                     -1
                     (al-get [i64] (.node-inst-head u) key))
        (mut found) -1]
    ;; The cached list is newest instruction first. Stop as soon as
    ;; it reaches `after`; the last greater entry was the nearest producer.
    (loop (if (< (load at) 0)
              (break)
              (do
                (if (<= (load at) after)
                    (set! at -1)
                    (do
                      (set! found (load at))
                      (set! at (al-get [i64] (.node-inst-next u) (load at)))
                      0)))))
    (load found)))

;; GCM preserves provisional instruction order within each destination block. Demand-driven
;; selection can nevertheless emit a consumer before an already-ordered memory predecessor. Move
;; that predecessor ahead of the consumer before the ordinary scalar/data scheduler runs.
(defn ms-repair-late-memory-deps! [] (-> bool)
  (let [started (ms-profile-now)
        limit (* (be-inst-count) (be-inst-count))
        (mut moves) 0
        (mut changed) true
        (mut ok) true]
    (loop (if (or (not (load changed)) (not (load ok)))
              (break)
              (do
                (set! changed false)
                (let [(mut consumer) 0]
                  (loop (if (or (>= (load consumer) (be-inst-count)) (load changed))
                            (break)
                            (let [m (be-inst (load consumer))
                                  owner (.owner m)
                                  count (.mem-count m)
                                  (mut dep) 0]
                              (loop (if (or (>= (load dep) count) (load changed))
                                        (break)
                                        (let [memory-node
                                                (al-get
                                                  (.selection-memory-deps (machine-unit))
                                                  (+ (.mem-first m) (load dep)))
                                              producer
                                                (ms-find-node-inst-after
                                                  owner memory-node (load consumer))]
                                          (if (and (>= producer 0)
                                                   (= (ms-inst-block producer)
                                                      (ms-inst-block (load consumer))))
                                              (let [saved (load (be-inst producer))
                                                    (mut at) producer]
                                                (loop (if (<= (load at) (load consumer))
                                                          (break)
                                                          (do
                                                            (set! (be-inst (load at)) (load (be-inst (- (load at) 1))))
                                                            (set! at (- (load at) 1)))))
                                                (set! (be-inst (load consumer)) saved)
                                                ;; The move changes physical instruction indices.
                                                ;; Rebuild the direct node index before the next
                                                ;; dependency query instead of falling back to a
                                                ;; whole-unit scan for every consumer/dependency.
                                                (ms-cache-def-insts!)
                                                (set! moves (+ (load moves) 1))
                                                (set! changed true)
                                                (if (> (load moves) limit) (set! ok false) 0))
                                              0)
                                          (set! dep (+ (load dep) 1)))))
                              (set! consumer (+ (load consumer) 1)))))))))
    (if (be-profiling?)
        (do (fmt (stderr) "AOTK_PROFILE phase=selection_memory_repair ns={d} moves={d}\n"
                 (- (ms-profile-now) started) (load moves))
            0)
        0)
    (load ok)))

(defn ms-select-built-core! [] (-> bool)
  (be-reset!)
  (let [u (machine-unit)
        funcs (mu-function-count)
        (mut owner) 0
        (mut profile-start) (ms-profile-now)
        (mut part-start) (ms-profile-now)
        (mut preselect-ns) 0
        (mut copies-ns) 0
        (mut terminators-ns) 0]
    (set! (.selection-result u) MSEL-OK)
    (set! (.selection-item u) -1)
    (set! (.next-vreg u) 0)
    (al-clear! [i64] (field u vreg-phi-block))
    (al-clear! [i64] (field u vreg-node))
    (al-clear! [i64] (field u vreg-node-owner))
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u call-args))
    (ms-map-init!)
    (ms-cache-block-phis!)
    (ms-build-preselect-candidates!)
    (if (be-profiling?)
        (do (fmt (stderr) "AOTK_PROFILE phase=selection_emit_setup ns={d} ingress={d} effects={d}\n"
                 (- (ms-profile-now) (load part-start))
                 (al-len [i64] (.selection-ingress-candidates u))
                 (al-len [i64] (.selection-effect-candidates u)))
            0)
        0)
    (set! owner 0)
    (loop (if (or (>= (load owner) funcs) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [base (be-inst-count)
                      (mut started) (ms-profile-now)]
                  ;; The selection memo is node-dense and owner-tagged because owners are selected
                  ;; sequentially. Preallocating every owner's Phis up front violated that contract:
                  ;; selecting an earlier owner could overwrite a later owner's reservation, and a
                  ;; later If then found no vreg for its Phi predicate. Reserve only the owner whose
                  ;; complete selection is about to run; its tags remain live through edge copies.
                  (ms-preallocate-phis! (load owner))
                  ; Establish control-rooted placement before edge copies request shared Phi
                  ; inputs. Otherwise a loop-header value first seen through its backedge copy can
                  ; be pinned to the backedge even when the branch condition consumes it in-header.
                  (ms-preselect-function! (load owner))
                  (set! preselect-ns (+ (load preselect-ns)
                                        (- (ms-profile-now) (load started))))
                  (set! started (ms-profile-now))
                  (ms-build-edge-copies! (load owner))
                  (set! copies-ns (+ (load copies-ns)
                                     (- (ms-profile-now) (load started))))
                  (set! started (ms-profile-now))
                  (ms-emit-function! (load owner) base)
                  (set! terminators-ns (+ (load terminators-ns)
                                          (- (ms-profile-now) (load started)))))
                (set! owner (+ (load owner) 1))
                0)))
    (if (be-profiling?)
        (do
          (fmt (stderr) "AOTK_PROFILE phase=selection_emit_preselect ns={d}\n" (load preselect-ns))
          (fmt (stderr) "AOTK_PROFILE phase=selection_emit_copies ns={d}\n" (load copies-ns))
          (fmt (stderr) "AOTK_PROFILE phase=selection_emit_terminators ns={d}\n" (load terminators-ns))
          0)
        0)
    (set! profile-start (ms-profile-note! "selection_emit" (load profile-start)))
    (if (= (ms-result) MSEL-OK)
        (do
          ;; Keep demand-selected instructions in graph order through GCM. Their block-id fields
          ;; and dense def/use indexes are sufficient for placement; packing here only copied and
          ;; indexed the whole unit a first time before GCM changed those blocks. Simple likewise
          ;; materializes block order after global scheduling, once.
          (ms-cache-new-defs!)
          true)
        false)))

;; THE ANTI-DEPENDENCY VECTOR HAS TO DESCRIBE THE SCHEDULE THAT EXISTS. It is built at the end of
;; selection, and its membership rule is "every aliasing read whose block DOMINATES this write's
;; block" — a rule stated in terms of block ids that global code motion is about to change. A read
;; GCM hoists into a dominating block is then required by the verifier and absent from the vector
;; the builder produced, and the block is refused with `MSEL-MEMORY-ORDER`. `ArrayShift`, whose
;; resize follows a loop that reads the same array, could not be compiled at all.
;;
;; Rebuilding rather than relaxing the rule: the vector is DERIVED, not a second source of truth, so
;; recomputing it against the final placement is what makes the verifier's question well posed. The
;; same mistake, in the same shape, is recorded for `schedule-order` in docs/JSL.md.
(defn ms-place-selected! [] (-> bool)
  (let [u (machine-unit)
        (mut profile-start) (ms-profile-now)]
    (if (ms-gcm-place!)
        (do
          (set! profile-start (ms-profile-note! "selection_gcm" (load profile-start)))
          (ms-build-memory-anti-deps!)
          (set! profile-start (ms-profile-note! "selection_antideps_final" (load profile-start)))
          (set! (.phase u) 2)
          ; Usually GCM's stable packing is already dependency-topological, and retaining
          ; it keeps selection dumps stable. If a cross-block move put a producer after its use,
          ; repair only that case with the dependency-aware seed-0 scheduler.
          (let [verify-start (ms-profile-now)
                verified (if (be-verification?) (ms-verify!) true)]
            (ms-profile-note! "selection_verify" verify-start)
            (if verified
                true
                (if (= (ms-result) MSEL-DEPENDENCY)
                    (let [repair-start (ms-profile-now)
                          repaired (ms-repair-late-memory-deps!)]
                      (ms-profile-note! "selection_repair" repair-start)
                      (if repaired
                          (let [schedule-start (ms-profile-now)
                                scheduled (ms-local-schedule! 0)]
                            (ms-profile-note! "selection_repair_schedule" schedule-start)
                            (if scheduled
                                (let [reverify-start (ms-profile-now)
                                      reverified (ms-verify!)]
                                  (ms-profile-note! "selection_reverify" reverify-start)
                                  reverified)
                                false))
                          false))
                    false))))
        false)))

(defn ms-select-built! [] (-> bool)
  (if (ms-select-built-core!) (ms-place-selected!) false))

(defn ms-select! [] (-> bool)
  (if (mu-build!) (ms-select-built!) false))
(defn ms-select-program! [] (-> bool)
  (let [started (ms-profile-now)]
    (if (mu-build-program!)
        (do (ms-profile-note! "selection_machine_build" started)
            (ms-select-built!))
        false)))

(defn ms-select-verified-program! [] (-> bool)
  (let [started (ms-profile-now)]
    (if (mu-build-verified-program!)
        (do (ms-profile-note! "selection_machine_build" started)
            (ms-select-built!))
        false)))
; Convert verified block terminators to the legacy encodable label/branch vocabulary.  This is a
; separate publication step so the block verifier continues to reason about explicit successors.
(defn ms-lowered-inst [(owner i64)
                       (bid i64)
                       (op i64)
                       (dst i64)
                       (a i64)
                       (b i64)
                       (imm i64)
                       (node i64)] (-> MInst)
  (let [p (primitive/alloc-stack MInst)]
    (set! p (mi-new op dst a b imm node))
    (set! (.owner p) owner)
    (set! (.block-id p) bid)
    (load p)))

(defn ms-lower-encodable! [] (-> bool)
  (if (and (be-verification?) (not (ms-verify!)))
      false
      (let [u (machine-unit)
            blocks (mu-block-count)
            (mut bid) 0]
        (al-clear! [MInst] (field u packed-insts))
        (loop (if (>= (load bid) blocks)
                  (break)
                  (do
                    (let [b (mu-block (load bid))
                          owner (.owner b)
                          first (.inst-first b)
                          count (.inst-count b)
                          scheduled-first (al-len [MInst] (.packed-insts u))
                          (mut i) 0]
                      (set! (.inst-first b) scheduled-first)
                      (al-push! [MInst]
                                (field u packed-insts)
                                (ms-lowered-inst owner (load bid) MI-LABEL -1 -1 -1 (load bid) NO-NODE))
                      (loop (if (>= (load i) count)
                                (break)
                                (do
                                  (let [m (be-inst (+ first (load i)))
                                        op (.op m)]
                                    (case op MI-CBR
                                          (do
                                            (al-push! [MInst]
                                                      (field u packed-insts)
                                                      (ms-lowered-inst owner
                                                                       (load bid)
                                                                       MI-CBZ
                                                                       -1
                                                                       (load (field m a))
                                                                       -1
                                                                       (load (field m imm))
                                                                       (load (field m node))))
                                            (al-push! [MInst]
                                                      (field u packed-insts)
                                                      (ms-lowered-inst owner
                                                                       (load bid)
                                                                       MI-B
                                                                       -1
                                                                       -1
                                                                       -1
                                                                       (load (field m b))
                                                                       (load (field m node))))
                                            0)
                                            MI-JMP
                                          (al-push! [MInst]
                                                    (field u packed-insts)
                                                    (ms-lowered-inst owner
                                                                     (load bid)
                                                                     MI-B
                                                                     -1
                                                                     -1
                                                                     -1
                                                                     (load (field m imm))
                                                                     (load (field m node))))
                                            (al-push! [MInst] (field u packed-insts) (load m))))
                                  (set! i (+ (load i) 1))
                                  0)))
                      (set! (.inst-count b) (- (al-len [MInst] (.packed-insts u)) scheduled-first)))
                    (set! bid (+ (load bid) 1))
                    0)))
        (al-clear! [MInst] (field (backend) ins))
        (let [n (al-len [MInst] (.packed-insts u))
              (mut i) 0
              (mut ok) true]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [m (al-get (.packed-insts u) (load i))
                            p (primitive/alloc-stack MInst)]
                        (set! p m)
                        (if (not (mi-desc-encodable? (mi-desc (.op p))))
                            (set! ok false)
                            0)
                        (al-push! [MInst] (field (backend) ins) m))
                      (set! i (+ (load i) 1))
                      0)))
          (ms-cache-def-insts!)
          (load ok)))))

(defn be-select-machine-program-core! [(verified bool)] (-> bool)
  (if (not (if verified (ms-select-verified-program!) (ms-select-program!)))
      (let [code
              (case (ms-result) MSEL-CALL-LIVE
                    BER-UNSUPPORTED-CALL-LIVE MSEL-CALL
                    BER-UNSUPPORTED-CALL MSEL-UNSUPPORTED
                    BER-UNSUPPORTED-OPCODE BER-MALFORMED-GRAPH)
            item (ms-result-item)
            node
              (if (and (ms-result-item-is-machine?)
                       (and (>= item 0) (< item (be-inst-count))))
                  (ms-inst-node item)
                  item)]
        (be-fail! code node))
      (if (ms-lower-encodable!) true (be-fail! BER-ENCODING NO-NODE))))

(defn be-select-machine-program! [] (-> bool)
  (be-select-machine-program-core! false))

(defn be-select-verified-machine-program! [] (-> bool)
  (be-select-machine-program-core! true))

(defn ms-inst-owner [(i i64)] (-> i64)
  (.owner (be-inst i)))
(defn ms-inst-block [(i i64)] (-> i64)
  (.block-id (be-inst i)))
(defn ms-inst-op [(i i64)] (-> i64)
  (.op (be-inst i)))
(defn ms-inst-dst [(i i64)] (-> i64)
  (.dst (be-inst i)))
(defn ms-inst-a [(i i64)] (-> i64)
  (.a (be-inst i)))
(defn ms-inst-imm [(i i64)] (-> i64)
  (.imm (be-inst i)))
(defn ms-inst-earliest [(i i64)] (-> i64)
  (.earliest (be-inst i)))
(defn ms-inst-latest [(i i64)] (-> i64)
  (.latest (be-inst i)))
(defn ms-inst-node [(i i64)] (-> i64)
  (.node (be-inst i)))
(defn ms-inst-memory-dep-count [(i i64)] (-> i64)
  (.mem-count (be-inst i)))
(defn ms-inst-memory-dep-node [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (.selection-memory-deps (machine-unit))
            (+ (.mem-first m) which))))
(defn ms-inst-memory-anti-count [(i i64)] (-> i64)
  (.anti-count (be-inst i)))
(defn ms-inst-memory-anti-node [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (.memory-anti-deps (machine-unit))
            (+ (.anti-first m) which))))
(defn ms-inst-arg-count [(i i64)] (-> i64)
  (.arg-count (be-inst i)))
(defn ms-inst-arg [(i i64) (which i64)] (-> i64)
  (let [m (be-inst i)]
    (al-get (.call-args (machine-unit))
            (+ (.arg-first m) which))))

(defn ms-def-inst [(vreg i64)] (-> i64)
  (let [defs (.vreg-def-inst (machine-unit))]
    (if (and (>= vreg 0) (< vreg (al-len [i64] defs)))
        (let [cached (al-get [i64] defs vreg)]
          (if (>= cached 0)
              cached
              (let [n (be-inst-count) (mut i) 0 (mut found) -1]
                (loop (if (or (>= (load i) n) (>= (load found) 0)) (break)
                          (do
                            (if (= (.dst (be-inst (load i))) vreg)
                                (set! found (load i)) 0)
                            (set! i (+ (load i) 1)))))
                (load found))))
        (let [n (be-inst-count) (mut i) 0 (mut found) -1]
          (loop (if (or (>= (load i) n) (>= (load found) 0)) (break)
                    (do
                      (if (= (.dst (be-inst (load i))) vreg)
                          (set! found (load i)) 0)
                      (set! i (+ (load i) 1)))))
          (load found)))))

(defn ms-phi-vreg? [(owner i64) (vreg i64)] (-> bool)
  (>= (ms-phi-vreg-block owner vreg) 0))

(defn ms-block-dominates? [(def-bid i64) (use-bid i64)] (-> bool)
  (mu-dominates? def-bid use-bid))

(defn ms-input-valid? [(at i64) (vreg i64)] (-> bool)
  (if (< vreg 0)
      true
      (if (ms-phi-vreg? (.owner (be-inst at)) vreg)
          true
          (let [def (ms-owner-def-inst (.owner (be-inst at)) vreg)]
            (if (< def 0)
                (ms-phi-vreg? (.owner (be-inst at)) vreg)
                (if (>= def at)
                    false
                    (let [use (be-inst at)
                          producer (be-inst def)
                          owner (.owner use)
                          bid (.block-id use)
                          def-owner (.owner producer)
                          def-bid (.block-id producer)]
                      (and (= owner def-owner)
                           (or (= def-bid (ms-entry-block owner))
                               (or (= def-bid bid) (ms-block-dominates? def-bid bid)))))))))))

(defn ms-verifier-node-inst-head [(owner i64) (node i64)] (-> i64)
  (let [u (machine-unit)
        nodes (n-count)
        key (+ (* owner nodes) node)]
    (if (or (< owner 0)
            (or (>= owner (mu-function-count))
                (or (< node 0)
                    (or (>= node nodes)
                        (>= key (al-len [i64] (.verify-node-inst-head u)))))))
        -1
        (al-get [i64] (.verify-node-inst-head u) key))))

(defn ms-node-inst-before [(owner i64) (node i64) (before i64)] (-> i64)
  (let [u (machine-unit)
        (mut i) (ms-verifier-node-inst-head owner node)
        (mut found) -1]
    ;; Verifier lists are newest instruction first, so the first entry below `before` is the
    ;; nearest producer. The previous verifier rescanned the whole machine prefix per query.
    (loop (if (or (< (load i) 0) (>= (load found) 0))
              (break)
              (do
                (if (< (load i) before) (set! found (load i)) 0)
                (set! i (al-get [i64] (.verify-node-inst-next u) (load i)))
                0)))
    (load found)))

(defn ms-memory-node-before? [(owner i64) (node i64) (at i64)] (-> bool)
  (match (n-op node)
    (Arg [ty]
        ;; A memory argument rooted at CallEnd is the post-call heap state. It is not an
        ;; entry-like root: consumers must remain after the call that produced that state.
        (let [ctrl (if (> (n-nins node) 0) (n-in node 0) NO-NODE)]
          (if (and (>= ctrl 0) (match (n-op ctrl) (CallEnd [] true) (_ false)))
              (>= (ms-node-inst-before owner (n-in ctrl 1) at) 0)
              true)))
    (Parm [index] true)
    (Proj [slot]
      (let [parent (n-in node 0)]
        (if (and (!= parent NO-NODE)
                 (match (n-op parent) (New [shape] true) (_ false)))
            (>= (ms-node-inst-before owner parent at) 0)
            true)))
    (Store [alias] (>= (ms-node-inst-before owner node at) 0))
    (PropStore [name] (>= (ms-node-inst-before owner node at) 0))
    (PropDelete [name] (>= (ms-node-inst-before owner node at) 0))
    (PropStoreKey [_] (>= (ms-node-inst-before owner node at) 0))
    (PropDeleteKey [] (>= (ms-node-inst-before owner node at) 0))
    (SetProto [] (>= (ms-node-inst-before owner node at) 0))
    (ObjectFreeze [] (>= (ms-node-inst-before owner node at) 0))
    (InternalStore [operation] (>= (ms-node-inst-before owner node at) 0))
    (ArrayStore [] (>= (ms-node-inst-before owner node at) 0))
    (ArrayResize [] (>= (ms-node-inst-before owner node at) 0))
    (ArrayCopy [] (>= (ms-node-inst-before owner node at) 0))
    (StringSplit [] (>= (ms-node-inst-before owner node at) 0))
    (New [shape] (>= (ms-node-inst-before owner node at) 0))
    (MemMerge []
      (let [len (n-nins node)
              (mut i) 1
              (mut ok) true]
          (loop (if (or (>= (load i) len) (not (load ok)))
                    (break)
                    (do
                      (if (not (ms-memory-node-before? owner (n-in node (load i)) at))
                          (set! ok false)
                          0)
                      (set! i (+ (load i) 1))
                      0)))
          (load ok)))
    (Phi [declared] (and (ty-mem? declared) (>= (ms-phi-block owner node) 0)))
    (_ false)))

(defn ms-memory-node-on-incoming-edge? [(owner i64) (node i64) (at i64)] (-> bool)
  (let [u (machine-unit)
        consumer-block (ms-inst-block at)
        (mut producer) (ms-verifier-node-inst-head owner node)
        (mut found) false]
    (loop (if (or (< (load producer) 0) (load found))
              (break)
              (do
                (let [m (be-inst (load producer))]
                  (let [(mut edge) 0]
                    (loop (if (or (>= (load edge) (mu-edge-count)) (load found))
                              (break)
                              (do
                                (if (and (= (mu-edge-source (load edge)) (.block-id m))
                                         (= (mu-edge-target (load edge)) consumer-block))
                                    (set! found true)
                                    0)
                                (set! edge (+ (load edge) 1)))))))
                (set! producer
                      (al-get [i64] (.verify-node-inst-next u) (load producer))))))
    (load found)))

(defn ms-block-reaches? [(source i64) (target i64)] (-> bool)
  (let [(mut seen) (al-new [i64] (malloc-allocator))
        blocks (mu-block-count)
        (mut i) 0
        (mut changed) true]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (al-push! [i64] (mut seen) (if (= (load i) source) 1 0))
                (set! i (+ (load i) 1)))))
    (loop (if (not (load changed))
              (break)
              (do
                (set! changed false)
                (set! i 0)
                (loop (if (>= (load i) (mu-edge-count))
                          (break)
                          (let [from (mu-edge-source (load i))
                                to (mu-edge-target (load i))]
                            (if (and (!= (al-get [i64] (load seen) from) 0)
                                     (= (al-get [i64] (load seen) to) 0))
                                (do
                                  (al-set! [i64] (mut seen) to 1)
                                  (set! changed true))
                                0)
                            (set! i (+ (load i) 1))))))))
    (let [answer (!= (al-get [i64] (load seen) target) 0)]
      (al-free! [i64] (mut seen))
      answer)))

(defn ms-memory-node-on-loop-backedge? [(owner i64) (node i64) (at i64)] (-> bool)
  (let [u (machine-unit)
        consumer-block (ms-inst-block at)
        (mut producer) (ms-verifier-node-inst-head owner node)
        (mut found) false]
    (loop (if (or (< (load producer) 0) (load found))
              (break)
              (do
                (let [m (be-inst (load producer))
                      producer-block (.block-id m)]
                  (if (and (!= producer-block consumer-block)
                           (or (= (ms-memory-block owner node) consumer-block)
                               (and (mu-dominates? consumer-block producer-block)
                                    (ms-block-reaches? producer-block consumer-block))))
                      (set! found true)
                      0))
                (set! producer
                      (al-get [i64] (.verify-node-inst-next u) (load producer))))))
    (load found)))

(defn ms-memory-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit)
        m (be-inst at)
        owner (.owner m)
        first (.mem-first m)
        count (.mem-count m)
        (mut i) 0
        (mut ok) true]
    (if (= count 0)
        true
        (if (or (< first 0)
                (> (+ first count) (al-len [i64] (.selection-memory-deps u))))
            false
            (do
              (loop (if (or (>= (load i) count) (not (load ok)))
                        (break)
                        (do
                          (let [node
                                  (al-get (.selection-memory-deps u)
                                          (+ first (load i)))]
                            (if (or (ms-memory-node-before? owner node at)
                                    (or (ms-memory-node-on-incoming-edge? owner node at)
                                        (ms-memory-node-on-loop-backedge? owner node at)))
                                0
                                (set! ok false)))
                          (set! i (+ (load i) 1))
                          0)))
              (load ok))))))

(defn ms-memory-anti-dependencies-valid? [(at i64)] (-> bool)
  (let [u (machine-unit)
        m (be-inst at)
        first (.anti-first m)
        count (.anti-count m)
        total (al-len [i64] (.memory-anti-deps u))
        (mut prior) 0
        (mut seen) 0
        (mut ok) true]
    (if (= count 0)
        true
        (if (or (< first 0) (or (< count 0) (> (+ first count) total)))
            false
            (do
              ;; Rebuild a verifier-owned read index once, then inspect only this
              ;; write's function. The previous verifier scanned the entire machine
              ;; unit for every write with anti-dependencies, making this independent
              ;; check quadratic even though the selector's builder was indexed.
              (set! prior
                    (if (and (>= (.owner m) 0)
                             (< (.owner m) (al-len [i64] (.verify-memory-read-head u))))
                        (al-get [i64] (.verify-memory-read-head u) (.owner m))
                        -1))
              (loop (if (or (< (load prior) 0) (not (load ok)))
                        (break)
                        (do
                          (let [candidate (be-inst (load prior))]
                            (if (and (ms-machine-memory-write? m)
                                     (and (= (.owner candidate) (.owner m))
                                          (and (ms-memory-operands-may-alias? candidate m)
                                               (and (ms-machine-memory-read? candidate)
                                               (and (< (.node candidate) (.node m))
                                                    (mu-dominates? (.block-id candidate)
                                                                   (.block-id m)))))))
                                (do
                                  ;; Scheduling may reorder independent reads. The anti-dependency
                                  ;; vector is a set of required read nodes, not a second schedule;
                                  ;; validate membership without imposing its construction order.
                                  (let [(mut dep) 0 (mut listed) false]
                                    (loop
                                      (if (or (>= (load dep) count) (load listed))
                                          (break)
                                          (do
                                            (if (= (al-get
                                                     (.memory-anti-deps u)
                                                     (+ first (load dep)))
                                                   (.node candidate))
                                                (set! listed true)
                                                0)
                                            (set! dep (+ (load dep) 1))
                                            0)))
                                    (if (not (load listed))
                                        (do
                                          (fmt (stderr)
                                               "selection anti-dependency missing write={d} read={d} write-block={d} read-block={d} declared={d}\n"
                                               (.node m)
                                               (.node candidate)
                                               (.block-id m)
                                               (.block-id candidate)
                                               count)
                                          (set! ok false))
                                        0))
                                  (set! seen (+ (load seen) 1)))
                                0))
                          (set! prior
                                (al-get [i64] (.verify-memory-read-next u) (load prior)))
                          0)))
              (if (and (load ok) (!= (load seen) count))
                  (do
                    (fmt (stderr)
                         "selection anti-dependency count mismatch write={d} seen={d} declared={d}\n"
                         (.node m) (load seen) count)
                    0)
                  0)
              (and (load ok) (= (load seen) count)))))))

(defn ms-inst-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        a (.a m)
        b (.b m)]
    (case op MI-MOVI
          true MI-FMOVI
          true MI-ARG
          true MI-JMP
          true MI-STACKARG
          true MI-ABI-COPY
          (ms-input-valid? at a) MI-NEW
          (and (and (ms-input-valid? at a) (ms-input-valid? at b))
               (ms-call-args-valid? at)) MI-JSPROP
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-JSARRAY
          (and (and (ms-input-valid? at a) (ms-input-valid? at b))
               (ms-call-args-valid? at))
            MI-JSSTRING
          (and (and (ms-input-valid? at a) (ms-input-valid? at b))
               (ms-call-args-valid? at))
            MI-LOAD
          (ms-input-valid? at a) MI-STORE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-NEG
          (ms-input-valid? at a) MI-SCVTF
          (ms-input-valid? at a) MI-I32FROMFP
          (ms-input-valid? at a) MI-FNEG
          (ms-input-valid? at a) MI-FTRUTH
          (ms-input-valid? at a) MI-JSBOX
          (ms-input-valid? at a) MI-JSUNBOX
          (ms-input-valid? at a) MI-JSTEST
          (ms-input-valid? at a) MI-RET
          (ms-input-valid? at a) MI-CBR
          (ms-input-valid? at a) MI-ADD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SUB
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-MUL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SDIV
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-EQ
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-LT
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-LE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FADD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FSUB
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FMUL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FDIV
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FMOD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FEQ
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FLT
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-FLE
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-MOD
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITAND
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITOR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITXOR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SHL
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-SHR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-USHR
          (and (ms-input-valid? at a) (ms-input-valid? at b)) MI-BITNOT
          (ms-input-valid? at a) MI-COPY
          (ms-input-valid? at a) MI-CALL
          (let [count (ms-inst-arg-count at)
                (mut i) 0
                (mut ok) true]
            (loop (if (or (>= (load i) count) (not (load ok)))
                      (break)
                      (do
                        (if (not (ms-input-valid? at (ms-inst-arg at (load i))))
                            (store! ok false)
                            0)
                        (store! i (+ (load i) 1))
                        0)))
            (load ok))
            false)))

(defn ms-call-target-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (.owner m)
        target (.imm m)
        node (.node m)]
    (if (>= target 0)
        (and (< target (mu-function-count))
             (= (mu-function-ideal target) (mu-direct-callee node)))
        (let [targets (^ target -1)
              expected (be-call-target-summary (n-ty (n-in node 1)))]
          ;; Polymorphic emission deliberately dispatches over every function in the machine unit:
          ;; the type summary can retain dead function ids after reachability, and requiring those
          ;; ids to have machine owners rejects sound calls even though no runtime value can name a
          ;; dead function. Validate that selection faithfully recorded the summary; unit coverage
          ;; is defined by mu-build-program! and checked by the emitted all-owner dispatch itself.
          (= targets expected)))))

(defn ms-call-args-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        first (.arg-first m)
        count (.arg-count m)
        total (al-len [i64] (.call-args (machine-unit)))]
    (and (>= count 0)
         (and (<= count 16)
              (and (if (= count 0) (= first -1) (>= first 0))
                   (or (= count 0) (<= (+ first count) total)))))))

(defn ms-vreg-used-after? [(owner i64) (vreg i64) (at i64)] (-> bool)
  (let [n (be-inst-count)
        (mut i) (+ at 1)
        (mut used) false]
    (loop (if (or (>= (load i) n) (load used))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (and (= (.owner m) owner)
                           (or (= (.a m) vreg) (= (.b m) vreg)))
                      (set! used true)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load used)))

(defn ms-block-range-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        len (be-inst-count)
        owner (mu-block-owner bid)
        (mut i) 0]
    (if (or (< first 0) (or (<= count 0) (> (+ first count) len)))
        false
        (let [(mut ok) true]
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [m (be-inst (+ first (load i)))]
                        (if (or (!= (.owner m) owner)
                                (!= (.block-id m) bid))
                            (set! ok false)
                            0))
                      (set! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn ms-block-terminator-valid? [(bid i64)] (-> bool)
  (let [first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        term (mu-block-terminator bid)
        succ (mu-block-succ-count bid)
        (mut i) 0
        (mut terms) 0
        (mut last-op) -1]
    (loop (if (>= (load i) count)
              (break)
              (do
                (let [op (ms-inst-op (+ first (load i)))]
                  (if (mi-op-terminator? op)
                      (do (set! terms (+ (load terms) 1)) (set! last-op op))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (and (= (load terms) 1)
         (and (mi-op-terminator? (ms-inst-op (- (+ first count) 1)))
              (if (= succ 1)
                  (= (load last-op) MI-JMP)
                  (if (= term NO-NODE)
                      false
                      (match (n-op term)
                        (If [] (and (= succ 2) (= (load last-op) MI-CBR)))
                        (Return [] (and (= succ 0) (= (load last-op) MI-RET)))
                        (_ false))))))))

(defn ms-definition-unique? [(at i64)] (-> bool)
  (let [m (be-inst at)
        dst (.dst m)
        owner (.owner m)
        node (.node m)
        u (machine-unit)]
    (if (or (< dst 0) (= (.op m) MI-COPY))
        true
        (let [defs (al-get [i64] (.verify-def-count u) dst)
              nodes (if (or (< node 0) (= (.op m) MI-LOAD))
                        1
                        (al-get [i64] (.verify-node-def-count u)
                                (+ (* owner (n-count)) node)))]
          ; Materialized closure environments may reload the same logical capture at distinct call
          ; sites. Those are distinct machine definitions but intentionally share the capture node
          ; so GC kind classification remains exact.
          (and (= defs 1)
               (if (or (< node 0) (= (.op m) MI-LOAD))
                   true
                   (= nodes 1)))))))

(defn ms-inst-membership-count [(at i64)] (-> i64)
  (let [members (.verify-membership (machine-unit))]
    (if (or (< at 0) (>= at (al-len [i64] members)))
        0
        (al-get [i64] members at))))

(defn ms-build-verifier-indices! [] (-> i64)
  (let [u (machine-unit)
        vregs (.next-vreg u)
        nodes (n-count)
        funcs (mu-function-count)
        insts (be-inst-count)
        blocks (mu-block-count)
        (mut i) 0]
    (al-clear! [i64] (field u verify-def-count))
    (al-clear! [i64] (field u verify-node-def-count))
    (al-clear! [i64] (field u verify-node-inst-head))
    (al-clear! [i64] (field u verify-node-inst-next))
    (al-clear! [i64] (field u verify-membership))
    (al-clear! [i64] (field u verify-block-phi-head))
    (al-clear! [i64] (field u verify-node-phi-next))
    (al-clear! [i64] (field u verify-memory-read-head))
    (al-clear! [i64] (field u verify-memory-read-next))
    (loop (if (>= (load i) vregs) (break)
              (do (al-push! [i64] (field u verify-def-count) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (* funcs nodes)) (break)
              (do (al-push! [i64] (field u verify-node-def-count) 0)
                  (al-push! [i64] (field u verify-node-inst-head) -1)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) blocks) (break)
              (do (al-push! [i64] (field u verify-block-phi-head) -1)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) funcs) (break)
              (do (al-push! [i64] (field u verify-memory-read-head) -1)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) nodes) (break)
              (do (al-push! [i64] (field u verify-node-phi-next) -1)
                  (set! i (+ (load i) 1)))))
    ;; This is an independent graph walk, in reverse so each block list retains ascending node
    ;; order. It verifies against ideal Phi ownership without trusting the selector's cache.
    (set! i nodes)
    (loop (if (<= (load i) 0) (break)
              (do
                (set! i (- (load i) 1))
                (if (and (not (n-dead? (load i)))
                         (and (op-is? (load i) Phi [_]) (> (n-nins (load i)) 0)))
                    (let [ctrl (n-in (load i) 0)
                          block (if (= ctrl NO-NODE) -1 (al-get (.ctrl-block u) ctrl))]
                      (if (and (>= block 0) (< block blocks))
                          (do
                            (al-set! [i64] (field u verify-node-phi-next) (load i)
                                     (al-get (.verify-block-phi-head u) block))
                            (al-set! [i64] (field u verify-block-phi-head) block (load i)))
                          0))
                    0))))
    (set! i 0)
    (loop (if (>= (load i) insts) (break)
              (do
                (al-push! [i64] (field u verify-membership) 0)
                (al-push! [i64] (field u verify-node-inst-next) -1)
                (al-push! [i64] (field u verify-memory-read-next) -1)
                (let [m (be-inst (load i))
                      dst (.dst m)
                      owner (.owner m)
                      node (.node m)]
                  (if (and (>= node 0)
                           (and (< node nodes) (and (>= owner 0) (< owner funcs))))
                      (let [key (+ (* owner nodes) node)]
                        (al-set! [i64] (field u verify-node-inst-next) (load i)
                                 (al-get [i64] (.verify-node-inst-head u) key))
                        (al-set! [i64] (field u verify-node-inst-head) key (load i)))
                      0)
                  (if (and (>= owner 0)
                           (and (< owner funcs) (ms-machine-memory-read? m)))
                      (do
                        (al-set! [i64] (field u verify-memory-read-next) (load i)
                                 (al-get [i64] (.verify-memory-read-head u) owner))
                        (al-set! [i64] (field u verify-memory-read-head) owner (load i))
                        0)
                      0)
                  (if (>= dst 0)
                      (do
                        (al-set! [i64] (field u verify-def-count) dst
                                 (+ (al-get [i64] (.verify-def-count u) dst) 1))
                        (if (and (!= (.op m) MI-LOAD)
                                 (and (>= node 0) (and (>= owner 0) (< owner funcs))))
                            (let [key (+ (* owner nodes) node)]
                              (al-set! [i64] (field u verify-node-def-count) key
                                       (+ (al-get [i64] (.verify-node-def-count u) key) 1)))
                            0))
                      0))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) blocks) (break)
              (do
                (let [first (mu-block-inst-first (load i))
                      count (mu-block-inst-count (load i))
                      (mut k) 0]
                  (loop (if (>= (load k) count) (break)
                            (do
                              (let [at (+ first (load k))]
                                (if (and (>= at 0) (< at insts))
                                    (al-set! [i64] (field u verify-membership) at
                                             (+ (al-get [i64] (.verify-membership u) at) 1))
                                    0))
                              (set! k (+ (load k) 1))))))
                (set! i (+ (load i) 1)))))
    0))

(defn ms-memory-source-on-edge? [(owner i64) (node i64) (bid i64)] (-> bool)
  (let [(mut edge) 0
        (mut found) false]
    (loop (if (or (>= (load edge) (mu-edge-count)) (load found))
              (break)
              (do
                (if (and (= (.owner (mu-edge (load edge))) owner)
                         (= (mu-edge-source (load edge)) bid))
                    (let [n (mu-edge-copy-count (load edge))
                          (mut i) 0]
                      (loop (if (or (>= (load i) n) (load found))
                                (break)
                                (do
                                  (if (and (= (mu-copy-kind (load edge) (load i)) MCOPY-MEMORY)
                                           (= (mu-copy-src (load edge) (load i)) node))
                                      (set! found true)
                                      0)
                                  (set! i (+ (load i) 1))
                                  0))))
                    0)
                (set! edge (+ (load edge) 1))
                0)))
    (load found)))

(defn ms-inst-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        owner (.owner m)
        bid (.block-id m)
        node (.node m)]
    (case op MI-ARG
          (= bid (ms-entry-block owner)) MI-STACKARG
          (= bid (ms-entry-block owner)) MI-NEW
          ; Ideal Loads have no explicit control input, and closure-environment
          ; reloads may retain a captured Parm/Arg as logical identity. Selection
          ; derives their block from memory and pointer dependencies; GCM verifies it.
          true MI-STORE
          (or (= bid (ms-memory-block owner node))
              (ms-memory-source-on-edge? owner node bid))
            MI-JSPROP
          ; Dynamic property operations have no explicit ideal control input. Selection derives
          ; their branch block from memory order and data dependencies; GCM and dependency
          ; verification below validate that derived placement.
          true
            MI-JSSTRING
          true MI-COPY
          (= (mu-edge-source (load (field m imm))) bid) MI-CALL
          (= bid (ms-node-block owner node)) MI-JMP
          ; A fallthrough block is commonly rooted at a CProj. ms-node-block follows
          ; input 0 and therefore names the predecessor If block; the jump belongs to
          ; the block mapped by the control root itself.
          (= bid (al-get (load (field (machine-unit) ctrl-block)) node)) true)))

(defn ms-gcm-input-earliest-valid? [(owner i64) (earliest i64) (vreg i64)] (-> bool)
  (if (< vreg 0)
      true
      (let [def (ms-owner-def-inst owner vreg)
            dependency
              (if (ms-phi-vreg? owner vreg)
                  (ms-vreg-def-block owner vreg)
                  (if (>= def 0) (ms-inst-earliest def) -1))]
        (and (>= dependency 0) (mu-dominates? dependency earliest)))))

(defn ms-gcm-earliest-dependencies-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (.owner m)
        earliest (.earliest m)
        inputs (mi-op-inputs (.op m))
        (mut ok) true]
    (if (> inputs 0)
        (set! ok (ms-gcm-input-earliest-valid? owner earliest (.a m)))
        0)
    (if (and (load ok) (> inputs 1))
        (set! ok (ms-gcm-input-earliest-valid? owner earliest (.b m)))
        0)
    (if (and (load ok) (= (.op m) MI-CSEL))
        (set! ok (ms-gcm-input-earliest-valid? owner earliest (.imm m)))
        0)
    (if (and (load ok) (> (ms-inst-arg-count at) 0))
        (let [(mut arg) 0]
          (loop (if (or (>= (load arg) (ms-inst-arg-count at)) (not (load ok)))
                    (break)
                    (do
                      (set! ok
                            (ms-gcm-input-earliest-valid? owner
                                                          earliest
                                                          (ms-inst-arg at (load arg))))
                      (set! arg (+ (load arg) 1))
                      0))))
        0)
    (load ok)))

(defn ms-gcm-placement-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        owner (.owner m)
        bid (.block-id m)
        earliest (.earliest m)
        latest (.latest m)
        pinned (or (mi-op-pinned? (.op m)) (ms-inst-anchored? owner at))]
    (if (or (< earliest 0)
            (or (< latest 0)
                (or (!= (mu-block-owner earliest) owner)
                    (!= (mu-block-owner latest) owner))))
        false
        (if pinned
            (and (= bid earliest) (= bid latest))
            (let [actual-latest
                    (if (>= (.dst m) 0)
                        (ms-gcm-latest-use-block owner (.dst m))
                        -1)
                  expected-latest (if (< actual-latest 0) earliest actual-latest)]
              (if (or (!= latest expected-latest)
                      (or (not (ms-gcm-earliest-dependencies-valid? at))
                          (or (not (mu-dominates? earliest bid))
                              (not (mu-dominates? bid latest)))))
                  false
                  (let [(mut expected) latest
                        (mut cursor) latest]
                    (loop (if (= (load cursor) earliest)
                              (break)
                              (do
                                (set! cursor (mu-block-idom (load cursor)))
                                (if (< (mu-block-loop-depth (load cursor))
                                       (mu-block-loop-depth (load expected)))
                                    (set! expected (load cursor))
                                    0))))
                    (= bid (load expected)))))))))

;; The only instruction an edge copy may put between a Phi's input and the value it copies: the
;; widening `ms-fp-input!` emits when the Phi is floating-point and the input is not. `SCVTF` for a
;; machine integer, `JSUNBOX` to a number for a tagged JavaScript word, and nothing else — this
;; verifier named only `SCVTF`, which is the same assumption that made the widening itself wrong.
(defn ms-fp-widening-of? [(def i64) (input i64)] (-> bool)
  (and (>= def 0)
       (and (= (ms-inst-a def) input)
            (or (= (ms-inst-op def) MI-SCVTF)
                (and (= (ms-inst-op def) MI-JSUNBOX) (= (ms-inst-imm def) 0))))))

(defn ms-vreg-selects-node? [(owner i64) (vreg i64) (node i64)] (-> bool)
  (let [u (machine-unit)]
    (and (>= vreg 0)
         (and (< vreg (al-len [i64] (.vreg-node u)))
              (and (= (al-get [i64] (.vreg-node-owner u) vreg) owner)
                   (= (al-get [i64] (.vreg-node u) vreg) node))))))

(defn ms-edge-copies-valid? [(edge i64)] (-> bool)
  (let [u (machine-unit)
        e (mu-edge edge)
        first (.copy-first e)
        count (.copy-count e)
        slot (.target-slot e)
        target (.target e)
        owner (.owner e)
        total (al-len [MCopy] (.edge-copies u))
        (mut i) 0
        (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) total)))
        false
        (do
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [c (mu-edge-copy edge (load i))
                            phi (.phi c)
                            kind (.kind c)]
                        (if (or (!= (.edge c) edge)
                                (or (= phi NO-NODE)
                                    (or (not (op-is? phi Phi [_]))
                                        (or (!= (ms-phi-block owner phi) target)
                                            (>= slot (n-nins phi))))))
                            (set! ok false)
                            (if (ty-mem? (n-ty phi))
                                (if (or (!= kind MCOPY-MEMORY)
                                        (or (!= (.dst c) phi)
                                            (or (!= (.src c) (n-in phi slot))
                                                (not (ms-memory-node-before? owner
                                                                             (.src c)
                                                                             (+ (mu-block-inst-first (.source e))
                                                                                (mu-block-inst-count (.source e))))))))
                                    (set! ok false)
                                    0)
                                (if (or (!= kind MCOPY-VALUE)
                                        (or (!= (.dst c) (ms-vget owner phi))
                                            (let [src (.src c)
                                                  input-node (n-in phi slot)
                                                  def (ms-owner-def-inst owner src)]
                                              (not
                                                (or (= src (ms-vget owner input-node))
                                                    (or (ms-vreg-selects-node? owner src input-node)
                                                    (and (ms-fp-widening-of?
                                                           def
                                                           (if (>= def 0) (ms-inst-a def) -1))
                                                         (ms-vreg-selects-node?
                                                           owner
                                                           (if (>= def 0) (ms-inst-a def) -1)
                                                           input-node))))))))
                                    (set! ok false)
                                    0))))
                      (set! i (+ (load i) 1))
                      0)))
          ; Every live Phi attached to the target has exactly one record on this edge.
          (let [(mut node) (al-get (.verify-block-phi-head u) target)]
            (loop (if (or (< (load node) 0) (not (load ok)))
                      (break)
                      (do
                        (let [(mut j) 0
                                  (mut matches) 0]
                              (loop (if (>= (load j) count)
                                        (break)
                                        (do
                                          (if (= (.phi (mu-edge-copy edge (load j))) (load node))
                                              (set! matches (+ (load matches) 1))
                                              0)
                                          (set! j (+ (load j) 1))
                                          0)))
                              (if (!= (load matches) 1) (set! ok false) 0))
                        (set! node (al-get (.verify-node-phi-next u) (load node)))
                        0))))
          (load ok)))))

(defn ms-verify! [] (-> bool)
  (ms-gcm-build-use-lists!)
  (ms-build-verifier-indices!)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        len (be-inst-count)
        (mut bid) 0
        (mut edge) 0
        (mut at) 0]
    (set! (.selection-result u) MSEL-OK)
    (set! (.selection-item u) -1)
    (loop (if (or (>= (load bid) blocks) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (not (ms-block-range-valid? (load bid)))
                    (ms-fail! MSEL-OWNER (load bid))
                    (if (not (ms-block-terminator-valid? (load bid)))
                        ;; Verifier failure items are machine-instruction indices. Reporting the
                        ;; block id here made the harness print an unrelated instruction whose
                        ;; index happened to equal that block number, hiding the actual terminator
                        ;; defect across thousands of Test262 cases.
                        (ms-fail! MSEL-TERMINATOR
                                  (- (+ (mu-block-inst-first (load bid))
                                        (mu-block-inst-count (load bid)))
                                     1))
                        0))
                (set! bid (+ (load bid) 1))
                0)))
    (loop (if (or (>= (load edge) edges) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (if (not (ms-edge-copies-valid? (load edge)))
                    (do
                      (let [e (mu-edge (load edge))
                                (mut copy) 0
                                (mut phi) (al-get (.verify-block-phi-head u) (.target e))]
                            (do
                              (fmt (stderr)
                                   "AOTK_PROFILE phase=selection_invalid_phi_edge edge={d} owner={d} source={d} target={d} slot={d} copies={d}\n"
                                   (load edge) (.owner e) (.source e) (.target e)
                                   (.target-slot e) (.copy-count e))
                              (loop (if (>= (load copy) (.copy-count e))
                                        (break)
                                        (do
                                          (let [c (mu-edge-copy (load edge) (load copy))]
                                            (fmt (stderr)
                                                 "AOTK_PROFILE phase=selection_invalid_phi_copy phi={d} dst={d} src={d} kind={d}\n"
                                                 (.phi c) (.dst c) (.src c) (.kind c)))
                                          (set! copy (+ (load copy) 1))
                                          0)))
                              (loop (if (< (load phi) 0)
                                        (break)
                                        (do
                                          (fmt (stderr)
                                               "AOTK_PROFILE phase=selection_invalid_phi_expected phi={d} dst={d} input={d} src={d}\n"
                                               (load phi) (ms-vget (.owner e) (load phi))
                                               (n-in (load phi) (.target-slot e))
                                               (ms-vget (.owner e)
                                                        (n-in (load phi) (.target-slot e))))
                                          (set! phi (al-get (.verify-node-phi-next u) (load phi)))
                                          0)))))
                      (ms-fail! MSEL-PHI (load edge)))
                    0)
                (set! edge (+ (load edge) 1))
                0)))
    (loop (if (or (>= (load at) len) (!= (ms-result) MSEL-OK))
              (break)
              (do
                (let [op (ms-inst-op (load at))
                      membership (ms-inst-membership-count (load at))
                      placement (ms-inst-placement-valid? (load at))]
                  (if (or (!= membership 1) (not placement))
                      (ms-fail! MSEL-OWNER (load at))
                      (do
                        (if (not (ms-gcm-placement-valid? (load at)))
                            (ms-fail! MSEL-PLACEMENT (load at))
                            0)
                        (if (and (= (ms-result) MSEL-OK)
                                 (not (ms-memory-anti-dependencies-valid? (load at))))
                            (ms-fail! MSEL-MEMORY-ORDER (load at))
                            0)
                        (if (and (= op MI-CALL) (not (ms-call-target-valid? (load at))))
                            (ms-fail! MSEL-CALL (load at))
                            0)
                        (if (and (= (ms-result) MSEL-OK)
                                 (and (> (ms-inst-arg-count (load at)) 0)
                                      (not (ms-call-args-valid? (load at)))))
                            (ms-fail! MSEL-CALL (load at))
                            0)
                        (if (!= (ms-result) MSEL-OK)
                            0
                            ; Keep the descriptor aggregate inside a scalar wrapper. Constructing
                            ; it directly in this whole-program loop consumes dynamic stack space
                            ; in Coil and eventually corrupts large-program verification.
                            (if (< (mi-op-inputs op) 0)
                                (ms-fail! MSEL-UNSUPPORTED (load at))
                                (if (or (not (ms-inst-dependencies-valid? (load at)))
                                        (not (ms-memory-dependencies-valid? (load at))))
                                    (ms-fail! MSEL-DEPENDENCY (load at))
                                    (if (not (ms-definition-unique? (load at)))
                                        (ms-fail! MSEL-DUPLICATE (load at))
                                        0)))))))
                (set! at (+ (load at) 1))
                0)))
    (= (ms-result) MSEL-OK)))

(defn ms-corrupt-owner! [(at i64) (owner i64)] (-> i64)
  (set! (.owner (be-inst at)) owner)
  0)
(defn ms-corrupt-input! [(at i64) (vreg i64)] (-> i64)
  (set! (.a (be-inst at)) vreg)
  0)
(defn ms-corrupt-memory-dep! [(at i64) (node i64)] (-> i64)
  (let [u (machine-unit)
        m (be-inst at)
        first (.mem-first m)]
    (if (< first 0) 0 (al-set! [i64] (field u selection-memory-deps) first node))
    0))
(defn ms-corrupt-placement! [(at i64) (bid i64)] (-> i64)
  (set! (.block-id (be-inst at)) bid)
  (ms-pack-instructions!)
  0)
(defn ms-corrupt-earliest! [(at i64) (bid i64)] (-> i64)
  (set! (.earliest (be-inst at)) bid)
  0)
(defn ms-corrupt-memory-anti-dep! [(at i64) (node i64)] (-> i64)
  (let [m (be-inst at)
        first (.anti-first m)]
    (if (> (.anti-count m) 0)
        (al-set! [i64] (field (machine-unit) memory-anti-deps) first node)
        0)
    0))
(defn ms-corrupt-duplicate-terminator! [(bid i64)] (-> i64)
  (let [b (mu-block bid)
        last (+ (.inst-first b) (- (.inst-count b) 1))
        copy (load (be-inst last))]
    (ms-emit! (mu-block-owner bid) bid copy)
    (set! (.inst-count b) (+ (.inst-count b) 1))
    0))
(defn ms-corrupt-copy-source! [(edge i64) (which i64) (src i64)] (-> i64)
  (set! (.src (mu-edge-copy edge which)) src)
  0)
(defn ms-corrupt-copy-phi! [(edge i64) (which i64) (phi i64)] (-> i64)
  (set! (.phi (mu-edge-copy edge which)) phi)
  0)
(defn ms-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (set! (.imm (be-inst at)) target)
  0)
(defn ms-corrupt-call-arg! [(at i64) (which i64) (vreg i64)] (-> i64)
  (let [m (be-inst at)
        first (.arg-first m)]
    (if (or (< which 0) (>= which (.arg-count m)))
        0
        (al-set! [i64] (field (machine-unit) call-args) (+ first which) vreg))
    0))

(defn mi-op-name [(op i64)] (-> (slice u8))
  (case op MI-MOVI
        "MOVI" MI-ADD
        "ADD" MI-SUB
        "SUB" MI-MUL
        "MUL" MI-SDIV
        "SDIV" MI-NEG
        "NEG" MI-RET
        "RET" MI-ARG
        "ARG" MI-EQ
        "EQ" MI-LT
        "LT" MI-LE
        "LE" MI-LABEL
        "LABEL" MI-CBZ
        "CBZ" MI-CSEL
        "CSEL" MI-MOV
        "MOV" MI-B
        "B" MI-NEW
        "NEW" MI-LOAD
        "LOAD" MI-STORE
        "STORE" MI-CBR
        "CBR" MI-JMP
        "JMP" MI-COPY
        "COPY" MI-CALL
        "CALL" MI-ABI-COPY
        "ABI-COPY" MI-FMOVI
        "FMOVI" MI-SCVTF
        "SCVTF" MI-FADD
        "FADD" MI-FSUB
        "FSUB" MI-FMUL
        "FMUL" MI-FDIV
        "FDIV" MI-FNEG
        "FNEG" MI-FEQ
        "FEQ" MI-FLT
        "FLT" MI-FLE
        "FLE" MI-FTRUTH
        "FTRUTH" MI-MOD
        "MOD" MI-BITAND
        "BITAND" MI-BITOR
        "BITOR" MI-BITXOR
        "BITXOR" MI-SHL
        "SHL" MI-SHR
        "SHR" MI-USHR
        "USHR" MI-BITNOT
        "BITNOT" MI-I32FROMFP
        "I32FROMFP" MI-FMOD
        "FMOD" MI-JSPROP
        "JSPROP" MI-JSARRAY
        "JSARRAY" MI-JSSTRING
        "JSSTRING" "?"))

(defn ms-print-inst [(w (ptr Writer)) (at i64)] (-> i64)
  (if (or (< at 0) (>= at (be-inst-count)))
      (do (fmt w "m{d}: out of range\n" at) 0)
      (let [m (be-inst at)]
        (fmt w "m{d}: {s} owner={d} block={d} node={d} dst={d} a={d} b={d} imm={d}\n"
             at (mi-op-name (.op m)) (.owner m) (.block-id m) (.node m)
             (.dst m) (.a m) (.b m) (.imm m))
        (let [a-def (ms-owner-def-inst (.owner m) (.a m))
              b-def (ms-owner-def-inst (.owner m) (.b m))]
          (if (>= a-def 0)
              (let [d (be-inst a-def)]
                (fmt w "  a <- m{d}:{s} block={d} node={d}\n"
                     a-def (mi-op-name (.op d)) (.block-id d) (.node d))
                0)
              0)
          (if (>= b-def 0)
              (let [d (be-inst b-def)]
                (fmt w "  b <- m{d}:{s} block={d} node={d}\n"
                     b-def (mi-op-name (.op d)) (.block-id d) (.node d))
                0)
              0)
          (if (and (= (.op m) MI-CALL)
                   (and (>= (.node m) 0) (< (.node m) (n-count))))
              (let [target (.imm m)
                    expected (be-call-target-summary (n-ty (n-in (.node m) 1)))
                    (mut owner) 0]
                (fmt w "  call target={d} decoded={d} expected={d} args={d}@{d} symbols="
                     target (if (< target 0) (^ target -1) target) expected
                     (.arg-count m) (.arg-first m))
                (loop (if (>= (load owner) (mu-function-count))
                          (break)
                          (do
                            (fmt w "{d}," (al-get (.symbols (machine-unit)) (load owner)))
                            (set! owner (+ (load owner) 1))
                            0)))
                (ps w "\n")
                0)
              0))))
  0)

(defn ms-print-block [(w (ptr Writer)) (bid i64)] (-> i64)
  (if (or (< bid 0) (>= bid (mu-block-count)))
      (do (fmt w "block {d}: out of range\n" bid) 0)
      (let [first (mu-block-inst-first bid)
            count (mu-block-inst-count bid)
            term (mu-block-terminator bid)
            succ (mu-block-succ-count bid)
            (mut i) 0]
        (fmt w "block {d}: owner={d} first={d} count={d} ideal-term={d} succ={d} valid={d}\n"
             bid (mu-block-owner bid) first count term succ
             (if (ms-block-terminator-valid? bid) 1 0))
        (loop (if (>= (load i) count)
                  (break)
                  (do
                    (ms-print-inst w (+ first (load i)))
                    (set! i (+ (load i) 1)))))
        0)))

(defn ms-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [nblocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) nblocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))
                                    first (mu-block-inst-first bid)
                                    n (mu-block-inst-count bid)
                                    (mut i) 0]
                                (fmt w "  b{d}:" (load rpo))
                                (loop (if (>= (load i) n)
                                          (break)
                                          (do
                                            (ps w " ")
                                            (ps w (mi-op-name (ms-inst-op (+ first (load i)))))
                                            (set! i (+ (load i) 1))
                                            0)))
                                (ps w "\n"))
                              (set! rpo (+ (load rpo) 1))
                              0))))
                (set! owner (+ (load owner) 1))
                0)))
    0))

(defn ms-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ms-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "ms-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

;; Machine representation classification is selection policy. Liveness consumes the result;
;; keeping it here prevents a selection/liveness dependency cycle.
;; A VALUE SPANNING REPRESENTATION CLASSES IS TAGGED, and this asked about `VK-OBJ` alone -- so
;; `num|str`, which is what `x + 1` on an `any` parameter produces, was classified a raw SCALAR. A
;; function returning one then had no single return tag, `be-call-return-tag` answered -1, and
;; `String(f(1))` failed instruction selection outright: the `Box` above the call had nothing to tag
;; a value that was already tagged. `undefined|number` -- every `at` and `codePointAt` -- was
;; classified the same wrong way.
;;
;; `be-kinds-must-be-tagged?` is the one place that rule is stated; this is the second reader of it.
(defn ml-kind-for-type [(t i64)] (-> i64)
  (let [kinds (ty-kinds t)
        nonmoving (| VK-STR (| VK-SYM (| VK-BIG VK-FUN)))]
    (if (be-kinds-must-be-tagged? t)
        MLK-BOXED
        (if (ty-only-obj? t)
            MLK-RAW-MANAGED
            (if (and (!= kinds 0) (= (& kinds (bits-dual nonmoving VK-MASK)) 0))
                MLK-NONMOVING
                (if (!= (& kinds VK-OBJ) 0) MLK-BOXED MLK-SCALAR))))))

;; Parm lattice types describe JavaScript values, not necessarily their machine representation.
;; In particular, receiver-aware calls intentionally pass typed object receivers as raw pointers;
;; several raw receiver shapes can meet to `dyn`. Derive the root kind from the actual incoming
;; call operands so a moving collection never interprets that raw pointer as an already-tagged word.
(defn ml-kind-for-source-representation [(node i64)] (-> i64)
  (let [(mut current) node (mut fuel) 64]
    (loop (if (or (<= (load fuel) 0) (not (op-is? (load current) Cast [_])))
              (break)
              (do
                (set! current (n-in (load current) 1))
                (set! fuel (- (load fuel) 1))
                0)))
    (if (op-is? (load current) Call [_])
        ;; Call nodes deliberately retain the open `dyn` lattice type, but their native return ABI
        ;; is a closed-world property of the target set. Publish that representation to liveness
        ;; and stack maps so a raw managed result held across another safepoint is relocated as a
        ;; pointer instead of being mistaken for an already-tagged JavaScript word.
        (let [kind (be-call-return-kind (load current))]
          (if (>= kind 0) kind (ml-kind-for-type (n-ty (load current)))))
    (if (or (op-is? (load current) Add [])
            (or (op-is? (load current) Sub [])
                (or (op-is? (load current) Mul [])
                    (or (op-is? (load current) Div [])
                        (or (op-is? (load current) Mod [])
                            (or (op-is? (load current) Eq [])
                                (or (op-is? (load current) Lt [])
                                    (or (op-is? (load current) Le [])
                                        (or (op-is? (load current) BitAnd [])
                                            (or (op-is? (load current) BitOr [])
                                                (or (op-is? (load current) BitXor [])
                                                    (or (op-is? (load current) Shl [])
                                                        (or (op-is? (load current) Shr [])
                                                            (or (op-is? (load current) UShr [])
                                                                (op-is? (load current) BitNot [])))))))))))))))
        ;; These nodes always select to an unboxed GPR/FPR result even when a dynamic input makes
        ;; their lattice type broad. In particular, recursive numeric calls must not turn an
        ;; enclosing arithmetic result into the boxed return ABI merely because its type is dyn.
        MLK-SCALAR
        (if (ml-raw-nullable-value? (load current) 32)
        MLK-RAW-MANAGED
        (if (op-is? (load current) Box [_])
        MLK-BOXED
        (ml-kind-for-type (n-ty (load current)))))))))

(defn ml-raw-nullable-value? [(node i64) (fuel i64)] (-> bool)
  (if (or (<= fuel 0) (or (= node NO-NODE) (n-dead? node)))
      false
      (if (op-is? node Phi [_])
          (let [kinds (ty-kinds (n-ty node))]
            (if (= kinds (| VK-NULL VK-OBJ))
                true
                (let [(mut i) 1 (mut saw-null) false (mut saw-raw) false (mut ok) true]
            (loop (if (or (>= (load i) (n-nins node)) (not (load ok)))
                      (break)
                      (let [value (n-in node (load i))]
                        (if (= value node)
                            0
                            (if (= (ty-kinds (n-ty value)) VK-NULL)
                                (set! saw-null true)
                                (if (or (ty-only-obj? (n-ty value))
                                        (ml-raw-nullable-value? value (- fuel 1)))
                                    (set! saw-raw true)
                                    (set! ok false))))
                        (set! i (+ (load i) 1)))))
                  (and (load ok) (and (load saw-null) (load saw-raw))))))
          false)))

(defn ml-kind-for-parm-representation [(parm i64)] (-> i64)
  ;; Selection normally built this compact index with the CFG. Direct unit queries can reach this
  ;; helper earlier, so populate it lazily rather than silently treating an empty cache as no calls.
  (if (= (al-len [i64] (.ideal-calls (machine-unit))) 0) (mu-cache-ideal-calls!) 0)
  (let [fun (n-in parm 0)
        fidx (n-fun-index fun)
        idx (n-parm-index parm)
        calls (.ideal-calls (machine-unit))
        lim (al-len [i64] calls)
        (mut call-index) 0
        (mut answer) -1
        (mut consistent) true]
    (loop (if (or (>= (load call-index) lim) (not (load consistent)))
              (break)
              (do
                (let [call (al-get [i64] calls (load call-index))]
                (if (or (n-dead? call) (not (op-is? call Call [_])))
                    0
                    (if (not (infer-call-reaches-fun? call fun))
                        0
                        (let [source (infer-parm-source call fun idx)]
                          (if (= source NO-NODE)
                              0
                              (let [kind (ml-kind-for-source-representation source)]
                                (if (< (load answer) 0)
                                    (set! answer kind)
                                    (if (!= (load answer) kind)
                                        (set! consistent false)
                                        0))))))))
                (set! call-index (+ (load call-index) 1))
                0)))
    (if (and (load consistent) (>= (load answer) 0))
        (load answer)
        (ml-kind-for-type (n-ty parm)))))

(defn ml-kind-for-node [(node i64)] (-> i64)
  (let [u (machine-unit)
        cacheable (> (mu-function-count) 0)]
    (if cacheable
        (loop (if (> (al-len [bool] (.kind-known u)) node)
                  (break)
                  (do
                    (al-push! [bool] (field u kind-known) false)
                    (al-push! [i64] (field u kind-value) MLK-SCALAR)
                    0)))
        0)
    (if (and cacheable (al-get [bool] (.kind-known u) node))
        (al-get [i64] (.kind-value u) node)
        (let [answer (if (op-is? node Parm [_])
                         (ml-kind-for-parm-representation node)
                         (ml-kind-for-source-representation node))]
          (if cacheable
              (do
                (al-set! [bool] (field u kind-known) node true)
                (al-set! [i64] (field u kind-value) node answer)
                0)
              0)
          answer))))

(defn ml-kind-for-vreg-direct [(vreg i64)] (-> i64)
  (let [u (machine-unit)
        candidate (if (and (>= vreg 0) (< vreg (al-len [i64] (.vreg-node u))))
                      (al-get [i64] (.vreg-node u) vreg)
                      -1)
        candidate-owner (if (< candidate 0)
                            -1
                            (al-get [i64] (.vreg-node-owner u) vreg))]
    (if (and (and (>= candidate 0) (not (n-dead? candidate)))
             (= (ms-vget candidate-owner candidate) vreg))
        (ml-kind-for-node candidate)
        -1)))

;; The reverse map answers most queries directly; a vreg whose recorded node has since died or
;; been reassigned falls back to the scan, so the answer is always the one the scan would give
;; (the verifier already requires every definition of a vreg to agree on its kind).
(defn ml-kind-for-vreg [(vreg i64)] (-> i64)
  (let [direct (ml-kind-for-vreg-direct vreg)]
    (if (>= direct 0) direct (ml-kind-for-vreg-scan vreg))))

(defn ml-kind-for-vreg-scan [(vreg i64)] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0
        (mut found) MLK-SCALAR
        (mut done) false]
    (loop (if (or (>= (load owner) funcs) (load done))
              (break)
              (do
                (let [(mut node) 0]
                  (loop (if (or (>= (load node) (n-count)) (load done))
                            (break)
                            (do
                              (if (and (not (n-dead? (load node)))
                                       (= (ms-vget (load owner) (load node)) vreg))
                                  (do
                                    (set! found (ml-kind-for-node (load node)))
                                    (set! done true))
                                  0)
                              (set! node (+ (load node) 1))
                              0))))
                (set! owner (+ (load owner) 1))
                0)))
    (load found)))

(defn ml-kind-for-inst [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)
        node (.node m)
        dst (.dst m)]
    (if (= (ml-class-for-inst at) MRC-FPR)
        MLK-SCALAR
        (if (= op MI-NEW)
            MLK-RAW-MANAGED
            ;; Preserve a destination's graph representation when it has one. A synthetic copy
            ;; destination has none; asking for its kind used to scan every graph node for every
            ;; copy only to discover no definition, so inherit the source in that case.
            (if (and (or (= op MI-COPY) (= op MI-ABI-COPY)) (>= (.a m) 0))
                (let [direct (ml-kind-for-vreg-direct dst)]
                  (if (>= direct 0) direct (ml-kind-for-vreg (.a m))))
                (if (or (< node 0) (>= node (n-count)))
                    MLK-SCALAR
                    (ml-kind-for-node node)))))))

(defn ml-fp-producing-op? [(op i64)] (-> bool)
  (or (or (= op MI-FMOVI) (= op MI-SCVTF))
      (or (or (= op MI-FADD) (= op MI-FSUB))
          (or (or (= op MI-FMUL) (= op MI-FDIV))
              (or (= op MI-FNEG) (= op MI-FMOD))))))

(defn ml-class-for-inst [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)
        a (.a m)
        node (.node m)]
    (if (or (= op MI-FTRUTH) (= op MI-I32FROMFP))
        MRC-GPR
        ;; Unboxing to a NUMBER writes a double, whatever the tagged payload was, so it lands in an
        ;; FPR the way SCVTF does. Every other tag unboxes to a machine word. The op alone does not
        ;; say which; only the tag does, which is why this is not in `ml-fp-producing-op?`.
        (if (or (ml-fp-producing-op? op)
                (and (= op MI-JSUNBOX) (= (.imm m) 0)))
            MRC-FPR
            (if (and (or (= op MI-COPY) (= op MI-ABI-COPY)) (>= a 0))
                (al-get (.register-class (machine-unit)) a)
                (if (and (>= node 0) (and (< node (n-count)) (be-node-fp-value? node)))
                    MRC-FPR
                    MRC-GPR))))))

;; Placement invokes this legality scheduler before liveness is available, so it belongs to the
;; selected-machine-IR phase rather than the later interval/liveness orchestration layer.
(defn ms-schedule-result [] (-> i64)
  (.schedule-result (machine-unit)))
(defn ms-schedule-item [] (-> i64)
  (.schedule-item (machine-unit)))
(defn ms-schedule-memory-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (.mem-first m)
        count (.mem-count m)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (if (= (al-get (.selection-memory-deps (machine-unit))
                               (+ first (load i)))
                       node)
                    (set! found true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

;; Memory roots created after a call name CallEnd rather than the call node directly. Resolve
;; that anchor here so local scheduling sees the call -> heap-read edge even when value demand
;; selected the read first.
(defn ms-schedule-post-call-memory-dep? [(consumer i64) (producer-node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (.mem-first m)
        count (.mem-count m)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (let [memory
                        (al-get (.selection-memory-deps (machine-unit))
                                (+ first (load i)))
                      ctrl (if (and (>= memory 0)
                                    (and (op-is? memory Arg [_])
                                         (> (n-nins memory) 0)))
                               (n-in memory 0)
                               NO-NODE)]
                  (if (and (>= ctrl 0)
                           (and (op-is? ctrl CallEnd [])
                                (= (n-in ctrl 1) producer-node)))
                      (set! found true)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load found)))

(defn ms-schedule-anti-node-dep? [(consumer i64) (node i64)] (-> bool)
  (let [m (be-inst consumer)
        first (.anti-first m)
        count (.anti-count m)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) count) (load found))
              (break)
              (do
                (if (= (al-get (.memory-anti-deps (machine-unit))
                               (+ first (load i)))
                       node)
                    (set! found true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

;; Set only for the duration of a retried block schedule. See `ms-schedule-block!`.
(defn ms-relax-effect-order [] (-> (ptr bool))
  (let [flag (primitive/alloc-static bool)] flag))

; 0=no edge, 1=scalar data, 2=memory/anti, 3=fixed effect/boundary order.
(defn ms-schedule-dependency-kind [(producer i64) (consumer i64)] (-> i64)
  (if (= producer consumer)
      0
      (let [p (be-inst producer)
            c (be-inst consumer)
            dst (.dst p)
            pop (.op p)
            cop (.op c)
            before (< (.schedule-order p) (.schedule-order c))
            ;; THE CALL/EFFECT ORDER EDGES ARE A HEURISTIC AND CAN CONTRADICT A REAL DEPENDENCE.
            ;; They ask `before`, which reads the CURRENT instruction order — the very thing this
            ;; scheduler exists to correct. `ms-schedule-block!` drops them and retries when they
            ;; make the block uncyclable; see the note there for what goes wrong without that.
            relax (load (ms-relax-effect-order))]
        (if (and (>= dst 0)
                 (and (ms-inst-uses-vreg? consumer dst)
                      (or (!= pop MI-COPY) before)))
            1
            (if (or (ms-schedule-memory-node-dep? consumer (.node p))
                    (or (ms-schedule-post-call-memory-dep? consumer
                                                          (.node p))
                    (and (ms-schedule-anti-node-dep? consumer (.node p))
                         (ms-memory-operands-may-alias? p c))))
                2
                (if (or (and before
                             (or (and (not relax)
                                      (and (> (mi-op-effects pop) 0) (= cop MI-CALL)))
                                 (or (and (not relax)
                                          (and (= pop MI-CALL) (> (mi-op-effects cop) 0)))
                                     (and (= pop MI-STORE) (= cop MI-STORE)))))
                        (or (= pop MI-LABEL)
                            (or (and (or (= pop MI-ARG) (= pop MI-STACKARG))
                                     (or (and (!= cop MI-LABEL)
                                              (and (not (= cop MI-ARG)) (not (= cop MI-STACKARG))))
                                         before))
                                (or (and (= cop MI-COPY)
                                         (and (not (mi-op-terminator? pop))
                                              (or (!= pop MI-COPY) before)))
                                    (or (and (= pop MI-ABI-COPY)
                                             (and (!= cop MI-LABEL)
                                                  (and (!= cop MI-ARG)
                                                       (and (!= cop MI-STACKARG)
                                                            (or (!= cop MI-ABI-COPY) before)))))
                                        (and (mi-op-terminator? cop)
                                             (or (not (mi-op-terminator? pop)) before)))))))
                    3
                    0))))))

(defn ms-schedule-structural-edge? [(producer i64) (consumer i64)] (-> bool)
  (if (= producer consumer)
      false
      (let [p (be-inst producer)
            c (be-inst consumer)
            pop (.op p)
            cop (.op c)
            before (< (.schedule-order p) (.schedule-order c))
            relax (load (ms-relax-effect-order))]
        (or (and before
                 (or (and (not relax) (and (> (mi-op-effects pop) 0) (= cop MI-CALL)))
                     (or (and (not relax) (and (= pop MI-CALL) (> (mi-op-effects cop) 0)))
                         (and (= pop MI-STORE) (= cop MI-STORE)))))
            (or (= pop MI-LABEL)
                (or (and (or (= pop MI-ARG) (= pop MI-STACKARG))
                         (or (and (!= cop MI-LABEL)
                                  (and (!= cop MI-ARG) (!= cop MI-STACKARG)))
                             before))
                    (or (and (= cop MI-COPY)
                             (and (not (mi-op-terminator? pop))
                                  (or (!= pop MI-COPY) before)))
                        (or (and (= pop MI-ABI-COPY)
                                 (and (!= cop MI-LABEL)
                                      (and (!= cop MI-ARG)
                                           (and (!= cop MI-STACKARG)
                                                (or (!= cop MI-ABI-COPY) before)))))
                            (and (mi-op-terminator? cop)
                                 (or (not (mi-op-terminator? pop)) before))))))))))

(defn ms-schedule-add-edge! [(first i64) (count i64) (producer i64) (consumer i64)] (-> i64)
  (if (or (= producer consumer)
          (or (< producer first) (or (>= producer (+ first count))
              (or (< consumer first) (>= consumer (+ first count))))))
      0
      (let [u (machine-unit)
            p (- producer first)
            c (- consumer first)]
        (al-set! [i64] (field u schedule-done) c
                 (+ (al-get [i64] (.schedule-done u) c) 1))
        (al-push! [i64] (field u sched-edge-consumer) c)
        (al-push! [i64] (field u sched-edge-next)
                  (al-get [i64] (.sched-edge-head u) p))
        (al-set! [i64] (field u sched-edge-head) p
                 (- (al-len [i64] (.sched-edge-consumer u)) 1))
        0)))

(defn ms-schedule-add-node-edges! [(first i64) (count i64) (consumer i64)
                                    (node i64) (anti bool)] (-> i64)
  (let [u (machine-unit)
        owner (.owner (be-inst consumer))
        nodes (n-count)
        (mut producer)
          (if (and (>= node 0) (< node nodes))
              (al-get [i64] (.node-inst-head u) (+ (* owner nodes) node))
              -1)]
    (loop (if (< (load producer) 0) (break)
              (do
                (if (and (>= (load producer) first)
                         (and (< (load producer) (+ first count))
                              (or (not anti)
                                  (ms-memory-operands-may-alias?
                                    (be-inst (load producer)) (be-inst consumer)))))
                    (ms-schedule-add-edge! first count (load producer) consumer)
                    0)
                (set! producer (al-get [i64] (.node-inst-next u) (load producer))))))
    0))

(defn ms-schedule-add-explicit-edges! [(first i64) (count i64) (consumer i64)] (-> i64)
  (let [m (be-inst consumer)
        op (.op m)
        inputs (mi-inputs op)
        (mut k) 0]
    (if (> inputs 0)
        (let [def (ms-def-inst (.a m))]
          (if (and (>= def 0)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (ms-schedule-add-edge! first count def consumer) 0)) 0)
    (if (> inputs 1)
        (let [def (ms-def-inst (.b m))]
          (if (and (>= def 0)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (ms-schedule-add-edge! first count def consumer) 0)) 0)
    (if (= op MI-CSEL)
        (let [def (ms-def-inst (.imm m))]
          (if (and (>= def 0)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (ms-schedule-add-edge! first count def consumer) 0)) 0)
    (loop (if (>= (load k) (.arg-count m)) (break)
              (do
                (let [def (ms-def-inst (ms-inst-arg consumer (load k)))]
                  (if (and (>= def 0)
                           (or (!= (ms-inst-op def) MI-COPY)
                               (< (.schedule-order (be-inst def)) (.schedule-order m))))
                      (ms-schedule-add-edge! first count def consumer) 0))
                (set! k (+ (load k) 1)))))
    (set! k 0)
    (loop (if (>= (load k) (.mem-count m)) (break)
              (do
                (let [memory (ms-inst-memory-dep-node consumer (load k))]
                  (ms-schedule-add-node-edges! first count consumer memory false)
                  (if (and (>= memory 0) (and (op-is? memory Arg [_]) (> (n-nins memory) 0)))
                      (let [ctrl (n-in memory 0)]
                        (if (and (op-is? ctrl CallEnd []) (> (n-nins ctrl) 1))
                            (ms-schedule-add-node-edges!
                              first count consumer (n-in ctrl 1) false) 0)) 0))
                (set! k (+ (load k) 1)))))
    (set! k 0)
    (loop (if (>= (load k) (.anti-count m)) (break)
              (do
                (ms-schedule-add-node-edges!
                  first count consumer (ms-inst-memory-anti-node consumer (load k)) true)
                (set! k (+ (load k) 1)))))
    0))

;; Add a transitive reduction of the block-wide structural rules. The old builder asked
;; `ms-schedule-structural-edge?` for every producer/consumer pair even though these constraints
;; are chains and barriers: argument classes lead the block, copies trail ordinary instructions,
;; terminators end it, and calls partition effect order. Keeping only the immediate chain/barrier
;; edges preserves exactly the same partial order while making construction linear in block size.
(defn ms-schedule-add-structural-edges! [(first i64) (count i64)] (-> i64)
  (let [u (machine-unit)
        end (+ first count)
        (mut at) first
        (mut label) -1
        (mut last-arg) -1
        (mut last-abi) -1
        (mut first-copy) -1
        (mut last-copy) -1
        (mut first-term) -1
        (mut last-term) -1
        (mut last-store) -1
        (mut last-call) -1]
    ;; `sched-ready` is scratch until readiness is initialized below.
    (al-clear! [i64] (field u sched-ready))
    (loop (if (>= (load at) end)
              (break)
              (do
                (let [m (be-inst (load at)) op (.op m)]
                  (if (= op MI-LABEL) (set! label (load at)) 0)
                  (if (or (= op MI-ARG) (= op MI-STACKARG))
                      (do
                        (if (>= (load last-arg) 0)
                            (ms-schedule-add-edge! first count (load last-arg) (load at)) 0)
                        (set! last-arg (load at)))
                      0)
                  (if (= op MI-ABI-COPY)
                      (do
                        (if (>= (load last-abi) 0)
                            (ms-schedule-add-edge! first count (load last-abi) (load at)) 0)
                        (set! last-abi (load at)))
                      0)
                  (if (= op MI-COPY)
                      (do
                        (if (< (load first-copy) 0) (set! first-copy (load at)) 0)
                        (if (>= (load last-copy) 0)
                            (ms-schedule-add-edge! first count (load last-copy) (load at)) 0)
                        (set! last-copy (load at)))
                      0)
                  (if (mi-op-terminator? op)
                      (do
                        (if (< (load first-term) 0) (set! first-term (load at)) 0)
                        (if (>= (load last-term) 0)
                            (ms-schedule-add-edge! first count (load last-term) (load at)) 0)
                        (set! last-term (load at)))
                      0)
                  (if (= op MI-STORE)
                      (do
                        (if (>= (load last-store) 0)
                            (ms-schedule-add-edge! first count (load last-store) (load at)) 0)
                        (set! last-store (load at)))
                      0)
                  ;; Between calls, each effect needs one edge from the preceding call. At the
                  ;; next call, each intervening effect leads into it. Earlier groups are then
                  ;; ordered transitively through the preceding call.
                  (if (= op MI-CALL)
                      (do
                        (if (>= (load last-call) 0)
                            (ms-schedule-add-edge! first count (load last-call) (load at)) 0)
                        (let [(mut i) 0]
                          (loop (if (>= (load i) (al-len [i64] (.sched-ready u)))
                                    (break)
                                    (do
                                      (ms-schedule-add-edge!
                                        first count
                                        (al-get [i64] (.sched-ready u) (load i)) (load at))
                                      (set! i (+ (load i) 1))))))
                        (al-clear! [i64] (field u sched-ready))
                        (set! last-call (load at)))
                      (if (> (mi-op-effects op) 0)
                          (do
                            (if (>= (load last-call) 0)
                                (ms-schedule-add-edge! first count (load last-call) (load at)) 0)
                            (al-push! [i64] (field u sched-ready) (load at))
                            0)
                          0)))
                (set! at (+ (load at) 1)))))
    ;; Publish each barrier with one incoming chain edge plus one edge per member on the opposite
    ;; side. Transitivity supplies the all-pairs relation expressed by the old predicate.
    (set! at first)
    (loop (if (>= (load at) end)
              (break)
              (do
                (let [op (.op (be-inst (load at)))]
                  (if (and (>= (load label) 0) (!= (load at) (load label)))
                      (ms-schedule-add-edge! first count (load label) (load at)) 0)
                  (if (and (>= (load last-arg) 0)
                           (and (!= op MI-LABEL)
                                (and (!= op MI-ARG) (!= op MI-STACKARG))))
                      (ms-schedule-add-edge! first count (load last-arg) (load at)) 0)
                  (if (and (>= (load last-abi) 0)
                           (and (!= op MI-LABEL)
                                (and (!= op MI-ARG)
                                     (and (!= op MI-STACKARG) (!= op MI-ABI-COPY)))))
                      (ms-schedule-add-edge! first count (load last-abi) (load at)) 0)
                  (if (and (>= (load first-copy) 0)
                           (and (!= op MI-COPY) (not (mi-op-terminator? op))))
                      (ms-schedule-add-edge! first count (load at) (load first-copy)) 0)
                  (if (and (>= (load first-term) 0) (not (mi-op-terminator? op)))
                      (ms-schedule-add-edge! first count (load at) (load first-term)) 0))
                (set! at (+ (load at) 1)))))
    (al-clear! [i64] (field u sched-ready))
    0))

;; Independent schedule verification asks the same direct graph questions without consulting the
;; scheduler's indegrees or edge lists.
(defn ms-schedule-node-producers-before? [(consumer i64) (node i64) (anti bool)] (-> bool)
  (let [u (machine-unit)
        c (be-inst consumer)
        owner (.owner c)
        bid (.block-id c)
        nodes (n-count)
        (mut producer)
          (if (and (>= node 0) (< node nodes))
              (al-get [i64] (.verify-node-inst-head u) (+ (* owner nodes) node))
              -1)
        (mut ok) true]
    (loop (if (or (< (load producer) 0) (not (load ok))) (break)
              (do
                (let [p (be-inst (load producer))]
                  (if (and (!= (load producer) consumer)
                           (and (= (.block-id p) bid)
                                (or (not anti) (ms-memory-operands-may-alias? p c))))
                      (if (< (load producer) consumer) 0 (set! ok false))
                      0))
                (set! producer (al-get [i64] (.verify-node-inst-next u) (load producer))))))
    (load ok)))

(defn ms-schedule-explicit-dependencies-before? [(consumer i64)] (-> bool)
  (let [m (be-inst consumer)
        op (.op m)
        inputs (mi-inputs op)
        bid (.block-id m)
        (mut k) 0
        (mut ok) true]
    (if (> inputs 0)
        (let [def (ms-def-inst (.a m))]
          (if (and (>= def 0) (= (ms-inst-block def) bid)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (if (< def consumer) 0 (set! ok false)) 0)) 0)
    (if (and (load ok) (> inputs 1))
        (let [def (ms-def-inst (.b m))]
          (if (and (>= def 0) (= (ms-inst-block def) bid)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (if (< def consumer) 0 (set! ok false)) 0)) 0)
    (if (and (load ok) (= op MI-CSEL))
        (let [def (ms-def-inst (.imm m))]
          (if (and (>= def 0) (= (ms-inst-block def) bid)
                   (or (!= (ms-inst-op def) MI-COPY)
                       (< (.schedule-order (be-inst def)) (.schedule-order m))))
              (if (< def consumer) 0 (set! ok false)) 0)) 0)
    (loop (if (or (>= (load k) (.arg-count m)) (not (load ok))) (break)
              (do
                (let [def (ms-def-inst (ms-inst-arg consumer (load k)))]
                  (if (and (>= def 0) (= (ms-inst-block def) bid)
                           (or (!= (ms-inst-op def) MI-COPY)
                               (< (.schedule-order (be-inst def)) (.schedule-order m))))
                      (if (< def consumer) 0 (set! ok false)) 0))
                (set! k (+ (load k) 1)))))
    (set! k 0)
    (loop (if (or (>= (load k) (.mem-count m)) (not (load ok))) (break)
              (do
                (let [memory (ms-inst-memory-dep-node consumer (load k))]
                  (if (not (ms-schedule-node-producers-before? consumer memory false))
                      (set! ok false) 0)
                  (if (and (load ok) (and (>= memory 0)
                           (and (op-is? memory Arg [_]) (> (n-nins memory) 0))))
                      (let [ctrl (n-in memory 0)]
                        (if (and (op-is? ctrl CallEnd []) (> (n-nins ctrl) 1))
                            (if (not (ms-schedule-node-producers-before?
                                       consumer (n-in ctrl 1) false))
                                (set! ok false) 0) 0)) 0))
                (set! k (+ (load k) 1)))))
    (set! k 0)
    (loop (if (or (>= (load k) (.anti-count m)) (not (load ok))) (break)
              (do
                (if (not (ms-schedule-node-producers-before?
                           consumer (ms-inst-memory-anti-node consumer (load k)) true))
                    (set! ok false) 0)
                (set! k (+ (load k) 1)))))
    (load ok)))

(defn ms-schedule-anti-dependencies-before? [(consumer i64)] (-> bool)
  (let [m (be-inst consumer)
        (mut k) 0
        (mut ok) true]
    (loop (if (or (>= (load k) (.anti-count m)) (not (load ok)))
              (break)
              (do
                (if (not (ms-schedule-node-producers-before?
                           consumer (ms-inst-memory-anti-node consumer (load k)) true))
                    (set! ok false) 0)
                (set! k (+ (load k) 1)))))
    (load ok)))

;; Independently verify the block-wide structural partial order in one scheduled-order scan. These
;; are the same pairwise invariants as `ms-schedule-structural-edge?`, expressed as monotone class
;; boundaries and original-order chains rather than consulting the scheduler's reduced edge set.
(defn ms-schedule-structural-valid? [(first i64) (count i64)] (-> bool)
  (let [end (+ first count)
        (mut at) first
        (mut labels) 0
        (mut seen-arg-regular) false
        (mut seen-abi-regular) false
        (mut seen-copy) false
        (mut seen-term) false
        (mut last-arg-order) -1
        (mut last-abi-order) -1
        (mut last-copy-order) -1
        (mut last-term-order) -1
        (mut last-store-order) -1
        (mut max-call-order) -1
        (mut max-effect-order) -1
        (mut ok) true]
    (loop (if (or (>= (load at) end) (not (load ok)))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (.op m)
                      order (.schedule-order m)
                      arg (or (= op MI-ARG) (= op MI-STACKARG))
                      term (mi-op-terminator? op)]
                  ;; A label leads every other instruction (and two labels would lead each other).
                  (if (= op MI-LABEL)
                      (do
                        (if (or (> (- (load at) first) 0) (> (load labels) 0))
                            (set! ok false) 0)
                        (set! labels (+ (load labels) 1)))
                      0)
                  ;; Argument and ABI-copy classes lead every later class and retain source order.
                  (if arg
                      (do
                        (if (or (load seen-arg-regular) (<= order (load last-arg-order)))
                            (set! ok false) 0)
                        (set! last-arg-order order))
                      (if (!= op MI-LABEL) (set! seen-arg-regular true) 0))
                  (if (= op MI-ABI-COPY)
                      (do
                        (if (or (load seen-abi-regular) (<= order (load last-abi-order)))
                            (set! ok false) 0)
                        (set! last-abi-order order))
                      (if (and (!= op MI-LABEL) (not arg))
                          (set! seen-abi-regular true) 0))
                  ;; All non-terminator non-copies lead the copy chain; all non-terminators lead
                  ;; the terminator chain.
                  (if (= op MI-COPY)
                      (do
                        (if (<= order (load last-copy-order)) (set! ok false) 0)
                        (set! last-copy-order order)
                        (set! seen-copy true))
                      (if (and (load seen-copy) (not term)) (set! ok false) 0))
                  (if term
                      (do
                        (if (<= order (load last-term-order)) (set! ok false) 0)
                        (set! last-term-order order)
                        (set! seen-term true))
                      (if (load seen-term) (set! ok false) 0))
                  (if (= op MI-STORE)
                      (do
                        (if (<= order (load last-store-order)) (set! ok false) 0)
                        (set! last-store-order order))
                      0)
                  ;; Calls retain source order against every effect. Non-call effects may reorder
                  ;; among themselves, so maxima encode exactly the pairs having a call endpoint.
                  (if (= op MI-CALL)
                      (do
                        (if (<= order (load max-effect-order)) (set! ok false) 0)
                        (set! max-call-order order)
                        (if (> order (load max-effect-order)) (set! max-effect-order order) 0))
                      (if (> (mi-op-effects op) 0)
                          (do
                            (if (<= order (load max-call-order)) (set! ok false) 0)
                            (if (> order (load max-effect-order))
                                (set! max-effect-order order) 0))
                          0)))
                (set! at (+ (load at) 1)))))
    (load ok)))

(defn ms-schedule-priority [(at i64)] (-> i64)
  (let [m (be-inst at)]
    ; Correctness edges decide readiness. Latency remains separately queryable target metadata;
    ; equal legal priority keeps seed 0 pressure-conservative and lets test seeds perturb ties.
    (if (mi-op-terminator? (.op m)) 0 1)))

(defn ms-schedule-tie [(at i64) (seed i64)] (-> i64)
  (if (= seed 0)
      (- 2147483647 (.schedule-order (be-inst at)))
      (if (= (& seed 1) 1)
          (.schedule-order (be-inst at))
          (& (+ (* (+ seed 1) 1103515245)
                (* (+ (.schedule-order (be-inst at)) 1) 2654435761))
             2147483647))))

(defn ms-schedule-ready-better? [(first i64) (seed i64) (left i64) (right i64)] (-> bool)
  (let [lp (ms-schedule-priority (+ first left))
        rp (ms-schedule-priority (+ first right))]
    (or (> lp rp)
        (and (= lp rp)
             (> (ms-schedule-tie (+ first left) seed)
                (ms-schedule-tie (+ first right) seed))))))

(defn ms-schedule-ready-push! [(first i64) (seed i64) (item i64)] (-> i64)
  (let [u (machine-unit)
        (mut at) (al-len [i64] (.sched-ready u))]
    (al-push! [i64] (field u sched-ready) item)
    (loop (if (<= (load at) 0) (break)
              (let [parent (/ (- (load at) 1) 2)
                    here (al-get [i64] (.sched-ready u) (load at))
                    above (al-get [i64] (.sched-ready u) parent)]
                (if (not (ms-schedule-ready-better? first seed here above))
                    (break)
                    (do
                      (al-set! [i64] (field u sched-ready) (load at) above)
                      (al-set! [i64] (field u sched-ready) parent here)
                      (set! at parent))))))
    0))

(defn ms-schedule-ready-pop! [(first i64) (seed i64)] (-> i64)
  (let [u (machine-unit)
        n (al-len [i64] (.sched-ready u))
        answer (al-get [i64] (.sched-ready u) 0)
        last (al-get [i64] (.sched-ready u) (- n 1))]
    (al-pop! [i64] (field u sched-ready))
    (if (> n 1)
        (do
          (al-set! [i64] (field u sched-ready) 0 last)
          (let [(mut at) 0]
            (loop
              (let [left (+ (* (load at) 2) 1)
                    right (+ left 1)
                    len (al-len [i64] (.sched-ready u))
                    (mut best) (load at)]
                (if (and (< left len)
                         (ms-schedule-ready-better?
                           first seed (al-get [i64] (.sched-ready u) left)
                           (al-get [i64] (.sched-ready u) (load best))))
                    (set! best left) 0)
                (if (and (< right len)
                         (ms-schedule-ready-better?
                           first seed (al-get [i64] (.sched-ready u) right)
                           (al-get [i64] (.sched-ready u) (load best))))
                    (set! best right) 0)
                (if (= (load best) (load at))
                    (break)
                    (let [a (al-get [i64] (.sched-ready u) (load at))
                          b (al-get [i64] (.sched-ready u) (load best))]
                      (al-set! [i64] (field u sched-ready) (load at) b)
                      (al-set! [i64] (field u sched-ready) (load best) a)
                      (set! at (load best)))))))
          0)
        0)
    answer))

;; Schedule one block, and if the edge set has no topological order, drop the two order-preserving
;; call/effect edges and schedule it again.
;;
;; WHY A RETRY RATHER THAN A SHARPER EDGE RULE. Kinds 1 and 2 are real dependences — a value and its
;; use, a memory order — and they cannot form a cycle. Kind 3 is different: the call/effect clauses
;; ask `before`, meaning "these two were in this order when we got here, keep them that way". When
;; the order they are preserving is the one this scheduler was called to FIX, that answer points
;; backwards along a chain of real data edges and closes a cycle.
;;
;; Concretely, from the case that motivated this: a call at instruction 17 consumed a string built
;; at instruction 37, and the effect rule added 17 -> 37 because 17 came first. The data edges ran
;; 37 -> 26 -> 23 -> 20 -> 17. Nothing can be emitted, `ms-schedule-block!` reported MSCHED-CYCLE,
;; the repair in `ms-place-selected!` gave up, and the ORIGINAL order survived to fail `ms-verify!`
;; with MSEL-DEPENDENCY. A guard against contradicting a DIRECT data edge is not enough — the cycle
;; here is five instructions long.
;;
;; Dropping the clauses is safe because they are a backstop, not the mechanism: genuine aliasing
;; between a call and an allocation is carried by the kind-2 memory edges, which are computed from
;; the node graph and are unaffected. Store/store order is left alone in both passes, and so are the
;; structural constraints (label first, terminator last, argument and ABI-copy placement).
;;
;; This is reachable whenever a call sits mid-block among floating arguments. The frontend only
;; began emitting those when JavaScript builtins moved from pure IR nodes to calls into the JSL
;; runtime library; a pure node is ordered by data dependence alone and never took this path.
(defn ms-schedule-block! [(bid i64) (seed i64)] (-> bool)
  (let [u (machine-unit)
        mark (al-len [MInst] (.schedule-work u))
        original-first (.inst-first (mu-block bid))]
    (if (ms-schedule-block-once! bid seed)
        true
        (if (!= (ms-schedule-result) MSCHED-CYCLE)
            false
            (do
              ;; Roll the work list back to what it held before the failed attempt, so the retry
              ;; republishes this block instead of appending a second copy of it.
              (loop (if (<= (al-len [MInst] (.schedule-work u)) mark)
                        (break)
                        (do (al-pop! [MInst] (field u schedule-work)) 0)))
              (set! (.schedule-result u) MSCHED-OK)
              (set! (.schedule-item u) -1)
              ;; `ms-schedule-block-once!` publishes the destination range before it knows the
              ;; attempt can finish. A cyclic attempt has therefore replaced `inst-first` with
              ;; the work-list mark. That mark is NOT a source index in `backend.ins`; retrying
              ;; through it copies an unrelated block and gives those instructions this block's
              ;; range. Restore the immutable source range along with rolling back the work list.
              (set! (.inst-first (mu-block bid)) original-first)
              (set! (ms-relax-effect-order) true)
              (let [ok (ms-schedule-block-once! bid seed)]
                (set! (ms-relax-effect-order) false)
                ok))))))

(defn ms-schedule-block-once! [(bid i64) (seed i64)] (-> bool)
  (let [u (machine-unit)
        b (mu-block bid)
        first (.inst-first b)
        count (.inst-count b)
        (mut emitted) 0]
    (al-clear! [i64] (field u schedule-done))
    (let [(mut i) 0]
      (loop (if (>= (load i) count)
                (break)
                (do
                  (al-push! [i64] (field u schedule-done) 0)
                  (set! i (+ (load i) 1))
                  0))))
    ;; Dependency kinds are invariant during this block schedule. Publish each candidate's
    ;; indegree once; the former ready check rebuilt the same answer for every candidate after
    ;; every emission, making a large straight-line block cubic. The same pair loop records the
    ;; edges themselves, so each emission below decrements along the producer's edge list
    ;; instead of re-asking the kind for every consumer.
    (al-clear! [i64] (field u sched-edge-head))
    (al-clear! [i64] (field u sched-edge-consumer))
    (al-clear! [i64] (field u sched-edge-next))
    (let [(mut i) 0]
      (loop (if (>= (load i) count)
                (break)
                (do
                  (al-push! [i64] (field u sched-edge-head) -1)
                  (set! i (+ (load i) 1))
                  0))))
    (ms-schedule-add-structural-edges! first count)
    (let [(mut consumer) 0]
      (loop (if (>= (load consumer) count)
                (break)
                (do
                  (ms-schedule-add-explicit-edges!
                    first count (+ first (load consumer)))
                  (set! consumer (+ (load consumer) 1))))))
    (al-clear! [i64] (field u sched-ready))
    (let [(mut i) 0]
      (loop (if (>= (load i) count) (break)
                (do
                  (if (= (al-get [i64] (.schedule-done u) (load i)) 0)
                      (ms-schedule-ready-push! first seed (load i)) 0)
                  (set! i (+ (load i) 1))))))
    (set! (.inst-first b) (al-len [MInst] (.schedule-work u)))
    (loop (if (>= (load emitted) count)
              (break)
              (let [choice (if (> (al-len [i64] (.sched-ready u)) 0)
                               (ms-schedule-ready-pop! first seed)
                               -1)]
                (if (< choice 0)
                    (do
                      (set! (.schedule-result u) MSCHED-CYCLE)
                      (set! (.schedule-item u) bid)
                      (break))
                    (do
                      (al-set! [i64] (field u schedule-done) choice -1)
                      (al-push! [MInst]
                                (field u schedule-work)
                                (load (be-inst (+ first choice))))
                      (let [(mut e) (al-get [i64]
                                            (.sched-edge-head u)
                                            choice)]
                        (loop (if (< (load e) 0)
                                  (break)
                                  (do
                                    (let [consumer (al-get [i64]
                                                           (.sched-edge-consumer u)
                                                           (load e))
                                          degree (al-get (.schedule-done u)
                                                         consumer)]
                                      (if (> degree 0)
                                          (do
                                            (al-set! [i64]
                                                     (field u schedule-done)
                                                     consumer
                                                     (- degree 1))
                                            (if (= degree 1)
                                                (ms-schedule-ready-push!
                                                  first seed consumer)
                                                0)
                                            0)
                                          0))
                                    (set! e
                                          (al-get [i64]
                                                  (.sched-edge-next u)
                                                  (load e)))
                                    0))))
                      (set! emitted (+ (load emitted) 1)))))))
    (= (load emitted) count)))

(defn ms-verify-schedule! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        n (be-inst-count)
        (mut bid) 0
        (mut at) 0]
    (set! (.schedule-result u) MSCHED-OK)
    (set! (.schedule-item u) -1)
    (ms-build-verifier-indices!)
    (al-clear! [i64] (field u verify-order-count))
    (loop (if (>= (load at) n) (break)
              (do (al-push! [i64] (field u verify-order-count) 0)
                  (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) n) (break)
              (do
                (let [order (.schedule-order (be-inst (load at)))]
                  (if (and (>= order 0) (< order n))
                      (al-set! [i64] (field u verify-order-count) order
                               (+ (al-get [i64] (.verify-order-count u) order) 1))
                      0))
                (set! at (+ (load at) 1)))))
    ;; Establish identity/coverage before asking semantic ordering questions so a duplicated
    ;; instruction retains the verifier's precise EXACTLY-ONCE diagnosis.
    (set! at 0)
    (loop (if (or (>= (load at) n) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (let [owner-count (al-get [i64] (.verify-membership u) (load at))
                      order (.schedule-order (be-inst (load at)))
                      order-count (if (and (>= order 0) (< order n))
                                      (al-get [i64] (.verify-order-count u) order) 0)]
                  (if (or (!= owner-count 1)
                          (or (< order 0) (or (>= order n) (!= order-count 1))))
                      (do
                        (set! (.schedule-result u) MSCHED-EXACTLY-ONCE)
                        (set! (.schedule-item u) (load at)))
                      0))
                (set! at (+ (load at) 1)))))
    (loop (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (let [b (mu-block (load bid))
                      first (.inst-first b)
                      count (.inst-count b)
                      (mut i) 0
                      (mut seen-term) false]
                  (if (or (< first 0) (> (+ first count) n))
                      (do
                        (set! (.schedule-result u) MSCHED-EXACTLY-ONCE)
                        (set! (.schedule-item u) (load bid)))
                      0)
                  (if (and (= (ms-schedule-result) MSCHED-OK)
                           (not (ms-schedule-structural-valid? first count)))
                      (do
                        (set! (.schedule-result u) MSCHED-DEPENDENCY)
                        (set! (.schedule-item u) (load bid)))
                      0)
                  (loop (if (or (>= (load i) count) (!= (ms-schedule-result) MSCHED-OK))
                            (break)
                            (do
                              (let [current (+ first (load i))
                                    m (be-inst (+ first (load i)))]
                                (if (!= (.block-id m) (load bid))
                                    (do
                                      (set! (.schedule-result u) MSCHED-EXACTLY-ONCE)
                                      (set! (.schedule-item u) current))
                                    0)
                                (if (mi-op-terminator? (.op m))
                                    (set! seen-term true)
                                    (if (load seen-term)
                                        (do
                                          (set! (.schedule-result u) MSCHED-BOUNDARY)
                                          (set! (.schedule-item u) current))
                                        0))
                                (if (and (= (ms-schedule-result) MSCHED-OK)
                                         (not (ms-memory-anti-dependencies-valid? current)))
                                    (do
                                      (set! (.schedule-result u) MSCHED-MEMORY)
                                      (set! (.schedule-item u) current))
                                    0)
                                (if (and (= (ms-schedule-result) MSCHED-OK)
                                         (not (ms-schedule-anti-dependencies-before? current)))
                                    (do
                                      (set! (.schedule-result u) MSCHED-MEMORY)
                                      (set! (.schedule-item u) current))
                                    0)
                                (if (and (= (ms-schedule-result) MSCHED-OK)
                                         (not (ms-schedule-explicit-dependencies-before? current)))
                                    (do
                                      (set! (.schedule-result u) MSCHED-DEPENDENCY)
                                      (set! (.schedule-item u) current))
                                    0)
                                0)
                              (set! i (+ (load i) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    ; Ranges must cover every instruction exactly once.
    (set! at 0)
    (loop (if (or (>= (load at) n) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (let [owner-count (al-get [i64] (.verify-membership u) (load at))
                      order (.schedule-order (be-inst (load at)))
                      order-count (if (and (>= order 0) (< order n))
                                      (al-get [i64] (.verify-order-count u) order) 0)]
                  (if (or (!= owner-count 1)
                          (or (< order 0) (or (>= order n) (!= order-count 1))))
                      (do
                        (set! (.schedule-result u) MSCHED-EXACTLY-ONCE)
                        (set! (.schedule-item u) (load at)))
                      0))
                (set! at (+ (load at) 1))
                0)))
    (= (ms-schedule-result) MSCHED-OK)))

(defn ms-corrupt-schedule-swap! [(left i64) (right i64)] (-> i64)
  (let [a (load (be-inst left))
        b (load (be-inst right))]
    (set! (be-inst left) b)
    (set! (be-inst right) a)
    0))

(defn ms-corrupt-schedule-duplicate! [(target i64) (source i64)] (-> i64)
  (set! (be-inst target) (load (be-inst source)))
  0)

(defn ms-local-schedule! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        n (be-inst-count)
        blocks (mu-block-count)
        (mut at) 0
        (mut bid) 0
        (mut max-block) 0
        (mut pairs) 0
        (mut profile-start) (ms-profile-now)]
    (set! (.schedule-result u) MSCHED-OK)
    (set! (.schedule-item u) -1)
    (set! (.schedule-seed u) seed)
    (loop (if (>= (load bid) blocks) (break)
              (do
                (let [count (mu-block-inst-count (load bid))]
                  (if (> count (load max-block)) (set! max-block count) 0)
                  (set! pairs (+ (load pairs) (* count count))))
                (set! bid (+ (load bid) 1)))))
    (fmt (stderr) "AOTK_PROFILE phase=schedule_shape insts={d} blocks={d} max_block={d} pair_queries={d}\n"
         n blocks (load max-block) (load pairs))
    (set! bid 0)
    (al-clear! [MInst] (field u schedule-work))
    (loop (if (>= (load at) n)
              (break)
              (do
                (set! (.schedule-order (be-inst (load at))) (load at))
                (set! at (+ (load at) 1))
                0)))
    ; Local scheduling must not silently become block layout. Preserve the already-published block
    ; order and change only instruction order within each range.
    (loop (if (or (>= (load bid) blocks) (!= (ms-schedule-result) MSCHED-OK))
              (break)
              (do
                (ms-schedule-block! (load bid) seed)
                (set! bid (+ (load bid) 1))
                0)))
    (set! profile-start (ms-profile-note! "schedule_build" (load profile-start)))
    (if (!= (ms-schedule-result) MSCHED-OK)
        false
        (do
          (al-clear! [MInst] (field (backend) ins))
          (let [count (al-len [MInst] (.schedule-work u))
                (mut i) 0]
            (loop (if (>= (load i) count)
                      (break)
                      (do
                        (al-push! [MInst]
                                  (field (backend) ins)
                                  (al-get (.schedule-work u) (load i)))
                        (set! i (+ (load i) 1))
                        0))))
          ;; `schedule-order` is what `before` reads, and until here it still describes the order
          ;; this pass was called to CHANGE. Verifying against it asks the new schedule to preserve
          ;; the relative order of the very instructions that were just moved, which the block that
          ;; retried without the call/effect edges has deliberately not done — MSCHED-DEPENDENCY on
          ;; an edge that exists only because the stale order says it should.
          ;;
          ;; Refreshing makes the order-preserving edges describe the schedule that actually exists.
          ;; They carry no independent correctness: what must not be reordered across a call is held
          ;; by the kind-2 memory edges, which come from the node graph and do not consult `before`.
          (let [total (be-inst-count) (mut k) 0]
            (loop (if (>= (load k) total)
                      (break)
                      (do (set! (.schedule-order (be-inst (load k))) (load k))
                          (set! k (+ (load k) 1))
                          0))))
          (ms-cache-def-insts!)
          (let [ok (if (be-verification?) (ms-verify-schedule!) true)]
            (ms-profile-note! "schedule_verify" (load profile-start))
            ok)))))

;; Selection emits a dependency-topological order. This explicit scheduler computes live intervals
;; and is the hook where M10's global code motion adds block placement for control graphs.
