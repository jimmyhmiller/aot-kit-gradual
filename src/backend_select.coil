                              (ms-jsstring! owner
                                            bid
                                            node
                                            value
                                            (ms-immediate! owner bid 0)
                                            (ms-immediate! owner bid 0)
                                            JSSOP-LOWER))
                      0)))
            (StringUpper [] (let [value (ms-select-value-at! owner (n-in node 1) bid)]
                  (if (>= value 0)
                      (store! vr
                              (ms-jsstring! owner
                                            bid
                                            node
                                            value
                                            (ms-immediate! owner bid 0)
                                            (ms-immediate! owner bid 0)
                                            JSSOP-UPPER))
                      0)))
            (StringIndexOf [] (let [value (ms-select-value-at! owner (n-in node 1) bid)
                      needle (ms-select-value-at! owner (n-in node 2) bid)
                      start (ms-select-value-at! owner (n-in node 3) bid)]
                  (if (or (< value 0) (or (< needle 0) (< start 0)))
                      0
                      (store! vr (ms-jsstring! owner bid node value needle start JSSOP-INDEX-OF)))))
            (StringCompare [] (let [left (ms-select-value-at! owner (n-in node 1) bid)
                      right (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< left 0) (< right 0))
                      0
                      (store! vr
                              (ms-jsstring! owner bid node left right
                                            (ms-immediate! owner bid 0) JSSOP-COMPARE)))))
            (StringNormalize [] (let [string (ms-select-value-at! owner (n-in node 1) bid)
                      form (ms-select-value-at! owner (n-in node 2) bid)]
                  (if (or (< string 0) (< form 0))
                      0
                      (store! vr
