            (Add [] (store! vr (ms-select-numeric-binary! owner node MI-ADD bid)))
            (Sub [] (store! vr (ms-select-numeric-binary! owner node MI-SUB bid)))
            (Mul [] (store! vr (ms-select-numeric-binary! owner node MI-MUL bid)))
            (Div [] (store! vr (ms-select-numeric-binary! owner node MI-SDIV bid)))
