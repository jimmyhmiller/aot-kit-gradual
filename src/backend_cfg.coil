;; Structural machine CFG construction, dominance, loop depth, and verification.
(module backend_cfg)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(defn be-has-input? [(n i64) (want i64)] (-> bool)
  (let [len (n-nins n)
        (mut i) 0
        (mut yes) false]
    (loop (if (or (>= (load i) len) (load yes))
              (break)
              (do
                (if (= (n-in n (load i)) want) (set! yes true) 0)
                (set! i (+ (load i) 1))
                0)))
    (load yes)))

(defn be-cfg-control? [(op Op)] (-> bool)
  (match op
    (If [] true) (Return [] true) (Loop [] true) (Region [] true)
    (CProj [_] true) (CallEnd [] true) (_ false)))

(defn be-ctrl-succ [(ctrl i64)] (-> i64)
  (let [len (n-nouts ctrl)
        (mut i) 0
        (mut found) NO-NODE
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out ctrl (load i))]
                  (if (and (not (n-dead? u))
                           (and (be-cfg-control? (n-op u)) (> (n-nins u) 0)))
                      (if (be-has-input? u ctrl)
                          (do (set! found u) (set! count (+ (load count) 1)) 0)
                          0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (= (load count) 1) (load found) NO-NODE)))

(defn be-if-arm [(iff i64) (slot i64)] (-> i64)
  (let [len (n-nouts iff)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out iff (load i))]
                  (if (and (not (n-dead? u))
                           (match (n-op u) (CProj [label] (= label slot)) (_ false)))
                      (set! found u)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load found)))

; ---------------------------------------------------------------------------
; G1 structural machine CFG. This pass only reads the ideal graph. Selection remains separate
; until G2, so building or verifying this table cannot perturb optimizer or legacy backend state.
; ---------------------------------------------------------------------------

(defn mu-target-slot [(target i64) (incoming i64)] (-> i64)
  (if (or (op-is? target Region []) (op-is? target Loop []))
      (let [len (n-nins target)
            (mut i) 1
            (mut found) -1]
        (loop (if (or (>= (load i) len) (>= (load found) 0))
                  (break)
                  (do
                    (if (= (n-in target (load i)) incoming) (set! found (load i)) 0)
                    (set! i (+ (load i) 1))
                    0)))
        (load found))
      0))

(defn mu-add-edge! [(owner i64) (source i64) (target i64) (slot i64)] (-> i64)
  (let [u (machine-unit)
        len (mu-edge-count)
        (mut i) 0
        (mut prior) -1]
    (loop (if (or (>= (load i) len) (>= (load prior) 0))
              (break)
              (do
                (let [e (mu-edge (load i))]
                  (if (and (= (.source e) source)
                           (and (= (.target e) target)
                                (= (.target-slot e) slot)))
                      (set! prior (load i))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (>= (load prior) 0)
        (load prior)
        (do (al-push! [MEdge] (field u edges) (me-new len owner source target slot)) len))))

(defn mu-note-return! [(owner i64) (ret i64)] (-> i64)
  (let [u (machine-unit)
        f (mu-function owner)]
    (if (< (.return-first f) 0)
        (set! (.return-first f) (al-len [i64] (.returns u)))
        0)
    (al-push! [i64]
              (field u returns)
              (al-get (.ctrl-block u) ret))
    (set! (.return-count f) (+ (.return-count f) 1))
    0))

(defn mu-walk-block! [(owner i64) (head i64)] (-> i64)
  (let [u (machine-unit)
        known (al-get (.ctrl-block u) head)]
    (if (>= known 0)
        known
        (let [bid (mu-block-count)
              (mut ctrl) head
              (mut done) false]
          (al-push! [MBlock] (field u blocks) (mb-new bid owner head))
          (loop (if (load done)
                    (break)
                    (let [mapped (al-get (.ctrl-block u) (load ctrl))]
                      (if (and (>= mapped 0) (!= mapped bid))
                          (do
                            (mu-add-edge! owner bid mapped 0)
                            (set! done true))
                          (do
                            (al-set! [i64] (field u ctrl-block) (load ctrl) bid)
                            (match (n-op (load ctrl))
                              (Return [] (do (mu-note-return! owner (load ctrl)) (set! done true)))
                              (If [] (let [a (be-if-arm (load ctrl) 0)
                                        b (be-if-arm (load ctrl) 1)]
                                    (if (!= a NO-NODE)
                                        (do
                                          (mu-walk-block! owner a)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (.ctrl-block u) a)
                                                        0)
                                          0)
                                        0)
                                    (if (!= b NO-NODE)
                                        (do
                                          (mu-walk-block! owner b)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (.ctrl-block u) b)
                                                        0)
                                          0)
                                        0)
                                    (set! done true)))
                              (_ (let [next (be-ctrl-succ (load ctrl))]
                                      (if (= next NO-NODE)
                                          (set! done true)
                                          (if (or (op-is? next Region [])
                                                  (or (op-is? next Loop []) (op-is? next CProj [_])))
                                              (do
                                                (mu-walk-block! owner next)
                                                (mu-add-edge! owner
                                                              bid
                                                              (al-get (.ctrl-block u) next)
                                                              (mu-target-slot next (load ctrl)))
                                                (set! done true))
                                              (set! ctrl next))))))))))
            bid)))))

(defn mu-build-function! [(ideal i64) (entry i64)] (-> i64)
  (let [u (machine-unit)
        id (mu-function-count)
        first (mu-block-count)]
    (al-push! [MFunction] (field u functions) (mf-new id ideal entry))
    (al-push! [i64]
              (field u symbols)
              (if (= ideal NO-NODE)
                  -1
                  (match (n-op ideal) (Fun [index] index) (Start [] 0)
                    (_ (do (panic-corrupt "machine function root must be Start or Fun") 0)))))
    (mu-walk-block! id entry)
    (let [f (mu-function id)]
      (set! (.block-first f) first)
      (set! (.block-count f) (- (mu-block-count) first)))
    id))

(defn mu-find-function [(ideal i64)] (-> i64)
  (let [n (mu-function-count)
        (mut i) 0
        (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (= (mu-function-ideal (load i)) ideal) (set! found (load i)) 0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

(defn mu-find-function-symbol [(symbol i64)] (-> i64)
  (let [(mut owner) 0
        (mut found) -1]
    (loop (if (or (>= (load owner) (mu-function-count)) (>= (load found) 0))
              (break)
              (do
                (if (= (al-get (.symbols (machine-unit)) (load owner)) symbol)
                    (set! found (load owner))
                    0)
                (set! owner (+ (load owner) 1)))))
    (load found)))

(defn mu-direct-callee [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (match (n-op callee)
      (Fun [index] callee)
      (Closure [captures] (n-in callee 0))
      (_ (let [fidx (ty-fun-singleton (n-ty callee))]
           (if (< fidx 0) NO-NODE (n-find-fun-index fidx)))))))

(defn mu-build-call-targets! [(call i64)] (-> i64)
  (let [direct (mu-direct-callee call)
        targets (ty-fun-targets (n-ty (n-in call 1)))
        (mut fidx) 0]
    (if (!= direct NO-NODE) (mu-build-reachable-function! direct) 0)
    (loop (if (>= (load fidx) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load fidx))) 0)
                    (let [fun (n-find-fun-index (load fidx))]
                      (if (!= fun NO-NODE) (mu-build-reachable-function! fun) 0))
                    0)
                (set! fidx (+ (load fidx) 1)))))
    0))

(defn mu-build-reachable-function! [(ideal i64)] (-> i64)
  (let [prior (mu-find-function ideal)]
    (if (>= prior 0)
        prior
        (let [owner (mu-build-function! ideal (n-fun-entry ideal))
              lim (n-count)
              (mut i) 0]
          ; Function ownership is already recorded on every reachable control in this function.
          ; A call belongs here exactly when its control maps to one of those blocks.
          (loop (if (>= (load i) lim)
                    (break)
                    (do
                      (if (and (not (n-dead? (load i))) (op-is? (load i) Call [_]))
                          (let [ctrl (n-in (load i) 0)
                                bid
                                  (if (= ctrl NO-NODE)
                                      -1
                                      (al-get (.ctrl-block (machine-unit)) ctrl))]
                            (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                                (mu-build-call-targets! (load i))
                                0))
                          0)
                      (set! i (+ (load i) 1))
                      0)))
          owner))))

(defn mu-finalize-adjacency! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut b) 0]
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (loop (if (>= (load b) blocks)
              (break)
              (do
                (let [block (mu-block (load b))
                      (mut e) 0]
                  (set! (.pred-first block) (al-len [i64] (.pred-edges u)))
                  (set! (.pred-count block) 0)
                  (set! (.succ-first block) (al-len [i64] (.succ-edges u)))
                  (set! (.succ-count block) 0)
                  (loop (if (>= (load e) edges)
                            (break)
                            (do
                              (if (= (mu-edge-target (load e)) (load b))
                                  (do
                                    (al-push! [i64] (field u pred-edges) (load e))
                                    (set! (.pred-count block) (+ (.pred-count block) 1)))
                                  0)
                              (if (= (mu-edge-source (load e)) (load b))
                                  (do
                                    (al-push! [i64] (field u succ-edges) (load e))
                                    (set! (.succ-count block) (+ (.succ-count block) 1)))
                                  0)
                              (set! e (+ (load e) 1))
                              0))))
                (set! b (+ (load b) 1))
                0)))
    0))

(defn mu-rpo-visit! [(owner i64) (bid i64)] (-> i64)
  (let [u (machine-unit)]
    (if (!= (al-get (.rpo-seen u) bid) 0)
        0
        (do
          (al-set! [i64] (field u rpo-seen) bid 1)
          (let [edges (mu-edge-count)
                (mut i) 0]
            (loop (if (>= (load i) edges)
                      (break)
                      (do
                        (let [e (mu-edge (load i))]
                          (if (and (= (.owner e) owner)
                                   (= (.source e) bid))
                              (mu-rpo-visit! owner (.target e))
                              0))
                        (set! i (+ (load i) 1))
                        0))))
          (al-push! [i64] (field u rpo-post) bid)
          0))))

(defn mu-compute-rpo! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-order))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (al-clear! [i64] (field u rpo-seen))
                (al-clear! [i64] (field u rpo-post))
                (let [(mut i) 0]
                  (loop (if (>= (load i) blocks)
                            (break)
                            (do
                              (al-push! [i64] (field u rpo-seen) 0)
                              (set! i (+ (load i) 1))
                              0))))
                (let [funrec (mu-function (load fidx))
                      entry (.entry funrec)
                      entry-block (al-get (.ctrl-block u) entry)
                      first (al-len [i64] (.block-order u))]
                  (if (< entry-block 0)
                      (set! ok false)
                      (mu-rpo-visit! (load fidx) entry-block))
                  (let [n (al-len [i64] (.rpo-post u))
                        (mut i) n]
                    (loop (if (<= (load i) 0)
                              (break)
                              (do
                                (set! i (- (load i) 1))
                                (let [bid (al-get (.rpo-post u) (load i))
                                      layout (- n (+ (load i) 1))]
                                  (al-push! [i64] (field u block-order) bid)
                                  (set! (.layout-index (mu-block bid)) layout))
                                0)))
                    (set! (.block-first funrec) first)
                    (set! (.block-count funrec) n)))
                (set! fidx (+ (load fidx) 1))
                0)))
    ; Every built block must be reachable from its declared function entry.
    (and (load ok) (= (al-len [i64] (.block-order u)) blocks))))

(defn mu-idom-intersect [(left i64) (right i64)] (-> i64)
  (let [(mut a) left
        (mut b) right]
    (loop (if (= (load a) (load b))
              (break)
              (do
                (loop (if (<= (mu-block-layout-index (load a))
                              (mu-block-layout-index (load b)))
                          (break)
                          (set! a (mu-block-idom (load a)))))
                (loop (if (<= (mu-block-layout-index (load b))
                              (mu-block-layout-index (load a)))
                          (break)
                          (set! b (mu-block-idom (load b)))))
                0)))
    (load a)))

(defn mu-compute-idoms! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut i) 0
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-idom))
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (al-push! [i64] (field u block-idom) -1)
                (set! i (+ (load i) 1))
                0)))
    (loop (if (or (>= (load fidx) funcs) (not (load ok)))
              (break)
              (let [count (mu-function-block-count (load fidx))
                    entry (mu-function-block (load fidx) 0)
                    (mut changed) true
                    (mut rounds) 0]
                (al-set! [i64] (field u block-idom) entry entry)
                (loop (if (or (not (load changed)) (> (load rounds) (+ count 1)))
                          (break)
                          (do
                            (set! changed false)
                            (set! i 1)
                            (loop (if (>= (load i) count)
                                      (break)
                                      (do
                                        (let [bid (mu-function-block (load fidx) (load i))
                                              block (mu-block bid)
                                              (mut p) 0
                                              (mut next) -1]
                                          (loop (if (>= (load p) (.pred-count block))
                                                    (break)
                                                    (do
                                                      (let [eid
                                                              (al-get (.pred-edges u)
                                                                      (+ (.pred-first block) (load p)))
                                                            pred (mu-edge-source eid)]
                                                        (if (>= (mu-block-idom pred) 0)
                                                            (if (< (load next) 0)
                                                                (set! next pred)
                                                                (set! next (mu-idom-intersect pred (load next))))
                                                            0))
                                                      (set! p (+ (load p) 1))
                                                      0)))
                                          (if (and (>= (load next) 0) (!= (mu-block-idom bid) (load next)))
                                              (do
                                                (al-set! [i64] (field u block-idom) bid (load next))
                                                (set! changed true))
                                              0))
                                        (set! i (+ (load i) 1))
                                        0)))
                            (set! rounds (+ (load rounds) 1))
                            0)))
                (set! i 0)
                (loop (if (>= (load i) count)
                          (break)
                          (do
                            (if (< (mu-block-idom (mu-function-block (load fidx) (load i))) 0)
                                (set! ok false)
                                0)
                            (set! i (+ (load i) 1))
                            0)))
                (set! fidx (+ (load fidx) 1))
                0)))
    (load ok)))

(defn mu-dominates? [(ancestor i64) (descendant i64)] (-> bool)
  (if (!= (mu-block-owner ancestor) (mu-block-owner descendant))
      false
      (let [(mut cursor) descendant]
        (loop (if (or (= (load cursor) ancestor)
                      (= (mu-block-idom (load cursor)) (load cursor)))
                  (break)
                  (set! cursor (mu-block-idom (load cursor)))))
        (= (load cursor) ancestor))))

(defn mu-compute-loop-depth! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (set! (.loop-depth (mu-block (load i))) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) edges)
              (break)
              (do
                (let [back (mu-edge (load i))
                      header (.target back)
                      source (.source back)
                      slot (.target-slot back)]
                  (if (and (= slot 2) (op-is? (mu-block-control header) Loop []))
                      (do
                        (al-clear! [i64] (field u rpo-seen))
                        (al-clear! [i64] (field u rpo-post))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (al-push! [i64] (field u rpo-seen) 0)
                                      (set! b (+ (load b) 1))
                                      0))))
                        (al-set! [i64] (field u rpo-seen) header 1)
                        (if (= source header)
                            0
                            (do
                              (al-set! [i64] (field u rpo-seen) source 1)
                              (al-push! [i64] (field u rpo-post) source)))
                        (loop (let [n (al-len [i64] (.rpo-post u))]
                                (if (= n 0)
                                    (break)
                                    (let [current (al-get (.rpo-post u) (- n 1))
                                          (mut eid) 0]
                                      (al-pop! [i64] (field u rpo-post))
                                      (loop (if (>= (load eid) edges)
                                                (break)
                                                (do
                                                  (let [pred-edge (mu-edge (load eid))]
                                                    (if (and (= (.target pred-edge) current)
                                                             (= (.owner pred-edge)
                                                                (.owner back)))
                                                        (let [pred (.source pred-edge)]
                                                          (if (= (al-get (.rpo-seen u) pred) 0)
                                                              (do
                                                                (al-set! [i64] (field u rpo-seen) pred 1)
                                                                (if (= pred header)
                                                                    0
                                                                    (al-push! [i64] (field u rpo-post) pred)))
                                                              0))
                                                        0))
                                                  (set! eid (+ (load eid) 1))
                                                  0)))))))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (if (!= (al-get (.rpo-seen u) (load b)) 0)
                                          (set! (.loop-depth (mu-block (load b)))
                                                (+ (.loop-depth (mu-block (load b))) 1))
                                          0)
                                      (set! b (+ (load b) 1))
                                      0))))
                        0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn mu-fail-verify! [(code i64) (item i64)] (-> bool)
  (let [u (machine-unit)]
    (set! (.verify-result u) code)
    (set! (.verify-item u) item)
    false))

(defn mu-adj-count [(edge i64) (pred bool)] (-> i64)
  (let [u (machine-unit)
        len
          (if pred
              (al-len [i64] (.pred-edges u))
              (al-len [i64] (.succ-edges u)))
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (if (= (if pred
                           (al-get (.pred-edges u) (load i))
                           (al-get (.succ-edges u) (load i)))
                       edge)
                    (set! count (+ (load count) 1))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load count)))

(defn mu-block-adj-valid? [(bid i64) (pred bool)] (-> bool)
  (let [u (machine-unit)
        b (mu-block bid)
        first (if pred (.pred-first b) (.succ-first b))
        count (if pred (.pred-count b) (.succ-count b))
        list-len
          (if pred
              (al-len [i64] (.pred-edges u))
              (al-len [i64] (.succ-edges u)))
        (mut i) 0
        (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) list-len)))
        false
        (do
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [eid
                              (if pred
                                  (al-get (.pred-edges u) (+ first (load i)))
                                  (al-get (.succ-edges u) (+ first (load i))))]
                        (if (or (< eid 0) (>= eid (mu-edge-count)))
                            (set! ok false)
                            (if (!= (if pred (mu-edge-target eid) (mu-edge-source eid)) bid)
                                (set! ok false)
                                0)))
                      (set! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn mu-slot-valid? [(eid i64)] (-> bool)
  (let [u (machine-unit)
        e (mu-edge eid)
        s (.source e)
        t (.target e)
        slot (.target-slot e)
        target (mu-block-control t)]
    (if (or (op-is? target Region []) (op-is? target Loop []))
        (if (or (<= slot 0) (or (>= slot (n-nins target)) (= (n-in target slot) NO-NODE)))
            false
            (let [incoming (n-in target slot)
                  mapped (al-get (.ctrl-block u) incoming)
                  edges (mu-edge-count)
                  (mut i) 0
                  (mut same) 0]
              (loop (if (>= (load i) edges)
                        (break)
                        (do
                          (let [other (mu-edge (load i))]
                            (if (and (= (.target other) t)
                                     (= (.target-slot other) slot))
                                (set! same (+ (load same) 1))
                                0))
                          (set! i (+ (load i) 1))
                          0)))
              (and (= mapped s) (= (load same) 1))))
        (= slot 0))))

(defn mu-block-terminator-op [(bid i64)] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut op) NO-NODE]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (= (al-get (.ctrl-block (machine-unit)) (load i)) bid)
                    (let [candidate (load i)]
                      (if (or (op-is? candidate If []) (op-is? candidate Return []))
                          (set! op candidate)
                          0))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load op)))

(defn mu-block-terminator [(bid i64)] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (= (al-get (.ctrl-block (machine-unit)) (load i)) bid)
                    (let [candidate (load i)]
                      (if (or (op-is? candidate If []) (op-is? candidate Return []))
                          (set! found (load i))
                          0))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

(defn mu-verify-terminators! [] (-> bool)
  (let [blocks (mu-block-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [term (mu-block-terminator-op (load i))
                      succ (.succ-count (mu-block (load i)))]
                  (if (or (and (!= term NO-NODE) (and (op-is? term If []) (!= succ 2)))
                          (and (!= term NO-NODE) (and (op-is? term Return []) (!= succ 0))))
                      (do
                        (fmt (stderr) "machine-cfg: terminator arity block={d} head={d} term={d} succ={d}\n"
                             (load i) (.ideal-ctrl (mu-block (load i))) term succ)
                        (mu-fail-verify! MCFG-TERMINATOR-ARITY (load i))
                        (break))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-rpo! [] (-> bool)
  (let [u (machine-unit)
        funcs (mu-function-count)
        blocks (mu-block-count)
        (mut fidx) 0]
    (al-clear! [i64] (field u rpo-seen))
    (let [(mut i) 0]
      (loop (if (>= (load i) blocks)
                (break)
                (do
                  (al-push! [i64] (field u rpo-seen) 0)
                  (set! i (+ (load i) 1))
                  0))))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      n (.block-count f)
                      (mut pos) 0]
                  (let [entry-block (al-get (.ctrl-block u) (.entry f))]
                    (if (or (= n 0) (!= (mu-function-block (load fidx) 0) entry-block))
                        (do (mu-fail-verify! MCFG-RPO (load fidx)) 0)
                        0))
                  (loop (if (or (>= (load pos) n) (!= (mu-verify-result) MCFG-OK))
                            (break)
                            (do
                              (let [bid (mu-function-block (load fidx) (load pos))]
                                (if (or (< bid 0)
                                        (or (>= bid blocks)
                                            (or (!= (mu-block-owner bid) (load fidx))
                                                (or (!= (mu-block-layout-index bid) (load pos))
                                                    (!= (al-get (.rpo-seen u) bid) 0)))))
                                    (do (mu-fail-verify! MCFG-RPO bid) (break))
                                    (al-set! [i64] (field u rpo-seen) bid 1)))
                              (set! pos (+ (load pos) 1))
                              0))))
                (if (!= (mu-verify-result) MCFG-OK) (break) 0)
                (set! fidx (+ (load fidx) 1))
                0)))
    (if (= (mu-verify-result) MCFG-OK)
        (let [(mut i) 0]
          (loop (if (>= (load i) blocks)
                    (break)
                    (do
                      (if (= (al-get (.rpo-seen u) (load i)) 0)
                          (do (mu-fail-verify! MCFG-RPO (load i)) (break))
                          0)
                      (set! i (+ (load i) 1))
                      0))))
        0)
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-idoms! [] (-> bool)
  (let [blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0]
    (loop (if (or (>= (load fidx) funcs) (!= (mu-verify-result) MCFG-OK))
              (break)
              (do
                (let [count (mu-function-block-count (load fidx))
                      entry (mu-function-block (load fidx) 0)
                      (mut i) 0]
                  (if (!= (mu-block-idom entry) entry)
                      (do (mu-fail-verify! MCFG-IDOM entry) 0)
                      0)
                  (set! i 1)
                  (loop (if (or (>= (load i) count) (!= (mu-verify-result) MCFG-OK))
                            (break)
                            (do
                              (let [bid (mu-function-block (load fidx) (load i))
                                    parent (mu-block-idom bid)]
                                (if (or (< parent 0)
                                        (or (>= parent blocks)
                                            (or (!= (mu-block-owner parent) (load fidx))
                                                (>= (mu-block-layout-index parent)
                                                    (mu-block-layout-index bid)))))
                                    (do (mu-fail-verify! MCFG-IDOM bid) 0)
                                    0))
                              (set! i (+ (load i) 1))
                              0))))
                (set! fidx (+ (load fidx) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        funcs (mu-function-count)
        (mut i) 0]
    (set! (.verify-result u) MCFG-OK)
    (set! (.verify-item u) -1)
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [b (mu-block (load i))
                      owner (.owner b)]
                  (if (or (!= (.id b) (load i))
                          (or (< owner 0) (>= owner funcs)))
                      (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                      (if (or (not (mu-block-adj-valid? (load i) true))
                              (not (mu-block-adj-valid? (load i) false)))
                          (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                          0)))
                (set! i (+ (load i) 1))
                0)))
    (if (!= (mu-verify-result) MCFG-OK)
        false
        (do
          (set! i 0)
          (loop (if (>= (load i) edges)
                    (break)
                    (do
                      (let [e (mu-edge (load i))
                            s (.source e)
                            t (.target e)
                            owner (.owner e)
                            slot (.target-slot e)]
                        (if (or (< s 0) (or (>= s blocks) (or (< t 0) (>= t blocks))))
                            (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                            (if (or (!= owner (mu-block-owner s)) (!= owner (mu-block-owner t)))
                                (do (mu-fail-verify! MCFG-FUNCTION-ISOLATION (load i)) (break))
                                (if (or (!= (mu-adj-count (load i) false) 1)
                                        (!= (mu-adj-count (load i) true) 1))
                                    (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                                    (if (not (mu-slot-valid? (load i)))
                                        (do (mu-fail-verify! MCFG-PREDECESSOR-SLOT (load i)) (break))
                                        0)))))
                      (set! i (+ (load i) 1))
                      0)))
          (if (!= (mu-verify-result) MCFG-OK)
              false
              (if (not (mu-verify-terminators!))
                  false
                  (if (not (mu-verify-rpo!))
                      false
                      (mu-verify-idoms!))))))))

; Test-only corruption hooks are explicit and narrow; production callers only build and verify.
(defn mu-corrupt-block-owner! [(bid i64) (new-owner i64)] (-> i64)
  (set! (.owner (mu-block bid)) new-owner)
  0)
(defn mu-corrupt-edge-target-slot! [(eid i64) (slot i64)] (-> i64)
  (set! (.target-slot (mu-edge eid)) slot)
  0)
(defn mu-corrupt-drop-last-pred! [] (-> i64)
  (let [u (machine-unit)
        n (al-len [i64] (.pred-edges u))]
    (if (> n 0) (set! (.len (.pred-edges u)) (- n 1)) 0)
    0))
(defn mu-corrupt-layout! [(bid i64) (layout i64)] (-> i64)
  (set! (.layout-index (mu-block bid)) layout)
  0)
(defn mu-corrupt-idom! [(bid i64) (parent i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) block-idom) bid parent)
  0)
(defn mu-corrupt-add-return-successor! [(bid i64)] (-> i64)
  (let [owner (mu-block-owner bid)]
    (al-push! [MEdge]
              (field (machine-unit) edges)
              (me-new (mu-edge-count) owner bid bid 0))
    (mu-finalize-adjacency!)
    0))
(defn mu-corrupt-edge-target! [(eid i64) (target i64)] (-> i64)
  (set! (.target (mu-edge eid)) target)
  (mu-finalize-adjacency!)
  0)

(defn mu-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        edges (mu-edge-count)
        (mut fidx) 0]
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      ideal (.ideal f)
                      nblocks (.block-count f)]
                  (fmt w "function {d} ideal {d} blocks {d}\n" (load fidx) ideal nblocks)
                  (let [(mut rpo) 0]
                    (loop (if (>= (load rpo) nblocks)
                              (break)
                              (do
                                (let [bid (mu-function-block (load fidx) (load rpo))
                                      ctrl (mu-block-control bid)]
                                  (fmt w "  b{d} {s}" (load rpo) (op-name (n-op ctrl)))
                                  ; Dump successors in target-layout order, independent of discovery order.
                                  (let [(mut target-layout) 0]
                                    (loop (if (>= (load target-layout) nblocks)
                                              (break)
                                              (do
                                                (let [(mut eid) 0]
                                                  (loop (if (>= (load eid) edges)
                                                            (break)
                                                            (do
                                                              (let [e (mu-edge (load eid))
                                                                    target (mu-edge-target (load eid))]
                                                                (if (and (= (mu-edge-source (load eid)) bid)
                                                                         (and (= (mu-block-owner target) (load fidx))
                                                                              (= (mu-block-layout-index target)
                                                                                 (load target-layout))))
                                                                    (do
                                                                      (fmt w
                                                                           " ->b{d}[{d}]"
                                                                           (load target-layout)
                                                                           (mu-edge-target-slot (load eid)))
                                                                      0)
                                                                    0))
                                                              (set! eid (+ (load eid) 1))
                                                              0))))
                                                (set! target-layout (+ (load target-layout) 1))
                                                0))))
                                  (ps w "\n"))
                                (set! rpo (+ (load rpo) 1))
                                0)))))
                (set! fidx (+ (load fidx) 1))
                0)))
    0))

(defn mu-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (mu-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "mu-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn mu-finish-build! [] (-> bool)
  (mu-finalize-adjacency!)
  (set! (.phase (machine-unit)) 1)
  (if (mu-compute-rpo!)
      (if (mu-compute-idoms!)
          (do (mu-compute-loop-depth!) (mu-verify!))
          (mu-fail-verify! MCFG-RPO -1))
      (mu-fail-verify! MCFG-RPO -1)))

(defn mu-build-entry! [(entry-fun i64)] (-> bool)
  (mu-reset!)
  (if (or (!= (g-verify) 0) (op-is? entry-fun FunStart []))
      false
      (if (not (op-is? entry-fun Fun [_]))
          false
          (do
            (mu-build-reachable-function! entry-fun)
            (mu-finish-build!)))))

(defn mu-build-program! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0)
      false
      (let [owner (mu-build-function! NO-NODE (g-start))
            lim (n-count)
            (mut i) 0]
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (op-is? (load i) Call [_]))
                        (let [ctrl (n-in (load i) 0)
                              bid
                                (if (= ctrl NO-NODE)
                                    -1
                                    (al-get (.ctrl-block (machine-unit)) ctrl))]
                          (if (and (>= bid 0) (= (mu-block-owner bid) owner))
                              (mu-build-call-targets! (load i))
                              0))
                        0)
                    (set! i (+ (load i) 1))
                    0)))
        ;; Closed-world dispatch reaches every live function: a callable whose identity escapes
        ;; only as a VALUE (a callback stored through a dynamic method call) has no direct call
        ;; edge, but the universal dispatcher can still land on it, so it must be in the unit.
        (set! i 0)
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (op-is? (load i) Fun [_]))
                        (do (mu-build-reachable-function! (load i)) 0)
                        0)
                    (set! i (+ (load i) 1))
                    0)))
        (mu-finish-build!))))

(defn mu-build! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0)
      false
      (let [lim (n-count)
            (mut i) 0
            (mut found) false]
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (op-is? (load i) Fun [_]))
                        (do
                          (mu-build-function! (load i) (n-fun-entry (load i)))
                          (set! found true))
                        0)
                    (set! i (+ (load i) 1))
                    0)))
        ; A graph without explicit Fun nodes is one synthetic top-level machine function.
        (if (not (load found)) (mu-build-function! NO-NODE (g-start)) 0)
        (mu-finish-build!))))
