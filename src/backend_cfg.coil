;; Structural machine CFG construction, dominance, loop depth, and verification.
(module backend_cfg)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "monotonic" :as monotonic)

(defn mu-profile-now [] (-> i64)
  (monotonic/monotonic-now-ns))
(defn mu-edge-probes-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn mu-function-build-ns-cell [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn be-has-input? [(n i64) (want i64)] (-> bool)
  (let [len (n-nins n)
        (mut i) 0
        (mut yes) false]
    (loop (if (or (>= (load i) len) (load yes))
              (break)
              (do
                (if (= (n-in n (load i)) want) (set! yes true) 0)
                (set! i (+ (load i) 1))
                0)))
    (load yes)))

(defn be-cfg-control? [(op Op)] (-> bool)
  (match op
    (If [] true) (Return [] true) (Loop [] true) (Region [] true)
    (CProj [_] true) (CallEnd [] true) (_ false)))

(defn be-if-has-machine-continuation? [(iff i64)] (-> bool)
  (let [input (n-in iff 0)
        (mut out) 0
        (mut found) false]
    (loop (if (or (>= (load out) (n-nouts iff)) (load found))
              (break)
              (do
                (let [projection (n-out iff (load out))
                      (mut use) 0]
                  (if (and (not (n-dead? projection)) (op-is? projection CProj [_]))
                      (loop (if (or (>= (load use) (n-nouts projection)) (load found))
                                (break)
                                (do
                                  (let [next (n-out projection (load use))]
                                    (if (and (not (n-dead? next))
                                             (and (be-cfg-control? (n-op next))
                                                  (be-has-input? next projection)))
                                        (set! found true)
                                        0))
                                  (set! use (+ (load use) 1)))))
                      0))
                (set! out (+ (load out) 1)))))
    (set! out 0)
    (loop (if (or (>= (load out) (n-nouts input)) (load found))
              (break)
              (do
                (let [next (n-out input (load out))]
                  (if (and (!= next iff)
                           (and (not (n-dead? next))
                                (and (be-cfg-control? (n-op next))
                                     (be-has-input? next input))))
                      (set! found true)
                      0))
                (set! out (+ (load out) 1)))))
    (load found)))

(defn be-ctrl-succ [(ctrl i64)] (-> i64)
  (let [len (n-nouts ctrl)
        (mut i) 0
        (mut found) NO-NODE
        (mut found-if) NO-NODE
        (mut if-count) 0
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out ctrl (load i))]
                  (if (and (not (n-dead? u))
                           (and (if (op-is? u If []) (be-if-has-machine-continuation? u) true)
                                (and (be-cfg-control? (n-op u)) (> (n-nins u) 0))))
                      (if (be-has-input? u ctrl)
                          (do
                            (set! found u)
                            (set! count (+ (load count) 1))
                            (if (op-is? u If [])
                                (do (set! found-if u)
                                    (set! if-count (+ (load if-count) 1))
                                    0)
                                0)
                            0)
                          0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    ;; A folded guard can retain one explicit exceptional CProj while its normal arm is rewired
    ;; directly to the guard's input control. Follow the If first; mu-walk-block! reconnects the
    ;; unique direct consumer as the missing arm's fallthrough.
    (if (= (load count) 1)
        (load found)
        (if (and (= (load count) 2) (= (load if-count) 1))
            (load found-if)
            NO-NODE))))

(defn be-ctrl-succ-except [(ctrl i64) (skip i64)] (-> i64)
  (let [len (n-nouts ctrl)
        (mut i) 0
        (mut found) NO-NODE
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out ctrl (load i))]
                  (if (and (!= u skip)
                           (and (not (n-dead? u))
                                (and (be-cfg-control? (n-op u))
                                     (and (> (n-nins u) 0) (be-has-input? u ctrl)))))
                      (do (set! found u) (set! count (+ (load count) 1)) 0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (= (load count) 1) (load found) NO-NODE)))

(defn be-if-arm [(iff i64) (slot i64)] (-> i64)
  (let [len (n-nouts iff)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out iff (load i))]
                  ;; Folding can rewire an arm's control continuation directly to the If's input
                  ;; while leaving memory Args rooted at its old projection. Such a projection is
                  ;; not a machine-CFG arm: walking it creates a reachable block with no
                  ;; terminator. Treat only projections with a control successor as explicit arms;
                  ;; mu-walk-block! recovers the rewired arm through the direct fallthrough.
                  (if (and (not (n-dead? u))
                           (and (match (n-op u) (CProj [label] (= label slot)) (_ false))
                                (!= (be-ctrl-succ u) NO-NODE)))
                      (set! found u)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load found)))

; ---------------------------------------------------------------------------
; G1 structural machine CFG. This pass only reads the ideal graph. Selection remains separate
; until G2, so building or verifying this table cannot perturb optimizer or legacy backend state.
; ---------------------------------------------------------------------------

(defn mu-target-slot [(target i64) (incoming i64)] (-> i64)
  (if (or (op-is? target Region []) (op-is? target Loop []))
      (let [len (n-nins target)
            (mut i) 1
            (mut found) -1]
        (loop (if (or (>= (load i) len) (>= (load found) 0))
                  (break)
                  (do
                    (if (= (n-in target (load i)) incoming) (set! found (load i)) 0)
                    (set! i (+ (load i) 1))
                    0)))
        (load found))
      0))

(defn mu-add-edge! [(owner i64) (source i64) (target i64) (slot i64)] (-> i64)
  (let [u (machine-unit)
        len (mu-edge-count)
        (mut i) (al-get (.build-edge-head u) source)
        (mut prior) -1]
    (loop (if (or (< (load i) 0) (>= (load prior) 0))
              (break)
              (do
                (set! (mu-edge-probes-cell) (+ (load (mu-edge-probes-cell)) 1))
                (let [e (mu-edge (load i))]
                  (if (and (= (.source e) source)
                           (and (= (.target e) target)
                                (= (.target-slot e) slot)))
                      (set! prior (load i))
                      0))
                (set! i (al-get (.build-edge-next u) (load i)))
                0)))
    (if (>= (load prior) 0)
        (load prior)
        (do
          (al-push! [MEdge] (field u edges) (me-new len owner source target slot))
          (al-push! [i64] (field u build-edge-next) (al-get (.build-edge-head u) source))
          (al-set! [i64] (field u build-edge-head) source len)
          len))))

(defn mu-note-return! [(owner i64) (ret i64)] (-> i64)
  (let [u (machine-unit)
        f (mu-function owner)]
    (if (< (.return-first f) 0)
        (set! (.return-first f) (al-len [i64] (.returns u)))
        0)
    (al-push! [i64]
              (field u returns)
              (al-get (.ctrl-block u) ret))
    (set! (.return-count f) (+ (.return-count f) 1))
    0))

(defn mu-walk-block! [(owner i64) (head i64)] (-> i64)
  (let [u (machine-unit)
        known (al-get (.ctrl-block u) head)]
    (if (>= known 0)
        known
        (let [bid (mu-block-count)
              (mut ctrl) head
              (mut done) false]
          (al-push! [MBlock] (field u blocks) (mb-new bid owner head))
          (al-push! [i64] (field u build-edge-head) -1)
          (loop (if (load done)
                    (break)
                    (let [mapped (al-get (.ctrl-block u) (load ctrl))]
                      (if (and (>= mapped 0) (!= mapped bid))
                          (do
                            (mu-add-edge! owner bid mapped 0)
                            (set! done true))
                          (do
                            (al-set! [i64] (field u ctrl-block) (load ctrl) bid)
                            (match (n-op (load ctrl))
                              (Return [] (do (mu-note-return! owner (load ctrl)) (set! done true)))
                              (If [] (let [a-arm (be-if-arm (load ctrl) 0)
                                        b-arm (be-if-arm (load ctrl) 1)
                                        fallthrough
                                          (if (or (= a-arm NO-NODE) (= b-arm NO-NODE))
                                              (be-ctrl-succ-except (n-in (load ctrl) 0)
                                                                   (load ctrl))
                                              NO-NODE)
                                        a (if (= a-arm NO-NODE) fallthrough a-arm)
                                        b (if (= b-arm NO-NODE) fallthrough b-arm)
                                        a-incoming
                                          (if (= a-arm NO-NODE) (n-in (load ctrl) 0) a-arm)
                                        b-incoming
                                          (if (= b-arm NO-NODE) (n-in (load ctrl) 0) b-arm)]
                                    (if (and (= a-arm NO-NODE)
                                             (and (= b-arm NO-NODE)
                                                  (and (= fallthrough NO-NODE)
                                                       (be-profiling?))))
                                        (do
                                          (fmt (stderr)
                                               "AOTK_PROFILE phase=mu_dangling_if owner={d} bid={d} iff={d} input={d} input_outs={d}\n"
                                               owner bid (load ctrl) (n-in (load ctrl) 0)
                                               (n-nouts (n-in (load ctrl) 0)))
                                          (let [(mut out) 0]
                                            (loop (if (>= (load out)
                                                          (n-nouts (n-in (load ctrl) 0)))
                                                      (break)
                                                      (do
                                                        (let [candidate
                                                                (n-out (n-in (load ctrl) 0)
                                                                       (load out))]
                                                          (if (and (not (n-dead? candidate))
                                                                   (be-cfg-control?
                                                                     (n-op candidate)))
                                                              (n-print-flat (stderr) candidate)
                                                              0))
                                                        (set! out (+ (load out) 1))))))
                                          0)
                                        0)
                                    (if (and (!= a-arm NO-NODE)
                                             (and (!= fallthrough NO-NODE)
                                                  (= (be-ctrl-succ a-arm) NO-NODE)))
                                        (al-set! [i64] (field u ctrl-block) a-arm bid)
                                        (if (and (!= a NO-NODE)
                                                 (or (!= a-arm NO-NODE) (!= b-arm NO-NODE)))
                                        (do
                                          (mu-walk-block! owner a)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (.ctrl-block u) a)
                                                        (mu-target-slot a a-incoming))
                                          0)
                                        0))
                                    (if (and (!= b-arm NO-NODE)
                                             (and (!= fallthrough NO-NODE)
                                                  (= (be-ctrl-succ b-arm) NO-NODE)))
                                        (al-set! [i64] (field u ctrl-block) b-arm bid)
                                        (if (and (!= b NO-NODE)
                                                 (or (!= a-arm NO-NODE) (!= b-arm NO-NODE)))
                                        (do
                                          (mu-walk-block! owner b)
                                          (mu-add-edge! owner
                                                        bid
                                                        (al-get (.ctrl-block u) b)
                                                        (mu-target-slot b b-incoming))
                                          0)
                                        0))
                                    (set! done true)))
                              (_ (let [next (be-ctrl-succ (load ctrl))]
                                      (if (= next NO-NODE)
                                          (set! done true)
                                          (if (or (op-is? next Region [])
                                                  (or (op-is? next Loop []) (op-is? next CProj [_])))
                                              (do
                                                (mu-walk-block! owner next)
                                                (mu-add-edge! owner
                                                              bid
                                                              (al-get (.ctrl-block u) next)
                                                              (mu-target-slot next (load ctrl)))
                                                (set! done true))
                                              (set! ctrl next))))))))))
            bid)))))

(defn mu-build-function! [(ideal i64) (entry i64)] (-> i64)
  (let [u (machine-unit)
        id (mu-function-count)
        first (mu-block-count)]
    (al-push! [MFunction] (field u functions) (mf-new id ideal entry))
    (if (and (>= ideal 0) (< ideal (al-len [i64] (.ideal-function-owner u))))
        (al-set! [i64] (field u ideal-function-owner) ideal id)
        0)
    (al-push! [i64]
              (field u symbols)
              (if (= ideal NO-NODE)
                  -1
                  (match (n-op ideal) (Fun [index] index) (Start [] 0)
                    (_ (do (panic-corrupt "machine function root must be Start or Fun") 0)))))
    (al-push! [i64] (field u identity-kinds)
              (if (and (!= ideal NO-NODE) (op-is? ideal Fun [_]))
                  (n-fun-identity-kind ideal) FUN-IDENTITY-EPHEMERAL))
    (al-push! [i64] (field u identity-units)
              (if (and (!= ideal NO-NODE) (op-is? ideal Fun [_]))
                  (n-fun-identity-unit ideal) 0))
    (al-push! [i64] (field u identity-locals)
              (if (and (!= ideal NO-NODE) (op-is? ideal Fun [_]))
                  (n-fun-identity-local ideal) 0))
    (if (and (!= ideal NO-NODE)
             (and (op-is? ideal Fun [_]) (n-fun-imported? ideal)))
        (mu-function-mark-imported! id)
        (mu-walk-block! id entry))
    (let [f (mu-function id)]
      (set! (.block-first f) first)
      (set! (.block-count f) (- (mu-block-count) first)))
    id))

(defn mu-find-function [(ideal i64)] (-> i64)
  (let [cached (if (and (>= ideal 0)
                        (< ideal (al-len [i64] (.ideal-function-owner (machine-unit)))))
                   (al-get (.ideal-function-owner (machine-unit)) ideal)
                   -1)
        n (mu-function-count)
        (mut i) 0
        (mut found) cached]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (= (mu-function-ideal (load i)) ideal) (set! found (load i)) 0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

(defn mu-find-function-symbol [(symbol i64)] (-> i64)
  (let [(mut owner) 0
        (mut found) -1]
    (loop (if (or (>= (load owner) (mu-function-count)) (>= (load found) 0))
              (break)
              (do
                (if (= (al-get (.symbols (machine-unit)) (load owner)) symbol)
                    (set! found (load owner))
                    0)
                (set! owner (+ (load owner) 1)))))
    (load found)))

(defn mu-direct-callee [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (match (n-op callee)
      (Fun [index] callee)
      (Closure [captures] (n-in callee 0))
      (_ (let [fidx (ty-fun-singleton (n-ty callee))]
           (if (< fidx 0) NO-NODE (n-find-fun-index fidx)))))))

(defn mu-build-call-targets! [(call i64)] (-> i64)
  (let [direct (mu-direct-callee call)
        targets (ty-fun-targets (n-ty (n-in call 1)))
        (mut fidx) 0]
    (if (!= direct NO-NODE) (mu-build-reachable-function! direct) 0)
    (loop (if (>= (load fidx) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load fidx))) 0)
                    (let [fun (n-find-fun-index (load fidx))]
                      (if (!= fun NO-NODE) (mu-build-reachable-function! fun) 0))
                    0)
                (set! fidx (+ (load fidx) 1)))))
    0))

(defn mu-cache-ideal-calls! [] (-> i64)
  (let [calls (.ideal-calls (machine-unit))
        (mut node) 0]
    (al-clear! [i64] (field (machine-unit) ideal-calls))
    (loop (if (>= (load node) (n-count))
              (break)
              (do
                (if (and (not (n-dead? (load node))) (op-is? (load node) Call [_]))
                    (al-push! [i64] (field (machine-unit) ideal-calls) (load node))
                    0)
                (set! node (+ (load node) 1)))))
    0))

(defn mu-build-reachable-function! [(ideal i64)] (-> i64)
  (let [prior (mu-find-function ideal)]
    (if (>= prior 0)
        prior
        (let [build-start (mu-profile-now)
              owner (mu-build-function! ideal (n-fun-entry ideal))
              build-ns (- (mu-profile-now) build-start)
              (mut i) 0]
          (set! (mu-function-build-ns-cell) (+ (load (mu-function-build-ns-cell)) build-ns))
          (if (> build-ns 100000000)
              (do
                (fmt (stderr) "AOTK_PROFILE phase=mu_function owner={d} ideal={d} ns={d} blocks={d}\n"
                     owner ideal build-ns (mu-function-block-count owner))
                0)
              0)
          owner))))

(defn mu-finalize-adjacency! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut b) 0]
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (al-clear! [i64] (field u block-terminator))
    (al-clear! [i64] (field u verify-def-count))
    (al-clear! [i64] (field u verify-node-def-count))
    ;; Count degrees once. The previous block-outer/edge-inner construction did B*E comparisons
    ;; merely to group an already materialized edge vector by endpoint.
    (loop (if (>= (load b) blocks)
              (break)
              (do
                (let [block (mu-block (load b))]
                  (set! (.pred-count block) 0)
                  (set! (.succ-count block) 0)
                  (al-push! [i64] (field u block-terminator) NO-NODE)
                  (al-push! [i64] (field u verify-def-count) 0)
                  (al-push! [i64] (field u verify-node-def-count) 0))
                (set! b (+ (load b) 1))
                0)))
    (let [(mut node) 0]
      (loop (if (>= (load node) (n-count))
                (break)
                (do
                  (if (or (op-is? (load node) If []) (op-is? (load node) Return []))
                      (let [bid (al-get (.ctrl-block u) (load node))]
                        (if (and (>= bid 0) (< bid blocks))
                            (al-set! [i64] (field u block-terminator) bid (load node))
                            0))
                      0)
                  (set! node (+ (load node) 1))))))
    (let [(mut e) 0]
      (loop (if (>= (load e) edges)
                (break)
                (do
                  (let [edge (mu-edge (load e))]
                    (set! (.pred-count (mu-block (.target edge)))
                          (+ (.pred-count (mu-block (.target edge))) 1))
                    (set! (.succ-count (mu-block (.source edge)))
                          (+ (.succ-count (mu-block (.source edge))) 1)))
                  (set! e (+ (load e) 1))))))
    ;; Prefix ranges and allocate the two packed vectors.
    (set! b 0)
    (let [(mut pred-first) 0 (mut succ-first) 0]
      (loop (if (>= (load b) blocks)
                (break)
                (do
                  (let [block (mu-block (load b))]
                    (set! (.pred-first block) (load pred-first))
                    (set! (.succ-first block) (load succ-first))
                    (set! pred-first (+ (load pred-first) (.pred-count block)))
                    (set! succ-first (+ (load succ-first) (.succ-count block))))
                  (set! b (+ (load b) 1))))))
    (set! b 0)
    (loop (if (>= (load b) edges)
              (break)
              (do
                (al-push! [i64] (field u pred-edges) -1)
                (al-push! [i64] (field u succ-edges) -1)
                (set! b (+ (load b) 1)))))
    ;; Fill in original edge order, preserving the order each block observed before this change.
    (let [(mut e) 0]
      (loop (if (>= (load e) edges)
                (break)
                (do
                  (let [edge (mu-edge (load e))
                        target (.target edge)
                        source (.source edge)
                        pred-at (+ (.pred-first (mu-block target))
                                   (al-get (.verify-def-count u) target))
                        succ-at (+ (.succ-first (mu-block source))
                                   (al-get (.verify-node-def-count u) source))]
                    (al-set! [i64] (field u pred-edges) pred-at (load e))
                    (al-set! [i64] (field u succ-edges) succ-at (load e))
                    (al-set! [i64] (field u verify-def-count) target
                             (+ (al-get (.verify-def-count u) target) 1))
                    (al-set! [i64] (field u verify-node-def-count) source
                             (+ (al-get (.verify-node-def-count u) source) 1)))
                  (set! e (+ (load e) 1))))))
    0))

(defn mu-rpo-visit! [(owner i64) (bid i64)] (-> i64)
  (let [u (machine-unit)]
    (if (!= (al-get (.rpo-seen u) bid) 0)
        0
        (do
          (al-set! [i64] (field u rpo-seen) bid 1)
          (let [block (mu-block bid)
                (mut i) 0]
            ;; Adjacency is already finalized. Walking the global edge vector at every DFS node
            ;; made RPO O(blocks*edges) on large control graphs.
            (loop (if (>= (load i) (.succ-count block))
                      (break)
                      (do
                        (let [e (mu-edge (al-get (.succ-edges u)
                                                 (+ (.succ-first block) (load i))))]
                          (if (and (= (.owner e) owner)
                                   (= (.source e) bid))
                              (mu-rpo-visit! owner (.target e))
                              0))
                        (set! i (+ (load i) 1))
                        0))))
          (al-push! [i64] (field u rpo-post) bid)
          0))))

(defn mu-compute-rpo! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-order))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (al-clear! [i64] (field u rpo-seen))
                (al-clear! [i64] (field u rpo-post))
                (let [(mut i) 0]
                  (loop (if (>= (load i) blocks)
                            (break)
                            (do
                              (al-push! [i64] (field u rpo-seen) 0)
                              (set! i (+ (load i) 1))
                              0))))
                (let [funrec (mu-function (load fidx))
                      entry (.entry funrec)
                      first (al-len [i64] (.block-order u))]
                  (if (.imported funrec)
                      0
                      (let [entry-block (al-get (.ctrl-block u) entry)]
                        (if (< entry-block 0)
                            (set! ok false)
                            (mu-rpo-visit! (load fidx) entry-block))))
                  (let [n (al-len [i64] (.rpo-post u))
                        (mut i) n]
                    (loop (if (<= (load i) 0)
                              (break)
                              (do
                                (set! i (- (load i) 1))
                                (let [bid (al-get (.rpo-post u) (load i))
                                      layout (- n (+ (load i) 1))]
                                  (al-push! [i64] (field u block-order) bid)
                                  (set! (.layout-index (mu-block bid)) layout))
                                0)))
                    (set! (.block-first funrec) first)
                    (set! (.block-count funrec) n)))
                (set! fidx (+ (load fidx) 1))
                0)))
    ; Every built block must be reachable from its declared function entry.
    (and (load ok) (= (al-len [i64] (.block-order u)) blocks))))

(defn mu-idom-intersect [(left i64) (right i64)] (-> i64)
  (let [(mut a) left
        (mut b) right]
    (loop (if (= (load a) (load b))
              (break)
              (do
                (loop (if (<= (mu-block-layout-index (load a))
                              (mu-block-layout-index (load b)))
                          (break)
                          (set! a (mu-block-idom (load a)))))
                (loop (if (<= (mu-block-layout-index (load b))
                              (mu-block-layout-index (load a)))
                          (break)
                          (set! b (mu-block-idom (load b)))))
                0)))
    (load a)))

(defn mu-compute-idoms! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        funcs (mu-function-count)
        (mut i) 0
        (mut fidx) 0
        (mut ok) true]
    (al-clear! [i64] (field u block-idom))
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (al-push! [i64] (field u block-idom) -1)
                (set! i (+ (load i) 1))
                0)))
    (loop (if (or (>= (load fidx) funcs) (not (load ok)))
              (break)
              (if (mu-function-imported? (load fidx))
                  (set! fidx (+ (load fidx) 1))
              (let [count (mu-function-block-count (load fidx))
                    entry (mu-function-block (load fidx) 0)
                    (mut changed) true
                    (mut rounds) 0]
                (al-set! [i64] (field u block-idom) entry entry)
                (loop (if (or (not (load changed)) (> (load rounds) (+ count 1)))
                          (break)
                          (do
                            (set! changed false)
                            (set! i 1)
                            (loop (if (>= (load i) count)
                                      (break)
                                      (do
                                        (let [bid (mu-function-block (load fidx) (load i))
                                              block (mu-block bid)
                                              (mut p) 0
                                              (mut next) -1]
                                          (loop (if (>= (load p) (.pred-count block))
                                                    (break)
                                                    (do
                                                      (let [eid
                                                              (al-get (.pred-edges u)
                                                                      (+ (.pred-first block) (load p)))
                                                            pred (mu-edge-source eid)]
                                                        (if (>= (mu-block-idom pred) 0)
                                                            (if (< (load next) 0)
                                                                (set! next pred)
                                                                (set! next (mu-idom-intersect pred (load next))))
                                                            0))
                                                      (set! p (+ (load p) 1))
                                                      0)))
                                          (if (and (>= (load next) 0) (!= (mu-block-idom bid) (load next)))
                                              (do
                                                (al-set! [i64] (field u block-idom) bid (load next))
                                                (set! changed true))
                                              0))
                                        (set! i (+ (load i) 1))
                                        0)))
                            (set! rounds (+ (load rounds) 1))
                            0)))
                (set! i 0)
                (loop (if (>= (load i) count)
                          (break)
                          (do
                            (if (< (mu-block-idom (mu-function-block (load fidx) (load i))) 0)
                                (set! ok false)
                                0)
                            (set! i (+ (load i) 1))
                            0)))
                (set! fidx (+ (load fidx) 1))
                0))))
    (load ok)))

(defn mu-dominates? [(ancestor i64) (descendant i64)] (-> bool)
  (if (!= (mu-block-owner ancestor) (mu-block-owner descendant))
      false
      (let [(mut cursor) descendant]
        (loop (if (or (= (load cursor) ancestor)
                      (= (mu-block-idom (load cursor)) (load cursor)))
                  (break)
                  (set! cursor (mu-block-idom (load cursor)))))
        (= (load cursor) ancestor))))

(defn mu-compute-loop-depth! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (set! (.loop-depth (mu-block (load i))) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) edges)
              (break)
              (do
                (let [back (mu-edge (load i))
                      header (.target back)
                      source (.source back)
                      slot (.target-slot back)]
                  (if (and (= slot 2) (op-is? (mu-block-control header) Loop []))
                      (do
                        (al-clear! [i64] (field u rpo-seen))
                        (al-clear! [i64] (field u rpo-post))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (al-push! [i64] (field u rpo-seen) 0)
                                      (set! b (+ (load b) 1))
                                      0))))
                        (al-set! [i64] (field u rpo-seen) header 1)
                        (if (= source header)
                            0
                            (do
                              (al-set! [i64] (field u rpo-seen) source 1)
                              (al-push! [i64] (field u rpo-post) source)))
                        (loop (let [n (al-len [i64] (.rpo-post u))]
                                (if (= n 0)
                                    (break)
                                    (let [current (al-get (.rpo-post u) (- n 1))
                                          (mut pred-index) 0]
                                      (al-pop! [i64] (field u rpo-post))
                                      ;; Adjacency was built before loop discovery. Walking this
                                      ;; block's predecessor slice is the same natural-loop walk;
                                      ;; scanning every edge for every visited block made the pass
                                      ;; O(backedges * loop-blocks * all-edges).
                                      (loop (if (>= (load pred-index)
                                                    (mu-block-pred-count current))
                                                (break)
                                                (do
                                                  (let [pred
                                                          (mu-block-pred-source
                                                            current
                                                            (load pred-index))]
                                                    (if (= (mu-block-owner pred) (.owner back))
                                                        (if (= (al-get (.rpo-seen u) pred) 0)
                                                            (do
                                                              (al-set! [i64] (field u rpo-seen) pred 1)
                                                              (if (= pred header)
                                                                  0
                                                                  (al-push! [i64]
                                                                            (field u rpo-post)
                                                                            pred)))
                                                            0)
                                                        0))
                                                  (set! pred-index (+ (load pred-index) 1))
                                                  0)))))))
                        (let [(mut b) 0]
                          (loop (if (>= (load b) blocks)
                                    (break)
                                    (do
                                      (if (!= (al-get (.rpo-seen u) (load b)) 0)
                                          (set! (.loop-depth (mu-block (load b)))
                                                (+ (.loop-depth (mu-block (load b))) 1))
                                          0)
                                      (set! b (+ (load b) 1))
                                      0))))
                        0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn mu-fail-verify! [(code i64) (item i64)] (-> bool)
  (let [u (machine-unit)]
    (set! (.verify-result u) code)
    (set! (.verify-item u) item)
    false))

;;; Independent dense facts for the CFG verifier. The builder's adjacency ranges remain the thing
;;; being checked; these counts are derived afresh from the published vectors so reciprocity does
;;; not rescan both complete vectors once per edge, and terminators do not rescan the ideal graph
;;; once per block.
(defn mu-build-verifier-indices! [] (-> i64)
  (let [u (machine-unit)
        edges (mu-edge-count)
        blocks (mu-block-count)
        (mut i) 0]
    (al-clear! [i64] (field u verify-def-count))
    (al-clear! [i64] (field u verify-node-def-count))
    (al-clear! [i64] (field u verify-membership))
    (loop (if (>= (load i) edges)
              (break)
              (do
                (al-push! [i64] (field u verify-def-count) 0)
                (al-push! [i64] (field u verify-node-def-count) 0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) blocks)
              (break)
              (do (al-push! [i64] (field u verify-membership) NO-NODE)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [i64] (.pred-edges u)))
              (break)
              (do
                (let [eid (al-get (.pred-edges u) (load i))]
                  (if (and (>= eid 0) (< eid edges))
                      (al-set! [i64] (field u verify-def-count) eid
                               (+ (al-get (.verify-def-count u) eid) 1))
                      0))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [i64] (.succ-edges u)))
              (break)
              (do
                (let [eid (al-get (.succ-edges u) (load i))]
                  (if (and (>= eid 0) (< eid edges))
                      (al-set! [i64] (field u verify-node-def-count) eid
                               (+ (al-get (.verify-node-def-count u) eid) 1))
                      0))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (n-count))
              (break)
              (do
                (if (or (op-is? (load i) If []) (op-is? (load i) Return []))
                    (let [bid (al-get (.ctrl-block u) (load i))]
                      (if (and (>= bid 0) (< bid blocks))
                          (al-set! [i64] (field u verify-membership) bid (load i))
                          0))
                    0)
                (set! i (+ (load i) 1)))))
    0))

(defn mu-adj-count [(edge i64) (pred bool)] (-> i64)
  (if pred
      (al-get (.verify-def-count (machine-unit)) edge)
      (al-get (.verify-node-def-count (machine-unit)) edge)))

(defn mu-block-adj-valid? [(bid i64) (pred bool)] (-> bool)
  (let [u (machine-unit)
        b (mu-block bid)
        first (if pred (.pred-first b) (.succ-first b))
        count (if pred (.pred-count b) (.succ-count b))
        list-len
          (if pred
              (al-len [i64] (.pred-edges u))
              (al-len [i64] (.succ-edges u)))
        (mut i) 0
        (mut ok) true]
    (if (or (< first 0) (or (< count 0) (> (+ first count) list-len)))
        false
        (do
          (loop (if (or (>= (load i) count) (not (load ok)))
                    (break)
                    (do
                      (let [eid
                              (if pred
                                  (al-get (.pred-edges u) (+ first (load i)))
                                  (al-get (.succ-edges u) (+ first (load i))))]
                        (if (or (< eid 0) (>= eid (mu-edge-count)))
                            (set! ok false)
                            (if (!= (if pred (mu-edge-target eid) (mu-edge-source eid)) bid)
                                (set! ok false)
                                0)))
                      (set! i (+ (load i) 1))
                      0)))
          (load ok)))))

(defn mu-slot-valid? [(eid i64)] (-> bool)
  (let [u (machine-unit)
        e (mu-edge eid)
        s (.source e)
        t (.target e)
        slot (.target-slot e)
        target (mu-block-control t)]
    (if (or (op-is? target Region []) (op-is? target Loop []))
        (if (or (<= slot 0) (or (>= slot (n-nins target)) (= (n-in target slot) NO-NODE)))
            false
            (let [incoming (n-in target slot)
                  mapped (al-get (.ctrl-block u) incoming)
                  block (mu-block t)
                  (mut i) 0
                  (mut same) 0]
              (loop (if (>= (load i) (.pred-count block))
                        (break)
                        (do
                          (let [other (mu-edge (al-get (.pred-edges u)
                                                       (+ (.pred-first block) (load i))))]
                            (if (and (= (.target other) t)
                                     (= (.target-slot other) slot))
                                (set! same (+ (load same) 1))
                                0))
                          (set! i (+ (load i) 1))
                          0)))
              (and (= mapped s) (= (load same) 1))))
        (= slot 0))))

(defn mu-block-terminator-op [(bid i64)] (-> i64)
  (al-get (.block-terminator (machine-unit)) bid))

(defn mu-block-terminator [(bid i64)] (-> i64)
  (mu-block-terminator-op bid))

(defn mu-verify-terminators! [] (-> bool)
  (let [blocks (mu-block-count)
        (mut i) 0]
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [term (mu-block-terminator-op (load i))
                      verify-term (al-get (.verify-membership (machine-unit)) (load i))
                      succ (.succ-count (mu-block (load i)))]
                  (if (or (!= term verify-term)
                          (or (and (!= verify-term NO-NODE)
                                   (and (op-is? verify-term If [])
                                        (or (< succ 1) (> succ 2))))
                              (and (!= verify-term NO-NODE) (and (op-is? verify-term Return []) (!= succ 0)))))
                      (do
                        (fmt (stderr) "machine-cfg: terminator arity block={d} head={d} term={d} succ={d}\n"
                             (load i) (.ideal-ctrl (mu-block (load i))) verify-term succ)
                        (mu-fail-verify! MCFG-TERMINATOR-ARITY (load i))
                        (break))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-rpo! [] (-> bool)
  (let [u (machine-unit)
        funcs (mu-function-count)
        blocks (mu-block-count)
        (mut fidx) 0]
    (al-clear! [i64] (field u rpo-seen))
    (let [(mut i) 0]
      (loop (if (>= (load i) blocks)
                (break)
                (do
                  (al-push! [i64] (field u rpo-seen) 0)
                  (set! i (+ (load i) 1))
                  0))))
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      n (.block-count f)
                      (mut pos) 0]
                  (if (mu-function-imported? (load fidx))
                      (if (!= n 0)
                          (do (mu-fail-verify! MCFG-RPO (load fidx)) 0)
                          0)
                      (let [entry-block (al-get (.ctrl-block u) (.entry f))]
                        (if (or (= n 0) (!= (mu-function-block (load fidx) 0) entry-block))
                            (do (mu-fail-verify! MCFG-RPO (load fidx)) 0)
                            0)))
                  (loop (if (or (>= (load pos) n) (!= (mu-verify-result) MCFG-OK))
                            (break)
                            (do
                              (let [bid (mu-function-block (load fidx) (load pos))]
                                (if (or (< bid 0)
                                        (or (>= bid blocks)
                                            (or (!= (mu-block-owner bid) (load fidx))
                                                (or (!= (mu-block-layout-index bid) (load pos))
                                                    (!= (al-get (.rpo-seen u) bid) 0)))))
                                    (do (mu-fail-verify! MCFG-RPO bid) (break))
                                    (al-set! [i64] (field u rpo-seen) bid 1)))
                              (set! pos (+ (load pos) 1))
                              0))))
                (if (!= (mu-verify-result) MCFG-OK) (break) 0)
                (set! fidx (+ (load fidx) 1))
                0)))
    (if (= (mu-verify-result) MCFG-OK)
        (let [(mut i) 0]
          (loop (if (>= (load i) blocks)
                    (break)
                    (do
                      (if (= (al-get (.rpo-seen u) (load i)) 0)
                          (do (mu-fail-verify! MCFG-RPO (load i)) (break))
                          0)
                      (set! i (+ (load i) 1))
                      0))))
        0)
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify-idoms! [] (-> bool)
  (let [blocks (mu-block-count)
        funcs (mu-function-count)
        (mut fidx) 0]
    (loop (if (or (>= (load fidx) funcs) (!= (mu-verify-result) MCFG-OK))
              (break)
              (do
                (if (mu-function-imported? (load fidx))
                    0
                    (let [count (mu-function-block-count (load fidx))
                          entry (mu-function-block (load fidx) 0)
                          (mut i) 0]
                      (if (!= (mu-block-idom entry) entry)
                          (do (mu-fail-verify! MCFG-IDOM entry) 0)
                          0)
                      (set! i 1)
                      (loop (if (or (>= (load i) count) (!= (mu-verify-result) MCFG-OK))
                                (break)
                                (do
                                  (let [bid (mu-function-block (load fidx) (load i))
                                        parent (mu-block-idom bid)]
                                    (if (or (< parent 0)
                                            (or (>= parent blocks)
                                                (or (!= (mu-block-owner parent) (load fidx))
                                                    (>= (mu-block-layout-index parent)
                                                        (mu-block-layout-index bid)))))
                                        (do (mu-fail-verify! MCFG-IDOM bid) 0)
                                        0))
                                  (set! i (+ (load i) 1))
                                  0)))))
                (set! fidx (+ (load fidx) 1))
                0)))
    (= (mu-verify-result) MCFG-OK)))

(defn mu-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        funcs (mu-function-count)
        (mut i) 0]
    (set! (.verify-result u) MCFG-OK)
    (set! (.verify-item u) -1)
    (mu-build-verifier-indices!)
    (loop (if (>= (load i) blocks)
              (break)
              (do
                (let [b (mu-block (load i))
                      owner (.owner b)]
                  (if (or (!= (.id b) (load i))
                          (or (< owner 0) (>= owner funcs)))
                      (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                      (if (or (not (mu-block-adj-valid? (load i) true))
                              (not (mu-block-adj-valid? (load i) false)))
                          (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                          0)))
                (set! i (+ (load i) 1))
                0)))
    (if (!= (mu-verify-result) MCFG-OK)
        false
        (do
          (set! i 0)
          (loop (if (>= (load i) edges)
                    (break)
                    (do
                      (let [e (mu-edge (load i))
                            s (.source e)
                            t (.target e)
                            owner (.owner e)
                            slot (.target-slot e)]
                        (if (or (< s 0) (or (>= s blocks) (or (< t 0) (>= t blocks))))
                            (do (mu-fail-verify! MCFG-OWNER (load i)) (break))
                            (if (or (!= owner (mu-block-owner s)) (!= owner (mu-block-owner t)))
                                (do (mu-fail-verify! MCFG-FUNCTION-ISOLATION (load i)) (break))
                                (if (or (!= (mu-adj-count (load i) false) 1)
                                        (!= (mu-adj-count (load i) true) 1))
                                    (do (mu-fail-verify! MCFG-RECIPROCITY (load i)) (break))
                                    (if (not (mu-slot-valid? (load i)))
                                        (do (mu-fail-verify! MCFG-PREDECESSOR-SLOT (load i)) (break))
                                        0)))))
                      (set! i (+ (load i) 1))
                      0)))
          (if (!= (mu-verify-result) MCFG-OK)
              false
              (if (not (mu-verify-terminators!))
                  false
                  (if (not (mu-verify-rpo!))
                      false
                      (mu-verify-idoms!))))))))

; Test-only corruption hooks are explicit and narrow; production callers only build and verify.
(defn mu-corrupt-block-owner! [(bid i64) (new-owner i64)] (-> i64)
  (set! (.owner (mu-block bid)) new-owner)
  0)
(defn mu-corrupt-edge-target-slot! [(eid i64) (slot i64)] (-> i64)
  (set! (.target-slot (mu-edge eid)) slot)
  0)
(defn mu-corrupt-drop-last-pred! [] (-> i64)
  (let [u (machine-unit)
        n (al-len [i64] (.pred-edges u))]
    (if (> n 0) (set! (.len (.pred-edges u)) (- n 1)) 0)
    0))
(defn mu-corrupt-layout! [(bid i64) (layout i64)] (-> i64)
  (set! (.layout-index (mu-block bid)) layout)
  0)
(defn mu-corrupt-idom! [(bid i64) (parent i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) block-idom) bid parent)
  0)
(defn mu-corrupt-add-return-successor! [(bid i64)] (-> i64)
  (let [owner (mu-block-owner bid)]
    (al-push! [MEdge]
              (field (machine-unit) edges)
              (me-new (mu-edge-count) owner bid bid 0))
    (mu-finalize-adjacency!)
    0))
(defn mu-corrupt-edge-target! [(eid i64) (target i64)] (-> i64)
  (set! (.target (mu-edge eid)) target)
  (mu-finalize-adjacency!)
  0)

(defn mu-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        edges (mu-edge-count)
        (mut fidx) 0]
    (loop (if (>= (load fidx) funcs)
              (break)
              (do
                (let [f (mu-function (load fidx))
                      ideal (.ideal f)
                      nblocks (.block-count f)]
                  (fmt w "function {d} ideal {d} blocks {d}\n" (load fidx) ideal nblocks)
                  (let [(mut rpo) 0]
                    (loop (if (>= (load rpo) nblocks)
                              (break)
                              (do
                                (let [bid (mu-function-block (load fidx) (load rpo))
                                      ctrl (mu-block-control bid)]
                                  (fmt w "  b{d} {s}" (load rpo) (op-name (n-op ctrl)))
                                  ; Dump successors in target-layout order, independent of discovery order.
                                  (let [(mut target-layout) 0]
                                    (loop (if (>= (load target-layout) nblocks)
                                              (break)
                                              (do
                                                (let [(mut eid) 0]
                                                  (loop (if (>= (load eid) edges)
                                                            (break)
                                                            (do
                                                              (let [e (mu-edge (load eid))
                                                                    target (mu-edge-target (load eid))]
                                                                (if (and (= (mu-edge-source (load eid)) bid)
                                                                         (and (= (mu-block-owner target) (load fidx))
                                                                              (= (mu-block-layout-index target)
                                                                                 (load target-layout))))
                                                                    (do
                                                                      (fmt w
                                                                           " ->b{d}[{d}]"
                                                                           (load target-layout)
                                                                           (mu-edge-target-slot (load eid)))
                                                                      0)
                                                                    0))
                                                              (set! eid (+ (load eid) 1))
                                                              0))))
                                                (set! target-layout (+ (load target-layout) 1))
                                                0))))
                                  (ps w "\n"))
                                (set! rpo (+ (load rpo) 1))
                                0)))))
                (set! fidx (+ (load fidx) 1))
                0)))
    0))

(defn mu-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (mu-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "mu-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

(defn mu-finish-build! [] (-> bool)
  (let [(mut started) (mu-profile-now)]
    (mu-finalize-adjacency!)
    (fmt (stderr) "AOTK_PROFILE phase=mu_adjacency ns={d} blocks={d} edges={d} edge_probes={d}\n"
         (- (mu-profile-now) (load started)) (mu-block-count) (mu-edge-count)
         (load (mu-edge-probes-cell)))
    (set! started (mu-profile-now))
    (set! (.phase (machine-unit)) 1)
    (let [rpo (mu-compute-rpo!)]
      (fmt (stderr) "AOTK_PROFILE phase=mu_rpo ns={d}\n" (- (mu-profile-now) (load started)))
      (if rpo
          (do
            (set! started (mu-profile-now))
            (let [idoms (mu-compute-idoms!)]
              (fmt (stderr) "AOTK_PROFILE phase=mu_idoms ns={d}\n" (- (mu-profile-now) (load started)))
              (if idoms
                  (do
                    (set! started (mu-profile-now))
                    (mu-compute-loop-depth!)
                    (fmt (stderr) "AOTK_PROFILE phase=mu_loops ns={d}\n" (- (mu-profile-now) (load started)))
                    (set! started (mu-profile-now))
                    (let [ok (if (be-verification?) (mu-verify!) true)]
                      (fmt (stderr) "AOTK_PROFILE phase=mu_verify ns={d}\n" (- (mu-profile-now) (load started)))
                      ok))
                  (mu-fail-verify! MCFG-RPO -1))))
          (mu-fail-verify! MCFG-RPO -1)))))

(defn mu-build-entry! [(entry-fun i64)] (-> bool)
  (mu-reset!)
  (if (or (!= (g-verify) 0) (op-is? entry-fun FunStart []))
      false
      (if (not (op-is? entry-fun Fun [_]))
          false
          (do
            (mu-cache-ideal-calls!)
            (mu-build-reachable-function! entry-fun)
            (mu-finish-build!)))))

;;; Does this function's identity leave the callee slot of a direct call? Every other use -- a
;;; materialization into a value, a store, an argument -- puts it somewhere the universal dispatcher
;;; can later find, so it has to be compiled even though no call edge names it.
(defn mu-fun-identity-escapes? [(fun i64)] (-> bool)
  (let [uses (n-nouts fun) (mut i) 0 (mut escapes) false]
    (loop (if (or (load escapes) (>= (load i) uses))
              (break)
              (do
                (let [use (n-out fun (load i))]
                  (if (n-dead? use)
                      0
                      (if (and (op-is? use Call [_])
                               (and (> (n-nins use) 1) (= (n-in use 1) fun)))
                          0
                          (set! escapes true))))
                (set! i (+ (load i) 1)))))
    (load escapes)))

(defn mu-build-program-core! [(verify-graph bool)] (-> bool)
  (mu-reset!)
  (set! (mu-edge-probes-cell) 0)
  (set! (mu-function-build-ns-cell) 0)
  (let [(mut profile-start) (mu-profile-now)
        verified (if verify-graph (= (g-verify) 0) true)]
  (fmt (stderr) "AOTK_PROFILE phase=mu_graph_verify ns={d}\n" (- (mu-profile-now) (load profile-start)))
  (if (not verified)
      false
      (do
      (mu-cache-ideal-calls!)
      (set! profile-start (mu-profile-now))
      (let [owner (mu-build-function! NO-NODE (g-start))
            lim (n-count)
            (mut i) 0]
        (fmt (stderr) "AOTK_PROFILE phase=mu_reachable ns={d} functions={d} blocks={d} edges={d} calls={d} function_ns={d}\n"
             (- (mu-profile-now) (load profile-start)) (mu-function-count) (mu-block-count)
             (mu-edge-count) (al-len [i64] (.ideal-calls (machine-unit)))
             (load (mu-function-build-ns-cell)))
        (set! profile-start (mu-profile-now))
        ;; Closed-world dispatch reaches a callable whose identity escapes only as a VALUE -- a
        ;; callback stored through a dynamic method call has no direct call edge, but the universal
        ;; dispatcher can still land on it, so it must be in the unit.
        ;;
        ;; THAT IS NOT EVERY LIVE FUNCTION. This used to build every `Fun` in the graph, so a cold
        ;; compile of a 253-line Test262 file compiled 91 functions when the walk above had reached
        ;; one. A `Fun` whose every use is the callee slot of a `Call` is already covered by
        ;; `mu-build-call-targets!`, and if the caller was not built the callee is not wanted. Only
        ;; an escaping identity needs the fallback -- which is what Simple's linker does: reachable
        ;; functions are discovered, not enumerated.
        ;;
        ;; A `CallableId` names a function by INDEX rather than by an edge to its `Fun`, so those
        ;; are collected separately; dropping them would lose exactly the dispatch case the
        ;; fallback exists for.
        (set! i 0)
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (not (n-dead? (load i)))
                        (match (n-op (load i))
                          (CallableId [index]
                            (let [fun (n-find-fun-index index)]
                              (if (!= fun NO-NODE) (mu-build-reachable-function! fun) 0)))
                          (Fun [_]
                            (if (mu-fun-identity-escapes? (load i))
                                (do (mu-build-reachable-function! (load i)) 0)
                                0))
                          (_ 0))
                        0)
                    (set! i (+ (load i) 1))
                    0)))
        (fmt (stderr) "AOTK_PROFILE phase=mu_all_functions ns={d} functions={d} blocks={d} edges={d}\n"
             (- (mu-profile-now) (load profile-start)) (mu-function-count) (mu-block-count) (mu-edge-count))
        (mu-finish-build!))))))

(defn mu-build-program! [] (-> bool)
  (mu-build-program-core! true))

;;; The native harness reports graph-verifier diagnostics itself immediately before selection. This
;;; explicit seam avoids repeating that same read-only whole-graph pass while keeping every ordinary
;;; selector caller independently verified.
(defn mu-build-verified-program! [] (-> bool)
  (mu-build-program-core! false))

(defn mu-build! [] (-> bool)
  (mu-reset!)
  (if (!= (g-verify) 0)
      false
      (let [lim (n-count)
            (mut i) 0
            (mut found) false]
        (loop (if (>= (load i) lim)
                  (break)
                  (do
                    (if (and (not (n-dead? (load i))) (op-is? (load i) Fun [_]))
                        (do
                          (mu-build-function! (load i) (n-fun-entry (load i)))
                          (set! found true))
                        0)
                    (set! i (+ (load i) 1))
                    0)))
        ; A graph without explicit Fun nodes is one synthetic top-level machine function.
        (if (not (load found)) (mu-build-function! NO-NODE (g-start)) 0)
        (mu-finish-build!))))
