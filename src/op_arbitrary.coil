;; ONE `Arbitrary Op` IMPL FOR THE WHOLE PROJECT.
;;
;; `Op` is declared in `node`, and two suites want to generate it: `tests/backend-parity-prop.coil`
;; drives the selector and allocator from it, and `tests/js-source-prop.coil` derives JavaScript
;; programs from it. A `(derive Arbitrary Debug Op)` in each is a duplicate impl of a foreign trait
;; for a foreign type, and the project build rejects it -- correctly, because which of the two the
;; generator picked would otherwise be a link-order accident.
;;
;; The derive does not belong in `node` either: that is the core IR module, and it must not acquire
;; a dependency on `coil.prop` to satisfy a test. So it lives here, on its own, and both suites
;; import it.
(module oparbitrary)

(import "node" :use *)
(import "coil.prop" :use *)
(import "coil.derive" :use *)

(derive Arbitrary Debug Op)
