(module jsarray)

(import "coil.arraylist" :use *)
(import "coil.alloc" :use * :as alloc)
(import "jsobject" :use *)
(import "jsvalue" :use *)

(const JSA-OK i64 0)
(const JSA-BAD-ARRAY i64 1)
(const JSA-BAD-INDEX i64 2)
(const JSA-NONE i64 -1)

(defstruct JsArray [(object i64) (length i64) (capacity i64)])
(defstruct JsElement [(array i64) (index i64) (value i64) (present bool)])
(defstruct JsArrayHeap
  [(arrays (ArrayList JsArray))
   (elements (ArrayList JsElement))
   (status i64)
   (inited bool)])

(defn jsa-disable-growth-ptr [] (-> (ptr bool)) (let [flag (alloc/static bool)] flag))

(defn jsa-heap [] (-> (ptr JsArrayHeap))
  (let [heap (alloc/static JsArrayHeap)]
    (if (.inited heap) 0
      (do (set! (.inited heap) true)
          (set! (.arrays heap) (al-new [JsArray] (malloc-allocator)))
          (set! (.elements heap) (al-new [JsElement] (malloc-allocator))) 0))
    heap))

(defn jsa-reset! [] (-> i64)
  (let [heap (jsa-heap)]
    (al-clear! [JsArray] (field heap arrays))
    (al-clear! [JsElement] (field heap elements))
    (set! (.status heap) JSA-OK)
    (set! (jsa-disable-growth-ptr) false)
    0))

(defn jsa-valid? [(array i64)] (-> bool)
  (and (>= array 0) (< array (al-len [JsArray] (.arrays (jsa-heap))))))

(defn jsa-array-make [(object i64) (length i64) (capacity i64)] (-> JsArray)
  (JsArray :object object :length length :capacity capacity))

(defn jsa-element-make [(array i64) (index i64) (value i64) (present bool)] (-> JsElement)
  (JsElement :array array :index index :value value :present present))

(defn jsa-new! [] (-> i64)
  (let [heap (jsa-heap) id (al-len [JsArray] (.arrays heap))
        object (jso-new! JSO-NONE)]
    (if (= object JSO-NONE) (do (set! (.status heap) JSA-BAD-ARRAY) JSA-NONE)
      (do (al-push! [JsArray] (field heap arrays) (jsa-array-make object 0 0)) id))))

(defn jsa-record [(array i64)] (-> JsArray)
  (al-get [JsArray] (.arrays (jsa-heap)) array))

(defn jsa-object [(array i64)] (-> i64)
  (if (jsa-valid? array) (let [record (jsa-record array)] (.object record)) JSO-NONE))
(defn jsa-length [(array i64)] (-> i64)
  (if (jsa-valid? array) (let [record (jsa-record array)] (.length record)) 0))
(defn jsa-capacity [(array i64)] (-> i64)
  (if (jsa-valid? array) (let [record (jsa-record array)] (.capacity record)) 0))

(defn jsa-element-index [(array i64) (index i64)] (-> i64)
  (let [elements (.elements (jsa-heap))
        (mut at) (- (al-len [JsElement] elements) 1) (mut found) JSA-NONE]
    (loop (if (or (< (load at) 0) (!= (load found) JSA-NONE)) (break)
      (let [element (al-get [JsElement] elements (load at))]
        (if (and (= (.array element) array)
                 (= (.index element) index))
            (set! found (load at)) 0)
        (set! at (- (load at) 1)))))
    (load found)))

(defn jsa-present? [(array i64) (index i64)] (-> bool)
  (let [at (jsa-element-index array index)]
    (and (!= at JSA-NONE)
         (let [element (al-get [JsElement] (.elements (jsa-heap)) at)]
           (.present element)))))

(defn jsa-load [(array i64) (index i64)] (-> i64)
  (if (or (not (jsa-valid? array)) (or (< index 0) (>= index (jsa-length array))))
      JSV-UNDEFINED
    (let [at (jsa-element-index array index)]
      (if (= at JSA-NONE) JSV-UNDEFINED
        (let [element (al-get [JsElement] (.elements (jsa-heap)) at)]
          (if (.present element) (.value element) JSV-UNDEFINED))))))

(defn jsa-next-capacity [(capacity i64) (needed i64)] (-> i64)
  (let [(mut next) (if (< capacity 4) 4 capacity)]
    (loop (if (>= (load next) needed) (break)
      (set! next (* (load next) 2))))
    (load next)))

(defn jsa-store! [(array i64) (index i64) (value i64)] (-> i64)
  (let [heap (jsa-heap)]
    (if (not (jsa-valid? array))
        (do (set! (.status heap) JSA-BAD-ARRAY) JSA-BAD-ARRAY)
      (if (< index 0) (do (set! (.status heap) JSA-BAD-INDEX) JSA-BAD-INDEX)
        (let [(mut record) (jsa-record array) needed (+ index 1)]
          (if (and (> needed (.capacity record))
                   (load (jsa-disable-growth-ptr)))
              (do (set! (.status heap) JSA-BAD-INDEX) JSA-BAD-INDEX)
            (do
              (if (> needed (.capacity record))
                  (set! (.capacity record) (jsa-next-capacity (.capacity record) needed)) 0)
              (if (> needed (.length record)) (set! (.length record) needed) 0)
              (al-set! [JsArray] (field heap arrays) array (load record))
              (let [at (jsa-element-index array index)]
                (if (= at JSA-NONE)
                    (al-push! [JsElement] (field heap elements)
                              (jsa-element-make array index value true))
                  (let [(mut element) (al-get [JsElement] (.elements heap) at)]
                    (set! (.value element) value)
                    (set! (.present element) true)
                    (al-set! [JsElement] (field heap elements) at (load element)))))
              (set! (.status heap) JSA-OK)
              JSA-OK)))))))

(defn jsa-push! [(array i64) (value i64)] (-> i64)
  (let [index (jsa-length array)]
    (if (= (jsa-store! array index value) JSA-OK) (jsa-length array) JSA-NONE)))

(defn jsa-pop! [(array i64)] (-> i64)
  (if (or (not (jsa-valid? array)) (= (jsa-length array) 0)) JSV-UNDEFINED
    (let [(mut record) (jsa-record array) index (- (.length record) 1)
          value (jsa-load array index) at (jsa-element-index array index)]
      (set! (.length record) index)
      (al-set! [JsArray] (field (jsa-heap) arrays) array (load record))
      (if (!= at JSA-NONE)
          (let [(mut element) (al-get [JsElement] (.elements (jsa-heap)) at)]
            (set! (.present element) false)
            (set! (.value element) JSV-UNDEFINED)
            (al-set! [JsElement] (field (jsa-heap) elements) at (load element))) 0)
      value)))

(defn jsa-slice! [(array i64) (start i64) (end i64)] (-> i64)
  (if (not (jsa-valid? array)) JSA-NONE
    (let [length (jsa-length array)
          from (if (< start 0) (if (< (+ length start) 0) 0 (+ length start))
                 (if (> start length) length start))
          to (if (< end 0) (if (< (+ length end) 0) 0 (+ length end))
               (if (> end length) length end))
          result (jsa-new!) (mut index) from]
      (loop (if (>= (load index) to) (break)
        (do (if (jsa-present? array (load index))
                (jsa-store! result (- (load index) from) (jsa-load array (load index))) 0)
            (set! index (+ (load index) 1)))))
      ; Slice preserves trailing/all holes, so length changes even when no element was stored.
      (let [(mut record) (jsa-record result) size (if (> to from) (- to from) 0)]
        (set! (.length record) size)
        (if (> size (.capacity record))
            (set! (.capacity record) (jsa-next-capacity 0 size)) 0)
        (al-set! [JsArray] (field (jsa-heap) arrays) result (load record)))
      result)))

(defn jsa-property-store! [(array i64) (name (slice u8)) (value i64)] (-> i64)
  (if (not (jsa-valid? array)) JSA-BAD-ARRAY
    (jso-store! (jsa-object array) name value)))
(defn jsa-property-load [(array i64) (name (slice u8))] (-> i64)
  (if (not (jsa-valid? array)) JSV-UNDEFINED
    (jso-load (jsa-object array) name)))
(defn jsa-status [] (-> i64) (.status (jsa-heap)))
