                                                  (field (machine-unit) internal-call-offsets)
                                                  bl-off)
                                        (al-push! [i64]
                                                  (field (machine-unit) internal-call-targets)
                                                  (load (field m imm)))
                                        (be-u32! (a64-bl (if (< target 0)
                                                            0
                                                            (/ (- target bl-off) 4))))
                                        0))))
                            (if (> (.capture-count
                                     (mu-call-bundle (mu-inst-call-bundle (load i)))) 0)
                                (do
                                  (be-emit-abi-parallel-moves!
                                    (.capture-first
                                      (mu-call-bundle (mu-inst-call-bundle (load i))))
                                    area base-area)
                                  (be-add-sp! area))
                                (do
                                  (if (= (be-register-class dst) MRC-FPR)
                                      (be-u32! (a64-fmov-d 30 0))
                                      (be-u32! (a64-add-reg 14 0 31)))
                                  (be-add-sp! area)
                                  (if (= (be-register-class dst) MRC-FPR)
                                      (be-u32! (a64-fmov-d (- rd 32) 30))
                                      (be-u32! (a64-add-reg rd 14 31)))
                                  0))
                            0)
                            MI-JSPROP
                          (let [key (ms-inst-arg (load i) 0)
                                rk (be-read-value! key 17)]
                            ; x0=owner, x1=runtime PropertyKey, x2=boxed value/raw prototype,
                            ; x3=operation. Preserve every source before assigning ABI registers.
                            (be-u32! (a64-sub-imm 31 31 32))
                            (be-u32! (a64-str ra 31 0))
                            (be-u32! (a64-str rb 31 8))
                            (be-u32! (a64-str rk 31 16))
                            (be-u32! (a64-ldr 0 31 0))
                            (be-u32! (a64-ldr 1 31 16))
                            (be-u32! (a64-ldr 2 31 8))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-imm 31 31 32))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-JSARRAY
                          (let [value (ms-inst-arg (load i) 0)
                                rv (be-read-value! value 17)]
                            ; x0=owner, x1=dynamic integer index, x2=boxed value,
                            ; x3=operation. Three caller-saved temporaries implement the parallel
                            ; ABI move without a stack frame around every dense-array access.
                            (be-u32! (a64-add-reg 14 ra 31))
                            (be-u32! (a64-add-reg 15 rb 31))
                            (be-u32! (a64-add-reg 16 rv 31))
                            (be-u32! (a64-add-reg 0 14 31))
                            (be-u32! (a64-add-reg 1 15 31))
                            (be-u32! (a64-add-reg 2 16 31))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-JSSTRING
                          (let [value (ms-inst-arg (load i) 0)
                                rv (be-read-value! value 17)
                                exception-fence
                                  (or (= (.imm m) 201)
                                      (or (= (.imm m) 202)
                                          (or (= (.imm m) 203) (= (.imm m) 204))))]
                            ; x0=a, x1=b, x2=third value, x3=operation.
                            (be-u32! (a64-sub-imm 31 31 32))
                            (if exception-fence
                                (be-u32! (a64-str 31 31 0))
                            (if (= (load (field m imm)) JSSOP-FROM-DOUBLE-BITS)
                                (do
                                  (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                                  (be-u32! (a64-str 15 31 0))
                                  0)
                                (be-u32! (a64-str ra 31 0))))
                            (be-u32! (a64-str (if exception-fence 31 rb) 31 8))
                            (be-u32! (a64-str (if exception-fence 31 rv) 31 16))
                            (be-u32! (a64-ldr 0 31 0))
                            (be-u32! (a64-ldr 1 31 8))
                            (be-u32! (a64-ldr 2 31 16))
                            (be-mov-imm! 3 (load (field m imm)))
                            (be-u32! (a64-bl 0))
                            (be-u32! (a64-add-reg 14 0 31))
                            (be-u32! (a64-add-imm 31 31 32))
                            (be-u32! (a64-add-reg rd 14 31))
                            0)
                            MI-B
                          (let [target (be-label-off (load (field m imm)))
                                here (load (field m first))]
                            (if (or (< target 0) (>= target (load expected-size)))
                                (do
                                  (fmt (stderr)
                                       "invalid-aarch64-branch inst={d} owner={d} ideal={d} op={d} label={d} source={d} target={d} code-size={d}\n"
                                       (load i) (load (field m owner)) (load (field m node))
                                       (load (field m op)) (load (field m imm)) here target
                                       (load expected-size))
                                  (be-fail! BER-ENCODING (load (field m node)))
                                  -1)
                                (be-u32! (a64-b (/ (- target here) 4)))))
                          ; Allocation is an external runtime safepoint. The object writer relocates
                          ; the slow-path zero BL to `_aot_alloc_slow`. x28 points at
                          ; {cursor,limit,stress}; the ordinary path bumps and writes
                          ; the header without entering C. x0=size, x1=shape, x0=result
                          ; on the slow path.
                          MI-NEW
                            (if (be-runtime-allocation?)
                                (let [size (shape-size (load (field m imm)))
                                      shape (load (field m imm))
                                      sw 4
                                      shw 4
                                      cw (+ 6 sw)]
                                  (be-u32! (a64-ldr 9 28 0))
                                  (be-u32! (a64-ldr 10 28 8))
                                  (be-mov-imm-fixed! 11 size)
                                  (be-u32! (a64-add-reg 11 9 11))
                                  (be-u32! (a64-cmp-reg 11 10))
                                  (be-u32! (a64-bcond 8 (+ 7 (+ shw cw))))
                                  (be-u32! (a64-ldr 10 28 16))
                                  (be-u32! (a64-cbnz 10 (+ 5 (+ shw cw))))
                                  (be-u32! (a64-str 11 28 0))
                                  (be-u32! (a64-add-reg 0 9 31))
                                  (be-mov-imm-fixed! 10 shape)
                                  (be-u32! (a64-str 10 0 0))
                                  ; Exact allocation metrics live in the thread state so the
                                  ; generated fast path and C slow path share one counter domain.
                                  (be-u32! (a64-ldr 15 28 72))
                                  (be-u32! (a64-add-imm 15 15 1))
                                  (be-u32! (a64-str 15 28 72))
                                  (be-u32! (a64-ldr 15 28 80))
                                  (be-mov-imm-fixed! 16 size)
                                  (be-u32! (a64-add-reg 15 15 16))
                                  (be-u32! (a64-str 15 28 80))
                                  (be-u32! (a64-b (+ 2 (+ sw shw))))
                                  (be-mov-imm-fixed! 0 size)
                                  (be-mov-imm-fixed! 1 shape)
                                  (be-u32! (a64-bl 0))
                                  (be-u32! (a64-add-reg rd 0 31))
                                  0)
                                (be-u32! (a64-add-imm rd
                                                      3
                                                      (* (graph-new-index (load (field m node))) 128))))
                          MI-LOAD
                            (if (= (be-register-class dst) MRC-FPR)
                                (be-u32! (a64-ldr-d (- rd 32) ra (load (field m imm))))
                                (be-u32! (a64-ldr rd ra (load (field m imm)))))
                          MI-STORE
                            (do
                              (if (= (be-register-class (load (field m b))) MRC-FPR)
                                  (be-u32! (a64-str-d (- rb 32) ra (load (field m imm))))
                                  (be-u32! (a64-str rb ra (load (field m imm)))))
                              (if (= (be-store-barrier-kind m) MLK-BOXED)
                                  (do
                                    ; A dynamic store dirties an old receiver conservatively. The
                                    ; collector subsequently decodes only exact managed tags, so
                                    ; scalar boxed values cannot become roots.
                                    (be-u32! (a64-ldr 15 28 24))
                                    (be-u32! (a64-cmp-reg ra 15))
                                    (be-u32! (a64-bcond 3 9))
                                    (be-u32! (a64-ldr 16 28 32))
                                    (be-u32! (a64-cmp-reg ra 16))
                                    (be-u32! (a64-bcond 2 6))
                                    (be-u32! (a64-movz 15 1 0))
                                    (be-u32! (a64-str 15 28 56))
                                    (be-u32! (a64-ldr 16 28 64))
                                    (be-u32! (a64-add-imm 16 16 1))
                                    (be-u32! (a64-str 16 28 64))
                                    0)
                                  (if (be-store-barrier? m)
                                      (do
                                        ; Inline remembered-set barrier. x15/x16 are
                                        ; reserved scratch registers; the four range
                                        ; checks recognize old-object -> young-value.
                                        (be-u32! (a64-ldr 15 28 24))
                                        (be-u32! (a64-cmp-reg ra 15))
                                        (be-u32! (a64-bcond 3 15))
                                        (be-u32! (a64-ldr 16 28 32))
                                        (be-u32! (a64-cmp-reg ra 16))
                                        (be-u32! (a64-bcond 2 12))
                                        (be-u32! (a64-ldr 15 28 40))
                                        (be-u32! (a64-cmp-reg rb 15))
                                        (be-u32! (a64-bcond 3 9))
                                        (be-u32! (a64-ldr 16 28 48))
                                        (be-u32! (a64-cmp-reg rb 16))
                                        (be-u32! (a64-bcond 2 6))
                                        (be-u32! (a64-movz 15 1 0))
                                        (be-u32! (a64-str 15 28 56))
                                        (be-u32! (a64-ldr 16 28 64))
                                        (be-u32! (a64-add-imm 16 16 1))
                                        (be-u32! (a64-str 16 28 64))
                                        0)
                                      0))
                              0)
                          MI-NEG (be-u32! (a64-sub-reg rd 31 ra))
                          MI-CALL-RESULT
                            0
                          MI-RET
                            (do
                              (if (> (load (field m imm)) 1)
                                  (be-emit-abi-parallel-moves! (load i) 0 0)
                                  (if (= (be-register-class (load (field m a))) MRC-FPR)
                                      (if (= ra 32) 0
                                          (be-u32! (a64-fmov-d 0 (- ra 32))))
                                      (if (= ra 0) 0 (be-u32! (a64-add-reg 0 ra 31)))))
                              (if (< (load (field m owner)) 0)
                                  (be-u32! (a64-add-imm 31 31 2048))
                                  (let [frame (mu-function-frame-size (load (field m owner)))]
                                    (let [owner (load (field m owner))
                                          mask (mu-function-callee-mask (load (field m owner)))
                                          (mut reg) 19]
                                      (loop (if (> (load reg) 28)
                                                (break)
                                                (do
                                                  (if (!= (& mask (<< 1 (load reg))) 0)
                                                      (be-u32! (a64-ldr (load reg)
                                                                        31
                                                                        (be-callee-save-off owner (load reg))))
                                                      0)
                                                  (store! reg (+ (load reg) 1))
                                                  0))))
                                    (let [owner (load (field m owner))
                                          mask (mu-function-callee-mask (load (field m owner)))
                                          (mut reg) 40]
                                      (loop (if (> (load reg) 47)
                                                (break)
                                                (do
                                                  (if (!= (& mask (<< 1 (load reg))) 0)
                                                      (be-u32! (a64-ldr-d (- (load reg) 32)
                                                                          31
                                                                          (be-callee-save-off owner (load reg))))
                                                      0)
                                                  (store! reg (+ (load reg) 1))
                                                  0))))
                                    (be-u32! (a64-ldr 29 31 0))
                                    (be-u32! (a64-ldr 30 31 8))
                                    (be-add-sp! frame)
                                    0))
                              (be-u32! (a64-ret))
                              0)
                          0)
                        ;; MI-CALL-RESULT names a snapshot already placed by the call's parallel
                        ;; ABI capture. It emits no defining instruction here; a generic spill
                        ;; store would overwrite that captured value with stale x14.
                        (if (and (and (>= dst 0) (!= op MI-CALL-RESULT))
                                 (not (and (= op MI-CALL)
                                           (> (be-call-result-count
                                                (load (field m node))) 1))))
                            (be-store-written! dst rd) 0)
                        (set! i (+ (load i) 1))
                        0)))))
      (if (and (= (be-result) BER-OK) (!= (be-code-len) (load expected-size)))
          (do
            (fmt (stderr) "encoding-final-size-mismatch expected={d} actual={d}\n"
                 (load expected-size) (be-code-len))
            (be-fail! BER-ENCODING NO-NODE)
            0)
          0)
      (be-code-len))))

(defn be-encode-checked! [] (-> bool)
  (if (!= (be-result) BER-OK)
      false
      (let [n (be-inst-count)
            (mut i) 0
            (mut bad) NO-NODE]
        (loop (if (or (>= (load i) n) (!= (load bad) NO-NODE))
                  (break)
                  (do
                    (let [m (be-inst (load i))
                          op (.op m)]
                      (if (not (mi-desc-encodable? (mi-desc op)))
                          (set! bad (.node m))
                          0))
                    (set! i (+ (load i) 1))
                    0)))
        (if (!= (load bad) NO-NODE)
            (be-fail! BER-ENCODING (load bad))
            (do
              (be-encode!)
              (if (> (be-code-len) 0) true (be-fail! BER-ENCODING NO-NODE)))))))

(defn be-code-len [] (-> i64)
  (if (= (be-result) BER-OK) (* 4 (al-len [i64] (.a64-code (backend)))) 0))
(defn be-code-byte [(i i64)] (-> i64)
  (& (>> (al-get [i64] (.a64-code (backend)) (/ i 4)) (* (& i 3) 8)) 255))
(defn be-code-u32 [(at i64)] (-> i64)
  (al-get [i64] (.a64-code (backend)) (/ at 4)))

(defn be-code-set-u32! [(at i64) (word i64)] (-> i64)
  (let [words (field (backend) a64-code)]
    (al-set! [i64] words (/ at 4) word)
    0))
