;; AArch64 instruction encoding and checked code-byte publication.
(module backend_aarch64)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(defn a64-movz [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 2 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-movk [(rd i64) (imm i64) (hw i64)] (-> i64)
  (| (<< 1 31) (| (<< 3 29) (| (<< 37 23) (| (<< hw 21) (| (<< (& imm 65535) 5) rd))))))
(defn a64-add-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd)))))
(defn a64-sub-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) rd))))))
(defn a64-and-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2315255808 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-orr-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2852126720 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-eor-reg [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 3388997632 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-mvn [(rd i64) (rm i64)] (-> i64)
  (| 2854224864 (| (<< rm 16) rd)))
(defn a64-adr [(rd i64) (byte-delta i64)] (-> i64)
  (let [imm (& byte-delta 2097151)
        lo (& imm 3)
        hi (>> imm 2)]
    (| 268435456 (| (<< lo 29) (| (<< hi 5) rd)))))
(defn a64-blr [(rn i64)] (-> i64)
  (| 3594452992 (<< rn 5)))
(defn a64-msub [(rd i64) (rn i64) (rm i64) (ra i64)] (-> i64)
  (| 2600501248 (| (<< rm 16) (| (<< ra 10) (| (<< rn 5) rd)))))
(defn a64-lslv [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2596282368 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-lsrv [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2596283392 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-asrv [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2596284416 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-sxtw [(rd i64) (rn i64)] (-> i64)
  (| 2470476800 (| (<< rn 5) rd)))
(defn a64-uxtw [(rd i64) (rn i64)] (-> i64)
  (| 3544218624 (| (<< rn 5) rd)))
(defn a64-sxt48 [(rd i64) (rn i64)] (-> i64)
  (| 2470445056 (| (<< 47 10) (| (<< rn 5) rd))))
(defn a64-lsr48 [(rd i64) (rn i64)] (-> i64)
  (| 3544186880 (| (<< 48 16) (| (<< 63 10) (| (<< rn 5) rd)))))
(defn a64-brk [] (-> i64)
  3558866944)
(defn a64-mul [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 27 24) (| (<< rm 16) (| (<< 31 10) (| (<< rn 5) rd))))))
(defn a64-sdiv [(rd i64) (rn i64) (rm i64)] (-> i64)
  (| 2596277248 (| (<< rm 16) (| (<< rn 5) rd))))
(defn a64-ret [] (-> i64)
  3596551104)
(defn a64-cmp-reg [(rn i64) (rm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 1 29) (| (<< 11 24) (| (<< rm 16) (| (<< rn 5) 31)))))))
(defn a64-csinc [(rd i64) (rn i64) (rm i64) (cnd i64)] (-> i64)
  (| (<< 1 31) (| (<< 212 21) (| (<< rm 16) (| (<< cnd 12) (| (<< 1 10) (| (<< rn 5) rd)))))))
(defn a64-cset [(rd i64) (cnd i64)] (-> i64)
  (a64-csinc rd 31 31 (^ cnd 1)))
(defn a64-cbz [(rt i64) (delta-words i64)] (-> i64)
  (| 3019898880 (| (<< (& delta-words 524287) 5) rt)))
(defn a64-cbnz [(rt i64) (delta-words i64)] (-> i64)
  (| 3036676096 (| (<< (& delta-words 524287) 5) rt)))
(defn a64-bcond [(cnd i64) (delta-words i64)] (-> i64)
  (| 1409286144 (| (<< (& delta-words 524287) 5) cnd)))
(defn a64-csel [(rd i64) (rn i64) (rm i64) (cnd i64)] (-> i64)
  (| (<< 1 31) (| (<< 212 21) (| (<< rm 16) (| (<< cnd 12) (| (<< rn 5) rd))))))
(defn a64-b [(delta-words i64)] (-> i64)
  (| 335544320 (& delta-words 67108863)))
(defn a64-bl [(delta-words i64)] (-> i64)
  (| 2483027968 (& delta-words 67108863)))
(defn a64-add-imm [(rd i64) (rn i64) (imm i64)] (-> i64)
  (| (<< 1 31) (| (<< 17 24) (| (<< (& imm 4095) 10) (| (<< rn 5) rd)))))
(defn a64-add-imm-shift12 [(rd i64) (rn i64) (imm i64)] (-> i64)
  (| (<< 1 31)
     (| (<< 17 24) (| (<< 1 22) (| (<< (& imm 4095) 10) (| (<< rn 5) rd))))))
(defn a64-sub-imm [(rd i64) (rn i64) (imm i64)] (-> i64)
  (| (<< 1 31) (| (<< 1 30) (| (<< 17 24) (| (<< (& imm 4095) 10) (| (<< rn 5) rd))))))
(defn a64-ldr [(rt i64) (rn i64) (off i64)] (-> i64)
  (| 4181721088 (| (<< (/ off 8) 10) (| (<< rn 5) rt))))
(defn a64-str [(rt i64) (rn i64) (off i64)] (-> i64)
  (| 4177526784 (| (<< (/ off 8) 10) (| (<< rn 5) rt))))
(defn a64-ldr-d [(dt i64) (rn i64) (off i64)] (-> i64)
  (| 4248829952 (| (<< (/ off 8) 10) (| (<< rn 5) dt))))
(defn a64-str-d [(dt i64) (rn i64) (off i64)] (-> i64)
  (| 4244635648 (| (<< (/ off 8) 10) (| (<< rn 5) dt))))
(defn a64-fmov-d-x [(dd i64) (xn i64)] (-> i64)
  (| 2657550336 (| (<< xn 5) dd)))
(defn a64-fmov-x-d [(xd i64) (dn i64)] (-> i64)
  (| 2657484800 (| (<< dn 5) xd)))
(defn a64-fmov-d [(dd i64) (dn i64)] (-> i64)
  (| 509624320 (| (<< dn 5) dd)))
(defn a64-scvtf-d-x [(dd i64) (xn i64)] (-> i64)
  (| 2657222656 (| (<< xn 5) dd)))
(defn a64-frintz-d [(dd i64) (dn i64)] (-> i64)
  (| 509984768 (| (<< dn 5) dd)))
(defn a64-fcvtzs-x-d [(xd i64) (dn i64)] (-> i64)
  (| 2658664448 (| (<< dn 5) xd)))
(defn a64-fadd-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509618176 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fsub-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509622272 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fmul-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509609984 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fdiv-d [(dd i64) (dn i64) (dm i64)] (-> i64)
  (| 509614080 (| (<< dm 16) (| (<< dn 5) dd))))
(defn a64-fneg-d [(dd i64) (dn i64)] (-> i64)
  (| 509689856 (| (<< dn 5) dd)))
(defn a64-fcmp-d [(dn i64) (dm i64)] (-> i64)
  (| 509616128 (| (<< dm 16) (<< dn 5))))
(defn a64-fcmp-zero-d [(dn i64)] (-> i64)
  (| 509616136 (<< dn 5)))
(defn a64-fcsel-d [(dd i64) (dn i64) (dm i64) (cnd i64)] (-> i64)
  (| 509611008 (| (<< dm 16) (| (<< cnd 12) (| (<< dn 5) dd)))))

;; A machine word is a plain 32-bit pattern. Anything else is an encoder that could not encode
;; what it was given and returned a sentinel instead -- and writing that sentinel's low four bytes
;; produces an illegal instruction which every later check then certifies as valid machine code.
;;
;; That is not hypothetical. The legacy selector, handed a float program, emitted -32/-31/-30 here;
;; they landed as 0xFFFFFFE0/E1/E2, `be-encode-checked!` returned true because the DESCRIPTORS were
;; encodable and the buffer was non-empty, and the first thing to notice was the CPU raising SIGILL.
;;
;; Failing here rather than at the descriptor level is deliberate: this catches any encoder that
;; returns a sentinel, not just the one that did. `be-fail!` clears the buffer and `be-code-len`
;; reports 0 once the result is not BER-OK, so the surrounding `be-encode-checked!` turns this into
;; a named BER-ENCODING failure instead of executable garbage.
(defn be-u32! [(w i64)] (-> i64)
  (if (or (< w 0) (> w 4294967295))
      (do (be-fail! BER-ENCODING NO-NODE) 0)
  (let [words (field (backend) a64-code)]
    (al-push! [i64] words w)
    0)))

; ADD/SUB (immediate) has a 12-bit unshifted immediate. Stack areas are
; 16-byte aligned, so split large adjustments into aligned encodable chunks.
(defn be-sp-adjust-words [(bytes i64)] (-> i64)
  (/ (+ bytes 4079) 4080))

(defn be-sub-sp! [(bytes i64)] (-> i64)
  (let [(mut left) bytes]
    (loop (if (<= (load left) 0)
              (break)
              (let [chunk (if (> (load left) 4080) 4080 (load left))]
                (be-u32! (a64-sub-imm 31 31 chunk))
                (set! left (- (load left) chunk))
                0)))
    0))

(defn be-add-sp! [(bytes i64)] (-> i64)
  (let [(mut left) bytes]
    (loop (if (<= (load left) 0)
              (break)
              (let [chunk (if (> (load left) 4080) 4080 (load left))]
                (be-u32! (a64-add-imm 31 31 chunk))
                (set! left (- (load left) chunk))
                0)))
    0))

;; THROUGH THE LIVE RANGE, not the raw vreg. A coalesced vreg has no register of its own -- the
;; range it was merged into holds it -- so reading `alloc-reg` by vreg answers -1 for every value
;; on the non-root side of a merge, and the encoder then emits a sentinel.
(defn be-reg-of [(vr i64)] (-> i64)
  (let [dense (.alloc-reg (machine-unit))
        root (mra-lrg vr)]
    (if (and (>= root 0) (< root (al-len [i64] dense)))
        (al-get dense root)
        -1)))

(defn be-spill-of [(vr i64)] (-> i64)
  (let [dense (.alloc-spill (machine-unit))
        root (mra-lrg vr)]
    (if (and (>= root 0) (< root (al-len [i64] dense)))
        (al-get dense root)
        -1)))

(defn be-owner-of [(vr i64)] (-> i64)
  (let [dense (.alloc-owner (machine-unit))]
    (if (and (>= vr 0) (< vr (al-len [i64] dense)))
        (al-get dense vr)
        -1)))

(defn be-spill-off [(slot i64)] (-> i64)
  (+ 1024 (* slot 8)))
(defn be-spill-off-vreg [(vr i64)] (-> i64)
  ;; Encoding and object publication run after allocation has already published dense vreg
  ;; ownership and spill tables. Looking the defining instruction up with two whole-program scans
  ;; here made stack-map serialization O(roots * instructions).
  (let [slot (mra-spill vr)
        owner (mra-owner vr)]
    (if (>= owner 0)
        (+ 16 (* (+ (mu-function-callee-count owner) slot) 8))
        (be-spill-off slot))))

;; AArch64's unsigned 64-bit LDR/STR immediate is scaled by eight and only twelve bits wide.
;; Large generated JSL functions routinely exceed its 32,760-byte ceiling. Encoding the low bits
;; of a larger frame offset aliases unrelated spill slots, so every stack access goes through this
;; checked seam and materializes an address when the direct form cannot represent it.
(defn be-stack-offset-direct? [(off i64)] (-> bool)
  (and (>= off 0) (and (= (& off 7) 0) (<= off 32760))))

(defn be-stack-access-words [(off i64)] (-> i64)
  (if (be-stack-offset-direct? off) 1
      (let [pages (/ off 4096) tail (& off 4095)]
        (+ 1 (+ (/ (+ pages 4094) 4095) (if (> tail 0) 1 0))))))

(defn be-stack-address! [(target i64) (base i64) (off i64)] (-> i64)
  (let [(mut pages) (/ off 4096)
        tail (& off 4095)
        (mut first) true]
    (loop (if (<= (load pages) 0) (break)
              (let [chunk (if (> (load pages) 4095) 4095 (load pages))]
                (be-u32! (a64-add-imm-shift12 target
                            (if (load first) base target) chunk))
                (set! first false)
                (set! pages (- (load pages) chunk))
                0)))
    (if (> tail 0)
        (be-u32! (a64-add-imm target (if (load first) base target) tail)) 0)
    0))

(defn be-stack-load-gpr! [(target i64) (base i64) (off i64)] (-> i64)
  (if (be-stack-offset-direct? off)
      (be-u32! (a64-ldr target base off))
      (do
        ;; `target` may also be the address scratch: the address is consumed by the load before
        ;; the loaded word replaces it. ADD (immediate), unlike ADD (shifted register), permits SP
        ;; as its base register.
        (be-stack-address! target base off)
        (be-u32! (a64-ldr target target 0))))
  0)

(defn be-stack-load-fpr! [(target i64) (base i64) (off i64) (address i64)] (-> i64)
  (if (be-stack-offset-direct? off)
      (be-u32! (a64-ldr-d target base off))
      (do
        (be-stack-address! address base off)
        (be-u32! (a64-ldr-d target address 0))))
  0)

(defn be-stack-store-gpr! [(source i64) (base i64) (off i64) (address i64)] (-> i64)
  (if (be-stack-offset-direct? off)
      (be-u32! (a64-str source base off))
      (do
        (if (= source address)
            (panic-corrupt "large stack store aliases its address scratch") 0)
        (be-stack-address! address base off)
        (be-u32! (a64-str source address 0))))
  0)

(defn be-stack-store-fpr! [(source i64) (base i64) (off i64) (address i64)] (-> i64)
  (if (be-stack-offset-direct? off)
      (be-u32! (a64-str-d source base off))
      (do
        (be-stack-address! address base off)
        (be-u32! (a64-str-d source address 0))))
  0)

(defn be-call-result-setup-words
  [(owner i64) (area i64) (result-area i64)] (-> i64)
  (if (> result-area 0)
      (+ 1
         (+ (be-stack-access-words
              (+ area (mu-function-outgoing-result-pointer-offset owner)))
            (/ result-area 8)))
      0))

;; Legacy single-return selection predates machine liveness and therefore has no class table. Its
;; existing values are all GPRs; machine-program selection always publishes the explicit class.
(defn be-register-class [(vr i64)] (-> i64)
  (let [classes (.register-class (machine-unit))]
    (if (or (< vr 0) (or (< (be-owner-of vr) 0) (>= vr (al-len [i64] classes))))
        MRC-GPR
        (al-get classes vr))))

(defn be-callee-save-off [(owner i64) (reg i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner)
        (mut r) 19
        (mut rank) 0]
    (loop (if (>= (load r) reg)
              (break)
              (do
                (if (!= (& mask (<< 1 (load r))) 0) (set! rank (+ (load rank) 1)) 0)
                (set! r (+ (load r) 1))
                0)))
    (+ 16 (* (load rank) 8))))

(defn be-read-reg! [(vr i64) (scratch i64)] (-> i64)
  (if (< vr 0)
      -1
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)]
              (if (< s 0) -1
                  (do (be-stack-load-gpr! scratch 31 (be-spill-off-vreg vr)) scratch)))))))

(defn be-read-value! [(vr i64) (scratch i64)] (-> i64)
  (if (or (< vr 0) (= (be-register-class vr) MRC-GPR))
      (be-read-reg! vr scratch)
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)
                  ds (if (= scratch 15) 30 31)]
              (if (< s 0)
                  -1
                  (do (be-stack-load-fpr! ds 31 (be-spill-off-vreg vr) scratch) (+ ds 32))))))))

(defn be-read-reg-delta! [(vr i64) (scratch i64) (sp-delta i64)] (-> i64)
  (if (< vr 0)
      -1
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)]
              (if (< s 0)
                  -1
                  (do (be-stack-load-gpr! scratch 31 (+ sp-delta (be-spill-off-vreg vr))) scratch)))))))

(defn be-read-value-delta! [(vr i64) (scratch i64) (sp-delta i64)] (-> i64)
  (if (= (be-register-class vr) MRC-GPR)
      (be-read-reg-delta! vr scratch sp-delta)
      (let [r (be-reg-of vr)]
        (if (>= r 0)
            r
            (let [s (be-spill-of vr)
                  ds (if (= scratch 15) 30 31)]
              (if (< s 0)
                  -1
                  (do
                    (be-stack-load-fpr! ds 31 (+ sp-delta (be-spill-off-vreg vr)) scratch)
                    (+ ds 32))))))))

(defn be-write-reg [(vr i64)] (-> i64)
  (let [r (be-reg-of vr)]
    (if (>= r 0) r (if (= (be-register-class vr) MRC-FPR) 62 14))))

(defn be-store-written! [(vr i64) (from i64)] (-> i64)
  (let [s (be-spill-of vr)]
    (if (< s 0)
        0
        (if (= (be-register-class vr) MRC-FPR)
            (be-stack-store-fpr! (- from 32) 31 (be-spill-off-vreg vr) 15)
            (be-stack-store-gpr! from 31 (be-spill-off-vreg vr)
                                 (if (= from 15) 16 15))))))

(defn be-abi-spill-off [(owner i64) (slot i64)] (-> i64)
  (+ 16 (* (+ (mu-function-callee-count owner) slot) 8)))

(defn be-emit-abi-parallel-moves! [(at i64) (sp-delta i64) (result-base i64)] (-> i64)
  (let [count (mu-abi-move-count at) (mut move) 0]
    (loop (if (>= (load move) count) (break)
              (let [p (mu-abi-move at (load move))
                    fp (= (.dst-class p) MRC-FPR)
                    scratch (if fp 62 15)
                    source
                      (case (.src-kind p) MLOC-REGISTER (.src-index p)
                            MLOC-SCRATCH scratch
                            MLOC-SPILL
                              (do
                                (if fp
                                    (be-stack-load-fpr!
                                      30 31
                                      (+ sp-delta (be-abi-spill-off
                                        (.owner p) (.src-index p)))
                                      15)
                                    (be-stack-load-gpr!
                                      15 31
                                      (+ sp-delta (be-abi-spill-off
                                        (.owner p) (.src-index p)))))
                                scratch)
                            MLOC-RESULT-AREA
                              (do
                                (if fp
                                    (be-u32! (a64-ldr-d 30 31
                                                        (+ result-base (.src-index p))))
                                    (be-u32! (a64-ldr 15 31
                                                      (+ result-base (.src-index p)))))
                                scratch)
                            -1)]
                (case (.dst-kind p) MLOC-REGISTER
                      (if (= source (.dst-index p)) 0
                          (if fp
                              (be-u32! (a64-fmov-d (- (.dst-index p) 32) (- source 32)))
                              (be-u32! (a64-add-reg (.dst-index p) source 31))))
                      MLOC-SCRATCH
                      (if (= source scratch) 0
                          (if fp
                              (be-u32! (a64-fmov-d 30 (- source 32)))
                              (be-u32! (a64-add-reg 15 source 31))))
                      MLOC-SPILL
                      (if fp
                          (be-stack-store-fpr!
                            (- source 32) 31
                            (+ sp-delta (be-abi-spill-off (.owner p) (.dst-index p)))
                            15)
                          (be-stack-store-gpr!
                            source 31
                            (+ sp-delta (be-abi-spill-off (.owner p) (.dst-index p)))
                            (if (= source 15) 16 15)))
                      MLOC-RESULT-AREA
                      (do
                        (be-stack-load-gpr!
                          14 31 (mu-function-result-pointer-offset (.owner p)))
                        (if fp
                            (be-u32! (a64-str-d (- source 32) 14 (.dst-index p)))
                            (be-u32! (a64-str source 14 (.dst-index p))))
                        0)
                      (panic-corrupt "unknown parallel ABI destination location"))
                (set! move (+ (load move) 1)))))
    0))

(defn be-entry-label-owner [(bid i64)] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0
        (mut found) -1]
    (loop (if (or (>= (load owner) funcs) (>= (load found) 0))
              (break)
              (do
                (if (= (mu-function-block (load owner) 0) bid) (set! found (load owner)) 0)
                (set! owner (+ (load owner) 1))
                0)))
    (load found)))

(defn be-align16 [(n i64)] (-> i64)
  (& (+ n 15) -16))
(defn be-call-area [(argc i64)] (-> i64)
  (be-align16 (* argc 8)))
(defn be-call-spill-load-words [(m (ptr MInst)) (sp-delta i64)] (-> i64)
  (let [count (.arg-count m)
        first (.arg-first m)
        (mut i) 0
        (mut loads) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (let [vr (al-get (.call-args (machine-unit)) (+ first (load i)))]
                  (if (< (be-reg-of vr) 0)
                      (set! loads
                            (+ (load loads)
                               (be-stack-access-words
                                 (+ sp-delta (be-spill-off-vreg vr)))))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load loads)))

(defn be-call-arg-class-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [first (.arg-first m)
        class (ms-call-arg-class m which)
        (mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do
                (if (= (ms-call-arg-class m (load i)) class)
                    (set! index (+ (load index) 1)) 0)
                (set! i (+ (load i) 1))
                0)))
    (load index)))

(defn be-call-register-loads [(m (ptr MInst))] (-> i64)
  (let [count (.arg-count m)
        (mut i) 0
        (mut loads) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (< (be-call-arg-class-index m (load i)) 8)
                    (set! loads (+ (load loads) 1))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load loads)))

(defn be-call-stack-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [(mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do
                (if (>= (be-call-arg-class-index m (load i)) 8)
                    (set! index (+ (load index) 1))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load index)))

(defn be-call-stack-count [(m (ptr MInst))] (-> i64)
  (let [count (.arg-count m)
        (mut i) 0
        (mut stack) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (>= (be-call-arg-class-index m (load i)) 8)
                    (set! stack (+ (load stack) 1))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load stack)))

(defn be-mov-imm! [(rd i64) (v i64)] (-> i64)
  (be-u32! (a64-movz rd (& v 65535) 0))
  (let [(mut hw) 1]
    (loop (if (>= (load hw) 4)
              (break)
              (do
                (let [part (& (>> v (* (load hw) 16)) 65535)]
                  (if (= part 0) 0 (be-u32! (a64-movk rd part (load hw)))))
                (set! hw (+ (load hw) 1))
                0)))
    0))

(defn be-mov-imm-fixed! [(rd i64) (v i64)] (-> i64)
  (be-u32! (a64-movz rd (& v 65535) 0))
  (be-u32! (a64-movk rd (& (>> v 16) 65535) 1))
  (be-u32! (a64-movk rd (& (>> v 32) 65535) 2))
  (be-u32! (a64-movk rd (& (>> v 48) 65535) 3))
  0)

;; Materialize a code address without ADR's signed +/-1 MiB limit. The generated Mach-O object is
;; copied to an arbitrary mmap base by the Darwin in-memory loader, so absolute section addresses
;; and page-base assumptions are both wrong. ADR self plus a fixed-width signed delta is invariant
;; under that copy and keeps instruction sizing independent of the final layout.
(defn be-relative-code-address! [(rd i64) (scratch i64) (target i64)] (-> i64)
  (let [here (be-code-len)]
    (be-u32! (a64-adr rd 0))
    (be-mov-imm-fixed! scratch (- target here))
    (be-u32! (a64-add-reg rd rd scratch))
    0))

(defn be-relocatable-code-address! [(source-owner i64) (target-owner i64)
                                     (rd i64) (scratch i64) (target i64)] (-> i64)
  (let [site (be-code-len)]
    (al-push! [i64] (field (machine-unit) internal-address-sources) source-owner)
    (al-push! [i64] (field (machine-unit) internal-address-offsets) site)
    (al-push! [i64] (field (machine-unit) internal-address-targets) target-owner)
    (be-relative-code-address! rd scratch target)))

(defn be-mov-words [(v i64)] (-> i64)
  (let [(mut words) 1
        (mut hw) 1]
    (loop (if (>= (load hw) 4)
              (break)
              (do
                (if (= (& (>> v (* (load hw) 16)) 65535) 0)
                    0
                    (set! words (+ (load words) 1)))
                (set! hw (+ (load hw) 1))
                0)))
    (load words)))

(defn be-store-barrier-kind [(m (ptr MInst))] (-> i64)
  (let [node (.node m)]
    (if (and (be-runtime-allocation?)
             (and (>= node 0)
                  (and (< node (n-count))
                       (and (op-is? node Store [_])
                            (shape-alias-defined? (n-store-alias node))))))
        (ml-kind-for-type (shape-alias-ty (n-store-alias node)))
        MLK-SCALAR)))
(defn be-store-barrier? [(m (ptr MInst))] (-> bool)
  (let [kind (be-store-barrier-kind m)]
    (or (= kind MLK-RAW-MANAGED) (= kind MLK-BOXED))))

(defn be-js-managed-tag? [(tag i64)] (-> bool)
  (or (= tag JSV-OBJECT)
      (or (= tag JSV-ARRAY)
          (or (= tag JSV-CLOSURE)
              (or (= tag JSV-REGEXP) (= tag JSV-SYMBOL))))))
(defn be-js-unbox-validation-words [(tag i64)] (-> i64)
  (if (or (= tag JSV-UNDEFINED) (= tag JSV-NULL))
      3
      (if (= tag JSV-BOOLEAN) 4 (if (be-js-managed-tag? tag) 6 0))))

(defn be-poly-call? [(m (ptr MInst))] (-> bool)
  (and (= (.op m) MI-CALL) (< (.imm m) 0)))
(defn be-poly-call-targets [(m (ptr MInst))] (-> i64)
  ;; The finite target summary is DELIBERATELY ignored for dispatch: closed-world inference
  ;; cannot yet see argument flow through dynamic method calls into capture cells, so a
  ;; summary-restricted chain can miss the runtime callee and hit the fallthrough brk
  ;; (NavierStokes stores its display callback through `solver.setDisplayFunction(cb)` and the
  ;; cell's summary never contained it). Dispatching over every unit function is always sound;
  ;; the summary can return as a fast path once the flow analysis covers dynamic stores.
  (if (be-poly-call? m) 0 0))
(defn be-poly-return-code [(owner i64)] (-> i64)
  (be-function-dispatch-return-code owner))
(defn be-poly-call-dispatch-words [(m (ptr MInst))] (-> i64)
  (let [targets (be-poly-call-targets m)
        (mut fidx) 0
        (mut words) 0]
    (if (= targets 0)
        ; An empty summary means the callee's target set was never narrowed. Dispatch over every
        ; function in the unit: a JavaScript value can only carry a JavaScript callable id, so
        ; the extra candidates (JSL internals) simply never match.
        (let [(mut owner) 0]
          (loop (if (>= (load owner) (mu-function-count))
                    (break)
                    (let [symbol (al-get (.symbols (machine-unit)) (load owner))]
                      (if (>= symbol 1)
                          (set! words
                                (+ (load words)
                                   (+ (be-mov-words symbol)
                                      (+ 9 (be-mov-words (be-poly-return-code (load owner)))))))
                          0)
                      (set! owner (+ (load owner) 1))))))
        (loop (if (>= (load fidx) 63)
                  (break)
                  (do
                    (if (!= (& targets (<< 1 (load fidx))) 0)
                        (let [owner (mu-find-function-symbol (load fidx))
                              code (if (< owner 0) -4 (be-poly-return-code owner))]
                          (set! words
                                (+ (load words)
                                   (+ (be-mov-words (load fidx))
                                      (+ 9 (be-mov-words code))))))
                        0)
                    (set! fidx (+ (load fidx) 1))))))
    (load words)))

(defn be-ret-extra-result-words [(m (ptr MInst))] (-> i64)
  (let [(mut result) 1 (mut words) 0]
    (loop (if (>= (load result) (load (field m imm))) (break)
              (let [value
                      (al-get [i64] (.call-args (machine-unit))
                              (+ (load (field m arg-first)) (- (load result) 1)))]
                (if (< (be-reg-of value) 0)
                    (set! words (+ (load words) 2))
                    (let [target (+ (load result)
                                    (if (= (be-register-class value) MRC-FPR) 32 0))]
                      (if (!= (be-reg-of value) target)
                          (set! words (+ (load words) 1)) 0)))
                (set! result (+ (load result) 1)))))
    (load words)))

(defn be-abi-parallel-move-words [(at i64) (sp-delta i64)] (-> i64)
  (let [count (mu-abi-move-count at) (mut move) 0 (mut words) 0]
    (loop (if (>= (load move) count) (break)
              (let [p (mu-abi-move at (load move))]
                ;; Mirror be-emit-abi-parallel-moves! exactly. A register-to-the-same-register
                ;; move and a scratch-to-the-same-scratch move emit no destination instruction;
                ;; counting one here shifts every following label and PC-relative relocation.
                (let [fp (= (.dst-class p) MRC-FPR)
                      scratch (if fp 62 15)
                      source
                        (case (.src-kind p) MLOC-REGISTER (.src-index p)
                              MLOC-SCRATCH scratch
                              MLOC-SPILL scratch
                              MLOC-RESULT-AREA scratch
                              -1)
                      source-load
                        (case (.src-kind p)
                          MLOC-SPILL
                            (be-stack-access-words
                              (+ sp-delta
                                 (be-abi-spill-off (.owner p) (.src-index p))))
                          MLOC-RESULT-AREA 1
                          0)
                      destination
                        (case (.dst-kind p) MLOC-REGISTER
                              (if (= source (.dst-index p)) 0 1)
                              MLOC-SCRATCH (if (= source scratch) 0 1)
                              MLOC-SPILL
                                (be-stack-access-words
                                  (+ sp-delta
                                     (be-abi-spill-off (.owner p) (.dst-index p))))
                              MLOC-RESULT-AREA
                                (+ (be-stack-access-words
                                     (mu-function-result-pointer-offset (.owner p))) 1)
                              0)]
                  (set! words (+ (load words) (+ source-load destination))))
                (set! move (+ (load move) 1)))))
    (load words)))

(defn be-inst-words [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)
        a (.a m)
        b (.b m)
        dst (.dst m)
        base
          (case op MI-ARG
                0 MI-CALL-RESULT
                0 MI-LABEL
                (let [owner (be-entry-label-owner (load (field m imm)))]
                  (if (>= owner 0)
                      (+ (+ 3
                            (if (> (mu-function-result-area-size owner) 0)
                                (be-stack-access-words
                                  (mu-function-result-pointer-offset owner)) 0))
                         (+ (be-sp-adjust-words (mu-function-frame-size owner))
                            (mu-function-callee-count owner)))
                      0))
                  MI-MOVI
                (if (and (!= (load (field m node)) NO-NODE)
                         (match (n-op (load (field m node)))
                           (Fun [_] true) (CallableId [_] true) (_ false)))
                    4
                    (be-mov-words (load (field m imm)))) MI-FMOVI
                (+ (be-mov-words (load (field m imm))) 1) MI-SCVTF
                1 MI-I32FROMFP
                (+ (be-mov-words 4751297606875873280) 8) MI-FADD
                1 MI-FSUB
                1 MI-FMUL
                1 MI-FDIV
                1 MI-FNEG
                1 MI-FMOD
                (+ 20
                   (+ (be-mov-words -9223372036854775808)
                      (be-mov-words JSV-NAN))) MI-FEQ
                2 MI-FLT
                2 MI-FLE
                2 MI-FTRUTH
                4 MI-MOD
                5 MI-BITAND
                2 MI-BITOR
                2 MI-BITXOR
                2 MI-BITNOT
                2 MI-SHL
                4 MI-SHR
                5 MI-USHR
                5 MI-JSBOX
                (if (= (load (field m imm)) JSV-RAW-NULLABLE-OBJECT)
                    11
                    (if (= (load (field m imm)) 0)
                        1
                        (+ 2 (+ (be-mov-words JSV-PAYLOAD-MASK)
                                (be-mov-words (load (field m imm))))))) MI-JSUNBOX
                (if (= (load (field m imm)) JSV-CLOSURE)
                    (+ 1 (be-mov-words JSV-PAYLOAD-MASK))
                (if (= (load (field m imm)) 0)
                    (+ 25
                       (+ (be-mov-words JSV-TAG-MASK)
                          (be-mov-words JSV-INTEGER)))
                    (+ 5
                       (+ (be-mov-words JSV-TAG-MASK)
                          (+ (be-mov-words (load (field m imm)))
                             (+ (be-mov-words JSV-PAYLOAD-MASK)
                                (be-js-unbox-validation-words (load (field m imm)))))))))
                  MI-JSTEST
                (if (= (load (field m imm)) 0)
                    19
                    (+ 3
                       (+ (be-mov-words JSV-TAG-MASK)
                          (be-mov-words (load (field m imm))))))
                  MI-NEW
                (if (be-runtime-allocation?)
                    39
                    1)
                  MI-EQ
                2 MI-LT
                2 MI-LE
                2 MI-CSEL
                2 MI-CALL
                (let [base-area (be-call-area
                                  (if (be-poly-call? m)
                                      (+ (* (load (field m arg-count)) 2) 2)
                                      (load (field m arg-count))))
                      bundle (mu-call-bundle (mu-inst-call-bundle at))
                      result-area (if (be-poly-call? m) 0 (.result-area-size bundle))
                      area (+ base-area result-area)
                      result-setup-words
                        (be-call-result-setup-words
                          (.owner m) area result-area)
                      capture-words
                        (if (> (.capture-count bundle) 0)
                            (be-abi-parallel-move-words (.capture-first bundle) area) 0)
                      poly-words
                        (if (be-poly-call? m)
                            ; Fixed-size runtime dispatch preserves register arguments across the
                            ; resolver, calls its returned address, then normalizes that function's
                            ; declared return representation.
                            ;; Fixed polymorphic dispatch emits 31 words around its immediate
                            ;; materializations. The common call-size term accounts for the first
                            ;; stack subtraction and addition through this base of 33; only extra
                            ;; adjustment chunks are added below.
                            (+ 33
                               (+ capture-words
                                  (+ (if (< (be-reg-of (load (field m a))) 0)
                                         (be-stack-access-words
                                           (be-spill-off-vreg (load (field m a)))) 0)
                                  (+ (* 2 (be-call-register-loads m))
                                     (+ (be-mov-words JSV-TAG-MASK)
                                        (+ (be-mov-words JSV-FUNCTION)
                                           (+ (be-mov-words JSV-CLOSURE)
                                              (+ (* 2 (be-mov-words JSV-PAYLOAD-MASK))
                                                 (+ (be-mov-words JSV-OBJECT)
                                                    (+ (be-mov-words -3)
                                                       (be-mov-words -4)))))))))))
                            (if (> (.capture-count bundle) 0)
                                (+ 3 (+ result-setup-words capture-words)) 5))]
                  (+ (+ poly-words
                        (* 2 (- (be-sp-adjust-words area) 1)))
                     (+ (load (field m arg-count))
                        (+ (be-call-register-loads m)
                           (+ (be-call-spill-load-words m area)
                              (* 2 (be-call-stack-count m)))))))
                  MI-JSPROP
                (+ 11
                   (+ (be-mov-words (load (field m imm)))
                      (let [key
                              (al-get (load (field (machine-unit) call-args))
                                      (load (field m arg-first)))]
                        (if (< (be-reg-of key) 0)
                            (be-stack-access-words (be-spill-off-vreg key)) 0))))
                  MI-JSARRAY
                (+ 9
                   (+ (be-mov-words (load (field m imm)))
                      (let [value
                              (al-get (load (field (machine-unit) call-args))
                                      (load (field m arg-first)))]
                        (if (< (be-reg-of value) 0)
                            (be-stack-access-words (be-spill-off-vreg value)) 0))))
                  MI-JSSTRING
                (+ 11
                   (+ (if (= (load (field m imm)) JSSOP-FROM-DOUBLE-BITS) 1 0)
                      (+ (be-mov-words (load (field m imm)))
                         (let [value
                                 (al-get (load (field (machine-unit) call-args))
                                         (load (field m arg-first)))]
                           (if (< (be-reg-of value) 0)
                               (be-stack-access-words (be-spill-off-vreg value)) 0)))))
                  MI-STACKARG
                (be-stack-access-words
                  (+ (mu-function-frame-size (load (field m owner)))
                     (* (load (field m imm)) 8))) MI-STORE
                (case (be-store-barrier-kind m) MLK-RAW-MANAGED
                      18 MLK-BOXED
                      12 1)
                  MI-RET
                (+ (if (> (load (field m imm)) 1)
                       (be-abi-parallel-move-words at 0)
                       (if (= (be-reg-of a)
                              (if (= (be-register-class a) MRC-FPR) 32 0)) 0 1))
                   (if (< (load (field m owner)) 0)
                       2
                       (+ 3
                          (+ (be-sp-adjust-words
                               (mu-function-frame-size (load (field m owner))))
                             (mu-function-callee-count (load (field m owner)))))))
                  1)
        aload (if (and (and (!= op MI-CALL) (!= op MI-CALL-RESULT))
                         (and (>= a 0) (< (be-reg-of a) 0)))
                  (be-stack-access-words (be-spill-off-vreg a)) 0)
        bload (if (and (!= op MI-CALL) (and (>= b 0) (< (be-reg-of b) 0)))
                  (be-stack-access-words (be-spill-off-vreg b)) 0)
        pload (if (and (= op MI-CSEL) (< (be-reg-of (.imm m)) 0))
                  (be-stack-access-words (be-spill-off-vreg (.imm m))) 0)
        dstore (if (and (and (and (>= dst 0) (< (be-reg-of dst) 0))
                             (!= op MI-CALL-RESULT))
                        (not (and (= op MI-CALL)
                                  (> (be-call-result-count (load (field m node))) 1))))
                   (be-stack-access-words (be-spill-off-vreg dst)) 0)]
    (+ base (+ aload (+ bload (+ pload dstore))))))

(defn be-label-off [(label i64)] (-> i64)
  (let [offsets (.block-code-offset (machine-unit))]
    (if (and (>= label 0) (< label (al-len [i64] offsets)))
        (al-get offsets label)
        -1)))
(defn be-encode! [] (-> i64)
  (let [p (backend)
        n (be-inst-count)
        (mut expected-size) 0
        (mut i) 0]
    (al-clear! [i64] (field p a64-code))
    (do
      (let [(mut off) 0]
        (al-clear! [i64] (field (machine-unit) block-code-offset))
        (let [(mut block) 0]
          (loop (if (>= (load block) (mu-block-count))
                    (break)
                    (do
                      (al-push! [i64] (field (machine-unit) block-code-offset) -1)
                      (set! block (+ (load block) 1))
                      0))))
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (set! (.first (be-inst (load i))) (load off))
                    (if (= (.op (be-inst (load i))) MI-LABEL)
                        (al-set! [i64] (field (machine-unit) block-code-offset)
                                 (.imm (be-inst (load i))) (load off))
                        0)
                    (set! off (+ (load off) (* 4 (be-inst-words (load i)))))
                    (set! i (+ (load i) 1))
                    0)))
        (set! expected-size (load off)))
      ; Scheduled function bodies are contiguous. Publish ranges from entry labels in one pass
      ; over the final instruction order instead of comparing every function start with every
      ; other function start.
      (let [funcs (mu-function-count)
            (mut owner) 0 (mut at-range) 0 (mut active) -1]
        (loop (if (>= (load owner) funcs) (break)
                  (do
                    (set! (.code-start (mu-function (load owner))) -1)
                    (set! (.code-size (mu-function (load owner))) 0)
                    (set! owner (+ (load owner) 1)))))
        (loop
          (if (>= (load at-range) n)
              (break)
              (do
                (let [m (be-inst (load at-range))]
                  (if (= (.op m) MI-LABEL)
                      (let [bid (.imm m)
                            entry-owner (if (and (>= bid 0) (< bid (mu-block-count)))
                                            (mu-block-owner bid) -1)]
                        (if (or (< entry-owner 0)
                                (!= bid (mu-function-block entry-owner 0)))
                            0
                            (do
                              (if (>= (load active) 0)
                                  (set! (.code-size (mu-function (load active)))
                                        (- (.first m)
                                           (.code-start (mu-function (load active)))))
                                  0)
                              (if (>= (.code-start (mu-function entry-owner)) 0)
                                  (do (be-fail! BER-ENCODING (.node m)) 0)
                                  (do
                                    (set! (.code-start (mu-function entry-owner)) (.first m))
                                    (set! active entry-owner)
                                    0)))))
                      0))
                (set! at-range (+ (load at-range) 1))
                0)))
        (if (>= (load active) 0)
            (set! (.code-size (mu-function (load active)))
                  (- (load expected-size)
                     (.code-start (mu-function (load active))))) 0)
        0)
      (al-clear! [i64] (field (machine-unit) internal-call-sources))
      (al-clear! [i64] (field (machine-unit) internal-call-offsets))
      (al-clear! [i64] (field (machine-unit) internal-call-targets))
      (al-clear! [i64] (field (machine-unit) internal-address-sources))
      (al-clear! [i64] (field (machine-unit) internal-address-offsets))
      (al-clear! [i64] (field (machine-unit) internal-address-targets))
      (set! i 0)
      (loop (if (or (>= (load i) n) (!= (be-result) BER-OK))
                (break)
                (do
                  (let [m0 (be-inst (load i))]
                    (if (!= (be-code-len) (.first m0))
                        (do
                          (fmt (stderr)
                               "encoding-offset-mismatch inst={d} ideal={d} op={d} expected={d} actual={d} words={d} prev-op={d} prev-ideal={d} prev-words={d} prev-imm={d}\n"
                               (load i) (load (field m0 node)) (load (field m0 op))
                               (load (field m0 first)) (be-code-len) (be-inst-words (load i))
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) op)) -1)
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) node)) -1)
                               (if (> (load i) 0) (be-inst-words (- (load i) 1)) -1)
                               (if (> (load i) 0) (load (field (be-inst (- (load i) 1)) imm)) -1))
                          ; A size-model disagreement makes every following PC-relative value
                          ; suspect. Fail atomically instead of publishing bytes after a warning.
                          (be-fail! BER-ENCODING (.node m0))
                          0)
                        0))
                  (if (!= (be-result) BER-OK)
                      0
                      (let [m (be-inst (load i))
                            op (.op m)
                            dst (.dst m)
                            rd (be-write-reg dst)
                        ; Calls marshal their complete argument vector below. Eagerly reading the
                        ; cached a/b mirrors here would emit duplicate spill reloads and make the
                        ; encoded byte count diverge from be-inst-words.
                        ra
                          (if (or (= op MI-CALL) (= op MI-CALL-RESULT))
                              -1
                              (be-read-value! (.a m)
                                              (if (= op MI-I32FROMFP) 16 15)))
                        rb
                          (if (= op MI-CALL)
                              -1
                              (be-read-value! (.b m) 16))]
                    (case op MI-MOVI
                          (if (and (!= (.node m) NO-NODE)
                                   (match (n-op (.node m))
                                     (Fun [_] true) (CallableId [_] true) (_ false)))
                              (be-mov-imm-fixed! rd (.imm m))
                              (be-mov-imm! rd (.imm m))) MI-FMOVI
                          (do
                            (be-mov-imm! 15 (load (field m imm)))
                            (be-u32! (a64-fmov-d-x (- rd 32) 15))
                            0)
                            MI-SCVTF
                          (be-u32! (a64-scvtf-d-x (- rd 32) ra)) MI-I32FROMFP
                          (do
                            (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                            (be-mov-imm! 17 4751297606875873280)
                            (be-u32! (a64-fmov-d-x 30 17))
                            (be-u32! (a64-fdiv-d 31 (- ra 32) 30))
                            (be-u32! (a64-frintz-d 31 31))
                            (be-u32! (a64-fmul-d 31 31 30))
                            (be-u32! (a64-fmov-d-x 30 15))
                            (be-u32! (a64-fsub-d 31 30 31))
                            (be-u32! (a64-fcvtzs-x-d rd 31))
                            0)
                            MI-FADD
                          (be-u32! (a64-fadd-d (- rd 32) (- ra 32) (- rb 32))) MI-FSUB
                          (be-u32! (a64-fsub-d (- rd 32) (- ra 32) (- rb 32))) MI-FMUL
                          (be-u32! (a64-fmul-d (- rd 32) (- ra 32) (- rb 32))) MI-FDIV
                          (be-u32! (a64-fdiv-d (- rd 32) (- ra 32) (- rb 32))) MI-FMOD
                          (let [nw (be-mov-words JSV-NAN)]
                            (be-u32! (a64-fmov-x-d 15 (- ra 32)))
                            (be-u32! (a64-fmov-x-d 16 (- rb 32)))
                            (be-u32! (a64-fmov-d-x 30 15))
                            (be-u32! (a64-fmov-d-x 31 16))
                            (be-u32! (a64-fdiv-d 31 30 31))
                            (be-u32! (a64-frintz-d 31 31))
                            (be-u32! (a64-fcmp-zero-d 31))
                            ; A zero truncated quotient means |dividend| < |divisor|, so the
                            ; JavaScript remainder is the original dividend. Jump past the
