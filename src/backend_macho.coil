;; Mach-O object layout, relocations, stack maps, layout metadata, and byte verification.
(module backend_macho)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "monotonic" :as monotonic)

(extern realloc :cc c [(ptr u8) i64] (-> (ptr u8)))

(defn mobj-profile! [(phase (slice u8)) (started i64)] (-> i64)
  (let [now (monotonic/monotonic-now-ns)]
    (fmt (stderr) "AOTK_PROFILE phase={s} ns={d}\n" phase (- now started))
    now))

;; Stack-map PCs are target instruction offsets, not portable Machine IR facts. Mach-O/AArch64
;; historically reconstructed them from fixed-width instruction counts; x86 records the exact
;; byte offset while encoding variable-length calls. Object publication selects the matching
;; interpretation before writing and independently verifying metadata.
(defn mobj-x64-target [] (-> (ptr bool)) (primitive/alloc-static bool))

;; Facts discovered while encoding/publication begins. Simple records these while emitting; this
;; cache is the AOT Kit phase boundary until relocation records move into the encoder itself. Most
;; importantly, every query below is O(1): the former implementation rescanned all instructions
;; for each symbol query and then repeated those queries for every relocation.
(defstruct MobjPublicationIndex
  [(external-mask i64)
   (external-inst (ArrayList i64))
   (inited bool)])

(defn mobj-index [] (-> (ptr MobjPublicationIndex))
  (let [p (primitive/alloc-static MobjPublicationIndex)]
    (if (.inited p)
        0
        (do
          (set! (.external-inst p) (al-new [i64] (malloc-allocator)))
          (set! (.inited p) true)
          0))
    p))

(defn mobj-index-jsarray-bit [(operation i64)] (-> i64)
  (if (and (>= operation 1) (<= operation 3)) (<< 1 (+ 51 operation)) 0))

(defn mobj-build-index! [] (-> i64)
  (let [p (mobj-index)
        (mut at) 0
        (mut mask) 0]
    (al-clear! [i64] (field p external-inst))
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (.op m)
                      external
                        (or (= op MI-JSPROP)
                            (or (= op MI-JSARRAY)
                                (or (= op MI-JSSTRING)
                                    (or (and (be-runtime-allocation?) (= op MI-NEW))
                                        (and (= op MI-CALL) (< (.imm m) 0))))))]
                  (if external
                      (do
                        (al-push! [i64] (field p external-inst) (load at))
                        (set! mask (| (load mask) (<< 1 op)))
                        (if (= op MI-JSARRAY)
                            (set! mask (| (load mask) (mobj-index-jsarray-bit (.imm m))))
                            0)
                        0)
                      0))
                (set! at (+ (load at) 1))
                0)))
    (set! (.external-mask p) (load mask))
    0))

(defn obj-u8! [(v i64)] (-> i64)
  (let [out (field (backend) obj)
        at (.len out)]
    (if (>= at (.cap out))
        (do (be-fail! BER-OBJECT NO-NODE) 0)
        (do
          (set! (index (.data out) at) (cast u8 (& v 255)))
          (set! (.len out) (+ at 1))
          0))))

;; Mach-O computes its exact final size before writing its first byte. Materialize that phase
;; boundary in the output buffer: one allocation, then cursor writes. This is the same ownership
;; model as Simple's exact-size ByteBuffer and avoids generic ArrayList growth checks per byte.
(defn obj-begin! [(size i64)] (-> bool)
  (let [out (field (backend) obj)]
    (if (< (.cap out) size)
        (let [data (realloc (.data out) size)]
          (if (= (cast i64 data) 0)
              (be-fail! BER-OBJECT NO-NODE)
              (do
                (set! (.data out) data)
                (set! (.cap out) size)
                (set! (.len out) 0)
                true)))
        (do (set! (.len out) 0) true))))
(defn obj-u32! [(v i64)] (-> i64)
  (obj-u8! v)
  (obj-u8! (>> v 8))
  (obj-u8! (>> v 16))
  (obj-u8! (>> v 24))
  0)
(defn obj-u64! [(v i64)] (-> i64)
  (obj-u32! v)
  (obj-u32! (>> v 32))
  0)
(defn obj-name16! [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) 16)
              (break)
              (do
                (obj-u8! (if (< (load i) n) (cast i64 (slice-get s (load i))) 0))
                (set! i (+ (load i) 1))
                0)))
    0))
(defn obj-pad-to! [(at i64)] (-> i64)
  (loop (if (>= (al-len [u8] (.obj (backend))) at)
            (break)
            (obj-u8! 0)))
  0)
(defn align8 [(n i64)] (-> i64)
  (& (+ n 7) -8))

(defn obj-ascii! [(s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (do
                (obj-u8! (cast i64 (slice-get s (load i))))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn obj-hex-digit [(v i64)] (-> i64)
  (if (< v 10) (+ 48 v) (+ 87 v)))

; Fixed-width names make string-table offsets independent of function count and layout order.
(defn obj-local-name! [(owner i64)] (-> i64)
  (obj-ascii! "_aot_")
  (let [(mut shift) 60]
    (loop (if (< (load shift) 0)
              (break)
              (do
                (obj-u8! (obj-hex-digit (& (>> owner (load shift)) 15)))
                (set! shift (- (load shift) 4))
                0)))
    0))

(defn mobj-safepoint-count [] (-> i64)
  (let [(mut at) 0
        (mut count) 0]
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at)) (set! count (+ (load count) 1)) 0)
                (set! at (+ (load at) 1))
                0)))
    (load count)))

(defn mobj-external-reloc-count [] (-> i64)
  (al-len [i64] (.external-inst (mobj-index))))
(defn mobj-external-reloc-inst [(i i64)] (-> i64)
  (al-get [i64] (.external-inst (mobj-index)) i))

(defn mobj-has-external-op? [(wanted i64)] (-> bool)
  (!= (& (.external-mask (mobj-index)) (<< 1 wanted)) 0))

(defn mobj-has-jsarray-imm? [(wanted i64)] (-> bool)
  (!= (& (.external-mask (mobj-index)) (mobj-index-jsarray-bit wanted)) 0))

(defn mobj-external-symbol-count [] (-> i64)
  (+ (if (mobj-has-external-op? MI-CALL) 1 0)
     (+ (if (mobj-has-external-op? MI-NEW) 1 0)
     (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
        (+ (if (mobj-has-external-op? MI-JSARRAY) 1 0)
           (+ (if (mobj-has-jsarray-imm? 1) 1 0)
              (+ (if (mobj-has-jsarray-imm? 2) 1 0)
                 (+ (if (mobj-has-jsarray-imm? 3) 1 0)
                    (if (mobj-has-external-op? MI-JSSTRING) 1 0)))))))))

(defn mobj-external-symbol [(basesyms i64) (op i64)] (-> i64)
  (if (= op MI-CALL)
      basesyms
      (let [base (+ basesyms (if (mobj-has-external-op? MI-CALL) 1 0))]
        (if (= op MI-NEW)
            base
            (if (= op MI-JSPROP)
                (+ base (if (mobj-has-external-op? MI-NEW) 1 0))
                (if (= op MI-JSARRAY)
                    (+ base
                       (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                          (if (mobj-has-external-op? MI-JSPROP) 1 0)))
                    (+ base
                       (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                          (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
                             (+ (if (mobj-has-external-op? MI-JSARRAY) 1 0)
                                (+ (if (mobj-has-jsarray-imm? 1) 1 0)
                                   (+ (if (mobj-has-jsarray-imm? 2) 1 0)
                                      (if (mobj-has-jsarray-imm? 3) 1 0)))))))))))))

(defn mobj-dispatch-resolver-branch-pc [(at i64)] (-> i64)
  (.last (be-inst at)))

(defn mobj-jsarray-external-symbol [(basesyms i64) (operation i64)] (-> i64)
  (let [generic (mobj-external-symbol basesyms MI-JSARRAY)]
    (cond (= operation 1) (+ generic 1)
          (= operation 2) (+ (+ generic 1) (if (mobj-has-jsarray-imm? 1) 1 0))
          (= operation 3) (+ (+ generic 1)
                             (+ (if (mobj-has-jsarray-imm? 1) 1 0)
                                (if (mobj-has-jsarray-imm? 2) 1 0)))
          :else generic)))

(defn mobj-new-branch-pc [(at i64)] (-> i64)
  ;; Runtime MI-NEW is a fixed 39-word sequence; the external slow-path BL is word 37.
  (+ (.first (be-inst at)) (* 37 4)))

(defn mobj-jsprop-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        key (ms-inst-arg at 0)
        spill-loads
          (+ (if (< (be-reg-of (.a m)) 0) 1 0)
             (+ (if (< (be-reg-of (.b m)) 0) 1 0)
                (if (< (be-reg-of key) 0) 1 0)))]
    (+ (.first m)
       (* 4
          (+ spill-loads
             (+ 7 (be-mov-words (.imm m))))))))

(defn mobj-jsarray-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        value (ms-inst-arg at 0)
        spill-loads
          (+ (if (< (be-reg-of (.a m)) 0) 1 0)
             (+ (if (< (be-reg-of (.b m)) 0) 1 0)
                (if (< (be-reg-of value) 0) 1 0)))]
    (+ (.first m)
       (* 4 (+ spill-loads (+ 6 (be-mov-words (.imm m))))))))

(defn mobj-jsstring-branch-pc [(at i64)] (-> i64)
  (+ (+ (mobj-jsarray-branch-pc at) 4)
     (if (= (.imm (be-inst at)) JSSOP-FROM-DOUBLE-BITS) 4 0)))

(defn mobj-safepoint-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)]
    (if (or (load (mobj-x64-target))
            (and (= op MI-CALL) (< (.imm m) 0)))
        ;; The x64 encoder stores the byte immediately after each direct call in `.earliest`.
        ;; Polymorphic dispatch currently stores its common continuation there, matching the
        ;; previous one-record-per-MI-CALL metadata contract without re-running AArch64 sizing.
        (.earliest m)
        (case op MI-NEW
          (if (be-runtime-allocation?)
              (+ (mobj-new-branch-pc at) 4)
              (load (field m first)))
            MI-CALL
          (let [argc (load (field m arg-count))
                here (load (field m first))
                common
                  (+ argc
                     (+ (be-call-spill-loads m)
                        (+ (be-call-register-loads m)
                           (* 2 (be-call-stack-count m)))))
                setup
                  (if (be-poly-call? m)
                      (+ 12
                         (+ common
                            (+ (if (< (be-reg-of (load (field m a))) 0) 1 0)
                               (+ (be-mov-words JSV-TAG-MASK)
                                  (+ (be-mov-words JSV-FUNCTION)
                                     (+ (be-mov-words JSV-PAYLOAD-MASK)
                                        (be-poly-call-dispatch-words m)))))))
                      (+ 2 common))]
            ;; setup includes the call instruction itself; stack maps name its return PC.
            (+ here (* 4 setup)))
            -1))))

(defn mobj-branch-reloc-info [(symbol i64)] (-> i64)
  (| symbol (| (<< 1 24) (| (<< 2 25) (| (<< 1 27) (<< 2 28))))))

(defn mobj-root? [(at i64) (vr i64)] (-> bool)
  (and (if (= (ms-inst-op at) MI-CALL)
           (and (!= (ms-inst-dst at) vr) (ml-live-after? at vr))
           (ml-live-before? at vr))
       (!= (ml-value-kind vr) MLK-SCALAR)))

;; All stackmap roots, computed by ONE backward liveness walk per block and read by everything
;; downstream. The per-query path above (mobj-root? -> ml-live-before?) rescans the block tail
;; for every (safepoint, vreg) pair, and the layout, the two stackmap sweeps, and the byte
;; verifier each repeated that product — it made the Mach-O step dominate large emits. The
;; per-query form stays as the reference implementation (the object tests exercise it).
(defstruct MobjRootCache
  [(site (ArrayList i64))     ; root entry -> safepoint instruction, grouped ascending
   (vreg (ArrayList i64))     ; root entry -> vreg, ascending within a site
   (tmp-site (ArrayList i64))
   (tmp-first (ArrayList i64))
   (tmp-count (ArrayList i64))
   (tmp-vreg (ArrayList i64))
   (flags (ArrayList i64))    ; packed per-vreg live flags during the block walk
   (touched (ArrayList i64))  ; vregs whose flag may need clearing before the next block
   (inited bool)])

(defn mobj-roots [] (-> (ptr MobjRootCache))
  (let [c (primitive/alloc-static MobjRootCache)]
    (if (.inited c)
        0
        (do
          (set! (.site c) (al-new [i64] (malloc-allocator)))
          (set! (.vreg c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-site c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-first c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-count c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-vreg c) (al-new [i64] (malloc-allocator)))
          (set! (.flags c) (al-new [i64] (malloc-allocator)))
          (set! (.touched c) (al-new [i64] (malloc-allocator)))
          (set! (.inited c) true)
          0))
    c))

(defn mobj-mark-use! [(vreg i64)] (-> i64)
  (let [c (mobj-roots)]
    (if (>= vreg 0)
        (let [word (/ vreg 64)]
          (if (< word (al-len [i64] (.flags c)))
              (let [old (al-get [i64] (.flags c) word)]
                (if (= (& old (ml-bit vreg)) 0)
                    (do
                      (al-set! [i64] (field c flags) word (| old (ml-bit vreg)))
                      (al-push! [i64] (field c touched) vreg))
                    0)
                0)
              0))
        0)))

(defn mobj-mark-inst-uses! [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)]
    (if (> inputs 0) (mobj-mark-use! (.a m)) 0)
    (if (> inputs 1) (mobj-mark-use! (.b m)) 0)
    (if (= op MI-CSEL) (mobj-mark-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (mobj-mark-use! (al-get (.call-args (machine-unit))
                                          (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    0))

(defn mobj-note-root-snapshot! [(at i64) (exclude i64) (vregs i64)] (-> i64)
  (let [c (mobj-roots)
        first (al-len [i64] (.tmp-vreg c))
        words (al-len [i64] (.flags c))
        (mut word) 0
        (mut count) 0]
    ;; Packed flags preserve ascending vreg publication while skipping wholly-dead groups of 64.
    (loop (if (>= (load word) words)
              (break)
              (do
                (let [bits (al-get [i64] (.flags c) (load word))]
                  (if (!= bits 0)
                      (let [(mut bit) 0]
                        (loop (if (>= (load bit) 64)
                                  (break)
                                  (do
                                    (if (!= (& bits (<< 1 (load bit))) 0)
                                        (let [vr (+ (* (load word) 64) (load bit))]
                                          (if (and (< vr vregs)
                                                   (and (!= vr exclude)
                                                        (!= (ml-value-kind vr) MLK-SCALAR)))
                                              (do
                                                (al-push! [i64] (field c tmp-vreg) vr)
                                                (set! count (+ (load count) 1))
                                                0)
                                              0))
                                        0)
                                    (set! bit (+ (load bit) 1))
                                    0))))
                      0))
                (set! word (+ (load word) 1))
                0)))
    (al-push! [i64] (field c tmp-site) at)
    (al-push! [i64] (field c tmp-first) first)
    (al-push! [i64] (field c tmp-count) (load count))
    0))

(defn mobj-build-block-roots! [(bid i64) (vregs i64)] (-> i64)
  (let [c (mobj-roots)
        u (machine-unit)
        words (ml-live-words)
        owner (mu-block-owner bid)
        local-words (ml-block-words bid)
        local-base (al-get (.live-block-first u) bid)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut touched) 0
        (mut word) 0
        (mut i) count]
    (al-clear! [i64] (field c tmp-site))
    (al-clear! [i64] (field c tmp-first))
    (al-clear! [i64] (field c tmp-count))
    (al-clear! [i64] (field c tmp-vreg))
    (loop (if (>= (al-len [i64] (.flags c)) words)
              (break)
              (do (al-push! [i64] (field c flags) 0))))
    ;; Clear only bits touched by the prior block, then expand this block's function-local row.
    (loop (if (>= (load touched) (al-len [i64] (.touched c)))
              (break)
              (do
                (let [vr (al-get [i64] (.touched c) (load touched))
                      global-word (/ vr 64)]
                  (al-set! [i64] (field c flags) global-word
                           (& (al-get [i64] (.flags c) global-word) (^ (ml-bit vr) -1))))
                (set! touched (+ (load touched) 1))
                0)))
    (al-clear! [i64] (field c touched))
    (set! word 0)
    (loop (if (>= (load word) local-words)
              (break)
              (do
                (let [bits (al-get [i64] (.live-out u) (+ local-base (load word)))
                      (mut bit) 0]
                  (loop (if (>= (load bit) 64)
                            (break)
                            (do
                              (if (!= (& bits (<< 1 (load bit))) 0)
                                  (let [local (+ (* (load word) 64) (load bit))]
                                    (if (< local (al-get (.live-owner-count u) owner))
                                        (let [vr (ml-owner-vreg owner local)
                                              global-word (/ vr 64)]
                                          (mobj-mark-use! vr))
                                        0))
                                  0)
                              (set! bit (+ (load bit) 1))))))
                (set! word (+ (load word) 1)))))
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [at (+ first (load i))
                      m (be-inst at)
                      op (.op m)
                      dst (.dst m)]
                  ; Arriving here the flags hold live-AFTER `at`; a call reads its roots now,
                  ; excluding its own destination, exactly as mobj-root? does.
                  (if (= op MI-CALL)
                      (mobj-note-root-snapshot! at dst vregs)
                      0)
                  (if (>= dst 0)
                      (let [word (/ dst 64)]
                        (al-set! [i64] (field c flags) word
                                 (& (al-get [i64] (.flags c) word) (^ (ml-bit dst) -1))))
                      0)
                  (mobj-mark-inst-uses! at)
                  ; After the kill and the uses the flags hold live-BEFORE `at`.
                  (if (= op MI-NEW)
                      (mobj-note-root-snapshot! at -1 vregs)
                      0))
                0)))
    ;; The walk visited safepoints in descending order; publish ascending.
    (let [sites (al-len [i64] (.tmp-site c))
          (mut s) sites]
      (loop (if (<= (load s) 0)
                (break)
                (do
                  (set! s (- (load s) 1))
                  (let [site (al-get [i64] (.tmp-site c) (load s))
                        rf (al-get [i64] (.tmp-first c) (load s))
                        rc (al-get [i64] (.tmp-count c) (load s))
                        (mut k) 0]
                    (loop (if (>= (load k) rc)
                              (break)
                              (do
                                (al-push! [i64] (field c site) site)
                                (al-push! [i64] (field c vreg)
                                          (al-get [i64] (.tmp-vreg c)
                                                  (+ rf (load k))))
                                (set! k (+ (load k) 1))
                                0))))
                  0))))
    0))

(defn mobj-build-roots! [] (-> i64)
  (let [c (mobj-roots)
        vregs (ml-vreg-count)
        blocks (mu-block-count)
        (mut bid) 0]
    (al-clear! [i64] (field c site))
    (al-clear! [i64] (field c vreg))
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (mobj-build-block-roots! (load bid) vregs)
                (set! bid (+ (load bid) 1))
                0)))
    0))

(defn mobj-root-count [] (-> i64)
  (al-len [i64] (.vreg (mobj-roots))))
(defn mobj-root-site [(i i64)] (-> i64)
  (al-get [i64] (.site (mobj-roots)) i))
(defn mobj-root-vreg [(i i64)] (-> i64)
  (al-get [i64] (.vreg (mobj-roots)) i))

;; First cache position whose site is >= at. Cache sites ascend, so [result..) begins at's
;; root range (possibly empty).
(defn mobj-roots-lower-bound [(at i64)] (-> i64)
  (let [c (mobj-roots)
        (mut lo) 0
        (mut hi) (al-len [i64] (.site c))]
    (loop (if (>= (load lo) (load hi))
              (break)
              (let [mid (/ (+ (load lo) (load hi)) 2)]
                (if (< (al-get [i64] (.site c) mid) at)
                    (set! lo (+ mid 1))
                    (set! hi mid))
                0)))
    (load lo)))

(defn mobj-stackmap-size [] (-> i64)
  (+ 24
     (+ (* (mu-function-count) 40)
        (+ (* (mobj-safepoint-count) 24) (* (mobj-root-count) 16)))))
(defn mobj-layout-size [] (-> i64)
  (+ 16 (* (shape-count) 32)))

(defn mobj-write-stackmaps! [] (-> i64)
  (let [sites (mobj-safepoint-count)
        roots (mobj-root-count)
        (mut phase-start) (ms-profile-now)
        (mut at) 0
        (mut root-first) 0]
    (obj-u32! 1398034241)
    (obj-u32! 3)
    (obj-u32! sites)
    (obj-u32! roots)
    (obj-u32! (mu-function-count))
    (obj-u32! 40)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (obj-u32! (load owner))
                  (obj-u32! (mu-function-code-start (load owner)))
                  (obj-u32! (mu-function-code-size (load owner)))
                  (obj-u32! (mu-function-frame-size (load owner)))
                  (obj-u64! (mu-function-callee-mask (load owner)))
                  (obj-u32! (mu-function-callee-count (load owner)))
                  (obj-u32! 0)
                  (obj-u32! (let [symbol (mu-function-symbol (load owner))]
                              (if (>= symbol 1) symbol 0)))
                  (obj-u32! (be-function-dispatch-return-code (load owner)))
                  (set! owner (+ (load owner) 1))
                  0))))
    (fmt (stderr) "AOTK_PROFILE phase=stackmap_functions ns={d} x64={d}\n"
         (- (ms-profile-now) (load phase-start))
         (if (load (mobj-x64-target)) 1 0))
    (set! phase-start (ms-profile-now))
    (let [c (mobj-roots)
          total (al-len [i64] (.site c))
          (mut cursor) 0]
      (loop (if (>= (load at) (be-inst-count))
                (break)
                (do
                  (if (ml-safepoint? (load at))
                      (let [m (be-inst (load at))
                            (mut count) 0]
                        (loop (if (or (>= (load cursor) total)
                                      (!= (al-get [i64] (.site c) (load cursor))
                                          (load at)))
                                  (break)
                                  (do
                                    (set! count (+ (load count) 1))
                                    (set! cursor (+ (load cursor) 1))
                                    0)))
                        (obj-u32! (mobj-safepoint-pc (load at)))
                        (obj-u32! (.owner m))
                        (obj-u32! (load at))
                        (obj-u32! (load root-first))
                        (obj-u32! (load count))
                        (obj-u32! (.op m))
                        (set! root-first (+ (load root-first) (load count))))
                      0)
                  (set! at (+ (load at) 1))
                  0)))
      (fmt (stderr) "AOTK_PROFILE phase=stackmap_sites ns={d} count={d}\n"
           (- (ms-profile-now) (load phase-start)) sites)
      (set! phase-start (ms-profile-now))
      (let [(mut r) 0]
        (loop (if (>= (load r) total)
                  (break)
                  (do
                    (let [vr (al-get [i64] (.vreg c) (load r))
                          reg (mra-reg vr)]
                      (obj-u32! vr)
                      (obj-u32! (ml-value-kind vr))
                      (obj-u32! (if (>= reg 0) 0 1))
                      (obj-u32! (if (>= reg 0) reg (be-spill-off-vreg vr))))
                    (set! r (+ (load r) 1))
                    0)))))
    (fmt (stderr) "AOTK_PROFILE phase=stackmap_roots ns={d} count={d}\n"
         (- (ms-profile-now) (load phase-start)) roots)
    0))

(defn mobj-shape-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (ty-only-obj? (shape-field-ty shape (load field)))
                    (set! bits (| (load bits) (<< 1 (load field))))
                    0)
                (set! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-shape-boxed-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (= (ml-kind-for-type (shape-field-ty shape (load field))) MLK-BOXED)
                    (set! bits (| (load bits) (<< 1 (load field))))
                    0)
                (set! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-write-layouts! [] (-> i64)
  (obj-u32! 1280593729)
  (obj-u32! 1)
  (obj-u32! (shape-count))
  (obj-u32! 32)
  (let [(mut shape) 0]
    (loop (if (>= (load shape) (shape-count))
              (break)
              (do
                (obj-u32! (load shape))
                (obj-u32! (shape-size (load shape)))
                (obj-u32! 8)
                (obj-u32! (shape-field-count (load shape)))
                (obj-u64! (mobj-shape-bitmap (load shape)))
                (obj-u64! (mobj-shape-boxed-bitmap (load shape)))
                (set! shape (+ (load shape) 1))
                0)))
    0))

(defn mobj-fail! [(code i64) (item i64)] (-> bool)
  (let [p (backend)]
    (set! (.object-result p) code)
    (set! (.object-item p) item)
    false))

; Validate the phase-owned object model before a byte is published. The serialized-byte parser
; below repeats the bounds checks after publication; neither verifier trusts the other.
(defn mobj-verify-model! [] (-> bool)
  (let [p (backend)
        funcs (mu-function-count)
        textlen (be-code-len)
        (mut owner) 0
        (mut ok) true]
    (set! (.object-result p) MOBJ-OK)
    (set! (.object-item p) -1)
    (if (<= textlen 0)
        (do (set! ok false) (mobj-fail! MOBJ-HEADER -1))
        false)
    (loop (if (or (>= (load owner) funcs) (not (load ok)))
              (break)
              (do
                (let [start (mu-function-code-start (load owner))
                      size (mu-function-code-size (load owner))]
                  (if (or (< start 0) (or (<= size 0) (> (+ start size) textlen)))
                      (do
                        (set! ok false)
                        (mobj-fail! MOBJ-FUNCTION-RANGE (load owner)))
                      false))
                (set! owner (+ (load owner) 1))
                0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (not (load ok)))
                    (break)
                    (do
                      (if (= (ms-inst-op (load at)) MI-CALL)
                          (let [target (.imm (be-inst (load at)))]
                            (if (if (< target 0)
                                    (not (ms-call-target-valid? (load at)))
                                    (>= target funcs))
                                (do
                                  (set! ok false)
                                  (mobj-fail! MOBJ-RELOCATION (load at)))
                                false))
                          false)
                      (set! at (+ (load at) 1))
                      0)))
          0)
        0)
    (load ok)))

(defn mobj-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (set! (.imm (be-inst at)) target)
  0)

(defn mobj-corrupt-function-range! [(owner i64) (start i64) (size i64)] (-> i64)
  (set! (.code-start (mu-function owner)) start)
  (set! (.code-size (mu-function owner)) size)
  0)

(defn mobj-byte [(at i64)] (-> i64)
  (cast i64 (al-get (.obj (backend)) at)))
(defn mobj-u32 [(at i64)] (-> i64)
  (| (mobj-byte at)
     (| (<< (mobj-byte (+ at 1)) 8)
        (| (<< (mobj-byte (+ at 2)) 16) (<< (mobj-byte (+ at 3)) 24)))))
(defn mobj-u64 [(at i64)] (-> i64)
  (| (mobj-u32 at) (<< (mobj-u32 (+ at 4)) 32)))

; Repository-local structural parser for the exact object schema emitted below. It validates raw
; bytes and cross-checks them against phase-owned function ranges.
(defn mobj-verify-bytes! [] (-> bool)
  (let [p (backend)
        len (al-len [u8] (.obj p))
        funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1)
        nreloc (mobj-external-reloc-count)
        externs (mobj-external-symbol-count)
        nsyms (+ basesyms externs)
        (mut ok) true]
    (set! (.object-result p) MOBJ-OK)
    (set! (.object-item p) -1)
    (if (< len 472)
        (do (set! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (and (load ok)
             (or (!= (mobj-u32 0) 4277009103)
                 (or (!= (mobj-u32 16) 4) (!= (mobj-u32 20) 440))))
        (do (set! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (load ok)
        (let [textlen (mobj-u64 144)
              textoff (mobj-u32 152)
              relocoff (mobj-u32 160)
              actual-nreloc (mobj-u32 164)
              stackaddr (mobj-u64 216)
              stacklen (mobj-u64 224)
              stackoff (mobj-u32 232)
              layoutaddr (mobj-u64 296)
              layoutlen (mobj-u64 304)
              layoutoff (mobj-u32 312)
              symoff (mobj-u32 352)
              actual-nsyms (mobj-u32 356)
              stroff (mobj-u32 360)
              strsize (mobj-u32 364)]
          (if (or (!= textoff 472)
                  (or (> (+ textoff textlen) len)
                      (or (> (+ stackoff stacklen) len)
                          (or (!= stackaddr (align8 textlen))
                              (or (!= layoutaddr (align8 (+ stackaddr stacklen)))
                                  (or (> (+ layoutoff layoutlen) len)
                                      (or (!= actual-nreloc nreloc)
                                          (or (> (+ relocoff (* actual-nreloc 8)) len)
                                              (or (!= actual-nsyms nsyms)
                                                  (or (> (+ symoff (* actual-nsyms 16)) len)
                                                      (> (+ stroff strsize) len)))))))))))
              (do (set! ok false) (mobj-fail! MOBJ-HEADER 1))
              false)
          (if (and (load ok)
                   (or (!= (mobj-u32 stackoff) 1398034241)
                       (or (!= (mobj-u32 (+ stackoff 4)) 3)
                           (or (!= (mobj-u32 (+ stackoff 8)) (mobj-safepoint-count))
                               (or (!= (mobj-u32 (+ stackoff 12)) (mobj-root-count))
                                   (or (!= (mobj-u32 (+ stackoff 16)) (mu-function-count))
                                       (or (!= (mobj-u32 (+ stackoff 20)) 40)
                                           (!= stacklen (mobj-stackmap-size)))))))))
              (do
                (fmt (stderr)
                     "AOTK_PROFILE phase=stackmap_header_failure magic={d} version={d} sites={d}/{d} roots={d}/{d} functions={d}/{d} stride={d} bytes={d}/{d}\n"
                     (mobj-u32 stackoff) (mobj-u32 (+ stackoff 4))
                     (mobj-u32 (+ stackoff 8)) (mobj-safepoint-count)
                     (mobj-u32 (+ stackoff 12)) (mobj-root-count)
                     (mobj-u32 (+ stackoff 16)) (mu-function-count)
                     (mobj-u32 (+ stackoff 20)) stacklen (mobj-stackmap-size))
                (set! ok false)
                (mobj-fail! MOBJ-STACKMAP 0))
              false)
          (if (and (load ok)
                   (or (!= (mobj-u32 layoutoff) 1280593729)
                       (or (!= (mobj-u32 (+ layoutoff 4)) 1)
                           (or (!= (mobj-u32 (+ layoutoff 8)) (shape-count))
                               (!= layoutlen (mobj-layout-size))))))
              (do (set! ok false) (mobj-fail! MOBJ-LAYOUT 0))
              false)
          (if (load ok)
              (let [functions (mobj-u32 (+ stackoff 16))
                    (mut owner) 0]
                (loop (if (or (>= (load owner) functions) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ (+ stackoff 24) (* (load owner) 40))]
                              (if (or (!= (mobj-u32 rec) (load owner))
                                      (or (!= (mobj-u32 (+ rec 4))
                                              (mu-function-code-start (load owner)))
                                          (or (!= (mobj-u32 (+ rec 8))
                                                  (mu-function-code-size (load owner)))
                                              (or (!= (mobj-u32 (+ rec 12))
                                                      (mu-function-frame-size (load owner)))
                                                  (or (!= (mobj-u64 (+ rec 16))
                                                          (mu-function-callee-mask (load owner)))
                                                      (or (!= (mobj-u32 (+ rec 24))
                                                              (mu-function-callee-count (load owner)))
                                                          (or (!= (mobj-u32 (+ rec 32))
                                                                  (let [symbol
                                                                          (mu-function-symbol
                                                                            (load owner))]
                                                                    (if (>= symbol 1) symbol 0)))
                                                              (!= (mobj-u32 (+ rec 36))
                                                                  (cast i64
                                                                    (cast u32
                                                                      (be-function-dispatch-return-code
                                                                        (load owner))))))))))))
                                  (do
                                    (fmt (stderr)
                                         "AOTK_PROFILE phase=stackmap_function_failure owner={d} id={d}/{d} start={d}/{d} size={d}/{d} frame={d}/{d} mask={d}/{d} callees={d}/{d} callable={d}/{d} return={d}/{d}\n"
                                         (load owner)
                                         (mobj-u32 rec) (load owner)
                                         (mobj-u32 (+ rec 4)) (mu-function-code-start (load owner))
                                         (mobj-u32 (+ rec 8)) (mu-function-code-size (load owner))
                                         (mobj-u32 (+ rec 12)) (mu-function-frame-size (load owner))
                                         (mobj-u64 (+ rec 16)) (mu-function-callee-mask (load owner))
                                         (mobj-u32 (+ rec 24)) (mu-function-callee-count (load owner))
                                         (mobj-u32 (+ rec 32))
                                         (let [symbol (mu-function-symbol (load owner))]
                                           (if (>= symbol 1) symbol 0))
                                         (mobj-u32 (+ rec 36))
                                         (cast i64 (cast u32
                                           (be-function-dispatch-return-code (load owner)))))
                                    (set! ok false)
                                    (mobj-fail! MOBJ-STACKMAP (load owner)))
                                  false))
                            (set! owner (+ (load owner) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [sites (mobj-u32 (+ stackoff 8))
                    roots (mobj-u32 (+ stackoff 12))
                    sitebase (+ (+ stackoff 24) (* (mu-function-count) 40))
                    (mut site) 0]
                (loop (if (or (>= (load site) sites) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ sitebase (* (load site) 24))
                                  pc (mobj-u32 rec)
                                  owner (mobj-u32 (+ rec 4))
                                  at (mobj-u32 (+ rec 8))
                                  root-first (mobj-u32 (+ rec 12))
                                  root-count (mobj-u32 (+ rec 16))
                                  op (mobj-u32 (+ rec 20))
                                  ; The root cache is this verifier's model of the roots; a
                                  ; site absent from it has zero.
                                  clo (if (< at (be-inst-count)) (mobj-roots-lower-bound at) 0)
                                  (mut chi) clo
                                  (mut expected-count) 0]
                              (if (< at (be-inst-count))
                                  (let [c (mobj-roots)
                                        total (al-len [i64] (.site c))]
                                    (loop (if (or (>= (load chi) total)
                                                  (!= (al-get [i64] (.site c)
                                                              (load chi))
                                                      at))
                                              (break)
                                              (do
                                                (set! chi (+ (load chi) 1))
                                                (set! expected-count (+ (load expected-count) 1))
                                                0)))
                                    0)
                                  0)
                              (if (or (>= at (be-inst-count))
                                      (or (not (ml-safepoint? at))
                                          (or (!= pc (mobj-safepoint-pc at))
                                              (or (!= owner (.owner (be-inst at)))
                                                  (or (!= op (.op (be-inst at)))
                                                      (or (!= root-count (load expected-count))
                                                          (> (+ root-first root-count) roots)))))))
                                  (do
                                    (set! ok false)
                                    (mobj-fail! MOBJ-STACKMAP (load site)))
                                  false)
                              (if (load ok)
                                  (let [c (mobj-roots)
                                        (mut ordinal) 0]
                                    (loop (if (or (>= (load ordinal) (load expected-count))
                                                  (not (load ok)))
                                              (break)
                                              (do
                                                (let [vr (al-get [i64]
                                                                 (.vreg c)
                                                                 (+ clo (load ordinal)))
                                                      rootrec
                                                        (+ sitebase
                                                           (+ (* sites 24)
                                                              (* (+ root-first (load ordinal)) 16)))
                                                      reg (mra-reg vr)]
                                                  (if (or (!= (mobj-u32 rootrec) vr)
                                                          (or (!= (mobj-u32 (+ rootrec 4))
                                                                  (ml-value-kind vr))
                                                              (or (!= (mobj-u32 (+ rootrec 8))
                                                                      (if (>= reg 0) 0 1))
                                                                  (!= (mobj-u32 (+ rootrec 12))
                                                                      (if (>= reg 0)
                                                                          reg
                                                                          (be-spill-off-vreg vr))))))
                                                      (do
                                                        (set! ok false)
                                                        (mobj-fail! MOBJ-STACKMAP (load site)))
                                                      false))
                                                (set! ordinal (+ (load ordinal) 1))
                                                0)))
                                    0)
                                  0))
                            (set! site (+ (load site) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [count (mobj-u32 (+ layoutoff 8))
                    (mut shape) 0]
                (loop (if (or (>= (load shape) count) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ (+ layoutoff 16) (* (load shape) 32))]
                              (if (or (!= (mobj-u32 rec) (load shape))
                                      (or (!= (mobj-u32 (+ rec 4)) (shape-size (load shape)))
                                          (or (!= (mobj-u32 (+ rec 8)) 8)
                                              (or (!= (mobj-u32 (+ rec 12))
                                                      (shape-field-count (load shape)))
                                                  (or (!= (mobj-u64 (+ rec 16))
                                                          (mobj-shape-bitmap (load shape)))
                                                      (!= (mobj-u64 (+ rec 24))
                                                          (mobj-shape-boxed-bitmap (load shape))))))))
                                  (do
                                    (set! ok false)
                                    (mobj-fail! MOBJ-LAYOUT (load shape)))
                                  false))
                            (set! shape (+ (load shape) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [(mut reloc) 0]
                (loop (if (or (>= (load reloc) actual-nreloc) (not (load ok)))
                          (break)
                          (do
                            (let [rec (+ relocoff (* (load reloc) 8))
                                  address (mobj-u32 rec)
                                  info (mobj-u32 (+ rec 4))]
                              (if (or (>= address textlen)
                                      (or (or (< (& info 16777215) basesyms)
                                              (>= (& info 16777215) (+ basesyms externs)))
                                          (!= (& (>> info 24) 255) 45)))
                                  (do
                                    (set! ok false)
                                    (mobj-fail! MOBJ-RELOCATION (load reloc)))
                                  false))
                            (set! reloc (+ (load reloc) 1))
                            0)))
                0)
              0)
          (if (load ok)
              (let [(mut s) 0]
                (loop (if (or (>= (load s) actual-nsyms) (not (load ok)))
                          (break)
                          (do
                            (let [at (+ symoff (* (load s) 16))
                                  strx (mobj-u32 at)
                                  typ (mobj-byte (+ at 4))
                                  sect (mobj-byte (+ at 5))
                                  value (mobj-u64 (+ at 8))
                                  owner (if (= (load s) (- basesyms 1)) 0 (+ (load s) 1))
                                  undef (>= (load s) basesyms)]
                              (if (or (>= strx strsize)
                                      (if undef
                                          (or (!= typ 1) (or (!= sect 0) (!= value 0)))
                                          (or (!= sect 1)
                                              (or (!= typ (if (= owner 0) 15 14))
                                                  (and (> funcs 0)
                                                       (!= value (mu-function-code-start owner)))))))
                                  (do (set! ok false) (mobj-fail! MOBJ-SYMBOL (load s)))
                                  false))
                            (set! s (+ (load s) 1))
                            0)))
                0)
              0))
        0)
    (load ok)))

(defn mobj-corrupt-byte! [(at i64) (value i64)] (-> i64)
  (al-set! [u8] (field (backend) obj) at (cast u8 value))
  0)

(defn be-macho! [] (-> i64)
  (store! (mobj-x64-target) false)
  (mobj-build-roots!)
  (let [p (backend)
        textlen (be-code-len)
        funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1)
        locals (if (> funcs 0) (- funcs 1) 0)
        nreloc (mobj-external-reloc-count)
        externs (mobj-external-symbol-count)
        nsyms (+ basesyms externs)
        stacklen (mobj-stackmap-size)
        layoutlen (mobj-layout-size)
        textoff 472
        stackoff (align8 (+ textoff textlen))
        stackaddr (align8 textlen)
        layoutaddr (align8 (+ stackaddr stacklen))
        layoutoff (align8 (+ stackoff stacklen))
        relocoff (align8 (+ layoutoff layoutlen))
        symoff (+ relocoff (* nreloc 8))
        stroff (+ symoff (* nsyms 16))
        strsize
          (+ (+ 9 (* locals 22))
             (+ (if (mobj-has-external-op? MI-CALL) 25 0)
                (+ (if (mobj-has-external-op? MI-NEW) 16 0)
                (+ (if (mobj-has-external-op? MI-JSPROP) 17 0)
                   (+ (if (mobj-has-external-op? MI-JSARRAY) 14 0)
                      (+ (if (mobj-has-jsarray-imm? 1) 14 0)
                         (+ (if (mobj-has-jsarray-imm? 2) 15 0)
                            (+ (if (mobj-has-jsarray-imm? 3) 13 0)
                               (if (mobj-has-external-op? MI-JSSTRING) 15 0)))))))))]
    (obj-begin! (+ stroff strsize))
    ; mach_header_64
    (obj-u32! 4277009103)
    (obj-u32! 16777228)
    (obj-u32! 0)
    (obj-u32! 1)
    (obj-u32! 4)
    (obj-u32! 440)
    (obj-u32! 0)
    (obj-u32! 0)
    ; LC_SEGMENT_64 + text and two versioned metadata sections.
    (obj-u32! 25)
    (obj-u32! 312)
    (obj-name16! "")
    (obj-u64! 0)
    (obj-u64! (+ layoutaddr layoutlen))
    (obj-u64! textoff)
    (obj-u64! (- (+ layoutoff layoutlen) textoff))
    (obj-u32! 7)
    (obj-u32! 7)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-name16! "__text")
    (obj-name16! "__TEXT")
    (obj-u64! 0)
    (obj-u64! textlen)
    (obj-u32! textoff)
    (obj-u32! 2)
    (obj-u32! relocoff)
    (obj-u32! nreloc)
    (obj-u32! 2147484672)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-name16! "__aot_stackmap")
    (obj-name16! "__DATA")
    (obj-u64! stackaddr)
    (obj-u64! stacklen)
    (obj-u32! stackoff)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-name16! "__aot_layout")
    (obj-name16! "__DATA")
    (obj-u64! layoutaddr)
    (obj-u64! layoutlen)
    (obj-u32! layoutoff)
    (obj-u32! 3)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    (obj-u32! 0)
    ; LC_SYMTAB
    (obj-u32! 2)
    (obj-u32! 24)
    (obj-u32! symoff)
    (obj-u32! nsyms)
    (obj-u32! stroff)
    (obj-u32! strsize)
    ; LC_DYSYMTAB: local function symbols first, then the exported `_kernel` definition.
    (obj-u32! 11)
    (obj-u32! 80)
    (obj-u32! 0)
    (obj-u32! locals)
    (obj-u32! locals)
    (obj-u32! 1)
    (obj-u32! basesyms)
    (obj-u32! externs)
    (let [(mut z) 0]
      (loop (if (>= (load z) 12)
                (break)
                (do (obj-u32! 0) (set! z (+ (load z) 1)) 0))))
    ; LC_BUILD_VERSION: macOS, minimum 11.0, SDK 11.0, no tool records.
    (obj-u32! 50)
    (obj-u32! 24)
    (obj-u32! 1)
    (obj-u32! 720896)
    (obj-u32! 720896)
    (obj-u32! 0)
    (obj-pad-to! textoff)
    (let [(mut i) 0]
      (loop (if (>= (load i) textlen)
                (break)
                (do
                  ;; AArch64 text is a little-endian sequence of aligned 32-bit instructions.
                  ;; Copy words, as Simple copies its completed encoding buffer, rather than
                  ;; re-entering the code accessor and publication loop for every byte.
                  (obj-u32! (be-code-u32 (load i)))
                  (set! i (+ (load i) 4))
                  0))))
    (obj-pad-to! stackoff)
    (mobj-write-stackmaps!)
    (obj-pad-to! layoutoff)
    (mobj-write-layouts!)
    (obj-pad-to! relocoff)
    (let [relocs (.external-inst (mobj-index))
          (mut reloc) 0]
      (loop (if (>= (load reloc) (al-len [i64] relocs))
                (break)
                (let [(mut at) (al-get [i64] relocs (load reloc))]
                  (if (and (be-runtime-allocation?) (= (ms-inst-op (load at)) MI-NEW))
                      (do
                        (obj-u32! (mobj-new-branch-pc (load at)))
                        ; ARM64_RELOC_BRANCH26, extern, 32-bit, pc-relative, symbol `basesyms`.
                        (obj-u32! (mobj-branch-reloc-info (mobj-external-symbol basesyms MI-NEW)))
                        0)
                      0)
                  (if (and (= (ms-inst-op (load at)) MI-CALL)
                           (< (.imm (be-inst (load at))) 0))
                      (do
                        (obj-u32! (mobj-dispatch-resolver-branch-pc (load at)))
                        (obj-u32! (mobj-branch-reloc-info
                                    (mobj-external-symbol basesyms MI-CALL)))
                        0)
                      0)
                  (if (= (ms-inst-op (load at)) MI-JSPROP)
                      (do
                        (obj-u32! (mobj-jsprop-branch-pc (load at)))
                        (obj-u32! (mobj-branch-reloc-info (mobj-external-symbol basesyms MI-JSPROP)))
                        0)
                      0)
                  (if (= (ms-inst-op (load at)) MI-JSARRAY)
                      (do
                        (obj-u32! (mobj-jsarray-branch-pc (load at)))
                        (obj-u32! (mobj-branch-reloc-info
                                    (mobj-jsarray-external-symbol
                                      basesyms (.imm (be-inst (load at))))))
                        0)
                      0)
                  (if (= (ms-inst-op (load at)) MI-JSSTRING)
                      (do
                        (obj-u32! (mobj-jsstring-branch-pc (load at)))
                        (obj-u32! (mobj-branch-reloc-info (mobj-external-symbol basesyms MI-JSSTRING)))
                        0)
                      0)
                  (set! reloc (+ (load reloc) 1))
                  0)))
      0)
    (obj-pad-to! symoff)
    ; Local nlist_64 records precede the exported entry as required by LC_DYSYMTAB.
    (let [(mut owner) 1
          (mut strx) 9]
      (loop (if (>= (load owner) funcs)
                (break)
                (do
                  (obj-u32! (load strx))
                  (obj-u8! 14)
                  (obj-u8! 1)
                  (obj-u8! 0)
                  (obj-u8! 0)
                  (obj-u64! (mu-function-code-start (load owner)))
                  (set! strx (+ (load strx) 22))
                  (set! owner (+ (load owner) 1))
                  0))))
    ; `_kernel` is the sole externally visible definition.
    (obj-u32! 1)
    (obj-u8! 15)
    (obj-u8! 1)
    (obj-u8! 0)
    (obj-u8! 0)
    (obj-u64! (if (> funcs 0) (mu-function-code-start 0) 0))
    (let [(mut external-strx) (+ 9 (* locals 22))]
      (if (mobj-has-external-op? MI-CALL)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1) (obj-u8! 0) (obj-u8! 0) (obj-u8! 0) (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 25))
            0)
          0)
      (if (mobj-has-external-op? MI-NEW)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 16))
            0)
          0)
      (if (mobj-has-external-op? MI-JSPROP)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 17))
            0)
          0)
      (if (mobj-has-external-op? MI-JSARRAY)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 14))
            0)
          0)
      (if (mobj-has-jsarray-imm? 1)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1) (obj-u8! 0) (obj-u8! 0) (obj-u8! 0) (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 14))
            0)
          0)
      (if (mobj-has-jsarray-imm? 2)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1) (obj-u8! 0) (obj-u8! 0) (obj-u8! 0) (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 15))
            0)
          0)
      (if (mobj-has-jsarray-imm? 3)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1) (obj-u8! 0) (obj-u8! 0) (obj-u8! 0) (obj-u64! 0)
            (set! external-strx (+ (load external-strx) 13))
            0)
          0)
      (if (mobj-has-external-op? MI-JSSTRING)
          (do
            (obj-u32! (load external-strx))
            (obj-u8! 1)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u8! 0)
            (obj-u64! 0)
            0)
          0))
    ; String table: leading NUL, `_kernel`, then fixed-width local names.
    (obj-u8! 0)
    (obj-ascii! "_kernel")
    (obj-u8! 0)
    (let [(mut owner) 1]
      (loop (if (>= (load owner) funcs)
                (break)
                (do
                  (obj-local-name! (load owner))
                  (obj-u8! 0)
                  (set! owner (+ (load owner) 1))
                  0))))
    (if (mobj-has-external-op? MI-CALL)
        (do (obj-ascii! "_aot_js_dispatch_resolve") (obj-u8! 0) 0)
        0)
    (if (mobj-has-external-op? MI-NEW)
        (do (obj-ascii! "_aot_alloc_slow") (obj-u8! 0) 0)
        0)
    (if (mobj-has-external-op? MI-JSPROP)
        (do (obj-ascii! "_aot_js_property") (obj-u8! 0) 0)
        0)
    (if (mobj-has-external-op? MI-JSARRAY)
        (do (obj-ascii! "_aot_js_array") (obj-u8! 0) 0)
        0)
    (if (mobj-has-jsarray-imm? 1)
        (do (obj-ascii! "_aot_arr_load") (obj-u8! 0) 0)
        0)
    (if (mobj-has-jsarray-imm? 2)
        (do (obj-ascii! "_aot_arr_store") (obj-u8! 0) 0)
        0)
    (if (mobj-has-jsarray-imm? 3)
        (do (obj-ascii! "_aot_arr_len") (obj-u8! 0) 0)
        0)
    (if (mobj-has-external-op? MI-JSSTRING)
        (do (obj-ascii! "_aot_js_string") (obj-u8! 0) 0)
        0)
    (al-len [u8] (.obj p))))

(defn be-macho-checked! [] (-> bool)
  (let [p (backend)
        (mut started) (monotonic/monotonic-now-ns)]
    ; Never let a previous successful publication survive a new validation attempt.
    (al-clear! [u8] (field p obj))
    (mobj-build-index!)
    (set! started (mobj-profile! "macho_index" (load started)))
    (if (or (!= (be-result) BER-OK) (= (be-code-len) 0))
        (be-fail! BER-OBJECT NO-NODE)
        (let [model-ok (mobj-verify-model!)]
          (set! started (mobj-profile! "macho_model_verify" (load started)))
          (if (not model-ok)
              (be-fail! BER-OBJECT (mobj-item))
              (let [published (be-macho!)]
                (set! started (mobj-profile! "macho_serialize" (load started)))
                (fmt (stderr) "AOTK_PROFILE phase=macho_output bytes={d} code_bytes={d}\n"
                     published (be-code-len))
                (if (<= published (be-code-len))
                    (be-fail! BER-OBJECT NO-NODE)
                    (let [bytes-ok (mobj-verify-bytes!)]
                      (set! started (mobj-profile! "macho_bytes_verify" (load started)))
                      (if bytes-ok true (be-fail! BER-OBJECT (mobj-item)))))))))))

;; The in-process ARM64 executor already owns encoded text and resolves runtime branches directly.
;; It needs GC metadata, not a Mach-O header, symbol table, relocation table, or a second copy of
;; text. Publish the same model-verified stack maps and layouts into the backend object buffer as a
;; compact execution image. Full object publication remains the default and the release/test path.
(defn mobj-memory-layout-offset-ptr [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn be-memory-metadata-checked! [] (-> bool)
  (let [p (backend)
        (mut started) (monotonic/monotonic-now-ns)]
    (al-clear! [u8] (field p obj))
    (mobj-build-index!)
    (set! started (mobj-profile! "memory_index" (load started)))
    (mobj-build-roots!)
    (if (or (!= (be-result) BER-OK) (= (be-code-len) 0))
        (be-fail! BER-OBJECT NO-NODE)
        (let [model-ok (mobj-verify-model!)]
          (set! started (mobj-profile! "memory_model_verify" (load started)))
          (if (not model-ok)
              (be-fail! BER-OBJECT (mobj-item))
              (let [stacklen (mobj-stackmap-size)
                    layoutoff (align8 stacklen)
                    total (+ layoutoff (mobj-layout-size))]
                (store! (mobj-memory-layout-offset-ptr) layoutoff)
                (if (not (obj-begin! total))
                    false
                    (do
                      (mobj-write-stackmaps!)
                      (obj-pad-to! layoutoff)
                      (mobj-write-layouts!)
                      (set! started (mobj-profile! "memory_metadata_serialize" (load started)))
                      (= (be-object-len) total)))))))))

(defn be-memory-stackmap-data [] (-> (ptr u8))
  (be-object-data))

(defn be-memory-layout-data [] (-> (ptr u8))
  (cast (ptr u8) (+ (cast i64 (be-object-data))
                    (load (mobj-memory-layout-offset-ptr)))))

(defn be-object-len [] (-> i64)
  (if (= (be-result) BER-OK) (al-len [u8] (.obj (backend))) 0))
(defn be-object-data [] (-> (ptr u8))
  (.data (.obj (backend))))
