;; Mach-O object layout, relocations, stack maps, layout metadata, and byte verification.
(module backend_macho)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "backend_allocate" :use *)
(import "backend_aarch64" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "monotonic" :as monotonic)

(extern realloc :cc c [(ptr u8) i64] (-> (ptr u8)))

(defn mobj-profile! [(phase (slice u8)) (started i64)] (-> i64)
  (let [now (monotonic/monotonic-now-ns)]
    (fmt (stderr) "AOTK_PROFILE phase={s} ns={d}\n" phase (- now started))
    now))

;;; Stack-map PCs are target instruction offsets, not portable Machine IR facts. Mach-O/AArch64
;;; historically reconstructed them from fixed-width instruction counts; x86 records the exact
;;; byte offset while encoding variable-length calls. Object publication selects the matching
;;; interpretation before writing and independently verifying metadata.
(defn mobj-x64-target [] (-> (ptr bool)) (primitive/alloc-static bool))

;;; Facts discovered while encoding/publication begins. Simple records these while emitting; this
;;; cache is the AOT Kit phase boundary until relocation records move into the encoder itself. Most
;;; importantly, every query below is O(1): the former implementation rescanned all instructions
;;; for each symbol query and then repeated those queries for every relocation.
(defstruct MobjPublicationIndex
  [(external-mask i64)
   (external-inst (ArrayList i64))
   ;; RELOCATIONS BUCKETED BY OWNING FUNCTION, as three CSR tables.
   ;;
   ;; Extracting one function's text used to walk EVERY internal call relocation, EVERY internal
   ;; address relocation and EVERY external relocation in the unit, asking each whether it belonged
   ;; to this owner. The snapshot then did that once per function, so the retained-image path was
   ;; O(functions x relocations) -- about a fifth of a 14.7 second per-request phase.
   ;;
   ;; Counting sort keyed on the owner, built once alongside the instruction index. Entries stay in
   ;; ascending relocation-id order inside a bucket, which is the order the extraction emitted them
   ;; in before and therefore the order the record's payload still has.
   ;; One kind-major table rather than three parallel triples: a Coil `(mut …)` place cannot be
   ;; returned from a function, so selecting a table per relocation kind would mean repeating every
   ;; mutation three times. `kind * functions + owner` indexes the bucket instead.
   (reloc-first (ArrayList i64))
   (reloc-count (ArrayList i64))
   (reloc-entry (ArrayList i64))
   ;; The instruction id range one function occupies, as [first, end). Extracting a function's text
   ;; asked FOUR separate questions of every instruction in the unit -- is this MOVI mine, is this
   ;; safepoint mine -- so a snapshot of n functions read the instruction array 4n times. Selection
   ;; emits function by function, so a min/max per owner is the exact range; scanning it and still
   ;; testing the owner stays correct even if that ever stops being contiguous.
   (owner-inst-first (ArrayList i64))
   (owner-inst-end (ArrayList i64))
   (inited bool)])

(defn mobj-index [] (-> (ptr MobjPublicationIndex))
  (let [p (primitive/alloc-static MobjPublicationIndex)]
    (if (.inited p)
        0
        (do
          (set! (.external-inst p) (al-new [i64] (malloc-allocator)))
          (set! (.reloc-first p) (al-new [i64] (malloc-allocator)))
          (set! (.reloc-count p) (al-new [i64] (malloc-allocator)))
          (set! (.reloc-entry p) (al-new [i64] (malloc-allocator)))
          (set! (.owner-inst-first p) (al-new [i64] (malloc-allocator)))
          (set! (.owner-inst-end p) (al-new [i64] (malloc-allocator)))
          (set! (.inited p) true)
          0))
    p))

(defn mobj-index-jsarray-bit [(operation i64)] (-> i64)
  (if (and (>= operation 1) (<= operation 3)) (<< 1 (+ 51 operation)) 0))

;;; RELOC-BUCKET-KIND selects which relocation table a bucket build or query is about. The three
;;; tables are shaped identically -- a count and a per-entry owning function -- so one builder and
;;; one pair of accessors serve all three rather than three copies of a counting sort.
(const MOBJ-RELOC-CALL i64 0)
(const MOBJ-RELOC-ADDRESS i64 1)
(const MOBJ-RELOC-EXTERNAL i64 2)

(defn mobj-reloc-kind-count [(kind i64)] (-> i64)
  (case kind
        MOBJ-RELOC-CALL (mu-internal-call-reloc-count)
        MOBJ-RELOC-ADDRESS (mu-internal-address-reloc-count)
        (mobj-external-reloc-count)))

(defn mobj-reloc-kind-owner [(kind i64) (i i64)] (-> i64)
  (case kind
        MOBJ-RELOC-CALL (mu-internal-call-reloc-source i)
        MOBJ-RELOC-ADDRESS (mu-internal-address-reloc-source i)
        (ms-inst-owner (mobj-external-reloc-inst i))))

(defn mobj-reloc-slot [(kind i64) (owner i64)] (-> i64)
  (+ (* kind (mu-function-count)) owner))

;;; Counting sort on the owner, for all three relocation kinds at once. Two passes over the
;;; relocations plus one over the functions; the fill pass walks ids ascending and appends, so a
;;; bucket ends up in ascending relocation-id order -- the order extraction emitted them in before,
;;; and therefore the order a record's payload still has.
(defn mobj-build-reloc-buckets! [] (-> i64)
  (let [p (mobj-index)
        functions (mu-function-count)
        slots (* 3 functions)
        (mut kind) 0
        (mut i) 0
        (mut cursor) 0]
    (al-clear! [i64] (field p reloc-first))
    (al-clear! [i64] (field p reloc-count))
    (al-clear! [i64] (field p reloc-entry))
    (loop (if (>= (load i) slots) (break)
              (do (al-push! [i64] (field p reloc-first) 0)
                  (al-push! [i64] (field p reloc-count) 0)
                  (set! i (+ (load i) 1)))))
    (loop (if (>= (load kind) 3) (break)
              (do
                (set! i 0)
                (loop (if (>= (load i) (mobj-reloc-kind-count (load kind))) (break)
                          (do
                            (let [owner (mobj-reloc-kind-owner (load kind) (load i))]
                              (if (and (>= owner 0) (< owner functions))
                                  (let [slot (mobj-reloc-slot (load kind) owner)]
                                    (al-set! [i64] (field p reloc-count) slot
                                             (+ (al-get [i64] (.reloc-count p) slot) 1)))
                                  0))
                            (set! i (+ (load i) 1)))))
                (set! kind (+ (load kind) 1)))))
    (set! i 0)
    (loop (if (>= (load i) slots) (break)
              (do (al-set! [i64] (field p reloc-first) (load i) (load cursor))
                  (set! cursor (+ (load cursor) (al-get [i64] (.reloc-count p) (load i))))
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (load cursor)) (break)
              (do (al-push! [i64] (field p reloc-entry) -1) (set! i (+ (load i) 1)))))
    ;; Reuse the counts as fill cursors, then restore them from the boundaries below.
    (set! i 0)
    (loop (if (>= (load i) slots) (break)
              (do (al-set! [i64] (field p reloc-count) (load i) 0) (set! i (+ (load i) 1)))))
    (set! kind 0)
    (loop (if (>= (load kind) 3) (break)
              (do
                (set! i 0)
                (loop (if (>= (load i) (mobj-reloc-kind-count (load kind))) (break)
                          (do
                            (let [owner (mobj-reloc-kind-owner (load kind) (load i))]
                              (if (and (>= owner 0) (< owner functions))
                                  (let [slot (mobj-reloc-slot (load kind) owner)
                                        fill (al-get [i64] (.reloc-count p) slot)]
                                    (al-set! [i64] (field p reloc-entry)
                                             (+ (al-get [i64] (.reloc-first p) slot) fill) (load i))
                                    (al-set! [i64] (field p reloc-count) slot (+ fill 1)))
                                  0))
                            (set! i (+ (load i) 1)))))
                (set! kind (+ (load kind) 1)))))
    0))

(defn mobj-build-owner-inst-ranges! [] (-> i64)
  (let [p (mobj-index)
        functions (mu-function-count)
        insts (be-inst-count)
        (mut i) 0]
    (al-clear! [i64] (field p owner-inst-first))
    (al-clear! [i64] (field p owner-inst-end))
    (loop (if (>= (load i) functions) (break)
              (do (al-push! [i64] (field p owner-inst-first) insts)
                  (al-push! [i64] (field p owner-inst-end) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) insts) (break)
              (do
                (let [owner (ms-inst-owner (load i))]
                  (if (and (>= owner 0) (< owner functions))
                      (do
                        (if (< (load i) (al-get [i64] (.owner-inst-first p) owner))
                            (al-set! [i64] (field p owner-inst-first) owner (load i)) 0)
                        (if (>= (load i) (al-get [i64] (.owner-inst-end p) owner))
                            (al-set! [i64] (field p owner-inst-end) owner (+ (load i) 1)) 0))
                      0))
                (set! i (+ (load i) 1)))))
    0))

(defn mobj-owner-inst-first [(owner i64)] (-> i64)
  (let [p (mobj-index)]
    (if (or (< owner 0) (>= owner (al-len [i64] (.owner-inst-first p)))) 0
        (al-get [i64] (.owner-inst-first p) owner))))

(defn mobj-owner-inst-end [(owner i64)] (-> i64)
  (let [p (mobj-index)]
    (if (or (< owner 0) (>= owner (al-len [i64] (.owner-inst-end p)))) (be-inst-count)
        (al-get [i64] (.owner-inst-end p) owner))))

(defn mobj-owner-reloc-count [(kind i64) (owner i64)] (-> i64)
  (let [p (mobj-index) slot (mobj-reloc-slot kind owner)]
    (if (or (< owner 0) (>= slot (al-len [i64] (.reloc-count p)))) 0
        (al-get [i64] (.reloc-count p) slot))))

(defn mobj-owner-reloc [(kind i64) (owner i64) (which i64)] (-> i64)
  (let [p (mobj-index) slot (mobj-reloc-slot kind owner)]
    (al-get [i64] (.reloc-entry p)
            (+ (al-get [i64] (.reloc-first p) slot) which))))

(defn mobj-build-index! [] (-> i64)
  (let [p (mobj-index)
        (mut at) 0
        (mut mask) 0]
    (al-clear! [i64] (field p external-inst))
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (.op m)
                      external
                        (or (= op MI-JSPROP)
                            (or (= op MI-JSARRAY)
                                (or (= op MI-JSSTRING)
                                    (or (and (be-runtime-allocation?) (= op MI-NEW))
                                        (and (= op MI-CALL) (< (.imm m) 0))))))]
                  (if external
                      (do
                        (al-push! [i64] (field p external-inst) (load at))
                        (set! mask (| (load mask) (<< 1 op)))
                        (if (= op MI-JSARRAY)
                            (set! mask (| (load mask) (mobj-index-jsarray-bit (.imm m))))
                            0)
                        0)
                      0))
                (set! at (+ (load at) 1))
                0)))
    (set! (.external-mask p) (load mask))
    (mobj-build-reloc-buckets!)
    (mobj-build-owner-inst-ranges!)
    0))

(defn obj-u8! [(v i64)] (-> i64)
  (let [out (field (backend) obj)
        at (.len out)]
    (if (>= at (.cap out))
        (do (be-fail! BER-OBJECT NO-NODE) 0)
        (do
          (set! (index (.data out) at) (cast u8 (& v 255)))
          (set! (.len out) (+ at 1))
          0))))

;;; Mach-O computes its exact final size before writing its first byte. Materialize that phase
;;; boundary in the output buffer: one allocation, then cursor writes. This is the same ownership
;;; model as Simple's exact-size ByteBuffer and avoids generic ArrayList growth checks per byte.
(defn obj-begin! [(size i64)] (-> bool)
  (let [out (field (backend) obj)]
    (if (< (.cap out) size)
        (let [data (realloc (.data out) size)]
          (if (= (cast i64 data) 0)
              (be-fail! BER-OBJECT NO-NODE)
              (do
                (set! (.data out) data)
                (set! (.cap out) size)
                (set! (.len out) 0)
                true)))
        (do (set! (.len out) 0) true))))
(defn obj-u32! [(v i64)] (-> i64)
  (obj-u8! v)
  (obj-u8! (>> v 8))
  (obj-u8! (>> v 16))
  (obj-u8! (>> v 24))
  0)
(defn obj-u64! [(v i64)] (-> i64)
  (obj-u32! v)
  (obj-u32! (>> v 32))
  0)
(defn obj-name16! [(s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) 16)
              (break)
              (do
                (obj-u8! (if (< (load i) n) (cast i64 (slice-get s (load i))) 0))
                (set! i (+ (load i) 1))
                0)))
    0))
(defn obj-pad-to! [(at i64)] (-> i64)
  (loop (if (>= (al-len [u8] (.obj (backend))) at)
            (break)
            (obj-u8! 0)))
  0)
(defn align8 [(n i64)] (-> i64)
  (& (+ n 7) -8))

(defn obj-ascii! [(s (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len s))
              (break)
              (do
                (obj-u8! (cast i64 (slice-get s (load i))))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn obj-hex-digit [(v i64)] (-> i64)
  (if (< v 10) (+ 48 v) (+ 87 v)))

; Fixed-width names make string-table offsets independent of function count and layout order.
(defn obj-local-name! [(owner i64)] (-> i64)
  (obj-ascii! "_aot_")
  (let [(mut shift) 60]
    (loop (if (< (load shift) 0)
              (break)
              (do
                (obj-u8! (obj-hex-digit (& (>> owner (load shift)) 15)))
                (set! shift (- (load shift) 4))
                0)))
    0))

(defn mobj-safepoint-count [] (-> i64)
  (let [(mut at) 0
        (mut count) 0]
    (loop (if (>= (load at) (be-inst-count))
              (break)
              (do
                (if (ml-safepoint? (load at)) (set! count (+ (load count) 1)) 0)
                (set! at (+ (load at) 1))
                0)))
    (load count)))

(defn mobj-external-reloc-count [] (-> i64)
  (al-len [i64] (.external-inst (mobj-index))))
(defn mobj-external-reloc-inst [(i i64)] (-> i64)
  (al-get [i64] (.external-inst (mobj-index)) i))

(defn mobj-has-external-op? [(wanted i64)] (-> bool)
  (!= (& (.external-mask (mobj-index)) (<< 1 wanted)) 0))

(defn mobj-has-jsarray-imm? [(wanted i64)] (-> bool)
  (!= (& (.external-mask (mobj-index)) (mobj-index-jsarray-bit wanted)) 0))

(defn mobj-external-symbol-count [] (-> i64)
  (+ (if (mobj-has-external-op? MI-CALL) 1 0)
     (+ (if (mobj-has-external-op? MI-NEW) 1 0)
     (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
        (+ (if (mobj-has-external-op? MI-JSARRAY) 1 0)
           (+ (if (mobj-has-jsarray-imm? 1) 1 0)
              (+ (if (mobj-has-jsarray-imm? 2) 1 0)
                 (+ (if (mobj-has-jsarray-imm? 3) 1 0)
                    (if (mobj-has-external-op? MI-JSSTRING) 1 0)))))))))

(defn mobj-external-symbol [(basesyms i64) (op i64)] (-> i64)
  (if (= op MI-CALL)
      basesyms
      (let [base (+ basesyms (if (mobj-has-external-op? MI-CALL) 1 0))]
        (if (= op MI-NEW)
            base
            (if (= op MI-JSPROP)
                (+ base (if (mobj-has-external-op? MI-NEW) 1 0))
                (if (= op MI-JSARRAY)
                    (+ base
                       (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                          (if (mobj-has-external-op? MI-JSPROP) 1 0)))
                    (+ base
                       (+ (if (mobj-has-external-op? MI-NEW) 1 0)
                          (+ (if (mobj-has-external-op? MI-JSPROP) 1 0)
                             (+ (if (mobj-has-external-op? MI-JSARRAY) 1 0)
                                (+ (if (mobj-has-jsarray-imm? 1) 1 0)
                                   (+ (if (mobj-has-jsarray-imm? 2) 1 0)
                                      (if (mobj-has-jsarray-imm? 3) 1 0)))))))))))))

(defn mobj-dispatch-resolver-branch-pc [(at i64)] (-> i64)
  (.last (be-inst at)))

(defn mobj-jsarray-external-symbol [(basesyms i64) (operation i64)] (-> i64)
  (let [generic (mobj-external-symbol basesyms MI-JSARRAY)]
    (cond (= operation 1) (+ generic 1)
          (= operation 2) (+ (+ generic 1) (if (mobj-has-jsarray-imm? 1) 1 0))
          (= operation 3) (+ (+ generic 1)
                             (+ (if (mobj-has-jsarray-imm? 1) 1 0)
                                (if (mobj-has-jsarray-imm? 2) 1 0)))
          :else generic)))

(defn mobj-new-branch-pc [(at i64)] (-> i64)
  ;; Runtime MI-NEW is a fixed 39-word sequence; the external slow-path BL is word 37.
  (+ (.first (be-inst at)) (* 37 4)))

(defn mobj-spill-load-words [(vr i64)] (-> i64)
  (if (and (>= vr 0) (< (be-reg-of vr) 0))
      (be-stack-access-words (be-spill-off-vreg vr)) 0))

(defn mobj-jsprop-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        key (ms-inst-arg at 0)
        spill-loads
          (+ (mobj-spill-load-words (.a m))
             (+ (mobj-spill-load-words (.b m))
                (mobj-spill-load-words key)))]
    (+ (.first m)
       (* 4
          (+ spill-loads
             (+ 7 (be-mov-words (.imm m))))))))

(defn mobj-jsarray-branch-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        value (ms-inst-arg at 0)
        spill-loads
          (+ (mobj-spill-load-words (.a m))
             (+ (mobj-spill-load-words (.b m))
                (mobj-spill-load-words value)))]
    (+ (.first m)
       (* 4 (+ spill-loads (+ 6 (be-mov-words (.imm m))))))))

(defn mobj-jsstring-branch-pc [(at i64)] (-> i64)
  (+ (+ (mobj-jsarray-branch-pc at) 4)
     (if (= (.imm (be-inst at)) JSSOP-FROM-DOUBLE-BITS) 4 0)))

(defn mobj-safepoint-pc [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)]
    (if (or (load (mobj-x64-target))
            (and (= op MI-CALL) (< (.imm m) 0)))
        ;; The x64 encoder stores the byte immediately after each direct call in `.earliest`.
        ;; Polymorphic dispatch currently stores its common continuation there, matching the
        ;; previous one-record-per-MI-CALL metadata contract without re-running AArch64 sizing.
        (.earliest m)
        (case op MI-NEW
          (if (be-runtime-allocation?)
              (+ (mobj-new-branch-pc at) 4)
              (load (field m first)))
            MI-CALL
          (let [argc (load (field m arg-count))
                here (load (field m first))
                base-area (be-call-area (if (be-poly-call? m) (+ (* argc 2) 2) argc))
                bundle (mu-call-bundle (mu-inst-call-bundle at))
                result-area (if (be-poly-call? m) 0 (.result-area-size bundle))
                area (+ base-area result-area)
                result-setup
                  (be-call-result-setup-words (.owner m) area result-area)
                common
                  (+ argc
                     (+ (be-call-spill-load-words m area)
                        (+ (be-call-register-loads m)
                           (* 2 (be-call-stack-count m)))))
                setup
                  (if (be-poly-call? m)
                      (+ 12
                         (+ common
                            (+ (if (< (be-reg-of (load (field m a))) 0)
                                   (be-stack-access-words
                                     (be-spill-off-vreg (load (field m a)))) 0)
                               (+ (be-mov-words JSV-TAG-MASK)
                                  (+ (be-mov-words JSV-FUNCTION)
                                     (+ (be-mov-words JSV-PAYLOAD-MASK)
                                        (be-poly-call-dispatch-words m)))))))
                      (+ (be-sp-adjust-words area)
                         (+ result-setup (+ common 1))))]
            ;; setup includes the call instruction itself; stack maps name its return PC.
            (+ here (* 4 setup)))
            -1))))

(defn mobj-branch-reloc-info [(symbol i64)] (-> i64)
  (| symbol (| (<< 1 24) (| (<< 2 25) (| (<< 1 27) (<< 2 28))))))

(defn mobj-root? [(at i64) (vr i64)] (-> bool)
  (and (if (= (ms-inst-op at) MI-CALL)
           (and (!= (ms-inst-dst at) vr) (ml-live-after? at vr))
           (ml-live-before? at vr))
       (!= (ml-value-kind vr) MLK-SCALAR)))

;;; All stackmap roots, computed by ONE backward liveness walk per block and read by everything
;;; downstream. The per-query path above (mobj-root? -> ml-live-before?) rescans the block tail
;;; for every (safepoint, vreg) pair, and the layout, the two stackmap sweeps, and the byte
;;; verifier each repeated that product — it made the Mach-O step dominate large emits. The
;;; per-query form stays as the reference implementation (the object tests exercise it).
(defstruct MobjRootCache
  [(site (ArrayList i64))     ; root entry -> safepoint instruction, grouped ascending
   (vreg (ArrayList i64))     ; root entry -> vreg, ascending within a site
   (tmp-site (ArrayList i64))
   (tmp-first (ArrayList i64))
   (tmp-count (ArrayList i64))
   (tmp-vreg (ArrayList i64))
   (flags (ArrayList i64))    ; packed per-vreg live flags during the block walk
   ;; SUMMARY OF `flags`: one bit per flags WORD, set exactly when that word is non-zero. Every
   ;; safepoint publishes its roots by reading the live set, and reading it meant scanning one bit
   ;; per vreg in the whole unit -- 9,455 words for the DataView Test262 file, at every one of
   ;; thousands of safepoints. Under 2% of those words are ever non-zero. The summary makes the
   ;; scan proportional to the live set instead of to the program: `words/64` summary reads plus
   ;; one read per word that actually holds a live value. Kept EXACT rather than conservative --
   ;; a word that reaches zero clears its summary bit -- because a summary that only ever gains
   ;; bits degrades back to the full scan over the course of a function.
   (flag-summary (ArrayList i64))
   (touched (ArrayList i64))  ; vregs whose flag may need clearing before the next block
   ;; Final instruction position -> non-empty block beginning there. This orders block-local root
   ;; streams without sorting the global `(site,vreg)` product afterward.
   (block-at-inst (ArrayList i64))
   (inited bool)])

(defn mobj-roots [] (-> (ptr MobjRootCache))
  (let [c (primitive/alloc-static MobjRootCache)]
    (if (.inited c)
        0
        (do
          (set! (.site c) (al-new [i64] (malloc-allocator)))
          (set! (.vreg c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-site c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-first c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-count c) (al-new [i64] (malloc-allocator)))
          (set! (.tmp-vreg c) (al-new [i64] (malloc-allocator)))
          (set! (.flags c) (al-new [i64] (malloc-allocator)))
          (set! (.flag-summary c) (al-new [i64] (malloc-allocator)))
          (set! (.touched c) (al-new [i64] (malloc-allocator)))
          (set! (.block-at-inst c) (al-new [i64] (malloc-allocator)))
          (set! (.inited c) true)
          0))
    c))

;;; The summary is grown alongside `flags` and indexed the same way, one level up.
(defn mobj-summary-set! [(word i64)] (-> i64)
  (let [c (mobj-roots) outer (/ word 64)]
    (loop (if (> (al-len [i64] (.flag-summary c)) outer) (break)
              (do (al-push! [i64] (field c flag-summary) 0) 0)))
    (al-set! [i64] (field c flag-summary) outer
             (| (al-get [i64] (.flag-summary c) outer) (<< 1 (& word 63))))
    0))

;;; Called after a flags word has been cleared. Exact, not conservative: the summary bit goes away
;;; the moment its word does, so a long function cannot accumulate a summary that is all ones.
(defn mobj-summary-clear-if-empty! [(word i64)] (-> i64)
  (let [c (mobj-roots) outer (/ word 64)]
    (if (and (!= (al-get [i64] (.flags c) word) 0)
             (< outer (al-len [i64] (.flag-summary c))))
        0
        (if (>= outer (al-len [i64] (.flag-summary c)))
            0
            (al-set! [i64] (field c flag-summary) outer
                     (& (al-get [i64] (.flag-summary c) outer)
                        (^ (<< 1 (& word 63)) -1)))))
    0))

(defn mobj-mark-use! [(vreg i64)] (-> i64)
  (let [c (mobj-roots)]
    (if (>= vreg 0)
        (let [word (/ vreg 64)]
          (if (< word (al-len [i64] (.flags c)))
              (let [old (al-get [i64] (.flags c) word)]
                (if (= (& old (ml-bit vreg)) 0)
                    (do
                      (al-set! [i64] (field c flags) word (| old (ml-bit vreg)))
                      (mobj-summary-set! word)
                      (al-push! [i64] (field c touched) vreg))
                    0)
                0)
              0))
        0)))

(defn mobj-mark-inst-uses! [(at i64)] (-> i64)
  (let [m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)]
    (if (> inputs 0) (mobj-mark-use! (.a m)) 0)
    (if (> inputs 1) (mobj-mark-use! (.b m)) 0)
    (if (= op MI-CSEL) (mobj-mark-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (mobj-mark-use! (al-get (.call-args (machine-unit))
                                          (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    0))

(defn mobj-note-root-snapshot! [(at i64) (exclude i64) (vregs i64)] (-> i64)
  (let [c (mobj-roots)
        first (al-len [i64] (.tmp-vreg c))
        words (al-len [i64] (.flags c))
        summary-words (al-len [i64] (.flag-summary c))
        (mut outer) 0
        (mut count) 0]
    ;; Ascending vreg publication is preserved because both levels are walked low bit first: the
    ;; summary names words in order and each word names vregs in order. The scan touches one
    ;; summary word per 4,096 vregs and one flags word per 64 LIVE vregs, where it used to touch
    ;; one flags word per 64 vregs in the entire compilation unit at every safepoint.
    (loop (if (>= (load outer) summary-words)
              (break)
              (do
                (let [outer-bits (al-get [i64] (.flag-summary c) (load outer))]
                  (if (!= outer-bits 0)
                      (let [(mut slot) 0]
                        (loop (if (>= (load slot) 64)
                                  (break)
                                  (do
                                    (if (!= (& outer-bits (<< 1 (load slot))) 0)
                                        (let [word (+ (* (load outer) 64) (load slot))]
                                          (if (>= word words) 0
                                            (let [bits (al-get [i64] (.flags c) word)
                                                  (mut bit) 0]
                                              (loop (if (>= (load bit) 64)
                                                        (break)
                                                        (do
                                                          (if (!= (& bits (<< 1 (load bit))) 0)
                                                              (let [vr (+ (* word 64) (load bit))]
                                                                (if (and (< vr vregs)
                                                                         (and (!= vr exclude)
                                                                              (!= (ml-value-kind vr)
                                                                                  MLK-SCALAR)))
                                                                    (do
                                                                      (al-push! [i64]
                                                                                (field c tmp-vreg) vr)
                                                                      (set! count (+ (load count) 1))
                                                                      0)
                                                                    0))
                                                              0)
                                                          (set! bit (+ (load bit) 1))
                                                          0))))))
                                        0)
                                    (set! slot (+ (load slot) 1))
                                    0))))
                      0))
                (set! outer (+ (load outer) 1))
                0)))
    (al-push! [i64] (field c tmp-site) at)
    (al-push! [i64] (field c tmp-first) first)
    (al-push! [i64] (field c tmp-count) (load count))
    0))

(defn mobj-build-block-roots! [(bid i64) (vregs i64)] (-> i64)
  (let [c (mobj-roots)
        u (machine-unit)
        words (ml-live-words)
        owner (mu-block-owner bid)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut touched) 0
        (mut word) 0
        (mut i) count]
    (al-clear! [i64] (field c tmp-site))
    (al-clear! [i64] (field c tmp-first))
    (al-clear! [i64] (field c tmp-count))
    (al-clear! [i64] (field c tmp-vreg))
    (loop (if (>= (al-len [i64] (.flags c)) words)
              (break)
              (do (al-push! [i64] (field c flags) 0))))
    ;; Clear only bits touched by the prior block, then expand this block's function-local row.
    (loop (if (>= (load touched) (al-len [i64] (.touched c)))
              (break)
              (do
                (let [vr (al-get [i64] (.touched c) (load touched))
                      global-word (/ vr 64)]
                  (al-set! [i64] (field c flags) global-word
                           (& (al-get [i64] (.flags c) global-word) (^ (ml-bit vr) -1)))
                  (mobj-summary-clear-if-empty! global-word))
                (set! touched (+ (load touched) 1))
                0)))
    (al-clear! [i64] (field c touched))
    ;; Seed from the block's live-out set by walking its chunks. This used to read one word per
    ;; vreg in the owning function, for every block in the unit.
    (set! word (ml-set-first (ml-block-set ML-SET-OUT bid)))
    (loop (if (< (load word) 0)
              (break)
              (do
                (let [bits (ml-chunk-bits (load word))
                      chunk-word (ml-chunk-word (load word))
                      (mut bit) (if (= bits 0) 64 0)]
                  (loop (if (>= (load bit) 64)
                            (break)
                            (do
                              (if (!= (& bits (<< 1 (load bit))) 0)
                                  (let [local (+ (* chunk-word 64) (load bit))]
                                    (if (< local (al-get (.live-owner-count u) owner))
                                        (mobj-mark-use! (ml-owner-vreg owner local))
                                        0))
                                  0)
                              (set! bit (+ (load bit) 1))))))
                (set! word (ml-chunk-next (load word))))))
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [at (+ first (load i))
                      m (be-inst at)
                      op (.op m)
                      dst (.dst m)]
                  ; Arriving here the flags hold live-AFTER `at`; a call reads its roots now,
                  ; excluding its own destination, exactly as mobj-root? does.
                  (if (= op MI-CALL)
                      (mobj-note-root-snapshot! at dst vregs)
                      0)
                  (if (>= dst 0)
                      (let [word (/ dst 64)]
                        (al-set! [i64] (field c flags) word
                                 (& (al-get [i64] (.flags c) word) (^ (ml-bit dst) -1)))
                        (mobj-summary-clear-if-empty! word))
                      0)
                  (mobj-mark-inst-uses! at)
                  ; After the kill and the uses the flags hold live-BEFORE `at`.
                  (if (= op MI-NEW)
                      (mobj-note-root-snapshot! at -1 vregs)
                      0))
                0)))
    ;; The walk visited safepoints in descending order; publish ascending.
    (let [sites (al-len [i64] (.tmp-site c))
          (mut s) sites]
      (loop (if (<= (load s) 0)
                (break)
                (do
                  (set! s (- (load s) 1))
                  (let [site (al-get [i64] (.tmp-site c) (load s))
                        rf (al-get [i64] (.tmp-first c) (load s))
                        rc (al-get [i64] (.tmp-count c) (load s))
                        (mut k) 0]
                    (loop (if (>= (load k) rc)
                              (break)
                              (do
                                (al-push! [i64] (field c site) site)
                                (al-push! [i64] (field c vreg)
                                          (al-get [i64] (.tmp-vreg c)
                                                  (+ rf (load k))))
                                (set! k (+ (load k) 1))
                                0))))
                  0))))
    0))

(defn mobj-build-roots! [] (-> i64)
  (let [c (mobj-roots)
        vregs (ml-vreg-count)
        blocks (mu-block-count)
        insts (be-inst-count)
        (mut bid) 0
        (mut at) 0]
    (al-clear! [i64] (field c site))
    (al-clear! [i64] (field c vreg))
    (al-clear! [i64] (field c block-at-inst))
    (loop (if (>= (load at) insts) (break)
              (do
                (al-push! [i64] (field c block-at-inst) -1)
                (set! at (+ (load at) 1)))))
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (if (> (mu-block-inst-count (load bid)) 0)
                    (let [first (mu-block-inst-first (load bid))]
                      (if (or (< first 0) (>= first insts))
                          (panic-corrupt "non-empty block has invalid final instruction range")
                          (al-set! [i64] (field c block-at-inst) first (load bid))))
                    0)
                (set! bid (+ (load bid) 1))
                0)))
    ;; A block publishes sites ascending internally. Walking block beginnings by final instruction
    ;; position therefore produces the global `(site,vreg)` order directly in O(I+B+R).
    (set! at 0)
    (loop (if (>= (load at) insts) (break)
              (do
                (let [block (al-get [i64] (.block-at-inst c) (load at))]
                  (if (>= block 0) (mobj-build-block-roots! block vregs) 0))
                (set! at (+ (load at) 1)))))
    0))

(defn mobj-root-count [] (-> i64)
  (al-len [i64] (.vreg (mobj-roots))))
(defn mobj-root-site [(i i64)] (-> i64)
  (al-get [i64] (.site (mobj-roots)) i))
(defn mobj-root-vreg [(i i64)] (-> i64)
  (al-get [i64] (.vreg (mobj-roots)) i))

;;; Managed overflow results are roots at the call safepoint even though they do not have vregs:
;;; the callee writes them into caller-owned storage through the hidden result pointer.  Keep this
;;; derivation beside the ordinary liveness-root cache so every direct-object size, site, record,
;;; and verifier calculation observes one exact root set.
(defn mobj-overflow-root-count-at [(at i64)] (-> i64)
  (if (or (< at 0) (>= at (be-inst-count))) 0
      (let [m (be-inst at)]
        (if (or (!= (.op m) MI-CALL) (< (.node m) 0)) 0
            (let [results (be-call-result-count (.node m)) (mut slot) 0 (mut count) 0]
              (loop (if (>= (load slot) results) (break)
                        (let [offset (be-call-result-area-offset (.node m) (load slot))
                              kind (be-call-result-kind-at (.node m) (load slot))]
                          (if (and (>= offset 0)
                                   (or (= kind MLK-RAW-MANAGED) (= kind MLK-BOXED)))
                              (set! count (+ (load count) 1)) 0)
                          (set! slot (+ (load slot) 1)))))
              (load count))))))

(defn mobj-overflow-root-count [] (-> i64)
  (let [(mut at) 0 (mut count) 0]
    (loop (if (>= (load at) (be-inst-count)) (break)
              (do
                (if (ml-safepoint? (load at))
                    (set! count (+ (load count) (mobj-overflow-root-count-at (load at)))) 0)
                (set! at (+ (load at) 1)))))
    (load count)))

;;; First cache position whose site is >= at. Cache sites ascend, so [result..) begins at's
;;; root range (possibly empty).
(defn mobj-roots-lower-bound [(at i64)] (-> i64)
  (let [c (mobj-roots)
        (mut lo) 0
        (mut hi) (al-len [i64] (.site c))]
    (loop (if (>= (load lo) (load hi))
              (break)
              (let [mid (/ (+ (load lo) (load hi)) 2)]
                (if (< (al-get [i64] (.site c) mid) at)
                    (set! lo (+ mid 1))
                    (set! hi mid))
                0)))
    (load lo)))

(defn mobj-stackmap-size [] (-> i64)
  (+ 24
     (+ (* (mu-function-count) 40)
        (+ (* (mobj-safepoint-count) 24)
           (* (+ (mobj-root-count) (mobj-overflow-root-count)) 16)))))
(defn mobj-layout-size [] (-> i64)
  (+ 16 (* (shape-count) 32)))

(defn mobj-write-stackmaps! [] (-> i64)
  (let [sites (mobj-safepoint-count)
        roots (+ (mobj-root-count) (mobj-overflow-root-count))
        (mut phase-start) (ms-profile-now)
        (mut at) 0
        (mut root-first) 0]
    (obj-u32! 1398034241)
    ;; Version 5 adds typed indirect roots (location kind 2) for caller-owned overflow-result
    ;; areas. Version 4 introduced the high half of the dynamic-dispatch return code.
    (obj-u32! 5)
    (obj-u32! sites)
    (obj-u32! roots)
    (obj-u32! (mu-function-count))
    (obj-u32! 40)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (obj-u32! (load owner))
                  (obj-u32! (mu-function-code-start (load owner)))
                  (obj-u32! (mu-function-code-size (load owner)))
                  (obj-u32! (mu-function-frame-size (load owner)))
                  (obj-u64! (mu-function-callee-mask (load owner)))
                  (obj-u32! (mu-function-callee-count (load owner)))
                  (obj-u32! (>> (be-function-dispatch-return-code (load owner)) 32))
                  (obj-u32! (let [symbol (mu-function-symbol (load owner))]
                              (if (>= symbol 1) symbol 0)))
                  (obj-u32! (be-function-dispatch-return-code (load owner)))
                  (set! owner (+ (load owner) 1))
                  0))))
    (fmt (stderr) "AOTK_PROFILE phase=stackmap_functions ns={d} x64={d}\n"
         (- (ms-profile-now) (load phase-start))
         (if (load (mobj-x64-target)) 1 0))
    (set! phase-start (ms-profile-now))
    (let [c (mobj-roots)
          total (al-len [i64] (.site c))
          (mut cursor) 0]
      (loop (if (>= (load at) (be-inst-count))
                (break)
                (do
                  (if (ml-safepoint? (load at))
                      (let [m (be-inst (load at))
                            (mut count) 0]
                        (loop (if (or (>= (load cursor) total)
                                      (!= (al-get [i64] (.site c) (load cursor))
                                          (load at)))
                                  (break)
                                  (do
                                    (set! count (+ (load count) 1))
                                    (set! cursor (+ (load cursor) 1))
                                    0)))
                        (obj-u32! (mobj-safepoint-pc (load at)))
                        (obj-u32! (.owner m))
                        (obj-u32! (load at))
                        (obj-u32! (load root-first))
                        (set! count (+ (load count) (mobj-overflow-root-count-at (load at))))
                        (obj-u32! (load count))
                        (obj-u32! (.op m))
                        (set! root-first (+ (load root-first) (load count))))
                      0)
                  (set! at (+ (load at) 1))
                  0)))
      (fmt (stderr) "AOTK_PROFILE phase=stackmap_sites ns={d} count={d}\n"
           (- (ms-profile-now) (load phase-start)) sites)
      (set! phase-start (ms-profile-now))
      ;; Root records are contiguous per site.  Emit ordinary live vregs followed by the call's
      ;; typed result-area leaves, matching the site counts above and the linked-image writer.
      (set! at 0)
      (set! cursor 0)
      (loop (if (>= (load at) (be-inst-count)) (break)
                (do
                  (if (ml-safepoint? (load at))
                      (do
                        (loop (if (or (>= (load cursor) total)
                                      (!= (al-get [i64] (.site c) (load cursor)) (load at)))
                                  (break)
                                  (let [vr (al-get [i64] (.vreg c) (load cursor))
                                        reg (mra-reg vr)]
                                    (obj-u32! vr)
                                    (obj-u32! (ml-value-kind vr))
                                    (obj-u32! (if (>= reg 0) 0 1))
                                    (obj-u32! (if (>= reg 0) reg (be-spill-off-vreg vr)))
                                    (set! cursor (+ (load cursor) 1)))))
                        (let [m (be-inst (load at))]
                          (if (and (= (.op m) MI-CALL) (>= (.node m) 0))
                              (let [owner (.owner m)
                                    pointer-off (mu-function-outgoing-result-pointer-offset owner)
                                    results (be-call-result-count (.node m))
                                    (mut slot) 0]
                                (loop (if (>= (load slot) results) (break)
                                          (let [offset (be-call-result-area-offset
                                                         (.node m) (load slot))
                                                kind (be-call-result-kind-at
                                                       (.node m) (load slot))]
                                            (if (and (>= offset 0)
                                                     (or (= kind MLK-RAW-MANAGED)
                                                         (= kind MLK-BOXED)))
                                                (do
                                                  (if (or (< pointer-off 0)
                                                          (> pointer-off 65535)
                                                          (> offset 65535))
                                                      (panic-corrupt
                                                        "overflow result root is outside stackmap range")
                                                      0)
                                                  (obj-u32! -1)
                                                  (obj-u32! kind)
                                                  (obj-u32! 2)
                                                  (obj-u32! (| (<< pointer-off 16) offset)))
                                                0)
                                            (set! slot (+ (load slot) 1))))))
                              0)))
                      0)
                  (set! at (+ (load at) 1)))))
      )
    (fmt (stderr) "AOTK_PROFILE phase=stackmap_roots ns={d} count={d}\n"
         (- (ms-profile-now) (load phase-start)) roots)
    0))

(defn mobj-shape-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (ty-only-obj? (shape-field-ty shape (load field)))
                    (set! bits (| (load bits) (<< 1 (load field))))
                    0)
                (set! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-shape-boxed-bitmap [(shape i64)] (-> i64)
  (let [(mut field) 0
        (mut bits) 0]
    (loop (if (>= (load field) (shape-field-count shape))
              (break)
              (do
                (if (= (ml-kind-for-type (shape-field-ty shape (load field))) MLK-BOXED)
                    (set! bits (| (load bits) (<< 1 (load field))))
                    0)
                (set! field (+ (load field) 1))
                0)))
    (load bits)))

(defn mobj-write-layouts! [] (-> i64)
  (obj-u32! 1280593729)
  (obj-u32! 1)
  (obj-u32! (shape-count))
  (obj-u32! 32)
  (let [(mut shape) 0]
    (loop (if (>= (load shape) (shape-count))
              (break)
              (do
                (obj-u32! (load shape))
                (obj-u32! (shape-size (load shape)))
                (obj-u32! 8)
                (obj-u32! (shape-field-count (load shape)))
                (obj-u64! (mobj-shape-bitmap (load shape)))
                (obj-u64! (mobj-shape-boxed-bitmap (load shape)))
                (set! shape (+ (load shape) 1))
                0)))
    0))

(defn mobj-fail! [(code i64) (item i64)] (-> bool)
  (let [p (backend)]
    (set! (.object-result p) code)
    (set! (.object-item p) item)
    false))

; Validate the phase-owned object model before a byte is published. The serialized-byte parser
; below repeats the bounds checks after publication; neither verifier trusts the other.
(defn mobj-verify-model! [] (-> bool)
  (let [p (backend)
        funcs (mu-function-count)
        textlen (be-code-len)
        (mut owner) 0
        (mut ok) true]
    (set! (.object-result p) MOBJ-OK)
    (set! (.object-item p) -1)
    (if (<= textlen 0)
        (do (set! ok false) (mobj-fail! MOBJ-HEADER -1))
        false)
    (loop (if (or (>= (load owner) funcs) (not (load ok)))
              (break)
              (do
                (let [start (mu-function-code-start (load owner))
                      size (mu-function-code-size (load owner))]
                  (if (or (< start 0) (or (<= size 0) (> (+ start size) textlen)))
                      (do
                        (set! ok false)
                        (mobj-fail! MOBJ-FUNCTION-RANGE (load owner)))
                      false))
                (set! owner (+ (load owner) 1))
                0)))
    (if (load ok)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (not (load ok)))
                    (break)
                    (do
                      (if (= (ms-inst-op (load at)) MI-CALL)
                          (let [target (.imm (be-inst (load at)))]
                            (if (if (< target 0)
                                    (not (ms-call-target-valid? (load at)))
                                    (>= target funcs))
                                (do
                                  (set! ok false)
                                  (mobj-fail! MOBJ-RELOCATION (load at)))
                                false))
                          false)
                      (set! at (+ (load at) 1))
                      0)))
          0)
        0)
    (load ok)))

(defn mobj-corrupt-call-target! [(at i64) (target i64)] (-> i64)
  (set! (.imm (be-inst at)) target)
  0)

(defn mobj-corrupt-function-range! [(owner i64) (start i64) (size i64)] (-> i64)
  (set! (.code-start (mu-function owner)) start)
  (set! (.code-size (mu-function owner)) size)
  0)

(defn mobj-byte [(at i64)] (-> i64)
  (cast i64 (al-get (.obj (backend)) at)))
(defn mobj-u32 [(at i64)] (-> i64)
  (| (mobj-byte at)
     (| (<< (mobj-byte (+ at 1)) 8)
        (| (<< (mobj-byte (+ at 2)) 16) (<< (mobj-byte (+ at 3)) 24)))))
(defn mobj-u64 [(at i64)] (-> i64)
  (| (mobj-u32 at) (<< (mobj-u32 (+ at 4)) 32)))

; Repository-local structural parser for the exact object schema emitted below. It validates raw
; bytes and cross-checks them against phase-owned function ranges.
(defn mobj-verify-bytes! [] (-> bool)
  (let [p (backend)
        len (al-len [u8] (.obj p))
        funcs (mu-function-count)
        basesyms (if (> funcs 0) funcs 1)
        nreloc (mobj-external-reloc-count)
        externs (mobj-external-symbol-count)
        nsyms (+ basesyms externs)
        (mut ok) true]
    (set! (.object-result p) MOBJ-OK)
    (set! (.object-item p) -1)
    (if (< len 472)
        (do (set! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (and (load ok)
             (or (!= (mobj-u32 0) 4277009103)
                 (or (!= (mobj-u32 16) 4) (!= (mobj-u32 20) 440))))
        (do (set! ok false) (mobj-fail! MOBJ-HEADER 0))
        false)
    (if (load ok)
        (let [textlen (mobj-u64 144)
              textoff (mobj-u32 152)
              relocoff (mobj-u32 160)
              actual-nreloc (mobj-u32 164)
              stackaddr (mobj-u64 216)
              stacklen (mobj-u64 224)
              stackoff (mobj-u32 232)
              layoutaddr (mobj-u64 296)
              layoutlen (mobj-u64 304)
              layoutoff (mobj-u32 312)
              symoff (mobj-u32 352)
              actual-nsyms (mobj-u32 356)
              stroff (mobj-u32 360)
              strsize (mobj-u32 364)]
          (if (or (!= textoff 472)
                  (or (> (+ textoff textlen) len)
                      (or (> (+ stackoff stacklen) len)
                          (or (!= stackaddr (align8 textlen))
