;; CFG liveness, register classes, value kinds, and safepoint root discovery.
(module backend_liveness)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

; ---------------------------------------------------------------------------
; G6 CFG liveness over the final scheduled machine code.
; ---------------------------------------------------------------------------

(defn ml-vreg-count [] (-> i64)
  (.next-vreg (machine-unit)))
;; ml-index/ml-edge-index survive as the DIAGNOSTIC item encoding (liveness-item) only. The
;; sets themselves are bitsets — 64 vregs per word — so the fixed-point solver and the whole-set
;; verifiers move word-wise instead of one (block, vreg) cell at a time.
(defn ml-index [(bid i64) (vreg i64)] (-> i64)
  (+ (* bid (ml-vreg-count)) vreg))
(defn ml-edge-index [(edge i64) (vreg i64)] (-> i64)
  (+ (* edge (ml-vreg-count)) vreg))
(defn ml-live-words [] (-> i64)
  (/ (+ (ml-vreg-count) 63) 64))
(defn ml-owner-words [(owner i64)] (-> i64)
  (al-get (.live-owner-words (machine-unit)) owner))
(defn ml-block-words [(bid i64)] (-> i64)
  (ml-owner-words (mu-block-owner bid)))
;; The size of ONE liveness bit matrix, in 64-bit words: the sum over blocks of the owning
;; function's vreg words. `live-use`, `live-def`, `live-in` and `live-out` each hold this many
;; words, and `edge-live` holds the same sum taken over edges. This is the exact number that
;; decides both the memory and the walk cost of every dense-set phase, so it is a compile budget
;; a gate can assert on: it is deterministic, where wall time and RSS are not.
(defn ml-liveness-block-words [] (-> i64)
  (let [blocks (mu-block-count)]
    (if (<= blocks 0) 0
        (+ (al-get (.live-block-first (machine-unit)) (- blocks 1))
           (ml-block-words (- blocks 1))))))
(defn ml-liveness-edge-words [] (-> i64)
  (let [edges (mu-edge-count)]
    (if (<= edges 0) 0
        (+ (al-get (.live-edge-first (machine-unit)) (- edges 1))
           (ml-block-words (mu-edge-source (- edges 1)))))))
(defn ml-liveness-words [] (-> i64)
  (+ (* 4 (ml-liveness-block-words)) (ml-liveness-edge-words)))
(defn ml-vreg-owner [(vreg i64)] (-> i64)
  (if (or (< vreg 0) (>= vreg (al-len [i64] (.vreg-owner (machine-unit)))))
      -1
      (al-get (.vreg-owner (machine-unit)) vreg)))
(defn ml-vreg-local [(vreg i64)] (-> i64)
  (if (or (< vreg 0) (>= vreg (al-len [i64] (.live-vreg-local (machine-unit)))))
      -1
      (al-get (.live-vreg-local (machine-unit)) vreg)))
(defn ml-owner-vreg [(owner i64) (local i64)] (-> i64)
  (al-get (.live-owner-vregs (machine-unit))
          (+ (al-get (.live-owner-first (machine-unit)) owner) local)))
(defn ml-word-index [(bid i64) (vreg i64)] (-> i64)
  (+ (al-get (.live-block-first (machine-unit)) bid) (/ (ml-vreg-local vreg) 64)))
(defn ml-edge-word-index [(edge i64) (vreg i64)] (-> i64)
  (+ (al-get (.live-edge-first (machine-unit)) edge) (/ (ml-vreg-local vreg) 64)))
(defn ml-bit [(vreg i64)] (-> i64)
  (<< 1 (& vreg 63)))
(defn ml-local-bit [(vreg i64)] (-> i64)
  (<< 1 (& (ml-vreg-local vreg) 63)))
(defn ml-use? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (!= (& (al-get (.live-use (machine-unit)) (ml-word-index bid vreg))
              (ml-local-bit vreg)) 0)))
(defn ml-def? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (!= (& (al-get (.live-def (machine-unit)) (ml-word-index bid vreg))
              (ml-local-bit vreg)) 0)))
(defn ml-live-in? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (!= (& (al-get (.live-in (machine-unit)) (ml-word-index bid vreg))
              (ml-local-bit vreg)) 0)))
(defn ml-live-out? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (!= (& (al-get (.live-out (machine-unit)) (ml-word-index bid vreg))
              (ml-local-bit vreg)) 0)))
(defn ml-edge-live? [(edge i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner (mu-edge-source edge)))
       (!= (& (al-get (.edge-live (machine-unit)) (ml-edge-word-index edge vreg))
              (ml-local-bit vreg)) 0)))
(defn ml-value-kind [(vreg i64)] (-> i64)
  (al-get (.value-kind (machine-unit)) vreg))
(defn ml-register-class [(vreg i64)] (-> i64)
  (al-get (.register-class (machine-unit)) vreg))
(defn ml-result [] (-> i64)
  (.liveness-result (machine-unit)))
(defn ml-result-item [] (-> i64)
  (.liveness-item (machine-unit)))
(defn ml-rounds [] (-> i64)
  (.liveness-rounds (machine-unit)))

(defn ml-vreg-class-is? [(vreg i64) (class i64)] (-> bool)
  (or (< vreg 0) (= (ml-register-class vreg) class)))

(defn ml-inst-classes-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        dst (.dst m)
        a (.a m)
        b (.b m)]
    (case op MI-SCVTF
          (and (ml-vreg-class-is? a MRC-GPR) (ml-vreg-class-is? dst MRC-FPR)) MI-I32FROMFP
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FADD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FSUB
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMUL
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FDIV
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMOD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FNEG
          (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? dst MRC-FPR)) MI-FEQ
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLT
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLE
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FTRUTH
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-MOD
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITAND
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITXOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHL
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-USHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITNOT
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-JSUNBOX
          ;; A tagged JavaScript word is always read out of a GPR. Where the payload lands depends
          ;; on the tag: unboxing to a NUMBER produces a double in an FPR, every other tag produces
          ;; a machine word in a GPR.
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst (if (= (load (field m imm)) 0) MRC-FPR MRC-GPR)))
            MI-COPY
          (= (ml-register-class dst) (ml-register-class a)) MI-RESULT-MATERIALIZE
          (= (ml-register-class dst) (ml-register-class a)) MI-ABI-COPY
          (= (ml-register-class dst) (ml-register-class a)) true)))

(defn ml-inst-uses? [(at i64) (vreg i64)] (-> bool)
  (ms-inst-uses-vreg? at vreg))

(defstruct MlVerifyScratch
  [(expected-use (ArrayList i64))
   (expected-def (ArrayList i64))
   (expected-edge (ArrayList i64))
   (inited bool)])
(defn ml-verify-scratch [] (-> (ptr MlVerifyScratch))
  (let [s (primitive/alloc-static MlVerifyScratch)]
    (if (.inited s)
        0
        (do
          (set! (.expected-use s) (al-new [i64] (malloc-allocator)))
          (set! (.expected-def s) (al-new [i64] (malloc-allocator)))
          (set! (.expected-edge s) (al-new [i64] (malloc-allocator)))
          (set! (.inited s) true)
          0))
    s))

(defn ml-verify-note-use! [(vreg i64)] (-> i64)
  (let [s (ml-verify-scratch)
        local (ml-vreg-local vreg)
        word (/ local 64)
        bit (ml-local-bit vreg)]
    (if (and (>= vreg 0) (< word (al-len [i64] (.expected-use s))))
        (if (!= (& (al-get [i64] (.expected-def s) word) bit) 0)
            0
            (do (al-set! [i64] (field s expected-use) word
                         (| (al-get [i64] (.expected-use s) word) bit)) 0))
        0)))

;; One instruction's contribution to the block's expected use/def sets: a use counts only when
;; the block has not yet defined that vreg, exactly as the per-vreg forward walk counted it.
(defn ml-verify-note-inst! [(at i64)] (-> i64)
  (let [s (ml-verify-scratch)
        m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)
        dst (.dst m)]
    (if (> inputs 0) (ml-verify-note-use! (.a m)) 0)
    (if (> inputs 1) (ml-verify-note-use! (.b m)) 0)
    (if (= op MI-CSEL) (ml-verify-note-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (ml-verify-note-use! (al-get (.call-args (machine-unit))
                                               (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    (if (and (>= dst 0)
             (< (/ (ml-vreg-local dst) 64) (al-len [i64] (.expected-def s))))
        (let [word (/ (ml-vreg-local dst) 64)]
          (al-set! [i64] (field s expected-def) word
                   (| (al-get [i64] (.expected-def s) word) (ml-local-bit dst))))
        0)))

;; Mark one operand of one instruction upward-exposed in its block, unless the block already
;; defined it. Enumerating an instruction's few operands replaces the old per-instruction sweep
;; over EVERY vreg asking ms-inst-uses-vreg?, which was quadratic in program size.
(defn ml-note-use! [(bid i64) (vreg i64)] (-> i64)
  (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
      (if (ml-def? bid vreg)
          0
          (let [u (machine-unit)
                idx (ml-word-index bid vreg)]
            (al-set! [i64] (field u live-use) idx
                     (| (al-get (.live-use u) idx) (ml-local-bit vreg)))))
      0))

(defn ml-build-local-layout! [] (-> i64)
  (let [u (machine-unit)
        funcs (mu-function-count)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut i) 0
        (mut cursor) 0]
    (al-clear! [i64] (field u live-vreg-owner))
    (al-clear! [i64] (field u live-vreg-local))
    (al-clear! [i64] (field u live-owner-first))
    (al-clear! [i64] (field u live-owner-count))
    (al-clear! [i64] (field u live-owner-words))
    (al-clear! [i64] (field u live-owner-vregs))
    (al-clear! [i64] (field u live-block-first))
    (al-clear! [i64] (field u live-edge-first))
    (loop (if (>= (load i) funcs) (break)
              (do (al-push! [i64] (field u live-owner-count) 0)
                  (al-push! [i64] (field u live-owner-first) 0)
                  (al-push! [i64] (field u live-owner-words) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (do (al-push! [i64] (field u live-vreg-owner) -1)
                  (al-push! [i64] (field u live-vreg-local) -1)
                  (al-push! [i64] (field u live-owner-vregs) -1)
                  (set! i (+ (load i) 1)))))
    ;; Selection's completed MachineValue rows are the authoritative ownership boundary.
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (do
                (let [dst (load i) owner (al-get (.vreg-owner u) (load i))]
                  (if (>= owner 0)
                      (do
                        (al-set! [i64] (field u live-vreg-owner) dst owner)
                        (al-set! [i64] (field u live-owner-count) owner
                                 (+ (al-get (.live-owner-count u) owner) 1)))
                      0))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) funcs) (break)
              (do
                (let [count (al-get (.live-owner-count u) (load i))]
                  (al-set! [i64] (field u live-owner-first) (load i) (load cursor))
                  (al-set! [i64] (field u live-owner-words) (load i) (/ (+ count 63) 64))
                  (set! cursor (+ (load cursor) count)))
                (set! i (+ (load i) 1)))))
    ;; Reuse owner-count as fill cursors, then restore its final counts from owner boundaries.
    (set! i 0)
    (loop (if (>= (load i) funcs) (break)
              (do (al-set! [i64] (field u live-owner-count) (load i) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (let [owner (al-get (.live-vreg-owner u) (load i))]
                (if (>= owner 0)
                    (let [local (al-get (.live-owner-count u) owner)]
                      (al-set! [i64] (field u live-vreg-local) (load i) local)
                      (al-set! [i64] (field u live-owner-vregs)
                               (+ (al-get (.live-owner-first u) owner) local) (load i))
                      (al-set! [i64] (field u live-owner-count) owner (+ local 1)))
                    0)
                (set! i (+ (load i) 1)))))
    (set! cursor 0)
    (set! i 0)
    (loop (if (>= (load i) blocks) (break)
              (do
                (al-push! [i64] (field u live-block-first) (load cursor))
                (set! cursor (+ (load cursor) (ml-block-words (load i))))
                (set! i (+ (load i) 1)))))
    (set! cursor 0)
    (set! i 0)
    (loop (if (>= (load i) edges) (break)
              (do
                (al-push! [i64] (field u live-edge-first) (load cursor))
                (set! cursor (+ (load cursor) (ml-block-words (mu-edge-source (load i)))))
                (set! i (+ (load i) 1)))))
    0))

(defn ml-init-tables! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut i) 0]
    (ml-build-local-layout!)
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (loop (if (>= (load i)
                   (if (> blocks 0)
                       (+ (al-get (.live-block-first u) (- blocks 1))
                          (ml-block-words (- blocks 1)))
                       0))
              (break)
              (do
                (al-push! [i64] (field u live-use) 0)
                (al-push! [i64] (field u live-def) 0)
                (al-push! [i64] (field u live-in) 0)
                (al-push! [i64] (field u live-out) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i)
                   (if (> edges 0)
                       (+ (al-get (.live-edge-first u) (- edges 1))
                          (ml-block-words (mu-edge-source (- edges 1))))
                       0))
              (break)
              (do
                (al-push! [i64] (field u edge-live) 0)
                (set! i (+ (load i) 1))
                0)))
    0))

(defn ml-compute-use-def! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0
        (mut phase-start) (ms-profile-now)]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) 0]
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (.dst m)
                                    desc (mi-desc (.op m))
                                    inputs (mi-desc-inputs desc)]
                                ; The same operand positions ms-inst-uses-vreg? tests, walked
                                ; directly: a, b, a CSEL's imm, and the argument list.
                                (if (> inputs 0) (ml-note-use! (load bid) (.a m)) 0)
                                (if (> inputs 1) (ml-note-use! (load bid) (.b m)) 0)
                                (if (= (.op m) MI-CSEL)
                                    (ml-note-use! (load bid) (.imm m))
                                    0)
                                (let [args (ms-inst-arg-count at)
                                      (mut arg) 0]
                                  (loop (if (>= (load arg) args)
                                            (break)
                                            (do
                                              (ml-note-use! (load bid) (ms-inst-arg at (load arg)))
                                              (set! arg (+ (load arg) 1))
                                              0))))
                                (if (>= dst 0)
                                    (let [idx (ml-word-index (load bid) dst)]
                                      (al-set! [i64] (field u live-def) idx
                                               (| (al-get (.live-def u) idx)
                                                  (ml-local-bit dst))))
                                    0))
                              (set! i (+ (load i) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    (set! phase-start (ms-profile-note! "liveness_use_sets" (load phase-start)))
    (ms-profile-note! "liveness_value_metadata_reads" (load phase-start))
    0))

;; Phi resolution can place a synthetic copy before the instruction that defines its source.
;; Seed all explicit definitions first, then propagate classes through copies to a fixed point so
;; class publication is independent of scheduled instruction order.
(defn ml-solve! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        live-in (.live-in u)
        live-use (.live-use u)
        live-def (.live-def u)
        live-out (.live-out u)
        (mut pending) (al-new [i64] (malloc-allocator))
        (mut queued) (al-new [i64] (malloc-allocator))
        (mut processed) 0
        (mut pos) 0]
    (loop (if (>= (load pos) blocks)
              (break)
              (do
                (al-push! [i64] (mut queued) 1)
                (al-push! [i64] (mut pending)
                          (if (= (& seed 1) 0) (load pos) (- blocks (+ (load pos) 1))))
                (set! pos (+ (load pos) 1)))))
    (loop (if (= (al-len [i64] (load pending)) 0)
              (break)
              (let [last (- (al-len [i64] (load pending)) 1)
                    bid (al-get [i64] (load pending) last)
                    words (ml-block-words bid)
                    succs (mu-block-succ-count bid)
                    base (al-get (.live-block-first u) bid)
                    (mut in-changed) false
                    (mut w) 0]
                (al-pop! [i64] (mut pending))
                (al-set! [i64] (mut queued) bid 0)
                (loop (if (>= (load w) words)
                            (break)
                            (do
                              (let [(mut s) 0
                                    (mut out) 0]
                                (loop (if (>= (load s) succs)
                                          (break)
                                          (do
                                            (set! out
                                                  (| (load out)
                                                     (al-get live-in
                                                             (+ (al-get (.live-block-first u)
                                                                        (mu-block-succ-target bid (load s)))
                                                                (load w)))))
                                            (set! s (+ (load s) 1)))))
                                (let [idx (+ base (load w))
                                      in (| (al-get live-use idx)
                                            (& (load out) (^ (al-get live-def idx) -1)))]
                                  (if (!= (al-get live-out idx) (load out))
                                      (al-set! [i64] (field u live-out) idx (load out))
                                      0)
                                  (if (!= (al-get live-in idx) in)
                                      (do
                                        (al-set! [i64] (field u live-in) idx in)
                                        (set! in-changed true))
                                      0)))
                              (set! w (+ (load w) 1)))))
                (if (load in-changed)
                    (let [(mut p) 0]
                      (loop (if (>= (load p) (mu-block-pred-count bid))
                                (break)
                                (let [pred (mu-block-pred-source bid (load p))]
                                  (if (= (al-get [i64] (load queued) pred) 0)
                                      (do
                                        (al-set! [i64] (mut queued) pred 1)
                                        (al-push! [i64] (mut pending) pred))
                                      0)
                                  (set! p (+ (load p) 1))))))
                    0)
                (set! processed (+ (load processed) 1)))))
    (set! (.liveness-rounds u) (load processed))
    (al-free! [i64] (mut pending))
    (al-free! [i64] (mut queued))
    true))

(defn ml-compute-edge-live! [] (-> i64)
  (let [u (machine-unit)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        live-in (.live-in u)
        (mut edge) 0]
    (loop (if (>= (load edge) edges)
              (break)
              (do
                (let [target (mu-edge-target (load edge))
                      words (ml-block-words target)
                      target-base (al-get (.live-block-first u) target)
                      base (al-get (.live-edge-first u) (load edge))
                      copies (mu-edge-copy-count (load edge))
                      (mut w) 0
                      (mut i) 0]
                  (loop (if (>= (load w) words)
                            (break)
                            (do
                              (al-set! [i64] (field u edge-live) (+ base (load w))
                                       (al-get live-in (+ target-base (load w))))
                              (set! w (+ (load w) 1))
                              0)))
                  ; A copy's destination is born on the edge (cleared), its source is consumed
                  ; there (set); a vreg that is both stays live, so every clear happens before
                  ; any set — the same precedence the per-vreg version had.
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [dst (mu-copy-dst (load edge) (load i))]
                                    (if (and (>= dst 0) (< dst vregs))
                                        (let [idx (+ base (/ (ml-vreg-local dst) 64))]
                                          (al-set! [i64] (field u edge-live) idx
                                                   (& (al-get (.edge-live u) idx)
                                                      (^ (ml-local-bit dst) -1)))
                                          0)
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0)))
                  (set! i 0)
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [src (mu-copy-src (load edge) (load i))]
                                    (if (and (>= src 0) (< src vregs))
                                        (let [idx (+ base (/ (ml-vreg-local src) 64))]
                                          (al-set! [i64] (field u edge-live) idx
                                                   (| (al-get (.edge-live u) idx)
                                                      (ml-local-bit src)))
                                          0)
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0))))
                (set! edge (+ (load edge) 1))
                0)))
    0))

(defn ml-live-before? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))
                      dst (ms-inst-dst (+ first (load i)))]
                  (if (= dst vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0))
                (if (= (+ first (load i)) at) (break) 0))))
    (load live)))

(defn ml-live-after? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))]
                  (if (= current at) (break) 0)
                  (if (= (ms-inst-dst current) vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0)))))
    (load live)))

(defn ml-safepoint? [(at i64)] (-> bool)
  (let [op (ms-inst-op at)] (or (= op MI-CALL) (= op MI-NEW))))

(defn ml-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        s (ml-verify-scratch)
        (mut bid) 0
        (mut max-words) 0]
    (set! (.liveness-result u) MLIVE-OK)
    (set! (.liveness-item u) -1)
    ;; One fixed scratch shape serves every block and edge. Repeated clear/push cycles across
    ;; 75,000 blocks paid ArrayList append checks for every represented word.
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [words (ml-block-words (load bid))]
                  (if (> words (load max-words)) (set! max-words words) 0))
                (set! bid (+ (load bid) 1)))))
    (al-clear! [i64] (field s expected-use))
    (al-clear! [i64] (field s expected-def))
    (al-clear! [i64] (field s expected-edge))
    (let [(mut word) 0]
      (loop (if (>= (load word) (load max-words))
                (break)
                (do
                  (al-push! [i64] (field s expected-use) 0)
                  (al-push! [i64] (field s expected-def) 0)
                  (al-push! [i64] (field s expected-edge) 0)
                  (set! word (+ (load word) 1))))))
    (set! bid 0)
    ; Re-derive use/def and the fixed-point equations without mutating the published sets.
    ; One forward operand walk per block fills the per-vreg expectations; asking every vreg
    ; about every instruction made this verifier cubic on large programs.
    (loop (if (or (>= (load bid) blocks) (!= (ml-result) MLIVE-OK))
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      owner (mu-block-owner (load bid))
                      words (ml-block-words (load bid))
                      base (al-get (.live-block-first u) (load bid))
                      (mut vr) 0
                      (mut i) 0]
                  (loop (if (>= (load vr) words)
                            (break)
                            (do
                              (al-set! [i64] (field s expected-use) (load vr) 0)
                              (al-set! [i64] (field s expected-def) (load vr) 0)
                              (set! vr (+ (load vr) 1))
                              0)))
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (ml-verify-note-inst! (+ first (load i)))
                              (set! i (+ (load i) 1))
                              0)))
                  (set! vr 0)
                  (loop (if (or (>= (load vr) words) (!= (ml-result) MLIVE-OK))
                            (break)
                            (do
                              (let [expected-use (al-get [i64] (.expected-use s) (load vr))
                                    expected-def (al-get [i64] (.expected-def s) (load vr))
                                    (mut expected-out) 0
                                    (mut k) 0]
                                (loop (if (>= (load k) (mu-block-succ-count (load bid)))
                                          (break)
                                          (do
                                            (set! expected-out
                                                  (| (load expected-out)
                                                     (al-get [i64] (.live-in u)
                                                       (+ (al-get (.live-block-first u)
                                                                  (mu-block-succ-target
                                                                    (load bid) (load k)))
                                                          (load vr)))))
                                            (set! k (+ (load k) 1))
                                            0)))
                                (let [idx (+ base (load vr))
                                      expected-in (| expected-use
                                                     (& (load expected-out) (^ expected-def -1)))]
                                  (if (or (!= (al-get [i64] (.live-use u) idx) expected-use)
                                          (or (!= (al-get [i64] (.live-def u) idx) expected-def)
                                              (or (!= (al-get [i64] (.live-out u) idx) (load expected-out))
                                                  (!= (al-get [i64] (.live-in u) idx) expected-in))))
                                      (do
                                        (set! (.liveness-result u) MLIVE-FIXPOINT)
                                        (set! (.liveness-item u)
                                              (ml-index (load bid)
                                                        (ml-owner-vreg owner (* (load vr) 64)))))
                                      0)))
                              (set! vr (+ (load vr) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    (if (= (ml-result) MLIVE-OK)
        (let [(mut edge) 0]
          (loop (if (or (>= (load edge) edges) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [target (mu-edge-target (load edge))
                            owner (mu-block-owner target)
                            words (ml-block-words target)
                            target-base (al-get (.live-block-first u) target)
                            base (al-get (.live-edge-first u) (load edge))
                            copies (mu-edge-copy-count (load edge))
                            (mut word) 0
                            (mut copy) 0]
                        (loop (if (>= (load word) words)
                                  (break)
                                  (do
                                    (al-set! [i64] (field s expected-edge) (load word)
                                             (al-get [i64] (.live-in u)
                                                     (+ target-base (load word))))
                                    (set! word (+ (load word) 1)))))
                        ;; Apply each copy once to the independent expected row. The old verifier
                        ;; reapplied every copy for every word: edge_words * edge_copies.
                        (loop (if (>= (load copy) copies)
                                  (break)
                                  (do
                                    (if (= (mu-copy-kind (load edge) (load copy)) MCOPY-VALUE)
                                        (let [dst (mu-copy-dst (load edge) (load copy))
                                              dst-word (/ (ml-vreg-local dst) 64)]
                                          (al-set! [i64] (field s expected-edge) dst-word
                                                   (& (al-get (.expected-edge s) dst-word)
                                                      (^ (ml-local-bit dst) -1))))
                                        0)
                                    (set! copy (+ (load copy) 1)))))
                        (set! copy 0)
                        (loop (if (>= (load copy) copies)
                                  (break)
                                  (do
                                    (if (= (mu-copy-kind (load edge) (load copy)) MCOPY-VALUE)
                                        (let [src (mu-copy-src (load edge) (load copy))
                                              src-word (/ (ml-vreg-local src) 64)]
                                          (al-set! [i64] (field s expected-edge) src-word
                                                   (| (al-get (.expected-edge s) src-word)
                                                      (ml-local-bit src))))
                                        0)
                                    (set! copy (+ (load copy) 1)))))
                        (set! word 0)
                        (loop (if (or (>= (load word) words)
                                      (!= (ml-result) MLIVE-OK))
                                  (break)
                                  (do
                                    (if (!= (al-get [i64] (.edge-live u)
                                                   (+ base (load word)))
                                            (al-get [i64] (.expected-edge s) (load word)))
                                        (do
                                          (set! (.liveness-result u) MLIVE-PHI)
                                          (set! (.liveness-item u)
                                                (ml-edge-index
                                                  (load edge)
                                                  (ml-owner-vreg owner (* (load word) 64)))))
                                        0)
                                    (set! word (+ (load word) 1))))))
                      (set! edge (+ (load edge) 1))))))
        0)
    (if (= (ml-result) MLIVE-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [dst (ms-inst-dst (load at))]
                        (if (not (ms-inst-result-kind-contract-valid? (load at)))
                            (do
                              (set! (.liveness-result u) MLIVE-KIND)
                              (set! (.liveness-item u) (if (>= dst 0) dst (load at))))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ms-inst-result-class-contract-valid? (load at))))
                            (do
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) (if (>= dst 0) dst (load at))))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ml-inst-classes-valid? (load at))))
                            (do
                              (fmt (stderr)
                                   "liveness-class-operands inst={d} op={d} dst={d} a={d} b={d}\n"
                                   (load at) (.op (be-inst (load at))) dst
                                   (.a (be-inst (load at))) (.b (be-inst (load at))))
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) (load at)))
                            0))
                      (set! at (+ (load at) 1))
                      0))))
        0)
    (= (ml-result) MLIVE-OK)))

(defn ml-compute! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        (mut phase-start) (ms-profile-now)]
    (set! (.liveness-seed u) seed)
    (ml-init-tables!)
    (set! phase-start (ms-profile-note! "liveness_init" (load phase-start)))
    (ml-compute-use-def!)
    (set! phase-start (ms-profile-note! "liveness_use_def" (load phase-start)))
    (if (not (ml-solve! seed))
        (do
          (set! phase-start (ms-profile-note! "liveness_solve" (load phase-start)))
          (set! (.liveness-result u) MLIVE-FIXPOINT)
          (set! (.liveness-item u) -1)
          false)
        (do
          (set! phase-start (ms-profile-note! "liveness_solve" (load phase-start)))
          (ml-compute-edge-live!)
          (set! phase-start (ms-profile-note! "liveness_edges" (load phase-start)))
          (let [ok (if (be-verification?) (ml-verify!) true)]
            (ms-profile-note! "liveness_verify" (load phase-start))
            ok)))))

(defn ml-corrupt-live-out! [(bid i64) (vreg i64) (live bool)] (-> i64)
  (let [u (machine-unit)
        idx (ml-word-index bid vreg)
        word (al-get (.live-out u) idx)]
    (al-set! [i64] (field u live-out) idx
             (if live
                 (| word (ml-local-bit vreg))
                 (& word (^ (ml-local-bit vreg) -1)))))
  0)
(defn ml-corrupt-edge-live! [(edge i64) (vreg i64) (live bool)] (-> i64)
  (let [u (machine-unit)
        idx (ml-edge-word-index edge vreg)
        word (al-get (.edge-live u) idx)]
    (al-set! [i64] (field u edge-live) idx
             (if live
                 (| word (ml-local-bit vreg))
                 (& word (^ (ml-local-bit vreg) -1)))))
  0)
(defn ml-corrupt-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) value-kind) vreg kind)
  0)
(defn ml-corrupt-register-class! [(vreg i64) (class i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) register-class) vreg class)
  0)

(defn ml-dump-set [(w (ptr Writer)) (kind i64) (id i64)] (-> i64)
  (let [vregs (ml-vreg-count)
        (mut vr) 0
        (mut first) true]
    (ps w "{")
    (loop (if (>= (load vr) vregs)
              (break)
              (do
                (let [live
                        (case kind 0
                              (ml-use? id (load vr)) 1
                              (ml-def? id (load vr)) 2
                              (ml-live-in? id (load vr)) 3
                              (ml-live-out? id (load vr)) (ml-edge-live? id (load vr)))]
                  (if live
                      (do
                        (if (load first) 0 (ps w ","))
                        (fmt w "v{d}" (load vr))
                        (set! first false))
                      0))
                (set! vr (+ (load vr) 1))
                0)))
    (ps w "}")
    0))

(defn ml-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [blocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) blocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))]
                                (fmt w "  b{d} use" (load rpo))
                                (ml-dump-set w 0 bid)
                                (ps w " def")
                                (ml-dump-set w 1 bid)
                                (ps w " in")
                                (ml-dump-set w 2 bid)
                                (ps w " out")
                                (ml-dump-set w 3 bid)
                                (ps w "\n"))
                              (set! rpo (+ (load rpo) 1))
                              0))))
                (set! owner (+ (load owner) 1))
                0)))
    (let [edges (mu-edge-count)
          (mut edge) 0]
      (loop (if (>= (load edge) edges)
                (break)
                (do
                  (fmt w
                       "edge {d} {d}->{d} live"
                       (load edge)
                       (mu-edge-source (load edge))
                       (mu-edge-target (load edge)))
                  (ml-dump-set w 4 (load edge))
                  (ps w "\n")
                  (set! edge (+ (load edge) 1))
                  0))))
    0))

(defn ml-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ml-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "ml-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))
