;; CFG liveness, register classes, value kinds, and safepoint root discovery.
(module backend_liveness)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

; ---------------------------------------------------------------------------
; G6 CFG liveness over the final scheduled machine code.
; ---------------------------------------------------------------------------

(defn ml-vreg-count [] (-> i64)
  (.next-vreg (machine-unit)))
;; ml-index/ml-edge-index survive as the DIAGNOSTIC item encoding (liveness-item) only. The
;; sets themselves are bitsets — 64 vregs per word — so the fixed-point solver and the whole-set
;; verifiers move word-wise instead of one (block, vreg) cell at a time.
(defn ml-index [(bid i64) (vreg i64)] (-> i64)
  (+ (* bid (ml-vreg-count)) vreg))
(defn ml-edge-index [(edge i64) (vreg i64)] (-> i64)
  (+ (* edge (ml-vreg-count)) vreg))
(defn ml-live-words [] (-> i64)
  (/ (+ (ml-vreg-count) 63) 64))
(defn ml-owner-words [(owner i64)] (-> i64)
  (al-get (.live-owner-words (machine-unit)) owner))
(defn ml-block-words [(bid i64)] (-> i64)
  (ml-owner-words (mu-block-owner bid)))

; ---------------------------------------------------------------------------
; Sparse live sets. See MachineUnit's live-set-head for why they are not a matrix.
; ---------------------------------------------------------------------------

(const ML-SET-USE i64 0)
(const ML-SET-DEF i64 1)
(const ML-SET-IN  i64 2)
(const ML-SET-OUT i64 3)

(defn ml-block-set [(kind i64) (bid i64)] (-> i64) (+ (* kind (mu-block-count)) bid))
(defn ml-edge-set [(edge i64)] (-> i64) (+ (* 4 (mu-block-count)) edge))

(defn ml-set-count [] (-> i64) (al-len [i64] (.live-set-head (machine-unit))))
(defn ml-chunk-count [] (-> i64) (al-len [i64] (.live-chunk-word (machine-unit))))
(defn ml-set-first [(set i64)] (-> i64)
  (if (or (< set 0) (>= set (ml-set-count))) -1
      (al-get [i64] (.live-set-head (machine-unit)) set)))
(defn ml-chunk-word [(c i64)] (-> i64) (al-get [i64] (.live-chunk-word (machine-unit)) c))
(defn ml-chunk-bits [(c i64)] (-> i64) (al-get [i64] (.live-chunk-bits (machine-unit)) c))
(defn ml-chunk-next [(c i64)] (-> i64) (al-get [i64] (.live-chunk-next (machine-unit)) c))

(defn ml-chunk-alloc! [(word i64) (bits i64) (next i64)] (-> i64)
  (let [u (machine-unit) id (al-len [i64] (.live-chunk-word u))]
    (al-push! [i64] (field u live-chunk-word) word)
    (al-push! [i64] (field u live-chunk-bits) bits)
    (al-push! [i64] (field u live-chunk-next) next)
    id))

;; The bits stored at one word of a set, or zero when the set holds no chunk there.
;;
;; A one-entry resume cursor makes an ascending scan over a set O(1) per step instead of O(chunks).
;; The dense-era verifier and dump walk every word of a block in order and are kept unchanged by
;; this accessor; without the cursor those word-at-a-time walks would be quadratic in the set.
(defn ml-set-word [(set i64) (word i64)] (-> i64)
  (let [u (machine-unit)
        (mut c) (if (and (= (.live-cursor-set u) set)
                         (and (>= (.live-cursor-chunk u) 0)
                              (<= (ml-chunk-word (.live-cursor-chunk u)) word)))
                    (.live-cursor-chunk u)
                    (ml-set-first set))
        (mut bits) 0]
    (loop (if (< (load c) 0) (break)
              (let [w (ml-chunk-word (load c))]
                (if (> w word) (break)
                  (do (if (= w word) (set! bits (ml-chunk-bits (load c))) 0)
                      (set! (.live-cursor-set u) set)
                      (set! (.live-cursor-chunk u) (load c))
                      (if (= w word) (break) 0)
                      (set! c (ml-chunk-next (load c))))))))
    (load bits)))

;; OR `bits` into one word of a set, answering whether anything changed. Chunks stay in ascending
;; word order, so this walks to the insertion point and either merges or splices.
(defn ml-set-or-word! [(set i64) (word i64) (bits i64)] (-> bool)
  (if (= bits 0) false
    (let [u (machine-unit)
          (mut prev) -1
          (mut c) (ml-set-first set)
          (mut changed) false
          (mut done) false]
      ;; A write invalidates the read cursor only when it touches the set the cursor names; a
      ;; splice into a different set cannot move the remembered chunk. The solver reads `def` while
      ;; writing `in`, so invalidating unconditionally would defeat the cursor on every step.
      (if (= (.live-cursor-set u) set)
          (do (set! (.live-cursor-set u) -1) (set! (.live-cursor-chunk u) -1) 0)
          0)
      (loop (if (or (load done) (< (load c) 0)) (break)
                (let [w (ml-chunk-word (load c))]
                  (if (= w word)
                      (let [old (ml-chunk-bits (load c)) merged (| old bits)]
                        (if (!= merged old)
                            (do (al-set! [i64] (field u live-chunk-bits) (load c) merged)
                                (set! changed true))
                            0)
                        (set! done true))
                      (if (> w word)
                          (set! done true)
                          (do (set! prev (load c)) (set! c (ml-chunk-next (load c)))))))))
      (if (load changed) 0
        (if (and (load done) (>= (load c) 0) (= (ml-chunk-word (load c)) word)) 0
          (let [fresh (ml-chunk-alloc! word bits (load c))]
            (if (< (load prev) 0)
                (al-set! [i64] (field u live-set-head) set fresh)
                (al-set! [i64] (field u live-chunk-next) (load prev) fresh))
            (set! changed true))))
      (load changed))))

;; Clear `mask` from one word. Chunks that reach zero are left in place rather than unlinked: the
;; list stays short because it only ever held words that were live, and unlinking would invalidate
;; a caller mid-walk.
(defn ml-set-clear-word! [(set i64) (word i64) (mask i64)] (-> i64)
  (let [u (machine-unit) (mut c) (ml-set-first set)]
    (if (= (.live-cursor-set u) set)
        (do (set! (.live-cursor-set u) -1) (set! (.live-cursor-chunk u) -1) 0)
        0)
    (loop (if (< (load c) 0) (break)
              (let [w (ml-chunk-word (load c))]
                (if (> w word) (break)
                  (do (if (= w word)
                          (al-set! [i64] (field u live-chunk-bits) (load c)
                                   (& (ml-chunk-bits (load c)) (^ mask -1)))
                          0)
                      (if (= w word) (break) 0)
                      (set! c (ml-chunk-next (load c))))))))
    0))

(defn ml-set-bit! [(set i64) (local i64)] (-> bool)
  (ml-set-or-word! set (/ local 64) (<< 1 (& local 63))))
(defn ml-set-test? [(set i64) (local i64)] (-> bool)
  (!= (& (ml-set-word set (/ local 64)) (<< 1 (& local 63))) 0))

;; dst |= src, answering whether dst changed. Both are ascending, so this is a merge.
(defn ml-set-union-masked! [(dst i64) (src i64) (minus i64)] (-> bool)
  ;; dst |= src & ~minus, in ONE pass over all three. All are ascending by word, so the destination
  ;; and the mask are walked with cursors that only move forward.
  ;;
  ;; Doing this as a per-word insert instead -- restarting at the destination head for every source
  ;; chunk -- is quadratic in the set, and on a function with thousands of live-set words it does
  ;; not terminate in any useful time. `minus` may be -1 for a plain union.
  (let [u (machine-unit)
        (mut sc) (ml-set-first src)
        (mut mc) (if (< minus 0) -1 (ml-set-first minus))
        (mut dprev) -1
        (mut dc) (ml-set-first dst)
        (mut changed) false]
    (loop (if (< (load sc) 0) (break)
              (let [sw (ml-chunk-word (load sc))]
                (loop (if (or (< (load mc) 0) (>= (ml-chunk-word (load mc)) sw)) (break)
                          (set! mc (ml-chunk-next (load mc)))))
                (let [mask (if (and (>= (load mc) 0) (= (ml-chunk-word (load mc)) sw))
                               (ml-chunk-bits (load mc))
                               0)
                      sb (& (ml-chunk-bits (load sc)) (^ mask -1))]
                  (loop (if (or (< (load dc) 0) (>= (ml-chunk-word (load dc)) sw)) (break)
                            (do (set! dprev (load dc)) (set! dc (ml-chunk-next (load dc))))))
                  (if (and (>= (load dc) 0) (= (ml-chunk-word (load dc)) sw))
                      (let [old (ml-chunk-bits (load dc)) merged (| old sb)]
                        (if (!= merged old)
                            (do (al-set! [i64] (field u live-chunk-bits) (load dc) merged)
                                (set! changed true))
                            0)
                        (set! dprev (load dc))
                        (set! dc (ml-chunk-next (load dc))))
                      (if (= sb 0)
                          0
                          (let [fresh (ml-chunk-alloc! sw sb (load dc))]
                            (if (< (load dprev) 0)
                                (al-set! [i64] (field u live-set-head) dst fresh)
                                (al-set! [i64] (field u live-chunk-next) (load dprev) fresh))
                            (set! dprev fresh)
                            (set! changed true)))))
                (set! sc (ml-chunk-next (load sc))))))
    (if (and (load changed) (= (.live-cursor-set u) dst))
        (do (set! (.live-cursor-set u) -1) (set! (.live-cursor-chunk u) -1) 0)
        0)
    (load changed)))

(defn ml-set-union! [(dst i64) (src i64)] (-> bool)
  (ml-set-union-masked! dst src -1))
;; The size of ONE liveness bit matrix, in 64-bit words: the sum over blocks of the owning
;; function's vreg words. `live-use`, `live-def`, `live-in` and `live-out` each hold this many
;; words, and `edge-live` holds the same sum taken over edges. This is the exact number that
;; decides both the memory and the walk cost of every dense-set phase, so it is a compile budget
;; a gate can assert on: it is deterministic, where wall time and RSS are not.
(defn ml-liveness-words [] (-> i64)
  ;; Three words per chunk -- word, bits, next -- plus one head per set. What the dense matrix cost
  ;; is recoverable for comparison as `blocks * owner_words * 4 + edges * owner_words`; the point of
  ;; reporting the real number is that a budget gate now measures storage rather than a bound.
  (+ (* 3 (ml-chunk-count)) (ml-set-count)))
(defn ml-vreg-owner [(vreg i64)] (-> i64)
  (if (or (< vreg 0) (>= vreg (al-len [i64] (.vreg-owner (machine-unit)))))
      -1
      (al-get (.vreg-owner (machine-unit)) vreg)))
(defn ml-vreg-local [(vreg i64)] (-> i64)
  (if (or (< vreg 0) (>= vreg (al-len [i64] (.live-vreg-local (machine-unit)))))
      -1
      (al-get (.live-vreg-local (machine-unit)) vreg)))
(defn ml-owner-vreg [(owner i64) (local i64)] (-> i64)
  (al-get (.live-owner-vregs (machine-unit))
          (+ (al-get (.live-owner-first (machine-unit)) owner) local)))
(defn ml-bit [(vreg i64)] (-> i64)
  (<< 1 (& vreg 63)))
(defn ml-local-bit [(vreg i64)] (-> i64)
  (<< 1 (& (ml-vreg-local vreg) 63)))
(defn ml-use? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (ml-set-test? (ml-block-set ML-SET-USE bid) (ml-vreg-local vreg))))
(defn ml-def? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (ml-set-test? (ml-block-set ML-SET-DEF bid) (ml-vreg-local vreg))))
(defn ml-live-in? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (ml-set-test? (ml-block-set ML-SET-IN bid) (ml-vreg-local vreg))))
(defn ml-live-out? [(bid i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner bid))
       (ml-set-test? (ml-block-set ML-SET-OUT bid) (ml-vreg-local vreg))))
(defn ml-edge-live? [(edge i64) (vreg i64)] (-> bool)
  (and (= (ml-vreg-owner vreg) (mu-block-owner (mu-edge-source edge)))
       (ml-set-test? (ml-edge-set edge) (ml-vreg-local vreg))))
(defn ml-value-kind [(vreg i64)] (-> i64)
  (al-get (.value-kind (machine-unit)) vreg))
(defn ml-register-class [(vreg i64)] (-> i64)
  (al-get (.register-class (machine-unit)) vreg))
(defn ml-result [] (-> i64)
  (.liveness-result (machine-unit)))
(defn ml-result-item [] (-> i64)
  (.liveness-item (machine-unit)))
(defn ml-rounds [] (-> i64)
  (.liveness-rounds (machine-unit)))

(defn ml-vreg-class-is? [(vreg i64) (class i64)] (-> bool)
  (or (< vreg 0) (= (ml-register-class vreg) class)))

(defn ml-inst-classes-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        dst (.dst m)
        a (.a m)
        b (.b m)]
    (case op MI-SCVTF
          (and (ml-vreg-class-is? a MRC-GPR) (ml-vreg-class-is? dst MRC-FPR)) MI-I32FROMFP
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FADD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FSUB
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMUL
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FDIV
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMOD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FNEG
          (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? dst MRC-FPR)) MI-FEQ
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLT
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLE
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FTRUTH
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-MOD
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITAND
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITXOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHL
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-USHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITNOT
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-JSUNBOX
          ;; A tagged JavaScript word is always read out of a GPR. Where the payload lands depends
          ;; on the tag: unboxing to a NUMBER produces a double in an FPR, every other tag produces
          ;; a machine word in a GPR.
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst (if (= (load (field m imm)) 0) MRC-FPR MRC-GPR)))
            MI-COPY
          (= (ml-register-class dst) (ml-register-class a)) MI-RESULT-MATERIALIZE
          (= (ml-register-class dst) (ml-register-class a)) MI-ABI-COPY
          (= (ml-register-class dst) (ml-register-class a)) true)))

(defn ml-inst-uses? [(at i64) (vreg i64)] (-> bool)
  (ms-inst-uses-vreg? at vreg))

(defstruct MlVerifyScratch
  [(expected-use (ArrayList i64))
   (expected-def (ArrayList i64))
   (expected-edge (ArrayList i64))
   (inited bool)])
(defn ml-verify-scratch [] (-> (ptr MlVerifyScratch))
  (let [s (primitive/alloc-static MlVerifyScratch)]
    (if (.inited s)
        0
        (do
          (set! (.expected-use s) (al-new [i64] (malloc-allocator)))
          (set! (.expected-def s) (al-new [i64] (malloc-allocator)))
          (set! (.expected-edge s) (al-new [i64] (malloc-allocator)))
          (set! (.inited s) true)
          0))
    s))

(defn ml-verify-note-use! [(vreg i64)] (-> i64)
  (let [s (ml-verify-scratch)
        local (ml-vreg-local vreg)
        word (/ local 64)
        bit (ml-local-bit vreg)]
    (if (and (>= vreg 0) (< word (al-len [i64] (.expected-use s))))
        (if (!= (& (al-get [i64] (.expected-def s) word) bit) 0)
            0
            (do (al-set! [i64] (field s expected-use) word
                         (| (al-get [i64] (.expected-use s) word) bit)) 0))
        0)))

;; One instruction's contribution to the block's expected use/def sets: a use counts only when
;; the block has not yet defined that vreg, exactly as the per-vreg forward walk counted it.
(defn ml-verify-note-inst! [(at i64)] (-> i64)
  (let [s (ml-verify-scratch)
        m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)
        dst (.dst m)]
    (if (> inputs 0) (ml-verify-note-use! (.a m)) 0)
    (if (> inputs 1) (ml-verify-note-use! (.b m)) 0)
    (if (= op MI-CSEL) (ml-verify-note-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (ml-verify-note-use! (al-get (.call-args (machine-unit))
                                               (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    (if (and (>= dst 0)
             (< (/ (ml-vreg-local dst) 64) (al-len [i64] (.expected-def s))))
        (let [word (/ (ml-vreg-local dst) 64)]
          (al-set! [i64] (field s expected-def) word
                   (| (al-get [i64] (.expected-def s) word) (ml-local-bit dst))))
        0)))

;; Mark one operand of one instruction upward-exposed in its block, unless the block already
;; defined it. Enumerating an instruction's few operands replaces the old per-instruction sweep
;; over EVERY vreg asking ms-inst-uses-vreg?, which was quadratic in program size.
(defn ml-note-use! [(bid i64) (vreg i64)] (-> i64)
  (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
      (if (ml-def? bid vreg)
          0
          (do (ml-set-bit! (ml-block-set ML-SET-USE bid) (ml-vreg-local vreg)) 0))
      0))

(defn ml-build-local-layout! [] (-> i64)
  (let [u (machine-unit)
        funcs (mu-function-count)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut i) 0
        (mut cursor) 0]
    (al-clear! [i64] (field u live-vreg-owner))
    (al-clear! [i64] (field u live-vreg-local))
    (al-clear! [i64] (field u live-owner-first))
    (al-clear! [i64] (field u live-owner-count))
    (al-clear! [i64] (field u live-owner-words))
    (al-clear! [i64] (field u live-owner-vregs))
    (loop (if (>= (load i) funcs) (break)
              (do (al-push! [i64] (field u live-owner-count) 0)
                  (al-push! [i64] (field u live-owner-first) 0)
                  (al-push! [i64] (field u live-owner-words) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (do (al-push! [i64] (field u live-vreg-owner) -1)
                  (al-push! [i64] (field u live-vreg-local) -1)
                  (al-push! [i64] (field u live-owner-vregs) -1)
                  (set! i (+ (load i) 1)))))
    ;; Selection's completed MachineValue rows are the authoritative ownership boundary.
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (do
                (let [dst (load i) owner (al-get (.vreg-owner u) (load i))]
                  (if (>= owner 0)
                      (do
                        (al-set! [i64] (field u live-vreg-owner) dst owner)
                        (al-set! [i64] (field u live-owner-count) owner
                                 (+ (al-get (.live-owner-count u) owner) 1)))
                      0))
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) funcs) (break)
              (do
                (let [count (al-get (.live-owner-count u) (load i))]
                  (al-set! [i64] (field u live-owner-first) (load i) (load cursor))
                  (al-set! [i64] (field u live-owner-words) (load i) (/ (+ count 63) 64))
                  (set! cursor (+ (load cursor) count)))
                (set! i (+ (load i) 1)))))
    ;; Reuse owner-count as fill cursors, then restore its final counts from owner boundaries.
    (set! i 0)
    (loop (if (>= (load i) funcs) (break)
              (do (al-set! [i64] (field u live-owner-count) (load i) 0)
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) vregs) (break)
              (let [owner (al-get (.live-vreg-owner u) (load i))]
                (if (>= owner 0)
                    (let [local (al-get (.live-owner-count u) owner)]
                      (al-set! [i64] (field u live-vreg-local) (load i) local)
                      (al-set! [i64] (field u live-owner-vregs)
                               (+ (al-get (.live-owner-first u) owner) local) (load i))
                      (al-set! [i64] (field u live-owner-count) owner (+ local 1)))
                    0)
                (set! i (+ (load i) 1)))))
    0))

(defn ml-init-tables! [] (-> i64)
  ;; Four block sets plus one per edge, each starting empty. This is O(blocks + edges) where the
  ;; dense form pushed one word per (block, vreg-word) pair and per (edge, vreg-word) pair -- for
  ;; the DataView Test262 file, 2.3 billion pushes.
  (let [u (machine-unit)
        sets (+ (* 4 (mu-block-count)) (mu-edge-count))
        (mut i) 0]
    (ml-build-local-layout!)
    (al-clear! [i64] (field u live-set-head))
    (al-clear! [i64] (field u live-chunk-word))
    (al-clear! [i64] (field u live-chunk-bits))
    (al-clear! [i64] (field u live-chunk-next))
    (set! (.live-cursor-set u) -1)
    (set! (.live-cursor-chunk u) -1)
    (loop (if (>= (load i) sets) (break)
              (do (al-push! [i64] (field u live-set-head) -1)
                  (set! i (+ (load i) 1)))))
    0))

(defn ml-compute-use-def! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0
        (mut phase-start) (ms-profile-now)]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) 0]
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (.dst m)
                                    desc (mi-desc (.op m))
                                    inputs (mi-desc-inputs desc)]
                                ; The same operand positions ms-inst-uses-vreg? tests, walked
                                ; directly: a, b, a CSEL's imm, and the argument list.
                                (if (> inputs 0) (ml-note-use! (load bid) (.a m)) 0)
                                (if (> inputs 1) (ml-note-use! (load bid) (.b m)) 0)
                                (if (= (.op m) MI-CSEL)
                                    (ml-note-use! (load bid) (.imm m))
                                    0)
                                (let [args (ms-inst-arg-count at)
                                      (mut arg) 0]
                                  (loop (if (>= (load arg) args)
                                            (break)
                                            (do
                                              (ml-note-use! (load bid) (ms-inst-arg at (load arg)))
                                              (set! arg (+ (load arg) 1))
                                              0))))
                                (if (>= dst 0)
                                    (do (ml-set-bit! (ml-block-set ML-SET-DEF (load bid))
                                                     (ml-vreg-local dst)) 0)
                                    0))
                              (set! i (+ (load i) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    (set! phase-start (ms-profile-note! "liveness_use_sets" (load phase-start)))
    (ms-profile-note! "liveness_value_metadata_reads" (load phase-start))
    0))

;; Phi resolution can place a synthetic copy before the instruction that defines its source.
;; Seed all explicit definitions first, then propagate classes through copies to a fixed point so
;; class publication is independent of scheduled instruction order.
(defn ml-solve! [(seed i64)] (-> bool)
  ;; out[b] = U in[succ];  in[b] = use[b] u (out[b] - def[b]).
  ;;
  ;; Identical equations to the dense solver, over sparse sets. Both sides are monotone, so a round
  ;; only ever adds chunks and "did in change" is exactly "did a union add anything". The worklist,
  ;; its seed-controlled initial order, and the predecessor re-queue are unchanged.
  (let [u (machine-unit)
        blocks (mu-block-count)
        (mut pending) (al-new [i64] (malloc-allocator))
        (mut queued) (al-new [i64] (malloc-allocator))
        (mut processed) 0
        (mut pos) 0]
    (loop (if (>= (load pos) blocks)
              (break)
              (do
                (al-push! [i64] (mut queued) 1)
                (al-push! [i64] (mut pending)
                          (if (= (& seed 1) 0) (load pos) (- blocks (+ (load pos) 1))))
                (set! pos (+ (load pos) 1)))))
    (loop (if (= (al-len [i64] (load pending)) 0)
              (break)
              (let [last (- (al-len [i64] (load pending)) 1)
                    bid (al-get [i64] (load pending) last)
                    succs (mu-block-succ-count bid)
                    out-set (ml-block-set ML-SET-OUT bid)
                    in-set (ml-block-set ML-SET-IN bid)
                    def-set (ml-block-set ML-SET-DEF bid)
                    (mut in-changed) false
                    (mut sidx) 0]
                (al-pop! [i64] (mut pending))
                (al-set! [i64] (mut queued) bid 0)
                (loop (if (>= (load sidx) succs)
                          (break)
                          (do
                            (ml-set-union! out-set
                                           (ml-block-set ML-SET-IN
                                                         (mu-block-succ-target bid (load sidx))))
                            (set! sidx (+ (load sidx) 1)))))
                ;; in |= out - def. Walking `out` and masking each word against `def` is the same
                ;; expression the dense solver evaluated word by word; `use` was already merged
                ;; into `in` when it was built, and `use` never changes after that.
                (if (ml-set-union! in-set (ml-block-set ML-SET-USE bid))
                    (set! in-changed true) 0)
                (if (ml-set-union-masked! in-set out-set def-set)
                    (set! in-changed true) 0)
                (if (load in-changed)
                    (let [(mut p) 0]
                      (loop (if (>= (load p) (mu-block-pred-count bid))
                                (break)
                                (let [pred (mu-block-pred-source bid (load p))]
                                  (if (= (al-get [i64] (load queued) pred) 0)
                                      (do
                                        (al-set! [i64] (mut queued) pred 1)
                                        (al-push! [i64] (mut pending) pred))
                                      0)
                                  (set! p (+ (load p) 1))))))
                    0)
                (set! processed (+ (load processed) 1)))))
    (set! (.liveness-rounds u) (load processed))
    (al-free! [i64] (mut pending))
    (al-free! [i64] (mut queued))
    true))

(defn ml-compute-edge-live! [] (-> i64)
  (let [edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut edge) 0]
    (loop (if (>= (load edge) edges)
              (break)
              (do
                (let [target (mu-edge-target (load edge))
                      edge-set (ml-edge-set (load edge))
                      copies (mu-edge-copy-count (load edge))
                      (mut i) 0]
                  (ml-set-union! edge-set (ml-block-set ML-SET-IN target))
                  ; A copy's destination is born on the edge (cleared), its source is consumed
                  ; there (set); a vreg that is both stays live, so every clear happens before
                  ; any set — the same precedence the per-vreg version had.
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [dst (mu-copy-dst (load edge) (load i))]
                                    (if (and (>= dst 0) (< dst vregs))
                                        (let [local (ml-vreg-local dst)]
                                          (ml-set-clear-word! edge-set (/ local 64)
                                                              (<< 1 (& local 63))))
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0)))
                  (set! i 0)
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [src (mu-copy-src (load edge) (load i))]
                                    (if (and (>= src 0) (< src vregs))
                                        (do (ml-set-bit! edge-set (ml-vreg-local src)) 0)
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0))))
                (set! edge (+ (load edge) 1))
                0)))
    0))

(defn ml-live-before? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))
                      dst (ms-inst-dst (+ first (load i)))]
                  (if (= dst vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0))
                (if (= (+ first (load i)) at) (break) 0))))
    (load live)))

(defn ml-live-after? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))]
                  (if (= current at) (break) 0)
                  (if (= (ms-inst-dst current) vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0)))))
    (load live)))

(defn ml-safepoint? [(at i64)] (-> bool)
  (let [op (ms-inst-op at)] (or (= op MI-CALL) (= op MI-NEW))))

(defn ml-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        s (ml-verify-scratch)
        (mut bid) 0
        (mut max-words) 0]
    (set! (.liveness-result u) MLIVE-OK)
    (set! (.liveness-item u) -1)
    ;; One fixed scratch shape serves every block and edge. Repeated clear/push cycles across
    ;; 75,000 blocks paid ArrayList append checks for every represented word.
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [words (ml-block-words (load bid))]
                  (if (> words (load max-words)) (set! max-words words) 0))
                (set! bid (+ (load bid) 1)))))
    (al-clear! [i64] (field s expected-use))
    (al-clear! [i64] (field s expected-def))
    (al-clear! [i64] (field s expected-edge))
    (let [(mut word) 0]
      (loop (if (>= (load word) (load max-words))
                (break)
                (do
                  (al-push! [i64] (field s expected-use) 0)
                  (al-push! [i64] (field s expected-def) 0)
                  (al-push! [i64] (field s expected-edge) 0)
                  (set! word (+ (load word) 1))))))
    (set! bid 0)
    ; Re-derive use/def and the fixed-point equations without mutating the published sets.
    ; One forward operand walk per block fills the per-vreg expectations; asking every vreg
    ; about every instruction made this verifier cubic on large programs.
    (loop (if (or (>= (load bid) blocks) (!= (ml-result) MLIVE-OK))
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      owner (mu-block-owner (load bid))
                      words (ml-block-words (load bid))
                      (mut vr) 0
                      (mut i) 0]
                  (loop (if (>= (load vr) words)
                            (break)
                            (do
                              (al-set! [i64] (field s expected-use) (load vr) 0)
                              (al-set! [i64] (field s expected-def) (load vr) 0)
                              (set! vr (+ (load vr) 1))
                              0)))
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (ml-verify-note-inst! (+ first (load i)))
                              (set! i (+ (load i) 1))
                              0)))
                  (set! vr 0)
                  (loop (if (or (>= (load vr) words) (!= (ml-result) MLIVE-OK))
                            (break)
                            (do
                              (let [expected-use (al-get [i64] (.expected-use s) (load vr))
                                    expected-def (al-get [i64] (.expected-def s) (load vr))
                                    (mut expected-out) 0
                                    (mut k) 0]
                                (loop (if (>= (load k) (mu-block-succ-count (load bid)))
                                          (break)
                                          (do
                                            (set! expected-out
                                                  (| (load expected-out)
                                                     (ml-set-word
                                                       (ml-block-set ML-SET-IN
                                                         (mu-block-succ-target
                                                           (load bid) (load k)))
                                                       (load vr))))
                                            (set! k (+ (load k) 1))
                                            0)))
                                (let [expected-in (| expected-use
                                                     (& (load expected-out) (^ expected-def -1)))]
                                  (if (or (!= (ml-set-word (ml-block-set ML-SET-USE (load bid))
                                                           (load vr)) expected-use)
                                          (or (!= (ml-set-word (ml-block-set ML-SET-DEF (load bid))
                                                               (load vr)) expected-def)
                                              (or (!= (ml-set-word (ml-block-set ML-SET-OUT (load bid))
                                                                   (load vr)) (load expected-out))
                                                  (!= (ml-set-word (ml-block-set ML-SET-IN (load bid))
                                                                   (load vr)) expected-in))))
                                      (do
                                        (set! (.liveness-result u) MLIVE-FIXPOINT)
                                        (set! (.liveness-item u)
                                              (ml-index (load bid)
                                                        (ml-owner-vreg owner (* (load vr) 64)))))
                                      0)))
                              (set! vr (+ (load vr) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    (if (= (ml-result) MLIVE-OK)
        (let [(mut edge) 0]
          (loop (if (or (>= (load edge) edges) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [target (mu-edge-target (load edge))
                            owner (mu-block-owner target)
                            words (ml-block-words target)
                            copies (mu-edge-copy-count (load edge))
                            (mut word) 0
                            (mut copy) 0]
                        (loop (if (>= (load word) words)
                                  (break)
                                  (do
                                    (al-set! [i64] (field s expected-edge) (load word)
                                             (ml-set-word (ml-block-set ML-SET-IN target)
                                                          (load word)))
                                    (set! word (+ (load word) 1)))))
                        ;; Apply each copy once to the independent expected row. The old verifier
                        ;; reapplied every copy for every word: edge_words * edge_copies.
                        (loop (if (>= (load copy) copies)
                                  (break)
                                  (do
                                    (if (= (mu-copy-kind (load edge) (load copy)) MCOPY-VALUE)
                                        (let [dst (mu-copy-dst (load edge) (load copy))
                                              dst-word (/ (ml-vreg-local dst) 64)]
                                          (al-set! [i64] (field s expected-edge) dst-word
                                                   (& (al-get (.expected-edge s) dst-word)
                                                      (^ (ml-local-bit dst) -1))))
                                        0)
                                    (set! copy (+ (load copy) 1)))))
                        (set! copy 0)
                        (loop (if (>= (load copy) copies)
                                  (break)
                                  (do
                                    (if (= (mu-copy-kind (load edge) (load copy)) MCOPY-VALUE)
                                        (let [src (mu-copy-src (load edge) (load copy))
                                              src-word (/ (ml-vreg-local src) 64)]
                                          (al-set! [i64] (field s expected-edge) src-word
                                                   (| (al-get (.expected-edge s) src-word)
                                                      (ml-local-bit src))))
                                        0)
                                    (set! copy (+ (load copy) 1)))))
                        (set! word 0)
                        (loop (if (or (>= (load word) words)
                                      (!= (ml-result) MLIVE-OK))
                                  (break)
                                  (do
                                    (if (!= (ml-set-word (ml-edge-set (load edge)) (load word))
                                            (al-get [i64] (.expected-edge s) (load word)))
                                        (do
                                          (set! (.liveness-result u) MLIVE-PHI)
                                          (set! (.liveness-item u)
                                                (ml-edge-index
                                                  (load edge)
                                                  (ml-owner-vreg owner (* (load word) 64)))))
                                        0)
                                    (set! word (+ (load word) 1))))))
                      (set! edge (+ (load edge) 1))))))
        0)
    (if (= (ml-result) MLIVE-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [dst (ms-inst-dst (load at))]
                        (if (not (ms-inst-result-kind-contract-valid? (load at)))
                            (do
                              (set! (.liveness-result u) MLIVE-KIND)
                              (set! (.liveness-item u) (if (>= dst 0) dst (load at))))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ms-inst-result-class-contract-valid? (load at))))
                            (do
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) (if (>= dst 0) dst (load at))))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ml-inst-classes-valid? (load at))))
                            (do
                              (fmt (stderr)
                                   "liveness-class-operands inst={d} op={d} dst={d} a={d} b={d}\n"
                                   (load at) (.op (be-inst (load at))) dst
                                   (.a (be-inst (load at))) (.b (be-inst (load at))))
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) (load at)))
                            0))
                      (set! at (+ (load at) 1))
                      0))))
        0)
    (= (ml-result) MLIVE-OK)))


;; WHY THE DENSE BIT MATRIX CANNOT SIMPLY BE MADE SPARSE.
;;
;; The obvious repair for a `blocks x owner_vregs` matrix is a sparse per-block live set, which is
;; what Simple does (`IdentityHashMap<LRG,Node>` per block) and what every production allocator does.
;; This counts whether that would actually help, by reporting how many bits are really set:
;;
;;   var x = 1;                     57 blocks,     5.5 values live per block boundary
;;   3-line `for` loop            5,436 blocks,   739
;;   [1,2,3].join("-")            6,986 blocks,   369
;;   assert.js + sta.js          92,841 blocks,   890
;;   + DataView getUint8 test   137,870 blocks, 1,965
;;
;; The floor case is healthy. Everything a JSL macro touches is not: with ~900 values live at every
;; boundary of a 90,000-block function, a sparse set costs 4 bytes per live value where the dense
;; matrix costs one bit, and the two land within a factor of ~6 of each other. That is not the
;; hundredfold this needs. The size of the input is the problem, not the way it is stored.
;;
;; So this stays as a diagnostic, gated on profiling: it is the number that says whether the
;; representation has become the bottleneck yet. It has not.
(defn ml-measure-alphabet! [] (-> i64)
  ;; WHY THE SETS ARE STILL EXPENSIVE AFTER BECOMING SPARSE.
  ;;
  ;; This walks the chunk lists, so it costs what the sets cost. It reports the number that decides
  ;; what to fix next: live bits against chunks. One bit per chunk means the live values are
  ;; scattered across the vreg space and NO bitset representation can help -- the cost is that too
  ;; many values are simultaneously live, which is a property of the code, not of the storage.
  ;;
  ;; DataView Test262 file: 8.47M live-in bits over 24,620 blocks is 344 values live at every block
  ;; boundary, in 16.9M chunks. A normal function has tens. The backend has no rematerialization, so
  ;; every materialized constant and address occupies a live range from its placement to its last
  ;; use; Simple splits those into private uses instead (`MachNode.isClone`, IFG.java:215).
  (let [blocks (mu-block-count)
        (mut seen) (al-new [i64] (malloc-allocator))
        (mut bid) 0
        (mut in-bits) 0
        (mut out-bits) 0
        (mut i) 0]
    (loop (if (>= (load i) (ml-vreg-count)) (break)
              (do (al-push! [i64] (mut seen) 0) (set! i (+ (load i) 1)))))
    (loop (if (>= (load bid) blocks) (break)
              (let [owner (mu-block-owner (load bid))
                    (mut kind) ML-SET-IN]
                (loop (if (> (load kind) ML-SET-OUT) (break)
                          (let [(mut c) (ml-set-first (ml-block-set (load kind) (load bid)))]
                            (loop (if (< (load c) 0) (break)
                                      (let [word (ml-chunk-word (load c))
                                            bits (ml-chunk-bits (load c))
                                            (mut bit) 0]
                                        (loop (if (>= (load bit) 64) (break)
                                                  (do
                                                    (if (!= (& bits (<< 1 (load bit))) 0)
                                                        (let [local (+ (* word 64) (load bit))]
                                                          (if (= (load kind) ML-SET-IN)
                                                              (set! in-bits (+ (load in-bits) 1))
                                                              (set! out-bits (+ (load out-bits) 1)))
                                                          (if (< local (al-get (.live-owner-count
                                                                                 (machine-unit))
                                                                               owner))
                                                              (al-set! [i64] (mut seen)
                                                                       (ml-owner-vreg owner local) 1)
                                                              0))
                                                        0)
                                                    (set! bit (+ (load bit) 1)))))
                                        (set! c (ml-chunk-next (load c))))))
                            (set! kind (+ (load kind) 1)))))
                (set! bid (+ (load bid) 1)))))
    (set! i 0)
    (let [(mut globals) 0]
      (loop (if (>= (load i) (ml-vreg-count)) (break)
                (do (if (!= (al-get [i64] (load seen) (load i)) 0)
                        (set! globals (+ (load globals) 1)) 0)
                    (set! i (+ (load i) 1)))))
      (fmt (stderr)
           "AOTK_PROFILE phase=liveness_alphabet total_vregs={d} boundary_vregs={d} live_in_bits={d} live_out_bits={d} chunks={d}\n"
           (ml-vreg-count) (load globals) (load in-bits) (load out-bits) (ml-chunk-count)))
    (al-free! [i64] (mut seen))
    0))

(defn ml-compute! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        (mut phase-start) (ms-profile-now)]
    (set! (.liveness-seed u) seed)
    (ml-init-tables!)
    (set! phase-start (ms-profile-note! "liveness_init" (load phase-start)))
    (ml-compute-use-def!)
    (set! phase-start (ms-profile-note! "liveness_use_def" (load phase-start)))
    (if (not (ml-solve! seed))
        (do
          (set! phase-start (ms-profile-note! "liveness_solve" (load phase-start)))
          (set! (.liveness-result u) MLIVE-FIXPOINT)
          (set! (.liveness-item u) -1)
          false)
        (do
          (set! phase-start (ms-profile-note! "liveness_solve" (load phase-start)))
          (ml-compute-edge-live!)
          (set! phase-start (ms-profile-note! "liveness_edges" (load phase-start)))
          ;; ml-measure-alphabet! is deliberately NOT called here. It walks every chunk of every
          ;; set and cost more than the phase it measures, which made every --profile run report a
          ;; liveness time several times the whole compile. Call it from a diagnostic when the
          ;; question "are the sets dense enough for a bitset" comes back.
          0
          (let [ok (if (be-verification?) (ml-verify!) true)]
            (ms-profile-note! "liveness_verify" (load phase-start))
            ok)))))

(defn ml-corrupt-live-out! [(bid i64) (vreg i64) (live bool)] (-> i64)
  (let [local (ml-vreg-local vreg) set (ml-block-set ML-SET-OUT bid)]
    (if live (do (ml-set-bit! set local) 0)
        (ml-set-clear-word! set (/ local 64) (<< 1 (& local 63))))))

(defn ml-corrupt-edge-live! [(edge i64) (vreg i64) (live bool)] (-> i64)
  (let [local (ml-vreg-local vreg) set (ml-edge-set edge)]
    (if live (do (ml-set-bit! set local) 0)
        (ml-set-clear-word! set (/ local 64) (<< 1 (& local 63))))))

(defn ml-corrupt-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) value-kind) vreg kind)
  0)
(defn ml-corrupt-register-class! [(vreg i64) (class i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) register-class) vreg class)
  0)

(defn ml-dump-set [(w (ptr Writer)) (kind i64) (id i64)] (-> i64)
  (let [vregs (ml-vreg-count)
        (mut vr) 0
        (mut first) true]
    (ps w "{")
    (loop (if (>= (load vr) vregs)
              (break)
              (do
                (let [live
                        (case kind 0
                              (ml-use? id (load vr)) 1
                              (ml-def? id (load vr)) 2
                              (ml-live-in? id (load vr)) 3
                              (ml-live-out? id (load vr)) (ml-edge-live? id (load vr)))]
                  (if live
                      (do
                        (if (load first) 0 (ps w ","))
                        (fmt w "v{d}" (load vr))
                        (set! first false))
                      0))
                (set! vr (+ (load vr) 1))
                0)))
    (ps w "}")
    0))

(defn ml-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [blocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) blocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))]
                                (fmt w "  b{d} use" (load rpo))
                                (ml-dump-set w 0 bid)
                                (ps w " def")
                                (ml-dump-set w 1 bid)
                                (ps w " in")
                                (ml-dump-set w 2 bid)
                                (ps w " out")
                                (ml-dump-set w 3 bid)
                                (ps w "\n"))
                              (set! rpo (+ (load rpo) 1))
                              0))))
                (set! owner (+ (load owner) 1))
                0)))
    (let [edges (mu-edge-count)
          (mut edge) 0]
      (loop (if (>= (load edge) edges)
                (break)
                (do
                  (fmt w
                       "edge {d} {d}->{d} live"
                       (load edge)
                       (mu-edge-source (load edge))
                       (mu-edge-target (load edge)))
                  (ml-dump-set w 4 (load edge))
                  (ps w "\n")
                  (set! edge (+ (load edge) 1))
                  0))))
    0))

(defn ml-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ml-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "ml-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))
