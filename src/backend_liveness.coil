;; CFG liveness, register classes, value kinds, and safepoint root discovery.
(module backend_liveness)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

; ---------------------------------------------------------------------------
; G6 CFG liveness over the final scheduled machine code.
; ---------------------------------------------------------------------------

(defn ml-vreg-count [] (-> i64)
  (.next-vreg (machine-unit)))
;; ml-index/ml-edge-index survive as the DIAGNOSTIC item encoding (liveness-item) only. The
;; sets themselves are bitsets — 64 vregs per word — so the fixed-point solver and the whole-set
;; verifiers move word-wise instead of one (block, vreg) cell at a time.
(defn ml-index [(bid i64) (vreg i64)] (-> i64)
  (+ (* bid (ml-vreg-count)) vreg))
(defn ml-edge-index [(edge i64) (vreg i64)] (-> i64)
  (+ (* edge (ml-vreg-count)) vreg))
(defn ml-live-words [] (-> i64)
  (/ (+ (ml-vreg-count) 63) 64))
(defn ml-word-index [(bid i64) (vreg i64)] (-> i64)
  (+ (* bid (ml-live-words)) (/ vreg 64)))
(defn ml-bit [(vreg i64)] (-> i64)
  (<< 1 (& vreg 63)))
(defn ml-use? [(bid i64) (vreg i64)] (-> bool)
  (!= (& (al-get (.live-use (machine-unit)) (ml-word-index bid vreg))
         (ml-bit vreg))
      0))
(defn ml-def? [(bid i64) (vreg i64)] (-> bool)
  (!= (& (al-get (.live-def (machine-unit)) (ml-word-index bid vreg))
         (ml-bit vreg))
      0))
(defn ml-live-in? [(bid i64) (vreg i64)] (-> bool)
  (!= (& (al-get (.live-in (machine-unit)) (ml-word-index bid vreg))
         (ml-bit vreg))
      0))
(defn ml-live-out? [(bid i64) (vreg i64)] (-> bool)
  (!= (& (al-get (.live-out (machine-unit)) (ml-word-index bid vreg))
         (ml-bit vreg))
      0))
(defn ml-edge-live? [(edge i64) (vreg i64)] (-> bool)
  (!= (& (al-get (.edge-live (machine-unit)) (ml-word-index edge vreg))
         (ml-bit vreg))
      0))
(defn ml-value-kind [(vreg i64)] (-> i64)
  (al-get (.value-kind (machine-unit)) vreg))
(defn ml-register-class [(vreg i64)] (-> i64)
  (al-get (.register-class (machine-unit)) vreg))
(defn ml-result [] (-> i64)
  (.liveness-result (machine-unit)))
(defn ml-result-item [] (-> i64)
  (.liveness-item (machine-unit)))
(defn ml-rounds [] (-> i64)
  (.liveness-rounds (machine-unit)))

(defn ml-vreg-class-is? [(vreg i64) (class i64)] (-> bool)
  (or (< vreg 0) (= (ml-register-class vreg) class)))

(defn ml-inst-classes-valid? [(at i64)] (-> bool)
  (let [m (be-inst at)
        op (.op m)
        dst (.dst m)
        a (.a m)
        b (.b m)]
    (case op MI-SCVTF
          (and (ml-vreg-class-is? a MRC-GPR) (ml-vreg-class-is? dst MRC-FPR)) MI-I32FROMFP
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FADD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FSUB
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMUL
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FDIV
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FMOD
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-FPR))
            MI-FNEG
          (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? dst MRC-FPR)) MI-FEQ
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLT
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FLE
          (and (and (ml-vreg-class-is? a MRC-FPR) (ml-vreg-class-is? b MRC-FPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-FTRUTH
          (and (ml-vreg-class-is? a MRC-FPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-MOD
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITAND
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITXOR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHL
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-SHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-USHR
          (and (and (ml-vreg-class-is? a MRC-GPR)
                    (ml-vreg-class-is? b MRC-GPR))
               (ml-vreg-class-is? dst MRC-GPR))
            MI-BITNOT
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst MRC-GPR))
            MI-JSUNBOX
          ;; A tagged JavaScript word is always read out of a GPR. Where the payload lands depends
          ;; on the tag: unboxing to a NUMBER produces a double in an FPR, every other tag produces
          ;; a machine word in a GPR.
          (and (ml-vreg-class-is? a MRC-GPR)
               (ml-vreg-class-is? dst (if (= (load (field m imm)) 0) MRC-FPR MRC-GPR)))
            MI-COPY
          (= (ml-register-class dst) (ml-register-class a)) MI-ABI-COPY
          (= (ml-register-class dst) (ml-register-class a)) true)))

(defn ml-inst-uses? [(at i64) (vreg i64)] (-> bool)
  (ms-inst-uses-vreg? at vreg))

(defstruct MlVerifyScratch
  [(expected-use (ArrayList bool))
   (expected-def (ArrayList bool))
   (inited bool)])
(defn ml-verify-scratch [] (-> (ptr MlVerifyScratch))
  (let [s (primitive/alloc-static MlVerifyScratch)]
    (if (.inited s)
        0
        (do
          (set! (.expected-use s) (al-new [bool] (malloc-allocator)))
          (set! (.expected-def s) (al-new [bool] (malloc-allocator)))
          (set! (.inited s) true)
          0))
    s))

(defn ml-verify-note-use! [(vreg i64)] (-> i64)
  (let [s (ml-verify-scratch)]
    (if (and (>= vreg 0) (< vreg (al-len [bool] (.expected-use s))))
        (if (al-get [bool] (.expected-def s) vreg)
            0
            (do (al-set! [bool] (field s expected-use) vreg true) 0))
        0)))

;; One instruction's contribution to the block's expected use/def sets: a use counts only when
;; the block has not yet defined that vreg, exactly as the per-vreg forward walk counted it.
(defn ml-verify-note-inst! [(at i64)] (-> i64)
  (let [s (ml-verify-scratch)
        m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)
        dst (.dst m)]
    (if (> inputs 0) (ml-verify-note-use! (.a m)) 0)
    (if (> inputs 1) (ml-verify-note-use! (.b m)) 0)
    (if (= op MI-CSEL) (ml-verify-note-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (ml-verify-note-use! (al-get (.call-args (machine-unit))
                                               (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    (if (and (>= dst 0) (< dst (al-len [bool] (.expected-def s))))
        (do (al-set! [bool] (field s expected-def) dst true) 0)
        0)))

;; Mark one operand of one instruction upward-exposed in its block, unless the block already
;; defined it. Enumerating an instruction's few operands replaces the old per-instruction sweep
;; over EVERY vreg asking ms-inst-uses-vreg?, which was quadratic in program size.
(defn ml-note-use! [(bid i64) (vreg i64)] (-> i64)
  (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
      (if (ml-def? bid vreg)
          0
          (let [u (machine-unit)
                idx (ml-word-index bid vreg)]
            (al-set! [i64] (field u live-use) idx
                     (| (al-get (.live-use u) idx) (ml-bit vreg)))))
      0))

(defn ml-init-tables! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        (mut i) 0]
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (al-clear! [i64] (field u value-kind))
    (al-clear! [i64] (field u register-class))
    (loop (if (>= (load i) (* blocks (ml-live-words)))
              (break)
              (do
                (al-push! [i64] (field u live-use) 0)
                (al-push! [i64] (field u live-def) 0)
                (al-push! [i64] (field u live-in) 0)
                (al-push! [i64] (field u live-out) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) (* edges (ml-live-words)))
              (break)
              (do
                (al-push! [i64] (field u edge-live) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u value-kind) MLK-SCALAR)
                (al-push! [i64] (field u register-class) MRC-GPR)
                (set! i (+ (load i) 1))
                0)))
    0))

(defn ml-compute-use-def! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) 0]
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (.dst m)
                                    desc (mi-desc (.op m))
                                    inputs (mi-desc-inputs desc)]
                                ; The same operand positions ms-inst-uses-vreg? tests, walked
                                ; directly: a, b, a CSEL's imm, and the argument list.
                                (if (> inputs 0) (ml-note-use! (load bid) (.a m)) 0)
                                (if (> inputs 1) (ml-note-use! (load bid) (.b m)) 0)
                                (if (= (.op m) MI-CSEL)
                                    (ml-note-use! (load bid) (.imm m))
                                    0)
                                (let [args (ms-inst-arg-count at)
                                      (mut arg) 0]
                                  (loop (if (>= (load arg) args)
                                            (break)
                                            (do
                                              (ml-note-use! (load bid) (ms-inst-arg at (load arg)))
                                              (set! arg (+ (load arg) 1))
                                              0))))
                                (if (>= dst 0)
                                    (let [idx (ml-word-index (load bid) dst)]
                                      (al-set! [i64] (field u live-def) idx
                                               (| (al-get (.live-def u) idx)
                                                  (ml-bit dst)))
                                      (al-set! [i64] (field u value-kind) dst (ml-kind-for-inst at))
                                      (al-set! [i64] (field u register-class) dst (ml-class-for-inst at)))
                                    0))
                              (set! i (+ (load i) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    0))

;; Phi resolution can place a synthetic copy before the instruction that defines its source.
;; Seed all explicit definitions first, then propagate classes through copies to a fixed point so
;; class publication is independent of scheduled instruction order.
(defn ml-propagate-register-classes! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        (mut changed) true
        (mut rounds) 0]
    (loop (if (or (not (load changed)) (> (load rounds) n))
              (break)
              (do
                (set! changed false)
                (let [(mut at) 0]
                  (loop (if (>= (load at) n)
                            (break)
                            (do
                              (let [m (be-inst (load at))
                                    op (.op m)
                                    dst (.dst m)
                                    src (.a m)]
                                (if (and (or (= op MI-COPY) (= op MI-ABI-COPY))
                                         (and (>= dst 0) (>= src 0)))
                                    (let [class (al-get (.register-class u) src)]
                                      (if (!= (al-get (.register-class u) dst) class)
                                          (do
                                            (al-set! [i64] (field u register-class) dst class)
                                            (set! changed true))
                                          0))
                                    0))
                              (set! at (+ (load at) 1))
                              0))))
                (set! rounds (+ (load rounds) 1))
                0)))
    (load rounds)))

;; Word-wise Gauss-Seidel over the bitsets: the 64 vregs of one word update together, and each
;; is an independent equation, so the per-round states match the old one-cell-at-a-time solver
;; exactly — including the round count.
(defn ml-solve! [(seed i64)] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        words (ml-live-words)
        live-in (.live-in u)
        live-use (.live-use u)
        live-def (.live-def u)
        live-out (.live-out u)
        (mut changed) true
        (mut rounds) 0]
    (loop (if (or (not (load changed)) (> (load rounds) (+ (* blocks (ml-vreg-count)) 1)))
              (break)
              (do
                (set! changed false)
                (let [(mut pos) 0]
                  (loop (if (>= (load pos) blocks)
                            (break)
                            (do
                              (let [bid
                                      (if (= (& seed 1) 0)
                                          (- blocks (+ (load pos) 1))
                                          (load pos))
                                    succs (mu-block-succ-count bid)
                                    base (* bid words)
                                    (mut w) 0]
                                (loop (if (>= (load w) words)
                                          (break)
                                          (do
                                            (let [(mut s) 0
                                                  (mut out) 0]
                                              (loop (if (>= (load s) succs)
                                                        (break)
                                                        (do
                                                          (set! out
                                                                (| (load out)
                                                                   (al-get live-in
                                                                           (+ (* (mu-block-succ-target bid (load s))
                                                                                 words)
                                                                              (load w)))))
                                                          (set! s (+ (load s) 1))
                                                          0)))
                                              (let [idx (+ base (load w))
                                                    in (| (al-get live-use idx)
                                                          (& (load out)
                                                             (^ (al-get live-def idx) -1)))]
                                                (if (!= (al-get live-out idx) (load out))
                                                    (do
                                                      (al-set! [i64] (field u live-out) idx (load out))
                                                      (set! changed true))
                                                    0)
                                                (if (!= (al-get live-in idx) in)
                                                    (do
                                                      (al-set! [i64] (field u live-in) idx in)
                                                      (set! changed true))
                                                    0)))
                                            (set! w (+ (load w) 1))
                                            0))))
                              (set! pos (+ (load pos) 1))
                              0))))
                (set! rounds (+ (load rounds) 1))
                0)))
    (set! (.liveness-rounds u) (load rounds))
    (not (load changed))))

(defn ml-compute-edge-live! [] (-> i64)
  (let [u (machine-unit)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        words (ml-live-words)
        live-in (.live-in u)
        (mut edge) 0]
    (loop (if (>= (load edge) edges)
              (break)
              (do
                (let [target (mu-edge-target (load edge))
                      base (* (load edge) words)
                      copies (mu-edge-copy-count (load edge))
                      (mut w) 0
                      (mut i) 0]
                  (loop (if (>= (load w) words)
                            (break)
                            (do
                              (al-set! [i64] (field u edge-live) (+ base (load w))
                                       (al-get live-in (+ (* target words) (load w))))
                              (set! w (+ (load w) 1))
                              0)))
                  ; A copy's destination is born on the edge (cleared), its source is consumed
                  ; there (set); a vreg that is both stays live, so every clear happens before
                  ; any set — the same precedence the per-vreg version had.
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [dst (mu-copy-dst (load edge) (load i))]
                                    (if (and (>= dst 0) (< dst vregs))
                                        (let [idx (+ base (/ dst 64))]
                                          (al-set! [i64] (field u edge-live) idx
                                                   (& (al-get (.edge-live u) idx)
                                                      (^ (ml-bit dst) -1)))
                                          0)
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0)))
                  (set! i 0)
                  (loop (if (>= (load i) copies)
                            (break)
                            (do
                              (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                  (let [src (mu-copy-src (load edge) (load i))]
                                    (if (and (>= src 0) (< src vregs))
                                        (let [idx (+ base (/ src 64))]
                                          (al-set! [i64] (field u edge-live) idx
                                                   (| (al-get (.edge-live u) idx)
                                                      (ml-bit src)))
                                          0)
                                        0))
                                  0)
                              (set! i (+ (load i) 1))
                              0))))
                (set! edge (+ (load edge) 1))
                0)))
    0))

(defn ml-live-before? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))
                      dst (ms-inst-dst (+ first (load i)))]
                  (if (= dst vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0))
                (if (= (+ first (load i)) at) (break) 0))))
    (load live)))

(defn ml-live-after? [(at i64) (vreg i64)] (-> bool)
  (let [bid (ms-inst-block at)
        first (mu-block-inst-first bid)
        count (mu-block-inst-count bid)
        (mut i) count
        (mut live) (ml-live-out? bid vreg)]
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [current (+ first (load i))]
                  (if (= current at) (break) 0)
                  (if (= (ms-inst-dst current) vreg) (set! live false) 0)
                  (if (ml-inst-uses? current vreg) (set! live true) 0)))))
    (load live)))

(defn ml-safepoint? [(at i64)] (-> bool)
  (let [op (ms-inst-op at)] (or (= op MI-CALL) (= op MI-NEW))))

(defn ml-verify! [] (-> bool)
  (let [u (machine-unit)
        blocks (mu-block-count)
        edges (mu-edge-count)
        vregs (ml-vreg-count)
        s (ml-verify-scratch)
        (mut bid) 0]
    (set! (.liveness-result u) MLIVE-OK)
    (set! (.liveness-item u) -1)
    ; Re-derive use/def and the fixed-point equations without mutating the published sets.
    ; One forward operand walk per block fills the per-vreg expectations; asking every vreg
    ; about every instruction made this verifier cubic on large programs.
    (loop (if (or (>= (load bid) blocks) (!= (ml-result) MLIVE-OK))
              (break)
              (do
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut vr) 0
                      (mut i) 0]
                  (al-clear! [bool] (field s expected-use))
                  (al-clear! [bool] (field s expected-def))
                  (loop (if (>= (load vr) vregs)
                            (break)
                            (do
                              (al-push! [bool] (field s expected-use) false)
                              (al-push! [bool] (field s expected-def) false)
                              (set! vr (+ (load vr) 1))
                              0)))
                  (loop (if (>= (load i) count)
                            (break)
                            (do
                              (ml-verify-note-inst! (+ first (load i)))
                              (set! i (+ (load i) 1))
                              0)))
                  (set! vr 0)
                  (loop (if (or (>= (load vr) vregs) (!= (ml-result) MLIVE-OK))
                            (break)
                            (do
                              (let [expected-use (al-get [bool] (.expected-use s) (load vr))
                                    expected-def (al-get [bool] (.expected-def s) (load vr))
                                    (mut expected-out) false
                                    (mut k) 0]
                                (loop (if (>= (load k) (mu-block-succ-count (load bid)))
                                          (break)
                                          (do
                                            (if (ml-live-in? (mu-block-succ-target (load bid) (load k)) (load vr))
                                                (set! expected-out true)
                                                0)
                                            (set! k (+ (load k) 1))
                                            0)))
                                (let [expected-in
                                        (or expected-use
                                            (and (load expected-out) (not expected-def)))]
                                  (if (or (!= (ml-use? (load bid) (load vr)) expected-use)
                                          (or (!= (ml-def? (load bid) (load vr)) expected-def)
                                              (or (!= (ml-live-out? (load bid) (load vr)) (load expected-out))
                                                  (!= (ml-live-in? (load bid) (load vr)) expected-in))))
                                      (do
                                        (set! (.liveness-result u) MLIVE-FIXPOINT)
                                        (set! (.liveness-item u) (ml-index (load bid) (load vr))))
                                      0)))
                              (set! vr (+ (load vr) 1))
                              0))))
                (set! bid (+ (load bid) 1))
                0)))
    (if (= (ml-result) MLIVE-OK)
        (let [(mut edge) 0]
          (loop (if (or (>= (load edge) edges) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [(mut vr) 0]
                        (loop (if (>= (load vr) vregs)
                                  (break)
                                  (do
                                    (let [(mut expected) (ml-live-in? (mu-edge-target (load edge)) (load vr))
                                          (mut dst) false
                                          (mut src) false
                                          (mut i) 0]
                                      (loop (if (>= (load i) (mu-edge-copy-count (load edge)))
                                                (break)
                                                (do
                                                  (if (= (mu-copy-kind (load edge) (load i)) MCOPY-VALUE)
                                                      (do
                                                        (if (= (mu-copy-dst (load edge) (load i)) (load vr))
                                                            (set! dst true)
                                                            0)
                                                        (if (= (mu-copy-src (load edge) (load i)) (load vr))
                                                            (set! src true)
                                                            0))
                                                      0)
                                                  (set! i (+ (load i) 1))
                                                  0)))
                                      (if (load dst) (set! expected false) 0)
                                      (if (load src) (set! expected true) 0)
                                      (if (!= (ml-edge-live? (load edge) (load vr)) (load expected))
                                          (do
                                            (set! (.liveness-result u) MLIVE-PHI)
                                            (set! (.liveness-item u) (ml-edge-index (load edge) (load vr))))
                                          0))
                                    (set! vr (+ (load vr) 1))
                                    0))))
                      (set! edge (+ (load edge) 1))
                      0))))
        0)
    (if (= (ml-result) MLIVE-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (ml-result) MLIVE-OK))
                    (break)
                    (do
                      (let [dst (ms-inst-dst (load at))]
                        (if (and (>= dst 0) (!= (ml-value-kind dst) (ml-kind-for-inst (load at))))
                            (do
                              (set! (.liveness-result u) MLIVE-KIND)
                              (set! (.liveness-item u) dst))
                            0)
                        (if (and (and (>= dst 0) (= (ml-result) MLIVE-OK))
                                 (!= (ml-register-class dst) (ml-class-for-inst (load at))))
                            (do
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) dst))
                            0)
                        (if (and (= (ml-result) MLIVE-OK)
                                 (not (ml-inst-classes-valid? (load at))))
                            (do
                              (set! (.liveness-result u) MLIVE-CLASS)
                              (set! (.liveness-item u) (load at)))
                            0))
                      (set! at (+ (load at) 1))
                      0))))
        0)
    (= (ml-result) MLIVE-OK)))

(defn ml-compute! [(seed i64)] (-> bool)
  (let [u (machine-unit)]
    (set! (.liveness-seed u) seed)
    (ml-init-tables!)
    (ml-compute-use-def!)
    (ml-propagate-register-classes!)
    (if (not (ml-solve! seed))
        (do
          (set! (.liveness-result u) MLIVE-FIXPOINT)
          (set! (.liveness-item u) -1)
          false)
        (do (ml-compute-edge-live!) (ml-verify!)))))

(defn ml-corrupt-live-out! [(bid i64) (vreg i64) (live bool)] (-> i64)
  (let [u (machine-unit)
        idx (ml-word-index bid vreg)
        word (al-get (.live-out u) idx)]
    (al-set! [i64] (field u live-out) idx
             (if live (| word (ml-bit vreg)) (& word (^ (ml-bit vreg) -1)))))
  0)
(defn ml-corrupt-edge-live! [(edge i64) (vreg i64) (live bool)] (-> i64)
  (let [u (machine-unit)
        idx (ml-word-index edge vreg)
        word (al-get (.edge-live u) idx)]
    (al-set! [i64] (field u edge-live) idx
             (if live (| word (ml-bit vreg)) (& word (^ (ml-bit vreg) -1)))))
  0)
(defn ml-corrupt-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) value-kind) vreg kind)
  0)
(defn ml-corrupt-register-class! [(vreg i64) (class i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) register-class) vreg class)
  0)

(defn ml-dump-set [(w (ptr Writer)) (kind i64) (id i64)] (-> i64)
  (let [vregs (ml-vreg-count)
        (mut vr) 0
        (mut first) true]
    (ps w "{")
    (loop (if (>= (load vr) vregs)
              (break)
              (do
                (let [live
                        (case kind 0
                              (ml-use? id (load vr)) 1
                              (ml-def? id (load vr)) 2
                              (ml-live-in? id (load vr)) 3
                              (ml-live-out? id (load vr)) (ml-edge-live? id (load vr)))]
                  (if live
                      (do
                        (if (load first) 0 (ps w ","))
                        (fmt w "v{d}" (load vr))
                        (set! first false))
                      0))
                (set! vr (+ (load vr) 1))
                0)))
    (ps w "}")
    0))

(defn ml-dump [(w (ptr Writer))] (-> i64)
  (let [funcs (mu-function-count)
        (mut owner) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (fmt w "function {d}\n" (load owner))
                (let [blocks (mu-function-block-count (load owner))
                      (mut rpo) 0]
                  (loop (if (>= (load rpo) blocks)
                            (break)
                            (do
                              (let [bid (mu-function-block (load owner) (load rpo))]
                                (fmt w "  b{d} use" (load rpo))
                                (ml-dump-set w 0 bid)
                                (ps w " def")
                                (ml-dump-set w 1 bid)
                                (ps w " in")
                                (ml-dump-set w 2 bid)
                                (ps w " out")
                                (ml-dump-set w 3 bid)
                                (ps w "\n"))
                              (set! rpo (+ (load rpo) 1))
                              0))))
                (set! owner (+ (load owner) 1))
                0)))
    (let [edges (mu-edge-count)
          (mut edge) 0]
      (loop (if (>= (load edge) edges)
                (break)
                (do
                  (fmt w
                       "edge {d} {d}->{d} live"
                       (load edge)
                       (mu-edge-source (load edge))
                       (mu-edge-target (load edge)))
                  (ml-dump-set w 4 (load edge))
                  (ps w "\n")
                  (set! edge (+ (load edge) 1))
                  0))))
    0))

(defn ml-render [(buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ml-dump w)
    (let [n (.len fb)]
      (if (>= n cap) (do (panic-corrupt "ml-render: buffer too small") 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))
