;; JSL lowering: a checked declaration becomes an ideal graph, built through node.coil's ordinary
;; builders. There is no JSL-specific node, no JSL-specific op and no JSL-specific arm anywhere
;; downstream — that is the entire point. `eval.coil` runs what comes out of here because it is
;; the same graph the frontend produces, and `backend_select.coil` compiles it for the same reason.
;;
;; THE CHECKER HAS ALREADY RUN, so this file is entitled to assume the shape it walks is legal and
;; PANICS when it is not. That division is what makes `jsl.coil` worth having: a lowering that
;; quietly emits a plausible node for an unrecognised form is how a format bug becomes a miscompile
;; hunt three passes later. Every `panic-corrupt` here means the checker let something through, and
;; is a bug in the checker rather than in the input.
;;
;; THE MERGE PROTOCOL IS THE ONE THING THAT IS EASY TO GET WRONG, and it is corpus.coil's, verbatim.
;; A two-armed Region with no Phi yet is a degenerate diamond and collapses on sight, so the Region
;; and the Phi are built UNPEEPHOLED and pushed to the worklist together. The arms and the arm-exit
;; controls are `n-keep!`-ed across the other arm's lowering for the reason `n-if-arms!` documents
;; at length: a node held only in a local can be collected by a cascade, and the caller then wires
;; a live Return to a dead node.
;;
;; A DECLARED PARAMETER TYPE IS NOT INJECTED ONTO ITS `OPTAG-PARM`. Under D1 an annotation is a
;; contract to discharge and under D8 a rewrite may only act on a PROVEN type, so handing the
;; optimiser an unproven claim it is entitled to act on is precisely the failure D8 exists to
;; prevent. Parameter types stay on the declaration; closed-world inference computes the real ones.
(module jsl_lower)
(import "coil.primitive" :as primitive)

(import "coil.alloc"     :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice"     :use *)
(import "coil.str"       :use *)
(import "coil.control"   :use *)
(import "coil.reader"    :as rd)
(import "jsl"  :use *)
(import "jsstring" :use *)
(import "ty"   :use *)
(import "node" :use *)
(import "shape" :use *)

; ============================================================================
; Lowering state
; ============================================================================
(defstruct JslBind [(name (slice u8)) (node i64)])

;; `ctrl` doubles as the divergence flag: NO-NODE means the path taken to here ended in a `goto`,
;; so there is no control to hang anything off and nothing further on this path may be built. Every
;; construct that merges control has to ask, which is what makes a bail-out a real early exit rather
;; than a value that happens to be ignored.
(const JL-DIVERGED i64 -1)

;; One active `loop`. TWO bases, not one: `base` is where this loop's controls start in `rctrl`, and
;; `vbase` is where its values start in `rvals`. They cannot be derived from each other, because
;; `rvals` holds `nbind` entries per recur and a nested loop may have a different `nbind` — deriving
;; the value offset as `control-index * nbind` silently reads another loop's values the moment two
;; loops disagree about their arity.
(defstruct JslLoop [(nbind i64) (base i64) (vbase i64) (memphi i64)])
(defstruct JslAbrupt [(ctrl i64) (dependency i64) (mem i64)])

(defstruct JslLower
  [(binds  (ArrayList JslBind))
   (exits  (ArrayList i64))   ; control nodes waiting at a label, innermost expansion last
   (loops  (ArrayList JslLoop))
   (rctrl  (ArrayList i64))   ; one control per `recur` reached
   (rvals  (ArrayList i64))   ; nbind values per `recur`, in the same order
   (rmem   (ArrayList i64))   ; and the heap each `recur` left, one per recur
   (callback-calls (ArrayList i64)) ; dynamic JS calls emitted by callback macros
   (abrupts (ArrayList JslAbrupt)) ; exceptional exits captured while inlining into frontend CFG
   (collect-abrupts bool)
   (ctrl   i64)               ; the control the next effectful form hangs off, or JL-DIVERGED
   (mem    i64)               ; the current JS property memory, or NO-NODE before it is needed
   (outer  i64)               ; the CALLER's other memory (cells, closure environments), or NO-NODE
   (anchor i64)               ; Start/FunStart of the CFG owner receiving newly rooted constants
   (frame  i64)               ; lookup floor: a macro body cannot see its caller's bindings
   (decl   i64)               ; which declaration is being lowered, for diagnostics
   (fun    i64)               ; its OPTAG-FUN
   (frontend-targets i64)
   (frontend-targets-valid bool)
   (profile-target-calls i64)
   (profile-target-scans i64)
   (profile-jsl-scans i64)
   (profile-max-calls i64)
   (profile-max-scans i64)
   (profile-param-scans i64)
   (profile-lower-ns i64)
   (profile-lower-calls i64)
   (profile-lower-nodes i64)
   (identity-unit i64)
   (identity-valid bool)
   (inited bool)])

(defn jl [] (-> (ptr JslLower))
  (let [p (primitive/alloc-static JslLower)]
    (if (.inited p) 0
      (do (set! (.inited p) true)
          (set! (.binds p) (al-new [JslBind] (malloc-allocator)))
          (set! (.exits p) (al-new [i64] (malloc-allocator)))
          (set! (.loops p) (al-new [JslLoop] (malloc-allocator)))
          (set! (.rctrl p) (al-new [i64] (malloc-allocator)))
          (set! (.rvals p) (al-new [i64] (malloc-allocator)))
          (set! (.rmem p) (al-new [i64] (malloc-allocator)))
          (set! (.callback-calls p) (al-new [i64] (malloc-allocator)))
          (set! (.abrupts p) (al-new [JslAbrupt] (malloc-allocator)))
          (set! (.collect-abrupts p) false)
          (set! (.ctrl p) NO-NODE)
          (set! (.mem p) NO-NODE)
          (set! (.outer p) NO-NODE)
          (set! (.anchor p) NO-NODE)
          (set! (.frame p) 0)
          (set! (.decl p) -1)
          (set! (.fun p) NO-NODE)
          (set! (.frontend-targets p) 0)
          (set! (.frontend-targets-valid p) false)
          (set! (.profile-target-calls p) 0)
          (set! (.profile-target-scans p) 0)
          (set! (.profile-jsl-scans p) 0)
          (set! (.profile-max-calls p) 0)
          (set! (.profile-max-scans p) 0)
          (set! (.profile-param-scans p) 0)
          (set! (.profile-lower-ns p) 0)
          (set! (.profile-lower-calls p) 0)
          (set! (.profile-lower-nodes p) 0)
          (set! (.identity-unit p) 0)
          (set! (.identity-valid p) false)
          0))
    p))

;; EVERY BINDING IS PINNED, SO EVERY WAY OF DROPPING ONE MUST UNPIN. `jl-drop!` is the ordinary
;; path; these two clear the whole table at once -- `jl-reset!` between units and
;; `jl-lower-decl!` between declarations -- and a pin left behind there survives into the next
;; unit, where the node it protects can never be collected and `g-verify` reports a leak. That
;; failure does not reproduce on the program that caused it, only on whatever runs after it, which
;; is the worst way to find out.
;;
;; Guarded on `n-keeps` because a reset may follow a graph reset, and unpinning something that was
;; never pinned is itself an abort.
(defn jl-unpin-binds! [] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (jl-depth))
              (break)
              (do (let [n (.node (jl-bind-p (load i)))]
                    (if (and (!= n NO-NODE)
                             (and (>= n 0) (and (< n (n-count)) (> (n-keeps n) 0))))
                        (n-unkeep! n)
                        0))
                  (set! i (+ (load i) 1))
                  0)))
    0))

(defn jl-reset! [] (-> i64)
  (let [p (jl)]
    ;; NO UNPIN HERE, and that is the whole difference between the two clear sites. `jl-reset!` runs
    ;; immediately after `graph-reset!`, so every node id in this table belongs to a graph that no
    ;; longer exists; "releasing" them would decrement `keeps` on whatever unrelated node now
    ;; occupies those ids in the fresh graph. The pins die with the arena.
    ;;
    ;; `jl-lower-decl!` is the opposite case -- same graph, still live -- and unpins for real.
    (al-clear! [JslBind] (field p binds))
    (al-clear! [i64] (field p exits))
    (al-clear! [JslLoop] (field p loops))
    (al-clear! [i64] (field p rctrl))
    (al-clear! [i64] (field p rvals))
    (al-clear! [i64] (field p rmem))
    (al-clear! [i64] (field p callback-calls))
    (al-clear! [JslAbrupt] (field p abrupts))
    (set! (.collect-abrupts p) false)
    (set! (.ctrl p) NO-NODE)
    (set! (.mem p) NO-NODE)
    (set! (.outer p) NO-NODE)
    (set! (.anchor p) NO-NODE)
    (set! (.frame p) 0)
    (set! (.decl p) -1)
    (set! (.fun p) NO-NODE)
    (set! (.frontend-targets p) 0)
    (set! (.frontend-targets-valid p) false)
    (set! (.profile-target-calls p) 0)
    (set! (.profile-target-scans p) 0)
    (set! (.profile-jsl-scans p) 0)
    (set! (.profile-max-calls p) 0)
    (set! (.profile-max-scans p) 0)
    (set! (.profile-param-scans p) 0)
    (set! (.profile-lower-ns p) 0)
    (set! (.profile-lower-calls p) 0)
    (set! (.profile-lower-nodes p) 0)
    (set! (.identity-unit p) 0)
    (set! (.identity-valid p) false)
    0))

(defn jl-identity-hash-slice! [(hash (ptr i64)) (tag i64) (text (slice u8))] (-> i64)
  (set! hash (hash-step (load hash) tag))
  (set! hash (hash-step (load hash) (slice-len text)))
  (let [(mut index) 0]
    (loop (if (>= (load index) (slice-len text)) (break)
              (do
                (set! hash (hash-step (load hash)
                                      (cast i64 (load (index (slice-data text) (load index))))))
                (set! index (+ (load index) 1))))))
  0)

;; Hash the checked reader tree, including exact IEEE bits for floating literals. Macros are part
;; of the same library fingerprint because their bodies are inlined into otherwise unchanged
;; declarations. Ordered child hashing distinguishes lists/vectors and preserves tree shape.
(defn jl-identity-hash-sexp! [(x (ptr rd/Sexp)) (hash (ptr i64))] (-> i64)
  (match (load (field x kind))
    (rd/KInt [v] (set! hash (hash-step (hash-step (load hash) 1) v)))
    (rd/KFloat [bits] (set! hash (hash-step (hash-step (load hash) 2) bits)))
    (rd/KSym [s] (jl-identity-hash-slice! hash 3 s))
    (rd/KKw [s] (jl-identity-hash-slice! hash 4 s))
    (rd/KStr [s] (jl-identity-hash-slice! hash 5 s))
    (rd/KCStr [s] (jl-identity-hash-slice! hash 6 s))
    (rd/KList [items]
      (let [(mut index) 0]
        (set! hash (hash-step (hash-step (load hash) 7) (rd/sexp-count x)))
        (loop (if (>= (load index) (rd/sexp-count x)) (break)
                  (do (jl-identity-hash-sexp! (rd/sexp-nth x (load index)) hash)
                      (set! index (+ (load index) 1)))))))
    (rd/KVec [items]
      (let [(mut index) 0]
        (set! hash (hash-step (hash-step (load hash) 8) (rd/sexp-count x)))
        (loop (if (>= (load index) (rd/sexp-count x)) (break)
                  (do (jl-identity-hash-sexp! (rd/sexp-nth x (load index)) hash)
                      (set! index (+ (load index) 1)))))))
    (rd/KView [items off len]
      (let [(mut index) 0]
        (set! hash (hash-step (hash-step (load hash) 9) (rd/sexp-count x)))
        (loop (if (>= (load index) (rd/sexp-count x)) (break)
                  (do (jl-identity-hash-sexp! (rd/sexp-nth x (load index)) hash)
                      (set! index (+ (load index) 1))))))))
  0)

(defn jl-library-identity-unit [] (-> i64)
  (let [lower (jl)]
    (if (.identity-valid lower) (.identity-unit lower)
        (let [(mut hash) 1469598103934665603 (mut decl) 0]
          (set! hash (hash-step (load hash) (jsl-decl-count)))
          (loop (if (>= (load decl) (jsl-decl-count)) (break)
                    (do
                      (jl-identity-hash-slice! (mut hash) 10 (jsl-decl-name (load decl)))
                      (jl-identity-hash-slice! (mut hash) 11 (jsl-decl-label (load decl)))
                      (set! hash (hash-step (load hash) (jsl-decl-kind (load decl))))
                      (set! hash (hash-step (load hash) (jsl-decl-ret (load decl))))
                      (set! hash (hash-step (load hash) (jsl-decl-nparams (load decl))))
                      (set! hash (hash-step (load hash) (jsl-decl-ncaptures (load decl))))
                      (set! hash (hash-step (load hash)
                                            (if (jsl-decl-transitioning? (load decl)) 1 0)))
                      (let [(mut parameter) 0]
                        (loop (if (>= (load parameter) (jsl-decl-nparams (load decl))) (break)
                                  (do
                                    (jl-identity-hash-slice!
                                      (mut hash) 12
                                      (jsl-param-name (load decl) (load parameter)))
                                    (set! hash
                                          (hash-step (load hash)
                                                     (jsl-param-ty (load decl) (load parameter))))
                                    (set! parameter (+ (load parameter) 1))))))
                      (let [(mut capture) 0]
                        (loop (if (>= (load capture) (jsl-decl-ncaptures (load decl))) (break)
                                  (do
                                    (jl-identity-hash-slice!
                                      (mut hash) 13
                                      (jsl-capture-name (load decl) (load capture)))
                                    (set! capture (+ (load capture) 1))))))
                      (jl-identity-hash-sexp! (jsl-decl-body (load decl)) (mut hash))
                      (set! decl (+ (load decl) 1)))))
          (set! (.identity-unit lower) (load hash))
          (set! (.identity-valid lower) true)
          (load hash)))))

(defn jl-open-function! [(d i64)] (-> i64)
  (let [fun (n-fun-open-identity! (jsl-decl-fidx d) FUN-IDENTITY-JSL
                                  (jl-library-identity-unit) d)
        callable (jsl-callable? d)
        (mut types) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (if callable
        (do (al-push! [i64] (mut types) (t-dyn))
            (al-push! [i64] (mut types) (t-dyn))
            (al-push! [i64] (mut types) (t-int)))
        0)
    (loop (if (>= (load index) (jsl-decl-nparams d)) (break)
              (do (al-push! [i64] (mut types) (jsl-param-ty d (load index)))
                  (set! index (+ (load index) 1)))))
    (n-fun-declare-abi! fun (al-slice [i64] (load types))
                        (let [ret (jsl-decl-ret d)] (if (= ret TY-NO-ID) (t-dyn) ret)))
    (al-free! [i64] (mut types))
    fun))

(defn jl-profile-target-calls [] (-> i64) (.profile-target-calls (jl)))
(defn jl-profile-target-scans [] (-> i64) (.profile-target-scans (jl)))
(defn jl-profile-jsl-scans [] (-> i64) (.profile-jsl-scans (jl)))
(defn jl-profile-max-calls [] (-> i64) (.profile-max-calls (jl)))
(defn jl-profile-max-scans [] (-> i64) (.profile-max-scans (jl)))
(defn jl-profile-param-scans [] (-> i64) (.profile-param-scans (jl)))
(defn jl-profile-lower-ns [] (-> i64) (.profile-lower-ns (jl)))
(defn jl-profile-lower-calls [] (-> i64) (.profile-lower-calls (jl)))
(defn jl-profile-lower-nodes [] (-> i64) (.profile-lower-nodes (jl)))

(defn jl-ctrl [] (-> i64) (.ctrl (jl)))
(defn jl-set-ctrl! [(n i64)] (-> i64) (set! (.ctrl (jl)) n) 0)
(defn jl-diverged? [] (-> bool) (= (jl-ctrl) JL-DIVERGED))
(defn jl-collect-abrupts? [] (-> bool) (.collect-abrupts (jl)))
(defn jl-set-collect-abrupts! [(enabled bool)] (-> i64)
  (set! (.collect-abrupts (jl)) enabled)
  0)

;; THE HEAP THIS DEFINITION WAS GIVEN. A heap-using builtin's call has an implicit trailing memory
;; argument. The callee sees that effect as its function-entry `OPTAG-ARG`, and its caller takes the
;; returned effect from a CallEnd-rooted `OPTAG-ARG`. Memory therefore crosses the call without being
;; exposed as a source parameter. The IR already reserves this convention: `v-need-call-args`
;; permits the LAST argument of a call to be a memory producer.
;;
;; `jl-lower-decl!` binds this for any declaration the checker found reads the heap; a macro
;; inlined into such a declaration inherits it, which is why the fixpoint propagates memory use
;; through calls rather than reading each body in isolation.
;; THE CALLER'S OTHER MEMORY, and the whole reason it has to be here. `jl-mem` is the JavaScript
;; PROPERTY heap, which is every state a `.jsl` definition can name -- and a callback is USER code,
;; which writes states this library cannot name: a captured variable's cell, a closure
;; environment's fields. Those live on their own aliases, and the callback `Call` carried no edge
;; to any of them, so the caller's stores into them had no consumer and were deleted as dead.
;;
;;   let b = 2; [3, 4].map(v => (v + b) | 0)          the environment slot was never written, and
;;                                                    the callee dereferenced it -- SIGSEGV
;;   let acc = 0; [3, 4].forEach(v => { acc += v; })  the cell store died the same way, and the
;;                                                    read after the loop saw the initial value
;;
;; `fng-jsl-call` sets this around any definition `jsl-decl-calls-back?` is true for, and clears it
;; afterwards; NO-NODE everywhere else, which is every definition that takes no callback.
(defn jl-outer-mem [] (-> i64) (.outer (jl)))
(defn jl-set-outer-mem! [(m i64)] (-> i64) (set! (.outer (jl)) m) 0)

;; The memory a callback call publishes: the property heap this definition threads, merged with the
;; caller's other state when there is any. ONE trailing argument, because `v-need-call-args` permits
;; exactly one memory producer and it must be last.
(defn jl-call-mem [] (-> i64)
  (let [m (jl-mem) o (jl-outer-mem)]
    (if (= o NO-NODE) m (n-memmerge2! m o))))
(defn jl-set-mem! [(m i64)] (-> i64) (set! (.mem (jl)) m) 0)
(defn jl-mem-raw [] (-> i64) (.mem (jl)))

(defn jl-mem [] (-> i64)
  (let [p (jl)]
    (if (!= (.mem p) NO-NODE) 0
        (set! (.mem p)
              (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef)))
                      (n-fun-entry (.fun p)))))
    (.mem p)))

(defn jl-frame [] (-> i64) (.frame (jl)))
(defn jl-set-frame! [(n i64)] (-> i64) (set! (.frame (jl)) n) 0)

(defn jl-exit-count [] (-> i64) (al-len [i64] (.exits (jl))))
(defn jl-exit [(i i64)] (-> i64) (al-get (.exits (jl)) i))
(defn jl-exit-push! [(n i64)] (-> i64) (al-push! [i64] (field (jl) exits) n))
(defn jl-exit-drop! [(depth i64)] (-> i64)
  (loop (if (<= (jl-exit-count) depth) (break)
          (do (al-pop! [i64] (field (jl) exits)) 0)))
  0)

(defn jl-abrupt-count [] (-> i64) (al-len [JslAbrupt] (.abrupts (jl))))
(defn jl-abrupt-p [(i i64)] (-> (ptr JslAbrupt))
  (al-elem [JslAbrupt] (field (jl) abrupts) i))
(defn jl-abrupt-ctrl [(i i64)] (-> i64) (.ctrl (jl-abrupt-p i)))
(defn jl-abrupt-dependency [(i i64)] (-> i64) (.dependency (jl-abrupt-p i)))
(defn jl-abrupt-mem [(i i64)] (-> i64) (.mem (jl-abrupt-p i)))
(defn jl-abrupt-drop! [(depth i64)] (-> i64)
  (loop (if (<= (jl-abrupt-count) depth) (break)
          (do (al-pop! [JslAbrupt] (field (jl) abrupts)) 0)))
  0)

(defn jl-capture-abrupt! [(ctrl i64) (dependency i64)] (-> i64)
  (let [(mut abrupt) (zeroed JslAbrupt)]
    (set! (.ctrl (mut abrupt)) ctrl)
    (set! (.dependency (mut abrupt)) dependency)
    ;; Capture the whole caller-visible heap at THIS control point. Reconstructing non-property
    ;; aliases later, after the macro's normal path has finished lowering, makes values created on
    ;; that later path dependencies of this earlier exception edge.
    (set! (.mem (mut abrupt)) (jl-call-mem))
    (al-push! [JslAbrupt] (field (jl) abrupts) (load abrupt))))

(defn jl-check-pending! [(dependency i64)] (-> i64)
  (if (not (.collect-abrupts (jl))) 0
    (let [tagged-condition
            (n-peephole
              (n-new3 (JsBuiltin 101) (jl-ctrl) dependency (jl-const (t-int-con 0))))
          ;; Descriptor 101 returns the ordinary tagged JavaScript boolean ABI. `If` consumes a
          ;; machine boolean; tagged false is itself nonzero and therefore cannot be used as the
          ;; predicate directly. This is the same transport boundary as
          ;; `fng-check-pending-exception!`.
          condition (n-unbox! tagged-condition (t-bool))
          arms (n-if-arms! (n-peephole (n-new2 (If) (jl-ctrl) condition)))]
      (jl-capture-abrupt! (arms-t arms) condition)
      (jl-set-ctrl! (arms-f arms))
      0)))

(defn jl-loop-depth [] (-> i64) (al-len [JslLoop] (.loops (jl))))
(defn jl-loop-p [(i i64)] (-> (ptr JslLoop)) (al-elem [JslLoop] (field (jl) loops) i))
(defn jl-rctrl-count [] (-> i64) (al-len [i64] (.rctrl (jl))))
(defn jl-rvals-count [] (-> i64) (al-len [i64] (.rvals (jl))))

;; `al-elem` gives a pointer to the live binding, so the by-value accessors these used to need are
;; gone. jsl.coil's `jsl-decl-p` carries the invalidation contract in full; the short version is
;; that this pointer must not outlive the expression that dereferences it.
(defn jl-bind-p [(i i64)] (-> (ptr JslBind)) (al-elem [JslBind] (field (jl) binds) i))

(defn jl-depth [] (-> i64) (al-len [JslBind] (.binds (jl))))

;; A BINDING IS PINNED FOR ITS WHOLE SCOPE, and that is not defensive.
;;
;; A `let` value can lose every user it currently has while its LATER uses have not been built yet
;; -- `(let ((a …)) (if (IsNumber a) … (NumLt a b)))` is exactly that: folding `IsNumber a` to a
;; constant collects the TypeTest, the cascade takes `a` with it, and `NumLt` is then built on a
;; corpse. `n-add-def!: input is dead`, surfacing later as a spray of `VERR-DEAD-INPUT`.
;;
;; Having users is not evidence a value is still needed; being IN SCOPE is. `jl-drop!` unpins at
;; scope exit and collects there, which is the point where "nothing used it" is finally true.
;;
;; Dormant until DSL guards began folding against typed operands: before that a `%IsInt` on a boxed
;; argument never proved, so a binding never lost its last user mid-scope. See
;; docs/DSL-OWNERSHIP.md.
(defn jl-bind! [(name (slice u8)) (node i64)] (-> i64)
  (let [(mut b) (zeroed JslBind)]
    (set! (.name b) name)
    (set! (.node b) node)
    (jl-keep! node)
    (al-push! [JslBind] (field (jl) binds) (load b))))

;; NO-NODE IS -1 AND EVERY NODE ACCESSOR INDEXES AN ARENA, so pinning "the value of a path that
;; diverged" is an out-of-bounds write, not a no-op. A `goto` makes exactly that value NO-NODE, and
;; the diamond builder pins both arms' values before merging them, so these guards are the
;; difference between a bail-out and a segfault.
(defn jl-keep! [(n i64)] (-> i64) (if (= n NO-NODE) 0 (n-keep! n)))
(defn jl-unkeep! [(n i64)] (-> i64) (if (= n NO-NODE) 0 (n-unkeep! n)))

;; Collect a binding whose value nothing used. A `let` binding is an ordinary SSA value, so an
;; unused one is dead code — but nothing else will notice: it has no users to cascade from and no
;; Return to reach it, so `g-verify` reports VERR-LEAK and the graph is malformed rather than merely
;; wasteful. `n-kill!` cascades into its inputs, which is what makes the whole dead expression go.
(defn jl-collect! [(n i64)] (-> i64)
  (if (= n NO-NODE) 0
    (if (n-dead? n) 0
      (if (and (= (n-nouts n) 0) (= (n-keeps n) 0)) (n-kill! n) 0))))

;; Pop bindings back to a depth, collecting any whose value went unused.
;;
;; THE CALLER MUST PIN ITS RESULT ACROSS THIS. `(let ((y (%Add x 1))) y)` returns the Add, which at
;; this moment has no users at all — the Return that will consume it does not exist yet — so an
;; unpinned result is indistinguishable from an unused binding and gets collected.
(defn jl-drop! [(depth i64)] (-> i64)
  (loop (if (<= (jl-depth) depth) (break)
          ; READ THE NODE BEFORE POPPING. Not defensive: `al-pop!` only decrements the length, so
          ; reading after it returns the CORRECT node — and would go on doing so until an unrelated
          ; `al-push!` reused that slot, at which point this silently collects a different binding.
          ; The wrong order passes every test today and breaks on an unrelated change later.
          (let [n (.node (jl-bind-p (- (jl-depth) 1)))]
            (al-pop! [JslBind] (field (jl) binds))
            ;; Unpin before collecting: the pin is what kept it alive through the scope, and
            ;; `jl-collect!` only kills a value with no users AND no pins.
            (jl-unkeep! n)
            (jl-collect! n)
            0)))
  0)

;; The innermost binding of a name, or NO-NODE. Searched from the TOP down so an inner `let`
;; shadows an outer one; the checker has already established that the name is bound at all.
;;
;; THE SEARCH STOPS AT THE FRAME, and that is what makes a macro lexically scoped. A macro body is
;; lowered in the caller's lowering state, so without a floor it would see the caller's `let`
;; bindings — dynamic scoping, and worse, dynamic scoping that only misbehaves when a caller
;; happens to have picked one of the macro's own names.
(defn jl-lookup [(name (slice u8))] (-> i64)
  (let [(mut i) (jl-depth) (mut found) NO-NODE]
    (loop (if (or (<= (load i) (jl-frame)) (!= (load found) NO-NODE))
              (break)
              (do
                (set! i (- (load i) 1))
                (let [b (jl-bind-p (load i))]
                  (if (= name (.name b)) (set! found (.node b)) 0))
                0)))
    (load found)))

; ============================================================================
; Leaves
; ============================================================================
(defn jl-const [(t i64)] (-> i64)
  (n-peephole (n-new1 (Const t) (.anchor (jl)))))

;; A bare symbol: a literal, or a binding. Parameters are bindings too — `jl-lower-decl!` creates
;; one `OPTAG-PARM` per parameter at entry and binds it by name.
;;
;; ONE PARM NODE PER PARAMETER, NOT ONE PER REFERENCE. `op-gvn?` excludes Parm, so `n-parm!` called
;; twice for the same index yields two live `Parm.0` nodes. Nothing about that graph looks wrong
;; locally, and the type analysis is perfectly happy with it; what notices is `VERR-CALL-ARITY`,
;; several nodes away, because the verifier reads a function's arity off its Parm nodes and a
;; one-parameter builtin referencing its argument twice then appears to take two. That is why the
;; binding environment owns parameters instead of this function minting them on demand.
(defn jl-symbol [(s (slice u8))] (-> i64)
  (let [lit (jsl-literal-ty s)]
    (if (!= lit TY-NO-ID) (jl-const lit)
      (let [b (jl-lookup s)]
        (if (!= b NO-NODE) b
          (do (panic-corrupt s)
              (panic-corrupt "jsl lowering: unbound symbol reached lowering; the checker should have refused it")
              NO-NODE))))))

; ============================================================================
; The expression walk
; ============================================================================
;; A primitive node. Slot 0 of every one of these ops is the ordinary control anchor and stays
;; null: a value op is ordered by its data edges and by nothing else, which is what lets the
;; optimiser float it. Arity came from `jsp-arity` and was checked, so an unhandled width here is
;; a table that grew a row without growing this dispatch.
;; An unbox is CHECKED: `MI-JSUNBOX` traps on a tag mismatch. `OPTAG-UNBOX` has a null control anchor,
;; so it floats and the scheduler may place it where the guard that establishes the tag has not run
;; — measured as a `brk` in `MathMin2` while the structurally identical `MathMax2` happened to be
;; scheduled safely.
;;
;; D4's pattern is the fix: a guard is `If(TypeTest(v, T))` followed by a `Cast(T)` ON THE TAKEN
;; EDGE, and `OPTAG-CAST` takes a real control input. Narrowing through the Cast pins the claim to the
;; guarded edge, after which the Unbox is floating over a value whose type is already proven and
;; cannot trap.
(defn jl-unbox [(target i64) (v i64)] (-> i64)
  (n-peephole (n-new2 (Unbox target) NO-NODE
                      (n-peephole (n-new2 (Cast target) (jl-ctrl) v)))))

;; Named-property IR stores the interned property-name id in AUX, not as a data input. The JSL
;; surface therefore accepts a key operand so frontend call sites remain ordinary macro calls, but
;; that operand must be a compile-time integer constant. This is deliberately a separate primitive
;; from the eventual dynamic `PropertyKey` operation: silently accepting a runtime key here would
;; bake whatever happened to be in a non-Const node's aux word into the graph.
(defn jl-static-property-key [(key i64)] (-> i64)
  (if (and (op-is? key Const [_])
           (and (ty-int-only? (n-const-type key)) (ty-const? (n-const-type key))))
      (ty-int-lo (n-const-type key))
      (if (op-is? key StringConst [_])
          (let [(mut bytes) (al-new [u8] (malloc-allocator))
                text (jss-utf8! (n-stringconst-id key) (mut bytes))
                name (shape-name-intern! text)]
            ;; The spelling moves into the property's aux field; the temporary StringConst is not
            ;; a runtime operand and would otherwise be an unreachable graph leaf.
            (n-kill! key)
            (al-free! [u8] (mut bytes))
            name)
          (do (panic-corrupt
                "jsl lowering: a named-property key must be an interned id or string literal")
              0))))

(defn jl-prim [(id i64) (a i64) (b i64) (c i64)] (-> i64)
  ;; A throw is not a floating value. Its payload participates in expression joins so the existing
  ;; exception ABI can propagate it, but the operation itself must remain in the branch that chose
  ;; it; otherwise scheduling can hoist an untaken error path and throw unconditionally.
  (if (= id JSP-THROW)
      (let [raised (n-peephole (n-new2 (JsThrow) (jl-ctrl) a))]
        (if (.collect-abrupts (jl))
            (do (jl-capture-abrupt! (jl-ctrl) raised)
                (jl-set-ctrl! JL-DIVERGED)
                0)
            0)
        raised)
  ;; THE STRING ATOMS ARE CONTROL-PINNED, for the reason a `New` is. `%StringNew` creates an
  ;; identity and `%StringSetUnit` mutates one, so neither may float: the evaluator executes a
  ;; control-pinned node once per arrival at its block and caches the result, while a floating
  ;; value node is recomputed at every demand — which for these two means allocating a second
  ;; string, or writing the same unit twice. (Data dependence alone orders the writes with respect
  ;; to EACH OTHER; it does not say how often one of them runs.)
  (if (= id JSP-STRINGNEW)
      (n-peephole (n-new2 (StringAlloc) (jl-ctrl) a))
  (if (= id JSP-STRINGSETUNIT)
      (n-peephole (n-new4 (StringSetUnit) (jl-ctrl) a b c))
  ;; NO `Cast` IN FRONT. `jl-unbox` asserts the target type, and an int-tagged number does not
  ;; satisfy `Cast flt` even though the unbox beneath converts it correctly. For the numeric case
  ;; the unbox IS the conversion, which is why the frontend's own `fng-to-number-operand` is a bare
  ;; `n-unbox!`. See docs/DSL-OWNERSHIP.md.
  (if (= id JSP-UNBOXNUMBER)
      (n-peephole (n-new2 (Unbox (jsp-aux id)) NO-NODE a))
  (if (or (= id JSP-UNBOXINT)
          (or (= id JSP-UNBOXFLT)
              (or (= id JSP-UNBOXOBJ) (= id JSP-UNBOXSTRING))))
      (jl-unbox (jsp-aux id) a)
   ;; `OPTAG-JSBUILTIN` always carries two operands. Unary descriptors ignore the duplicate second
   ;; operand; the zero-argument random descriptor ignores both explicit zero placeholders.
   (if (op-value-is? (jsp-op id) JsBuiltin [_])
       (let [arity (jsp-arity id)
             zero (if (= arity 0) (jl-const (t-int-con 0)) NO-NODE)
             first (if (= arity 0) zero a)
             second (if (= arity 2) b first)]
         (n-peephole (n-new3 (JsBuiltin (jsp-aux id)) NO-NODE first second)))
   (if (jsp-touches-memory? id) (jl-prim-mem id a b c)
    (let [op (jsp-op id)
          n (jsp-arity id)]
      (if (= id JSP-BOXARRAY) (n-box-array! a)
      (if (= n 1) (n-peephole (n-new2 op NO-NODE a))
        (if (= n 2) (n-peephole (n-new3 op NO-NODE a b))
          (if (= n 3) (n-peephole (n-new4 op NO-NODE a b c))
            (do (panic-corrupt "jsl lowering: a primitive arity this dispatch does not build")
                NO-NODE))))))))))))))

;; A heap-reading primitive. The memory operand is supplied here rather than written in the `.jsl`
;; source, so `%ArrayLoad a i` in the library becomes `ArrayLoad(mem, a, i)` in the graph and the
;; author never sees the memory edge.
(defn jl-prim-mem [(id i64) (a i64) (b i64) (c i64)] (-> i64)
  (let [op (jsp-op id)]
;; THE `-at!` VARIANTS, which anchor the read to the current control. A heap read built with a null
    ;; control anchor floats, ordered by its memory edge alone — which is right for a straight-line
    ;; body and wrong the moment the memory it reads is LOOP-CARRIED. `(%ArrayLen a)` after a loop
    ;; that never ran answered 1 instead of 0, because a floating read of a header Phi has no block
    ;; to say which trip it belongs to. Anchoring pins it to the block it was written in.
    (if (op-value-is? op ArrayLen []) (n-array-length-at! (jl-ctrl) (jl-mem) a)
      (if (op-value-is? op OwnKeyCount []) (n-own-key-count-at! (jl-ctrl) (jl-mem) a)
      (if (op-value-is? op OwnKeyAt []) (n-own-key-at-at! (jl-ctrl) (jl-mem) a b)
      (if (op-value-is? op ArrayLoad [_]) (n-array-load-at! (jl-ctrl) (jl-mem) a b)
        (if (op-value-is? op ProtoHas []) (n-prototype-has-at! (jl-ctrl) (jl-mem) a b)
        (if (op-value-is? op SetProto [])
            (do (jl-set-mem! (n-set-prototype-at! (jl-ctrl) (jl-mem) a b))
                (jl-const (t-undef)))
        (if (op-value-is? op ObjectFreeze [])
            (do (jl-set-mem! (n-object-freeze-at! (jl-ctrl) (jl-mem) a))
                (jl-const (t-undef)))
        (if (= id JSP-INTERNALINIT)
            (do (jl-set-mem! (n-internal-init-at! (jl-ctrl) (jl-mem) a b c))
                (jl-const (t-undef)))
        (if (= id JSP-INTERNALSETINDEX)
            (do (jl-set-mem! (n-internal-set-index-at! (jl-ctrl) (jl-mem) a b))
                (jl-const (t-undef)))
        (if (or (= id JSP-INTERNALTARGET)
                (or (= id JSP-INTERNALINDEX) (= id JSP-INTERNALKIND)))
            (n-internal-load-at! (jl-ctrl) (jl-mem) a (jsp-aux id))
        (if (op-value-is? op PropLoadKey [_])
            (if (= id JSP-OWNPROPERTYATTRS)
                (n-own-property-attributes-at! (jl-ctrl) (jl-mem) a b)
                (if (or (= id JSP-PROPERTYGETTER)
                        (or (= id JSP-PROPERTYSETTER) (= id JSP-PROPERTYATTRS)))
                    (n-property-component-at! (jl-ctrl) (jl-mem) a b (jsp-aux id))
                    (n-prop-load-key-at! (jl-ctrl) (jl-mem) a b)))
        (if (op-value-is? op PropHasKey [])
            (n-prop-has-key-at! (jl-ctrl) (jl-mem) a b)
        (if (op-value-is? op PropDeleteKey [])
            (do (jl-set-mem! (n-prop-delete-key-at! (jl-ctrl) (jl-mem) a b))
                (jl-const (t-undef)))
        (if (op-value-is? op PropStoreKey [_])
            (do (jl-set-mem! (if (= id JSP-SETPROPERTYATTRS)
                                 (n-set-property-attributes-at! (jl-ctrl) (jl-mem) a b c)
                                 (if (or (= id JSP-DEFINEPROPERTYVALUE)
                                         (or (= id JSP-DEFINEPROPERTYGETTER)
                                             (= id JSP-DEFINEPROPERTYSETTER)))
                                     (n-define-property-component-at! (jl-ctrl) (jl-mem) a b c
                                                                      (jsp-aux id))
                                     (n-prop-store-key-at! (jl-ctrl) (jl-mem) a b c))))
                (jl-const (t-undef)))
        (if (op-value-is? op PropLoad [_])
            (n-peephole (n-new3 (PropLoad (jl-static-property-key b))
                                (jl-ctrl) (jl-mem) a))
        (if (op-value-is? op PropHas [_])
            (n-peephole (n-new3 (PropHas (jl-static-property-key b))
                                (jl-ctrl) (jl-mem) a))
        (if (op-value-is? op PropDelete [_])
            (do (jl-set-mem! (n-peephole (n-new3 (PropDelete (jl-static-property-key b))
                                                   (jl-ctrl) (jl-mem) a)))
                (jl-const (t-undef)))
        (if (op-value-is? op PropStore [_])
            (do (jl-set-mem! (n-peephole (n-new4 (PropStore (jl-static-property-key b))
                                                   (jl-ctrl) (jl-mem) a c)))
                (jl-const (t-undef)))
        (if (op-value-is? op New [_])
            ; SHAPE-ROOT, then the Array tag. The allocation's control input is real — an allocation
            ; happening twice is two objects — so it hangs off the current control rather than
            ; floating like a value op.
            (let [object (n-obj-ptr (n-new-obj0! (jl-ctrl) SHAPE-ROOT))]
              (if (= id JSP-NEWARRAY) (n-array-mark! (jl-ctrl) object) object))
          (if (op-value-is? op ArrayStore [])
              ; The store PRODUCES the new memory, which becomes current. Its JSL value is
              ; `undefined`: a store is an effect, and giving it the stored value back would invite
              ; a definition to read a heap write as an expression.
              (do (jl-set-mem! (n-array-store-at! (jl-ctrl) (jl-mem) a b c))
                  (jl-const (t-undef)))
            ;; `%ArrayResize a n v`. The third operand is an ORDERING value, not data: the resize is
            ;; built with `n-array-resize-after-at!` so `v`'s read is forced ahead of the write that
            ;; destroys it. Without it `pop`'s load of the last element floats past the shortening
            ;; and selection rejects the block with `MSEL-MEMORY-ORDER`.
            (if (op-value-is? op ArrayResize [])
                (do (jl-set-mem! (n-array-resize-after-at! (jl-ctrl) (jl-mem) a b c))
                    (jl-const (t-undef)))
              (do (panic-corrupt "jsl lowering: a memory primitive this dispatch does not build")
                  NO-NODE))))))))))))))))))))))))

;; NOTHING IS BUILT ON A DIVERGED PATH. After a `goto` there is no control to hang a node off, so
;; every remaining form on that path lowers to nothing. Guarding here rather than at each construct
;; means an unreachable expression cannot leave a stray node behind whichever way it is written.
;; A float literal's payload is its BIT PATTERN, which is what `t-flt-bits` wants: NaN is not
;; reflexive under `fcmp` and interning needs exact identity, so the lattice never holds an f64.
(defn jl-float-bits [(x (ptr rd/Sexp))] (-> i64)
  (match (.kind x)
    (rd/KFloat [bits] bits)
    (_ 0)))

(defn jl-expr [(x (ptr rd/Sexp))] (-> i64)
  (if (jl-diverged?) NO-NODE
    (if (rd/sexp-int? x) (jl-const (t-int-con (rd/sexp-int x)))
      (if (rd/sexp-float? x) (jl-const (t-flt-bits (jl-float-bits x)))
        (if (rd/sexp-str? x) (n-string-const! (jss-from-utf8! (rd/sexp-str x)))
          (if (rd/sexp-sym? x) (jl-symbol (rd/sexp-sym x))
            (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
              (cond (= name "let") (jl-let x)
                    (= name "if") (jl-if x)
                    (= name "goto") (jl-goto x)
                    (= name "loop") (jl-loop x)
                    (= name "recur") (jl-recur x)
                    (= name "call") (jl-js-call x)
                    (= name "call-with-receiver") (jl-js-call-with-receiver x)
                    (= name "call-dynamic-with-receiver")
                      (jl-js-call-dynamic-with-receiver x)
                    (= name "closure") (jl-closure x)
                    (jsl-prim-name? name) (jl-prim-call x name)
                    :else (jl-call x name)))))))))

(defn jl-capture-field-name [(i i64)] (-> (slice u8))
  (case i 0 "__jsl_capture_0" 1 "__jsl_capture_1"
          2 "__jsl_capture_2" 3 "__jsl_capture_3" "__jsl_capture_bad"))

(defn jl-callable-env-shape [(d i64)] (-> i64)
  (let [(mut shape) (shape-transition SHAPE-ROOT "__closure_target" (t-int))
        (mut i) 0]
    (loop (if (>= (load i) (jsl-decl-ncaptures d)) (break)
            (do (set! shape (shape-transition (load shape)
                                              (jl-capture-field-name (load i))
                                              (t-dyn)))
                (set! i (+ (load i) 1)))))
    (load shape)))

(defn jl-closure [(x (ptr rd/Sexp))] (-> i64)
  (block :done
  (let [target (jsl-find (rd/sexp-sym (rd/sexp-nth x 1)))
        fun (jsl-decl-fun target)
        shape (jl-callable-env-shape target)
        n (jsl-decl-ncaptures target)
        (mut incoming) (al-new [i64] (malloc-allocator))
        (mut captures) (al-new [i64] (malloc-allocator))
        (mut stores) (al-new [i64] (malloc-allocator))
        base-memory (jl-mem)
        (mut i) 0]
    ;; A zero-capture intrinsic callable needs no environment object: its bare Fun is both a stable
    ;; built-in identity and a complete dynamic-call target. Allocating an empty environment under
    ;; a JSL `if` pinned that New to one arm even after the value Phi simplified, producing a live
    ;; closure use that did not dominate its consumer in large property-helper graphs.
    (if (= n 0)
        (do
          (al-free! [i64] (mut incoming))
          (al-free! [i64] (mut captures))
          (al-free! [i64] (mut stores))
          (return-from :done fun))
        0)
    (loop (if (>= (load i) (+ n 1)) (break)
            (do (al-push! [i64] (mut incoming) base-memory)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n) (break)
            (do (al-push! [i64] (mut captures) (jl-expr (rd/sexp-nth x (+ (load i) 2))))
                (set! i (+ (load i) 1)))))
    (let [nw (n-new-obj! (jl-ctrl) shape (al-slice [i64] (load incoming)))
          object (n-obj-ptr nw)]
      (al-push! [i64] (mut stores)
                (n-store! (n-obj-mem nw 0) object
                          (n-callable-id! fun)
                          (shape-field-alias shape 0)))
      (set! i 0)
      (loop (if (>= (load i) n) (break)
              (do (al-push! [i64] (mut stores)
                            (n-store! (n-obj-mem nw (+ (load i) 1)) object
                                      (al-get [i64] (load captures) (load i))
                                      (shape-field-alias shape (+ (load i) 1))))
                  (set! i (+ (load i) 1)))))
      (let [(mut merged) (al-get [i64] (load stores) 0)]
        (set! i 1)
        (loop (if (>= (load i) (al-len [i64] (load stores))) (break)
                (do (set! merged (n-new3 (MemMerge) NO-NODE (load merged)
                                         (al-get [i64] (load stores) (load i))))
                    (set! i (+ (load i) 1)))))
        (jl-set-mem! (load merged))
        (let [answer (n-materialized-closure! fun object (load merged)
                                              (al-slice [i64] (load captures)))]
          (al-free! [i64] (mut incoming))
          (al-free! [i64] (mut captures))
          (al-free! [i64] (mut stores))
          answer))))))

;; Invoke a JavaScript callback value and thread its effect through the same implicit heap cell as
;; the memory primitives. The pre-call heap is a trailing effect argument, never a source-level
;; JavaScript argument; the CallEnd-rooted Arg is the opaque heap the callback returned.
(defn jl-js-call [(x (ptr rd/Sexp))] (-> i64)
  (block :done
    (let [callee (jl-expr (rd/sexp-nth x 1))
          n (- (rd/sexp-count x) 2)
          buf (primitive/alloc-stack (array i64 17))
          p (cast (ptr i64) buf)
          (mut i) 0]
      (loop (if (>= (load i) n) (break)
              (do (store! (index p (load i)) (jl-expr (rd/sexp-nth x (+ (load i) 2))))
                  (store! i (+ (load i) 1))
                  0)))
      (if (jl-diverged?) (return-from :done NO-NODE) 0)
      (store! (index p n) (jl-call-mem))
      ;; The callee value doubles as the hidden environment, and a bare `f(...)` call runs with an
      ;; undefined receiver — the uniform closure-call ABI, same layout `inline-clone!` maps
      ;; parameters against.
      ;; A syntactically direct Fun/Closure callee stays an exact call — its raw materialized
      ;; value is a bare function index, which the polymorphic dispatcher would reject as an
      ;; untagged callable. Exact sites pass the BOXED closure as the hidden environment (the
      ;; callee prologue unboxes parameter 0); only a runtime-value callee needs tag dispatch,
      ;; and there the tagged callee value doubles as the environment.
      (let [direct (or (op-is? callee Fun [_]) (op-is? callee Closure [_]))
            cs (n-call-receiver! (jl-ctrl) callee
                                 (if direct (n-box! callee) callee)
                                 (n-box! (jl-const (t-undef)))
                                 (jl-const (t-int-con n))
                                 (slice-new [i64] p (+ n 1)))
            end (call-end cs)]
      (if direct 0 (do (n-set-op! (call-value cs) (Call CALL-ABI-DYNAMIC-RECEIVER)) 0))
        (al-push! [i64] (field (jl) callback-calls) (call-value cs))
        (jl-set-ctrl! end)
        (jl-set-mem! (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef))) end))
        ;; A JavaScript call expression always yields a tagged language value even when the
        ;; closed-world callee uses an unboxed native return register. `Box(Call)` is the existing
        ;; representation boundary; selection removes it when the target already returns `dyn`.
        (let [value (n-box! (call-value cs))]
          (jl-check-pending! value)
          value)))))

(defn jl-jsl-function? [(node i64)] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (jsl-decl-count)) (load found)) (break)
            (do (set! (.profile-jsl-scans (jl)) (+ (.profile-jsl-scans (jl)) 1))
                ;; JavaScript-callable JSL declarations participate in runtime dispatch; only
                ;; implementation-only builtins are excluded from the frontend target set.
                (if (and (= (jsl-decl-fun (load i)) node)
                         (not (jsl-callable? (load i))))
                    (set! found true) 0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; Every JavaScript function is already a closed-world Fun node. A value loaded through the heap
;; retains its runtime payload but loses that target-set refinement, so a guarded dynamic call
;; explicitly restores the set of frontend-visible targets. Internal JSL builtins are excluded:
;; they are implementation functions, never JavaScript values stored in user objects.
(defn jl-frontend-function-targets [] (-> i64)
  (let [p (jl)
        (mut node) 0
        (mut targets) 0]
    (set! (.profile-target-calls (jl)) (+ (.profile-target-calls (jl)) 1))
    (if (.frontend-targets-valid p)
        (.frontend-targets p)
        (do
          ;; Every frontend Fun root is opened before any body (and therefore before the first
          ;; dynamic JSL callback) is lowered. Internal JSL Funs may appear later, but are excluded
          ;; from this closed-world set, so the answer is graph-stable after its first computation.
          (loop (if (>= (load node) (n-count)) (break)
                  (do
                    (set! (.profile-target-scans p) (+ (.profile-target-scans p) 1))
                    (if (and (op-is? (load node) Fun [_])
                             (not (jl-jsl-function? (load node))))
                        (let [fidx (n-fun-index (load node))]
                          (if (and (>= fidx 0) (< fidx 63))
                              (set! targets (| (load targets) (<< 1 fidx)))
                              0))
                        0)
                    (set! node (+ (load node) 1)))))
          (set! (.frontend-targets p) (load targets))
          (set! (.frontend-targets-valid p) true)
          (load targets)))))

(defn jl-function-param-count [(fun i64)] (-> i64)
  ;; Parameters are direct users of their Fun. Walking the entire graph for every candidate target
  ;; made dynamic callback lowering cubic: max-arity scans every Fun for every call, and each Fun
  ;; used to rescan every node to rediscover these edges. The def-use list is the same source of
  ;; truth and bounds this by the Fun's actual users.
  (let [(mut index) 0 (mut count) 0]
    (loop (if (>= (load index) (n-nouts fun)) (break)
            (do
              (set! (.profile-param-scans (jl)) (+ (.profile-param-scans (jl)) 1))
              (let [node (n-out fun (load index))]
                (if (and (not (n-dead? node))
                         (and (op-is? node Parm [_]) (= (n-in node 0) fun)))
                  (let [next (+ (n-parm-index node) 1)]
                    (if (> next (load count)) (set! count next) 0))
                  0))
              (set! index (+ (load index) 1)))))
    (load count)))

(defn jl-frontend-max-params [(targets i64)] (-> i64)
  (let [(mut fidx) 0 (mut count) 0]
    (set! (.profile-max-calls (jl)) (+ (.profile-max-calls (jl)) 1))
    ;; The finite target mask already excludes internal JSL functions. Probe its at most 63 exact
    ;; Fun identities instead of rescanning every graph node once per dynamic call.
    (loop (if (>= (load fidx) 63) (break)
            (do
              (set! (.profile-max-scans (jl)) (+ (.profile-max-scans (jl)) 1))
              (if (!= (& targets (<< 1 (load fidx))) 0)
                  (let [fun (n-find-fun-index (load fidx))]
                    (if (!= fun NO-NODE)
                        (let [arity (jl-function-param-count fun)]
                          (if (> arity (load count)) (set! count arity) 0))
                        0))
                  0)
              (set! fidx (+ (load fidx) 1)))))
    (load count)))

(defn jl-js-call-receiver-core [(x (ptr rd/Sexp)) (dynamic bool)] (-> i64)
  (block :done
    (let [raw-callee (jl-expr (rd/sexp-nth x 1))
          targets (if dynamic (jl-frontend-function-targets) 0)
          callee
            (if (and dynamic (!= targets 0))
                (n-peephole
                  (n-new2 (Cast (t-fun-set targets))
                          (jl-ctrl) raw-callee))
                raw-callee)
          receiver (jl-expr (rd/sexp-nth x 2))
          n (- (rd/sexp-count x) 3)
          max-params (if dynamic (jl-frontend-max-params targets) (+ n 2))
          ;; Parameter indices include hidden environment (0), receiver (1), and actual argc (2).
          call-n (if (and dynamic (> (- max-params 3) n)) (- max-params 3) n)
          buf (primitive/alloc-stack (array i64 17))
          p (cast (ptr i64) buf)
          (mut i) 0]
      (loop (if (>= (load i) n) (break)
              (do (store! (index p (load i)) (jl-expr (rd/sexp-nth x (+ (load i) 3))))
                  (store! i (+ (load i) 1))
                  0)))
      ;; JavaScript permits missing arguments. The specialized native ABI does not, so dynamic
      ;; calls materialize tagged `undefined` through the largest closed-world target arity; targets
      ;; with fewer parameters simply ignore the surplus registers, as JavaScript requires.
      (if (and dynamic (!= targets 0))
          (loop (if (>= (load i) call-n) (break)
                  (do (store! (index p (load i))
                              (n-box! (jl-const (t-undef))))
                      (store! i (+ (load i) 1))
                      0)))
          0)
      (if (jl-diverged?) (return-from :done NO-NODE) 0)
      ;; An empty frontend target set means only that this immutable library graph contains no
      ;; Script functions yet. It does not make a call through a callable parameter unreachable:
      ;; retained DSL functions can receive Script callables after import. Target discovery may
      ;; refine and pad a call, but the call itself is always part of the operation's semantics.
      (store! (index p call-n) (jl-call-mem))
      ;; The callee value doubles as the hidden environment: a closure is its own environment
      ;; object, and a bare function ignores the slot entirely.
      (let [cs (n-call-receiver! (jl-ctrl) callee callee receiver
                               (jl-const (t-int-con n))
                               (slice-new [i64] p (+ call-n 1)))
          end (call-end cs)]
        (if dynamic (n-set-op! (call-value cs) (Call CALL-ABI-DYNAMIC-RECEIVER)) 0)
        (jl-set-ctrl! end)
        (jl-set-mem! (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef))) end))
        (let [value (n-box! (call-value cs))]
          (jl-check-pending! value)
          value)))))

(defn jl-js-call-with-receiver [(x (ptr rd/Sexp))] (-> i64)
  (jl-js-call-receiver-core x false))

(defn jl-js-call-dynamic-with-receiver [(x (ptr rd/Sexp))] (-> i64)
  (jl-js-call-receiver-core x true))

;; A bail-out. The current control is parked on the label's pending list and the path is marked
;; diverged; the destination does not exist yet, because it is built at the CALL SITE out of every
;; exit that reached the label. That is the whole of Torque's `otherwise`: a macro names where it
;; gives up, and the caller decides what giving up means.
(defn jl-goto [(x (ptr rd/Sexp))] (-> i64)
  (jl-exit-push! (jl-ctrl))
  (jl-set-ctrl! JL-DIVERGED)
  NO-NODE)

;; `let` is sequential: a binding sees the ones before it, the body sees them all, and nothing
;; outside sees any of them. The bindings emit no node of their own — a JSL binding IS an SSA
;; value, which is why the lowering has no notion of a local slot.
(defn jl-let [(x (ptr rd/Sexp))] (-> i64)
  (let [binds (rd/sexp-nth x 1)
        nb (rd/sexp-count binds)
        depth (jl-depth)
        (mut i) 0]
    (loop (if (>= (load i) nb) (break)
            (do
              (let [b (rd/sexp-nth binds (load i))]
                (jl-bind! (rd/sexp-sym (rd/sexp-nth b 0)) (jl-expr (rd/sexp-nth b 1))))
              (set! i (+ (load i) 1))
              0)))
    ; The body is every form after the binding list; its value is the last one.
    (let [n (rd/sexp-count x)
          (mut k) 2
          (mut v) NO-NODE]
      (loop (if (>= (load k) n) (break)
              (do (set! v (jl-expr (rd/sexp-nth x (load k))))
                  (set! k (+ (load k) 1))
                  0)))
      (jl-keep! (load v))
      (jl-drop! depth)
      (jl-unkeep! (load v))
      (load v))))

;; A diamond. Built in corpus.coil's documented order, and the keeps are not belt and braces: an
;; arm held only in a Coil local is used by nothing while the other arm is being lowered, so a
;; cascade that kills the If collects it, and the Region below then merges a dead node.
;; Merge two control paths that may each have diverged. Returns the merged value and leaves the
;; merged control current. Shared by `if` and by the `:otherwise` join, because they are the same
;; problem: a diamond in which either side may have bailed out instead of arriving.
;; A memory Phi over a merge, when the two paths left the heap in different states. Its aux is the
;; declared memory type, which is what makes it a memory PRODUCER: `v-mem-producer?` decides that
;; structurally from the Phi variant and its declared-type payload, not from the computed type.
(defn jl-mem-phi [(region i64) (ma i64) (mb i64)] (-> i64)
  (if (= ma mb) ma
    (let [phi (n-new (Phi (t-mem-alias JS-PROPERTY-ALIAS (t-undef))))]
      (n-add-def! phi region)
      (n-add-def! phi ma)
      (n-add-def! phi mb)
      (wl-push! phi)
      phi)))

(defn jl-join [(va i64) (xa i64) (ma i64) (vb i64) (xb i64) (mb i64)] (-> i64)
  (if (= xa JL-DIVERGED)
      ; Both gone means the whole construct diverges; one gone is not a merge at all, and building
      ; a Region for it would leave a one-armed merge for the peepholes to undo. The surviving
      ; path's heap is the heap.
      (do (jl-set-ctrl! xb)
          (if (= xb JL-DIVERGED) NO-NODE (do (jl-set-mem! mb) vb)))
    (if (= xb JL-DIVERGED)
        (do (jl-set-ctrl! xa) (jl-set-mem! ma) va)
      (let [region (n-new (Region))]
        (n-add-def! region NO-NODE)
        (n-add-def! region xa)
        (n-add-def! region xb)
        (let [phi (n-new (Phi (t-dyn)))]
          (n-add-def! phi region)
          (n-add-def! phi va)
          (n-add-def! phi vb)
          (wl-push! region)
          (wl-push! phi)
          ; The heap merges the same way the value does, and it must: an arm that wrote and an arm
          ; that did not leave DIFFERENT memory states, and reading the pre-branch memory after the
          ; merge would silently miss the write on exactly one path.
          (if (= (jl-mem-raw) NO-NODE) 0 (jl-set-mem! (jl-mem-phi region ma mb)))
          (jl-set-ctrl! region)
          phi)))))

(defn jl-if-dynamic [(x (ptr rd/Sexp)) (pred i64)] (-> i64)
  (let [iff (n-peephole (n-new2 (If) (jl-ctrl) pred))
        arms (n-if-arms! iff)
        at (arms-t arms)
        af (arms-f arms)]
    (jl-keep! at) (jl-keep! af)
    (let [m0 (jl-mem-raw)]
    (jl-set-ctrl! at)
    (let [va (jl-expr (rd/sexp-nth x 2))
          xa (jl-ctrl)
          ma (jl-mem-raw)]
      (jl-keep! va) (jl-keep! xa)
      (jl-set-ctrl! af)
      (jl-set-mem! m0)
      (let [vb (jl-expr (rd/sexp-nth x 3))
            xb (jl-ctrl)
            mb (jl-mem-raw)]
        (jl-keep! vb) (jl-keep! xb)
        ; The Region and the Phi are built UNPEEPHOLED and pushed together inside `jl-join`: a
        ; two-armed Region with no Phi yet is a degenerate diamond that collapses on sight. The
        ; declared Phi type is `dyn` — the ABSENCE of a claim about the merged value, which is what
        ; D8 says every unproven position must start from.
        (let [r (jl-join va xa ma vb xb mb)]
          (jl-unkeep! xb) (jl-unkeep! vb)
          (jl-unkeep! xa) (jl-unkeep! va)
          (jl-unkeep! af) (jl-unkeep! at)
          r))))))

(defn jl-if [(x (ptr rd/Sexp))] (-> i64)
  (let [pred (jl-expr (rd/sexp-nth x 1))]
    ;; The checker has already validated both arms. If construction proves the predicate, lower
    ;; only the reachable arm: building an unreachable arm and then peepholing its If used to kill
    ;; the control projection while leaving its values wired into the later Region/Phi.
    ;; LOWER THE ARM, THEN COLLECT THE PREDICATE -- in that order, and the order is the whole fix.
    ;;
    ;; `n-kill!` CASCADES into its inputs, so killing a proven predicate first releases whatever
    ;; only it was holding. `(if (%IsInt a) (%UnboxInt a) …)` is precisely that shape: the
    ;; TypeTest is the Box's only user at this moment, killing the TypeTest takes the Box with it,
    ;; and the arm is then lowered against a corpse -- `n-add-def!: input is dead`, surfacing much
    ;; later as `VERR-DEAD-INPUT` on a `Cast` whose value was a dead `Box` with four live uses.
    ;;
    ;; Doing it the other way round means every value the arm needs has a live user before anything
    ;; is collected. The result is pinned across the collect for the reason `jl-drop!` states about
    ;; its own caller: a freshly built value has no users yet and is indistinguishable from garbage.
    ;;
    ;; This was dormant until DSL guards began folding against typed operands -- before that a
    ;; `%IsInt` on a boxed argument never proved, so this branch was rarely taken. See
    ;; docs/DSL-OWNERSHIP.md.
    (if (= (n-ty pred) (t-bool-con true))
        (let [v (jl-expr (rd/sexp-nth x 2))]
          (jl-keep! v)
          (jl-collect! pred)
          (jl-unkeep! v)
          v)
        (if (= (n-ty pred) (t-bool-con false))
            (let [v (jl-expr (rd/sexp-nth x 3))]
              (jl-keep! v)
              (jl-collect! pred)
              (jl-unkeep! v)
              v)
            (jl-if-dynamic x pred)))))

;; `(loop [(name init [type]) ...] BODY...)`. Built in the order D9's in-progress contract requires,
;; corpus.coil's `fx-loop` states and which is not negotiable: OPEN the Loop, OPEN every Phi with a
;; placeholder back edge, build and peephole the body INSIDE that window, CLOSE the phis, then close
;; the control back edge. Get the order wrong and the loop is deleted with no error reported, every
;; individual step locally justified.
;;
;; `recur` diverges exactly as `goto` does, so a body of the shape `(if c (recur …) v)` needs no
;; special case: one arm bails, the other carries the value, and `jl-join` already collapses that to
;; the surviving arm rather than a degenerate merge.
(defn jl-loop [(x (ptr rd/Sexp))] (-> i64)
  (let [binds (rd/sexp-nth x 1)
        nb (rd/sexp-count binds)
        ;; Initialisers can move control through calls and dynamic guards. Capture the loop entry
        ;; only after all of them have run; wiring the Loop to the pre-initialiser control strands
        ;; their exit Region as a value-only CFG sink.
        (mut entry) (jl-ctrl)
        buf (primitive/alloc-stack (array i64 16))
        inits (cast (ptr i64) buf)
        pbuf (primitive/alloc-stack (array i64 16))
        phis (cast (ptr i64) pbuf)
        (mut k) 0]
    ; Initialisers run once, in the ENCLOSING scope, before the loop node exists.
    (loop (if (>= (load k) nb) (break)
            (do (set! (index inits (load k)) (jl-expr (rd/sexp-nth (rd/sexp-nth binds (load k)) 1)))
                (set! k (+ (load k) 1))
                0)))
    (set! entry (jl-ctrl))
    ; NEITHER THE LOOP NOR ITS PHIS IS PEEPHOLED UNDER CONSTRUCTION, and this is not caution — it is
    ; the difference between a working loop and a corrupt graph. A node whose back edge is still the
    ; NO-NODE placeholder is not yet structurally meaningful, but GVN cannot tell: two bindings that
    ; start from the same value are `Phi(loop, Const 0, NO-NODE)` twice over, structurally identical,
    ; and the second is deduped into the first. Both bindings then name one phi, closing it twice
    ; writes the second binding's value over the first, and the failure surfaces several nodes away
    ; as `n-in: input index out of range`. Two sibling loops with the same entry collide the same
    ; way. The worklist pushes at close time are what get their types computed instead;
    ; `fng-if-expression` in the frontend builds every phi this way for the same reason.
    (let [lp (n-new (Loop))]
      (n-add-def! lp NO-NODE)
      (n-add-def! lp (load entry))
      (n-add-def! lp NO-NODE)          ; the back edge, filled in below
      (set! k 0)
      (loop (if (>= (load k) nb) (break)
              (let [binding (rd/sexp-nth binds (load k))
                    declared (if (= (rd/sexp-count binding) 3)
                                 (jsl-type-of (rd/sexp-nth binding 2))
                                 (t-dyn))
                    ph (n-new (Phi declared))]
                (n-add-def! ph lp)
                (n-add-def! ph (load (index inits (load k))))
                (n-add-def! ph NO-NODE)  ; the recur value, filled in below
                (set! (index phis (load k)) ph)
                (set! k (+ (load k) 1))
                0)))
      ; THE HEAP IS AN EXTRA, UNNAMED BINDING. A loop that writes the heap needs a memory Phi for
      ; exactly the reason it needs one per value: the body reads what the previous iteration wrote,
      ; and the entry memory is only right on the first trip. It is built here alongside the value
      ; phis and closed with them; `recur` records the current memory as the (nb+1)-th back-edge
      ; value. Nothing in the source names it.
      (let [depth (jl-depth)
            rbase (jl-rctrl-count)
            vbase (jl-rvals-count)
            m0 (jl-mem-raw)
            memphi (if (= m0 NO-NODE) NO-NODE
                     (let [ph (n-new (Phi (t-mem-alias JS-PROPERTY-ALIAS (t-undef))))]
                       (n-add-def! ph lp) (n-add-def! ph m0) (n-add-def! ph NO-NODE)
                       ph))
            (mut frame) (zeroed JslLoop)]
        (if (= memphi NO-NODE) 0 (jl-set-mem! memphi))
        (set! (.nbind frame) nb)
        (set! (.base frame) rbase)
        (set! (.vbase frame) vbase)
        (set! (.memphi frame) memphi)
        (al-push! [JslLoop] (field (jl) loops) (load frame))
        (set! k 0)
        (loop (if (>= (load k) nb) (break)
                (do (jl-bind! (rd/sexp-sym (rd/sexp-nth (rd/sexp-nth binds (load k)) 0))
                              (load (index phis (load k))))
                    (set! k (+ (load k) 1))
                    0)))
        (jl-set-ctrl! lp)
        ; The body, inside the open window.
        (let [n (rd/sexp-count x) (mut j) 2 (mut v) NO-NODE]
          (loop (if (>= (load j) n) (break)
                  (do (set! v (jl-expr (rd/sexp-nth x (load j))))
                      (set! j (+ (load j) 1))
                      0)))
          (let [exit (jl-ctrl)
                exitmem (jl-mem-raw)]
            (jl-keep! (load v))
            (jl-drop! depth)
            (jl-unkeep! (load v))
            (al-pop! [JslLoop] (field (jl) loops))
            (jl-loop-close! lp phis nb rbase vbase memphi exit exitmem (load v))))))))

;; Close the phis, then the control back edge, then hand back the loop's value.
(defn jl-loop-close! [(lp i64) (phis (ptr i64)) (nb i64) (rbase i64) (vbase i64)
                      (memphi i64) (exit i64) (exitmem i64) (v i64)] (-> i64)
  (let [nrec (- (jl-rctrl-count) rbase)]
    ; A loop nothing recurs to is a `let` written the long way, and would leave the Loop's back edge
    ; null. A loop everything recurs from cannot terminate and leaves the enclosing body with no
    ; Return. Both are named rather than left to produce a malformed graph three passes later.
    (if (= nrec 0) (do (jsl-fail! JSL-ERR-LOOP-NO-RECUR "") NO-NODE)
      (if (= exit JL-DIVERGED) (do (jsl-fail! JSL-ERR-LOOP-NO-EXIT "") NO-NODE)
        (let [back (if (= nrec 1)
                       (al-get (.rctrl (jl)) rbase)
                       (jl-recur-region! rbase nrec))
              (mut k) 0]
          ; PHIS FIRST, then control: D9's order.
          (loop (if (>= (load k) nb) (break)
                  (do (n-set-def! (load (index phis (load k))) 2
                                  (jl-recur-value! vbase nrec nb (load k) back))
                      (wl-push! (load (index phis (load k))))
                      (set! k (+ (load k) 1))
                      0)))
          ; The memory phi closes with the others, before control.
          (if (= memphi NO-NODE) 0
            (do (n-set-def! memphi 2 (jl-recur-mem! rbase nrec back))
                (wl-push! memphi)
                0))
          (n-set-def! lp 2 back)
          (wl-push! lp)
          (jl-recur-drop! rbase vbase)
          (jl-set-ctrl! exit)
          ;; After the loop the heap is the state on its EXIT path. That may be the header phi when
          ;; the body only reads, but a body can write before testing whether to exit; publishing
          ;; the header phi there silently discards the final iteration's effects.
          (if (= memphi NO-NODE) 0 (jl-set-mem! exitmem))
          v)))))

;; The memory reaching the back edge, from the memory each `recur` recorded.
(defn jl-recur-mem! [(rbase i64) (nrec i64) (back i64)] (-> i64)
  (if (= nrec 1) (al-get (.rmem (jl)) rbase)
    (let [phi (n-new (Phi (t-mem-alias JS-PROPERTY-ALIAS (t-undef))))
          (mut i) 0]
      (n-add-def! phi back)
      (loop (if (>= (load i) nrec) (break)
              (do (n-add-def! phi (al-get (.rmem (jl)) (+ rbase (load i))))
                  (set! i (+ (load i) 1))
                  0)))
      (wl-push! phi)
      phi)))

;; More than one `recur`: the IR gives a Loop exactly one back edge (`n-back-edge?` is input 2), so
;; the recur controls merge into a Region first and THAT is the back edge.
(defn jl-recur-region! [(rbase i64) (nrec i64)] (-> i64)
  (let [region (n-new (Region))
        (mut i) 0]
    (n-add-def! region NO-NODE)
    (loop (if (>= (load i) nrec) (break)
            (do (n-add-def! region (al-get (.rctrl (jl)) (+ rbase (load i))))
                (set! i (+ (load i) 1))
                0)))
    (wl-push! region)
    region))

;; Binding `k`'s value on the back edge: the single recur's value, or a Phi over the merge region.
;; Recur `r` of this loop wrote its values at `vbase + r*nb`, which is why the value base is carried
;; separately from the control base.
(defn jl-recur-value! [(vbase i64) (nrec i64) (nb i64) (k i64) (back i64)] (-> i64)
  (if (= nrec 1) (al-get (.rvals (jl)) (+ vbase k))
    (let [phi (n-new (Phi (t-dyn)))
          (mut i) 0]
      (n-add-def! phi back)
      (loop (if (>= (load i) nrec) (break)
              (do (n-add-def! phi (al-get (.rvals (jl))
                                          (+ vbase (+ (* (load i) nb) k))))
                  (set! i (+ (load i) 1))
                  0)))
      (wl-push! phi)
      phi)))

;; Released only after `jl-loop-close!` has wired every parked value into a phi, which is what gives
;; each of them a real user.
(defn jl-recur-drop! [(rbase i64) (vbase i64)] (-> i64)
  (loop (if (<= (jl-rctrl-count) rbase) (break)
          (do (jl-unkeep! (al-get (.rmem (jl)) (- (jl-rctrl-count) 1)))
              (al-pop! [i64] (field (jl) rctrl))
              (al-pop! [i64] (field (jl) rmem))
              0)))
  (loop (if (<= (jl-rvals-count) vbase) (break)
          (do (jl-unkeep! (al-get (.rvals (jl)) (- (jl-rvals-count) 1)))
              (al-pop! [i64] (field (jl) rvals))
              0)))
  0)

;; `(recur v ...)`. Parks the control and the next values on the enclosing loop's list and diverges,
;; the same shape `goto` uses. The destination does not exist yet: the phis are still open.
(defn jl-recur [(x (ptr rd/Sexp))] (-> i64)
  (let [nb (.nbind (jl-loop-p (- (jl-loop-depth) 1)))
        buf (primitive/alloc-stack (array i64 16))
        vals (cast (ptr i64) buf)
        (mut k) 0]
    ; ARGUMENTS FIRST, THEN THE CONTROL. An argument may move control — a nested `loop`, a call, an
    ; `if` — so the control at the moment of the jump is the one AFTER they are evaluated, not the
    ; one on entry. Recording it first names the block the arguments started in, and the back edge
    ; then leaves from a block that no longer runs: `g-verify` catches it, several nodes away.
    (loop (if (>= (load k) nb) (break)
            (do (set! (index vals (load k)) (jl-expr (rd/sexp-nth x (+ (load k) 1))))
                (set! k (+ (load k) 1))
                0)))
    (if (jl-diverged?) NO-NODE
      (do
        ; PIN EVERY PARKED VALUE UNTIL THE LOOP CLOSES. A recur's values are held in these arrays,
        ; which are Coil storage, not graph edges — so until `jl-loop-close!` wires them into the
        ; phis' back edges they have no user at all. `jl-drop!` then collects them as unused dead
        ; code, and the phi is wired to a killed node: `VERR-DEAD-INPUT`, several nodes away from
        ; the `let` that dropped them.
        (al-push! [i64] (field (jl) rctrl) (jl-ctrl))
        (al-push! [i64] (field (jl) rmem) (jl-mem-raw))
        (jl-keep! (jl-mem-raw))
        (set! k 0)
        (loop (if (>= (load k) nb) (break)
                (do (al-push! [i64] (field (jl) rvals) (load (index vals (load k))))
                    (jl-keep! (load (index vals (load k))))
                    (set! k (+ (load k) 1))
                    0)))
        (jl-set-ctrl! JL-DIVERGED)
        NO-NODE))))

;; DIVERGENCE PROPAGATES THROUGH OPERANDS, and this is semantics rather than a safety net. A `recur`
;; or `goto` in a non-tail position — `(%Add (recur 1) 2)` — transfers control, so the `%Add` never
;; happens; building it would wire a live node to the NO-NODE a diverged path hands back. Checking
;; after the operands are lowered says exactly that: once the path is gone, so is the expression.
(defn jl-prim-call [(x (ptr rd/Sexp)) (name (slice u8))] (-> i64)
  (let [id (jsp-find name)
        n (jsp-arity id)
        a (if (>= n 1) (jl-expr (rd/sexp-nth x 1)) NO-NODE)
        b (if (>= n 2) (jl-expr (rd/sexp-nth x 2)) NO-NODE)
        c (if (>= n 3) (jl-expr (rd/sexp-nth x 3)) NO-NODE)]
    (if (jl-diverged?) NO-NODE (jl-prim id a b c))))

;; The macro machinery. A `macro` has no `OPTAG-FUN` and is never called: its body is lowered AGAIN,
;; here, in the caller's graph, with its parameters bound to the caller's already-lowered argument
;; nodes. That is real inlining with no cloning machinery — re-lowering from the source is both
;; simpler than copying a graph and automatically correct, because the source is the only
;; description of the macro that exists.
;;
;; The lookup frame is moved so the body cannot see the caller's bindings, and the exit list is
;; based so a nested expansion's `goto`s cannot be mistaken for this one's.
(defn jl-macro-expand [(x (ptr rd/Sexp)) (callee i64) (nargs i64) (owa i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 16))
        p (cast (ptr i64) buf)
        (mut k) 0]
    ; Arguments are lowered in the CALLER's scope, before the frame moves. Call-by-value: the macro
    ; receives nodes, not source, so an argument expression is evaluated once however many times
    ; the body mentions the parameter.
    (loop (if (>= (load k) nargs) (break)
            (do (set! (index p (load k)) (jl-expr (rd/sexp-nth x (+ (load k) 1))))
                (set! k (+ (load k) 1))
                0)))
    (let [saved-frame (jl-frame)
          saved-decl (.decl (jl))
          saved-fun (.fun (jl))
          depth (jl-depth)
          exit-base (jl-exit-count)]
      (jl-set-frame! depth)
      (set! k 0)
      (loop (if (>= (load k) nargs) (break)
              (do (jl-bind! (jsl-param-name callee (load k)) (load (index p (load k))))
                  (set! k (+ (load k) 1))
                  0)))
      (set! (.decl (jl)) callee)
      (let [v (jl-expr (jsl-decl-body callee))
            normal (jl-ctrl)]
        (set! (.decl (jl)) saved-decl)
        (set! (.fun (jl)) saved-fun)
        (jl-set-frame! saved-frame)
        (jl-keep! v)
        (jl-drop! depth)
        (jl-unkeep! v)
        (jl-macro-finish v normal callee exit-base x owa)))))

;; Build the label's destination out of every exit that reached it, lower the handler there, and
;; merge. When no exit survived — the usual outcome once a guard folds — there is nothing to build
;; and the handler is simply never emitted, which is exactly the specialisation the language exists
;; for.
(defn jl-macro-finish [(v i64) (normal i64) (callee i64)
                       (exit-base i64) (x (ptr rd/Sexp)) (owa i64)] (-> i64)
  (let [nexits (- (jl-exit-count) exit-base)]
    (if (= nexits 0)
        (do (jl-set-ctrl! normal) v)
      (let [hctrl (if (= nexits 1) (jl-exit exit-base) (jl-exit-region exit-base nexits))]
        (jl-exit-drop! exit-base)
        (jl-keep! v) (jl-keep! normal) (jl-keep! hctrl)
        ; D4: the slow path is an ordinary CFG path carrying a cold hint. Nothing downstream needs
        ; to know it is a bail-out; the hint biases block layout and spill costs and that is all.
        (n-mark-cold! hctrl)
        (jl-set-ctrl! hctrl)
        (let [vh (jl-expr (rd/sexp-nth x (+ owa 1)))
              xh (jl-ctrl)]
          (jl-keep! vh) (jl-keep! xh)
          (let [r (jl-join v normal (jl-mem-raw) vh xh (jl-mem-raw))]
            (jl-unkeep! xh) (jl-unkeep! vh)
            (jl-unkeep! hctrl) (jl-unkeep! normal) (jl-unkeep! v)
            r))))))

;; More than one `goto` to the same label. Unpeepholed and worklisted, following the same rule the
;; diamond does.
(defn jl-exit-region [(base i64) (n i64)] (-> i64)
  (let [region (n-new (Region))
        (mut i) 0]
    (n-add-def! region NO-NODE)
    (loop (if (>= (load i) n) (break)
            (do (n-add-def! region (jl-exit (+ base (load i))))
                (set! i (+ (load i) 1))
                0)))
    (wl-push! region)
    region))

;; A call to another JSL builtin. The callee is the `OPTAG-FUN` NODE itself rather than a Closure:
;; `call-idealize` accepts a Fun directly, `OPTAG-FUN` computes to `t-fun-con fidx` so
;; `infer-call-targets` sees an exact singleton, and with no captures `infer-parm-source` maps
;; argument `k` to input `2 + k` either way. A Closure would be a wrapper carrying nothing.
(defn jl-call [(x (ptr rd/Sexp)) (name (slice u8))] (-> i64)
  (let [callee (jsl-find name)
        owa (jsl-otherwise-at x)
        nargs (if (>= owa 0) (- owa 1) (- (rd/sexp-count x) 1))]
    (if (< callee 0)
        (do (panic-corrupt "jsl lowering: a call to an undeclared name reached lowering") 0)
        0)
    (if (jsl-macro? callee)
        (jl-macro-expand x callee nargs owa)
        (jl-builtin-call x callee nargs))))

(defn jl-call-argument [(callee i64) (index i64) (value i64)] (-> i64)
  ;; `dyn` is the tagged JavaScript-value ABI. The other JSL annotations name raw machine
  ;; representations consumed by their primitives. `n-box!` is representation-aware: an already
  ;; tagged argument remains unchanged, while raw strings, objects, arrays, and numbers acquire
  ;; exactly their structural JavaScript tag.
  (if (= (jsl-param-ty callee index) (t-dyn)) (n-box! value) value))

(defn jl-builtin-call [(x (ptr rd/Sexp)) (callee i64) (nargs i64)] (-> i64)
  (block :call
  (let [buf (primitive/alloc-stack (array i64 10))
        p (cast (ptr i64) buf)
        uses-mem (jsl-decl-uses-memory? callee)
        (mut i) 0]
    (loop (if (>= (load i) nargs) (break)
            (do (store! (index p (load i))
                        (jl-call-argument callee (load i)
                                          (jl-expr (rd/sexp-nth x (+ (load i) 1)))))
                (store! i (+ (load i) 1))
                0)))
    (if (jl-diverged?) (return-from :call NO-NODE) 0)
    (if uses-mem
        (store! (index p nargs)
                (if (jsl-decl-calls-back? callee) (jl-call-mem) (jl-mem)))
        0)
    (let [fun (jsl-decl-fun callee)
          cs (n-call! (jl-ctrl) fun (slice-new [i64] p (+ nargs (if uses-mem 1 0))))
          end (call-end cs)]
      (jl-set-ctrl! end)
      (if uses-mem
          (jl-set-mem! (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef))) end))
          0)
      ;; A DECLARED `:ret` IS A REPRESENTATION CONTRACT ON THE WAY OUT, exactly as a declared
      ;; parameter type is one on the way in, and nothing carried it. A `Call` computes `dyn`
      ;; whatever its callee returns, so the result of a definition declared `:ret int` -- a RAW
      ;; machine integer -- reads as a tagged JavaScript value everywhere downstream. Two consumers
      ;; then disagree about the same word: `"abcdef".lastIndexOf("c")` RETURNED 2 CORRECTLY, and
      ;; `lastIndexOf("c") | 0` answered 0, because `be-box-input-already-tagged?` saw `dyn` on the
      ;; loop phi holding it, called the `Box` an identity, and the DSL's `ToInt32` ran its tag
      ;; tests on a raw integer.
      ;;
      ;; The `Cast` is an assertion of the type the declaration already states, so it adds no claim
      ;; the callee was not making. It is pinned to the `CallEnd`, which is where the value exists.
      (let [ret (jsl-decl-ret callee)
            raw (call-value cs)
            value (if (or (= ret TY-NO-ID) (= ret (t-dyn)))
                      raw
                      (n-peephole (n-new2 (Cast ret) end raw)))]
        (jl-check-pending! value)
        value)))))

;; Inline only calls introduced by JSL's JavaScript-callback form. This deliberately excludes
;; ordinary source calls: callback macros expose hot per-element calls, while global inlining can
;; perturb unrelated recursive/control-heavy functions and their register pressure.
(defn jl-inline-callback-calls! [] (-> i64)
  (let [calls (.callback-calls (jl))
        (mut index) 0 (mut count) 0]
    (loop (if (>= (load index) (al-len [i64] calls))
              (break)
              (do (if (inline-one-call! (al-get [i64] calls (load index)))
                      (set! count (+ (load count) 1)) 0)
                  (set! index (+ (load index) 1)))))
    (load count)))

; ============================================================================
; Declarations
; ============================================================================
;; WHAT THIS DECLARATION BUILT is the id window between the two node counts, which includes every
;; node an inlined macro contributed — correctly, because after inlining those nodes ARE the
;; caller's. A macro whose body calls a builtin therefore makes its CALLER transitioning, which is
;; the right answer: the call is in the caller's frame once the macro is expanded.
;;
;; `transitioning` is
;; then checked against the GRAPH rather than against the source, which is the thing that makes it
;; stronger than the annotation discipline it is modelled on: Torque enforces `transitioning`
;; syntactically, so a Torque annotation can be right about the source and wrong about the code
;; the macro expanded into. An annotation cannot be wrong about what the lowering did when the
;; thing inspected IS the lowering's output.
(defn jl-transition-check [(d i64) (from i64) (to i64)] (-> i64)
  (if (jsl-decl-transitioning? d) JSL-OK
    (let [(mut n) from (mut err) JSL-OK]
      (loop (if (or (>= (load n) to) (!= (load err) JSL-OK))
                (break)
                (do
                  (if (n-dead? (load n)) 0
                    (let [node (load n)]
                      (if (or (op-is? node Call [_]) (op-is? node Safepoint []))
                          (set! err (jsl-fail! JSL-ERR-UNDECLARED-TRANSITION (jsl-decl-name d)))
                          0)))
                  (set! n (+ (load n) 1))
                  0)))
      (load err))))

;; Pass one. Every Fun is opened before any body is lowered, because a body may call a definition
;; that appears later in the file and `jl-call` needs the callee's node to exist.
;; A MACRO GETS NO FUN. It is never called, so a Fun for it would be an unreachable function in
;; every graph the library is linked into, and `n-fun-close!` would then need a body that has no
;; independent existence. Its `fun` stays NO-NODE, which is what `jsl-call!` checks.
(defn jl-open-all! [] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (do (if (jsl-macro? (load i)) 0
                    (jsl-decl-set-fun! (load i) (jl-open-function! (load i))))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn jl-lower-decl! [(d i64)] (-> i64)
  (let [fun (jsl-decl-fun d)
        before (n-count)
        started (node-profile-now)
        p (jl)
        saved-collect (.collect-abrupts p)
        abrupt-base (jl-abrupt-count)]
    ;; A standalone definition owns the abrupt paths produced by calls in its body. Collect them
    ;; here even when demand lowering was entered from a frontend macro expansion: the declaration
    ;; publishes them as exceptional Returns on its own Fun below, rather than leaking them into
    ;; the source function that happened to trigger lowering.
    (set! (.collect-abrupts p) true)
    (jl-unpin-binds!)
    (al-clear! [JslBind] (field p binds))
    (set! (.decl p) d)
    (set! (.fun p) fun)
    (set! (.ctrl p) (n-fun-entry fun))
    (set! (.anchor p) (n-fun-entry fun))
    ; Parameters are the outermost bindings, created ONCE each. `jl-lookup` searches innermost
    ; first, so a `let` may shadow a parameter, and the checker resolves in the same order.
    (let [np (jsl-decl-nparams d) (mut k) 0]
      (if (jsl-callable? d)
          (do
            (jl-bind! "this" (n-parm! fun 1))
            (if (> (jsl-decl-ncaptures d) 0)
                (let [entry (n-fun-entry fun)
                      shape (jl-callable-env-shape d)
                      ;; Dynamic dispatch retags the closure payload as an object for hidden
                      ;; environment parameter 0; the shape describes the raw pointer and fields.
                      env (n-unbox! (n-parm! fun 0) (t-obj-shape shape))
                      (mut capture) 0]
                  (loop (if (>= (load capture) (jsl-decl-ncaptures d)) (break)
                          (let [alias (shape-field-alias shape (+ (load capture) 1))
                                memory (n-new1 (Arg (t-mem-alias alias (t-dyn))) entry)]
                            (jl-bind! (jsl-capture-name d (load capture))
                                      (n-load! memory env alias))
                            (set! capture (+ (load capture) 1))))))
                0))
          0)
      (loop (if (>= (load k) np) (break)
              (do (jl-bind! (jsl-param-name d (load k))
                            (n-parm! fun (+ (load k) (if (jsl-callable? d) 3 0))))
                  (set! k (+ (load k) 1))
                  0)))
      ; THE HEAP IS ESTABLISHED BEFORE THE BODY, not on first use, and the difference is a real bug
      ; rather than a preference. Created lazily, a heap first touched INSIDE a loop has no memory
      ; at the loop's entry, so no loop memory Phi is built — and every iteration then reads the
      ; entry heap instead of what the previous iteration wrote. The same laziness loses the heap
      ; across an `if` whose writing arm diverges. The checker already knows which definitions touch
      ; the heap, so this uses that rather than discovering it mid-lowering.
      (set! (.mem p) NO-NODE)
      (set! (.outer p) NO-NODE)
      (if (jsl-decl-uses-memory? d) (jl-mem) 0)
      ;; Callback-bearing builtins receive the caller's merged state in their ordinary trailing
      ;; memory argument. Reuse that dependency for calls into user code instead of capturing the
      ;; first source caller present while this shared DSL function happened to be lowered.
      (if (jsl-decl-calls-back? d) (jl-set-outer-mem! (jl-mem)) 0))
    (let [v (jl-expr (jsl-decl-body d))
          ; RAW, not peepholed, and not added to Stop: a function body's Return belongs to its Fun
          ; (`n-fun-close!`), and only a top-level Return is a def of Stop.
          ;
          ; A DEFINITION THAT TOUCHED THE HEAP RETURNS ITS FINAL MEMORY. Not decoration: with
          ; nothing reading the last store, the kill cascade collects the entire chain as unused and
          ; `g-verify` reports VERR-LEAK. corpus.coil's memory fixtures all end this way for the
          ; same reason.
          ret (if (= (jl-mem-raw) NO-NODE)
                  (n-new2 (Return) (jl-ctrl) v)
                  (n-new3 (Return) (jl-ctrl) v (jl-mem-raw)))]
      (n-fun-close! fun ret)
      ;; A callback or transitive JSL call reports an abrupt completion through the process-local
      ;; pending flag. Its result register is deliberately meaningless in that state, so no normal
      ;; operation may consume it. `jl-check-pending!` split each such call and captured the true
      ;; edge with the heap visible at that exact point; publish those edges as the same descriptor-
      ;; 104 exceptional Returns source functions use. The caller checks the flag before touching
      ;; the returned placeholder, while return-kind inference ignores these marked arms.
      (let [(mut abrupt) abrupt-base]
        (loop (if (>= (load abrupt) (jl-abrupt-count)) (break)
                (let [ctrl (jl-abrupt-ctrl (load abrupt))
                      dependency (jl-abrupt-dependency (load abrupt))
                      memory (jl-abrupt-mem (load abrupt))
                      marked
                        (n-peephole
                          (n-new3 (JsBuiltin 104) ctrl dependency
                                  (n-new1 (Const (t-int-con 0)) (g-start))))
                      exceptional
                        (if (= memory NO-NODE)
                            (n-new2 (Return) ctrl marked)
                            (n-new3 (Return) ctrl marked memory))]
                  (n-fun-add-return! fun exceptional)
                  (set! abrupt (+ (load abrupt) 1))))))
      (jl-abrupt-drop! abrupt-base)
      (jl-set-outer-mem! NO-NODE)
      (if (jsl-decl-cold? d) (n-mark-cold! (n-fun-entry fun)) 0)
      ; A failure recorded DURING lowering (a loop that cannot iterate or cannot exit) has to be
      ; returned, not just stored: `jsl-lower!` reports its caller's return value, and a recorded
      ; error nobody propagates is a lowering that reports success over a graph it knows is wrong.
      (let [result (if (not (jsl-ok?))
                       (jsl-err)
                       (jl-transition-check d before (n-count)))]
        ;; A declaration's lexical bindings end with its body. Eagerly release their construction
        ;; pins rather than relying on a later declaration to do so: demand-lowered shared builtins
        ;; may be the last declaration opened in a graph, in which case the stale pins make an
        ;; otherwise unreachable node survive `g-write`'s two-root reachability check.
        (jl-unpin-binds!)
        (al-clear! [JslBind] (field p binds))
        (set! (.profile-lower-calls p) (+ (.profile-lower-calls p) 1))
        (set! (.profile-lower-nodes p) (+ (.profile-lower-nodes p) (- (n-count) before)))
        (set! (.profile-lower-ns p) (+ (.profile-lower-ns p) (- (node-profile-now) started)))
        (set! (.collect-abrupts p) saved-collect)
        result))))

;; Lower every checked declaration into the CURRENT graph. The caller owns `graph-reset!` and
;; `g-analyze!` around this, exactly as the frontend's caller does, because a runtime library is
;; linked into a program's graph rather than being a graph of its own.
(defn jsl-lower! [] (-> i64)
  (if (not (jsl-ok?)) (jsl-err)
    (do
      (jl-reset!)
      (jl-open-all!)
      (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                  (break)
                  (do (if (jsl-macro? (load i)) 0
                          (set! err (jl-lower-decl! (load i))))
                      (set! i (+ (load i) 1))
                      0)))
        (load err)))))

;; Lower the complete checked library as one immutable separately-compilable artifact. Closure
;; targets use integer-valued CallableId nodes, whose retained relocations preserve semantic Fun
;; identity without leaking graph-local indexes into machine text.
(defn jsl-lower-static-library! [] (-> i64)
  (if (not (jsl-ok?)) (jsl-err)
    (do
      (jl-reset!)
      (let [n (jsl-decl-count) (mut i) 0]
        ;; Open the complete function set first so forward and recursive JSL calls resolve.
        (loop (if (>= (load i) n) (break)
                  (do
                    (if (jsl-macro? (load i))
                        0
                        (jsl-decl-set-fun! (load i) (jl-open-function! (load i))))
                    (set! i (+ (load i) 1))
                    0)))
        (set! i 0)
        (let [(mut err) JSL-OK]
          (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                    (break)
                    (do
                      (if (jsl-macro? (load i))
                          0
                          (set! err (jl-lower-decl! (load i))))
                      (set! i (+ (load i) 1))
                      0)))
          (load err))))))

; ============================================================================
; On-demand lowering
; ============================================================================
;; Lower ONE definition and its transitive callees, and nothing else.
;;
;; WHY THIS EXISTS RATHER THAN `jsl-lower!`. The frontend links the library into programs that are
;; also held to exact `g-render` equality against the JavaScript codegen. Lowering the whole library
;; would put an unreachable function in the GRAPH for every definition the program never calls, so a
;; program that touches no string builtin would stop rendering the same. Pulling definitions the way
;; a linker pulls objects out of an archive keeps that contract, and it means adding to the library
;; cannot change the graph built for a program that does not call the addition.
;;
;; It is worth being precise about what this does NOT buy: the emitted object is the same size
;; either way, because selection already drops functions nothing reaches — `MathAbs` emits 1135
;; bytes whether the rest of the library was lowered or not. The graph is what this keeps small,
;; and the graph is what the frontend's acceptance test compares.
;;
;; `jsl-decl-fun` DOUBLES AS THE VISITED MARK and the order is what makes that work: the Fun is
;; opened BEFORE the body is walked, so a definition that calls itself finds a node to call instead
;; of recursing forever. A macro gets no Fun and so no mark, which is safe only because
;; `jsl-check-macro-cycles` has already rejected macro recursion; without that this walk would not
;; terminate on a cyclic macro.
;;
;; Dependencies are lowered to COMPLETION before the caller's body, not interleaved with it:
;; `jl-lower-decl!` drives one shared `jl` state, so lowering a callee part-way through a caller
;; would clobber the caller's bindings and control.
(defn jl-require-body! [(x (ptr rd/Sexp))] (-> i64)
  ;; `KVec` is walked as well as `KList` because `loop` bindings live in a vector, and a call that
  ;; only ever appears in a loop's initialisers would otherwise never be pulled in.
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) JSL-OK
    (let [n (rd/sexp-count x) (mut i) 0 (mut err) JSL-OK]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (and (= name "closure") (> n 1))
                (let [target (jsl-find (rd/sexp-sym (rd/sexp-nth x 1)))]
                  (if (>= target 0) (set! err (jl-require-decl! target)) 0))
                0)
            ;; A `%Prim` has no declaration to pull; it is lowered inline wherever it appears.
            (if (jsl-prim-name? name) 0
              (let [c (jsl-find name)]
                (if (>= c 0) (set! err (jl-require-decl! c)) 0))))
          0)
      (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
              (do (set! err (jl-require-body! (rd/sexp-nth x (load i))))
                  (set! i (+ (load i) 1))
                  0)))
      (load err))))

(defn jl-require-decl! [(d i64)] (-> i64)
  ;; A macro is inlined at its call site, so it needs no Fun of its own — but whatever IT calls
  ;; still has to be lowered, or the expansion would reference a Fun that was never opened.
  (if (jsl-macro? d) (jl-require-body! (jsl-decl-body d))
    (if (!= (jsl-decl-fun d) NO-NODE) JSL-OK
      (let [existing (n-find-fun-index (jsl-decl-fidx d))]
        ;; Appended frontend units reset declaration-local JSL metadata but intentionally retain
        ;; one graph and one reserved JSL function-id range. The graph is therefore the durable
        ;; visited set across units. Reopening an existing id creates a second body in the same
        ;; machine function, making otherwise independent Script units one giant optimization
        ;; problem. Rebind to the existing body; calls from this unit still contribute ordinary
        ;; call edges and parameter types during whole-image analysis.
        (if (!= existing NO-NODE)
            (do
              (jsl-decl-set-fun! d existing)
              JSL-OK)
            (do
              (let [fun (jl-open-function! d)]
                (jsl-decl-set-fun! d fun)
                (if (n-import-catalog-contains? FUN-IDENTITY-JSL
                                                (jl-library-identity-unit) d)
                    (do (n-fun-mark-imported! fun) JSL-OK)
                    (let [err (jl-require-body! (jsl-decl-body d))]
                      (if (!= err JSL-OK) err (jl-lower-decl! d)))))))))))

;; Lower everything a definition CALLS, without lowering the definition itself. That is exactly what
;; an inlined body needs: its own nodes go straight into the caller's graph, but a builtin it calls
;; still needs a Fun to call, and a macro it uses still needs that macro's callees.
(defn jsl-require-body-only! [(name (slice u8))] (-> i64)
  (if (not (jsl-ok?)) (jsl-err)
    (let [d (jsl-find name)]
      (if (< d 0)
          (jsl-fail! JSL-ERR-UNKNOWN-CALL name)
          (jl-require-body! (jsl-decl-body d))))))

;; Pull one definition into the current graph by name. Idempotent: calling it twice for the same
;; name lowers once and the second call is free, which is what lets a caller ask on every use.
(defn jsl-require! [(name (slice u8))] (-> i64)
  (if (not (jsl-ok?)) (jsl-err)
    (let [d (jsl-find name)]
      (if (< d 0) (jsl-fail! JSL-ERR-UNKNOWN-CALL name)
        (if (jsl-macro? d)
            (jsl-fail! JSL-ERR-UNKNOWN-CALL name)
            (jl-require-decl! d))))))

; ============================================================================
; Linking a caller against the library
; ============================================================================
;; Call a lowered builtin from outside. This is how a program reaches the runtime library, and it
;; is the seam the frontend will eventually emit through: today it is what the suite uses to run a
;; `.jsl` definition under the evaluator.
;; Expand a definition's body straight into the CALLER's graph, with the caller's nodes bound to the
;; parameters. No Fun, no Call, no return — the body's nodes simply become the caller's.
;;
;; WHY THIS EXISTS, MEASURED. Routing the frontend's Math builtins through `jsl-call!` cost real
;; time: `benchmarks/typescript-aot/math-loop.ts` went from 48.9ms to 75.9ms, a 1.55x slowdown,
;; because every `Math.abs` became a function call where it had been an inline node. The values were
;; identical, so this is purely what the call frame costs. There is no inliner in the optimiser to
;; recover it afterwards, so the choice has to be made here.
;;
;; This is the split Torque draws — a `macro` is inlined into its caller, a `builtin` is a separate
;; code object — with one difference: the choice belongs to the CALLER, not the declaration. The
;; same definition is a call when another library definition calls it and an inlining when the
;; frontend emits it, because the frontend is emitting the operation itself rather than invoking it.
;;
;; `ctrl-cell` is read for the control to build on and written with the control the body ended on,
;; which is how a body containing an `if` hands its merge back to the caller.
(defn jsl-inline! [(ctrl-cell (ptr i64)) (mem-cell (ptr i64)) (owner-entry i64)
                   (name (slice u8)) (args (slice i64))] (-> i64)
  (let [d (jsl-find name)]
    (if (< d 0)
        (do (panic-corrupt "jsl-inline!: no such definition") 0)
        0)
    (if (!= (slice-len args) (jsl-decl-nparams d))
        (do (panic-corrupt "jsl-inline!: argument count does not match the declaration") 0)
        0)
    ;; THE HEAP THREADS THROUGH; IT IS NOT REFUSED. This used to panic on any definition the checker
    ;; found touches memory, and that was the CALL path's reasoning misapplied here.
    ;;
    ;; A called heap definition takes an implicit effect and returns the effect it leaves. Inlining
    ;; has no call boundary: the body's nodes ARE the caller's nodes, so binding the caller's memory
    ;; before the body and reading it back afterward is the whole convention.
    (let [saved-frame (jl-frame)
          saved-decl (.decl (jl))
          saved-ctrl (jl-ctrl)
          saved-mem (jl-mem-raw)
          saved-anchor (.anchor (jl))
          saved-collect (.collect-abrupts (jl))
          uses-mem (jsl-decl-uses-memory? d)
          depth (jl-depth)
          (mut k) 0]
      (jl-set-ctrl! (load ctrl-cell))
      (set! (.anchor (jl)) owner-entry)
      ;; Established BEFORE the body, for the reason `jl-lower-decl!` gives at length: a heap first
      ;; touched inside a loop has no memory at the loop's entry, so no loop memory Phi is built and
      ;; every iteration re-reads the entry heap instead of the previous iteration's writes.
      (jl-set-mem! (if uses-mem (load mem-cell) NO-NODE))
      ;; Parameters are the only bindings the body may see: `jl-set-frame!` hides everything the
      ;; caller had bound, exactly as a macro expansion does.
      (jl-set-frame! depth)
      (loop (if (>= (load k) (slice-len args)) (break)
              (do (jl-bind! (jsl-param-name d (load k)) (slice-get args (load k)))
                  (set! k (+ (load k) 1))
                  0)))
      (set! (.decl (jl)) d)
      (let [v (jl-expr (jsl-decl-body d))]
        (set! ctrl-cell (jl-ctrl))
        ;; The caller now owns whatever the body left behind. Nothing RETURNS memory here — there is
        ;; no call to return from, which is why this needs no `VERR-LEAK` dance either.
        (if uses-mem (set! mem-cell (jl-mem-raw)) 0)
        (jl-set-mem! saved-mem)
        (set! (.anchor (jl)) saved-anchor)
        (set! (.decl (jl)) saved-decl)
        (set! (.collect-abrupts (jl)) saved-collect)
        (jl-set-frame! saved-frame)
        ;; The result outlives the bindings that built it, so it is pinned across the drop.
        (jl-keep! v)
        (jl-drop! depth)
        (jl-unkeep! v)
        (jl-set-ctrl! saved-ctrl)
        v))))

(defn jsl-call-with-memory! [(ctrl i64) (name (slice u8)) (args (slice i64))
                             (memory i64)] (-> CallSite)
  (let [d (jsl-find name)]
    (if (< d 0)
        (do (panic-corrupt "jsl-call-with-memory!: no such builtin") 0)
        0)
    (if (jsl-macro? d)
        (do (panic-corrupt "jsl-call-with-memory!: a macro has no callable entry") 0)
        0)
    (if (!= (slice-len args) (jsl-decl-nparams d))
        (do (panic-corrupt "jsl-call-with-memory!: argument count does not match the declaration") 0)
        0)
    (let [buf (primitive/alloc-stack (array i64 10))
          p (cast (ptr i64) buf)
          n (slice-len args)
          uses-mem (jsl-decl-uses-memory? d)
          (mut i) 0
          (mut answer) (zeroed CallSite)]
      (loop (if (>= (load i) n) (break)
              (do (set! (index p (load i))
                        (jl-call-argument d (load i) (slice-get args (load i))))
                  (set! i (+ (load i) 1))
                  0)))
      (if uses-mem (set! (index p n) memory) 0)
      (let [call (n-call! ctrl (jsl-decl-fun d)
                          (slice-new [i64] p (+ n (if uses-mem 1 0))))
            ret (jsl-decl-ret d)
            value (call-value call)]
        (set! (.end answer) (call-end call))
        (set! (.value answer)
              (if (or (= ret TY-NO-ID) (= ret (t-dyn)))
                  value
                  (n-peephole (n-new2 (Cast ret) (call-end call) value))))
        (load answer)))))

(defn jsl-call! [(ctrl i64) (name (slice u8)) (args (slice i64))] (-> CallSite)
  ;; This public boundary accepts source arguments only. Heap effects are a lowering concern and
  ;; stay implicit just as they do for JSL-to-JSL calls.
  (let [d (jsl-find name)]
    (jsl-call-with-memory!
      ctrl name args
      (if (and (>= d 0) (jsl-decl-uses-memory? d))
          (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef))) ctrl)
          NO-NODE))))

;; A raw ABI word whose contract is integer but whose Parm seed is deliberately untyped needs a
;; structural integer producer before `%Box` can choose the integer representation. Keep that
;; representation operation at the JSL lowering boundary rather than open-coding it in a frontend.
(defn jsl-normalize-int-representation! [(value i64)] (-> i64)
  (n-peephole
    (n-new3 (BitOr) NO-NODE value
            (n-peephole (n-new1 (Const (t-int-con 0)) (g-start))))))
