;; Local instruction scheduling plus interval compatibility for the legacy allocator.
(module backend_schedule)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(defn be-note-call-arg-uses! [(at i64) (n i64)] (-> i64)
  (let [m (be-inst at)
        argc (.arg-count m)
        (mut argi) 0]
    (loop (if (>= (load argi) argc)
              (break)
              (do
                (let [vr (ms-inst-arg at (load argi))
                      def (ms-def-inst vr)]
                  (if (>= def 0) (set! (.last (be-inst def)) at) 0))
                (set! argi (+ (load argi) 1))
                0)))
    0))

(defn be-schedule-intervals! [] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))
                      d (.dst m)]
                  (if (< d 0)
                      0
                      (do
                        (set! (.first m) (if (= (.op m) MI-ARG) 0 (load i)))
                        (set! (.last m) (load i))
                        0)))
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))
                      a (.a m)
                      b (.b m)
                      pred (if (= (.op m) MI-CSEL) (.imm m) -1)
                      adef (ms-def-inst a)
                      bdef (ms-def-inst b)
                      pdef (ms-def-inst pred)]
                  (if (>= adef 0) (set! (.last (be-inst adef)) (load i)) 0)
                  (if (>= bdef 0) (set! (.last (be-inst bdef)) (load i)) 0)
                  (if (>= pdef 0) (set! (.last (be-inst pdef)) (load i)) 0)
                  (if (> (ms-inst-arg-count (load i)) 0)
                      (be-note-call-arg-uses! (load i) n)
                      0))
                (set! i (+ (load i) 1))
                0)))
    ; A linear interval ends at its last textual use, but a preheader value used inside a loop is
    ; live again on every back edge. Extend such ranges through the branch that targets an earlier
    ; label so colouring cannot reuse an invariant's register for a loop-carried temporary.
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [br (be-inst (load i))]
                  (if (!= (.op br) MI-B)
                      0
                      (let [label (.imm br)
                            (mut j) 0
                            (mut at) -1]
                        (loop (if (>= (load j) (load i))
                                  (break)
                                  (do
                                    (if (and (= (.op (be-inst (load j))) MI-LABEL)
                                             (= (.imm (be-inst (load j))) label))
                                        (set! at (load j))
                                        0)
                                    (set! j (+ (load j) 1))
                                    0)))
                        (if (< (load at) 0)
                            0
                            (do
                              (set! j 0)
                              (loop (if (>= (load j) (load at))
                                        (break)
                                        (do
                                          (let [d (be-inst (load j))]
                                            (if (>= (.last d) (load at))
                                                (set! (.last d) (load i))
                                                0))
                                          (set! j (+ (load j) 1))
                                          0)))))))
                  (set! i (+ (load i) 1))
                  0))))
    n))

(defn be-local-schedule-seeded! [(seed i64)] (-> i64)
  (let [n (be-inst-count)]
    (if (and (> n 0) (>= (ms-inst-owner 0) 0))
        ;; Run the legality scheduler for production seed zero as well as perturbation seeds. GCM
        ;; placement alone does not order a heap read before a later aliasing write; the explicit
        ;; memory anti-edge is enforced here.
        (if (ms-local-schedule! seed) n -1)
        (be-schedule-intervals!))))

(defn be-liveness-seeded! [(seed i64)] (-> i64)
  (let [n (be-inst-count)]
    (if (and (> n 0) (>= (ms-inst-owner 0) 0))
        (let [ok (ml-compute! seed)]
          (if (be-profiling?)
              (do
                (fmt (stderr)
                     "AOTK_PROFILE phase=backend_work kind_direct={d} memory_alias_candidates={d} memory_duplicate_probes={d}\n"
                     (mu-work-kind-direct) (mu-work-memory-alias-candidates)
                     (mu-work-memory-antidep-duplicate-probes))
                0)
              0)
          (if ok n -1))
        n)))

(defn be-schedule-seeded! [(seed i64)] (-> i64)
  (let [scheduled (be-local-schedule-seeded! seed)]
    (if (< scheduled 0) -1 (be-liveness-seeded! seed))))

(defn be-local-schedule! [] (-> i64)
  (be-local-schedule-seeded! 0))

(defn be-liveness! [] (-> i64)
  (be-liveness-seeded! 0))

(defn be-schedule! [] (-> i64)
  (be-schedule-seeded! 0))

(defn intervals-overlap? [(a (ptr MInst)) (b (ptr MInst))] (-> bool)
  (and (<= (.first a) (.last b))
       (<= (.first b) (.last a))))
