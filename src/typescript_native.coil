;; Native TypeScript AST ABI. This is the only Coil module that declares these C
;; symbols; extern declarations are not deduplicated across Coil modules.
(module typescriptnative)

(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)

(extern aot_ts_parse :cc c [(ptr u8) i32] (-> u64))
(extern aot_ts_parse_ex :cc c [(ptr u8) i32 (ptr u8) i32 i32] (-> u64))
(extern aot_ts_parse_delete :cc c [u64] (-> void))
(extern aot_ts_script_kind :cc c [u64] (-> i32))
(extern aot_ts_root :cc c [u64] (-> i32))
(extern aot_ts_node_count :cc c [u64] (-> i32))
(extern aot_ts_node_kind :cc c [u64 i32] (-> i32))
(extern aot_ts_node_start :cc c [u64 i32] (-> i32))
(extern aot_ts_node_end :cc c [u64 i32] (-> i32))
(extern aot_ts_node_child_count :cc c [u64 i32] (-> i32))
(extern aot_ts_node_child :cc c [u64 i32 i32] (-> i32))
(extern aot_ts_node_role :cc c [u64 i32 i32 i32] (-> i32))
(extern aot_ts_node_literal_kind :cc c [u64 i32] (-> i32))
(extern aot_ts_node_literal_text :cc c [u64 i32 (ptr u8) i32] (-> i32))
(extern aot_ts_node_numeric_bits :cc c [u64 i32] (-> u64))
(extern aot_ts_diagnostic_count :cc c [u64] (-> i32))
(extern aot_ts_diagnostic_code :cc c [u64 i32] (-> i32))
(extern aot_ts_diagnostic_start :cc c [u64 i32] (-> i32))
(extern aot_ts_diagnostic_length :cc c [u64 i32] (-> i32))

;; Stable aot-kit kind codes. The Go bridge maps upstream ast.Kind explicitly;
;; no Coil lowering module depends on Microsoft's numeric enum.
(const TSK-END-OF-FILE i64 1)
(const TSK-NUMERIC-LITERAL i64 8)
(const TSK-STRING-LITERAL i64 11)
(const TSK-REGEXP-LITERAL i64 14)
(const TSK-TEMPLATE-HEAD i64 15)
(const TSK-TEMPLATE-MIDDLE i64 16)
(const TSK-TEMPLATE-TAIL i64 17)
(const TSK-IDENTIFIER i64 79)
(const TSK-FALSE i64 96)
(const TSK-NEW i64 104)
(const TSK-NULL i64 105)
(const TSK-TRUE i64 111)
(const TSK-THIS i64 110)
(const TSK-VOID i64 115)
(const TSK-ANY i64 132)
(const TSK-BOOLEAN i64 135)
(const TSK-NUMBER i64 150)
(const TSK-STRING i64 154)
(const TSK-UNKNOWN i64 159)
(const TSK-COMPUTED-PROPERTY-NAME i64 168)
(const TSK-PARAMETER i64 170)
(const TSK-PROPERTY-SIGNATURE i64 172)
(const TSK-TYPE-REFERENCE i64 184)
(const TSK-TYPE-LITERAL i64 188)
(const TSK-ARRAY-TYPE i64 189)
(const TSK-UNION-TYPE i64 193)
(const TSK-LITERAL-TYPE i64 202)
(const TSK-OBJECT-LITERAL i64 211)
(const TSK-ARRAY-LITERAL i64 210)
(const TSK-PROPERTY-ACCESS i64 212)
(const TSK-ELEMENT-ACCESS i64 213)
(const TSK-CALL i64 214)
(const TSK-NEW-EXPRESSION i64 215)
(const TSK-PARENTHESIZED-EXPRESSION i64 218)
(const TSK-FUNCTION-EXPRESSION i64 219)
(const TSK-ARROW-FUNCTION i64 220)
(const TSK-CONDITIONAL-EXPRESSION i64 224)
(const TSK-PREFIX-UNARY i64 225)
(const TSK-POSTFIX-UNARY i64 226)
(const TSK-BINARY i64 227)
(const TSK-TYPEOF-EXPRESSION i64 228)
(const TSK-DELETE-EXPRESSION i64 229)
(const TSK-VOID-EXPRESSION i64 230)
(const TSK-TEMPLATE-EXPRESSION i64 231)
(const TSK-TEMPLATE-SPAN i64 232)
(const TSK-BLOCK i64 242)
(const TSK-VARIABLE-STATEMENT i64 244)
(const TSK-EXPRESSION-STATEMENT i64 245)
(const TSK-IF i64 246)
(const TSK-DO i64 247)
(const TSK-WHILE i64 248)
(const TSK-FOR i64 249)
(const TSK-FOR-OF i64 250)
(const TSK-LABELED i64 251)
(const TSK-CONTINUE i64 252)
(const TSK-BREAK i64 253)
(const TSK-RETURN i64 254)
;; `for (k in o)` and `for await (x of xs)`. Neither is lowered, and both are refused by name at
;; indexing -- which is the point of giving them codes at all: the bridge's kind 0 is "no code for
;; this", shared with every syntax it has not been taught, and the frontend's catch-all for it is
;; an abort no test can observe.
(const TSK-FOR-IN i64 259)
(const TSK-FOR-AWAIT i64 260)
(const TSK-SWITCH i64 256)
(const TSK-THROW i64 257)
(const TSK-TRY i64 258)
(const TSK-CATCH i64 300)
(const TSK-VARIABLE-DECLARATION i64 261)
(const TSK-VARIABLE-DECLARATION-LIST i64 262)
(const TSK-FUNCTION-DECLARATION i64 263)
(const TSK-INTERFACE-DECLARATION i64 265)
(const TSK-TYPE-ALIAS-DECLARATION i64 266)
(const TSK-CASE-BLOCK i64 284)
(const TSK-CASE-CLAUSE i64 285)
(const TSK-DEFAULT-CLAUSE i64 286)
(const TSK-PROPERTY-ASSIGNMENT i64 303)
(const TSK-SOURCE-FILE i64 307)

(const TS-SCRIPT-AUTO i64 0)
(const TS-SCRIPT-JS i64 1)
(const TS-SCRIPT-TS i64 2)
(const TS-ROLE-NAME i64 1)
(const TS-ROLE-BODY i64 2)
(const TS-ROLE-TYPE i64 3)
(const TS-ROLE-INITIALIZER i64 4)
(const TS-ROLE-EXPRESSION i64 5)
(const TS-ROLE-LEFT i64 6)
(const TS-ROLE-OPERATOR i64 7)
(const TS-ROLE-RIGHT i64 8)
(const TS-ROLE-CONDITION i64 9)
(const TS-ROLE-THEN i64 10)
(const TS-ROLE-ELSE i64 11)
(const TS-ROLE-STATEMENT i64 12)
(const TS-ROLE-CALLEE i64 13)
(const TS-ROLE-ARGUMENT i64 14)
(const TS-ROLE-PARAMETER i64 15)
(const TS-ROLE-OBJECT i64 16)
(const TS-ROLE-PROPERTY i64 17)
(const TS-ROLE-ELEMENT i64 18)
(const TS-ROLE-MEMBER i64 19)
(const TS-ROLE-WHEN-TRUE i64 20)
(const TS-ROLE-WHEN-FALSE i64 21)
(const TS-ROLE-LABEL i64 22)
(const TS-ROLE-CLAUSE i64 23)
(const TS-ROLE-TRY-BLOCK i64 24)
(const TS-ROLE-CATCH i64 25)
(const TS-ROLE-FINALLY i64 26)
(const TS-ROLE-CATCH-BINDING i64 27)
(const TS-LITERAL-NONE i64 0)
(const TS-LITERAL-NUMBER i64 1)
(const TS-LITERAL-STRING i64 2)
(const TS-LITERAL-BOOLEAN i64 3)
(const TS-LITERAL-NULL i64 4)
(const TS-LITERAL-REGEXP i64 5)

(defstruct TsAst [(handle u64) (source (slice u8))])

(defn ts-open [(source (slice u8))] (-> TsAst)
  (TsAst :handle (aot_ts_parse (slice-data source) (cast i32 (slice-len source))) :source source))

(defn ts-open-file [(source (slice u8)) (filename (slice u8)) (script-kind i64)] (-> TsAst)
  (TsAst :handle
         (aot_ts_parse_ex (slice-data source)
                          (cast i32 (slice-len source))
                          (slice-data filename)
                          (cast i32 (slice-len filename))
                          (cast i32 script-kind))
         :source
         source))

(defn ts-close! [(ast (mut TsAst))] (-> i64)
  (if (= (.handle ast) (cast u64 0))
      0
      (do
        (aot_ts_parse_delete (.handle ast))
        (set! (.handle ast) (cast u64 0))
        0)))

(defn ts-root [(ast TsAst)] (-> i64)
  (cast i64 (aot_ts_root (.handle ast))))

(defn ts-kind [(ast TsAst) (node i64)] (-> i64)
  (cast i64 (aot_ts_node_kind (.handle ast) (cast i32 node))))

(defn ts-start [(ast TsAst) (node i64)] (-> i64)
  (cast i64 (aot_ts_node_start (.handle ast) (cast i32 node))))

(defn ts-end [(ast TsAst) (node i64)] (-> i64)
  (cast i64 (aot_ts_node_end (.handle ast) (cast i32 node))))

(defn ts-child-count [(ast TsAst) (node i64)] (-> i64)
  (cast i64 (aot_ts_node_child_count (.handle ast) (cast i32 node))))

(defn ts-child [(ast TsAst) (node i64) (index i64)] (-> i64)
  (cast i64 (aot_ts_node_child (.handle ast) (cast i32 node) (cast i32 index))))

(defn ts-role [(ast TsAst) (node i64) (role i64) (index i64)] (-> i64)
  (cast i64 (aot_ts_node_role (.handle ast) (cast i32 node) (cast i32 role) (cast i32 index))))

(defn ts-numeric-bits [(ast TsAst) (node i64)] (-> i64)
  (cast i64 (aot_ts_node_numeric_bits (.handle ast) (cast i32 node))))

(defn ts-literal-text! [(ast TsAst) (node i64) (out (mut (ArrayList u8)))] (-> (slice u8))
  (let [required
          (cast i64
                (aot_ts_node_literal_text (.handle ast)
                                          (cast i32 node)
                                          (cast (ptr u8) 0)
                                          0))
        (mut index) 0]
    (al-clear! [u8] (mut out))
    (if (< required 0)
        (slice-new [u8] (cast (ptr u8) 0) 0)
        (do
          (loop (if (> (load index) required)
                    (break)
                    (do
                      (al-push! [u8] (mut out) (cast u8 0))
                      (set! index (+ (load index) 1)))))
          (aot_ts_node_literal_text (.handle ast)
                                    (cast i32 node)
                                    (load (field out data))
                                    (cast i32 (+ required 1)))
          (slice-new [u8] (load (field out data)) required)))))

(defn ts-text [(ast TsAst) (node i64)] (-> (slice u8))
  (substr (.source ast) (ts-start ast node) (ts-end ast node)))

(defn ts-child-of-kind [(ast TsAst) (node i64) (kind i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (ts-child-count ast node)) (!= (load answer) -1))
              (break)
              (let [child (ts-child ast node (load index))]
                (if (= (ts-kind ast child) kind) (set! answer child) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn ts-diagnostic-count [(ast TsAst)] (-> i64)
  (cast i64 (aot_ts_diagnostic_count (.handle ast))))
