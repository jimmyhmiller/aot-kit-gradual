;; Coil-owned TypeScript frontend state. The native Go compiler supplies only the
;; immutable syntax tree; declaration ordering and symbol identities live here.
(module frontendnative)
(import "coil.primitive" :as primitive)

(import "typescriptnative" :use *)
(import "jsbuiltin_desc" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use *)

(const FE-ROLE-FUNCTION i64 1)
(const FE-ROLE-PARAMETER i64 2)
(const FE-ROLE-LOCAL i64 3)
(const FE-ROLE-GLOBAL i64 4)
(const FE-OK i64 0)
(const FE-PARSE i64 1)
(const FE-UNBOUND i64 2)
(const FE-UNSUPPORTED i64 3)
(const FE-TARGET i64 4)
(const FE-CODE-UNSUPPORTED-SYNTAX i64 1001)
(const FE-CODE-UNSUPPORTED-OPERATOR i64 1002)
(const FE-CODE-UNBOUND-NAME i64 1003)
(const FE-CODE-INVALID-TARGET i64 1004)
(const FE-CODE-CONSTRUCTOR-LAYOUT i64 1005)
(const FE-CODE-MISSING-RECEIVER i64 1006)
(const FE-CODE-UNKNOWN-BUILTIN i64 1007)
(const FE-RECEIVER-DYNAMIC i64 -2)
(const FE-INTRINSIC-STRING i64 -10)
(const FE-INTRINSIC-PARSEINT i64 -11)
(const FE-INTRINSIC-ISNAN i64 -12)
(const FE-INTRINSIC-UNDEFINED i64 -13)
(const FE-INTRINSIC-NAN i64 -14)
(const FE-INTRINSIC-MATH i64 -15)
(const FE-INTRINSIC-ERROR i64 -16)
(const FE-INTRINSIC-ARRAY i64 -17)
(const FE-INTRINSIC-OBJECT i64 -18)
;; `Number`, added so that `Number.isNaN` and its three neighbours can be named at all. The four
;; definitions in lib/number/predicates.jsl were written and verified against Node long before this
;; constant existed, and until it did the receiver had no resolution, so a program using them
;; crashed the emitter rather than compiling.
(const FE-INTRINSIC-NUMBER i64 -19)
(const FE-INTRINSIC-INFINITY i64 -20)
(const FE-INTRINSIC-PARSEFLOAT i64 -21)
(const FE-INTRINSIC-JSON i64 -22)
(const FE-INTRINSIC-BOOLEAN i64 -23)
(const FE-INTRINSIC-UNBOUND i64 -24)

(defn fe-function-expression-kind? [(kind i64)] (-> bool)
  (or (= kind TSK-FUNCTION-EXPRESSION)
      (or (= kind TSK-ARROW-FUNCTION) (= kind TSK-METHOD-DECLARATION))))

(defn fe-object-property-value-node [(ast (ref TsAst)) (property i64)] (-> i64)
  (if (= (ts-kind ast property) TSK-METHOD-DECLARATION)
      property
      (if (= (ts-kind ast property) TSK-SHORTHAND-PROPERTY-ASSIGNMENT)
          (ts-child ast property 0)
          (ts-child ast property (- (ts-child-count ast property) 1)))))

(defn fe-intrinsic-name [(name (slice u8))] (-> i64)
  (cond (= name "String") FE-INTRINSIC-STRING
        (= name "parseInt") FE-INTRINSIC-PARSEINT
        (= name "isNaN") FE-INTRINSIC-ISNAN
        (= name "undefined") FE-INTRINSIC-UNDEFINED
        (= name "NaN") FE-INTRINSIC-NAN
        (= name "Math") FE-INTRINSIC-MATH
        (or (= name "Error")
            (or (= name "EvalError")
                (or (= name "RangeError")
                    (or (= name "ReferenceError")
                        (or (= name "SyntaxError")
                            (or (= name "TypeError") (= name "URIError")))))))
          FE-INTRINSIC-ERROR
        (= name "Array") FE-INTRINSIC-ARRAY
        (= name "Object") FE-INTRINSIC-OBJECT
        (= name "Number") FE-INTRINSIC-NUMBER
        (= name "Infinity") FE-INTRINSIC-INFINITY
        (= name "parseFloat") FE-INTRINSIC-PARSEFLOAT
        (= name "JSON") FE-INTRINSIC-JSON
        (= name "Boolean") FE-INTRINSIC-BOOLEAN
        :else -1))

(defstruct FeFunction
  [(id i64)
   (source-id i64)
   (node i64)
   (parent i64)
   (name-node i64)
   (body-node i64)
   (result-node i64)
   (receiver-type-node i64)
   (arrow bool)
   (lexical-this bool)
   (parameter-start i64)
   (parameter-count i64)])

(defstruct FeSymbol
  [(id i64) (node i64) (name-node i64) (owner i64) (role i64) (type-node i64)])

(defstruct FeResolution [(node i64) (symbol i64)])
(defstruct FeCapture [(function i64) (symbol i64) (mutable bool)])
(defstruct FeBinding [(name-node i64) (symbol i64) (depth i64)])
(defstruct FeTypeDecl [(node i64) (name-node i64) (field-start i64) (field-count i64)])
(defstruct FeField [(owner i64) (node i64) (name-node i64) (type-node i64)])
(defstruct FeTarget [(label-node i64) (can-break bool) (can-continue bool)])
(defstruct FePrototypeMethod [(constructor i64) (name-node i64) (target i64)])
(defstruct FePrototypeParent [(constructor i64) (parent i64)])

(defn fe-target-make [(label-node i64) (can-break bool) (can-continue bool)] (-> FeTarget)
  (FeTarget :label-node label-node :can-break can-break :can-continue can-continue))

(defstruct NativeFrontend
  [(ast TsAst)
   (functions (ArrayList FeFunction))
   (symbols (ArrayList FeSymbol))
   (resolutions (ArrayList FeResolution))
   (resolution-symbols (ArrayList i64))
   (captures (ArrayList FeCapture))
   (types (ArrayList FeTypeDecl))
   (fields (ArrayList FeField))
   (prototype-methods (ArrayList FePrototypeMethod))
   (prototype-parents (ArrayList FePrototypeParent))
   ;; Closed-world method resolution recursively scans the immutable AST. Cache exact
   ;; (receiver symbol, property text) answers so repeated call sites pay for that scan once.
   (static-method-symbols (ArrayList i64))
   (static-method-names (ArrayList i64))
   (static-method-results (ArrayList i64))
   (status i64)
   (error-node i64)
   (error-code i64)
   (error-role i64)])

(defn fe-function-make [(id i64)
                        (node i64)
                        (parent i64)
                        (name i64)
                        (body i64)
                        (result i64)
                        (receiver-type i64)
                        (arrow bool)
                        (lexical-this bool)
                        (parameter-start i64)
                        (parameter-count i64)] (-> FeFunction)
  (FeFunction :id
              id
              :source-id
              id
              :node
              node
              :parent
              parent
              :name-node
              name
              :body-node
              body
              :result-node
              result
              :receiver-type-node
              receiver-type
              :arrow
              arrow
              :lexical-this
              lexical-this
              :parameter-start
              parameter-start
              :parameter-count
              parameter-count))

(defn fe-symbol-make [(id i64) (node i64) (name i64) (owner i64) (role i64) (type-node i64)] (-> FeSymbol)
  (FeSymbol :id id :node node :name-node name :owner owner :role role :type-node type-node))

(defn fe-resolution-make [(node i64) (symbol i64)] (-> FeResolution)
  (FeResolution :node node :symbol symbol))

(defn fe-capture-make [(function i64) (symbol i64)] (-> FeCapture)
  (FeCapture :function function :symbol symbol :mutable false))

(defn fe-binding-make [(name-node i64) (symbol i64) (depth i64)] (-> FeBinding)
  (FeBinding :name-node name-node :symbol symbol :depth depth))

(defn fe-type-make [(node i64) (name-node i64) (field-start i64) (field-count i64)] (-> FeTypeDecl)
  (FeTypeDecl :node node :name-node name-node :field-start field-start :field-count field-count))

(defn fe-field-make [(owner i64) (node i64) (name-node i64) (type-node i64)] (-> FeField)
  (FeField :owner owner :node node :name-node name-node :type-node type-node))

(defn fe-native-new [(source (slice u8))] (-> NativeFrontend)
  (let [a (malloc-allocator)
        (mut frontend) (zeroed NativeFrontend)]
    (set! (.ast frontend) (ts-open source))
    (set! (.functions frontend) (al-new [FeFunction] a))
    (set! (.symbols frontend) (al-new [FeSymbol] a))
    (set! (.resolutions frontend) (al-new [FeResolution] a))
    (set! (.resolution-symbols frontend) (al-new [i64] a))
    (set! (.captures frontend) (al-new [FeCapture] a))
    (set! (.types frontend) (al-new [FeTypeDecl] a))
    (set! (.fields frontend) (al-new [FeField] a))
    (set! (.prototype-methods frontend) (al-new [FePrototypeMethod] a))
    (set! (.prototype-parents frontend) (al-new [FePrototypeParent] a))
    (set! (.static-method-symbols frontend) (al-new [i64] a))
    (set! (.static-method-names frontend) (al-new [i64] a))
    (set! (.static-method-results frontend) (al-new [i64] a))
    (set! (.status frontend) 0)
    (set! (.error-node frontend) -1)
    (set! (.error-code frontend) 0)
    (set! (.error-role frontend) 0)
    (load frontend)))

(defn fe-fail! [(frontend (mut NativeFrontend)) (code i64) (node i64) (role i64)] (-> i64)
  (if (= (.status frontend) FE-OK)
      (do
        (set! (.status frontend) FE-UNSUPPORTED)
        (set! (.error-code frontend) code)
        (set! (.error-node frontend) node)
        (set! (.error-role frontend) role))
      0)
  FE-UNSUPPORTED)

(defn fe-supported-binary? [(ast TsAst) (node i64)] (-> bool)
  (let [operator-node (ts-role ast node TS-ROLE-OPERATOR 0)
        operator (if (= operator-node -1) "" (ts-text ast operator-node))]
    (or (= operator "=")
        (= operator "+=")
        (= operator "-=")
        (= operator "*=")
        (= operator "/=")
        (= operator "%=")
        (= operator "&=")
        (= operator "|=")
        (= operator "^=")
        (= operator "<<=")
        (= operator ">>=")
        (= operator ">>>=")
        (= operator "+")
        (= operator "-")
        (= operator "*")
        (= operator "/")
        (= operator "%")
        (= operator "&")
        (= operator "|")
        (= operator "^")
        (= operator "<<")
        (= operator ">>")
        (= operator ">>>")
        (= operator "<")
        (= operator "<=")
        (= operator ">")
        (= operator ">=")
        (= operator "==")
        (= operator "!=")
        (= operator "===")
        (= operator "!==")
        (= operator "&&")
        (= operator "||")
        (= operator "??")
        (= operator "in")
        (= operator "instanceof")
        (= operator ","))))

(defn fe-supported-prefix? [(ast TsAst) (node i64)] (-> bool)
  (let [text (ts-text ast node)
        operator (if (> (slice-len text) 0) (substr text 0 1) "")]
    (or (= operator "+")
        (= operator "-")
        (= operator "!")
        (= operator "~")
        (= operator "++")
        (= operator "--"))))

(defn fe-supported-postfix? [(ast TsAst) (node i64)] (-> bool)
  (let [text (ts-text ast node)
        length (slice-len text)
        operator (if (>= length 2) (substr text (- length 2) length) "")]
    (or (= operator "++") (= operator "--"))))

(defn fe-target-valid? [(frontend (ptr NativeFrontend))
                        (targets (ptr (ArrayList FeTarget)))
                        (node i64)
                        (wants-continue bool)] (-> bool)
  (let [ast (field frontend ast)
        label (ts-role ast node TS-ROLE-LABEL 0)
        (mut index) (- (al-len [FeTarget] (load targets)) 1)
        (mut valid) false]
    (loop (if (or (< (load index) 0) (load valid))
              (break)
              (let [target (al-get [FeTarget] (load targets) (load index))
                    capability
                      (if wants-continue
                          (.can-continue target)
                          (.can-break target))
                    label-match
                      (if (= label -1)
                          (= (.label-node target) -1)
                          (and (!= (.label-node target) -1)
                               (= (ts-text ast label) (ts-text ast (.label-node target)))))]
                (if (and capability label-match) (set! valid true) 0)
                (set! index (- (load index) 1)))))
    (load valid)))

(defn fe-active-label? [(frontend (ptr NativeFrontend))
                        (targets (ptr (ArrayList FeTarget)))
                        (label i64)] (-> bool)
  (let [ast (field frontend ast)
        (mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeTarget] (load targets))) (load found))
              (break)
              (let [target (al-get [FeTarget] (load targets) (load index))]
                (if (and (!= (.label-node target) -1)
                         (= (ts-text ast label) (ts-text ast (.label-node target))))
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

;; A declared identifier, an array binding pattern, or an ordinary assignment target in
;; `for ... of` / `for ... in`. Keeping this check syntactic is deliberate:
;; the graph builder owns assignment structure, while IteratorValue and property writes remain JSL
;; operations.
(defn fe-array-binding-pattern-valid? [(ast TsAst) (node i64)] (-> bool)
  (let [kind (ts-kind ast node)]
    (if (= kind TSK-IDENTIFIER)
        true
        (if (= kind TSK-BINDING-ELEMENT)
            (let [name (ts-role ast node TS-ROLE-NAME 0)]
              ;; Defaults and rest require their own abrupt/evaluation semantics. Refuse them
              ;; until those semantics exist rather than quietly ignoring either one.
              (and (!= name -1)
                   (and (= (ts-role ast node TS-ROLE-INITIALIZER 0) -1)
                        (fe-array-binding-pattern-valid? ast name))))
            (if (= kind TSK-ARRAY-BINDING-PATTERN)
                (let [(mut i) 0 (mut valid) true]
                  (loop (if (or (>= (load i) (ts-child-count ast node)) (not (load valid)))
                            (break)
                            (do (if (not (fe-array-binding-pattern-valid?
                                           ast (ts-child ast node (load i))))
                                    (set! valid false) 0)
                                (set! i (+ (load i) 1)))))
                  (load valid))
                false)))))

(defn fe-for-enumeration-binding-valid? [(ast TsAst) (node i64)] (-> bool)
  (let [initializer (ts-role ast node TS-ROLE-INITIALIZER 0)]
    (and (!= initializer -1)
         (or (= (ts-kind ast initializer) TSK-IDENTIFIER)
             (or (= (ts-kind ast initializer) TSK-PROPERTY-ACCESS)
                 (or (= (ts-kind ast initializer) TSK-ELEMENT-ACCESS)
                     (and (= (ts-kind ast initializer) TSK-VARIABLE-DECLARATION-LIST)
                          (and (= (ts-child-count ast initializer) 1)
                               (let [declaration (ts-child ast initializer 0)]
                                 (and (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION)
                                      (and (= (ts-child-count ast declaration) 1)
                                           (fe-array-binding-pattern-valid?
                                             ast (ts-role ast declaration TS-ROLE-NAME 0)))))))))))))

(defn fe-validate-node! [(frontend (mut NativeFrontend))
                         (node i64)
                         (targets (mut (ArrayList FeTarget)))] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (and (= kind TSK-CALL)
               (let [callee (ts-child ast node 0)]
                 (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                      (and (= (ts-text ast (ts-child ast callee 0)) "Math")
                           (< (jbi-find (ts-text ast callee)) 0)))))
            (fe-fail! (mut frontend) FE-CODE-UNKNOWN-BUILTIN node TS-ROLE-CALLEE)
          (= kind TSK-REGEXP-LITERAL)
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX node 0)
          (= kind TSK-TRY)
            (let [catch-clause (ts-role ast node TS-ROLE-CATCH 0)
                  finally-block (ts-role ast node TS-ROLE-FINALLY 0)]
              ;; Catchable exceptions land first without pretending `finally` is an ordinary
              ;; trailing block: `finally` must run on return, throw, break and continue, and the
              ;; graph builder does not implement that completion-record machinery yet.
              (if (or (= catch-clause -1) (!= finally-block -1))
                  (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX node
                            (if (!= finally-block -1) TS-ROLE-FINALLY TS-ROLE-CATCH))
                  (let [(mut index) 0]
                    (loop (if (or (>= (load index) (ts-child-count ast node))
                                  (!= (load (field frontend status)) FE-OK))
                              (break)
                              (do (fe-validate-node! (mut frontend)
                                                     (ts-child ast node (load index))
                                                     (mut targets))
                                  (store! index (+ (load index) 1))))))))
          (and (= kind TSK-BINARY) (not (fe-supported-binary? ast node)))
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-OPERATOR node TS-ROLE-OPERATOR)
          (and (= kind TSK-PREFIX-UNARY) (not (fe-supported-prefix? ast node)))
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-OPERATOR node TS-ROLE-OPERATOR)
          (and (= kind TSK-POSTFIX-UNARY) (not (fe-supported-postfix? ast node)))
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-OPERATOR node TS-ROLE-OPERATOR)
          (= kind TSK-DELETE-EXPRESSION)
            (let [target (ts-role ast node TS-ROLE-EXPRESSION 0)]
              (if (and (!= target -1)
                       (or (= (ts-kind ast target) TSK-PROPERTY-ACCESS)
                           (= (ts-kind ast target) TSK-ELEMENT-ACCESS)))
                  (fe-validate-node! (mut frontend) target (mut targets))
                  (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX node TS-ROLE-EXPRESSION)))
          (= kind TSK-ELEMENT-ACCESS)
            (let [(mut index) 0]
              (loop (if (or (!= (load (field frontend status)) FE-OK)
                            (>= (load index) (ts-child-count ast node)))
                        (break)
                        (do
                          (let [child (ts-child ast node (load index))]
                            (if (and (= (load index) 1) (= (ts-kind ast child) TSK-STRING-LITERAL))
                                0
                                (fe-validate-node! (mut frontend) child (mut targets))))
                          (store! index (+ (load index) 1)))))
              0)
          (fe-function-expression-kind? kind)
            (let [(mut nested-targets) (al-new [FeTarget] (malloc-allocator))
                  body (ts-role ast node TS-ROLE-BODY 0)]
              ;; Abrupt-control targets never cross a function boundary.
              (fe-validate-node! (mut frontend) body (mut nested-targets))
              (al-free! [FeTarget] (mut nested-targets))
              0)
          (or (= kind TSK-BREAK) (= kind TSK-CONTINUE))
            (if (fe-target-valid? frontend targets node (= kind TSK-CONTINUE))
                0
                (do
                  (store! (field frontend status) FE-TARGET)
                  (store! (field frontend error-code) FE-CODE-INVALID-TARGET)
                  (store! (field frontend error-node) node)
                  (store! (field frontend error-role) TS-ROLE-LABEL)))
          (= kind TSK-LABELED)
            (let [label (ts-role ast node TS-ROLE-LABEL 0)
                  statement (ts-role ast node TS-ROLE-STATEMENT 0)
                  statement-kind (ts-kind ast statement)]
              (if (fe-active-label? frontend targets label)
                  (do
                    (store! (field frontend status) FE-TARGET)
                    (store! (field frontend error-code) FE-CODE-INVALID-TARGET)
                    (store! (field frontend error-node) label)
                    (store! (field frontend error-role) TS-ROLE-LABEL))
                  (do
                    (al-push! [FeTarget]
                              (mut targets)
                              (fe-target-make label
                                              true
                                              (or (= statement-kind TSK-DO)
                                                  (or (= statement-kind TSK-WHILE)
                                                      (or (= statement-kind TSK-FOR)
                                                          (or (= statement-kind TSK-FOR-OF)
                                                              (= statement-kind TSK-FOR-IN)))))))
                    (fe-validate-node! (mut frontend) statement (mut targets))
                    (store! (field targets len) (- (al-len [FeTarget] (load targets)) 1)))))
          (and (or (= kind TSK-FOR-OF) (= kind TSK-FOR-IN))
               (not (fe-for-enumeration-binding-valid? ast node)))
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX node TS-ROLE-INITIALIZER)
          ;; `for await (x of xs)` is refused HERE rather than by the graph builder's kind-0
          ;; abort. Same answer, three differences that matter: the message names the construct,
          ;; the refusal is recoverable, and a test can therefore observe it.
          (= kind TSK-FOR-AWAIT)
            (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX node TS-ROLE-EXPRESSION)
          (or (= kind TSK-DO)
              (or (= kind TSK-WHILE)
                  (or (= kind TSK-FOR)
                      (or (= kind TSK-FOR-OF) (= kind TSK-FOR-IN)))))
            (let [(mut index) 0]
              (al-push! [FeTarget] (mut targets) (fe-target-make -1 true true))
              (loop (if (or (>= (load index) (ts-child-count ast node))
                            (!= (load (field frontend status)) FE-OK))
                        (break)
                        (do
                          (fe-validate-node! (mut frontend) (ts-child ast node (load index)) (mut targets))
                          (store! index (+ (load index) 1)))))
              (store! (field targets len) (- (al-len [FeTarget] (load targets)) 1)))
          (= kind TSK-SWITCH)
            (let [(mut index) 0]
              (al-push! [FeTarget] (mut targets) (fe-target-make -1 true false))
              (loop (if (or (>= (load index) (ts-child-count ast node))
                            (!= (load (field frontend status)) FE-OK))
                        (break)
                        (do
                          (fe-validate-node! (mut frontend) (ts-child ast node (load index)) (mut targets))
                          (store! index (+ (load index) 1)))))
              (store! (field targets len) (- (al-len [FeTarget] (load targets)) 1)))
          :else
            (let [(mut index) 0]
              (loop (if (or (!= (load (field frontend status)) FE-OK)
                            (>= (load index) (ts-child-count ast node)))
                        (break)
                        (do
                          (fe-validate-node! (mut frontend) (ts-child ast node (load index)) (mut targets))
                          (store! index (+ (load index) 1)))))))
    (.status frontend)))

(defn fe-validate-supported! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [(mut targets) (al-new [FeTarget] (malloc-allocator))]
    (fe-validate-node! (mut frontend) node (mut targets))
    (al-free! [FeTarget] (mut targets))
    (.status frontend)))

(defn fe-type-name [(frontend (ptr NativeFrontend)) (index i64)] (-> (slice u8))
  (let [type (al-get [FeTypeDecl] (.types frontend) index)]
    (ts-text (field frontend ast) (.name-node type))))

(defn fe-field-name [(frontend (ptr NativeFrontend)) (index i64)] (-> (slice u8))
  (let [field-value (al-get [FeField] (.fields frontend) index)]
    (ts-text (field frontend ast) (.name-node field-value))))

(defn fe-type-index-for-name-node [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [name (ts-text (field frontend ast) name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeTypeDecl] (.types frontend))) (!= (load answer) -1))
              (break)
              (if (= name (fe-type-name frontend (load index)))
                  (set! answer (load index))
                  (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-type-index-for-node [(frontend (ptr NativeFrontend)) (type-node i64)] (-> i64)
  (if (= type-node -1)
      -1
      (let [ast (field frontend ast)
            kind (ts-kind ast type-node)]
        (if (= kind TSK-TYPE-REFERENCE)
            (fe-type-index-for-name-node frontend (ts-child-of-kind ast type-node TSK-IDENTIFIER))
            -1))))

(defn fe-type-index-for-decl-node [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [(mut index) 0 (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeTypeDecl] (.types frontend)))
                  (!= (load answer) -1))
              (break)
              (let [type (al-get [FeTypeDecl] (.types frontend) (load index))]
                (if (= (.node type) node) (set! answer (load index)) 0)
                (set! index (+ (load index) 1)))))
    ;; `fe-index-object-layouts!` DEDUPES structurally identical literals: only the first
    ;; occurrence of a layout gets a declaration, and later literals were resolved to -1 here —
    ;; so the CALLEE read a parameter through the first literal's static shape while the call
    ;; site built its identical literal DYNAMICALLY (fixed-slot loads over dynamic property
    ;; storage; object-parameters returned 7000064 for 1507052134 in JS mode). Resolve them by
    ;; the same structural criterion the dedup used.
    (if (>= (load answer) 0)
        (load answer)
        (let [ast (field frontend ast)]
          (if (or (< node 0) (!= (ts-kind ast node) TSK-OBJECT-LITERAL))
              -1
              (let [(mut eligible) true
                    (mut property-at) 0]
                (loop (if (or (not (load eligible))
                              (>= (load property-at) (ts-child-count ast node)))
                          (break)
                          (let [property (ts-child ast node (load property-at))]
                            (if (or (!= (ts-kind ast property) TSK-PROPERTY-ASSIGNMENT)
                                    (= (ts-kind ast (ts-child ast property 0))
                                       TSK-COMPUTED-PROPERTY-NAME))
                                (set! eligible false)
                                0)
                            (set! property-at (+ (load property-at) 1)))))
                (if (or (not (load eligible)) (= (ts-child-count ast node) 0))
                    -1
                    (let [(mut type-at) 0
                          (mut found) -1]
                      (loop (if (or (>= (load type-at)
                                        (al-len [FeTypeDecl] (.types frontend)))
                                    (>= (load found) 0))
                                (break)
                                (let [decl (al-get [FeTypeDecl] (.types frontend)
                                                   (load type-at))
                                      (mut same) (= (.field-count decl)
                                                    (ts-child-count ast node))
                                      (mut field-at) 0]
                                  (loop (if (or (not (load same))
                                                (>= (load field-at) (ts-child-count ast node)))
                                            (break)
                                            (let [property (ts-child ast node (load field-at))
                                                  field (al-get [FeField]
                                                                (.fields frontend)
                                                                (+ (.field-start decl)
                                                                   (load field-at)))]
                                              (if (not (= (ts-text ast (ts-child ast property 0))
                                                          (ts-text ast
                                                                   (.name-node field))))
                                                  (set! same false)
                                                  0)
                                              (set! field-at (+ (load field-at) 1)))))
                                  (if (load same) (set! found (load type-at)) 0)
                                  (set! type-at (+ (load type-at) 1)))))
                      (load found)))))))))

(defn fe-index-type! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        owner (al-len [FeTypeDecl] (.types frontend))
        name (ts-child-of-kind ast node TSK-IDENTIFIER)
        start (al-len [FeField] (.fields frontend))
        kind (ts-kind ast node)
        layout (if (= kind TSK-TYPE-ALIAS-DECLARATION) (ts-child-of-kind ast node TSK-TYPE-LITERAL) node)
        (mut index) 0
        (mut count) 0]
    (loop (if (or (= layout -1) (>= (load index) (ts-child-count ast layout)))
              (break)
              (let [member (ts-child ast layout (load index))]
                (if (= (ts-kind ast member) TSK-PROPERTY-SIGNATURE)
                    (let [field-name (ts-child-of-kind ast member TSK-IDENTIFIER)
                          type-node (if (> (ts-child-count ast member) 1) (ts-child ast member 1) -1)]
                      (al-push! [FeField]
                                (mut (.fields frontend))
                                (fe-field-make owner member field-name type-node))
                      (set! count (+ (load count) 1)))
                    0)
                (set! index (+ (load index) 1)))))
    (al-push! [FeTypeDecl]
              (mut (.types frontend))
              (fe-type-make node name start (load count)))
    0))

;; Index simple fixed-key literals before graph construction. Computed names and non-property
;; members retain the fully dynamic dictionary path.
(defn fe-object-layout-inference-safe? [(frontend (ptr NativeFrontend)) (node i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut safe) true
        (mut index) 0]
    (if (or (= kind TSK-ELEMENT-ACCESS)
            (or (= kind TSK-DELETE-EXPRESSION)
                (or (and (= kind TSK-PROPERTY-ACCESS)
                         (!= (ts-role ast node TS-ROLE-OPERATOR 0) -1))
                    (and (= kind TSK-BINARY)
                         (let [operator (ts-text ast (ts-child ast node 1))]
                           (or (= operator "in") (= operator "instanceof")))))))
        (set! safe false) 0)
    ;; JSON and Object enumeration/assignment consume the complete ordinary property surface.
    (if (and (load safe) (= kind TSK-IDENTIFIER))
        (let [name (ts-text ast node)]
          (if (or (= name "JSON")
                  (or (= name "Object") (= name "String")))
              (set! safe false) 0)) 0)
    ;; An object spread enumerates its source the same way Object.assign does, and the
    ;; enumeration primitives read the runtime property table -- shape slots are invisible to
    ;; them. A spread element arrives as bridge kind 0 with source text starting `...` (a bare
    ;; kind 0 with an empty extent is an array elision and stays safe).
    (if (and (load safe) (= kind 0))
        (let [text (ts-text ast node)]
          (if (and (>= (slice-len text) 3) (= (substr text 0 3) "..."))
              (set! safe false) 0)) 0)
    (loop (if (or (not (load safe)) (>= (load index) (ts-child-count ast node)))
              (break)
              (do (set! safe
                        (fe-object-layout-inference-safe? frontend
                                                          (ts-child ast node (load index))))
                  (set! index (+ (load index) 1)))))
    (load safe)))

(defn fe-index-object-layouts! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        (mut eligible) (= (ts-kind ast node) TSK-OBJECT-LITERAL)
        (mut index) 0]
    (if (and (load eligible)
             (not (fe-object-layout-inference-safe? frontend (ts-root ast))))
        (set! eligible false) 0)
    (if (load eligible)
        (loop (if (>= (load index) (ts-child-count ast node))
                  (break)
                  (let [property (ts-child ast node (load index))]
                    (if (or (not (or (= (ts-kind ast property) TSK-PROPERTY-ASSIGNMENT)
                                     (or (= (ts-kind ast property) TSK-METHOD-DECLARATION)
                                         (= (ts-kind ast property) TSK-SHORTHAND-PROPERTY-ASSIGNMENT))))
                            (= (ts-kind ast (ts-child ast property 0)) TSK-COMPUTED-PROPERTY-NAME))
                        (set! eligible false) 0)
                    (set! index (+ (load index) 1))))) 0)
    ;; A structurally identical named declaration already supplies the layout for
    ;; contextually typed literals. Do not add a second anonymous declaration.
    (if (load eligible)
        (let [(mut type-at) 0]
          (loop (if (or (not (load eligible))
                        (>= (load type-at) (al-len [FeTypeDecl] (.types frontend))))
                    (break)
                    (let [decl (al-get [FeTypeDecl] (.types frontend) (load type-at))
                          (mut same) (= (.field-count decl) (ts-child-count ast node))
                          (mut field-at) 0]
                      (loop (if (or (not (load same))
                                    (>= (load field-at) (ts-child-count ast node)))
                                (break)
                                (let [property (ts-child ast node (load field-at))
                                      field (al-get [FeField] (.fields frontend)
                                                    (+ (.field-start decl) (load field-at)))]
                                  (if (not (= (ts-text ast (ts-child ast property 0))
                                              (ts-text ast (.name-node field))))
                                      (set! same false) 0)
                                  (set! field-at (+ (load field-at) 1)))))
                      (if (load same) (set! eligible false) 0)
                      (set! type-at (+ (load type-at) 1))))))
        0)
    (if (and (load eligible) (> (ts-child-count ast node) 0))
        (let [owner (al-len [FeTypeDecl] (.types frontend))
              start (al-len [FeField] (.fields frontend))]
          (set! index 0)
          (loop (if (>= (load index) (ts-child-count ast node))
                    (break)
                    (let [property (ts-child ast node (load index))]
                      (al-push! [FeField]
                                (mut (.fields frontend))
                                (fe-field-make owner property
                                               (ts-child ast property 0)
                                               (fe-object-property-value-node ast property)))
                      (set! index (+ (load index) 1)))))
          (al-push! [FeTypeDecl] (mut (.types frontend))
                    (fe-type-make node node start (ts-child-count ast node)))) 0)
    (set! index 0)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (do (fe-index-object-layouts! (mut frontend) (ts-child ast node (load index)))
                  (set! index (+ (load index) 1)))))
    0))

(defn fe-resolution-symbol [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (if (or (< node 0) (>= node (al-len [i64] (.resolution-symbols frontend))))
      -1
      (al-get [i64] (.resolution-symbols frontend) node)))

(defn fe-function-for-node [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend)))
                  (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (= (.node fn) node) (set! answer (load index)) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-symbol-owner [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load answer) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) symbol-id)
                    (set! answer (.owner symbol))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-symbol-role [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) 0]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load answer) 0))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) symbol-id)
                    (set! answer (.role symbol))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-record-capture! [(frontend (mut NativeFrontend)) (function i64) (symbol i64)] (-> i64)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (.captures frontend)))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.function capture) function)
                         (= (.symbol capture) symbol))
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (if (not (load found))
        (al-push! [FeCapture] (mut (.captures frontend)) (fe-capture-make function symbol))
        0)
    symbol))

(defn fe-mark-capture-mutable! [(frontend (mut NativeFrontend)) (symbol i64)] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) (al-len [FeCapture] (.captures frontend)))
              (break)
              (do
                (if (= (.symbol (index (load (field (field frontend captures) data))
                                       (load index)))
                       symbol)
                    (set! (.mutable (index (load (field (field frontend captures) data))
                                           (load index)))
                          true)
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fe-assignment-operator? [(ast TsAst) (node i64)] (-> bool)
  (let [operator-node (ts-role ast node TS-ROLE-OPERATOR 0)
        operator (if (= operator-node -1) "" (ts-text ast operator-node))]
    (or (= operator "=")
        (= operator "+=")
        (= operator "-=")
        (= operator "*=")
        (= operator "/=")
        (= operator "%=")
        (= operator "&=")
        (= operator "|=")
        (= operator "^=")
        (= operator "<<=")
        (= operator ">>=")
        (= operator ">>>="))))

(defn fe-mark-mutations! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut target) -1]
    (if (and (= kind TSK-BINARY) (fe-assignment-operator? ast node))
        (set! target (ts-role ast node TS-ROLE-LEFT 0))
        (if (or (= kind TSK-PREFIX-UNARY) (= kind TSK-POSTFIX-UNARY))
            (let [text (ts-text ast node)]
              (if (or (= (substr text 0 2) "++")
                      (or (= (substr text 0 2) "--")
                          (or (= (substr text (- (slice-len text) 2) (slice-len text)) "++")
                              (= (substr text (- (slice-len text) 2) (slice-len text)) "--"))))
                  (set! target (ts-role ast node TS-ROLE-EXPRESSION 0))
                  0))
            0))
    (if (and (!= (load target) -1) (= (ts-kind ast (load target)) TSK-IDENTIFIER))
        (let [symbol (fe-resolution-symbol frontend (load target))]
          (if (!= symbol -1) (fe-mark-capture-mutable! (mut frontend) symbol) 0))
        0)
    (let [(mut index) 0]
      (loop (if (>= (load index) (ts-child-count ast node))
                (break)
                (do
                  (fe-mark-mutations! (mut frontend) (ts-child ast node (load index)))
                  (set! index (+ (load index) 1))))))
    0))

(defn fe-function-name [(frontend (ptr NativeFrontend)) (index i64)] (-> (slice u8))
  (let [fn (al-get [FeFunction] (.functions frontend) index)]
    (ts-text (field frontend ast) (.name-node fn))))

(defn fe-prototype-method-make [(constructor i64) (name-node i64) (target i64)] (-> FePrototypeMethod)
  (FePrototypeMethod :constructor constructor :name-node name-node :target target))

(defn fe-prototype-parent-make [(constructor i64) (parent i64)] (-> FePrototypeParent)
  (FePrototypeParent :constructor constructor :parent parent))

(defn fe-index-prototype-method! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (= (ts-kind ast node) TSK-BINARY)
        (let [operator-node (ts-role ast node TS-ROLE-OPERATOR 0)
              left (ts-role ast node TS-ROLE-LEFT 0)
              right (ts-role ast node TS-ROLE-RIGHT 0)]
          (if (and (!= operator-node -1)
                   (and (= (ts-text ast operator-node) "=")
                        (and (!= left -1) (= (ts-kind ast left) TSK-PROPERTY-ACCESS))))
              (let [base (ts-child ast left 0)
                    method-name (ts-child ast left 1)]
                (if (= (ts-kind ast base) TSK-PROPERTY-ACCESS)
                    (let [constructor-name (ts-child ast base 0)
                          prototype-name (ts-child ast base 1)
                          constructor (fe-find-function-name frontend constructor-name)
                          target
                            (if (= right -1)
                                -1
                                (if (= (ts-kind ast right) TSK-IDENTIFIER)
                                    (fe-find-function-name frontend right)
                                    (if (fe-function-expression-kind? (ts-kind ast right))
                                        (let [function-index (fe-function-for-node frontend right)]
                                          (if (>= function-index 0)
                                              (.id (index (load (field (field frontend functions) data))
                                                          function-index))
                                              -1))
                                        -1)))]
                      (if (and (= (ts-text ast prototype-name) "prototype")
                               (and (>= constructor 0) (>= target 0)))
                          (do
                            ; Prototype method ABI always carries the receiver, even when this
                            ; particular body does not read `this` (for example an empty abstract
                            ; hook). Call sites cannot vary arity based on body usage.
                            (if (= (.receiver-type-node (index (load (field (field frontend functions) data))
                                                               target))
                                   -1)
                                (set! (.receiver-type-node (index (load (field (field frontend functions) data))
                                                                  target))
                                      FE-RECEIVER-DYNAMIC)
                                0)
                            (al-push! [FePrototypeMethod]
                                      (mut (.prototype-methods frontend))
                                      (fe-prototype-method-make constructor method-name target)))
                          0))
                    0))
              0))
        0)
    (if (or (= kind TSK-FUNCTION-DECLARATION) (fe-function-expression-kind? kind))
        0
        (let [(mut index) 0]
          (loop (if (>= (load index) (ts-child-count ast node))
                    (break)
                    (do
                      (fe-index-prototype-method! (mut frontend) (ts-child ast node (load index)))
                      (set! index (+ (load index) 1)))))))
    0))

;; A single-level `obj.name = f` (NavierStokes stores `this.reset = reset` inside FluidField)
;; publishes a KNOWN function as a method. Its property-call sites use the receiver ABI, so the
;; target must carry the receiver slot even when its body never reads `this` — the same rule the
;; prototype indexer states. Unlike prototype indexing this walks into function bodies, because
;; constructor-style publication happens inside the constructor.
(defn fe-mark-property-published-functions! [(frontend (mut NativeFrontend))
                                             (node i64)
                                             (enclosing i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut child-enclosing) enclosing]
    (if (or (= kind TSK-FUNCTION-DECLARATION) (fe-function-expression-kind? kind))
        (let [function-index (fe-function-for-node frontend node)]
          (if (>= function-index 0)
              (let [fn (al-get [FeFunction] (.functions frontend) function-index)]
                (set! child-enclosing (.id fn)))
              0))
        0)
    (if (= kind TSK-BINARY)
        (let [operator-node (ts-role ast node TS-ROLE-OPERATOR 0)
              left (ts-role ast node TS-ROLE-LEFT 0)
              right (ts-role ast node TS-ROLE-RIGHT 0)]
          (if (and (!= operator-node -1)
                   (and (= (ts-text ast operator-node) "=")
                        (and (!= left -1)
                             (and (= (ts-kind ast left) TSK-PROPERTY-ACCESS)
                                  (and (!= right -1)
                                       (!= (ts-kind ast (ts-child ast left 0))
                                           TSK-PROPERTY-ACCESS))))))
              (let [target
                      (if (= (ts-kind ast right) TSK-IDENTIFIER)
                          (fe-find-function-name frontend right)
                          (if (fe-function-expression-kind? (ts-kind ast right))
                              (let [function-index (fe-function-for-node frontend right)]
                                (if (>= function-index 0)
                                    (.id (index (load (field (field frontend functions)
                                                             data))
                                                function-index))
                                    -1))
                              -1))]
                (if (>= target 0)
                    (do
                      (if (= (.receiver-type-node (index (load (field (field frontend functions) data))
                                                         target))
                             -1)
                          (set! (.receiver-type-node (index (load (field (field frontend functions) data))
                                                            target))
                                FE-RECEIVER-DYNAMIC)
                          0)
                      ; `this.NAME = f` inside constructor F publishes a method of F: record it
                      ; so name-keyed dispatch (finite target summaries and the identity chain)
                      ; knows this name can reach this target at runtime.
                      (if (and (>= enclosing 0)
                               (= (ts-kind ast (ts-child ast left 0)) TSK-THIS))
                          (al-push! [FePrototypeMethod]
                                    (mut (.prototype-methods frontend))
                                    (fe-prototype-method-make enclosing
                                                              (ts-child ast left 1)
                                                              target))
                          0))
                    0))
              0))
        0)
    (let [(mut index) 0]
      (loop (if (>= (load index) (ts-child-count ast node))
                (break)
                (do
                  (fe-mark-property-published-functions! (mut frontend)
                                                         (ts-child ast node (load index))
                                                         (load child-enclosing))
                  (set! index (+ (load index) 1))))))
    0))

(defn fe-index-prototype-parent! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)]
    (if (= (ts-kind ast node) TSK-CALL)
        (let [callee (ts-child ast node 0)]
          (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                   (and (= (ts-text ast (ts-child ast callee 1)) "inheritsFrom")
                        (> (ts-child-count ast node) 1)))
              (let [constructor (fe-find-function-name frontend (ts-child ast callee 0))
                    parent (fe-find-function-name frontend (ts-child ast node 1))]
                (if (and (>= constructor 0) (>= parent 0))
                    (al-push! [FePrototypeParent]
                              (mut (.prototype-parents frontend))
                              (fe-prototype-parent-make constructor parent))
                    0))
              0))
        0)
    (if (or (= (ts-kind ast node) TSK-FUNCTION-DECLARATION)
            (fe-function-expression-kind? (ts-kind ast node)))
        0
        (let [(mut index) 0]
          (loop (if (>= (load index) (ts-child-count ast node))
                    (break)
                    (do
                      (fe-index-prototype-parent! (mut frontend) (ts-child ast node (load index)))
                      (set! index (+ (load index) 1)))))))
    0))

(defn fe-prototype-target? [(frontend (ptr NativeFrontend)) (function-id i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index)
                      (al-len [FePrototypeMethod] (.prototype-methods frontend)))
                  (load found))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load index))]
                (if (= (.target method) function-id) (set! found true) 0)
                (set! index (+ (load index) 1)))))
    (load found)))

; Finite polymorphic types use 63 target bits. Keep every dynamically published prototype method
; in that compact namespace; exact-only functions may retain larger IDs because Fun/Closure nodes
; carry their full identity independently of the summary type.
(defn fe-prioritize-prototype-functions! [(frontend (mut NativeFrontend))] (-> i64)
  (let [count (al-len [FeFunction] (.functions frontend))
        (mut mapping) (al-new [i64] (malloc-allocator))
        (mut reordered) (al-new [FeFunction] (malloc-allocator))
        (mut index) 0
        (mut pass) 0]
    (loop (if (>= (load index) count)
              (break)
              (do (al-push! [i64] (mut mapping) -1) (set! index (+ (load index) 1)))))
    (loop (if (>= (load pass) 2)
              (break)
              (do
                (set! index 0)
                (loop (if (>= (load index) count)
                          (break)
                          (let [fn
                                  (al-get [FeFunction]
                                          (.functions frontend)
                                          (load index))
                                old-id (.id fn)
                                dynamic (fe-prototype-target? frontend old-id)]
                            (if (= dynamic (= (load pass) 0))
                                (let [new-id (al-len [FeFunction] (load reordered))
                                      copy (primitive/alloc-stack FeFunction)
                                      (mut symbol-index) 0
                                      (mut declaration-symbol) old-id]
                                  (set! copy fn)
                                  ; Callable ids and lexical binding ids are separate namespaces
                                  ; after dispatch compaction. Recover the declaration's stable
                                  ; symbol from its exact name node before changing the callable id.
                                  (loop (if (>= (load symbol-index)
                                               (al-len [FeSymbol] (.symbols frontend)))
                                            (break)
                                            (let [symbol
                                                    (al-get [FeSymbol]
                                                            (.symbols frontend)
                                                            (load symbol-index))]
                                              (if (and (>= (.name-node fn) 0)
                                                       (= (.name-node symbol)
                                                          (.name-node fn)))
                                                  (do (set! declaration-symbol (.id symbol))
                                                      (break)) 0)
                                              (set! symbol-index (+ (load symbol-index) 1)))))
                                  (al-set! [i64] (mut mapping) old-id new-id)
                                  (set! (.id copy) new-id)
                                  (set! (.source-id copy) (load declaration-symbol))
                                  (al-push! [FeFunction] (mut reordered) (load copy)))
                                0)
                            (set! index (+ (load index) 1)))))
                (set! pass (+ (load pass) 1)))))
    (set! index 0)
    (loop (if (>= (load index) count)
              (break)
              (let [fn (index (load (field reordered data)) (load index))
                    parent (.parent fn)]
                (if (>= parent 0) (set! (.parent fn) (al-get [i64] (load mapping) parent)) 0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (index (load (field (field frontend symbols) data)) (load index))
                    owner (.owner symbol)]
                (if (and (>= owner 0) (< owner count))
                    (set! (.owner symbol) (al-get [i64] (load mapping) owner))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (al-len [FeCapture] (.captures frontend)))
              (break)
              (let [capture (index (load (field (field frontend captures) data)) (load index))]
                (set! (.function capture) (al-get [i64] (load mapping) (.function capture)))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (index (load (field (field frontend prototype-methods) data))
                             (load index))]
                (set! (.constructor method) (al-get [i64] (load mapping) (.constructor method)))
                (set! (.target method) (al-get [i64] (load mapping) (.target method)))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index)
                  (al-len [FePrototypeParent] (.prototype-parents frontend)))
              (break)
              (let [relation
                      (index (load (field (field frontend prototype-parents) data))
                             (load index))]
                (set! (.constructor relation) (al-get [i64] (load mapping) (.constructor relation)))
                (set! (.parent relation) (al-get [i64] (load mapping) (.parent relation)))
                (set! index (+ (load index) 1)))))
    (al-free! [FeFunction] (mut (.functions frontend)))
    (set! (.functions frontend) (load reordered))
    (al-free! [i64] (mut mapping))
    0))

(defn fe-uses-implicit-this? [(ast TsAst) (node i64)] (-> bool)
  (let [kind (ts-kind ast node)]
    (if (= kind TSK-THIS)
        true
        ; Arrows inherit `this`, so they remain transparent to the enclosing receiver scan.
        (if (or (= kind TSK-FUNCTION-DECLARATION)
                (or (= kind TSK-FUNCTION-EXPRESSION) (= kind TSK-METHOD-DECLARATION)))
            false
            (let [(mut index) 0
                  (mut found) false]
              (loop (if (or (>= (load index) (ts-child-count ast node)) (load found))
                        (break)
                        (do
                          (if (fe-uses-implicit-this? ast (ts-child ast node (load index)))
                              (set! found true)
                              0)
                          (set! index (+ (load index) 1)))))
              (load found))))))

;; A REST PARAMETER, DETECTED FROM ITS OWN SOURCE TEXT. Nothing in this frontend implements one,
;; and until this check existed nothing noticed: `...xs` was indexed as an ordinary parameter named
;; `xs`, the call site passed it nothing, and every read came back undefined. `xs.length` was
;; therefore `undefined`, and `undefined | 0` is 0 -- so `(...xs) => xs.length` returned zero for
;; every call, with a well-formed graph and no diagnostic anywhere.
;;
;; That is the worst outcome available: a wrong answer nothing signals. Refusing by name is not the
;; feature, but it is the difference between "this is not supported" and a number that is quietly
;; false. repros/open/rest-parameters-report-length-zero.js.
;;
;; The text, not a token kind: the bridge maps every syntax it does not enumerate to kind 0, so a
;; `DotDotDotToken` is not reliably distinguishable from anything else it has not been taught. The
;; parameter's extent always begins with the ellipsis when one is present.
(defn fe-rest-parameter? [(ast TsAst) (parameter i64)] (-> bool)
  (let [t (ts-text ast parameter)]
    (and (>= (slice-len t) 3)
         (and (= (slice-get t 0) 46)
              (and (= (slice-get t 1) 46) (= (slice-get t 2) 46))))))

(defn fe-find-function-parts! [(frontend (mut NativeFrontend)) (node i64) (id i64) (parent i64)] (-> i64)
  (let [ast (field frontend ast)
        ;; Function metadata comes from semantic roles, never child position. Arrow functions add
        ;; an `=>` token to their child stream; treating every non-parameter child as a return type
        ;; makes that token overwrite the declared result and corrupts the native call ABI.
        (mut name) (ts-role ast node TS-ROLE-NAME 0)
        (mut body) (ts-role ast node TS-ROLE-BODY 0)
        (mut result) (ts-role ast node TS-ROLE-TYPE 0)
        (mut receiver-type) -1
        (mut parameter-start) (al-len [FeSymbol] (.symbols frontend))
        (mut parameter-count) 0
        (mut index) 0]
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [child (ts-child ast node (load index))
                    kind (ts-kind ast child)]
                (if (= kind TSK-PARAMETER)
                    (let [parameter-name (ts-role ast child TS-ROLE-NAME 0)
                          type-node (ts-role ast child TS-ROLE-TYPE 0)]
                      (if (fe-rest-parameter? ast child)
                          (fe-fail! (mut frontend) FE-CODE-UNSUPPORTED-SYNTAX child FE-ROLE-PARAMETER)
                          0)
                      (if (and (!= parameter-name -1)
                               (or (= (ts-kind ast parameter-name) TSK-THIS)
                                   (= (ts-text ast parameter-name) "this")))
                          (set! receiver-type type-node)
                          (let [sid (al-len [FeSymbol] (.symbols frontend))]
                            (al-push! [FeSymbol]
                                      (mut (.symbols frontend))
                                      (fe-symbol-make sid child parameter-name id FE-ROLE-PARAMETER type-node))
                            (set! parameter-count (+ (load parameter-count) 1)))))
                    0)
                (set! index (+ (load index) 1)))))
    (let [arrow (= (ts-kind ast node) TSK-ARROW-FUNCTION)
          lexical-this
            (and arrow
                 (and (!= (load body) -1)
                      (fe-uses-implicit-this? ast (load body))))]
      ; The lexical receiver keeps its enclosing static type even though it is transported as a
      ; closure capture rather than as this function's receiver ABI slot.
      (if (and lexical-this (>= parent 0))
          (set! receiver-type
                (.receiver-type-node (index (load (field (field frontend functions) data)) parent)))
          0)
      (if (and (= (load receiver-type) -1)
               (and (not arrow)
                    (and (!= (load body) -1) (fe-uses-implicit-this? ast (load body)))))
          (set! receiver-type FE-RECEIVER-DYNAMIC)
          0)
      (al-push! [FeFunction]
                (mut (.functions frontend))
                (fe-function-make id
                                  node
                                  parent
                                  (load name)
                                  (load body)
                                  (load result)
                                  (load receiver-type)
                                  arrow
                                  lexical-this
                                  (load parameter-start)
                                  (load parameter-count))))
    0))

;; Function identities are allocated in syntax preorder before any parameter or local identity.
;; A nested expression records the immediately enclosing function, not merely the source file.
(defn fe-index-functions! [(frontend (mut NativeFrontend)) (node i64) (parent i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut child-parent) parent]
    (if (or (= kind TSK-FUNCTION-DECLARATION) (fe-function-expression-kind? kind))
        (let [id (al-len [FeFunction] (.functions frontend))]
          (fe-find-function-parts! (mut frontend) node id parent)
          (set! child-parent id))
        0)
    (let [(mut index) 0]
      (loop (if (>= (load index) (ts-child-count ast node))
                (break)
                (do
                  (fe-index-functions! (mut frontend)
                                       (ts-child ast node (load index))
                                       (load child-parent))
                  (set! index (+ (load index) 1))))))
    0))

;; One declaration may introduce several lexical names. Symbols retain the declaration node for
;; the ordinary one-name case (many existing queries use that identity), while pattern leaves use
;; their identifier node as the unique declaration identity.
(defn fe-index-binding-names! [(frontend (mut NativeFrontend))
                               (declaration i64)
                               (name i64)
                               (owner i64)
                               (role i64)
                               (type-node i64)
                               (symbol-base i64)] (-> i64)
  (let [ast (field frontend ast) kind (ts-kind ast name)]
    (if (= kind TSK-IDENTIFIER)
        (let [sid (+ symbol-base (al-len [FeSymbol] (.symbols frontend)))
              identity (if (= (ts-kind ast (ts-role ast declaration TS-ROLE-NAME 0)) TSK-IDENTIFIER)
                           declaration name)]
          (al-push! [FeSymbol]
                    (mut (.symbols frontend))
                    (fe-symbol-make sid identity name owner role type-node)))
        (if (or (= kind TSK-ARRAY-BINDING-PATTERN) (= kind TSK-OBJECT-BINDING-PATTERN))
            (let [(mut i) 0]
              (loop (if (>= (load i) (ts-child-count ast name)) (break)
                      (do (fe-index-binding-names! (mut frontend)
                                                   declaration
                                                   (ts-child ast name (load i))
                                                   owner role type-node symbol-base)
                          (set! i (+ (load i) 1))))))
            (if (= kind TSK-BINDING-ELEMENT)
                (let [nested (ts-role ast name TS-ROLE-NAME 0)]
                  (if (!= nested -1)
                      (fe-index-binding-names! (mut frontend)
                                               declaration nested owner role type-node symbol-base)
                      0))
                0))))
  0)

(defn fe-scan-locals! [(frontend (mut NativeFrontend)) (node i64) (owner i64) (symbol-base i64)] (-> i64)
  (let [ast (field frontend ast)]
    (if (= (ts-kind ast node) TSK-VARIABLE-DECLARATION)
        (let [name (ts-role ast node TS-ROLE-NAME 0)
              count (ts-child-count ast node)
              maybe-type (if (> count 2) (ts-child ast node 1) -1)]
          (fe-index-binding-names! (mut frontend) node name owner FE-ROLE-LOCAL maybe-type symbol-base))
        0)
    (if (fe-function-expression-kind? (ts-kind ast node))
        0
        (let [(mut index) 0]
          (loop (if (>= (load index) (ts-child-count ast node))
                    (break)
                    (do
                      (fe-scan-locals! (mut frontend) (ts-child ast node (load index)) owner symbol-base)
                      (set! index (+ (load index) 1)))))))
    0))

(defn fe-scan-globals! [(frontend (mut NativeFrontend)) (root i64) (owner i64) (symbol-base i64)] (-> i64)
  (let [ast (field frontend ast)
        (mut index) 0]
    (loop (if (>= (load index) (ts-child-count ast root))
              (break)
              (let [statement (ts-child ast root (load index))]
                (if (= (ts-kind ast statement) TSK-VARIABLE-STATEMENT)
                    (let [list (ts-child ast statement 0)
                          (mut declaration-index) 0]
                      (loop (if (>= (load declaration-index) (ts-child-count ast list))
                                (break)
                                (let [declaration (ts-child ast list (load declaration-index))
                                      name (ts-role ast declaration TS-ROLE-NAME 0)]
                                  (fe-index-binding-names! (mut frontend) declaration name owner
                                                           FE-ROLE-GLOBAL -1 symbol-base)
                                  (set! declaration-index (+ (load declaration-index) 1))))))
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fe-symbol-for-declaration [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend))) (!= (load answer) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.node symbol) node) (= (.owner symbol) owner))
                    (set! answer (.id symbol))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-symbol-for-binding-name [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> i64)
  (let [(mut index) 0 (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load answer) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.name-node symbol) node) (= (.owner symbol) owner))
                    (set! answer (.id symbol)) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-find-function-name [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1
        name (ts-text (field frontend ast) name-node)]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend))) (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (and (= (ts-kind (field frontend ast) (.node fn))
                            TSK-FUNCTION-DECLARATION)
                         (= name (ts-text (field frontend ast) (.name-node fn))))
                    (set! answer (.id fn))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

;; Declaration hoisting is lexical. A global name-only scan makes same-named declarations in
;; unrelated functions alias each other when several Test262 entries share one compilation unit.
(defn fe-find-function-name-in-owner [(frontend (ptr NativeFrontend))
                                      (name-node i64)
                                      (owner i64)] (-> i64)
  (let [name (ts-text (field frontend ast) name-node)
        (mut scope) owner
        (mut answer) -1
        (mut done) false]
    (loop (if (or (load done) (>= (load answer) 0))
              (break)
              (do
                (let [(mut index) 0]
                  (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend)))
                                (>= (load answer) 0))
                            (break)
                            (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                              (if (and (= (.parent fn) (load scope))
                                       (and (= (ts-kind (field frontend ast) (.node fn))
                                               TSK-FUNCTION-DECLARATION)
                                            (= name
                                               (ts-text (field frontend ast) (.name-node fn)))))
                                  (set! answer (.id fn))
                                  0)
                              (set! index (+ (load index) 1)))))
                (if (< (load scope) 0)
                    (set! done true)
                    (let [parent-fn
                            (al-get [FeFunction] (.functions frontend) (load scope))]
                      (set! scope (.parent parent-fn))))))))
    (load answer)))

(defn fe-main-id [(frontend (ptr NativeFrontend))] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend)))
                  (!= (load answer) -1))
              (break)
              (do
                (if (= (fe-function-name frontend (load index)) "main")
                    (set! answer
                          (.id (index (load (field (field frontend functions) data))
                                      (load index))))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-validate-receiver-abis! [(frontend (mut NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut target) -1]
    (if (= kind TSK-NEW-EXPRESSION)
        (do
          (set! target (fe-find-function-name frontend (ts-child ast node 0)))
          (if (>= (load target) 0)
              (let [fn (al-get [FeFunction] (.functions frontend) (load target))]
                ; Untyped JavaScript constructors deliberately acquire a dynamic receiver layout
                ; from their `this` writes and prototype publication. A declared return type with
                ; no receiver/object layout remains the B10 ABI error.
                (if (and (= (.receiver-type-node fn) -1)
                         (and (!= (.result-node fn) -1)
                              (= (fe-type-index-for-node frontend
                                                         (.result-node fn))
                                 -1)))
                    (fe-fail! (mut frontend) FE-CODE-CONSTRUCTOR-LAYOUT node TS-ROLE-CALLEE)
                    0))
              0))
        ;; `object.name()` does not resolve to an unrelated top-level declaration merely because
        ;; that declaration is also named `name`. The graph builder resolves indexed prototype
        ;; methods and otherwise loads the property dynamically. Treating a same-named helper as
        ;; the target rejected Test262's global `compareArray` alongside `assert.compareArray`.
        0)
    (let [(mut i) 0]
      (loop (if (or (>= (load i) (ts-child-count ast node))
                    (!= (.status frontend) FE-OK))
                (break)
                (do
                  (fe-validate-receiver-abis! (mut frontend) (ts-child ast node (load i)))
                  (set! i (+ (load i) 1))
                  0))))
    (.status frontend)))

(defn fe-resolve-name! [(frontend (mut NativeFrontend))
                        (bindings (ptr (ArrayList FeBinding)))
                        (node i64)
                        (owner i64)] (-> i64)
  (let [name (ts-text (field frontend ast) node)
        (mut index) (- (al-len [FeBinding] (load bindings)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (!= (load answer) -1))
              (break)
              (let [binding (al-get [FeBinding] (load bindings) (load index))]
                (if (= name (ts-text (field frontend ast) (.name-node binding)))
                    (set! answer (.symbol binding))
                    0)
                (set! index (- (load index) 1)))))
    (if (= (load answer) -1)
        (set! answer (fe-find-function-name-in-owner frontend node owner))
        0)
    (if (= (load answer) -1) (set! answer (fe-intrinsic-name name)) 0)
    ;; An unresolved identifier is a JavaScript runtime ReferenceError, not an indexing failure.
    ;; Keep a distinguished resolution so expression lowering can route it through the ordinary
    ;; source exception control (including a surrounding catch). Assignment/typeof apply their own
    ;; source-language rules at their lowering sites.
    (if (= (load answer) -1) (set! answer FE-INTRINSIC-UNBOUND) 0)
    (al-push! [FeResolution]
              (mut (.resolutions frontend))
              (fe-resolution-make node (load answer)))
    (loop (if (> (al-len [i64] (.resolution-symbols frontend)) node)
              (break)
              (do (al-push! [i64] (mut (.resolution-symbols frontend)) -1) 0)))
    (al-set! [i64] (mut (.resolution-symbols frontend)) node (load answer))
    (if (and (and (>= (load answer) 0)
                  (>= (load answer) (al-len [FeFunction] (.functions frontend))))
             (!= (fe-symbol-owner frontend (load answer)) owner))
        (fe-record-capture! (mut frontend) owner (load answer))
        0)
    (load answer)))

(defn fe-resolve-binding-pattern! [(frontend (mut NativeFrontend))
                                   (bindings (mut (ArrayList FeBinding)))
                                   (node i64)
                                   (owner i64)
                                   (depth i64)] (-> i64)
  (let [ast (field frontend ast) kind (ts-kind ast node)]
    (if (= kind TSK-IDENTIFIER)
        (let [symbol (fe-symbol-for-binding-name frontend node owner)]
          (al-push! [FeBinding] (mut bindings) (fe-binding-make node symbol depth)))
        (if (= kind TSK-BINDING-ELEMENT)
            (let [name (ts-role ast node TS-ROLE-NAME 0)]
              (if (!= name -1)
                  (fe-resolve-binding-pattern! (mut frontend) (mut bindings) name owner depth) 0))
            (if (or (= kind TSK-ARRAY-BINDING-PATTERN) (= kind TSK-OBJECT-BINDING-PATTERN))
                (let [(mut i) 0]
                  (loop (if (>= (load i) (ts-child-count ast node)) (break)
                          (do (fe-resolve-binding-pattern! (mut frontend)
                                                           (mut bindings)
                                                           (ts-child ast node (load i))
                                                           owner depth)
                              (set! i (+ (load i) 1))))))
                0))))
  0)

(defn fe-resolve-node! [(frontend (mut NativeFrontend))
                        (bindings (mut (ArrayList FeBinding)))
                        (node i64)
                        (owner i64)
                        (depth i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= (load (field frontend status)) FE-UNBOUND) 0
          (= kind TSK-IDENTIFIER) (do (fe-resolve-name! (mut frontend) bindings node owner) 0)
          ;; A function declaration NESTED in another function resolves inline exactly like an
          ;; expression: its parameters bind in its own scope, its body sees the enclosing lexical
          ;; stack, and captures record against its own id. Only top-level declarations go through
          ;; the driver's fe-resolve-function! pass — the default child walk used to descend into
          ;; nested declaration bodies with the PARENT's bindings and report their parameters as
          ;; unbound names. Sibling calls keep resolving through the fe-find-function-name
          ;; fallback, which is how declaration hoisting is already approximated at top level.
          (or (fe-function-expression-kind? kind) (= kind TSK-FUNCTION-DECLARATION))
            (let [function-index (fe-function-for-node frontend node)
                  fn (al-get [FeFunction] (load (field frontend functions)) function-index)
                  saved (al-len [FeBinding] (load bindings))
                  function-id (load (field fn id))
                  parameter-start (load (field fn parameter-start))
                  parameter-count (load (field fn parameter-count))
                  (mut index) 0]
              ;; A named expression's name exists only in its own body.
              (if (!= (load (field fn name-node)) -1)
                  (al-push! [FeBinding]
                            (mut bindings)
                            (fe-binding-make (load (field fn name-node)) function-id depth))
                  0)
              (loop (if (>= (load index) parameter-count)
                        (break)
                        (let [symbol
                                (al-get [FeSymbol]
                                        (load (field frontend symbols))
                                        (+ parameter-start (load index)))]
                          (al-push! [FeBinding]
                                    (mut bindings)
                                    (fe-binding-make (load (field symbol name-node))
                                                     (load (field symbol id))
                                                     depth))
                          (store! index (+ (load index) 1)))))
              (fe-resolve-node! (mut frontend)
                                (mut bindings)
                                (load (field fn body-node))
                                function-id
                                (+ depth 1))
              (store! (field bindings len) saved)
              0)
          (= kind TSK-VARIABLE-DECLARATION)
            (let [count (ts-child-count ast node)
                  name (ts-role ast node TS-ROLE-NAME 0)
                  value (ts-role ast node TS-ROLE-INITIALIZER 0)]
              ;; Initializers are resolved before the declaration enters scope.
              (if (and (!= value -1) (!= value name))
                  (fe-resolve-node! (mut frontend) (mut bindings) value owner depth)
                  0)
              (fe-resolve-binding-pattern! (mut frontend) (mut bindings) name owner depth)
              0)
          ;; The ITERABLE is evaluated in the enclosing scope and the binding is visible only
          ;; inside the loop. The default child walk got both wrong: it walks children in order,
          ;; so it bound the name before descending into the expression, and it never popped the
          ;; binding, leaving it in scope for every statement after the loop.
          (or (= kind TSK-FOR-OF) (= kind TSK-FOR-IN))
            (let [saved (al-len [FeBinding] (load bindings))]
              (fe-resolve-node! (mut frontend)
                                (mut bindings)
                                (ts-role ast node TS-ROLE-EXPRESSION 0)
                                owner
                                depth)
              (fe-resolve-node! (mut frontend)
                                (mut bindings)
                                (ts-role ast node TS-ROLE-INITIALIZER 0)
                                owner
                                (+ depth 1))
              (fe-resolve-node! (mut frontend)
                                (mut bindings)
                                (ts-role ast node TS-ROLE-STATEMENT 0)
                                owner
                                (+ depth 1))
              (store! (field bindings len) saved)
              0)
          (= kind TSK-CATCH)
            (let [saved (al-len [FeBinding] (load bindings))
                  declaration (ts-role ast node TS-ROLE-CATCH-BINDING 0)
                  block (ts-role ast node TS-ROLE-BODY 0)]
              (if (!= declaration -1)
                  (fe-resolve-node! (mut frontend) (mut bindings) declaration owner (+ depth 1))
                  0)
              (fe-resolve-node! (mut frontend) (mut bindings) block owner (+ depth 1))
              (store! (field bindings len) saved)
              0)
          (= kind TSK-BLOCK)
            (let [saved (al-len [FeBinding] (load bindings))
                  (mut index) 0]
              (loop (if (>= (load index) (ts-child-count ast node))
                        (break)
                        (do
                          (fe-resolve-node! (mut frontend)
                                            (mut bindings)
                                            (ts-child ast node (load index))
                                            owner
                                            (+ depth 1))
                          (store! index (+ (load index) 1)))))
              (store! (field bindings len) saved)
              0)
          (= kind TSK-PROPERTY-ACCESS)
            (let [object (ts-child ast node 0)]
              (fe-resolve-node! (mut frontend) (mut bindings) object owner depth)
              (if (= (ts-kind ast object) TSK-IDENTIFIER)
                  (let [symbol (fe-resolution-symbol frontend object)]
                    (if (and (>= symbol 0)
                             (< symbol
                                (al-len [FeFunction] (load (field frontend functions)))))
                        ; A declaration used as a property receiver needs its JavaScript function
                        ; object identity. A direct callee does not: capturing every call target
                        ; would manufacture cyclic, unused closure environments.
                        (fe-record-capture! (mut frontend) owner symbol)
                        0))
                  0))
          (= kind TSK-PROPERTY-ASSIGNMENT)
            (do
              (let [name (ts-child ast node 0)]
                (if (= (ts-kind ast name) TSK-COMPUTED-PROPERTY-NAME)
                    (fe-resolve-node! (mut frontend)
                                      (mut bindings)
                                      (ts-child ast name 0)
                                      owner
                                      depth)
                    0))
              (fe-resolve-node! (mut frontend)
                                (mut bindings)
                                (ts-child ast node (- (ts-child-count ast node) 1))
                                owner
                                depth))
          (= kind TSK-LABELED)
            (fe-resolve-node! (mut frontend)
                              (mut bindings)
                              (ts-role ast node TS-ROLE-STATEMENT 0)
                              owner
                              depth)
          (or (= kind TSK-BREAK) (= kind TSK-CONTINUE)) 0
          :else
            (let [(mut index) 0]
              (loop (if (>= (load index) (ts-child-count ast node))
                        (break)
                        (do
                          (fe-resolve-node! (mut frontend)
                                            (mut bindings)
                                            (ts-child ast node (load index))
                                            owner
                                            depth)
                          (store! index (+ (load index) 1)))))
              0))))

(defn fe-resolve-function! [(frontend (mut NativeFrontend)) (function-index i64)] (-> i64)
  (let [ast (field frontend ast)
        fn (al-get [FeFunction] (.functions frontend) function-index)
        owner (.id fn)
        (mut bindings) (al-new [FeBinding] (malloc-allocator))
        start (.parameter-start fn)
        count (.parameter-count fn)
        (mut index) 0]
    ;; Source-file `var` bindings are hoisted and shared. The graph builder materializes them as
    ;; main-owned closure cells, so every function resolves the same symbol identity.
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.role symbol) FE-ROLE-GLOBAL)
                    (al-push! [FeBinding]
                              (mut bindings)
                              (fe-binding-make (.name-node symbol)
                                               (.id symbol)
                                               0))
                    0)
                (set! index (+ (load index) 1)))))
    ;; `var` hoisting inside the function: every local this function owns is visible from the top
    ;; of the body, including from nested functions declared before the `var` statement appears
    ;; (NavierStokes declares FluidField's state vars BELOW the nested helpers that write them).
    ;; Parameters are pushed afterwards, so a parameter of the same name shadows the local, which
    ;; is JavaScript's `var x` merging with parameter `x`.
    (set! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.role symbol) FE-ROLE-LOCAL)
                         (= (.owner symbol) owner))
                    (al-push! [FeBinding]
                              (mut bindings)
                              (fe-binding-make (.name-node symbol)
                                               (.id symbol)
                                               0))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) count)
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (+ start (load index)))]
                (al-push! [FeBinding]
                          (mut bindings)
                          (fe-binding-make (.name-node symbol) (.id symbol) 0))
                (set! index (+ (load index) 1)))))
    ;; Parameter initializers are executable expressions outside the body child. Resolve them once
    ;; all formal bindings exist; lowering still evaluates them sequentially at function entry.
    (set! index 0)
    (loop (if (>= (load index) count)
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (+ start (load index)))
                    initializer (ts-role ast (.node symbol) TS-ROLE-INITIALIZER 0)]
                (if (!= initializer -1)
                    (fe-resolve-node! (mut frontend) (mut bindings) initializer owner 0)
                    0)
                (set! index (+ (load index) 1)))))
    (fe-resolve-node! (mut frontend) (mut bindings) (.body-node fn) owner 0)
    (al-free! [FeBinding] (mut bindings))
    0))

(defn fe-resolve-top-level! [(frontend (mut NativeFrontend)) (root i64) (owner i64)] (-> i64)
  (let [ast (field frontend ast)
        (mut bindings) (al-new [FeBinding] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.role symbol) FE-ROLE-GLOBAL)
                    (al-push! [FeBinding]
                              (mut bindings)
                              (fe-binding-make (.name-node symbol)
                                               (.id symbol)
                                               0))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (or (>= (load index) (ts-child-count ast root))
                  (= (.status frontend) FE-UNBOUND))
              (break)
              (let [statement (ts-child ast root (load index))
                    kind (ts-kind ast statement)]
                (if (or (= kind TSK-VARIABLE-STATEMENT) (= kind TSK-EXPRESSION-STATEMENT))
                    (fe-resolve-node! (mut frontend) (mut bindings) statement owner 0)
                    0)
                (set! index (+ (load index) 1)))))
    (al-free! [FeBinding] (mut bindings))
    0))

(defn fe-copy-global-captures! [(frontend (mut NativeFrontend)) (caller i64) (callee i64)] (-> i64)
  (let [limit (al-len [FeCapture] (.captures frontend))
        (mut index) 0]
    (loop (if (>= (load index) limit)
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.function capture) callee)
                         (or (< (.symbol capture)
                                (al-len [FeFunction] (.functions frontend)))
                             (= (fe-symbol-role frontend (.symbol capture))
                                FE-ROLE-GLOBAL)))
                    (fe-record-capture! (mut frontend) caller (.symbol capture))
                    0)
                (set! index (+ (load index) 1)))))
    0))

;; A direct call to a capture-carrying function threads the callee's environment through the
;; CALLER: the call site passes each captured cell, so the caller must own or capture every one
;; of them itself. Globals stopped being captures, but a nested function's parent-locals are real
;; lexical state — NavierStokes' lin_solve calls set_bnd, and set_bnd's width/height/rowSize
;; cells have to arrive through lin_solve. The fixpoint in fe-propagate-call-captures! makes this
;; converge for recursion and call chains.
;; True when `function` is lexically nested (at any depth) inside `owner`. Only such a function
;; can legally capture a symbol `owner` declares — its environment chain reaches the cell.
(defn fe-scope-inside? [(frontend (ptr NativeFrontend)) (function i64) (owner i64)] (-> bool)
  (let [count (al-len [FeFunction] (.functions frontend))
        (mut cur) function
        (mut found) false]
    (loop (if (or (load found) (or (< (load cur) 0) (>= (load cur) count)))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load cur))]
                (set! cur (.parent fn))
                (if (= (load cur) owner) (set! found true) 0))))
    (load found)))

(defn fe-copy-callee-captures! [(frontend (mut NativeFrontend)) (caller i64) (callee i64)] (-> i64)
  (let [limit (al-len [FeCapture] (.captures frontend))
        (mut index) 0]
    (loop (if (>= (load index) limit)
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                ; A cell the caller itself OWNS is not a capture of the caller; the call site
                ; reads it as the owner's local storage. And a caller that is NOT nested inside
                ; the symbol's owner cannot capture it at all — its environment chain never
                ; reaches the cell, so recording it would demand an unsatisfiable environment
                ; (a top-level function "capturing" a constructor's locals).
                (let [symbol (.symbol capture)
                      owner (fe-symbol-owner frontend (.symbol capture))]
                  (if (and (= (.function capture) callee)
                           (and (!= owner caller)
                                (or (< owner 0)
                                    (fe-scope-inside? frontend caller owner))))
                      (fe-record-capture! (mut frontend) caller symbol)
                      0))
                (set! index (+ (load index) 1)))))
    0))

(defn fe-copy-prototype-captures! [(frontend (mut NativeFrontend))
                                   (caller i64)
                                   (constructor i64)] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load index))]
                (if (= (.constructor method) constructor)
                    (fe-copy-global-captures! (mut frontend)
                                              caller
                                              (.target method))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index)
                  (al-len [FePrototypeParent] (.prototype-parents frontend)))
              (break)
              (let [relation
                      (al-get [FePrototypeParent]
                              (.prototype-parents frontend)
                              (load index))]
                (if (= (.constructor relation) constructor)
                    (fe-copy-prototype-captures! (mut frontend)
                                                 caller
                                                 (.parent relation))
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fe-call-prototype-parent [(frontend (ptr NativeFrontend)) (constructor i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index)
                      (al-len [FePrototypeParent] (.prototype-parents frontend)))
                  (>= (load answer) 0))
              (break)
              (let [relation
                      (al-get [FePrototypeParent]
                              (.prototype-parents frontend)
                              (load index))]
                (if (= (.constructor relation) constructor)
                    (set! answer (.parent relation))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fe-call-prototype-method [(frontend (ptr NativeFrontend))
                                (constructor i64)
                                (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        (mut current) constructor
        (mut answer) -1
        (mut fuel) 64]
    (loop (if (or (< (load current) 0)
                  (or (<= (load fuel) 0) (>= (load answer) 0)))
              (break)
              (let [(mut index) 0]
                (loop (if (or (>= (load index)
                                  (al-len [FePrototypeMethod]
                                          (.prototype-methods frontend)))
                              (>= (load answer) 0))
                          (break)
                          (let [method
                                  (al-get [FePrototypeMethod]
                                          (.prototype-methods frontend)
                                          (load index))]
                            (if (and (= (.constructor method) (load current))
                                     (= (ts-text ast (.name-node method)) (ts-text ast name-node)))
                                (set! answer (.target method))
                                0)
                            (set! index (+ (load index) 1)))))
                (if (< (load answer) 0)
                    (set! current (fe-call-prototype-parent frontend (load current)))
                    0)
                (set! fuel (- (load fuel) 1)))))
    (load answer)))

(defn fe-explicit-call-target [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)]
    (if (= (ts-kind ast node) TSK-IDENTIFIER)
        (fe-resolution-symbol frontend node)
        (if (= (ts-kind ast node) TSK-PROPERTY-ACCESS)
            (let [base (ts-child ast node 0)
                  name (ts-text ast (ts-child ast node 1))]
              (if (= name "superConstructor")
                  (fe-call-prototype-parent frontend (fe-find-function-name frontend base))
                  (if (and (= (ts-kind ast base) TSK-PROPERTY-ACCESS)
                           (= (ts-text ast (ts-child ast base 1)) "prototype"))
                      (let [constructor (fe-explicit-call-target frontend (ts-child ast base 0))]
                        (if (>= constructor 0)
                            (fe-call-prototype-method frontend constructor (ts-child ast node 1))
                            -1))
                      -1)))
            -1))))

(defn fe-propagate-call-captures-node! [(frontend (mut NativeFrontend))
                                        (caller i64)
                                        (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (or (= kind TSK-CALL) (= kind TSK-NEW-EXPRESSION))
        (let [callee-node (ts-child ast node 0)]
          (cond (= (ts-kind ast callee-node) TSK-IDENTIFIER)
                  (let [callee (fe-resolution-symbol frontend callee-node)]
                    (if (and (>= callee 0)
                             (< callee (al-len [FeFunction] (load (field frontend functions)))))
                        (do
                          (fe-copy-callee-captures! (mut frontend) caller callee)
                          ;; A capture-bearing callee's VALUE is the materialized closure held in
                          ;; the cell its declaring parent owns. Every OTHER caller reaches that
                          ;; closure only through its own environment, so the callee's identity is
                          ;; itself a capture; without it the call site falls back to the bare Fun
                          ;; and hands the callee a functionless environment.
                          (let [callee-fn
                                  (al-get [FeFunction] (load (field frontend functions)) callee)
                                callee-parent (load (field callee-fn parent))
                                (mut callee-captures) false
                                (mut scan) 0]
                            (loop (if (or (>= (load scan)
                                              (al-len [FeCapture] (load (field frontend captures))))
                                          (load callee-captures))
                                      (break)
                                      (let [capture (al-get [FeCapture]
                                                            (load (field frontend captures))
                                                            (load scan))]
                                        (if (= (load (field capture function)) callee)
                                            (store! callee-captures true)
                                            0)
                                        (store! scan (+ (load scan) 1)))))
                            (if (and (load callee-captures)
                                     (and (>= callee-parent 0)
                                          (and (!= callee-parent caller)
                                               (fe-scope-inside? frontend caller callee-parent))))
                                (fe-record-capture! (mut frontend) caller callee)
                                0))
                          (if (= kind TSK-NEW-EXPRESSION)
                              (fe-copy-prototype-captures! (mut frontend) caller callee)
                              0))
                        0))
                (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS)
                  (let [name (ts-text ast (ts-child ast callee-node 1))
                        (mut method-index) 0]
                    (if (= name "call")
                        (let [target (fe-explicit-call-target frontend (ts-child ast callee-node 0))]
                          (if (>= target 0)
                              (fe-copy-global-captures! (mut frontend) caller target)
                              0))
                        (loop (if (>= (load method-index)
                                      (al-len [FePrototypeMethod]
                                              (load (field frontend prototype-methods))))
                                  (break)
                                  (let [method
                                          (al-get [FePrototypeMethod]
                                                  (load (field frontend prototype-methods))
                                                  (load method-index))]
                                    (if (= name (ts-text ast (load (field method name-node))))
                                        (fe-copy-global-captures! (mut frontend)
                                                                  caller
                                                                  (load (field method target)))
                                        0)
                                    (store! method-index (+ (load method-index) 1)))))))
                :else 0))
        0)
    (if (or (= kind TSK-FUNCTION-DECLARATION) (fe-function-expression-kind? kind))
        ;; CREATING a nested closure is a capture site: before the creator can store a
        ;; grandparent's cell into the child's environment it must thread that cell through
        ;; its OWN environment. Copy the child's captures up (the copier already excludes
        ;; symbols the creator itself owns). The child's body is not recursed into here —
        ;; the driver visits every function under its own id.
        (let [child (fe-function-for-node frontend node)]
          (if (>= child 0)
              (let [child-fn (al-get [FeFunction] (.functions frontend) child)]
                (fe-copy-callee-captures! (mut frontend) caller (.id child-fn)))
              0))
        (let [(mut index) 0]
          (loop (if (>= (load index) (ts-child-count ast node))
                    (break)
                    (do
                      (fe-propagate-call-captures-node! (mut frontend)
                                                        caller
                                                        (ts-child ast node (load index)))
                      (set! index (+ (load index) 1)))))))
    0))

(defn fe-propagate-call-captures! [(frontend (mut NativeFrontend))] (-> i64)
  (let [(mut changed) true]
    (loop (if (not (load changed))
              (break)
              (do
                (let [before (al-len [FeCapture] (.captures frontend))
                      (mut function-index) 0]
                  (loop (if (>= (load function-index)
                                (al-len [FeFunction] (.functions frontend)))
                            (break)
                            (let [fn
                                    (al-get [FeFunction]
                                            (.functions frontend)
                                            (load function-index))]
                              (fe-propagate-call-captures-node! (mut frontend)
                                                                (.id fn)
                                                                (.body-node fn))
                              (set! function-index (+ (load function-index) 1)))))
                  (set! changed (!= before (al-len [FeCapture] (.captures frontend)))))))
      0)))

; Prototype dispatch loads a function identity from an object before the exact implementation is
; known. Give every prototype method the same closed-world global environment so one indirect call
; ABI works for overloaded method names. Lexical/local captures remain specific to nested closures.
(defn fe-normalize-prototype-captures! [(frontend (mut NativeFrontend))] (-> i64)
  (let [function-count (al-len [FeFunction] (.functions frontend))
        original (al-len [FeCapture] (.captures frontend))
        (mut method-index) 0]
    (loop (if (>= (load method-index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load method-index))
                    target (.target method)
                    (mut capture-index) 0]
                (loop (if (>= (load capture-index) original)
                          (break)
                          (let [capture
                                  (al-get [FeCapture]
                                          (.captures frontend)
                                          (load capture-index))
                                symbol (.symbol capture)]
                            (if (and (or (< symbol function-count)
                                         (= (fe-symbol-role frontend symbol) FE-ROLE-GLOBAL))
                                     (let [(mut scan) 0
                                           (mut method-capture) false]
                                       (loop (if (or (>= (load scan)
                                                         (al-len [FePrototypeMethod]
                                                                 (.prototype-methods frontend)))
                                                     (load method-capture))
                                                 (break)
                                                 (let [candidate
                                                         (al-get [FePrototypeMethod]
                                                                 (.prototype-methods frontend)
                                                                 (load scan))]
                                                   (if (= (.function capture)
                                                          (.target candidate))
                                                       (set! method-capture true)
                                                       0)
                                                   (set! scan (+ (load scan) 1)))))
                                       (load method-capture)))
                                (fe-record-capture! (mut frontend) target symbol)
                                0)
                            (set! capture-index (+ (load capture-index) 1)))))
                (set! method-index (+ (load method-index) 1)))))
    0))

(defn fe-native-index! [(frontend (mut NativeFrontend))] (-> i64)
  (let [ast (field frontend ast)]
    (if (> (ts-diagnostic-count ast) 0)
        (do (set! (.status frontend) FE-PARSE) (set! (.error-node frontend) 0) FE-PARSE)
        (let [root (ts-root ast)]
          (fe-validate-supported! (mut frontend) root)
          (if (!= (.status frontend) FE-OK)
              (.status frontend)
              (let [(mut index) 0
                    (mut function-count) 0]
                ;; Type layouts are indexed by source declaration order. They do not
                ;; consume symbol ids, matching the legacy normalized IR.
                (loop (if (>= (load index) (ts-child-count ast root))
                          (break)
                          (let [node (ts-child ast root (load index))
                                kind (ts-kind ast node)]
                            (if (or (= kind TSK-TYPE-ALIAS-DECLARATION) (= kind TSK-INTERFACE-DECLARATION))
                                (fe-index-type! (mut frontend) node)
                                0)
                            (set! index (+ (load index) 1)))))
                (fe-index-object-layouts! (mut frontend) root)
                ;; Function ids are allocated globally in syntax preorder before any parameter/local id.
                (fe-index-functions! (mut frontend) root -1)
                (set! function-count (al-len [FeFunction] (.functions frontend)))
                (set! index 0)
                (loop (if (>= (load index) (ts-child-count ast root))
                          (break)
                          (do
                            (fe-index-prototype-method! (mut frontend) (ts-child ast root (load index)))
                            (fe-index-prototype-parent! (mut frontend) (ts-child ast root (load index)))
                            (set! index (+ (load index) 1)))))
                (fe-mark-property-published-functions! (mut frontend) root -1)
                ;; Keep semantic callable identities stable. Finite target masks are only an
                ;; optimization summary; methods beyond their width retain exact runtime IDs and
                ;; are dispatched generically instead of renumbering every declaration/capture
                ;; table in the frontend.
                0
                (fe-validate-receiver-abis! (mut frontend) root)
                ;; fe-find-function-parts! appended parameters too early. Rebase them after
                ;; all function ids, matching frontend_ir.mjs's nextSymbol order.
                (let [(mut si) 0]
                  (loop (if (>= (load si) (al-len [FeSymbol] (.symbols frontend)))
                            (break)
                            (do
                              (set! (.id (index (load (field (field frontend symbols) data)) (load si)))
                                    (+ (load function-count) (load si)))
                              (set! si (+ (load si) 1))))))
                (let [main-id (fe-main-id frontend)]
                  (if (>= main-id 0)
                      (fe-scan-globals! (mut frontend) root main-id (load function-count))
                      0))
                (let [(mut fi) 0]
                  (loop (if (>= (load fi) (al-len [FeFunction] (.functions frontend)))
                            (break)
                            (let [fn (al-get [FeFunction] (.functions frontend) (load fi))]
                              (fe-scan-locals! (mut frontend)
                                               (.body-node fn)
                                               (.id fn)
                                               (load function-count))
                              (set! fi (+ (load fi) 1))))))
                (let [main-id (fe-main-id frontend)]
                  (if (>= main-id 0) (fe-resolve-top-level! (mut frontend) root main-id) 0))
                (let [(mut fi) 0]
                  (loop (if (>= (load fi) (al-len [FeFunction] (.functions frontend)))
                            (break)
                            (let [fn (al-get [FeFunction] (.functions frontend) (load fi))]
                              ;; Nested expressions are resolved exactly where the enclosing resolver
                              ;; encounters them, with the then-active lexical binding stack.
                              (if (= (.parent fn) -1)
                                  (fe-resolve-function! (mut frontend) (load fi))
                                  0)
                              (set! fi (+ (load fi) 1)))))
                  (if (= (.status frontend) FE-OK)
                      (fe-propagate-call-captures! (mut frontend))
                      0)
                  (if (= (.status frontend) FE-OK)
                      (do
                        (fe-normalize-prototype-captures! (mut frontend))
                        (fe-propagate-call-captures! (mut frontend)))
                      0)
                  (if (= (.status frontend) FE-OK)
                      (fe-mark-mutations! (mut frontend) root)
                      0)
                  (.status frontend))))))))

(defn fe-native-free! [(frontend (mut NativeFrontend))] (-> i64)
  (al-free! [FeFunction] (mut (.functions frontend)))
  (al-free! [FeSymbol] (mut (.symbols frontend)))
  (al-free! [FeResolution] (mut (.resolutions frontend)))
  (al-free! [i64] (mut (.resolution-symbols frontend)))
  (al-free! [FeCapture] (mut (.captures frontend)))
  (al-free! [FeTypeDecl] (mut (.types frontend)))
  (al-free! [FeField] (mut (.fields frontend)))
  (al-free! [FePrototypeMethod] (mut (.prototype-methods frontend)))
  (al-free! [FePrototypeParent] (mut (.prototype-parents frontend)))
  (al-free! [i64] (mut (.static-method-symbols frontend)))
  (al-free! [i64] (mut (.static-method-names frontend)))
  (al-free! [i64] (mut (.static-method-results frontend)))
  (ts-close! (mut (.ast frontend)))
  0)
