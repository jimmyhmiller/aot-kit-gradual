;; Canonical hand-built binary-trees integration kernel.
(module binarytrees)

(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "verify" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.slice" :use *)

(const BT-MIN-DEPTH i64 4)
(const BT-WORK-SLOTS i64 9)       ; depths 4, 6, ... 20
(const BT-RESULT-FIELDS i64 31)   ; stretch pair + 9 triples + long-lived pair

(defn bt-optimize-ptr [] (-> (ptr bool)) (let [enabled (alloc/static bool)] enabled))
(defn bt-set-optimize! [(enabled bool)] (-> i64)
  (set! (bt-optimize-ptr) enabled) 0)
(defn bt-peep [(node i64)] (-> i64)
  (if (load (bt-optimize-ptr)) (n-peephole node) node))

(defn bt-const [(v i64)] (-> i64) (n-new1 (Const (t-int-con v)) (g-start)))
(defn bt-null [] (-> i64) (n-new1 (Const (t-null)) (g-start)))
(defn bt-bin [(op Op) (a i64) (b i64)] (-> i64)
  (bt-peep (n-new3 op NO-NODE a b)))
(defn bt-memory [(ctrl i64) (alias i64)] (-> i64)
  (n-new1 (Arg (t-mem-alias alias (t-undef))) ctrl))

(defn bt-result-name [(i i64)] (-> (slice u8))
  (case i
    0 "stretchDepth" 1 "stretchCheck"
    2 "depth4" 3 "iterations4" 4 "check4"
    5 "depth6" 6 "iterations6" 7 "check6"
    8 "depth8" 9 "iterations8" 10 "check8"
    11 "depth10" 12 "iterations10" 13 "check10"
    14 "depth12" 15 "iterations12" 16 "check12"
    17 "depth14" 18 "iterations14" 19 "check14"
    20 "depth16" 21 "iterations16" 22 "check16"
    23 "depth18" 24 "iterations18" 25 "check18"
    26 "depth20" 27 "iterations20" 28 "check20"
    29 "longLivedDepth" 30 "longLivedCheck"
    "invalid"))

(defn bt-result-shape! [] (-> i64)
  (let [(mut shape) SHAPE-ROOT (mut i) 0]
    (loop
      (if (>= (load i) BT-RESULT-FIELDS) (break)
        (do (set! shape (shape-transition (load shape) (bt-result-name (load i)) (t-int)))
            (set! i (+ (load i) 1)) 0)))
    (load shape)))

(defn bt-tree-node! [(ctrl i64) (shape i64) (left-alias i64) (right-alias i64)
                     (left i64) (right i64)] (-> (array i64 2))
  (let [nw (n-new-obj2! ctrl shape (bt-memory ctrl left-alias) (bt-memory ctrl right-alias))
        obj (n-obj-ptr nw)
        lm (n-store! (n-obj-mem nw 0) obj left left-alias)
        rm (n-store! (n-obj-mem nw 1) obj right right-alias)
        out (alloc/stack (array i64 2))]
    (set! (index out 0) obj)
    (set! (index out 1) (n-memmerge2! lm rm))
    (load out)))

(defn bt-build-bottom! [(tree-shape i64) (left-alias i64) (right-alias i64)] (-> i64)
  (let [fun (n-fun-open! 0) depth (n-parm! fun 0)
        arms (n-if-arms!
               (bt-peep (n-new2 (If) (n-fun-entry fun)
                                    (bt-bin (Lt) depth (bt-const 1)))))
        leaf (bt-tree-node! (arms-t arms) tree-shape left-alias right-alias
                            (bt-null) (bt-null))
        leaf-ret (n-new3 (Return) (arms-t arms) (index leaf 0) (index leaf 1))
        next (bt-bin (Sub) depth (bt-const 1))
        left-call (n-call1! (arms-f arms) fun next)
        right-call (n-call1! (call-end left-call) fun next)
        parent (bt-tree-node! (call-end right-call) tree-shape left-alias right-alias
                              (call-value left-call) (call-value right-call))
        parent-ret (n-new3 (Return) (call-end right-call)
                           (index parent 0) (index parent 1))]
    (n-fun-close! fun leaf-ret)
    (n-fun-add-return! fun parent-ret)
    fun))

(defn bt-build-check! [(tree-shape i64) (left-alias i64) (right-alias i64)] (-> i64)
  (let [fun (n-fun-open! 1) node (n-parm! fun 0)
        cast (n-new2 (Cast (t-obj-shape tree-shape)) (n-fun-entry fun) node)
        left (n-load! (bt-memory (n-fun-entry fun) left-alias) cast left-alias)
        arms (n-if-arms!
               (bt-peep (n-new2 (If) (n-fun-entry fun)
                                    (bt-bin (Eq) left (bt-null)))))
        leaf-ret (n-new2 (Return) (arms-t arms) (bt-const 1))
        right (n-load! (bt-memory (n-fun-entry fun) right-alias) cast right-alias)
        lc (n-call1! (arms-f arms) fun left)
        rc (n-call1! (call-end lc) fun right)
        branch-ret (n-new2 (Return) (call-end rc)
                     (bt-bin (Add) (bt-const 1)
                       (bt-bin (Add) (call-value lc) (call-value rc))))]
    (n-fun-close! fun leaf-ret)
    (n-fun-add-return! fun branch-ret)
    fun))

(defn bt-build-pow2! [] (-> i64)
  (let [fun (n-fun-open! 2) exponent (n-parm! fun 0)
        arms (n-if-arms!
               (bt-peep (n-new2 (If) (n-fun-entry fun)
                                    (bt-bin (Lt) exponent (bt-const 1)))))
        base (n-new2 (Return) (arms-t arms) (bt-const 1))
        rec (n-call1! (arms-f arms) fun (bt-bin (Sub) exponent (bt-const 1)))
        step (n-new2 (Return) (call-end rec)
                     (bt-bin (Mul) (bt-const 2) (call-value rec)))]
    (n-fun-close! fun base)
    (n-fun-add-return! fun step)
    fun))

(defn bt-build-work! [(bottom i64) (check i64)] (-> i64)
  (let [fun (n-fun-open! 3) depth (n-parm! fun 0) iterations (n-parm! fun 1)
        lp (n-new (Loop))]
    (n-add-def! lp NO-NODE) (n-add-def! lp (n-fun-entry fun)) (n-add-def! lp NO-NODE)
    (let [i (n-new (Phi (t-int))) sum (n-new (Phi (t-int)))]
      (n-add-def! i lp) (n-add-def! i (bt-const 0)) (n-add-def! i NO-NODE)
      (n-add-def! sum lp) (n-add-def! sum (bt-const 0)) (n-add-def! sum NO-NODE)
      (let [arms (n-if-arms! (bt-peep (n-new2 (If) lp (bt-bin (Lt) i iterations))))
            tree (n-call1! (arms-t arms) bottom depth)
            checked (n-call1! (call-end tree) check (call-value tree))
            ret (n-new2 (Return) (arms-f arms) sum)]
        (n-set-def! i 2 (bt-bin (Add) i (bt-const 1)))
        (n-set-def! sum 2 (bt-bin (Add) sum (call-value checked)))
        (n-set-def! lp 2 (call-end checked))
        (n-fun-close! fun ret)
        fun))))

(defn bt-merge-memories! [(mems (ptr i64)) (count i64)] (-> i64)
  (let [merge (n-new (MemMerge)) (mut i) 0]
    (n-add-def! merge NO-NODE)
    (loop
      (if (>= (load i) count) (break)
        (do (n-add-def! merge (load (index mems (load i))))
            (set! i (+ (load i) 1)) 0)))
    (bt-peep merge)))

(defn bt-build-result! [(ctrl i64) (shape i64) (values (ptr i64))] (-> i64)
  (let [incoming (alloc/stack (array i64 31))
        stores (alloc/stack (array i64 31)) (mut i) 0]
    (loop
      (if (>= (load i) BT-RESULT-FIELDS) (break)
        (do (set! (index incoming (load i)) (bt-memory ctrl (shape-field-alias shape (load i))))
            (set! i (+ (load i) 1)) 0)))
    (let [nw (n-new-obj! ctrl shape
               (slice-new [i64] (cast (ptr i64) incoming) BT-RESULT-FIELDS))
          obj (n-obj-ptr nw)]
      (set! i 0)
      (loop
        (if (>= (load i) BT-RESULT-FIELDS) (break)
          (do (set! (index stores (load i))
                    (n-store! (n-obj-mem nw (load i)) obj
                              (load (index values (load i)))
                              (shape-field-alias shape (load i))))
              (set! i (+ (load i) 1)) 0)))
      (let [ret (n-new3 (Return) ctrl obj
                         (bt-merge-memories! (cast (ptr i64) stores) BT-RESULT-FIELDS))]
        (n-add-def! (g-stop) ret)
        obj))))

;; Returns the maxDepth argument node. Callers bind it explicitly for interpreter runs.
(defn binarytrees-build-mode-analysis! [(seed i64) (optimize bool) (analyze bool)] (-> i64)
  (graph-reset! seed) (shape-reset!)
  (bt-set-optimize! optimize)
  (let [left-shape (shape-transition SHAPE-ROOT "left" (t-obj))
        tree-shape (shape-transition left-shape "right" (t-obj))
        left-alias (shape-field-alias tree-shape 0)
        right-alias (shape-field-alias tree-shape 1)
        result-shape (bt-result-shape!)
        bottom (bt-build-bottom! tree-shape left-alias right-alias)
        check (bt-build-check! tree-shape left-alias right-alias)
        pow2 (bt-build-pow2!) work (bt-build-work! bottom check)
        max-depth (n-new1 (Arg (t-int)) (g-start))
        stretch-depth (bt-bin (Add) max-depth (bt-const 1))
        stretch (n-call1! (g-start) bottom stretch-depth)
        stretch-check (n-call1! (call-end stretch) check (call-value stretch))
        long-tree (n-call1! (call-end stretch-check) bottom max-depth)
        values (alloc/stack (array i64 31))
        (mut ctrl) (call-end long-tree) (mut slot) 0]
    (set! (index values 0) stretch-depth)
    (set! (index values 1) (call-value stretch-check))
    (loop
      (if (>= (load slot) BT-WORK-SLOTS) (break)
        (do
          (let [depth (+ BT-MIN-DEPTH (* (load slot) 2))
                arms (n-if-arms!
                       (bt-peep (n-new2 (If) (load ctrl)
                                            (bt-bin (Le) (bt-const depth) max-depth))))
                iterations (n-call1! (arms-t arms) pow2
                              (bt-bin (Add)
                                (bt-bin (Sub) max-depth (bt-const depth))
                                (bt-const BT-MIN-DEPTH)))
                checked (n-call2! (call-end iterations) work (bt-const depth)
                                  (call-value iterations))
                join (n-new (Region))]
            (n-add-def! join NO-NODE)
            (n-add-def! join (call-end checked))
            (n-add-def! join (arms-f arms))
            (let [iter-phi (n-new (Phi (t-int))) check-phi (n-new (Phi (t-int)))]
              (n-add-def! iter-phi join) (n-add-def! iter-phi (call-value iterations))
              (n-add-def! iter-phi (bt-const 0))
              (n-add-def! check-phi join) (n-add-def! check-phi (call-value checked))
              (n-add-def! check-phi (bt-const 0))
              (set! (index values (+ 2 (* (load slot) 3))) (bt-const depth))
              (set! (index values (+ 3 (* (load slot) 3))) iter-phi)
              (set! (index values (+ 4 (* (load slot) 3))) check-phi)
              (set! ctrl join)))
          (set! slot (+ (load slot) 1)) 0)))
    (let [long-check (n-call1! (load ctrl) check (call-value long-tree))]
      (set! (index values 29) max-depth)
      (set! (index values 30) (call-value long-check))
      (bt-build-result! (call-end long-check) result-shape (cast (ptr i64) values)))
    (if analyze (g-analyze!) 0)
    max-depth))

(defn binarytrees-build-mode! [(seed i64) (optimize bool)] (-> i64)
  (binarytrees-build-mode-analysis! seed optimize true))

(defn binarytrees-build-unanalysed! [(seed i64)] (-> i64)
  (binarytrees-build-mode-analysis! seed true false))

(defn binarytrees-build! [(seed i64)] (-> i64)
  (binarytrees-build-mode! seed true))
(defn binarytrees-build-raw! [(seed i64)] (-> i64)
  (binarytrees-build-mode! seed false))
