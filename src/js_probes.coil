;; `c` is a small constant the caller varies; `k` is a suffix that keeps names unique so probes
;; compose without colliding.
(defn js-emit-probe! [(w (ptr Writer)) (i i64) (c i64) (k i64)] (-> i64)
  (case i 0
        (do (fmt w "  acc = (acc + {d}) | 0;\n" c) 0) 1
        (do (fmt w "  acc = Math.imul(acc, {d});\n" c) 0) 2
        (do (fmt w "  acc = Math.trunc(acc / {d});\n" c) 0) 3
        (do (fmt w "  acc = acc % ({d} + 1);\n" c) 0) 4
        (do (fmt w "  acc = Math.pow(acc % 5, 2) | 0;\n") 0) 5
        (do (fmt w "  acc = (acc * -0) | 0;\n") 0) 6
        (do (fmt w "  acc = Math.round(acc / 2 + 0.5) | 0;\n") 0) 7
        (do (fmt w "  acc = (Math.floor(acc / 2) + Math.ceil(acc / 3)) | 0;\n") 0) 8
        (do (fmt w "  acc = (Math.sqrt(Math.abs(acc)) | 0) + {d};\n" c) 0) 9
        (do (fmt w "  acc = (acc + Math.sign(acc) * {d}) | 0;\n" c) 0) 10
        (do (fmt w "  acc = (Math.min(acc, {d}) + Math.max(acc, 0)) | 0;\n" c) 0) 11
        (do (fmt w "  acc = (acc + Math.clz32(acc)) | 0;\n") 0) 12
        (do (fmt w "  acc = (Math.hypot(acc % 4, 3) | 0) + {d};\n" c) 0) 13
        (do (fmt w "  acc = (acc + 2147483640 + {d}) | 0;\n" c) 0) 14
        (do (fmt w "  acc = (acc >>> {d}) | 0;\n" c) 0) 15
        (do (fmt w "  acc = (acc << {d}) | 0;\n" c) 0) 16
        (do (fmt w "  acc = ((acc ^ {d}) & 0xff) | (acc >> 2);\n" c) 0) 17
        (do (fmt w "  acc = ~acc + {d};\n" c) 0) 18
        (do (fmt w "  acc = Number.isNaN(acc / 0) ? {d} : (acc + 1) | 0;\n" c) 0) 19
        (do (fmt w "  acc = Number.isFinite(acc / 0) ? 1 : (acc + {d}) | 0;\n" c) 0) 20
        (do (fmt w "  acc = (acc + (Number.MAX_SAFE_INTEGER > acc ? {d} : 0)) | 0;\n" c) 0) 21
        (do (fmt w "  acc = (acc + (Number.isInteger(acc) ? {d} : 7)) | 0;\n" c) 0) 22
        (do (fmt w "  {{ let s{d} = (acc / 4).toFixed(2); acc = (acc + s{d}.length) | 0; }}\n" k k) 0) 23
        (do (fmt w "  acc = (parseInt(String(acc), 10) + {d}) | 0;\n" c) 0) 24
        (do (fmt w "  acc = (parseFloat(String(acc) + '.5') | 0) + {d};\n" c) 0) 25
        (do (fmt w "  acc = (+String(acc) + {d}) | 0;\n" c) 0) 26
        (do (fmt w "  {{ let i{d} = acc; i{d}++; ++i{d}; i{d}--; --i{d}; acc = i{d} + {d}; }}\n" k k k k k k c) 0) 27
        (do
          (fmt w
               "  {{ let v{d} = acc; v{d} += {d}; v{d} -= 1; v{d} *= 2; v{d} = v{d} | 0; acc = v{d}; }}\n"
               k
               k
               c
               k
               k
               k
               k
               k)
          0)
          28
        (do (fmt w "  acc = (acc + {d}, acc - 1) | 0;\n" c) 0) 29
        (do (fmt w "  if (acc > {d}) {{ acc = (acc + 1) | 0; }} else {{ acc = (acc - 1) | 0; }}\n" c) 0) 30
        (do (fmt w "  if (acc > 100) {{ acc += 1; }} else if (acc > 10) {{ acc += 2; }} else {{ acc += {d}; }}\n" c) 0)
          31
        (do (fmt w "  if (acc > 0) {{ if (acc < 1000) {{ acc = (acc + {d}) | 0; }} }}\n" c) 0) 32
        (do (fmt w "  acc = (acc & 1) === 0 ? (acc + {d}) | 0 : (acc - {d}) | 0;\n" c c) 0) 33
        (do (fmt w "  acc = acc > 8 ? (acc > 64 ? 1 : 2) : (acc > 2 ? 3 : {d});\n" c) 0) 34
        (do (fmt w "  switch (acc & 3) {{ case 0: acc += 1; case 1: acc += {d}; break; default: acc -= 1; }}\n" c) 0) 35
        (do (fmt w "  switch (acc % 5) {{ case 4: acc += {d}; break; default: acc -= {d}; }}\n" c c) 0) 36
        (do (fmt w "  if (false) {{ acc += 1000; }} else {{ acc = (acc + {d}) | 0; }}\n" c) 0) 37
        (do (fmt w "  if (true) {{ acc = (acc + {d}) | 0; }}\n" c) 0) 38
        (do (fmt w "  acc = ((acc > 0 && acc < 999) ? {d} : 1) + acc;\n" c) 0) 39
        (do (fmt w "  acc = ((acc < 0 || acc > 3) ? {d} : 1) + acc;\n" c) 0) 40
        (do (fmt w "  {{ let z{d}: any = 0; acc = ((z{d} || acc) + (acc && 1)) | 0; }}\n" k k) 0) 41
        (do (fmt w "  {{ let n{d}: any = null; acc = ((n{d} ?? acc) + {d}) | 0; }}\n" k k c) 0) 42
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < {d}; i{d}++) {{ z{d} += i{d}; }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               c
               k
               k
               k
               k)
          0)
          43
        (do
          (fmt w
               "  {{ let z{d} = 0; let i{d} = 0; while (i{d} < {d}) {{ z{d} += i{d}; i{d}++; }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               c
               k
               k
               k
               k)
          0)
          44
        (do
          (fmt w
               "  {{ let z{d} = 0; let i{d} = 0; do {{ z{d} += i{d}; i{d}++; }} while (i{d} < {d}); acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               k
               k
               k
               c
               k)
          0)
          45
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < 9; i{d}++) {{ if (i{d} > {d}) {{ break; }} z{d} += 1; }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               k
               k
               c
               k
               k)
          0)
          46
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < 9; i{d}++) {{ if (i{d} < {d}) {{ continue; }} z{d} += 1; }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               k
               k
               c
               k
               k)
          0)
          47
        (do
          (fmt w
               "  {{ let z{d} = 0; ou{d}: for (let i{d} = 0; i{d} < 4; i{d}++) {{ for (let j{d} = 0; j{d} < 4; j{d}++) {{ if (j{d} > {d}) {{ break ou{d}; }} z{d} += 1; }} }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               k
               k
               k
               k
               k
               k
               c
               k
               k
               k)
          0)
          48
        (do
          (fmt w
               "  {{ let z{d} = 0; ou{d}: for (let i{d} = 0; i{d} < 4; i{d}++) {{ for (let j{d} = 0; j{d} < 4; j{d}++) {{ if (j{d} > {d}) {{ continue ou{d}; }} z{d} += 1; }} }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               k
               k
               k
               k
               k
               k
               c
               k
               k
               k)
          0)
          49
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < {d}; i{d}++) {{ for (let j{d} = 0; j{d} < 3; j{d}++) {{ z{d} += 1; }} }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               c
               k
               k
               k
               k
               k
               k)
          0)
          50
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < 0; i{d}++) {{ z{d} += 1000; }} acc = (acc + z{d} + {d}) | 0; }}\n"
               k
               k
               k
               k
               k
               k
               c)
          0)
          51
        (do
          (fmt w
               "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < {d}; i{d}++) {{ let o{d} = {{v: i{d}}}; z{d} += o{d}.v; }} acc = (acc + z{d}) | 0; }}\n"
               k
               k
               k
               c
               k
               k
               k
               k
               k
               k)
          0)
          52
        (do
          (fmt w
               "  {{ let o{d} = {{v: 0}}; for (let i{d} = 0; i{d} < {d}; i{d}++) {{ o{d}.v = (o{d}.v + i{d}) | 0; }} acc = (acc + o{d}.v) | 0; }}\n"
               k
               k
               k
               c
               k
               k
               k
               k
               k)
          0)
          53
        (do
          (fmt w
               "  {{ function r{d}(x: number): number {{ if (x > 0) {{ return (x + {d}) | 0; }} return (x - {d}) | 0; }} acc = r{d}(acc); }}\n"
               k
               c
               c
               k)
          0)
          54
        (do (fmt w "  {{ if (acc !== acc) {{ throw new Error('x'); }} acc = (acc + {d}) | 0; }}\n" c) 0) 55
        (do (fmt w "  {{ try {{ acc = (acc + {d}) | 0; }} catch (e) {{ acc = 0; }} }}\n" c) 0) 56
        (do (fmt w "  {{ try {{ acc = (acc + {d}) | 0; }} finally {{ acc = (acc + 1) | 0; }} }}\n" c) 0) 57
        (do
          (fmt w
               "  {{ try {{ if (acc >= 0) {{ throw new Error('e'); }} acc = 5; }} catch (e) {{ acc = (acc + {d}) | 0; }} }}\n"
               c)
          0)
          58
        (do (fmt w "  {{ const f{d} = (x: number): number => (x + {d}) | 0; acc = f{d}(acc); }}\n" k c k) 0) 59
        (do
          (fmt w
               "  {{ const f{d} = function (x: number): number {{ return (x * 2 + {d}) | 0; }}; acc = f{d}(acc); }}\n"
