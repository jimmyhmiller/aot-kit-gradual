               k)
          0)
          60
        (do (fmt w "  {{ function f{d}(x: number): number {{ return (x - {d}) | 0; }} acc = f{d}(acc); }}\n" k c k) 0)
          61
        (do
          (fmt w
               "  {{ const f{d} = (a: number, b: number): number => (a + b * 2) | 0; acc = f{d}(acc, {d}); }}\n"
               k
               k
               c)
          0)
          62
        (do
          (fmt w
               "  {{ const a{d} = (x: number): number => (x + {d}) | 0; const b{d} = (x: number): number => (x * 2) | 0; acc = b{d}(a{d}(acc)); }}\n"
               k
               c
               k
               k
               k)
          0)
          63
        (do
