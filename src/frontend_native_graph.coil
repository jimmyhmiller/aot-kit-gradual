;; Direct ideal-graph construction from the Coil-owned native TypeScript frontend.
;; Node creation order intentionally mirrors frontend_coil_codegen.mjs. Exact
;; g-render equality, not merely execution equivalence, is the acceptance test.
(module frontendnativegraph)
(import "coil.primitive" :as primitive)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "jsvalue" :use *)
(import "jsbuiltin" :use *)
(import "jsbuiltin_desc" :use *)
(import "jsl" :use *)
(import "jsl_lower" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "monotonic" :as monotonic)

(defn fng-profile-now [] (-> i64)
  (monotonic/monotonic-now-ns))
(defn fng-profile-note! [(name (slice u8)) (started i64)] (-> i64)
  (let [now (fng-profile-now)]
    (fmt (stderr) "AOTK_TIMING phase={s} ns={d}\n" name (- now started))
    now))
(defn fng-window-calls-cell [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-window-scans-cell [] (-> (ptr i64)) (primitive/alloc-static i64))

(const FNG-DYNAMIC i64 -1)
(const FNG-NUMBER i64 -2)
(const FNG-BOOLEAN i64 -3)
(const FNG-NULL i64 -4)
(const FNG-VOID i64 -5)
(const FNG-LVALUE-LOCAL i64 0)
(const FNG-LVALUE-FIELD i64 1)
(const FNG-LVALUE-ELEMENT i64 2)
(const FNG-LVALUE-PROPERTYKEY i64 3)
(const FNG-ARRAY i64 -6)
(const FNG-STRING i64 -7)
(const FNG-INTRINSIC-STRING i64 -8)
(const FNG-INTRINSIC-PARSEINT i64 -9)
(const FNG-INTRINSIC-ISNAN i64 -10)
(const FNG-INTRINSIC-ERROR i64 -11)
(const FNG-INTRINSIC-ARRAY i64 -12)
(const FNG-INTRINSIC-OBJECT i64 -13)
(const FNG-INTRINSIC-NUMBER i64 -14)
(const FNG-INTRINSIC-PARSEFLOAT i64 -15)
(const FNG-ITERATOR i64 -16)
(const FNG-INTRINSIC-BOOLEAN i64 -17)
(const FNG-JUMP-BREAK i64 0)
(const FNG-JUMP-CONTINUE i64 1)
(const FNG-JUMP-THROW i64 2)
(const FNG-EXCEPTION-TARGET-LABEL i64 -2)
(const FNG-EXCEPTION-PENDING-DESCRIPTOR i64 101)
(const FNG-EXCEPTION-TAKE-DESCRIPTOR i64 102)
(const FNG-EXCEPTION-UNCAUGHT-DESCRIPTOR i64 103)
(const FNG-EXCEPTION-RETURN-DESCRIPTOR i64 104)

(defstruct FngLValue
  [(kind i64) (symbol i64) (object i64) (key i64) (alias i64) (shape i64)])

(defstruct FngTarget
  [(label-node i64)
   (can-break bool)
   (can-continue bool)
   (active bool)
   (symbol-start i64)
   (symbol-count i64)
   (active-start i64)
   (active-count i64)
   (jump-start i64)
   (jump-value-start i64)])

(defstruct FngJump [(target i64) (kind i64) (ctrl i64) (value-start i64) (dependency i64)])

(defstruct FngContext
  [(frontend (ptr NativeFrontend))
   (values (ptr (ArrayList i64)))
   (value-types (ptr (ArrayList i64)))
   (functions (ptr (ArrayList i64)))
   (prototypes (ptr (ArrayList i64)))
   (shapes (ptr (ArrayList i64)))
   (aliases (ptr (ArrayList i64)))
   (effects (ptr (ArrayList bool)))
   (dynamic-aliases (ptr (ArrayList i64)))
   (type-count i64)
   (ctrl (ptr i64))
   (memory (ptr i64))
   (first-return (ptr i64))
   (targets (ptr (ArrayList FngTarget)))
   (target-symbols (ptr (ArrayList i64)))
   (target-active (ptr (ArrayList i64)))
   (jumps (ptr (ArrayList FngJump)))
   (jump-values (ptr (ArrayList i64)))
   (exception-dependency (ptr i64))
   (cell-shape i64)
   (cell-alias i64)
   (receiver i64)
   (owner i64)
   (fun i64)
   (top-level bool)])

(defn fng-context [(frontend (ptr NativeFrontend))
                   (values (ptr (ArrayList i64)))
                   (value-types (ptr (ArrayList i64)))
                   (functions (ptr (ArrayList i64)))
                   (prototypes (ptr (ArrayList i64)))
                   (shapes (ptr (ArrayList i64)))
                   (aliases (ptr (ArrayList i64)))
                   (effects (ptr (ArrayList bool)))
                   (dynamic-aliases (ptr (ArrayList i64)))
                   (type-count i64)
                   (ctrl (ptr i64))
                   (memory (ptr i64))
                   (first-return (ptr i64))
                   (targets (ptr (ArrayList FngTarget)))
                   (target-symbols (ptr (ArrayList i64)))
                   (target-active (ptr (ArrayList i64)))
                   (jumps (ptr (ArrayList FngJump)))
                   (jump-values (ptr (ArrayList i64)))
                   (exception-dependency (ptr i64))
                   (cell-shape i64)
                   (cell-alias i64)
                   (receiver i64)
                   (owner i64)
                   (fun i64)
                   (top-level bool)] (-> FngContext)
  (FngContext :frontend
              frontend
              :values
              values
              :value-types
              value-types
              :functions
              functions
              :prototypes
              prototypes
              :shapes
              shapes
              :aliases
              aliases
              :effects
              effects
              :dynamic-aliases
              dynamic-aliases
              :type-count
              type-count
              :ctrl
              ctrl
              :memory
              memory
              :first-return
              first-return
              :targets
              targets
              :target-symbols
              target-symbols
              :target-active
              target-active
              :jumps
              jumps
              :jump-values
              jump-values
              :exception-dependency
              exception-dependency
              :cell-shape
              cell-shape
              :cell-alias
              cell-alias
              :receiver
              receiver
              :owner
              owner
              :fun
              fun
              :top-level
              top-level))

(defn fng-optimize-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))

(defn fng-reuse-jsl-index-ptr [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn fng-jsl-index-ready-ptr [] (-> (ptr bool))
  (primitive/alloc-static bool))

(defn fng-profile-memory-alias-calls-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-memory-alias-edges-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-preserve-calls-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-preserve-fields-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-current-scans-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-method-chains-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-method-candidates-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-static-method-calls-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-static-method-hits-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn fng-profile-static-method-scans-ptr [] (-> (ptr i64)) (primitive/alloc-static i64))

;; Long-lived harness workers compile many isolated graphs against the same immutable library.
;; Ordinary frontend users retain the full reset/read/check behavior on every build.
(defn frontend-native-reuse-jsl-index! [(enabled bool)] (-> i64)
  (set! (fng-reuse-jsl-index-ptr) enabled)
  (if (not enabled) (set! (fng-jsl-index-ready-ptr) false) 0)
  0)

(defn fng-numeric-string-add-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))

(defn fng-capture-by-value-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))

(defn fng-omit-receiver-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))

(defn fng-duplicate-receiver-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))

(defn fng-analyze-fresh! [] (-> i64)
  (let [(mut index) 0
        started (fng-profile-now)]
    (loop (if (>= (load index) (n-count))
              (break)
              (do
                (if (n-dead? (load index)) 0 (n-set-ty! (load index) (t-top)))
                (set! index (+ (load index) 1)))))
    ;; ANALYSE, FOLD, AND THEN ANALYSE WHAT THE FOLD LEFT.
    ;;
    ;; `g-fold-proven!` REWIRES the graph -- it replaces proven nodes with constants, collapses the
    ;; branches that then become dead, and reduces the phis on the regions those collapses remove.
    ;; Every one of those is an input change for something downstream, and nothing re-queued them,
    ;; so the pass returned with types describing the graph as it was BEFORE the fold. `g-verify`
    ;; says VERR-STALE-TYPE, and the stale type is the pre-fold one, which is wider than the truth
    ;; in some places and narrower in others.
    ;;
    ;; It was invisible while little folded. Once `box-compute` began carrying its input's kind,
    ;; the DSL's tag guards started proving and the amount of folding went up sharply, which is
    ;; what surfaced it. See docs/DSL-OWNERSHIP.md.
    ;;
    ;; Bounded because each round must FOLD something to earn the next one, and folding is
    ;; monotone: it only ever replaces nodes with constants and deletes control.
    (let [(mut rounds) 0
          (mut stable) 0
          (mut analyze-ns) 0
          (mut fold-ns) 0
          (mut iterate-ns) 0
          (mut fold-rounds) 0
          (mut iterate-steps) 0]
      (loop (do
                (let [phase (fng-profile-now)]
                  (g-analyze!)
                  (set! analyze-ns (+ (load analyze-ns) (- (fng-profile-now) phase))))
                (let [before (g-live-count)]
                  (let [phase (fng-profile-now)]
                    (set! fold-rounds (+ (load fold-rounds) (g-fold-proven-for-iterate!)))
                    (set! fold-ns (+ (load fold-ns) (- (fng-profile-now) phase))))
                  ;; `g-fold-proven!` turns a proven predicate into a constant; `iterate!` is what
                  ;; then collapses the `If`, retires the unreachable projection and reduces the
                  ;; phis on the region that loses an arm. Folding without it leaves the branch
                  ;; standing with one dead side -- every guard proved and none of them removed,
                  ;; which is most of the cost the DSL was being blamed for.
                  (let [phase (fng-profile-now)]
                    (set! iterate-steps (+ (load iterate-steps) (iterate!)))
                    (set! iterate-ns (+ (load iterate-ns) (- (fng-profile-now) phase))))
                  (set! rounds (+ (load rounds) 1))
                  ;; TWO STABLE ROUNDS, not one. A round that folds nothing may still have PROVEN
                  ;; something -- the analysis at the top of it -- and that proof only becomes a
                  ;; deletion in the round after. Stopping on the first quiet round left a CProj
                  ;; typed `~ctrl` still wired into a live Region, which the evaluator walks into:
                  ;; "control reached a dead node".
                  (if (= (g-live-count) before)
                      (set! stable (+ (load stable) 1))
                      (set! stable 0))
                  (if (or (>= (load stable) 2) (> (load rounds) 12))
                      (break)
                      0))))
      ;; One last analysis so the types describe the graph that actually survived.
      (let [phase (fng-profile-now)]
        (g-analyze!)
        (set! analyze-ns (+ (load analyze-ns) (- (fng-profile-now) phase))))
      (fmt (stderr) "AOTK_TIMING phase=frontend_analyze_core ns={d}\n" (load analyze-ns))
      (fmt (stderr) "AOTK_TIMING phase=frontend_fold ns={d}\n" (load fold-ns))
      (fmt (stderr) "AOTK_TIMING phase=frontend_iterate ns={d}\n" (load iterate-ns))
      (fmt (stderr) "AOTK_TIMING phase=frontend_analyze_rounds ns={d}\n" (load rounds))
      (fmt (stderr) "AOTK_TIMING phase=frontend_fold_rounds ns={d}\n" (load fold-rounds))
      (fmt (stderr) "AOTK_TIMING phase=frontend_iterate_steps ns={d}\n" (load iterate-steps))
      (fmt (stderr) "AOTK_PROFILE phase=peephole peeps={d} compute_ns={d} proof_ns={d} proof_calls={d} proof_snapshot_ns={d} proof_snapshot_calls={d} proof_visits={d} proof_max={d} idealize_ns={d} gvn_ns={d}\n"
           (g-profile-peeps) (g-profile-compute-ns) (g-profile-proof-ns)
           (g-profile-proof-calls) (g-profile-proof-snapshot-ns)
           (g-profile-proof-snapshot-calls) (g-profile-proof-visits) (g-profile-proof-max)
           (g-profile-idealize-ns) (g-profile-gvn-ns))
      (fmt (stderr) "AOTK_PROFILE phase=frontend_work analyze_pops={d} fold_scans={d} fold_candidates={d} iterate_live_scans={d} iterate_pops={d} iterate_sweeps={d} proof_snapshot_seeds={d} proof_snapshot_edges={d}\n"
           (g-profile-analyze-pops) (g-profile-fold-scans) (g-profile-fold-candidates)
           (g-profile-iterate-live-scans) (g-profile-iterate-pops) (g-profile-iterate-sweeps)
           (g-profile-proof-snapshot-seeds) (g-profile-proof-snapshot-edges))
      (fng-profile-note! "frontend_analyze" started))))

(defn fng-peep [(node i64)] (-> i64)
  (if (load (fng-optimize-ptr)) (n-peephole node) node))

(defn fng-const [(value i64)] (-> i64)
  (n-new1 (Const (t-int-con value)) (g-start)))

(defn fng-bool [(value bool)] (-> i64)
  (n-new1 (Const (t-bool-con value)) (g-start)))

(defn fng-null [] (-> i64)
  (n-new1 (Const (t-null)) (g-start)))

(defn fng-undefined [] (-> i64)
  (n-new1 (Const (t-undef)) (g-start)))

(defn fng-string-literal [(ast TsAst) (node i64)] (-> i64)
  (let [(mut bytes) (al-new [u8] (malloc-allocator))
        text (ts-literal-text! ast node (mut bytes))
        string (jss-from-utf8! text)]
    (al-free! [u8] (mut bytes))
    (n-string-const! string)))

(defn fng-static-property-name [(ast TsAst) (node i64)] (-> i64)
  (if (= (ts-kind ast node) TSK-STRING-LITERAL)
      (let [(mut bytes) (al-new [u8] (malloc-allocator))
            name (ts-literal-text! ast node (mut bytes))
            id (shape-name-intern! name)]
        (al-free! [u8] (mut bytes))
        id)
      (shape-name-intern! (ts-text ast node))))

;; Template syntax supplies the sequencing; JavaScript conversion and concatenation stay in JSL.
;; Each span is evaluated exactly once, from left to right, before its following cooked literal.
(defn fng-template-expression [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        (mut value) (fng-string-literal ast (ts-child ast node 0))
        (mut index) 1]
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [span (ts-child ast node (load index))
                    expression (ts-child ast span 0)
                    literal (ts-child ast span 1)
                    converted (fng-jsl-call1 context "ToStringValue"
                                             (fng-expression context expression))
                    with-value (fng-jsl-call2 context "StringConcat" (load value) converted)]
                (set! value
                      (fng-jsl-call2 context "StringConcat"
                                     with-value
                                     (fng-string-literal ast literal)))
                (set! index (+ (load index) 1)))))
    (load value)))

(defn fng-numeric-literal [(ast TsAst) (node i64)] (-> i64)
  (let [bits (ts-numeric-bits ast node)
        number (bits-f64 bits)]
    ;; TypeScript accepts hexadecimal, binary, and octal integer spellings that the decimal text
    ;; parser does not. Recover every exactly represented safe integer from the parser's numeric
    ;; value so bitwise loop Phis start in the GPR representation instead of an accidental FPR.
    (if (and (>= number -9007199254740991.0)
             (and (<= number 9007199254740991.0)
                  (= bits (f64-bits (cast f64 (cast i64 number))))))
        (fng-const (cast i64 number))
        (n-new1 (Const (t-flt-bits bits)) (g-start)))))

(defn fng-direct-call-object-type [(value i64)] (-> i64)
  (if (and (>= value 0) (op-is? value Call [_]))
      (let [callee (n-in value 1)
            target (if (op-is? callee Closure [_]) (n-in callee 0) callee)
            (mut index) 1
            (mut answer) (t-top)
            (mut valid) (op-is? target Fun [_])]
        (loop (if (or (>= (load index) (n-nins target)) (not (load valid)))
                  (break)
                  (let [ret (n-in target (load index))]
                    (if (op-is? ret Return [])
                        (let [result-type (n-ty (n-in ret 1))]
                          (if (ty-only-obj? result-type)
                              (if (= (load answer) (t-top))
                                  (set! answer result-type)
                                  (if (!= (load answer) result-type) (set! valid false) 0))
                              (set! valid false)))
                        0)
                    (set! index (+ (load index) 1)))))
        (if (load valid) (load answer) (t-top)))
      (t-top)))

(defn fng-box-dynamic-argument! [(value i64)] (-> i64)
  ;; A Phi's semantic `dyn` type does not prove that its incoming machine words are tagged.
  ;; Lift the representation conversion through the merge so raw null/object arms are boxed,
  ;; while inputs already produced in the tagged ABI remain unchanged by backend selection.
  (let [(mut closed) true (mut probe) 1]
    (if (and (>= value 0) (op-is? value Phi [_]))
        (loop (if (or (>= (load probe) (n-nins value)) (not (load closed)))
                  (break)
                  (do
                    (if (= (n-in value (load probe)) NO-NODE) (set! closed false) 0)
                    (set! probe (+ (load probe) 1))
                    0)))
        0)
  (if (and (>= value 0) (and (op-is? value Phi [_]) (load closed)))
      (let [boxed (n-new (Phi (t-dyn)))
            (mut index) 1]
        (n-add-def! boxed (n-in value 0))
        (loop (if (>= (load index) (n-nins value))
                  (break)
                  (do
                    (n-add-def! boxed
                                (if (= (n-in value (load index)) value)
                                    boxed
                                    (n-box! (n-in value (load index)))))
                    (set! index (+ (load index) 1)))))
        boxed)
      (let [object-type (fng-direct-call-object-type value)]
        (n-box! (if (= object-type (t-top))
                    value
                    (n-new2 (Cast object-type) (n-in value 0) value)))))))

(defn fng-tagged-dynamic-value? [(value i64)] (-> bool)
  ;; Type computation can lag graph construction, so `n-ty == dyn` alone is not reliable while
  ;; lowering a body. These producers have a defined tagged-JavaScript-value machine ABI.
  (if (< value 0)
      false
      (match (n-op value)
        (PropLoad [_] true)
        (ArrayLoad [_] true)
        (Load [alias] (= (shape-alias-ty alias) (t-dyn)))
        (_ false))))

;; `fng-tagged-dynamic-value?` answers for the producers whose ABI is tagged by DECLARATION. A
;; `Box` is tagged by construction and belongs in the same answer, and it is the one this file
;; reaches most often, because a load that forwards through a store lands on the boxed value the
;; store wrote rather than on a Load node at all.
(defn fng-value-tagged? [(value i64)] (-> bool)
  (if (< value 0)
      false
      (if (fng-tagged-dynamic-value? value)
          true
          (match (n-op value)
            (Box [_] true)
            (_ (= (n-ty value) (t-dyn)))))))

;; PUT `value` IN THE REPRESENTATION THIS ALIAS'S SLOT HOLDS.
;;
;; Every write through a declared field goes through here, so the frontend cannot emit a slot in
;; one representation and a value in another -- which is what `o.q = o.p` did whenever `p` and `q`
;; disagreed, since the forwarded load handed the store `p`'s boxed word directly. The
;; classification is `shape-alias-rep`, the same one the verifier judges by.
;; THE TAGGED TEST IS THE STRUCTURAL WALK, NOT ONLY `fng-value-tagged?`. That helper's last resort
;; is `(= (n-ty value) (t-dyn))`, and during construction `n-ty` is a MOMENTARY state that depends
;; on peephole visit order: a DSL call's result is a fresh Phi whose type may or may not have been
;; computed by the time the store is lowered. It usually had been -- until a compiler update
;; changed an unspecified iteration order and `o.x = acc` after `acc += 1` stored the tagged word
;; raw, with the SOURCE tree unchanged. Same rule as everywhere else in this file: a decision made
;; at build time keys on SHAPE. `fng-boxed-dynamic-value?` is the shape answer -- it walks to the
;; Box/ToNumber arms a DSL result actually has, whatever its type currently reads.
(defn fng-coerce-to-alias [(alias i64) (value i64)] (-> i64)
  (let [rep (shape-alias-rep alias)]
    (cond (= rep REP-TAGGED) (fng-box-dynamic-argument! value)
          (= rep REP-RAW-NUM)
            (if (or (fng-value-tagged? value) (fng-boxed-dynamic-value? value))
                (n-unbox! value (t-flt))
                value)
          (= rep REP-RAW-PTR)
            ;; Unbox to the slot's own object type, not to a generic pointer: the verifier reads
            ;; the Unbox's target to decide it produced raw-ptr.
            (if (or (fng-value-tagged? value) (fng-boxed-dynamic-value? value))
                (n-unbox! value (shape-alias-ty alias))
                value)
          :else value)))

;; Mark array, walk stack, and generation stamp for `fng-boxed-dynamic-value?`, following the
;; backend's fp-walk discipline exactly (backend_core's fp-mark/fp-stack): one shared buffer,
;; generation-stamped marks, and a busy flag so an accidental reentrant walk aborts instead of
;; answering from a truncated stack.
(defstruct FngBoxedWalk
  [(mark (ArrayList i64))
   (stack (ArrayList i64))
   (gen i64)
   (busy bool)
   (inited bool)])

(defn fng-boxed-walk-unit [] (-> (ptr FngBoxedWalk))
  (let [p (primitive/alloc-static FngBoxedWalk)]
    (if (.inited p)
        0
        (do
          (set! (.inited p) true)
          (set! (.mark p) (al-new [i64] (malloc-allocator)))
          (set! (.stack p) (al-new [i64] (malloc-allocator)))
          (set! (.gen p) 0)
          (set! (.busy p) false)
          0))
    p))

;; Is this value CERTAINLY a tagged word by construction — a tagged-ABI producer
;; (`fng-tagged-dynamic-value?`), a Box, a runtime ToNumber, or a Phi reached through Casts and
;; other Phis from such a producer on any arm? Seed types lag construction, so `n-ty == dyn` is
;; not enough: a JSL macro like StringCodePointAt inlines to nested diamonds whose arms are all
;; `%Box`, and the join's seed type is still unanalysed while the consuming expression is being
;; lowered — `codePointAt(0) * 2` selected a raw multiply over the tagged word (correct only by
;; the low-32-bit accident, wrong the moment the payload is float-represented; repros/negload.js
;; is the observed form of that failure). The walk is marked, not fuel-bounded: a wrong answer in
;; EITHER direction miscompiles (a missed guard feeds tag bits to arithmetic; a spurious guard
;; feeds raw bits to the tag test), so depth may not decide it. A Phi is boxed if ANY arm is —
;; the frontend never deliberately builds a mixed-representation Phi (see lib/string/char.jsl's
;; StringAt note), and the representation verifier now rejects graphs where one leaks through.
(defn fng-boxed-dynamic-value? [(value i64)] (-> bool)
  (let [u (fng-boxed-walk-unit)]
    (if (.busy u)
        (do (panic-corrupt "fng-boxed-dynamic-value?: reentrant walk; the mark and stack are shared") 0)
        0)
    (set! (.busy u) true)
    (loop (if (>= (al-len [i64] (.mark u)) (n-count))
              (break)
              (do (al-push! [i64] (field u mark) 0) 0)))
    (set! (.gen u) (+ (.gen u) 1))
    (let [gen (.gen u)
          (mut found) false]
      (al-clear! [i64] (field u stack))
      (al-push! [i64] (field u stack) value)
      (loop (let [depth (al-len [i64] (.stack u))]
              (if (or (load found) (= depth 0))
                  (break)
                  (let [m (al-get (.stack u) (- depth 1))]
                    (al-pop! [i64] (field u stack))
                    (if (or (< m 0) (= (al-get (.mark u) m) gen))
                        0
                        (do
                          (al-set! [i64] (field u mark) m gen)
                          (if (fng-tagged-dynamic-value? m)
                              (set! found true)
                              (match (n-op m)
                                (Box [_] (set! found true))
                                (ToNumber [] (set! found true))
                                (Cast [_] (do (al-push! [i64] (field u stack) (n-in m 1)) 0))
                                (Phi [_]
                                  (let [(mut input) 1]
                                    (loop (if (>= (load input) (n-nins m))
                                              (break)
                                              (do
                                                (al-push! [i64] (field u stack)
                                                          (n-in m (load input)))
                                                (set! input (+ (load input) 1))
                                                0)))
                                    0))
                                (_ 0)))
                          0))))))
      (set! (.busy u) false)
      (load found))))

;; A dynamic argument can be consumed while a loop Phi is still open. At that point its backedge
;; is unknown, so `fng-box-dynamic-argument!` must leave a Box(Phi) placeholder. Once all function
;; bodies have closed their loops, distribute those placeholders across the incoming CFG edges.
;; Doing this as a graph repair (rather than an ordinary peephole replacement) is essential for a
;; loop Phi: the tagged replacement is self-referential and recursively peepholing it never reaches
;; a leaf.
(defn fng-distribute-deferred-phi-boxes! [] (-> i64)
  (let [limit (n-count)
        (mut node) 0]
    (loop (if (>= (load node) limit)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (op-is? (load node) Box [_]))
                    (let [value (n-in (load node) 1)]
                      (if (and (!= value NO-NODE)
                               (and (not (n-dead? value)) (op-is? value Phi [_])))
                          (let [(mut input) 1
                                (mut closed) true]
                            (loop (if (or (>= (load input) (n-nins value))
                                          (not (load closed)))
                                      (break)
                                      (do
                                        (if (= (n-in value (load input)) NO-NODE)
                                            (set! closed false)
                                            0)
                                        (set! input (+ (load input) 1)))))
                            (if (load closed)
                                (let [boxed (n-new (Phi (t-dyn)))]
                                  (n-add-def! boxed (n-in value 0))
                                  (set! input 1)
                                  (loop (if (>= (load input) (n-nins value))
                                            (break)
                                            (do
                                              (let [incoming (n-in value (load input))]
                                                (n-add-def! boxed
                                                            (if (= incoming value)
                                                                boxed
                                                                (n-box! incoming))))
                                              (set! input (+ (load input) 1)))))
                                  (n-keep! boxed)
                                  (n-subsume! (load node) boxed)
                                  (n-unkeep! boxed)
                                  0)
                                0))
                          0))
                    0)
                (set! node (+ (load node) 1)))))
    0))

;; The declared type of a callee's parameter, or `FNG-DYNAMIC` when there is no such parameter.
(defn fng-parameter-type [(frontend (ptr NativeFrontend))
                          (fn FeFunction)
                          (ordinal i64)] (-> i64)
  ;; Surplus actuals are ELEMENTS of a rest array, not values of the array's declared type.
  (if (or (< ordinal 0)
          (or (>= ordinal (.parameter-count fn))
              (and (.rest fn) (>= ordinal (- (.parameter-count fn) 1)))))
      FNG-DYNAMIC
      (let [symbol
              (al-get [FeSymbol]
                      (.symbols frontend)
                      (+ (.parameter-start fn) ordinal))]
        (fng-type-tag frontend (.type-node symbol)))))

;; Normalize already-evaluated actuals for one exact target. The compiler owns the statically
;; known formal/surplus split; allocation and element writes remain JSL operations.
(defn fng-normalize-call-arguments! [(context FngContext)
                                     (fn FeFunction)
                                     (args (mut (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        source-count (al-len [i64] (load args))
        fixed-count (if (.rest fn) (- (.parameter-count fn) 1) (.parameter-count fn))
        (mut normalized) (al-new [i64] (malloc-allocator))
        (mut ordinal) 0]
    (loop (if (>= (load ordinal) fixed-count) (break)
            (do (al-push! [i64]
                          (mut normalized)
                          (fng-call-argument frontend fn (load ordinal)
                            (if (< (load ordinal) source-count)
                                (al-get [i64] (load args) (load ordinal))
                                (fng-undefined))))
                (set! ordinal (+ (load ordinal) 1)))))
    (if (.rest fn)
        (let [rest-array (fng-jsl-call0 context "NewArray")]
          (set! ordinal fixed-count)
          (loop (if (>= (load ordinal) source-count) (break)
                  (do (fng-jsl-call2 context "ArrayOfAppend1"
                                     rest-array
                                     (fng-box-dynamic-argument!
                                       (al-get [i64] (load args) (load ordinal))))
                      (set! ordinal (+ (load ordinal) 1)))))
          (al-push! [i64]
                    (mut normalized)
                    (fng-call-argument frontend fn fixed-count rest-array)))
        0)
    (set! (.len args) 0)
    (set! ordinal 0)
    (loop (if (>= (load ordinal) (al-len [i64] (load normalized))) (break)
            (do (al-push! [i64] (mut args)
                          (al-get [i64] (load normalized) (load ordinal)))
                (set! ordinal (+ (load ordinal) 1)))))
    (al-free! [i64] (mut normalized))
    0))

;; The expected type an ARGUMENT expression is lowered under, which is only ever a structural shape.
;;
;; An object literal builds a different object depending on what is expected of it: with a shape it
;; gets real field slots, and with `FNG-DYNAMIC` it gets `SHAPE-ROOT` and a dynamic property table.
;; `let o: T = {value: 41}` already supplied the shape and an argument position did not, so
;; `get({value: 41})` allocated a dynamic object, handed it to a callee reading `Load#0` off the
;; declared shape, and answered 0 — silently, on three lines of ordinary TypeScript.
;;
;; Only shape ids are forwarded. `FNG-NUMBER` is also an expected type `fng-expression-expected`
;; understands, and forwarding it here would change how numeric arguments are built for no reason
;; this bug requires.
(defn fng-argument-expected [(frontend (ptr NativeFrontend))
                             (fn FeFunction)
                             (ordinal i64)
                             (known bool)] (-> i64)
  (if (not known)
      FNG-DYNAMIC
      (let [declared (fng-parameter-type frontend fn ordinal)]
        (if (>= declared 0) declared FNG-DYNAMIC))))

(defn fng-call-argument [(frontend (ptr NativeFrontend))
                         (fn FeFunction)
                         (ordinal i64)
                         (value i64)] (-> i64)
  (if (or (< ordinal 0) (>= ordinal (.parameter-count fn)))
      value
      (let [parameter-type (fng-parameter-type frontend fn ordinal)]
        ;; Parm nodes carry JavaScript values. Numeric consumers therefore unbox typed number
        ;; parameters just as they unbox dynamic parameters; publish numeric actuals in that same
        ;; tagged ABI instead of passing an FPR/GPR word to a callee expecting a boxed value.
        ;;
        ;; AN OBJECT-TYPED PARAMETER IS THE SAME BARGAIN, and leaving it out was a `SIGTRAP` on
        ;; three lines of ordinary TypeScript:
        ;;
        ;;     type T = { value: number };
        ;;     function get(t: T): number { return t.value; }
        ;;     get({value: 41})
        ;;
        ;; The callee reads `t.value` through the declared shape, so it emits `Unbox : obj@2` on its
        ;; `Parm` — which is right, because a Parm is a tagged JavaScript value. The caller handed it
        ;; the RAW object pointer the allocation produced, and `MI-JSUNBOX` traps on a word nothing
        ;; tagged. A structural type is a shape id, which is non-negative, where every `FNG-` kind is
        ;; negative; that is the whole test.
        ;;
        ;; It never showed up because the corpus passes objects that are ALREADY tagged — an array
        ;; element in `integrated-heap-program.ts`, which `fng-tagged-dynamic-value?` recognises and
        ;; leaves alone. A freshly allocated one is the case nothing covered.
        ;; FNG-ARRAY is in this set for the same reason FNG-DYNAMIC is, and it was FNG-DYNAMIC
        ;; until `fng-type-tag` learned about `KindArrayType`: an array parameter is a `Parm`, a
        ;; `Parm` is a tagged JavaScript value, and the caller must hand over a tagged one.
        (if (or (>= parameter-type 0)
                (or (= parameter-type FNG-DYNAMIC)
                    (or (= parameter-type FNG-NUMBER) (= parameter-type FNG-ARRAY))))
            (if (fng-tagged-dynamic-value? value) value (fng-box-dynamic-argument! value))
            value))))

;; THE CONDITION POSITION HOLDS NO SEMANTICS. `If` owns JavaScript truthiness end to end: the
;; evaluator judges with `rt-truthy?` and selection dispatches a tagged word to the runtime's
;; VALUE-TRUTHY, a float to MI-FTRUTH, and a raw integer to the zero test. What a condition needs
;; from the frontend is REPRESENTATION only: a raw string pointer is the one representation with
;; no truthy contract -- an empty and a non-empty string are both non-zero addresses -- so a
;; string-valued condition boxes and takes the tagged path. This used to be a `StringLength`
;; call, which was the frontend spelling out string truthiness (`length != 0`) by hand.
(defn fng-condition-representation [(context FngContext) (source i64)] (-> i64)
  (let [value (fng-expression context source)]
    (if (= (fng-infer context source FNG-DYNAMIC) FNG-STRING)
        (n-box! value)
        value)))

;; The dynamic-to-number seam, and the difference between an UNBOX and a COERCION.
;;
;; `Unbox : flt` asserts a representation: it strips a tag it has already been promised is there,
;; and `MI-JSUNBOX` traps when it is not. That is the right node for a value the compiler knows is
;; a number and the wrong one for an arbitrary JavaScript value, and the frontend used it for both.
;; `let xs = [10, 20]; xs[5] + 1` reads a hole, correctly answers `undefined`, and then unboxed it
;; as a number: `SIGTRAP` on a program Node runs to `NaN`. Nothing in the conformance corpus read a
;; hole or a past-the-end index into arithmetic, which is why it survived — `arrays.ts` reads
;; `sparse[0]` and `sparse[2]` and never `sparse[1]`.
;;
;; ToNumber is what JavaScript specifies here, and it already existed on both sides of the compiler:
;; `ev-to-number-value` in eval.coil and `aot_js_to_number_double` in the runtime implement the same
;; table (undefined is NaN, null is +0, a boolean is 0 or 1, a string parses). The graph was the only
;; place that did not say so. `OPTAG-TONUMBER` returns a BOXED number, so the unbox stays — but now its
;; promise is one the producer keeps.
;;
;; It is emitted ONLY where the value is dynamic. A value the frontend already types as a number is
;; unboxed directly, so nothing that was straight-line arithmetic acquires a coercion.
;;
;; IT COMES FROM `lib/`, THROUGH `ToNumberValue`, AND THAT IS NOT DECORATION. A bare `%ToNumber`
;; is a runtime call on every operand, numbers included, and this is the hottest boundary the
;; frontend has: unguarded it cost `call-loop` 9.6ms to 25.5ms and `math-loop` 73.3ms to 97.3ms.
;; The library definition carries the spec's own steps 1 and 2 — an argument that is already a
;; Number is returned as it is — so the call survives only for the strings and the objects.
(defn fng-to-number-operand [(context FngContext) (value i64)] (-> i64)
  (n-unbox! (fng-jsl-call1 context "ToNumberValue" value) (t-flt)))

;; Does this operand still need ToNumber, or is it already an unboxed machine number?
;;
;; THE TEST IS EXACT TYPE IDENTITY WITH `dyn`, and it is deliberately not `ty-isa ... (t-num)`.
;; This lattice puts ANY — "not analysed yet", the seed `n-new` gives every node — ABOVE every
;; concrete type, so `ANY isa num` is true and reads exactly like a proof that the value is already
;; a machine number. `ty-high?` cannot tell the two apart either, and ty.coil says so at length.
;; Both were tried here: the first skipped the coercion on anything unanalysed, the second put one
;; on the literal `1000` in `xs[0] * 1000` — a raw machine word ToNumber must never see.
;;
;; Extracted from the two callers below only so that the rule is stated once. `captured-cell` is a
;; variable that lives in a heap cell because a closure writes it, which is a tagged word whatever
;; the syntax says its type is.
;; Does this value certainly carry a RAW machine number? Seed types lag construction, so an
;; open Phi reads as dyn even when every incoming value is raw numeric — follow the structure
;; with fuel, the same way the backend's return-kind analysis does, or the caller injects a
;; tagged-word conversion the backend then feeds a raw float (MLIVE-CLASS on arrow-lexical-this).
(defn fng-machine-number-value? [(v i64) (fuel i64)] (-> bool)
  (if (or (= v NO-NODE) (<= fuel 0))
      false
    ;; AN OPEN LOOP PHI IS NOT A MACHINE NUMBER YET, whatever its one visible arm says. `i++` asked
    ;; this to decide the write-back representation and got "raw" from the entry `0`, so it wrote a
    ;; raw FLOAT into a phi whose other arm is a raw INT -- one phi, two register classes, and every
    ;; integer consumer read the double's bit pattern. `a[i]` and `s.charCodeAt(i)` inside an `i++`
    ;; loop then indexed 0 on every iteration. Answering false here writes the tagged value back, so
    ;; the phi is tagged on both arms and the use sites unbox it; where the counter really is an
    ;; integer the guards fold and the loop is the same two instructions it was.
    (if (fng-open-loop-phi? v)
        false
      ;; The boxed walk, not just the shallow producer test: `ty-isa ANY num` below is true for
      ;; an unanalysed Phi, so a Phi joining Box arms would otherwise read as a machine number.
      (if (fng-boxed-dynamic-value? v)
          false
          (if (ty-isa (n-ty v) (t-num))
              true
              (if (op-is? v Phi [_])
                  (let [(mut i) 1
                        (mut ok) (> (n-nins v) 1)]
                    (loop (if (or (>= (load i) (n-nins v)) (not (load ok)))
                              (break)
                              (do
                                (let [input (n-in v (load i))]
                                  (if (and (!= input v)
                                           (not (fng-machine-number-value? input (- fuel 1))))
                                      (set! ok false)
                                      0))
                                (set! i (+ (load i) 1))
                                0)))
                    (load ok))
                  ;; A delegated result: `() => f()` returns f's raw representation, so follow the
                  ;; direct callee the same way the backend's return-kind analysis does.
                  (if (and (op-is? v Call [_])
                           (or (op-is? (n-in v 1) Fun [_])
                               (op-is? (n-in v 1) Closure [_])))
                      (fng-call-returns-machine-number-fuel? v (- fuel 1))
                      false)))))))

;; Is this a DIRECT call whose callee returns a MACHINE NUMBER on every return arm? The
;; number-conversion exemption for direct calls assumed "direct => raw numeric return", but a
;; callee that returns a dyn-content field load returns a TAGGED word (drop4: readX over
;; dyn-shaped {x,y} returned 0x7ffc-tagged 4; the caller's scvtf then converted the tag bits as
;; an integer, contaminating the total by ~9.2e18). A Fun's inputs after its FunStart are its
;; Returns, so the callee's actual return types are inspectable at the call site.
(defn fng-call-returns-machine-number-fuel? [(value i64) (fuel i64)] (-> bool)
  (let [callee (n-in value 1)
        fun (if (op-is? callee Closure [_]) (n-in callee 0) callee)]
    (if (or (<= fuel 0) (not (op-is? fun Fun [_])))
        false
    ;; A Fun with no Return inputs is NOT BUILT YET: nested function bodies lower after the
    ;; enclosing body that calls them, so their returns are uninspectable here. Keep the old
    ;; structural exemption for those (converting blindly injected tagged-word conversions into
    ;; raw-float paths — MLIVE-CLASS on arrow-lexical-this); a BUILT callee whose return is
    ;; tagged still gets the conversion, which is the drop4/object-parameters fix.
    (if (< (n-nins fun) 2)
        true
        (let [(mut i) 1
              (mut ok) true]
          (loop (if (or (>= (load i) (n-nins fun)) (not (load ok)))
                    (break)
                    (do
                      (let [ret (n-in fun (load i))]
                        (if (and (!= ret NO-NODE) (op-is? ret Return []))
                            (if (match (n-op (n-in ret 1))
                                  (JsBuiltin [descriptor]
                                    (= descriptor FNG-EXCEPTION-RETURN-DESCRIPTOR))
                                  (_ false))
                                0
                                (if (fng-machine-number-value? (n-in ret 1) fuel)
                                    0
                                    (set! ok false)))
                            0))
                      (set! i (+ (load i) 1))
                      0)))
          (load ok))))))

(defn fng-call-returns-machine-number? [(value i64)] (-> bool)
  (fng-call-returns-machine-number-fuel? value 8))

;; A loop-carried local may be assigned values of BOTH machine representations: NavierStokes'
;; `lastX` in lin_solve enters the loop as a tagged ArrayLoad and comes back around as a raw
;; Mul result. A Phi whose arms disagree has no single register class — selection classified it
;; from whichever arm its walk reached first and every consumer re-derived its own answer
;; (MLIVE-CLASS on repros/proj2.js once the guarded ToNumber consumed the tagged arm honestly).
;; Tagged is the representation that can hold every arm, so when any arm is certainly tagged,
;; box the arms that are certainly raw machine numbers; consumers already route tagged values
;; through the guarded ToNumber. Arms that are OTHER PHIS are never boxed, even when their own
;; arms are all machine numbers: a phi arm can later be SUBSUMED into the phi being reconciled
;; (nested-loop phi chains with no outside consumer collapse that way), which rewrites the Box's
;; input to the consumer itself and strands a Box(self) cycle nothing reaches (VERR-LEAK on
;; proj2). Arms that are neither certainly tagged nor certainly raw are also left alone —
;; boxing a value that MIGHT already be tagged would double-box it.
(defn fng-reconcile-phi-arms! [(phi i64)] (-> i64)
  (let [(mut any-tagged) false
        (mut input) 1]
    (loop (if (or (>= (load input) (n-nins phi)) (load any-tagged))
              (break)
              (do
                (let [arm (n-in phi (load input))]
                  (if (and (and (!= arm NO-NODE) (!= arm phi))
                           (fng-boxed-dynamic-value? arm))
                      (set! any-tagged true)
                      0))
                (set! input (+ (load input) 1)))))
    (if (load any-tagged)
        (let [(mut at) 1]
          (loop (if (>= (load at) (n-nins phi))
                    (break)
                    (do
                      (let [arm (n-in phi (load at))]
                        (if (and (and (!= arm NO-NODE) (!= arm phi))
                                 (and (not (op-is? arm Phi [_]))
                                      (and (not (fng-boxed-dynamic-value? arm))
                                           (fng-machine-number-value? arm 8))))
                            (do (n-set-def! phi (load at) (n-box! arm)) 0)
                            0))
                      (set! at (+ (load at) 1)))))
          0)
        0)
    0))

;; A LOOP'S CARRIED PHI IS NOT FINISHED WHILE THE BODY IS BEING LOWERED. `fng-loop` allocates each
;; phi with its back edge as NO-NODE, lowers the body, and only then writes slot 2 -- so every use
;; of an induction variable INSIDE the loop asks about a phi with one arm. Both structural tests
;; below answer from the arms, so a counter whose entry value is a raw `0` reads as certainly-raw,
;; and the coercion is skipped. Then the body's `i = i + 1` comes back from the DSL BOXED, slot 2 is
;; written, and the phi that was judged raw is tagged.
;;
;; NOTHING NOTICES. `a[i]` fails `g-verify` with "ArrayLoad slot 3 is tagged, needs raw-num", which
;; at least says so; `s.charCodeAt(i)` compiles and reads the NaN box as an index, and the program
;; returns a number that is merely wrong. Both are in `tests/native-execution-test.coil` now.
;;
;; So an open loop phi is conservatively "may be tagged". The cost is a coercion on a counter that
;; turns out raw, and it FOLDS: `ToNumberValue`'s guard proves against a phi typed `int` and
;; `BitOr(x, 0)` on an int is the identity, so the finished graph is the one the old test was
;; hoping for -- only now it is the analysis proving it rather than the frontend guessing.
(defn fng-open-loop-phi? [(v i64)] (-> bool)
  (and (>= v 0)
       (and (op-is? v Phi [_])
            (and (> (n-nins v) 0)
                 (and (!= (n-in v 0) NO-NODE)
                      (and (op-is? (n-in v 0) Loop [])
                           (or (< (n-nins v) 3) (= (n-in v 2) NO-NODE))))))))

(defn fng-needs-to-number? [(value i64) (captured-cell bool)] (-> bool)
  ;; STRUCTURAL, not just the seed type: a fresh Load's type is not computed until inference
  ;; runs, so `n-ty == dyn` misses a tagged field load written moments earlier — Mul then took
  ;; NaN-boxed bits as a double (nested inner.x through a dyn-content field was the witness:
  ;; tagged 3 read as NaN, NaN*5|0 == 0). The boxed walk extends the same structural test
  ;; through Phi joins of Box arms (inlined JSL macros like StringCodePointAt).
  (or captured-cell
      ;; A VALUE THAT CERTAINLY CARRIES A RAW MACHINE NUMBER NEEDS NOTHING, whatever its type reads,
      ;; and this gate is what stops the last resort in `fng-value-tagged?` -- `n-ty == dyn` -- from
      ;; claiming one that does. A `Call` computes `dyn` regardless of its native ABI, so the result
      ;; of a `lib/` definition declared `:ret int` reads as tagged: `"abcdef".lastIndexOf("c")`
      ;; RETURNED 2 CORRECTLY and `lastIndexOf("c") | 0` answered 0, because the coercion put the
      ;; raw index through `ToNumber` into a double and the bitwise op read the low half of a small
      ;; double's bit pattern. `fng-machine-number-value?` is the structural question and it already
      ;; defers to the boxed walk, so this only ever narrows the coercion.
      (and (not (fng-machine-number-value? value 8))
           (or (fng-value-tagged? value)
               (or (fng-boxed-dynamic-value? value)
                   (fng-open-loop-phi? value))))))

(defn fng-int-value [(context FngContext) (source i64) (value i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        captured-cell
          (and (= (ts-kind ast source) TSK-IDENTIFIER)
               (let [symbol (fe-resolution-symbol frontend source)]
                 (and (>= symbol 0) (fng-symbol-cell? context symbol))))]
  (if (fng-needs-to-number? value captured-cell)
      ;; Arithmetic results are machine numbers and the bitwise op's selection converts them,
      ;; as are DIRECT calls whose callee is statically known. A DYNAMICALLY dispatched call is
      ;; NOT exempt: it returns a BOXED dyn value, and passing it raw fed a double's bit
      ;; pattern to the integer op — the low 32 bits of any small double are zero, which
      ;; silently zeroed `f() | 0` for every dispatched callee.
      (if (or (and (op-is? value Call [_])
                   (and (or (op-is? (n-in value 1) Fun [_])
                            (op-is? (n-in value 1) Closure [_]))
                        (fng-call-returns-machine-number? value)))
              (or (op-is? value Add [])
                  (or (op-is? value Sub [])
                      (or (op-is? value Mul [])
                          (or (op-is? value Div []) (op-is? value Mod []))))))
          value
          (fng-peep (n-new3 (BitOr) NO-NODE (fng-to-number-operand context value) (fng-const 0))))
      value)))

(defn fng-number-value [(context FngContext) (source i64) (value i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        declared-number-element
          (and (= (ts-kind ast source) TSK-ELEMENT-ACCESS)
               (let [base (ts-child ast source 0)]
                 (and (= (ts-kind ast base) TSK-IDENTIFIER)
                      (fng-number-array-symbol? frontend
                                                (fe-resolution-symbol frontend base)))))
        captured-cell
          (and (= (ts-kind ast source) TSK-IDENTIFIER)
               (let [symbol (fe-resolution-symbol frontend source)]
                 (and (>= symbol 0) (fng-symbol-cell? context symbol))))]
  (if declared-number-element
      (n-unbox! value (t-flt))
      (if (fng-needs-to-number? value captured-cell)
      ;; Same rule as fng-int-value: direct-callee calls and arithmetic are machine numbers,
      ;; but a DYNAMICALLY dispatched call returns a BOXED dyn value and needs the guarded
      ;; conversion — passing it raw fed double bit patterns into numeric ops.
      (if (or (and (op-is? value Call [_])
                   (and (or (op-is? (n-in value 1) Fun [_])
                            (op-is? (n-in value 1) Closure [_]))
                        (fng-call-returns-machine-number? value)))
              (or (op-is? value Add [])
                  (or (op-is? value Sub [])
                      (or (op-is? value Mul [])
                          (or (op-is? value Div []) (op-is? value Mod []))))))
          value
          (fng-to-number-operand context value))
      value))))

;; EQUALITY IS THE DSL'S, WHOLE -- all four operators and `switch` matching. `StrictEqual`,
;; `StrictNotEqual`, `LooseEqual` and `LooseNotEqual` in `lib/abstract/conversions.jsl` are the
;; entire meaning; nothing here decides anything about operands.
;;
;; What was deleted to get here, because each piece was a live defect or one waiting:
;; `fng-equal-value` unboxed a tagged operand as a float on the evidence that the OTHER side was
;; numeric -- no evidence about the tagged one -- and `7 == "7"` was false until loose equality
;; stopped routing through it. `fng-nullish-equal` was loose-equality-with-null spelled by hand
;; over raw Eq/BitOr. The number/number and string/string fast paths on `===` were the compiler's
;; opinion of strict equality; the specialisation lives in `StrictEqual`, which leads with the
;; Number/Number case so proven operands still fold to one compare -- and `x == null` folds
;; through `LooseEqual`'s leading IsNullish guards because the null constant's kinds prove them.
;;
;; THE RELATIONAL OPERATORS ARE THE DSL'S, WHOLE. `IsLessThan` and `IsLessEqual` in
;; `lib/abstract/conversions.jsl` are the entire meaning of `<`, `<=`, `>` and `>=`; nothing here
;; decides anything about operands.
;;
;; The frontend used to spell all four out: a static "did inference say both sides are strings?"
;; test with a numeric compare as the fallback, over a coercion helper that only fires on `dyn`.
;; A string beside a number matched neither, and `"5" < 6` stopped the evaluator where node says
;; true; `true < 2` and `null < 1` were wrong for the same reason. Four hand-written copies of one
;; abstract operation, each wrong for the operands its author did not picture.
;;
;; NO FAST PATH HERE, DELIBERATELY. One was tried -- "both operands provably raw machine numbers,
;; compare directly" -- and it works, and it is still the compiler holding an opinion about what
;; JavaScript comparison means. The specialisation belongs in the definition, and it is there: the
;; DSL macros lead with the Number/Number case so two numbers cost tag tests and no calls.
;; See docs/DSL-OWNERSHIP.md.
(defn fng-relational [(context FngContext) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (fng-jsl-call2 context name (n-box! a) (n-box! b)))

;; THE BITWISE OPERATORS ARE THE DSL'S. `BitwiseAnd`, `BitwiseOr`, `BitwiseXor`, `BitwiseNot`,
;; `ShiftLeft`, `ShiftRight` and `ShiftRightUnsigned` in `lib/abstract/conversions.jsl` are their
;; whole meaning: ToInt32 on each operand and then the machine operation.
;;
;; The frontend used to write that out ELEVEN TIMES -- once per operator in the binary form and
;; again in the compound-assignment form -- as `fng-int-value` on each side followed by the raw
;; node. `fng-int-value` decides whether to coerce by asking whether the value is `dyn`, which a
;; string is not, so the same class of operand that broke `==` and `<` broke these too.
;;
;; Wiring these is also what finally calls `ToInt32` and `ToUint32`: they were defined in `lib/` and
;; called by nothing, because the frontend had its own copy. See docs/DSL-OWNERSHIP.md.
;; THE ARITHMETIC OPERATORS ARE THE DSL'S. `JsAdd`, `JsSub`, `JsMul`, `JsDiv`, `JsMod` and
;; `JsNegate` in `lib/abstract/conversions.jsl` are their whole meaning.
;;
;; `+` is the one that could not be a peephole: its RESULT TYPE depends on its operands -- a String
;; on either side makes it concatenation. The frontend decided that STATICALLY, asking `fng-infer`
;; whether either side looked like a string, and fell back to a numeric add over `fng-number-value`,
;; whose coercion only fires on `dyn`. Every operand the static test could not classify took the
;; numeric arm regardless of what it actually held.
;;
;; The precision is not lost by moving it: `:ret` is recorded and never read, so a call's type is
;; whatever the graph computes, and the guards fold when the operands are known. `1 + 2` keeps its
;; integer range; only a genuinely dynamic operand produces a dynamic result.
(defn fng-graph-proven-numeric? [(node i64) (fuel i64)] (-> bool)
  (if (or (= node NO-NODE) (or (<= fuel 0) (n-dead? node)))
      false
      (match (n-op node)
        (Const [ty] (ty-numeric? ty))
        (Arg [ty] (ty-numeric? ty))
        (Cast [target] (ty-numeric? target))
        (Box [_] (if (> (n-nins node) 1)
                     (fng-graph-proven-numeric? (n-in node 1) (- fuel 1))
                     false))
        (Add [] true) (Sub [] true) (Mul [] true) (Div [] true) (Minus [] true)
        (_ false))))

(defn fng-arith2 [(context FngContext) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (let [value (fng-jsl-call2 context name (n-box! a) (n-box! b))]
    ;; A representation refinement, not arithmetic semantics: when both source values are proven
    ;; machine numbers, the DSL's guarded dynamic result is also a Number. Recording that fact lets
    ;; the typed consumer cancel Box/Unbox without retaining impossible object-exception arms.
    (if (and (fng-graph-proven-numeric? a 16) (fng-graph-proven-numeric? b 16))
        (fng-peep (n-new2 (Cast (t-num)) (load (load (field context ctrl))) value))
        value)))

(defn fng-arith1 [(context FngContext) (name (slice u8)) (a i64)] (-> i64)
  (fng-jsl-call1 context name (n-box! a)))

(defn fng-bitwise2 [(context FngContext) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (fng-jsl-call2 context name (n-box! a) (n-box! b)))

(defn fng-bitwise1 [(context FngContext) (name (slice u8)) (a i64)] (-> i64)
  (fng-jsl-call1 context name (n-box! a)))

(defn fng-type-tag [(frontend (ptr NativeFrontend)) (type-node i64)] (-> i64)
  (if (<= type-node -1)
      FNG-DYNAMIC
      (let [ast (field frontend ast)
            kind (ts-kind ast type-node)
            named (fe-type-index-for-node frontend type-node)]
        (cond (!= named -1) named
              (= kind TSK-NUMBER) FNG-NUMBER
              (= kind TSK-NUMERIC-LITERAL) FNG-NUMBER
              (= kind TSK-BOOLEAN) FNG-BOOLEAN
              (or (= kind TSK-TRUE) (= kind TSK-FALSE)) FNG-BOOLEAN
              (= kind TSK-NULL) FNG-NULL
              (= kind TSK-STRING) FNG-STRING
              (= kind TSK-STRING-LITERAL) FNG-STRING
              (= kind TSK-ARRAY-LITERAL) FNG-ARRAY
              ;; `xs: number[]` IS AN ARRAY, and until the bridge reported `KindArrayType` at all
              ;; this fell through to `FNG-DYNAMIC`. Everything that decides "is this an array"
              ;; asks `fng-infer`, which asks this, so `xs.push(9)` on an array-typed PARAMETER was
              ;; not an array method: it took the generic path, loaded `push` out of the runtime
              ;; property table, found nothing, and dispatched `undefined` -- `brk` on the callee
              ;; tag test. The same for every method, and for `forEach` it looked like "a callback
              ;; inside a nested function traps", because a callback is only ever written on a
              ;; method. `fng-number-array-symbol?` had been reading the type node's TEXT for
              ;; `"[]"` since before this kind existed; that is what it was working around.
              (= kind TSK-ARRAY-TYPE) FNG-ARRAY
              (= kind TSK-VOID) FNG-VOID
              :else FNG-DYNAMIC))))

(defn fng-coil-type [(frontend (ptr NativeFrontend))
                     (shapes (ptr (ArrayList i64)))
                     (type-node i64)] (-> i64)
  (let [tag (fng-type-tag frontend type-node)
        kind (if (<= type-node -1) -1 (ts-kind (field frontend ast) type-node))]
    (cond (= tag FNG-NUMBER) (t-int)
          (= tag FNG-BOOLEAN) (t-bool)
          ;; `null` is frequently only a mutable variable's initializer in JavaScript.
          ;; Using it as a Phi's declared upper bound freezes loop/branch merges at null
          ;; even after an object assignment reaches a backedge (DeltaBlue's prev/first/
          ;; last variables are the concrete witness). Constants remain precisely null;
          ;; only mutable-symbol merge declarations need the open dynamic bound.
          (= tag FNG-NULL) (t-dyn)
          (= tag FNG-STRING) (t-str)
          (>= tag 0) (t-obj-shape (al-get [i64] (load shapes) tag))
          (or (= kind TSK-TYPE-LITERAL) (= kind TSK-UNION-TYPE)) (t-obj)
          :else (t-int))))

(defn fng-field-coil-type [(frontend (ptr NativeFrontend))
                           (shapes (ptr (ArrayList i64)))
                           (type-node i64)] (-> i64)
  ;; Source `number` values use the JavaScript numeric ABI at calls, but a static object field must
  ;; have one raw in-memory representation. Use f64 so integer and fractional assignments share
  ;; the same slot representation across constructors and methods.
  (let [kind (if (<= type-node -1) -1 (ts-kind (field frontend ast) type-node))
        tag (fng-type-tag frontend type-node)]
    (if (= tag FNG-NUMBER)
        (t-flt)
        ;; Nullable and other union fields need the tagged representation: a raw object slot
        ;; cannot distinguish null from an object pointer while preserving both values.
        (if (= kind TSK-UNION-TYPE)
            (t-dyn)
            ;; An UNRESOLVED field type must be TAGGED, never the int fallback: `inner: Point`
            ;; reaching the fallback declared a slot the GC scan skips while the program stored
            ;; raw object pointers into it — a dangling pointer on the first collection. The
            ;; representation verifier (g-rep-report) is what caught it.
            ;; FNG-ARRAY lands here with FNG-DYNAMIC and for the same reason: an array is a
            ;; managed pointer, so its slot must be TAGGED. It read `FNG-DYNAMIC` until
            ;; `fng-type-tag` learned about `KindArrayType`, and without naming it here the fall
            ;; through would reach `fng-coil-type`'s `t-int` default -- a raw slot the GC scan
            ;; skips, holding an object pointer.
            (if (and (or (= tag FNG-DYNAMIC) (= tag FNG-ARRAY)) (!= kind TSK-TYPE-LITERAL))
                (t-dyn)
                (fng-coil-type frontend shapes type-node))))))

(defn fng-field-index [(frontend (ptr NativeFrontend)) (owner i64) (name-node i64)] (-> i64)
  (let [name (ts-text (field frontend ast) name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeField] (.fields frontend))) (!= (load answer) -1))
              (break)
              (let [field-value (al-get [FeField] (.fields frontend) (load index))]
                (if (and (= (.owner field-value) owner)
                         (= name (fe-field-name frontend (load index))))
                    (set! answer (load index))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-unique-field-index [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut answer) -1
        (mut local) -1
        (mut compatible) true]
    (loop (if (>= (load index) (al-len [FeField] (.fields frontend)))
              (break)
              (let [field-value (al-get [FeField] (.fields frontend) (load index))]
                (if (= name (fe-field-name frontend (load index)))
                    (let [owner (.owner field-value)
                          type (al-get [FeTypeDecl] (.types frontend) owner)
                          candidate-local (- (load index) (.field-start type))]
                      (if (= (load answer) -1)
                          (do (set! answer (load index))
                              (set! local candidate-local))
                          (if (!= (load local) candidate-local)
                              (set! compatible false)
                              0)))
                    0)
                (set! index (+ (load index) 1)))))
    (if (load compatible) (load answer) -1)))

(defn fng-compatible-field-memory [(context FngContext) (name-node i64) (representative i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        name (ts-text ast name-node)
        fields (.fields frontend)
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeField] fields))
              (break)
              (do
                (if (= name (fe-field-name frontend (load index)))
                    (let [alias (al-get [i64] (load (load (field context aliases))) (load index))]
                      (al-push! [i64] (mut memories) (fng-current-memory context alias)))
                    0)
                (set! index (+ (load index) 1)))))
    (let [memory (if (= (al-len [i64] (load memories)) 1)
                     (al-get [i64] (load memories) 0)
                     (fng-merge memories))]
      (al-free! [i64] (mut memories))
      memory)))

(defn fng-field-local-index [(frontend (ptr NativeFrontend)) (field-index i64)] (-> i64)
  (let [field-value (al-get [FeField] (.fields frontend) field-index)
        owner (.owner field-value)
        type (al-get [FeTypeDecl] (.types frontend) owner)]
    (- field-index (.field-start type))))

(defn fng-memory [(ctrl i64) (alias i64)] (-> i64)
  ;; A function-entry memory argument represents an existing heap, not a freshly undefined field.
  ;; Static shape aliases carry their declared field type across calls; dynamic/runtime aliases
  ;; retain the conservative undefined seed until an explicit effect supplies stronger evidence.
  (n-new1 (Arg (t-mem-alias alias
                       (if (shape-alias-defined? alias) (shape-alias-ty alias) (t-undef))))
          ctrl))

(defn fng-merge [(memories (ptr (ArrayList i64)))] (-> i64)
  (let [merge (n-new (MemMerge))
        (mut index) 0]
    (n-add-def! merge NO-NODE)
    (loop (if (>= (load index) (al-len [i64] (load memories)))
              (break)
              (do
                (n-add-def! merge (al-get [i64] (load memories) (load index)))
                (set! index (+ (load index) 1)))))
    (fng-peep merge)))

(defn fng-memory-has-alias? [(memory i64) (alias i64)] (-> bool)
  (set! (fng-profile-memory-alias-calls-ptr) (+ (load (fng-profile-memory-alias-calls-ptr)) 1))
  (if (= memory NO-NODE)
      false
      (match (n-op memory)
        (Store [stored-alias] (= stored-alias alias))
        (PropStore [_] (= alias JS-PROPERTY-ALIAS))
        (PropDelete [_] (= alias JS-PROPERTY-ALIAS))
        (SetProto [] (= alias JS-PROPERTY-ALIAS))
        (ArrayStore [] (= alias JS-PROPERTY-ALIAS))
        (ArrayResize [] (= alias JS-PROPERTY-ALIAS))
        (ArrayCopy [] (= alias JS-PROPERTY-ALIAS))
        (MemMerge []
          (let [(mut index) 1 (mut found) false]
            (loop (if (or (>= (load index) (n-nins memory)) (load found))
                      (break)
                      (do (set! (fng-profile-memory-alias-edges-ptr)
                                (+ (load (fng-profile-memory-alias-edges-ptr)) 1))
                          (if (fng-memory-has-alias? (n-in memory (load index)) alias)
                              (set! found true) 0)
                          (set! index (+ (load index) 1)))))
            (load found)))
        (Proj [projection]
          (if (op-is? (n-in memory 0) New [_])
              (let [nw (n-in memory 0)]
                (and (> projection 0)
                     (= (shape-field-alias (n-new-shape nw) (- projection 1)) alias)))
              (let [t (n-ty memory)]
                (and (ty-mem? t) (!= (& (ty-mem-aliases t) (<< 1 alias)) 0)))))
        ;; A freshly built Phi has not computed its type yet; its declared memory slice is payload.
        (Phi [declared]
          (and (ty-mem? declared) (!= (& (ty-mem-aliases declared) (<< 1 alias)) 0)))
        (_ (let [t (n-ty memory)]
             (and (ty-mem? t) (!= (& (ty-mem-aliases t) (<< 1 alias)) 0)))))))

(defn fng-memory-node? [(memory i64)] (-> bool)
  (if (= memory NO-NODE)
      false
      (match (n-op memory)
        (Store [_] true) (PropStore [_] true) (PropDelete [_] true) (SetProto [] true)
        (ArrayStore [] true) (ArrayResize [] true) (ArrayCopy [] true) (MemMerge [] true)
        (Proj [_] (or (op-is? (n-in memory 0) New [_]) (ty-mem? (n-ty memory))))
        (Phi [declared] (ty-mem? declared))
        (_ (ty-mem? (n-ty memory))))))

;; The single non-merge state that carries `alias` inside a (possibly nested) MemMerge. Answering
;; a per-alias query with a whole merge is how merges ended up NESTED in bigger merges: the outer
;; merge then held one child selected for alias A whose static mask also claims B, C, ... next to
;; the newer states it was merged with — two states claiming one alias, which is ambiguous (the
;; IR evaluator rejects it as EV-MEM; the backend just happens to schedule the newer one).
(defn fng-alias-leaf [(memory i64) (alias i64) (fuel i64)] (-> i64)
  (if (or (<= fuel 0) (not (op-is? memory MemMerge [])))
      memory
      (let [(mut index) 1
            (mut answer) NO-NODE]
        (loop (if (or (>= (load index) (n-nins memory)) (!= (load answer) NO-NODE))
                  (break)
                  (let [candidate (n-in memory (load index))]
                    (if (fng-memory-has-alias? candidate alias) (set! answer candidate) 0)
                    (set! index (+ (load index) 1)))))
        (if (= (load answer) NO-NODE)
            memory
            (fng-alias-leaf (load answer) alias (- fuel 1))))))

(defn fng-current-memory [(context FngContext) (alias i64)] (-> i64)
  (let [memory (load (load (field context memory)))]
    (if (= memory NO-NODE)
        (fng-memory (load (load (field context ctrl))) alias)
        (if (op-is? memory MemMerge [])
            (let [(mut index) 1
                  (mut answer) NO-NODE]
              (loop (if (or (>= (load index) (n-nins memory)) (!= (load answer) NO-NODE))
                        (break)
                        (let [candidate (n-in memory (load index))]
                          (set! (fng-profile-current-scans-ptr)
                                (+ (load (fng-profile-current-scans-ptr)) 1))
                          (if (fng-memory-has-alias? candidate alias) (set! answer candidate) 0)
                          (set! index (+ (load index) 1)))))
              (if (= (load answer) NO-NODE)
                  (fng-memory (load (load (field context ctrl))) alias)
                  (fng-alias-leaf (load answer) alias 16)))
            (if (fng-memory-has-alias? memory alias)
                (fng-alias-leaf memory alias 16)
                (fng-memory (load (load (field context ctrl))) alias))))))

(defn fng-active-memory! [(context FngContext) (out (mut (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeField] (.fields frontend)))
              (break)
              (let [field-value (al-get [FeField] (.fields frontend) (load index))]
                ; Preserve every declared field alias at JavaScript calls and allocations. Receiver
                ; calls can expose an object through a closure or detached function, so the older
                ; return-type-only effect summary is not sound enough to discard an alias.
                (al-push! [i64] (mut out) (load index))
                (set! index (+ (load index) 1)))))
    0))

(defn fng-preserve-active-memory [(context FngContext) (primary i64)] (-> i64)
  (let [(mut active) (al-new [i64] (malloc-allocator))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (set! (fng-profile-preserve-calls-ptr) (+ (load (fng-profile-preserve-calls-ptr)) 1))
    (al-push! [i64] (mut memories) primary)
    (fng-active-memory! context (mut active))
    (loop (if (>= (load i) (al-len [i64] (load active)))
              (break)
              (let [field-index (al-get [i64] (load active) (load i))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (set! (fng-profile-preserve-fields-ptr)
                      (+ (load (fng-profile-preserve-fields-ptr)) 1))
                (if (not (fng-memory-has-alias? primary alias))
                    (al-push! [i64] (mut memories) (fng-current-memory context alias))
                    0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [i64] (load (field context dynamic-aliases))))
              (break)
              (let [alias (al-get [i64] (load (field context dynamic-aliases)) (load i))]
                (if (not (fng-memory-has-alias? primary alias))
                    (al-push! [i64] (mut memories) (fng-current-memory context alias))
                    0)
                (set! i (+ (load i) 1)))))
    (if (and (!= (.cell-shape context) SHAPE-ROOT)
             (not (fng-memory-has-alias? primary (.cell-alias context))))
        (al-push! [i64]
                  (mut memories)
                  (fng-current-memory context (.cell-alias context)))
        0)
    (let [answer (fng-merge memories)]
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut memories))
      answer)))

(defn fng-discard-memory-scaffolding! [] (-> i64)
  (let [limit (n-count)
        (mut node) 0]
    (loop (if (>= (load node) limit)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (op-is? (load node) MemMerge [])
                              (= (n-nouts (load node)) 0)))
                    (n-discard-scaffolding! (load node))
                    0)
                (set! node (+ (load node) 1)))))
    0))

;; Values held only in frontend construction tables are not graph uses. Once all bodies are closed,
;; sweep their unused leaves so speculative prototype/cell setup cannot survive as verifier leaks.
(defn fng-discard-unused! [] (-> i64)
  (let [(mut node) (- (n-count) 1)]
    (loop (if (< (load node) 0)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (= (n-nouts (load node)) 0)
                              (and (= (n-keeps (load node)) 0)
                                   (and (!= (load node) (g-start))
                                        (and (!= (load node) (g-stop))
                                             ;; Parameter position is part of the callable ABI even
                                             ;; when this body does not read the value.
                                             (not (op-is? (load node) Parm [_])))))))
                    (n-kill! (load node))
                    0)
                (set! node (- (load node) 1)))))
    0))

(defn fng-main-index [(frontend (ptr NativeFrontend))] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend))) (!= (load answer) -1))
              (break)
              (if (= (fe-function-name frontend (load index)) "main")
                  (set! answer (load index))
                  (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-function-index [(frontend (ptr NativeFrontend)) (id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend))) (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (= (.id fn) id) (set! answer (load index)) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-function-node-index [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (.functions frontend)))
                  (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (= (.node fn) node) (set! answer (load index)) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

;; Closed-world function reachability for graph publication. Indexing still sees every declaration
;; (resolution, captures, effects and diagnostics need the complete source), but a function body
;; that no reachable expression can materialize need not become thousands of ideal nodes. Direct
;; references use the frontend's exact resolution table; nested function syntax is marked when its
;; enclosing reachable body is walked. Nested bodies are then walked once from their own queue item.
(defn fng-reachable-functions [(frontend (ptr NativeFrontend)) (main-index i64)]
                              (-> (ArrayList bool))
  (let [count (al-len [FeFunction] (.functions frontend))
        ast (field frontend ast)
        (mut reachable) (al-new [bool] (malloc-allocator))
        (mut id-to-index) (al-new [i64] (malloc-allocator))
        (mut pending) (al-new [i64] (malloc-allocator))
        (mut stack) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (al-push! [bool] (mut reachable) false)
                (al-push! [i64] (mut id-to-index) -1)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load i))]
                (if (and (>= (.id fn) 0) (< (.id fn) count))
                    (al-set! [i64] (mut id-to-index) (.id fn) (load i))
                    0)
                (set! i (+ (load i) 1)))))
    (al-push! [i64] (mut pending) main-index)
    ;; Top-level variable initializers and expression statements execute before `main`; function
    ;; values they mention are roots even when the declaration itself is outside main's body.
    ;; Walk the script root but stop at function declarations, whose bodies are discovered only
    ;; when an executable reference reaches them.
    (al-push! [i64] (mut stack) (ts-root ast))
    (loop (if (= (al-len [i64] (load stack)) 0)
              (break)
              (let [last (- (al-len [i64] (load stack)) 1)
                    node (al-get [i64] (load stack) last)
                    kind (ts-kind ast node)
                    symbol (fe-resolution-symbol frontend node)
                    target (if (and (>= symbol 0) (< symbol count))
                               (al-get [i64] (load id-to-index) symbol)
                               -1)]
                (al-pop! [i64] (mut stack))
                (if (and (>= target 0) (not (al-get [bool] (load reachable) target)))
                    (al-push! [i64] (mut pending) target)
                    0)
                (if (= kind TSK-FUNCTION-DECLARATION)
                    0
                    (if (fe-function-expression-kind? kind)
                        (let [nested (fng-function-node-index frontend node)]
                          (if (and (>= nested 0)
                                   (not (al-get [bool] (load reachable) nested)))
                              (al-push! [i64] (mut pending) nested)
                              0))
                        (let [(mut child) 0]
                          (loop (if (>= (load child) (ts-child-count ast node))
                                    (break)
                                    (do
                                      (al-push! [i64] (mut stack) (ts-child ast node (load child)))
                                      (set! child (+ (load child) 1)))))))))))
    (loop (if (= (al-len [i64] (load pending)) 0)
              (break)
              (let [last (- (al-len [i64] (load pending)) 1)
                    index (al-get [i64] (load pending) last)]
                (al-pop! [i64] (mut pending))
                (if (al-get [bool] (load reachable) index)
                    0
                    (do
                      (al-set! [bool] (mut reachable) index true)
                      (let [fn (al-get [FeFunction] (.functions frontend) index)]
                        (al-clear! [i64] (mut stack))
                        ;; Default-parameter initializers execute as part of the call and may
                        ;; materialize callbacks not present in the function body.
                        (let [(mut parameter) 0]
                          (loop (if (>= (load parameter) (.parameter-count fn))
                                    (break)
                                    (let [symbol
                                            (al-get [FeSymbol]
                                                    (.symbols frontend)
                                                    (+ (.parameter-start fn) (load parameter)))]
                                      (al-push! [i64] (mut stack) (.node symbol))
                                      (set! parameter (+ (load parameter) 1))))))
                        (al-push! [i64] (mut stack) (.body-node fn))
                        (loop (if (= (al-len [i64] (load stack)) 0)
                                  (break)
                                  (let [last (- (al-len [i64] (load stack)) 1)
                                        node (al-get [i64] (load stack) last)
                                        kind (ts-kind ast node)
                                        symbol (fe-resolution-symbol frontend node)
                                        target (if (and (>= symbol 0) (< symbol count))
                                                   (al-get [i64] (load id-to-index) symbol)
                                                   -1)]
                                    (al-pop! [i64] (mut stack))
                                    (if (and (>= target 0)
                                             (not (al-get [bool] (load reachable) target)))
                                        (al-push! [i64] (mut pending) target)
                                        0)
                                    (if (or (= kind TSK-FUNCTION-DECLARATION)
                                            (fe-function-expression-kind? kind))
                                        (let [nested (fng-function-node-index frontend node)]
                                          (if (and (>= nested 0) (!= nested index))
                                              (if (not (al-get [bool] (load reachable) nested))
                                                  (al-push! [i64] (mut pending) nested)
                                                  0)
                                              0))
                                        (let [(mut child) 0]
                                          (loop (if (>= (load child) (ts-child-count ast node))
                                                    (break)
                                                    (do
                                                      (al-push! [i64] (mut stack)
                                                                (ts-child ast node (load child)))
                                                      (set! child (+ (load child) 1))))))))))))))))
    (al-free! [i64] (mut id-to-index))
    (al-free! [i64] (mut pending))
    (al-free! [i64] (mut stack))
    (load reachable)))

(defn fng-function-receiver-aware? [(frontend (ptr NativeFrontend)) (id i64)] (-> bool)
  (let [index (fng-function-index frontend id)]
    (if (< index 0)
        false
        (let [fn (al-get [FeFunction] (.functions frontend) index)]
          (and (not (.arrow fn))
               (!= (.receiver-type-node fn) -1))))))

;; WHAT THE STATIC EVALUATOR MAY SEE, and the boundary is SEMANTIC, so it is stated here rather
;; than left to the evaluator: the raw IR arithmetic IS JavaScript's arithmetic FOR NUMBERS --
;; `arith-compute`'s Div is float division and its Add promotes overflow to float -- and for
;; nothing else. `true + 1`, `"a" + "b"` and `null * 2` all passed the old qualifier and reached
;; a raw `Add`/`Mul` over a non-numeric constant, which is a hand-written (and wrong) copy of
;; ApplyStringOrNumericBinaryOperator. So an OPERAND position demands a numeric expression, while
;; a VALUE position (the initializer itself, `const G = "abc"`) still admits any literal.
;; An initializer that fails the test is not an error: it simply is not static, and lowers on the
;; ordinary top-level path where the DSL owns the coercions.
(defn fng-static-global-expression-mode? [(frontend (ptr NativeFrontend))
                                          (node i64)
                                          (fuel i64)
                                          (numeric bool)] (-> bool)
  (if (<= fuel 0)
      false
      (let [ast (field frontend ast)
            kind (ts-kind ast node)]
        (cond (= kind TSK-NUMERIC-LITERAL) true
              (= kind TSK-STRING-LITERAL) (not numeric)
              (= kind TSK-NULL) (not numeric)
              (= kind TSK-TRUE) (not numeric)
              (= kind TSK-FALSE) (not numeric)
              (= kind TSK-PARENTHESIZED-EXPRESSION)
                (fng-static-global-expression-mode? frontend (ts-child ast node 0) (- fuel 1) numeric)
              (= kind TSK-IDENTIFIER)
                (fng-static-global-symbol-mode? frontend
                                                (fe-resolution-symbol frontend node)
                                                (- fuel 1)
                                                numeric)
              (= kind TSK-PREFIX-UNARY)
                (fng-static-global-expression-mode? frontend (ts-child ast node 0) (- fuel 1) true)
              (= kind TSK-BINARY)
                (and (fng-static-global-expression-mode? frontend (ts-child ast node 0) (- fuel 1) true)
                     (fng-static-global-expression-mode? frontend (ts-child ast node 2) (- fuel 1) true))
              :else false))))

;; An immutable primitive constant expression has no runtime environment identity. Publish it as a
;; compilation-unit value so every function can reference it without manufacturing closure cells.
;; `numeric` narrows the check to a NUMERIC initializer, for identifiers read in an operand
;; position of the static evaluator's raw arithmetic.
(defn fng-static-global-symbol-mode? [(frontend (ptr NativeFrontend))
                                      (symbol-id i64)
                                      (fuel i64)
                                      (numeric bool)] (-> bool)
  (let [ast (field frontend ast)
        (mut symbol-index) 0
        (mut declaration) -1
        (mut mutable) false
        (mut capture-index) 0]
    (loop (if (or (>= (load symbol-index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load declaration) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load symbol-index))]
                (if (and (= (.id symbol) symbol-id)
                         (= (.role symbol) FE-ROLE-GLOBAL))
                    (set! declaration (.node symbol))
                    0)
                (set! symbol-index (+ (load symbol-index) 1)))))
    (loop (if (or (load mutable)
                  (>= (load capture-index) (al-len [FeCapture] (.captures frontend))))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load capture-index))]
                (if (and (= (.symbol capture) symbol-id)
                         (.mutable capture))
                    (set! mutable true)
                    0)
                (set! capture-index (+ (load capture-index) 1)))))
    (if (or (<= fuel 0)
            (or (= (load declaration) -1)
                (or (load mutable) (< (ts-child-count ast (load declaration)) 2))))
        false
        (let [initializer (ts-child ast (load declaration)
                                    (- (ts-child-count ast (load declaration)) 1))]
          (fng-static-global-expression-mode? frontend initializer (- fuel 1) numeric)))))

(defn fng-static-global-symbol-fuel? [(frontend (ptr NativeFrontend))
                                      (symbol-id i64)
                                      (fuel i64)] (-> bool)
  (fng-static-global-symbol-mode? frontend symbol-id fuel false))

(defn fng-static-global-symbol? [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> bool)
  (fng-static-global-symbol-fuel? frontend symbol-id 32))

;; The script's own callable identity. Zero is the runtime's invalid-owner sentinel and main is
;; never opened as a Fun, so no JavaScript function value and no JSL callable ever carries this
;; id. The property side table therefore treats it as a permanently live integer owner, which
;; makes it the natural owner for script-global storage.
(defn fng-script-owner-id [(frontend (ptr NativeFrontend))] (-> i64)
  (let [main (al-get [FeFunction] (.functions frontend) (fng-main-index frontend))]
    (+ (.id main) 1)))

(defn fng-raw-captured-symbol? [(frontend (ptr NativeFrontend)) (symbol i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (.captures frontend)))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (= (.symbol capture) symbol)
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

;; A script global whose storage is the runtime property side table under the script owner id.
;; Only globals some function actually references need shared runtime storage; a global used
;; exclusively by the top level keeps ordinary SSA flow, and a provably constant one keeps the
;; value installed by fng-initialize-static-globals!.
(defn fng-script-global-symbol? [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> bool)
  (and (>= symbol-id (al-len [FeFunction] (.functions frontend)))
       (and (= (fe-symbol-role frontend symbol-id) FE-ROLE-GLOBAL)
            (and (fng-raw-captured-symbol? frontend symbol-id)
                 (not (fng-static-global-symbol? frontend symbol-id))))))

(defn fng-script-global-name [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> i64)
  (let [(mut index) 0
        (mut name-node) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load name-node) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) symbol-id)
                    (set! name-node (.name-node symbol))
                    0)
                (set! index (+ (load index) 1)))))
    (if (= (load name-node) -1)
        (do (panic-corrupt "fng-script-global-name: symbol has no declaration name") 0)
        (shape-name-intern! (ts-text (field frontend ast) (load name-node))))))

;; Which captures become hidden parameters. Script globals live in the property side table and
;; top-level function identities are graph constants, so neither crosses a call boundary; only
;; true lexical state still travels as a capture. This is what lets a generic call use one stable
;; descriptor for every capture-free target instead of a per-target hidden prefix.
(defn fng-runtime-capture? [(frontend (ptr NativeFrontend)) (capture FeCapture)] (-> bool)
  (let [symbol (.symbol capture)
        capturer (.function capture)]
    (if (< symbol (al-len [FeFunction] (.functions frontend)))
        ; A nested declaration's value can be a capture-carrying closure, so its identity still
        ; travels with the parent. A top-level declaration is its bare Fun constant everywhere.
        ; Either way, only a function NESTED INSIDE the declaring parent can thread the identity
        ; cell — the analysis passes copy capture records into method callers as closed-world
        ; data, and treating those as runtime captures demanded environments no call site has.
        (let [function-index (fng-function-index frontend symbol)]
          (if (< function-index 0)
              true
              (let [fn (al-get [FeFunction] (.functions frontend) function-index)
                    parent (.parent fn)]
                (and (!= parent -1)
                     (fe-scope-inside? frontend capturer parent)))))
        (if (= (fe-symbol-role frontend symbol) FE-ROLE-GLOBAL)
            false
            (and (not (fng-static-global-symbol? frontend symbol))
                 (let [owner (fe-symbol-owner frontend symbol)]
                   (or (< owner 0) (fe-scope-inside? frontend capturer owner))))))))

(defn fng-symbol-capture-count [(frontend (ptr NativeFrontend)) (function-id i64)] (-> i64)
  (let [(mut index) 0
        (mut count) 0]
    (loop (if (>= (load index) (al-len [FeCapture] (.captures frontend)))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.function capture) function-id)
                         (fng-runtime-capture? frontend capture))
                    (set! count (+ (load count) 1))
                    0)
                (set! index (+ (load index) 1)))))
    (load count)))

(defn fng-lexical-this? [(frontend (ptr NativeFrontend)) (function-id i64)] (-> bool)
  (.lexical-this (index (load (field (field frontend functions) data)) function-id)))

(defn fng-capture-count [(frontend (ptr NativeFrontend)) (function-id i64)] (-> i64)
  (+ (fng-symbol-capture-count frontend function-id)
     (if (fng-lexical-this? frontend function-id) 1 0)))

(defn fng-capture-symbol [(frontend (ptr NativeFrontend)) (function-id i64) (ordinal i64)] (-> i64)
  (let [(mut rank) 0
        (mut prior) -1
        (mut answer) -1]
    ; Canonical symbol order makes normalized polymorphic environments ABI-identical regardless
    ; of the source order in which each method first discovered a capture.
    (loop (if (> (load rank) ordinal)
              (break)
              (let [(mut index) 0 (mut next) 9223372036854775807]
                (loop (if (>= (load index)
                              (al-len [FeCapture] (.captures frontend)))
                          (break)
                          (let [capture (al-get [FeCapture]
                                               (.captures frontend)
                                               (load index))
                                symbol (.symbol capture)]
                            (if (and (= (.function capture) function-id)
                                     (and (fng-runtime-capture? frontend capture)
                                          (and (> symbol (load prior)) (< symbol (load next)))))
                                (set! next symbol)
                                0)
                            (set! index (+ (load index) 1)))))
                (set! answer (load next))
                (set! prior (load next))
                (set! rank (+ (load rank) 1)))))
    (if (= (load answer) 9223372036854775807) -1 (load answer))))

(defn fng-capture-field-name [(ordinal i64)] (-> (slice u8))
  (case ordinal 0 "__capture0" 1 "__capture1" 2 "__capture2" 3 "__capture3"
        4 "__capture4" 5 "__capture5" 6 "__capture6" 7 "__capture7"
        8 "__capture8" 9 "__capture9" 10 "__capture10" 11 "__capture11"
        12 "__capture12" 13 "__capture13" 14 "__capture14" 15 "__capture15"
        16 "__capture16" 17 "__capture17" 18 "__capture18" 19 "__capture19"
        20 "__capture20" 21 "__capture21" 22 "__capture22" 23 "__capture23"
        24 "__capture24" 25 "__capture25" 26 "__capture26" 27 "__capture27"
        28 "__capture28" 29 "__capture29" 30 "__capture30" "__capture31"))

(defn fng-captured-symbol? [(frontend (ptr NativeFrontend)) (symbol i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (.captures frontend)))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.symbol capture) symbol)
                         (fng-runtime-capture? frontend capture))
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-function-captures-symbol? [(frontend (ptr NativeFrontend))
                                     (function i64)
                                     (symbol i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (.captures frontend)))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.function capture) function)
                         (and (= (.symbol capture) symbol)
                              (fng-runtime-capture? frontend capture)))
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-symbol-cell? [(context FngContext) (symbol i64)] (-> bool)
  (let [frontend (load (field context frontend))
        owner (.owner context)]
    ; An owner materializes cells for locals/globals captured by descendants. A different
    ; function only treats the symbol as a cell when that function actually has the capture.
    ; A nested declaration's IDENTITY behaves like a local of its parent: siblings that
    ; reference each other capture the identity cell, which is what lets mutual recursion
    ; observe the closure that is materialized after the referencing sibling's own closure.
    (if (< symbol (al-len [FeFunction] (.functions frontend)))
        (let [function-index (fng-function-index frontend symbol)
              parent (if (< function-index 0)
                         -1
                         (let [fn (al-get [FeFunction] (.functions frontend)
                                          function-index)]
                           (.parent fn)))]
          (if (and (>= parent 0) (= parent owner))
              (fng-captured-symbol? frontend symbol)
              (fng-function-captures-symbol? frontend owner symbol)))
        (if (= (fe-symbol-owner frontend symbol) owner)
            (fng-captured-symbol? frontend symbol)
            (fng-function-captures-symbol? frontend owner symbol)))))

(defn fng-record-dynamic-alias! [(context FngContext) (alias i64)] (-> i64)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [i64] (load (field context dynamic-aliases))))
                  (load found))
              (break)
              (do
                (if (= (al-get [i64] (load (field context dynamic-aliases)) (load index)) alias)
                    (set! found true)
                    0)
                (set! index (+ (load index) 1)))))
    (if (not (load found))
        (al-push! [i64] (mut (load (field context dynamic-aliases))) alias)
        0)
    alias))

(defn fng-symbol-storage [(context FngContext) (symbol i64)] (-> i64)
  (al-get [i64] (load (load (field context values))) symbol))

;; Script globals read and write the runtime property side table under the script owner id.
;; Every function reaches that table without any hidden parameter, the collector already
;; relocates its values, and the JS-PROPERTY-ALIAS memory edge orders these accesses against
;; calls exactly like every other dynamic property access.
(defn fng-script-global-load [(context FngContext) (symbol i64)] (-> i64)
  (let [frontend (load (field context frontend))
        name-id (fng-script-global-name frontend symbol)]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (n-peephole
      (n-new3 (PropLoad name-id)
              (load (load (field context ctrl)))
              (fng-current-memory context JS-PROPERTY-ALIAS)
              (fng-const (fng-script-owner-id frontend))))))

(defn fng-script-global-store! [(context FngContext) (symbol i64) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        name-id (fng-script-global-name frontend symbol)]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (let [stored
            (n-peephole
              (n-new4 (PropStore name-id)
                      (load (load (field context ctrl)))
                      (fng-current-memory context JS-PROPERTY-ALIAS)
                      (fng-const (fng-script-owner-id frontend))
                      (fng-box-dynamic-argument! node)))]
      (set! (load (field context memory)) (fng-preserve-active-memory context stored))
      node)))

(defn fng-symbol-node [(context FngContext) (symbol i64)] (-> i64)
  (if (fng-script-global-symbol? (load (field context frontend)) symbol)
      (fng-script-global-load context symbol)
      (if (or (load (fng-capture-by-value-ptr))
              (not (fng-symbol-cell? context symbol)))
          (fng-symbol-storage context symbol)
          (let [cell (fng-symbol-storage context symbol)
                alias (.cell-alias context)
                cast-node
                  (n-new2 (Cast (t-obj-shape (.cell-shape context)))
                          (load (load (field context ctrl)))
                          cell)]
            (n-load! (fng-current-memory context alias) cast-node alias)))))

(defn fng-set-symbol! [(context FngContext) (symbol i64) (node i64)] (-> i64)
  (if (fng-script-global-symbol? (load (field context frontend)) symbol)
      (fng-script-global-store! context symbol node)
  (if (or (load (fng-capture-by-value-ptr))
          (not (fng-symbol-cell? context symbol)))
      (al-set! [i64] (mut (load (field context values))) symbol node)
      (let [cell (fng-symbol-storage context symbol)
            alias (.cell-alias context)]
        (if (= cell NO-NODE)
            (let [incoming (primitive/alloc-stack (array i64 1))]
              (set! (index incoming 0) (fng-current-memory context alias))
              (let [nw
                      (n-new-obj! (load (load (field context ctrl)))
                                  (.cell-shape context)
                                  (slice-new [i64] (cast (ptr i64) incoming) 1))
                    object (n-obj-ptr nw)
                    stored
                      (n-store! (n-obj-mem nw 0)
                                object
                                (fng-box-dynamic-argument! node)
                                alias)]
                (al-set! [i64] (mut (load (field context values))) symbol object)
                (set! (load (field context memory)) (fng-preserve-active-memory context stored))
                node))
            (let [cast-node
                    (n-new2 (Cast (t-obj-shape (.cell-shape context)))
                            (load (load (field context ctrl)))
                            cell)
                  stored
                    (n-store! (fng-current-memory context alias)
                              cast-node
                              (fng-box-dynamic-argument! node)
                              alias)]
              (set! (load (field context memory)) (fng-preserve-active-memory context stored))
              node))))))

(defn fng-symbol-type [(context FngContext) (symbol i64)] (-> i64)
  (al-get [i64] (load (load (field context value-types))) symbol))

(defn fng-symbol-coil-type [(context FngContext) (symbol i64)] (-> i64)
  (let [tag (fng-symbol-type context symbol)]
    (cond (= tag FNG-NUMBER) (t-int)
          (= tag FNG-BOOLEAN) (t-bool)
          ;; Null is commonly only the initializer of a mutable JavaScript
          ;; variable. Keep its merge bound open so an object assignment on a
          ;; branch or loop backedge can widen the Phi.
          (= tag FNG-NULL) (t-dyn)
          :else (t-dyn))))

(defn fng-set-symbol-type! [(context FngContext) (symbol i64) (type i64)] (-> i64)
  ;; A script global's value is whatever the side table holds when any function last wrote it,
  ;; so a type observed while building one function must never narrow a read built in another.
  (al-set! [i64]
           (mut (load (field context value-types)))
           symbol
           (if (fng-script-global-symbol? (load (field context frontend)) symbol)
               FNG-DYNAMIC
               type)))

(defn fng-intrinsic-type [(symbol i64)] (-> i64)
  (cond (= symbol FE-INTRINSIC-STRING) FNG-INTRINSIC-STRING
        (= symbol FE-INTRINSIC-PARSEINT) FNG-INTRINSIC-PARSEINT
        (= symbol FE-INTRINSIC-ISNAN) FNG-INTRINSIC-ISNAN
        (= symbol FE-INTRINSIC-UNDEFINED) FNG-VOID
        (= symbol FE-INTRINSIC-NAN) FNG-NUMBER
        (= symbol FE-INTRINSIC-INFINITY) FNG-NUMBER
        (= symbol FE-INTRINSIC-ERROR) FNG-INTRINSIC-ERROR
        (= symbol FE-INTRINSIC-ARRAY) FNG-INTRINSIC-ARRAY
        (= symbol FE-INTRINSIC-OBJECT) FNG-INTRINSIC-OBJECT
        (= symbol FE-INTRINSIC-NUMBER) FNG-INTRINSIC-NUMBER
        (= symbol FE-INTRINSIC-PARSEFLOAT) FNG-INTRINSIC-PARSEFLOAT
        (= symbol FE-INTRINSIC-BOOLEAN) FNG-INTRINSIC-BOOLEAN
        :else FNG-DYNAMIC))

(defn fng-declared-symbol-type [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) FNG-DYNAMIC]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load answer) FNG-DYNAMIC))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) symbol-id)
                    (set! answer (fng-type-tag frontend (.type-node symbol)))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-number-array-symbol? [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> bool)
  (let [(mut index) 0 (mut answer) false]
    (loop (if (or (load answer)
                  (>= (load index) (al-len [FeSymbol] (.symbols frontend))))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) symbol-id)
                    (let [type-node (.type-node symbol)]
                      (if (>= type-node 0)
                          (let [text (ts-text (field frontend ast) type-node)
                                length (slice-len text)]
                            (if (and (>= length 2)
                                     (and (= (substr text (- length 2) length) "[]")
                                          (or (= (fng-type-tag frontend
                                                               (ts-child (field frontend ast)
                                                                         type-node 0))
                                                 FNG-NUMBER)
                                              (= text "number[]"))))
                                (set! answer true) 0)) 0)) 0)
                (set! index (+ (load index) 1)))))
    (load answer)))

; Closed-world JavaScript field inference. A dynamic property is array-valued only
; when every direct assignment to that property in the compilation unit creates an
; array. State: 0 = unseen, 1 = array-only, 2 = conflicting/non-array assignment.
(defn fng-array-property-scan [(frontend (ptr NativeFrontend))
                               (node i64)
                               (name (slice u8))] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (and (= kind TSK-BINARY)
             (= (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS)
             (= (ts-text ast (ts-child ast (ts-child ast node 0) 1)) name))
        (let [value (ts-child ast node 2)
              value-kind (ts-kind ast value)]
          (if (or (= value-kind TSK-ARRAY-LITERAL)
                  (and (= value-kind TSK-NEW-EXPRESSION)
                       (= (fe-resolution-symbol frontend (ts-child ast value 0))
                          FE-INTRINSIC-ARRAY)))
              1
              2))
        (let [(mut index) 0
              (mut state) 0]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (= (load state) 2))
                    (break)
                    (let [child-state
                            (fng-array-property-scan frontend
                                                     (ts-child ast node (load index))
                                                     name)]
                      (if (= child-state 2)
                          (set! state 2)
                          (if (= child-state 1) (set! state 1) 0))
                      (set! index (+ (load index) 1)))))
          (load state)))))

(defn fng-array-property? [(frontend (ptr NativeFrontend)) (name-node i64)] (-> bool)
  (= (fng-array-property-scan frontend
                              (ts-root (field frontend ast))
                              (ts-text (field frontend ast) name-node))
     1))

(defn fng-call-result-type [(frontend (ptr NativeFrontend))
                            (callee i64)
                            (construct bool)] (-> i64)
  (let [function-index (fng-function-index frontend callee)]
    ;; Prototype and other dynamic property calls can have closed-world targets without one direct
    ;; function symbol. Their result remains dynamic at this stage; never index functions at -1.
    (if (< function-index 0)
        FNG-DYNAMIC
        (let [fn (al-get [FeFunction] (.functions frontend) function-index)
              result (fng-type-tag frontend (.result-node fn))]
          ;; TypeScript permits constructor-style factory functions which return a declared object
          ;; type without using `this` (for example `new Tree(left, right): Tree`).  In that case
          ;; the explicit object return, not the absent receiver annotation, describes the value
          ;; produced by `new`.  Primitive returns still fall back to the receiver because
          ;; JavaScript ignores them for constructor calls.
          (if (and construct (>= result 0))
              result
              (if construct
                  (fng-type-tag frontend (.receiver-type-node fn))
                  result))))))

(defn fng-infer [(context FngContext) (node i64) (expected i64)] (-> i64)
  (if (!= expected FNG-DYNAMIC)
      expected
      (let [frontend (load (field context frontend))
            ast (field frontend ast)
            kind (ts-kind ast node)]
        (cond (= kind TSK-IDENTIFIER)
                (let [symbol (fe-resolution-symbol frontend node)]
                  (if (< symbol 0) (fng-intrinsic-type symbol) (fng-symbol-type context symbol)))
              (= kind TSK-THIS)
                (let [fn
                        (al-get [FeFunction]
                                (load (field frontend functions))
                                (fng-function-index frontend (load (field context owner))))]
                  (fng-type-tag frontend (load (field fn receiver-type-node))))
              (= kind TSK-NUMERIC-LITERAL) FNG-NUMBER
              (= kind TSK-STRING-LITERAL) FNG-STRING
              (= kind TSK-TEMPLATE-EXPRESSION) FNG-STRING
              (= kind TSK-PARENTHESIZED-EXPRESSION)
                (fng-infer context (ts-child ast node 0) FNG-DYNAMIC)
              (or (= kind TSK-TRUE) (= kind TSK-FALSE)) FNG-BOOLEAN
              (= kind TSK-NULL) FNG-NULL
              (= kind TSK-ARRAY-LITERAL) FNG-ARRAY
              (= kind TSK-ELEMENT-ACCESS)
                (let [base (ts-child ast node 0)]
                  (if (and (= (ts-kind ast base) TSK-IDENTIFIER)
                           (fng-number-array-symbol? frontend
                                                     (fe-resolution-symbol frontend base)))
                      FNG-NUMBER
                      ;; `s[i]` ON A STRING IS A STRING, which is what TypeScript's own type for it
                      ;; says, and saying so here is what puts `s[i].charCodeAt(0)` on the static
                      ;; string path. It is not merely faster: the dynamic dispatch answers 0 for a
                      ;; receiver typed `str|undefined`, so a loop over `s[i].charCodeAt(0)` summed
                      ;; to nothing. Out of range the value is `undefined` and calling a method on it
                      ;; is a TypeError this compiler cannot raise -- the same gap every other
                      ;; unguarded access has, and the reason `docs/NATIVE-DIFFERENTIAL.md` is a
                      ;; floor rather than a conformance claim.
                      (if (= (fng-infer context base FNG-DYNAMIC) FNG-STRING)
                          FNG-STRING
                          FNG-DYNAMIC)))
              (= kind TSK-OBJECT-LITERAL) (fe-type-index-for-decl-node frontend node)
              (or (= kind TSK-CALL) (= kind TSK-NEW-EXPRESSION))
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-OBJECT))
                    FNG-DYNAMIC
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ARRAY))
                    FNG-ARRAY
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ERROR))
                    FNG-DYNAMIC
                (let [callee-type
                        (if (= kind TSK-CALL)
                            (fng-infer context (ts-child ast node 0) FNG-DYNAMIC)
                            FNG-DYNAMIC)]
                  (if (or (= callee-type FNG-INTRINSIC-STRING)
                          (or (= callee-type FNG-INTRINSIC-PARSEINT)
                              (or (= callee-type FNG-INTRINSIC-ISNAN)
                                  (= callee-type FNG-INTRINSIC-BOOLEAN))))
                      (if (= callee-type FNG-INTRINSIC-STRING)
                          FNG-STRING
                          (if (or (= callee-type FNG-INTRINSIC-ISNAN)
                                  (= callee-type FNG-INTRINSIC-BOOLEAN))
                              FNG-BOOLEAN
                              FNG-NUMBER))
                      ;; Both of these are unboxed at their emitter — see `fng-number-static` for
                      ;; why the predicates must be — so they are a machine bool and a machine
                      ;; number, exactly like the global `isNaN` and `parseInt` above.
                      (if (and (= kind TSK-CALL) (fng-number-static? context node))
                          FNG-BOOLEAN
                      (if (and (= kind TSK-CALL) (fng-parse-float? context node))
                          FNG-NUMBER
                      (if (and (= kind TSK-CALL) (fng-number-convert? context node))
                          FNG-NUMBER
                      (if (and (= kind TSK-CALL) (fng-number-to-string? context node))
                          FNG-STRING
                      (if (and (= kind TSK-CALL) (fng-number-to-fixed? context node))
                          FNG-STRING
                          (if (and (= kind TSK-CALL) (fng-array-from? context node))
                              FNG-ARRAY
                          (if (and (= kind TSK-CALL) (fng-array-is-array? context node))
                              FNG-BOOLEAN
                          (if (and (= kind TSK-CALL) (fng-array-of? context node))
                              FNG-ARRAY
                          (if (and (= kind TSK-CALL) (fng-array-iterator-next? context node))
                              FNG-DYNAMIC
                          (if (and (= kind TSK-CALL) (fng-object-enumeration? context node))
                              FNG-ARRAY
                          (if (and (= kind TSK-CALL) (fng-string-raw? context node))
                              FNG-STRING
                          (if (and (= kind TSK-CALL) (fng-string-from-char-code? context node))
                              FNG-STRING
                              (if (and (= kind TSK-CALL) (fng-string-builtin? context node))
                                  (fng-string-builtin-result (fng-string-builtin-name context node))
                                  (if (and (= kind TSK-CALL) (fng-math-builtin? context node))
                                      FNG-NUMBER
                                  (if (and (= kind TSK-CALL) (fng-array-builtin? context node))
                                      (let [builtin (fng-array-builtin-name context node)]
                                        (cond (= builtin "push") FNG-NUMBER
                                              (or (= builtin "keys")
                                                  (or (= builtin "values")
                                                      (= builtin "entries"))) FNG-ITERATOR
                                              (or (= builtin "concat")
                                              (or (= builtin "flat")
                                              (or (= builtin "slice")
                                                  (or (= builtin "splice")
                                                  (or (= builtin "map")
                                                      (or (= builtin "filter")
                                                          (or (= builtin "sort")
                                                              (= builtin "flatMap")))))))) FNG-ARRAY
                                              (= builtin "join") FNG-STRING
                                              (or (= builtin "some")
                                                  (= builtin "every")) FNG-BOOLEAN
                                              (= builtin "findIndex") FNG-NUMBER
                                              :else FNG-DYNAMIC))
                                      (let [callee-node (ts-child ast node 0)
                                            callee
                                              (if (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS)
                                                  (fe-find-function-name frontend (ts-child ast callee-node 1))
                                                  (fe-resolution-symbol frontend callee-node))]
                                      (fng-call-result-type
                                        frontend callee (= kind TSK-NEW-EXPRESSION)))))))))))))))))))))))
              (= kind TSK-PROPERTY-ACCESS)
                (if (fng-number-constant? context node)
                    FNG-NUMBER
                (let [owner (fng-infer context (ts-role ast node TS-ROLE-OBJECT 0) FNG-DYNAMIC)
                      name-node (ts-role ast node TS-ROLE-PROPERTY 0)
                      field-index
                        (if (= owner FNG-DYNAMIC)
                            -1
                            (fng-field-index frontend owner name-node))]
                  (if (< field-index 0)
                      (if (and (= owner FNG-DYNAMIC)
                               (fng-array-property? frontend name-node))
                          FNG-ARRAY
                          FNG-DYNAMIC)
                      (let [field-value (al-get [FeField] (load (field frontend fields)) field-index)]
                        (fng-type-tag frontend (load (field field-value type-node)))))))
              (= kind TSK-PREFIX-UNARY)
                (let [text (ts-text ast node)]
                  (if (and (> (slice-len text) 0) (= (substr text 0 1) "!"))
                      FNG-BOOLEAN
                      FNG-NUMBER))
              (= kind TSK-VOID-EXPRESSION) FNG-VOID
              (= kind TSK-DELETE-EXPRESSION) FNG-BOOLEAN
              (= kind TSK-TYPEOF-EXPRESSION) FNG-STRING
              (= kind TSK-POSTFIX-UNARY) FNG-NUMBER
              (= kind TSK-CONDITIONAL-EXPRESSION) expected
              (= kind TSK-BINARY)
                (let [operator (ts-text ast (ts-child ast node 1))]
                  (if (or (= operator "<")
                          (= operator "<=")
                          (= operator ">")
                          (= operator ">=")
                          (= operator "==")
                          (= operator "!=")
                          (= operator "===")
                          (or (= operator "!==")
                              (or (= operator "in") (= operator "instanceof"))))
                      FNG-BOOLEAN
                      (if (or (= operator "%")
                              (or (= operator "&")
                                  (or (= operator "|")
                                      (or (= operator "^")
                                          (or (= operator "<<")
                                              (or (= operator ">>")
                                                  (= operator ">>>")))))))
                          FNG-NUMBER
                          (fng-infer context (ts-child ast node 0) FNG-DYNAMIC))))
              :else FNG-DYNAMIC))))

;; The one report for syntax the builder has no lowering for. `kind` is worth printing because the
;; interesting case is kind 0: that is the bridge's `default`, so it means "the Go side does not
;; enumerate this syntax at all" rather than "this kind is known and unhandled", and the two want
;; different fixes.
;; THE RECEIVER SLOT TAKES A TAGGED OBJECT-ISH VALUE, and this is the verifier's own rule --
;; `VERR-CALL-RECEIVER-TAG` accepts `undefined`, an object or a function and nothing else.
;;
;; A method on a PRIMITIVE therefore has nowhere to go: `(acc / 4).toFixed(2)` put a raw `Div`
;; straight into the slot, and `'aXa'.replace(...)` did the same with a string. JavaScript answers
;; this by boxing the primitive into a wrapper object, and this compiler has no wrapper objects --
;; so the honest outcome is a refusal, not a Call the verifier will reject afterwards. Neither
;; method is implemented anyway: there is no `toFixed` in `lib/`, and `lib/string/replace-all.jsl`
;; is `replaceAll`, which has different semantics from `replace`.
;;
;; Checked HERE rather than left to `g-verify` because the frontend is what knows the source text.
;; See repros/open/method-call-on-primitive-receiver.js.
(defn fng-valid-receiver? [(value i64)] (-> bool)
  (if (= value NO-NODE)
      true
      ;; A HIGH type passes. The builder analyses lazily, so a node built a moment ago still reads
      ;; as unanalysed and there is nothing to conclude from it -- and `fng-machine-number-value?`
      ;; is not the way to fill that gap, whatever it looks like: `ty-isa ANY num` is true, so it
      ;; reports every unanalysed value as a machine number. Tried here, it refused `reset()` and
      ;; five NavierStokes repros. The numeric case is caught from the SOURCE instead, at the
      ;; receiver-call site below, where the frontend has a declared type to read.
      (let [t (n-ty value)]
        (if (ty-high? t)
            true
            (or (= (ty-kinds t) VK-UNDEF)
                (or (!= (& (ty-kinds t) VK-OBJ) 0)
                    (!= (& (ty-kinds t) VK-FUN) 0)))))))

(defn fng-unsupported-syntax! [(position (slice u8)) (kind i64) (text (slice u8))] (-> i64)
  (let [w (stderr)]
    (fmt w "frontend: unsupported {s} syntax (bridge kind {d}): " position kind)
    (ps w text)
    (ps w "\n"))
  (abort)
  0)

(defn fng-expression [(context FngContext) (node i64)] (-> i64)
  (fng-expression-expected context node FNG-DYNAMIC))

;; The closure environment ABI. Field 0 is the runtime callable id (`fidx = FeFunction.id + 1`)
;; so a closure VALUE loaded from the heap can be dispatched generically: the polymorphic call
;; sequence reads it and selects the target, then passes the environment itself as the callee's
;; hidden first parameter. Fields 1..N are the captured cells, and a lexical `this` rides as the
;; final field. Creator and callee both derive the layout from this one function, so the shapes
;; agree by construction.
(defn fng-env-shape-of [(frontend (ptr NativeFrontend))
                        (cell-shape i64)
                        (function-id i64)] (-> i64)
  (let [count (fng-symbol-capture-count frontend function-id)
        (mut shape) (shape-transition SHAPE-ROOT "__closure_target" (t-int))
        (mut i) 0]
    (loop (if (>= (load i) count)
              (break)
              (do
                (set! shape
                      (shape-transition (load shape)
                                        (fng-capture-field-name (load i))
                                        (t-obj-shape cell-shape)))
                (set! i (+ (load i) 1)))))
    (if (fng-lexical-this? frontend function-id)
        (set! shape (shape-transition (load shape) "__closure_this" (t-dyn)))
        0)
    (load shape)))

(defn fng-env-shape [(context FngContext) (function-id i64)] (-> i64)
  (fng-env-shape-of (load (field context frontend))
                    (.cell-shape context)
                    function-id))

(defn fng-closure-expression [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        function-index (fng-function-node-index frontend node)
        fn (al-get [FeFunction] (.functions frontend) function-index)
        function-id (.id fn)
        target (al-get [i64] (load (load (field context functions))) function-id)
        (mut captures) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (fng-symbol-capture-count frontend function-id))
              (break)
              (let [symbol (fng-capture-symbol frontend function-id (load index))]
                (al-push! [i64]
                          (mut captures)
                          (if (load (fng-capture-by-value-ptr))
                              (fng-symbol-node context symbol)
                              (fng-symbol-storage context symbol)))
                (set! index (+ (load index) 1)))))
    (if (fng-lexical-this? frontend function-id)
        (al-push! [i64]
                  (mut captures)
                  (fng-box-dynamic-argument! (.receiver context)))
        0)
    (let [closure
            (if (= (al-len [i64] (load captures)) 0)
                target
                (if (load (fng-capture-by-value-ptr))
                    (n-closure! target (al-slice [i64] (load captures)))
                (let [shape (fng-env-shape context function-id)
                      (mut incoming) (al-new [i64] (malloc-allocator))
                      (mut stores) (al-new [i64] (malloc-allocator))
                      (mut i) 0]
                  (loop (if (>= (load i) (shape-field-count shape))
                            (break)
                            (let [alias
                                    (fng-record-dynamic-alias! context
                                                               (shape-field-alias shape (load i)))]
                              (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                              (set! i (+ (load i) 1))
                              0)))
                  (let [nw
                          (n-new-obj! (load (load (field context ctrl)))
                                      shape
                                      (al-slice [i64] (load incoming)))
                        object (n-obj-ptr nw)]
                    (al-push! [i64]
                              (mut stores)
                              (n-store! (n-obj-mem nw 0)
                                        object
                                        (fng-const (+ function-id 1))
                                        (shape-field-alias shape 0)))
                    (set! i 0)
                    (loop (if (>= (load i) (al-len [i64] (load captures)))
                              (break)
                              (do
                                (al-push! [i64]
                                          (mut stores)
                                          (n-store! (n-obj-mem nw (+ (load i) 1))
                                                    object
                                                    (al-get [i64] (load captures) (load i))
                                                    (shape-field-alias shape (+ (load i) 1))))
                                (set! i (+ (load i) 1))
                                0)))
                    (set! (load (field context memory)) (fng-preserve-active-memory context (fng-merge stores)))
                    (let [answer (n-materialized-closure! target object (al-slice [i64] (load captures)))]
                      (al-free! [i64] (mut incoming))
                      (al-free! [i64] (mut stores))
                      answer)))))]
      (al-free! [i64] (mut captures))
      closure)))

(defn fng-empty-object [(context FngContext) (owner i64)] (-> i64)
  (let [frontend (load (field context frontend))
        type (al-get [FeTypeDecl] (.types frontend) owner)
        shape (al-get [i64] (load (load (field context shapes))) owner)
        field-start (.field-start type)
        field-count (.field-count type)
        (mut incoming) (al-new [i64] (malloc-allocator))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) field-count)
              (break)
              (let [alias (al-get [i64] (load (load (field context aliases))) (+ field-start (load i)))]
                (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                (set! i (+ (load i) 1)))))
    (let [nw (n-new-obj! (load (load (field context ctrl))) shape (al-slice [i64] (load incoming)))
          object (n-obj-ptr nw)]
      (set! i 0)
      (loop (if (>= (load i) field-count)
                (break)
                (do
                  (al-push! [i64] (mut memories) (n-obj-mem nw (load i)))
                  (set! i (+ (load i) 1))
                  0)))
      (fng-active-memory! context (mut active))
      (set! i 0)
      (loop (if (>= (load i) (al-len [i64] (load active)))
                (break)
                (let [field-index (al-get [i64] (load active) (load i))
                      field (al-get [FeField] (.fields frontend) field-index)]
                  (if (= (.owner field) owner)
                      0
                      (let [alias (al-get [i64] (load (load (field context aliases))) field-index)]
                        (al-push! [i64] (mut memories) (fng-current-memory context alias))))
                  (set! i (+ (load i) 1)))))
      (if (> (al-len [FeCapture] (.captures frontend)) 0)
          (al-push! [i64]
                    (mut memories)
                    (fng-current-memory context (.cell-alias context)))
          0)
      (set! (load (field context memory)) (fng-merge memories))
      (al-free! [i64] (mut incoming))
      (al-free! [i64] (mut memories))
      (al-free! [i64] (mut active))
      object)))

(defn fng-empty-dynamic-object [(context FngContext)] (-> i64)
  (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
  (n-obj-ptr (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)))

(defn fng-pin-after-call! [(context FngContext) (dependency i64) (value i64)] (-> i64)
  ; Both truthiness arms rejoin immediately. The branch exists only to make the post-call control
  ; dependency explicit; unlike `dependency === dependency`, it cannot fold away under peep.
  (let [arms (n-if-arms! (n-new2 (If) (load (load (field context ctrl))) dependency))
        region (n-new (Region))]
    (n-add-def! region NO-NODE)
    (n-add-def! region (arms-t arms))
    (n-add-def! region (arms-f arms))
    (set! (load (field context ctrl)) region)
    value))

(defn fng-prototype-parent [(frontend (ptr NativeFrontend)) (constructor i64)] (-> i64)
  (let [(mut index) 0 (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FePrototypeParent] (.prototype-parents frontend)))
                  (!= (load answer) -1))
              (break)
              (let [relation
                      (al-get [FePrototypeParent]
                              (.prototype-parents frontend)
                              (load index))]
                (if (= (.constructor relation) constructor)
                    (set! answer (.parent relation))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

;; Resolve a prototype method by property name when the closed world contains exactly one
;; implementation.  This covers the common monomorphic JavaScript method-call case while
;; leaving genuinely polymorphic names as dynamic calls for later dispatch lowering.
(defn fng-unique-prototype-method [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load index))]
                (if (= name (ts-text ast (.name-node method)))
                    (if (= (load answer) -1)
                        (set! answer (.target method))
                        (set! answer -2))
                    0)
                (set! index (+ (load index) 1)))))
    (if (= (load answer) -2) -1 (load answer))))

(defn fng-prototype-method-targets [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut targets) 0
        (mut captures) -1
        (mut valid) true]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load index))
                    target (.target method)]
                (if (= name (ts-text ast (.name-node method)))
                    ;; Function payload zero is reserved by the runtime, so graph Fun nodes
                    ;; and boxed function values use source id + 1. Target summaries must use
                    ;; that same identity; otherwise polymorphic dispatch selects the method
                    ;; immediately preceding the one stored in the object. Capture counts no
                    ;; longer restrict the set: every callable reserves the same single hidden
                    ;; environment slot, so mixed capture-free and capturing targets share one
                    ;; call descriptor.
                    (let [runtime-target (+ target 1)]
                      (if (or (< target 0) (>= runtime-target 63))
                          (set! valid false)
                          0)
                      (set! targets (| (load targets) (<< 1 runtime-target))))
                    0)
                (set! index (+ (load index) 1)))))
    (if (load valid) (load targets) 0)))

;; Every distinct prototype method sharing this name, with no width limit. This feeds the
;; graph-level dispatch chain used when the finite 63-bit target summary cannot represent the
;; set; the chain compares exact callable identity, so arbitrary function ids are fine.
(defn fng-method-candidates! [(frontend (ptr NativeFrontend))
                              (name-node i64)
                              (out (mut (ArrayList i64)))] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (.prototype-methods frontend)))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (.prototype-methods frontend)
                              (load index))
                    target (.target method)]
                ; Identity comparison against a boxed Fun constant only means something for a
                ; capture-free target; a capturing method's runtime value is a per-construction
                ; closure object and dispatches through the finite target summary instead.
                (if (and (= name (ts-text ast (.name-node method)))
                         (and (>= target 0)
                              (= (fng-capture-count frontend target) 0)))
                    (let [(mut scan) 0
                          (mut seen) false]
                      (loop (if (or (>= (load scan) (al-len [i64] (load out))) (load seen))
                                (break)
                                (do
                                  (if (= (al-get [i64] (load out) (load scan)) target)
                                      (set! seen true)
                                      0)
                                  (set! scan (+ (load scan) 1)))))
                      (if (not (load seen)) (al-push! [i64] (mut out) target) 0))
                    0)
                (set! index (+ (load index) 1)))))
    (al-len [i64] (load out))))

(defn fng-constructor-descends-from? [(frontend (ptr NativeFrontend))
                                      (constructor i64)
                                      (ancestor i64)] (-> bool)
  (let [(mut current) constructor
        (mut fuel) 64
        (mut found) false]
    (loop (if (or (< (load current) 0)
                  (or (<= (load fuel) 0) (load found)))
              (break)
              (do
                (if (= (load current) ancestor) (set! found true) 0)
                (if (not (load found))
                    (set! current (fng-prototype-parent frontend (load current)))
                    0)
                (set! fuel (- (load fuel) 1)))))
    (load found)))

(defn fng-constructor-prototype! [(context FngContext) (constructor i64)] (-> i64)
  (let [frontend0 (load (field context frontend))
        constructor-index (fng-function-index frontend0 constructor)
        top-level-declaration
          (and (>= constructor-index 0)
               (let [fn (al-get [FeFunction] (.functions frontend0) constructor-index)]
                 (= (.parent fn) -1)))]
    ; Reusing a lazily materialized prototype is only sound where the first materialization
    ; dominates every later use. The top level is straight-line for these, so main keeps its memo
    ; and publishes exactly that object as the constructor's `.prototype` property. A function
    ; body instead LOADS that published object: one property read is dominance-safe at any control
    ; point, allocates nothing per call, and keeps one prototype identity for the whole program —
    ; re-materializing a copy per site rebuilt the method tables inside hot loops and drowned the
    ; property side table in dead prototype objects.
    (if (and (not (.top-level context)) top-level-declaration)
        (fng-jsl-call2 context "GetNamedProperty"
                       (al-get [i64] (load (load (field context functions))) constructor)
                       (fng-const (shape-name-intern! "prototype")))
  (let [prototypes (load (field context prototypes))
        existing (if (.top-level context)
                     (al-get [i64] (load prototypes) constructor)
                     NO-NODE)]
    (if (!= existing NO-NODE)
        existing
        (let [frontend (load (field context frontend))
              ast (field frontend ast)
              object (fng-empty-dynamic-object context)
              initialized
                (fng-jsl-call2 context "InitializeFunctionPrototype"
                               object
                               (al-get [i64]
                                       (load (load (field context functions)))
                                       constructor))
              parent (fng-prototype-parent frontend constructor)
              (mut index) 0]
          (if (>= parent 0)
              (let [linked
                      (fng-jsl-call2 context "SetObjectPrototype" object
                                     (fng-constructor-prototype! context parent))]
                0)
              0)
          (loop (if (>= (load index)
                        (al-len [FePrototypeMethod] (.prototype-methods frontend)))
                    (break)
                    (let [method
                            (al-get [FePrototypeMethod]
                                    (.prototype-methods frontend)
                                    (load index))]
                      ; Publish the inherited closed-world method set directly on each synthesized
                      ; prototype as well as linking its parent. Prototype assignments are indexed
                      ; in source order, so a child override is stored after its ancestor's value.
                      ; This prevents an early instance lookup from observing a recursively-created
                      ; ancestor whose initialization was locally scheduled too late.
                      ; A capture-carrying method's callable value is a closure materialized when
                      ; its constructor runs, stored directly on the instance. The bare Fun would
                      ; be missing its environment; publishing it on the prototype would turn a
                      ; pre-assignment lookup into a silent wrong-environment call, so it is
                      ; deliberately absent and such a lookup traps in the callee's unbox instead.
                      (if (and (fng-constructor-descends-from?
                                 frontend constructor (.constructor method))
                               (= (fng-capture-count frontend (.target method)) 0))
                          (let [target-index
                                  (fng-function-index frontend (.target method))
                                target-function
                                  (al-get [FeFunction]
                                          (.functions frontend)
                                          target-index)
                                target
                                  ; Closed-world prototype dispatch supplies the normalized method
                                  ; environment at the call site, so the property carries exact
                                  ; function identity rather than a target-specific closure object.
                                  (al-get [i64]
                                          (load (load (field context functions)))
                                          (.target method))
                                stored
                                  (fng-jsl-call3 context "SetNamedProperty"
                                                 object
                                                 (fng-const
                                                   (shape-name-intern!
                                                     (ts-text ast (.name-node method))))
                                                 target)]
                            0)
                          0)
                      (set! index (+ (load index) 1)))))
          (al-set! [i64] (mut (load (field context prototypes))) constructor object)
          object))))))

(defn fng-array-prototype-expression? [(frontend (ptr NativeFrontend)) (node i64)] (-> bool)
  (let [ast (field frontend ast)]
    (and (= (ts-kind ast node) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ARRAY)
              (= (ts-text ast (ts-child ast node 1)) "prototype")))))

(defn fng-array-builtin-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (or (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-ARRAY)
                 (fng-array-prototype-expression? frontend (ts-child ast callee 0))))
        (ts-text ast (ts-child ast callee 1))
        ;; Borrowed Array methods keep the same DSL operation; only the source location of the
        ;; receiver and arguments differs. Recognize `.call` structurally here and let each array
        ;; lowering extract those operands, rather than treating the built-in method identity as a
        ;; generic user function (which cannot dispatch to an opaque built-in identity).
        (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                 (= (ts-text ast (ts-child ast callee 1)) "call"))
            (let [method (ts-child ast callee 0)]
              (if (and (= (ts-kind ast method) TSK-PROPERTY-ACCESS)
                       (or (= (fng-infer context (ts-child ast method 0) FNG-DYNAMIC) FNG-ARRAY)
                           (fng-array-prototype-expression? frontend
                                                            (ts-child ast method 0))))
                  (ts-text ast (ts-child ast method 1))
                  ""))
            ""))))

(defn fng-array-builtin? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        syntax-name (if (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                        (ts-text ast (ts-child ast callee 1))
                        "")
        supported (cond (= syntax-name "call") true
                        (= syntax-name "concat") true (= syntax-name "flat") true
                        (= syntax-name "splice") true (= syntax-name "fill") true
                        (= syntax-name "reverse") true (= syntax-name "unshift") true
                        (= syntax-name "push") true (= syntax-name "pop") true
                        (= syntax-name "shift") true (= syntax-name "slice") true
                        (= syntax-name "indexOf") true (= syntax-name "includes") true
                        (= syntax-name "lastIndexOf") true (= syntax-name "at") true
                        (= syntax-name "join") true (= syntax-name "map") true
                        (= syntax-name "filter") true (= syntax-name "forEach") true
                        (= syntax-name "reduce") true (= syntax-name "reduceRight") true
                        (= syntax-name "find") true (= syntax-name "findIndex") true
                        (= syntax-name "some") true (= syntax-name "every") true
                        (= syntax-name "sort") true (= syntax-name "flatMap") true
                        (= syntax-name "keys") true (= syntax-name "values") true
                        (= syntax-name "entries") true :else false)]
    ;; Receiver inference recursively classifies call expressions. Reject unrelated method names
    ;; before entering it; borrowed `Array.prototype.x.call(...)` remains on the structural path.
    (if (not supported)
        false
        (let [name (fng-array-builtin-name context node)]
          (cond (= name "concat") true (= name "flat") true
                (= name "splice") true (= name "fill") true
                (= name "reverse") true (= name "unshift") true
                (= name "push") true (= name "pop") true
                (= name "shift") true (= name "slice") true
                (= name "indexOf") true (= name "includes") true
                (= name "lastIndexOf") true (= name "at") true
                (= name "join") true (= name "map") true
                (= name "filter") true (= name "forEach") true
                (= name "reduce") true (= name "reduceRight") true
                (= name "find") true (= name "findIndex") true
                (= name "some") true (= name "every") true
                (= name "sort") true (= name "flatMap") true
                (= name "keys") true (= name "values") true
                (= name "entries") true :else false)))))

(defn fng-array-iterator-next? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-child-count ast node) 1)
         (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
              (and (= (ts-text ast (ts-child ast callee 1)) "next")
                   (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-ITERATOR))))))

(defn fng-array-iterator-next [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (fng-jsl-call1 context "ArrayIteratorNext"
                   (n-box! (fng-expression context (ts-child ast callee 0))))))

;; `Array.prototype.at` and `Array.prototype.join`, out of lib/array/read.jsl.
;;
;; Both remain `macro`s, so their small graphs inline into the caller. Heap-reading builtins are
;; also valid: the JSL call convention gives them an implicit trailing memory effect.
;;
;; `at` boxes its index because `RelativeIndex` runs `%ToInteger` on a tagged word. `join`'s
;; separator defaults to "," — and its disagreement with `String(x)` is the definition's whole
;; reason for existing: `undefined` and `null` join as the EMPTY string, not as "undefined".
(defn fng-array-at [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        argc (- (ts-child-count ast node) 1)]
    (fng-jsl-call2 context "ArrayAt" array
                   (n-box! (if (> argc 0)
                               (fng-expression context (ts-child ast node 1))
                               (fng-const 0))))))

(defn fng-array-join [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        borrowed (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                      (= (ts-text ast (ts-child ast callee 1)) "call"))
        argument-base (if borrowed 2 1)
        array (n-box! (fng-expression context
                                      (if borrowed (ts-child ast node 1)
                                          (ts-child ast callee 0))))]
    (fng-jsl-call2 context "ArrayJoin" array
                   (if (> (ts-child-count ast node) argument-base)
                       (fng-jsl-call1 context "ToStringValue"
                                      (n-box! (fng-expression context
                                                              (ts-child ast node argument-base))))
                       (n-string-const! (jss-from-utf8! ","))))))

;; The read-only searches, straight out of lib/array/read.jsl.
;;
;; These definitions remain macros, so `jsl-inline!` binds the caller's memory going in and
;; publishes whatever the body left on the way out. Larger or recursive definitions can instead be
;; builtins; their calls carry the same heap as an implicit trailing effect argument.
;;
;; The receiver is BOXED because these methods are intentionally generic: `array.indexOf(x)` and
;; `Array.prototype.indexOf.call(arrayLike, x)` reach the same ArrayLike DSL operation. For the
;; borrowed form child 1 is the receiver and real arguments begin at child 2; treating the method
;; expression as the receiver made `%ArrayLen` read an arbitrary tagged word and native execution
;; scan forever. The frontend decides only this syntax shape. Length, property access, equality and
;; coercion remain wholly in JSL.
(defn fng-array-search [(context FngContext) (node i64) (name (slice u8))] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        borrowed (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                      (= (ts-text ast (ts-child ast callee 1)) "call"))
        argument-base (if borrowed 2 1)
        array (n-box! (fng-expression context
                                      (if borrowed (ts-child ast node 1)
                                          (ts-child ast callee 0))))
        argc (- (ts-child-count ast node) (if borrowed 2 1))
        target (n-box! (if (> argc 0)
                           (fng-expression context (ts-child ast node argument-base))
                           (fng-undefined)))]
    (if (= name "includes")
        (fng-jsl-call3 context "ArrayIncludes" array target
                       (n-box! (if (> argc 1)
                                   (fng-expression context
                                                   (ts-child ast node (+ argument-base 1)))
                                   (fng-const 0))))
        (if (= name "lastIndexOf")
            (fng-jsl-call4 context "ArrayLastIndexOf" array target
                           (n-box! (if (> argc 1)
                                       (fng-expression context
                                                       (ts-child ast node (+ argument-base 1)))
                                       (fng-undefined)))
                           (fng-const (if (> argc 1) 1 0)))
            (fng-jsl-call3 context "ArrayIndexOf" array target
                           (n-box! (if (> argc 1)
                                       (fng-expression context
                                                       (ts-child ast node (+ argument-base 1)))
                                       (fng-const 0))))))))

(defn fng-math-member-id [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-PROPERTY-ACCESS)
             (= (ts-text ast (ts-child ast node 0)) "Math"))
        (jbi-find (ts-text ast node))
        JBI-NONE)))

(defn fng-symbol-declaration-node [(context FngContext) (id i64)] (-> i64)
  (let [frontend (load (field context frontend))
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (!= (load answer) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (= (.id symbol) id)
                    (set! answer (.node symbol))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-math-alias-id [(context FngContext) (callee i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (!= (ts-kind ast callee) TSK-IDENTIFIER)
        JBI-NONE
        (let [symbol (fe-resolution-symbol frontend callee)
              declaration (if (>= symbol 0) (fng-symbol-declaration-node context symbol) -1)]
          (if (and (>= declaration 0) (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION))
              (let [count (ts-child-count ast declaration)
                    initializer (if (> count 1) (ts-child ast declaration (- count 1)) -1)]
                (if (>= initializer 0) (fng-math-member-id context initializer) JBI-NONE))
              JBI-NONE)))))

(defn fng-math-builtin-id [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (let [direct (fng-math-member-id context callee)]
      (if (>= direct 0) direct (fng-math-alias-id context callee)))))

(defn fng-math-builtin? [(context FngContext) (node i64)] (-> bool)
  (>= (fng-math-builtin-id context node) 0))

(defn fng-math-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        descriptor (fng-math-builtin-id context node)
        argc (- (ts-child-count ast node) 1)
        arg0 (if (> argc 0) (fng-expression context (ts-child ast node 1)) (fng-undefined))
        arg1 (if (> argc 1) (fng-expression context (ts-child ast node 2)) (fng-undefined))]
    (if (not (jbi-valid-arity? descriptor argc))
        NO-NODE
      ;; Every Math entry point comes from lib/math. Irreducible libm and random services are named
      ;; primitives there, analogous to Torque externs; the frontend only chooses the definition
      ;; implied by syntax and handles the numeric representation at the JavaScript/IR boundary.
      ;; Math.max and Math.min go through binary MathMax2/MathMin2. They are variadic in the
      ;; language but not in this frontend: `jbi-max-arity` is `jbi-min-arity`, so exactly two
      ;; arguments reach here and anything else is rejected before this point.
      ;;
      ;; WHAT MAKES THIS FREE IS `typetest-idealize`, NOT THIS CODE. The library's MathFloor is
      ;; `if (%IsInt v) v else (%FloorNum v)`, and `%FloorNum` lowers to the same OPTAG-JSBUILTIN the
      ;; hand-written form emitted — so the conversion is that node plus a guard. The guard folds
      ;; against a boxed argument whose input type is proven, which is why the box is built here
      ;; from a value the frontend has already typed rather than from something opaque.
      ;;
      ;; THE RESULT GOES THROUGH ToNumber, NOT AN UNBOX TO `flt`. OPTAG-JSBUILTIN always answers a
      ;; double, so unboxing its result as a float is right. A JSL definition is not the same:
      ;; `MathAbs` of a boxed integer returns a boxed INTEGER, and reading that as a float
      ;; reinterprets the bits. Math.abs(-7) takes exactly that path.
      ;; `sign` and `trunc` are the only two here that do not also exist as an `OPTAG-JSBUILTIN`. The
      ;; other four have a descriptor-runtime implementation underneath — the library's contribution
      ;; to `MathFloor` is the `if (%IsInt v)` guard around `%FloorNum`, which is real but partial —
      ;; where `MathSign` and `MathTrunc` are the whole operation, written in the DSL and reachable
      ;; from a program for the first time here.
      (let [jsl-name (cond (= descriptor JBI-ABS)   "MathAbs"
                           (= descriptor JBI-FLOOR) "MathFloor"
                           (= descriptor JBI-CEIL)  "MathCeil"
                           (= descriptor JBI-ROUND) "MathRound"
                           (= descriptor JBI-SIGN)  "MathSign"
                           (= descriptor JBI-TRUNC) "MathTrunc"
                           (= descriptor JBI-MAX)   "MathMax2"
                           (= descriptor JBI-MIN)   "MathMin2"
                           (= descriptor JBI-EXP)   "MathExp"
                           (= descriptor JBI-LOG)   "MathLog"
                           (= descriptor JBI-SIN)   "MathSin"
                           (= descriptor JBI-COS)   "MathCos"
                           (= descriptor JBI-TAN)   "MathTan"
                           (= descriptor JBI-ASIN)  "MathAsin"
                           (= descriptor JBI-ACOS)  "MathAcos"
                           (= descriptor JBI-ATAN)  "MathAtan"
                           (= descriptor JBI-SQRT)  "MathSqrt"
                           (= descriptor JBI-POW)   "MathPow"
                           :else "MathRandom")]
        (n-to-number!
          (if (= descriptor JBI-RANDOM)
              (fng-jsl-call0 context jsl-name)
              (if (or (= descriptor JBI-POW)
                      (or (= descriptor JBI-MAX) (= descriptor JBI-MIN)))
                  (fng-jsl-call2 context jsl-name (n-box! arg0) (n-box! arg1))
                  (fng-jsl-call1 context jsl-name (n-box! arg0)))))))))

(defn fng-error-constructor? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ERROR)))

(defn fng-error-kind [(name (slice u8))] (-> i64)
  (cond (= name "Error") 0
        (= name "EvalError") 1
        (= name "RangeError") 2
        (= name "ReferenceError") 3
        (= name "SyntaxError") 4
        (= name "TypeError") 5
        (= name "URIError") 6
        :else -1))

(defn fng-error-constructor-value [(context FngContext) (node i64)] (-> i64)
  (fng-jsl-call1 context "ErrorConstructorValue"
                 (fng-const (fng-error-kind (ts-text (field (load (field context frontend)) ast) node)))))

(defn fng-builtin-constructor-value [(context FngContext) (symbol i64)] (-> i64)
  (fng-jsl-call1 context "BuiltinConstructorValue"
                 (fng-const (cond (= symbol FE-INTRINSIC-OBJECT) 16
                                  (= symbol FE-INTRINSIC-ARRAY) 17
                                  (= symbol FE-INTRINSIC-STRING) 18
                                  (= symbol FE-INTRINSIC-NUMBER) 19
                                  :else 20))))

(defn fng-error-constructor [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        name (ts-text ast callee)
        message
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (n-string-const! (jss-from-utf8! "")))
        object
          (fng-jsl-call3 context "NewErrorObject"
                         message
                         (n-string-const! (jss-from-utf8! name))
                         (fng-error-constructor-value context callee))]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    object))

(defn fng-unbound-reference [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object
          (fng-jsl-call3 context "NewErrorObject"
                         (n-string-const! (jss-from-utf8! (ts-text ast node)))
                         (n-string-const! (jss-from-utf8! "ReferenceError"))
                         (fng-jsl-call1 context "ErrorConstructorValue" (fng-const 3)))
        raised (fng-jsl-call1 context "ThrowValue" (n-box! object))]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    ;; An identifier read is an expression, so leave a structurally ordinary (runtime-impossible)
    ;; false arm for its parent expression while routing the pending true arm to the active catch.
    (fng-check-pending-exception! context raised)
    (fng-undefined)))

(defn fng-string-builtin-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
        (ts-text ast (ts-child ast callee 1))
        "")))

;; `Number.isNaN` and its three neighbours, out of lib/number/predicates.jsl.
;;
;; THE DIFFERENCE FROM THE GLOBAL `isNaN` IS COERCION, and it is the reason there are two
;; definitions rather than one: `isNaN("12x")` is true because ToNumber of the argument is NaN,
;; while `Number.isNaN("12x")` is false because the argument is a string rather than the NaN value.
;; `GlobalIsNaN` is `%IsNaN`, which coerces; `NumberIsNaN` is `IsNaNNumber`, which does not.
;;
;; The argument is BOXED. Every one of these asks about the argument's TAG before its value — that
;; is what "is it a Number at all" means here — so it has to arrive as a tagged word, where the
;; string methods take their receiver as the raw pointer it already is.
;;
;; THE RESULT IS UNBOXED BACK TO A RAW BOOL, and that is not tidiness. The four `builtin`s end in
;; `%Box` because a builtin returns a JavaScript value, so the result is a TAGGED boolean, and a
;; tagged boolean used as an `if` or `?:` condition goes through the `JSSOP-VALUE-TRUTHY` runtime
;; call. The global `isNaN` next to it answers a raw machine bool and compares directly, and one
;; expression holding both — `Number.isNaN(v) ? 1 : 0` added to `isNaN(v) ? 2 : 0` — failed
;; selection with `MSEL-TERMINATOR`. Either predicate alone compiles. Unboxing here gives every
;; predicate in the language the same representation, which is what the merge needs.
(defn fng-number-static-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-NUMBER))
        (let [member (ts-text ast (ts-child ast callee 1))]
          (cond (= member "isNaN")         "NumberIsNaN"
                (= member "isFinite")      "NumberIsFinite"
                (= member "isInteger")     "NumberIsInteger"
                (= member "isSafeInteger") "NumberIsSafeInteger"
                :else ""))
        "")))

(defn fng-number-static? [(context FngContext) (node i64)] (-> bool)
  (> (str-len (fng-number-static-name context node)) 0))

(defn fng-number-constant-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-PROPERTY-ACCESS)
             (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-NUMBER))
        (let [member (ts-text ast (ts-child ast node 1))]
          (cond (= member "NaN")               "NumberNaN"
                (= member "POSITIVE_INFINITY") "NumberPositiveInfinity"
                (= member "NEGATIVE_INFINITY") "NumberNegativeInfinity"
                (= member "EPSILON")           "NumberEpsilon"
                (= member "MAX_VALUE")         "NumberMaxValue"
                (= member "MIN_VALUE")         "NumberMinValue"
                (= member "MAX_SAFE_INTEGER")  "NumberMaxSafeInteger"
                (= member "MIN_SAFE_INTEGER")  "NumberMinSafeInteger"
                :else ""))
        "")))

(defn fng-number-constant? [(context FngContext) (node i64)] (-> bool)
  (> (str-len (fng-number-constant-name context node)) 0))

(defn fng-number-static [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        name (fng-number-static-name context node)
        argument
          (if (> (ts-child-count ast node) 1)
              (n-box! (fng-expression context (ts-child ast node 1)))
              ;; `Number.isNaN()` with no argument asks about `undefined`, and every one of these
              ;; answers false for it. Boxed for the same reason the present argument is.
              (n-box! (fng-undefined)))]
    (n-unbox! (fng-jsl-call1 context name argument) (t-bool))))

;; `Number(x)`, which is ToNumber and nothing else — the same `ToNumberValue` the arithmetic seam
;; emits, differing only in that the result is the expression rather than an operand. Unboxed here
;; because the frontend types the call `FNG-NUMBER`, and that means a machine number.
(defn fng-number-convert? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (> (ts-child-count ast node) 0)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-NUMBER))))

(defn fng-number-convert [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    ;; `Number()` with no argument is +0, not NaN. It is the one place this differs from ToNumber
    ;; of `undefined`, and the spec says so explicitly.
    (if (> (ts-child-count ast node) 1)
        (n-unbox! (fng-jsl-call1 context "ToNumberValue"
                                 (n-box! (fng-expression context (ts-child ast node 1))))
                  (t-flt))
        (fng-const 0))))

;; `Boolean(value)` is the DSL's ToBoolean operation. Argument evaluation belongs to the frontend;
;; truthiness does not. An omitted argument is `undefined`, hence false through the same path.
(defn fng-boolean-convert? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (> (ts-child-count ast node) 0)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-BOOLEAN))))

(defn fng-boolean-convert [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argument (if (> (ts-child-count ast node) 1)
                     (n-box! (fng-expression context (ts-child ast node 1)))
                     (n-box! (fng-undefined)))]
    (fng-jsl-call1 context "ToBoolean" argument)))

(defn fng-object-convert? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (> (ts-child-count ast node) 0)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-OBJECT))))

(defn fng-object-convert [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argument (if (> (ts-child-count ast node) 1)
                     (n-box! (fng-expression context (ts-child ast node 1)))
                     (n-box! (fng-undefined)))]
    (fng-jsl-call1 context "ObjectFromValue" argument)))

(defn fng-string-convert? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (> (ts-child-count ast node) 0)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-STRING))))

(defn fng-string-convert [(context FngContext) (node i64) (wrapper bool)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argument (if (> (ts-child-count ast node) 1)
                     (n-box! (fng-expression context (ts-child ast node 1)))
                     (n-string-const! (jss-from-utf8! "")))]
    (fng-jsl-call1 context (if wrapper "NewStringObject" "ToStringValue") argument)))

(defn fng-array-convert? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (> (ts-child-count ast node) 0)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ARRAY))))

(defn fng-array-convert [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argc (- (ts-child-count ast node) 1)]
    (if (= argc 0)
        (fng-jsl-call0 context "NewArray")
        (if (= argc 1)
            (fng-jsl-call1 context "ArrayFromOne"
                           (n-box! (fng-expression context (ts-child ast node 1))))
            (let [(mut array) (fng-jsl-call0 context "NewArray")
                  (mut index) 0]
              (loop (if (>= (load index) argc)
                        (break)
                        (do (fng-jsl-call3 context "SetElement" (load array)
                                          (fng-const (load index))
                                          (fng-expression context
                                            (ts-child ast node (+ (load index) 1))))
                            (set! index (+ (load index) 1)))))
              (load array))))))

(defn fng-primitive-wrapper? [(context FngContext) (node i64) (symbol i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (= (ts-kind ast node) TSK-NEW-EXPRESSION)
         (= (fe-resolution-symbol frontend (ts-child ast node 0)) symbol))))

(defn fng-primitive-wrapper [(context FngContext) (node i64) (number bool)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argument (if (> (ts-child-count ast node) 1)
                     (n-box! (fng-expression context (ts-child ast node 1)))
                     (n-box! (if number (fng-const 0) (fng-undefined))))]
    (fng-jsl-call1 context
                   (if number "NewNumberObject" "NewBooleanObject")
                   argument)))

(defn fng-parse-float? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (or (= (fe-resolution-symbol frontend callee) FE-INTRINSIC-PARSEFLOAT)
        (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-NUMBER)
                  (= (ts-text ast (ts-child ast callee 1)) "parseFloat"))))))

(defn fng-parse-float [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        first (if (> (ts-child-count ast node) 1)
                  (n-box! (fng-expression context (ts-child ast node 1)))
                  (n-box! (fng-undefined)))
        (mut i) 2]
    (loop (if (>= (load i) (ts-child-count ast node)) (break)
            (do (fng-expression context (ts-child ast node (load i)))
                (set! i (+ (load i) 1)))))
    (n-unbox! (fng-jsl-call1 context "ParseFloatValue" first) (t-flt))))

(defn fng-json-parse? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-JSON)
              (= (ts-text ast (ts-child ast callee 1)) "parse")))))

(defn fng-json-parse [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        argc (- (ts-child-count ast node) 1)
        value (if (> (ts-child-count ast node) 1)
                  (fng-expression context (ts-child ast node 1))
                  (fng-undefined))]
    (if (<= argc 1)
        (fng-jsl-call1 context "JSONParse" value)
        (let [reviver (fng-expression context (ts-child ast node 2))
              (mut i) 3]
          ;; ECMAScript ignores later arguments but still evaluates their expressions.
          (loop (if (>= (load i) (ts-child-count ast node)) (break)
                  (do (fng-expression context (ts-child ast node (load i)))
                      (set! i (+ (load i) 1)))))
          (fng-jsl-call2 context "JSONParseWithReviver" value reviver)))))

(defn fng-json-stringify? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-JSON)
              (= (ts-text ast (ts-child ast callee 1)) "stringify")))))

(defn fng-json-stringify [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        argc (- (ts-child-count ast node) 1)
        value (if (> (ts-child-count ast node) 1)
                  (fng-expression context (ts-child ast node 1))
                  (fng-undefined))]
    (if (<= argc 1)
        (fng-jsl-call1 context "JSONStringify" value)
        (let [replacer (fng-expression context (ts-child ast node 2))
              space (if (> argc 2)
                        (fng-expression context (ts-child ast node 3))
                        (fng-undefined))
              (mut i) 4]
          ;; ECMAScript ignores arguments after `space`, but their expressions are still evaluated.
          (loop (if (>= (load i) (ts-child-count ast node)) (break)
                  (do (fng-expression context (ts-child ast node (load i)))
                      (set! i (+ (load i) 1)))))
          (fng-jsl-call3 context "JSONStringifyWithOptions" value replacer space)))))

(defn fng-string-from-char-code? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-STRING)
         (= (ts-text ast (ts-child ast callee 1)) "fromCharCode")))))

(defn fng-string-raw? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (>= (ts-child-count ast node) 2)
         (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
              (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-STRING)
                   (= (ts-text ast (ts-child ast callee 1)) "raw"))))))

(defn fng-string-raw [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        substitutions (fng-jsl-call0 context "NewArray")
        (mut index) 2]
    ;; Only the variadic syntax fold belongs here. Each append and String.raw itself are JSL calls.
    (loop (if (>= (load index) (ts-child-count ast node)) (break)
              (do (fng-jsl-call2 context "ArrayOfAppend1" substitutions
                                  (n-box! (fng-expression context
                                                          (ts-child ast node (load index)))))
                  (set! index (+ (load index) 1)))))
    (fng-jsl-call2 context "StringRaw"
                   (n-box! (fng-expression context (ts-child ast node 1)))
                   substitutions)))

(defn fng-array-of? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-ARRAY)
              (= (ts-text ast (ts-child ast callee 1)) "of")))))

(defn fng-array-is-array? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-ARRAY)
              (= (ts-text ast (ts-child ast callee 1)) "isArray")))))

(defn fng-array-from? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (<= (ts-child-count ast node) 3)
         (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
              (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-ARRAY)
                   (= (ts-text ast (ts-child ast callee 1)) "from"))))))

(defn fng-array-of [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        array (fng-jsl-call0 context "NewArray") (mut i) 1]
    (loop (if (>= (load i) (ts-child-count ast node)) (break)
            (do (fng-jsl-call2 context "ArrayOfAppend1" array
                               (n-box! (fng-expression context (ts-child ast node (load i)))))
                (set! i (+ (load i) 1)))))
    array))

(defn fng-array-is-array [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (fng-jsl-call1 context "IsArray"
                   (n-box! (if (> (ts-child-count ast node) 1)
                               (fng-expression context (ts-child ast node 1))
                               (fng-undefined))))))

(defn fng-array-from [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        source (n-box! (if (> (ts-child-count ast node) 1)
                           (fng-expression context (ts-child ast node 1))
                           (fng-undefined)))
        callback (if (> (ts-child-count ast node) 2)
                     (fng-callback-value context (ts-child ast node 2)) NO-NODE)
        copied (fng-jsl-call1 context "ArrayFrom" source)]
    (if (= callback NO-NODE) copied (fng-jsl-call2 context "ArrayMap" copied callback))))

(defn fng-object-enumeration-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-OBJECT))
        (let [member (ts-text ast (ts-child ast callee 1))]
          (cond (= member "keys") "ObjectKeys"
                (= member "values") "ObjectValues"
                (= member "entries") "ObjectEntries"
                :else ""))
        "")))

(defn fng-object-enumeration? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))]
    (and (= (ts-child-count (field frontend ast) node) 2)
         (> (str-len (fng-object-enumeration-name context node)) 0))))

(defn fng-object-enumeration [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (fng-jsl-call1 context
                   (fng-object-enumeration-name context node)
                   (n-box! (fng-expression context (ts-child ast node 1))))))

(defn fng-object-assign? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (>= (ts-child-count ast node) 2)
         (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
              (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-OBJECT)
                   (= (ts-text ast (ts-child ast callee 1)) "assign"))))))

(defn fng-object-assign [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        target
          (fng-jsl-call1 context "ToObjectValue"
                         (n-box! (fng-expression context (ts-child ast node 1))))
        (mut index) 2]
    ;; Argument evaluation remains a syntax fold in the frontend, like Array.of and variadic
    ;; String.fromCharCode. Each semantic source step is a JSL macro.
    (loop (if (>= (load index) (ts-child-count ast node)) (break)
              (do (fng-jsl-call2 context "ObjectAssignSource"
                                  target
                                  (n-box! (fng-expression context
                                                          (ts-child ast node (load index)))))
                  (set! index (+ (load index) 1)))))
    target))

(defn fng-object-static-direct-name [(context FngContext) (callee i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-OBJECT))
        (ts-text ast (ts-child ast callee 1))
        "")))

(defn fng-object-static-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)
        direct (fng-object-static-direct-name context callee)]
    (if (> (str-len direct) 0)
        direct
        (if (= (ts-kind ast callee) TSK-IDENTIFIER)
            (let [symbol (fe-resolution-symbol frontend callee)
                  declaration (if (>= symbol 0)
                                  (fng-symbol-declaration-node context symbol) -1)]
              (if (and (>= declaration 0)
                       (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION))
                  (let [count (ts-child-count ast declaration)
                        initializer (if (> count 1)
                                        (ts-child ast declaration (- count 1)) -1)]
                    (if (>= initializer 0)
                        (fng-object-static-direct-name context initializer) ""))
                  ""))
            ""))))

(defn fng-object-descriptor-call? [(context FngContext) (node i64)] (-> bool)
  (let [name (fng-object-static-name context node)]
    (or (= name "defineProperty")
        (or (= name "defineProperties")
            (or (= name "getOwnPropertyDescriptor")
                (or (= name "getOwnPropertyNames") (= name "create")))))))

(defn fng-object-descriptor-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        name (fng-object-static-name context node)
        argc (- (ts-child-count ast node) 1)]
    (cond (= name "defineProperty")
            (fng-jsl-call3 context "DefineProperty"
              (n-box! (if (> argc 0) (fng-expression-expected context (ts-child ast node 1)
                                                              FNG-DYNAMIC)
                                      (fng-undefined)))
              (n-box! (if (> argc 1) (fng-expression context (ts-child ast node 2))
                                      (fng-undefined)))
              (n-box! (if (> argc 2) (fng-expression-expected context (ts-child ast node 3)
                                                              FNG-DYNAMIC)
                                      (fng-undefined))))
          (= name "defineProperties")
            (fng-jsl-call2 context "DefineProperties"
              (n-box! (if (> argc 0) (fng-expression-expected context (ts-child ast node 1)
                                                              FNG-DYNAMIC)
                                      (fng-undefined)))
              (n-box! (if (> argc 1) (fng-expression-expected context (ts-child ast node 2)
                                                              FNG-DYNAMIC)
                                      (fng-undefined))))
          (= name "getOwnPropertyDescriptor")
            (fng-jsl-call2 context "GetOwnPropertyDescriptor"
              (n-box! (if (> argc 0) (fng-expression-expected context (ts-child ast node 1)
                                                              FNG-DYNAMIC)
                                      (fng-undefined)))
              (n-box! (if (> argc 1) (fng-expression context (ts-child ast node 2))
                                      (fng-undefined))))
          (= name "getOwnPropertyNames")
            (fng-jsl-call1 context "ObjectOwnPropertyNames"
              (n-box! (if (> argc 0) (fng-expression context (ts-child ast node 1))
                                      (fng-undefined))))
          :else
            (let [object (fng-jsl-call1 context "ObjectCreate"
                           (n-box! (if (> argc 0)
                                      (fng-expression context (ts-child ast node 1))
                                      (fng-undefined))))]
              (if (> argc 1)
                  (fng-jsl-call2 context "DefineProperties" object
                    (n-box! (fng-expression-expected context (ts-child ast node 2) FNG-DYNAMIC)))
                  object)))))

(defn fng-object-prototype-call-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
        (let [name (ts-text ast (ts-child ast callee 1))]
          (if (or (= name "hasOwnProperty")
                  (or (= name "propertyIsEnumerable") (= name "isPrototypeOf"))) name ""))
        "")))

(defn fng-object-prototype-call? [(context FngContext) (node i64)] (-> bool)
  (> (str-len (fng-object-prototype-call-name context node)) 0))

;; The Test262 property helpers deliberately borrow the intrinsic method rather than trusting an
;; object's possibly-shadowed member: `Object.prototype.hasOwnProperty.call(object, key)`. The
;; frontend recognizes only that closed syntactic identity; HasOwnProperty still owns the complete
;; JavaScript operation in lib/abstract/property.jsl.
(defn fng-object-prototype-borrowed-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (= (ts-text ast (ts-child ast callee 1)) "call"))
        (let [method (ts-child ast callee 0)]
          (if (= (ts-kind ast method) TSK-PROPERTY-ACCESS)
              (let [name (ts-text ast (ts-child ast method 1))
                    prototype (ts-child ast method 0)]
                (if (and (or (= name "hasOwnProperty") (= name "propertyIsEnumerable"))
                         (and (= (ts-kind ast prototype) TSK-PROPERTY-ACCESS)
                              (and (= (ts-text ast (ts-child ast prototype 1)) "prototype")
                                   (= (fe-resolution-symbol frontend (ts-child ast prototype 0))
                                      FE-INTRINSIC-OBJECT))))
                    name ""))
              ""))
        "")))

(defn fng-object-prototype-borrowed? [(context FngContext) (node i64)] (-> bool)
  (> (str-len (fng-object-prototype-borrowed-name context node)) 0))

(defn fng-object-prototype-borrowed [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        receiver (n-box! (if (> (ts-child-count ast node) 1)
                            (fng-expression context (ts-child ast node 1))
                            (fng-undefined)))
        key (n-box! (if (> (ts-child-count ast node) 2)
                       (fng-expression context (ts-child ast node 2))
                       (fng-undefined)))]
    (fng-jsl-call2 context
      (if (= (fng-object-prototype-borrowed-name context node) "hasOwnProperty")
          "HasOwnProperty" "PropertyIsEnumerable")
      receiver key)))

(defn fng-object-prototype-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)
        receiver (n-box! (fng-expression context (ts-child ast callee 0)))
        key (n-box! (if (> (ts-child-count ast node) 1)
                       (fng-expression context (ts-child ast node 1))
                       (fng-undefined)))]
    (fng-jsl-call2 context
      (let [name (fng-object-prototype-call-name context node)]
        (cond (= name "hasOwnProperty") "HasOwnProperty"
              (= name "propertyIsEnumerable") "PropertyIsEnumerable"
              :else "IsPrototypeOf"))
      receiver key)))

(defn fng-object-method-value? [(context FngContext) (node i64)] (-> bool)
  (let [name (fng-object-static-direct-name context node)]
    (or (= name "defineProperty")
        (or (= name "defineProperties")
            (or (= name "getOwnPropertyDescriptor")
                (or (= name "getOwnPropertyNames")
                    (or (= name "create")
                        (or (= name "isExtensible")
                            (or (= name "preventExtensions") (= name "freeze"))))))))))

(defn fng-object-method-value [(context FngContext) (node i64)] (-> i64)
  (let [name (fng-object-static-direct-name context node)
        kind (cond (= name "defineProperty") 32
                   (= name "defineProperties") 33
                   (= name "getOwnPropertyDescriptor") 34
                   (= name "getOwnPropertyNames") 35
                   (= name "create") 36
                   (= name "isExtensible") 37
                   (= name "preventExtensions") 38
                   :else 39)
        length (cond (= name "defineProperty") 3
                     (= name "defineProperties") 2
                     (= name "getOwnPropertyDescriptor") 2
                     (= name "create") 2
                     :else 1)]
    (fng-jsl-call2 context "BuiltinMethodValue" (fng-const kind) (fng-const length))))

(defn fng-object-integrity-call? [(context FngContext) (node i64)] (-> bool)
  (let [name (fng-object-static-name context node)]
    (or (= name "isExtensible") (= name "preventExtensions"))))

(defn fng-object-integrity-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        name (fng-object-static-name context node)
        value (n-box! (if (> (ts-child-count ast node) 1)
                          (fng-expression context (ts-child ast node 1))
                          (fng-undefined)))]
    (if (= name "isExtensible")
        (fng-jsl-call1 context "ObjectIsExtensibleValue" value)
        (fng-jsl-call1 context "ObjectPreventExtensionsValue" value))))

(defn fng-object-freeze? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-child-count ast node) 2)
         (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
              (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-OBJECT)
                   (= (ts-text ast (ts-child ast callee 1)) "freeze"))))))

(defn fng-object-freeze [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (fng-jsl-call1 context "ObjectFreeze"
                   (n-box! (fng-expression context (ts-child ast node 1))))))

(defn fng-number-to-string? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (ts-text ast (ts-child ast callee 1)) "toString")
              (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-NUMBER)))))

(defn fng-number-to-string [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        value (fng-expression context (ts-child ast callee 0))
        radix
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (fng-const 10))]
    (fng-jsl-call2 context "NumberToStringValue" value radix)))

;; `Number.prototype.toFixed`, out of `NumberToFixed` in lib/number/predicates.jsl and the
;; `%ToFixed` primitive underneath it -- correctly-rounded fixed-point formatting is a runtime
;; capability the DSL cannot spell, which is exactly what a `%` primitive is for. Both the
;; receiver and the digit count cross the seam TAGGED: the definition asks ToNumber of one and
;; ToIntegerOrInfinity of the other, and both of those read tagged words.
(defn fng-number-to-fixed? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (ts-text ast (ts-child ast callee 1)) "toFixed")
              (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-NUMBER)))))

(defn fng-number-to-fixed [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        value (fng-expression context (ts-child ast callee 0))
        digits
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (fng-const 0))]
    (fng-jsl-call2 context "NumberToFixed" (n-box! value) (n-box! digits))))

(defn fng-string-from-char-code [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        count (ts-child-count ast node)
        (mut index) 1
        (mut result) (n-string-const! (jss-from-utf8! ""))]
    (loop (if (>= (load index) count)
              (break)
              (do
                (set! result
                      (fng-jsl-call2 context "StringConcat"
                                    (load result)
                                    (fng-jsl-call1 context "StringFromCharCode"
                                                   (fng-expression context
                                                     (ts-child ast node (load index))))))
                (set! index (+ (load index) 1)))))
    (load result)))

;; Every `String.prototype` method the frontend accepts, with the argument counts each one supports.
;;
;; THIS LIST IS WHAT MAKES A DEFINITION REACHABLE, and for most of this project's history it was
;; nine names long while `lib/string/` held twenty-one definitions. Twelve complete, spec-annotated,
;; Node-verified definitions could not be called by any program, because a name absent here never
;; reaches a lowering at all — `fng-expression` reports the receiver as an unsupported expression
;; and the compile stops. Passing the JSL gates says nothing about that; only
;; `tools/native-source-conformance.sh` does.
;;
;; THE ARITY IS PART OF THE ENTRY, not a detail. A silently ignored argument is a wrong answer, and
;; a name this function rejects is a clear frontend diagnostic. The search methods accept their
;; optional position because the boxed value now reaches the DSL rather than being dropped. The
;; three-argument `replaceAll` and `at` with more than one remain refused.
(defn fng-string-builtin-arity? [(name (slice u8)) (argc i64)] (-> bool)
  (cond (= name "charAt")      (<= argc 1)
        (= name "charCodeAt")  (<= argc 1)
        (= name "codePointAt") (= argc 1)
        (= name "substring")   (<= argc 2)
        (= name "substr")      (<= argc 2)
        (= name "slice")       (<= argc 2)
        (= name "split")       (<= argc 1)
        (= name "indexOf")     (<= argc 2)
        (= name "toLowerCase") (= argc 0)
        (= name "toUpperCase") (= argc 0)
        ;; Added with the reachability pass. Everything below already had a definition.
        (= name "startsWith")  (<= argc 2)
        (= name "endsWith")    (<= argc 2)
        (= name "includes")    (<= argc 2)
        (= name "lastIndexOf") (<= argc 2)
        (= name "padStart")    (<= argc 2)
        (= name "padEnd")      (<= argc 2)
        (= name "repeat")      (= argc 1)
        (= name "replaceAll")  (= argc 2)
        (= name "replace")     (= argc 2)
        (= name "trim")        (= argc 0)
        (= name "trimStart")   (= argc 0)
        (= name "trimEnd")     (= argc 0)
        (= name "at")          (= argc 1)
        (= name "localeCompare") (= argc 1)
        (= name "normalize")     (<= argc 1)
        :else false))

;; What each of those calls evaluates to, which is how the frontend types the expression around it.
;;
;; The three predicates are `FNG-DYNAMIC` rather than a boolean kind, and that is the definitions'
;; doing rather than an approximation: `StringStartsWith` and its two neighbours end in `%Box`, so
;; the value is a TAGGED boolean. `FNG-BOOLEAN` here means the raw machine word `GlobalIsNaN`
;; returns, and claiming it for a tagged one would have the consumer read a tag as a truth value.
;; `at` is dynamic for a different reason — out of range it is `undefined`, not a string.
(defn fng-string-builtin-result [(name (slice u8))] (-> i64)
  (cond (= name "charCodeAt")  FNG-NUMBER
        (= name "codePointAt") FNG-DYNAMIC
        (= name "indexOf")     FNG-NUMBER
        (= name "lastIndexOf") FNG-NUMBER
        (= name "localeCompare") FNG-NUMBER
        (= name "split")       FNG-ARRAY
        (= name "startsWith")  FNG-DYNAMIC
        (= name "endsWith")    FNG-DYNAMIC
        (= name "includes")    FNG-DYNAMIC
        (= name "at")          FNG-DYNAMIC
        :else FNG-STRING))

(defn fng-string-builtin? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        name (fng-string-builtin-name context node)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (fng-string-builtin-arity? name (- (ts-child-count ast node) 1))
              (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-STRING)))))

;; Emit a call to a JSL runtime-library definition.
;;
;; THE SEAM IS REPRESENTATION, and it is narrower than "everything is NaN-boxed". A JSL `dyn`
;; parameter holds whatever the value's representation already is: a string literal inside a `.jsl`
;; file lowers to `n-string-const!`, a raw pointer, and `%StringIndexOf` reads it as one. So a string
;; the frontend already has is passed straight through, and boxing it here would hand the library a
;; tagged word where it expects a pointer. Definitions whose parameters are declared `int` take raw
;; machine integers for the same reason. Only a definition returning `dyn` needs unboxing at this
;; boundary, and none of the ones called here do.
;;
;; THE BODY IS INLINED, NOT CALLED, and that is a measured decision rather than a preference. Going
;; through `jsl-call!` made `benchmarks/typescript-aot/math-loop.ts` 1.55x slower — 48.9ms to
;; 75.9ms — because every `Math.abs` became a function call where it had been an inline node, and
;; there is no inliner downstream to give that back. `jsl-inline!` expands the body into this graph
;; with these argument nodes bound to the parameters, so the library costs what the hand-written
;; node cost. It is the same split Torque draws between an inlined `macro` and a called `builtin`,
;; except the caller chooses: the frontend is emitting the operation, not invoking it.
;;
;; The control cell is passed through because a body containing an `if` ends on its merge, and
;; everything the frontend sequences afterwards belongs there.
;; THE CALLER'S STATE THAT A CALLBACK CAN REACH BUT `.jsl` CANNOT NAME: every declared field
;; alias, every dynamic alias, and the captured-cell alias -- minus the JavaScript property heap,
;; which the definition threads itself.
;;
;; THE EXCLUSION IS THE WHOLE POINT. `jl-call-mem` merges this with the definition's own
;; `jl-mem`, so including the property heap here as well would put TWO states on ONE alias inside
;; a single `MemMerge` -- ambiguous by construction: `fng-alias-leaf` takes whichever it finds
;; first, and selection refused `[1, 2, 3].flatMap(x => x)` outright with MSEL-UNSUPPORTED on the
;; result array's `ArrayMark`. Aliases are deduplicated for the same reason -- a field alias and a
;; dynamic alias can be the same alias.
(defn fng-callback-outer-memory [(context FngContext)] (-> i64)
  (let [(mut active) (al-new [i64] (malloc-allocator))
        (mut aliases) (al-new [i64] (malloc-allocator))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (fng-active-memory! context (mut active))
    (loop (if (>= (load i) (al-len [i64] (load active)))
              (break)
              (let [field-index (al-get [i64] (load active) (load i))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (if (and (!= alias JS-PROPERTY-ALIAS) (not (fng-list-has (mut aliases) alias)))
                    (al-push! [i64] (mut aliases) alias)
                    0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [i64] (load (field context dynamic-aliases))))
              (break)
              (let [alias (al-get [i64] (load (field context dynamic-aliases)) (load i))]
                (if (and (!= alias JS-PROPERTY-ALIAS) (not (fng-list-has (mut aliases) alias)))
                    (al-push! [i64] (mut aliases) alias)
                    0)
                (set! i (+ (load i) 1)))))
    (if (and (!= (.cell-shape context) SHAPE-ROOT)
             (and (!= (.cell-alias context) JS-PROPERTY-ALIAS)
                  (not (fng-list-has (mut aliases) (.cell-alias context)))))
        (al-push! [i64] (mut aliases) (.cell-alias context))
        0)
    (set! i 0)
    (loop (if (>= (load i) (al-len [i64] (load aliases)))
              (break)
              (do (al-push! [i64] (mut memories)
                            (fng-current-memory context (al-get [i64] (load aliases) (load i))))
                  (set! i (+ (load i) 1)))))
    (let [answer (if (> (al-len [i64] (load memories)) 0) (fng-merge memories) NO-NODE)]
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut aliases))
      (al-free! [i64] (mut memories))
      answer)))

(defn fng-exception-runtime [(context FngContext) (descriptor i64) (value i64)] (-> i64)
  ;; These descriptors are runtime transport, not JavaScript operations: `%Throw` in the DSL owns
  ;; the act of raising, while the frontend owns the control edges that catch or propagate it.
  (n-peephole
    (n-new3 (JsBuiltin descriptor)
            (load (load (field context ctrl)))
            value
            (fng-const 0))))

(defn fng-find-exception-target [(context FngContext)] (-> i64)
  (let [targets (load (field context targets))
        (mut index) (- (al-len [FngTarget] (load targets)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (>= (load answer) 0))
              (break)
              (let [target (al-get [FngTarget] (load targets) (load index))]
                (if (and (.active target)
                         (= (.label-node target) FNG-EXCEPTION-TARGET-LABEL))
                    (set! answer (load index))
                    0)
                (set! index (- (load index) 1)))))
    (load answer)))

(defn fng-add-exception-return! [(context FngContext) (value i64)] (-> i64)
  ;; The descriptor wrapper marks propagation-only control without changing Return's structural
  ;; arity. Return ABI inference ignores this arm; generated code still evaluates `value` (the
  ;; uncaught sink at the outer entry) before the wrapper and its unreachable machine return.
  (fng-ensure-memory! context)
  (let [ctrl (load (load (field context ctrl)))
        memory
          (if (= (load (load (field context memory))) NO-NODE)
              (fng-memory ctrl JS-PROPERTY-ALIAS)
              (load (load (field context memory))))
        marked
          (fng-exception-runtime context FNG-EXCEPTION-RETURN-DESCRIPTOR value)
        ret (n-new3 (Return) ctrl marked memory)]
    (if (.top-level context)
        (n-add-def! (g-stop) ret)
        (let [first (load (field context first-return))]
          (if (= (load first) NO-NODE)
              (do (n-fun-close! (.fun context) ret) (set! first ret))
              (n-fun-add-return! (.fun context) ret))))
    ret))

(defn fng-abrupt-exception! [(context FngContext) (dependency i64)] (-> i64)
  (let [target (fng-find-exception-target context)]
    (if (>= target 0)
        (fng-capture-target! context target FNG-JUMP-THROW dependency)
        (do
          ;; A function returns immediately with the pending flag still set; its caller checks the
          ;; flag before consuming the meaningless placeholder. The outer entry is the one place
          ;; that turns an unhandled exception into the established diagnostic and exit status.
          (fng-add-exception-return!
            context
            (if (.top-level context)
                (fng-exception-runtime context
                                       FNG-EXCEPTION-UNCAUGHT-DESCRIPTOR
                                       dependency)
                dependency))
          (set! (load (field context ctrl)) NO-NODE)
          0))))

(defn fng-check-pending-exception! [(context FngContext) (dependency i64)] (-> i64)
  (let [condition
          ;; The runtime ignores this operand, but its data edge keeps the raise/call before the
          ;; pending read and keeps an otherwise value-less `%Throw` alive through scheduling.
          (fng-exception-runtime context FNG-EXCEPTION-PENDING-DESCRIPTOR dependency)
        arms
          (n-if-arms!
            (fng-peep
              (n-new2 (If) (load (load (field context ctrl))) condition)))]
    (set! (load (field context ctrl)) (arms-t arms))
    (fng-abrupt-exception! context condition)
    (set! (load (field context ctrl)) (arms-f arms))
    0))

(defn fng-lowered-window-can-throw? [(start i64)] (-> bool)
  ;; Declaration-level can-throw is necessarily conservative. Macro guards often fold while they
  ;; lower (`number + number` removes ToPrimitive's object arm), and retaining a pending-exception
  ;; branch after the only Call/JsThrow disappeared both bloats pure arithmetic and invents runtime
  ;; externs in otherwise standalone code. Ask the lowered window instead: these are the two graph
  ;; operations that can set the pending exception transport.
  (let [(mut node) start (mut found) false]
    (set! (fng-window-calls-cell) (+ (load (fng-window-calls-cell)) 1))
    (loop (if (or (>= (load node) (n-count)) (load found))
              (break)
              (do
                (set! (fng-window-scans-cell) (+ (load (fng-window-scans-cell)) 1))
                (if (and (not (n-dead? (load node)))
                         (or (op-is? (load node) Call [_]) (op-is? (load node) JsThrow [])))
                    (set! found true)
                    0)
                (set! node (+ (load node) 1)))))
    (load found)))

(defn fng-proven-numeric-nonthrowing-call? [(name (slice u8)) (args (slice i64))] (-> bool)
  (let [arithmetic
          (or (= name "JsAdd")
              (or (= name "JsSub")
                  (or (= name "JsMul")
                      (or (= name "JsDiv")
                          (or (= name "JsMod")
                              (or (= name "JsNegate")
                                  (or (= name "ToNumberValue")
                                      (= name "ToPrimitiveNumber"))))))))
        (mut index) 0
        (mut numeric) arithmetic]
    (loop (if (or (>= (load index) (slice-len args)) (not (load numeric)))
              (break)
              (do
                (let [argument (slice-get args (load index))]
                (if (or (ty-numeric? (n-ty argument))
                        (fng-graph-proven-numeric? argument 16))
                    0
                    (set! numeric false)))
                (set! index (+ (load index) 1)))))
    (load numeric)))

(defn fng-jsl-call [(context FngContext) (name (slice u8)) (args (slice i64))] (-> i64)
  (if (!= (jsl-require-body-only! name) JSL-OK)
      (do
        (fmt (stderr) "frontend: JSL dependency failure name={s} code={d} where={s}\n"
             name (jsl-err) (jsl-where))
        (panic-corrupt "frontend: a JSL definition the frontend emits did not resolve")
        0)
      0)
  ;; A NO-NODE argument binds a JSL parameter to nothing and surfaces later as a baffling
  ;; "unbound symbol" panic deep in lowering. Refuse it here, where the callee name is known.
  (let [(mut probe) 0]
    (loop (if (>= (load probe) (slice-len args))
              (break)
              (do
                (if (= (slice-get args (load probe)) NO-NODE)
                    (do
                      (fmt (stderr) "frontend: JSL {s} argument {d} is NO-NODE owner={d}\n"
                           name (load probe) (.owner context))
                      (if (= (load probe) 0) (panic-corrupt "jsl argument 0 is NO-NODE") 0)
                      (if (= (load probe) 1) (panic-corrupt "jsl argument 1 is NO-NODE") 0)
                      (panic-corrupt "jsl argument 2+ is NO-NODE")
                      0)
                    0)
                (set! probe (+ (load probe) 1))))))
  ;; THE DECLARED PARAMETER TYPE IS A REPRESENTATION CONTRACT, and this is the one place that can
  ;; honour it. A definition writing `(start int)` means a RAW machine integer: its body does plain
  ;; integer arithmetic on it, and `%Add` with a tagged operand is a verifier error, not a coercion.
  ;; Call sites pass whatever the expression produced, and for `"abcdef".slice(-2)` that is a BOXED
  ;; -2, because unary minus reaches the DSL and comes back tagged. The graph then failed
  ;; `g-verify` with "Add slot 1 is tagged, needs raw-num" and the program did not compile at all.
  ;;
  ;; Unboxing here is representation, which is the frontend's job -- the DSL owns what the operation
  ;; MEANS and the frontend owns which machine word carries it. Fixing it at each call site instead
  ;; would be the same edit repeated per method, and the next definition with an `int` parameter
  ;; would arrive broken again.
  ;;
  ;; It fires only on a value that is actually tagged, so a raw argument -- which is nearly all of
  ;; them -- is untouched and nothing is added to fold away.
  (let [callee (jsl-find name)
        (mut k) 0]
    (loop (if (or (>= (load k) (slice-len args)) (< callee 0))
              (break)
              (do
                (if (and (< (load k) (jsl-decl-nparams callee))
                         (and (ty-int-only? (jsl-param-ty callee (load k)))
                              ;; `fng-open-loop-phi?` for the reason it documents: inside a loop the
                              ;; argument may be a counter whose back edge is not wired yet, and
                              ;; every other test here answers from the arms it can see.
                              (or (fng-value-tagged? (slice-get args (load k)))
                                  (fng-open-loop-phi? (slice-get args (load k))))))
                    ;; `BitOr(x, 0)` ON TOP, because `fng-to-number-operand` answers a raw FLOAT and
                    ;; the parameter says `int`. Both are "raw-num" to the verifier and a different
                    ;; register class to selection, so an `int` parameter handed the float read the
                    ;; double's bit pattern -- whose low 32 bits are zero for every small integer.
                    ;; `s.charCodeAt(i)` in a loop therefore read index 0 on every iteration and
                    ;; summed the first character six times. The same conversion `fng-int-value`
                    ;; puts on an index, for the same reason it puts it there.
                    (do (slice-set! args (load k)
                                    (fng-peep
                                      (n-new3 (BitOr) NO-NODE
                                              (fng-to-number-operand context (slice-get args (load k)))
                                              (fng-const 0))))
                        0)
                    0)
                (set! k (+ (load k) 1))
                0))))
  ;; The heap goes in and comes back out. A definition that does not touch it leaves the cell alone,
  ;; so this is the same code for both kinds and there is nothing to decide here.
  (let [cell (primitive/alloc-stack (array i64 1))
        mp (cast (ptr i64) cell)]
    ;; DECLARED BEFORE THE BODY IS BUILT, not after it has written. Every hand-written array path
    ;; here records the dynamic alias first, and the order is load-bearing: the nodes `jsl-inline!`
    ;; is about to emit read and write JS-PROPERTY-ALIAS, and declaring the alias afterwards leaves
    ;; them outside the set the merge machinery then treats as dynamic. Recording it for a
    ;; definition that turns out not to write is harmless — the memory cell is compared below and
    ;; an unchanged one publishes nothing.
    (if (jsl-name-uses-memory? name) (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS) 0)
    ;; A DEFINITION THAT CALLS A CALLBACK RUNS USER CODE, so it needs everything an ordinary
    ;; JavaScript call site publishes, not just the property heap. `fng-callback-outer-memory`
    ;; builds the rest -- every other active alias plus the captured-cell alias -- and
    ;; `jl-call-mem` names it on the callback `Call` itself. Without it the caller's cell and
    ;; closure-environment stores had no consumer at all, so they were deleted as dead:
    ;; `[3, 4].map(v => v + b)` then dereferenced an environment slot nothing had written.
    ;;
    ;; AT THE CALL, NOT AT THIS SEAM. Merging it into the memory handed IN looks tidier and is
    ;; worse: it becomes the entry arm of the definition's loop memory phi, and `ArrayFilter`'s
    ;; resize-before-and-after-the-loop shape then fails placement outright --
    ;; `[1, 2, 3, 4].filter(v => v > lo)`, which compiles and answers correctly today, stopped
    ;; compiling at all. Naming it on the `Call` leaves every other memory edge the shape it had.
    (let [calls-back (jsl-name-calls-back? name)
          callee (jsl-find name)]
      (set! (index mp 0) (fng-current-memory context JS-PROPERTY-ALIAS))
      (if calls-back (jl-set-outer-mem! (fng-callback-outer-memory context)) 0)
      (let [lowered-start (n-count)
            owner-entry (if (.top-level context)
                            (g-start)
                            (n-fun-entry (.fun context)))
            (mut v) NO-NODE]
        ;; Builtins already have an independent DSL body and can be shared by every source call.
        ;; Macros and callback-bearing definitions remain expansions because they deliberately bind
        ;; caller control or caller-local memory. Keeping ordinary builtins as calls avoids copying
        ;; their often loop-heavy graph once per JavaScript operation.
        (if (and (>= callee 0) (and (not (jsl-macro? callee)) (not calls-back)))
            (do
              (if (!= (jsl-require! name) JSL-OK)
                  (panic-corrupt "frontend: a called JSL builtin did not lower")
                  0)
              (let [call (jsl-call-with-memory!
                           (load (load (field context ctrl))) name args (load (index mp 0)))]
                (set! v (call-value call))
                (set! (load (field context ctrl)) (call-end call))
                (if (jsl-decl-uses-memory? callee)
                    (do
                      (set! (index mp 0)
                            (n-new1 (Arg (t-mem-alias JS-PROPERTY-ALIAS (t-undef)))
                                    (call-end call)))
                      0)
                    0)))
            (set! v (jsl-inline! (load (field context ctrl)) mp owner-entry name args)))
        (jl-set-outer-mem! NO-NODE)
        (if calls-back
            ;; The callback may have written any alias the caller can reach, so nothing recorded
            ;; before the call still describes them. Clearing the cell first is what re-anchors
            ;; them: `fng-current-memory` answers a missing alias with a fresh `Arg` at the current
            ;; control, which is the control the body ended on -- the CallEnd. THE PROPERTY HEAP IS
            ;; THE EXCEPTION and is taken from the body: `ArrayMap` builds its result array through
            ;; that chain, and re-anchoring it too would leave those stores with no consumer, which
            ;; deleted every element the map had written.
            (do (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                (set! (load (field context memory)) NO-NODE)
                (set! (load (field context memory))
                      (fng-preserve-active-memory context (load (index mp 0))))
                0)
            (if (!= (load (index mp 0)) (fng-current-memory context JS-PROPERTY-ALIAS))
                (do (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    (set! (load (field context memory))
                          (fng-preserve-active-memory context (load (index mp 0))))
                    0)
                0))
        ;; ThrowValue is used by source `throw`, whose statement lowering already knows the edge is
        ;; abrupt. Definitions that call it transitively still get the ordinary pending check.
        (if (and (!= name "ThrowValue")
                 (and (not (fng-proven-numeric-nonthrowing-call? name args))
                      (fng-lowered-window-can-throw? lowered-start)))
            (fng-check-pending-exception! context (load v))
            0)
        (load v)))))

(defn fng-jsl-call0 [(context FngContext) (name (slice u8))] (-> i64)
  (fng-jsl-call context name (slice-new [i64] (cast (ptr i64) 0) 0)))

(defn fng-jsl-call1 [(context FngContext) (name (slice u8)) (a i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1))
        p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (fng-jsl-call context name (slice-new [i64] p 1))))

(defn fng-jsl-call2 [(context FngContext) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 2))
        p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (set! (index p 1) b)
    (fng-jsl-call context name (slice-new [i64] p 2))))

(defn fng-jsl-call3 [(context FngContext) (name (slice u8)) (a i64) (b i64) (c i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 3))
        p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (set! (index p 1) b)
    (set! (index p 2) c)
    (fng-jsl-call context name (slice-new [i64] p 3))))

(defn fng-jsl-call4 [(context FngContext) (name (slice u8))
                      (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 4)) p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (set! (index p 1) b)
    (set! (index p 2) c)
    (set! (index p 3) d)
    (fng-jsl-call context name (slice-new [i64] p 4))))

(defn fng-jsl-call5 [(context FngContext) (name (slice u8))
                      (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 5)) p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (set! (index p 1) b)
    (set! (index p 2) c)
    (set! (index p 3) d)
    (set! (index p 4) e)
    (fng-jsl-call context name (slice-new [i64] p 5))))

(defn fng-jsl-call9 [(context FngContext) (name (slice u8))
                      (a i64) (b i64) (c i64) (d i64) (e i64)
                      (f i64) (g i64) (h i64) (i i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 9)) p (cast (ptr i64) buf)]
    (set! (index p 0) a) (set! (index p 1) b) (set! (index p 2) c)
    (set! (index p 3) d) (set! (index p 4) e) (set! (index p 5) f)
    (set! (index p 6) g) (set! (index p 7) h) (set! (index p 8) i)
    (fng-jsl-call context name (slice-new [i64] p 9))))

;; A string-valued argument at `child`, or the constant a missing one coerces to.
;;
;; ToString of an ABSENT argument is the string "undefined", not the undefined value, and every
;; search method here takes its needle through ToString. `"abc".indexOf()` is therefore
;; `"abc".indexOf("undefined")` and answers -1 rather than trapping on a tag. The padding methods
;; pass " " instead, which is their spec default rather than a coercion.
;; A STRING-POSITION ARGUMENT IS ToString OF WHATEVER WAS PASSED, which is what every one of these
;; methods says in the spec and what this used to skip: the expression went through untouched, so
;; `"abcdef".localeCompare(1)` handed a raw machine integer to `%StringCompare` and `[1,2,3].join(1)`
;; used one as a separator. Both answered nonsense that compiled.
;;
;; The coercion is `ToStringValue`, so the meaning stays in `lib/` -- and it costs nothing where the
;; argument is already a string, because `%IsArray` folds to false on a `str` type, the guard goes
;; with it, and selection answers `ToString` of a string with the string itself.
(defn fng-string-argument [(context FngContext) (node i64) (child i64) (fallback (slice u8))] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (> (ts-child-count ast node) child)
        (fng-jsl-call1 context "ToStringValue"
                       (fng-expression context (ts-child ast node child)))
        (n-string-const! (jss-from-utf8! fallback)))))

(defn fng-string-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        string (fng-expression context (ts-child ast callee 0))
        name (fng-string-builtin-name context node)
        argc (- (ts-child-count ast node) 1)
        needs-start
          (or (= name "charCodeAt")
              (or (= name "codePointAt")
              (or (= name "charAt")
                  (or (= name "substring")
                      (or (= name "substr") (= name "slice"))))))
        start
          (if needs-start
              (if (> argc 0)
                  (fng-expression context (ts-child ast node 1))
                  (fng-const 0))
              NO-NODE)]
    (cond
      ;; `String.prototype.split`, out of lib/string/split.jsl — the last hand-written IR node with
      ;; JavaScript semantics in it, and the one the conversion notes called the largest open item.
      ;;
      ;; What made it look blocked was the allocation: the hand-written path built its own `New`,
      ;; marked it an array and published a dynamic alias, and the library had no counterpart. It
      ;; has had one since `ArraySlice` — `%NewArray` lowers through `n-array-mark!` on a real
      ;; control anchor, and `fng-jsl-call` publishes the alias for any definition
      ;; `jsl-name-uses-memory?` reports, before the body is built rather than after.
      ;;
      ;; TWO DEFINITIONS, CHOSEN BY ARGUMENT COUNT. `"abc".split()` is `["abc"]` and `"abc".split("")`
      ;; is `["a","b","c"]`, and no separator VALUE distinguishes them, so the choice has to be made
      ;; where the syntax is. Passing the count in as an argument instead compiles for every case
      ;; but that one, where the literal 0 folds the library's mode arithmetic during construction
      ;; and leaves a Region and its Phi disagreeing.
      (= name "split")
        (if (> argc 0)
            (fng-jsl-call2 context "StringSplit" string
                           (fng-expression context (ts-child ast node 1)))
            (fng-jsl-call1 context "StringSplitWhole" string))
      (= name "toLowerCase") (fng-jsl-call1 context "StringToLowerCase" string)
      (= name "toUpperCase") (fng-jsl-call1 context "StringToUpperCase" string)
      (= name "trim")        (fng-jsl-call1 context "StringTrim" string)
      (= name "trimStart")   (fng-jsl-call1 context "StringTrimStart" string)
      (= name "trimEnd")     (fng-jsl-call1 context "StringTrimEnd" string)
      (= name "indexOf")
        ;; Steps 5-7 of String.prototype.indexOf, from lib/string/index-of.jsl rather than a
        ;; hand-written IR node. The receiver is known to be a string here (the
        ;; `fng-string-builtin?` guard proves it), so ToString on it is the identity and the
        ;; coerced core is the right entry point; the missing-argument case keeps the frontend's
        ;; existing `"undefined"` string, which is what ToString of an absent argument produces.
        (fng-jsl-call3 context "StringIndexOfFrom" string
                       (fng-string-argument context node 1 "undefined")
                       (n-box! (if (> argc 1)
                                   (fng-expression context (ts-child ast node 2))
                                   (fng-const 0))))
      ;; The three search predicates are string search plus comparisons in the library, which is
      ;; why none needs a new primitive. Their boxed positions are converted and bounded there;
      ;; `endsWith` also computes the candidate start from its end position. All three return a
      ;; BOXED boolean, so the result is `FNG-DYNAMIC` and reaches truthiness the ordinary way.
      (= name "startsWith")
        (fng-jsl-call3 context "StringStartsWith" string
                       (fng-string-argument context node 1 "undefined")
                       (n-box! (if (> argc 1)
                                   (fng-expression context (ts-child ast node 2))
                                   (fng-undefined))))
      (= name "endsWith")
        (fng-jsl-call3 context "StringEndsWith" string
                       (fng-string-argument context node 1 "undefined")
                       (n-box! (if (> argc 1)
                                   (fng-expression context (ts-child ast node 2))
                                   (fng-undefined))))
      (= name "includes")
        (fng-jsl-call3 context "StringIncludesFrom" string
                       (fng-string-argument context node 1 "undefined")
                       (n-box! (if (> argc 1)
                                   (fng-expression context (ts-child ast node 2))
                                   (fng-const 0))))
      ;; `StringLastIndexOf` scans forward keeping the last hit up to the DSL's converted position,
      ;; because the primitive only searches forward. Omitted and explicit values follow the same
      ;; boxed-value boundary as the other search methods.
      (= name "lastIndexOf")
        (fng-jsl-call3 context "StringLastIndexOf" string
                       (fng-string-argument context node 1 "undefined")
                       (n-box! (if (> argc 1)
                                   (fng-expression context (ts-child ast node 2))
                                   (fng-undefined))))
      ;; The padding pair. The filler defaults to a single space, which is the spec's default and
      ;; the reason the second argument is optional at all.
      (= name "padStart")
        (fng-jsl-call3 context "StringPadStart" string
                       (if (> argc 0) (fng-expression context (ts-child ast node 1)) (fng-const 0))
                       (fng-string-argument context node 2 " "))
      (= name "padEnd")
        (fng-jsl-call3 context "StringPadEnd" string
                       (if (> argc 0) (fng-expression context (ts-child ast node 1)) (fng-const 0))
                       (fng-string-argument context node 2 " "))
      (= name "repeat")
        (fng-jsl-call2 context "StringRepeatCount" string
                       (fng-expression context (ts-child ast node 1)))
      (= name "replaceAll")
        (fng-jsl-call3 context "StringReplaceAll" string
                       (fng-string-argument context node 1 "undefined")
                       (fng-string-argument context node 2 "undefined"))
      (= name "replace")
        (fng-jsl-call3 context "StringReplaceFirst" string
                       (fng-string-argument context node 1 "undefined")
                       (fng-string-argument context node 2 "undefined"))
      (= name "localeCompare")
        (fng-jsl-call2 context "StringLocaleCompare" string
                       (fng-string-argument context node 1 "undefined"))
      (= name "normalize")
        (fng-jsl-call2 context "StringNormalize" string
                       (fng-string-argument context node 1 "NFC"))
      ;; `at` takes its index as a `dyn`, unlike `charAt`: `RelativeIndex` runs `%ToInteger` on it,
      ;; which reads a TAGGED word. Boxing here is what the seam requires, and passing the raw
      ;; machine integer `charAt` passes would hand `%ToInteger` a bit pattern nothing tagged.
      (= name "at")
        (fng-jsl-call2 context "StringAt" string
                       (n-box! (fng-expression context (ts-child ast node 1))))
      (= name "charCodeAt") (fng-jsl-call2 context "StringCharCodeAt" string start)
      (= name "codePointAt") (fng-jsl-call2 context "StringCodePointAt" string start)
      (= name "charAt")     (fng-jsl-call2 context "StringCharAt" string start)
      ;; Every remaining extractor comes from lib/string/, which does its own bounds and
      ;; negative-index handling — the work the C runtime used to do behind these IR nodes. The
      ;; three are separate definitions rather than one clamped helper because they genuinely
      ;; differ: substr's second argument is a COUNT, and substring SWAPS out-of-order arguments
      ;; where slice yields the empty string.
      :else
        (let [jsl-name (cond (= name "substring") "StringSubstring"
                             (= name "substr") "StringSubstr"
                             :else "StringSlice")
              ;; The distinction between an absent/undefined substr count and every value that
              ;; ToInteger turns into zero is JavaScript meaning owned by StringSubstr. The
              ;; frontend supplies the actual value and only boxes it to match that DSL boundary.
              end (if (= name "substr")
                      (n-box! (if (> argc 1)
                                  (fng-expression context (ts-child ast node 2))
                                  (fng-undefined)))
                      (if (> argc 1)
                          (fng-expression context (ts-child ast node 2))
                          (fng-jsl-call1 context "StringLength" string)))]
          (fng-jsl-call3 context jsl-name string start end)))))

;; `Array.prototype.push`, out of `ArrayPush1` in lib/array/build.jsl.
;;
;; THE LOOP IS OVER THE ARGUMENT SYNTAX, not over runtime values, so it stays here. JSL has no
;; variadic signature and inventing one would buy nothing: the argument count is a property of the
;; call site, so a variadic definition would have to be unrolled per call site anyway, and this is
;; that unrolling written where the syntax is.
;;
;; The value is BOXED. Array elements are stored boxed, `%ArrayStore` writes the word it is given,
;; and the read paths (`ArrayIndexOfFrom` and friends) compare boxed words.
(defn fng-array-push [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        (mut index) 1
        (mut result) NO-NODE]
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [value (fng-expression context (ts-child ast node (load index)))]
                (set! result (fng-jsl-call2 context "ArrayPush1" array (n-box! value)))
                (set! index (+ (load index) 1)))))
    ;; `a.push()` writes nothing and answers the length. It needs its own definition rather than
    ;; falling out of the loop, because with no argument the loop's result never exists.
    (if (= (load result) NO-NODE)
        (fng-jsl-call1 context "ArrayLength" array)
        (load result))))

;; `Array.prototype.pop` and `shift`, out of `ArrayPop` and `ArrayShift` in lib/array/build.jsl.
;;
;; Both were hand-written IR here, and both carried the empty-array case WRONG: `pop` on a length-0
;; array resized to -1 and `shift` clamped the new length at 0 while still returning whatever the
;; load of index 0 found. The library definitions have the spec's step-3 guard instead, so the
;; empty case is `undefined` and the length does not move.
(defn fng-array-pop [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))]
    (fng-jsl-call1 context "ArrayPop" array)))

(defn fng-array-shift [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))]
    (fng-jsl-call1 context "ArrayShift" array)))

(defn fng-array-unshift [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0) array (fng-expression context (ts-child ast callee 0))
        (mut values) (al-new [i64] (malloc-allocator)) (mut i) 1 (mut result) NO-NODE]
    ;; Evaluate arguments left-to-right, then apply the one-element definition right-to-left.
    (loop (if (>= (load i) (ts-child-count ast node)) (break)
            (do (al-push! [i64] (mut values)
                          (n-box! (fng-expression context (ts-child ast node (load i)))))
                (set! i (+ (load i) 1)))))
    (set! i (al-len [i64] (load values)))
    (loop (if (<= (load i) 0) (break)
            (do (set! i (- (load i) 1))
                (set! result
                      (fng-jsl-call2 context "ArrayUnshift1" array
                                      (al-get [i64] (load values) (load i)))))))
    (al-free! [i64] (mut values))
    (if (= (load result) NO-NODE) (fng-jsl-call1 context "ArrayLength" array) (load result))))

(defn fng-array-fill [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)
        borrowed (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                      (= (ts-text ast (ts-child ast callee 1)) "call"))
        argument-base (if borrowed 2 1)
        argc (- (ts-child-count ast node) (if borrowed 2 1))
        array (n-box! (fng-expression context
                                      (if borrowed (ts-child ast node 1)
                                          (ts-child ast callee 0))))
        value (if (> argc 0)
                  (n-box! (fng-expression context (ts-child ast node argument-base)))
                  (n-box! (fng-undefined)))
        start (n-box! (if (> argc 1)
                          (fng-expression context (ts-child ast node (+ argument-base 1)))
                          (fng-const 0)))
        end (n-box! (if (> argc 2)
                        (fng-expression context (ts-child ast node (+ argument-base 2)))
                        (fng-undefined)))]
    (fng-jsl-call5 context "ArrayFill" array value start end
                   (fng-const (if (> argc 2) 1 0)))))

(defn fng-array-splice [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0) array (fng-expression context (ts-child ast callee 0))
        argc (- (ts-child-count ast node) 1)
        raw-start (if (> argc 0) (fng-expression context (ts-child ast node 1)) (fng-const 0))
        raw-delete (if (> argc 1) (fng-expression context (ts-child ast node 2))
                       (if (= argc 0) (fng-const 0) (fng-const -1)))
        (mut values) (al-new [i64] (malloc-allocator)) (mut i) 3]
    ;; All syntax arguments are evaluated before splice performs its first observable mutation.
    (loop (if (>= (load i) (ts-child-count ast node)) (break)
            (do (al-push! [i64] (mut values)
                          (n-box! (fng-expression context (ts-child ast node (load i)))))
                (set! i (+ (load i) 1)))))
    (let [start (fng-jsl-call2 context "ArraySpliceStart" array raw-start)
          deleted (fng-jsl-call3 context "ArraySpliceDelete" array start raw-delete)
          (mut inserted) 0]
      (loop (if (>= (load inserted) (al-len [i64] (load values))) (break)
              (do (fng-jsl-call4 context "ArraySpliceInsert1" array start
                                 (fng-const (load inserted))
                                 (al-get [i64] (load values) (load inserted)))
                  (set! inserted (+ (load inserted) 1)))))
      (al-free! [i64] (mut values))
      deleted)))

(defn fng-array-concat [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0) receiver (fng-expression context (ts-child ast callee 0))
        (mut values) (al-new [i64] (malloc-allocator)) (mut i) 1]
    (loop (if (>= (load i) (ts-child-count ast node)) (break)
            (do (al-push! [i64] (mut values)
                          (n-box! (fng-expression context (ts-child ast node (load i)))))
                (set! i (+ (load i) 1)))))
    (let [out (fng-jsl-call0 context "NewArray")]
      (fng-jsl-call2 context "ArrayConcatValue" out (n-box! receiver))
      (set! i 0)
      (loop (if (>= (load i) (al-len [i64] (load values))) (break)
              (do (fng-jsl-call2 context "ArrayConcatValue" out
                                 (al-get [i64] (load values) (load i)))
                  (set! i (+ (load i) 1)))))
      (al-free! [i64] (mut values))
      out)))

(defn fng-array-flat [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast)
        callee (ts-child ast node 0)
        borrowed (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                      (= (ts-text ast (ts-child ast callee 1)) "call"))
        argument-base (if borrowed 2 1)
        array (n-box! (fng-expression context
                                      (if borrowed (ts-child ast node 1)
                                          (ts-child ast callee 0))))
        depth (n-box! (if (> (ts-child-count ast node) argument-base)
                          (fng-expression context (ts-child ast node argument-base))
                          (fng-const 1)))]
    (fng-jsl-call2 context "ArrayFlat" array depth)))

;; `Array.prototype.slice`, out of `ArraySlice` in lib/array/build.jsl.
;;
;; The BOUNDS moved with the operation. They were `fng-slice-bound` here, a third implementation of
;; the negative-index rule that `StringSlice` and `RelativeIndex` already had; the library uses the
;; same `Clamp` the string family does, so there is one spelling of "a negative index counts from
;; the end" rather than three that no test compares.
;;
;; A MISSING `end` IS THE LENGTH, and the frontend has to supply it because JSL has no optional
;; parameter. `ArrayLength` is the definition that answers it, so even the default goes through the
;; library.
(defn fng-array-slice [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        raw-start
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (fng-const 0))
        raw-end
          (if (> (ts-child-count ast node) 2)
              (fng-expression context (ts-child ast node 2))
              (fng-jsl-call1 context "ArrayLength" array))]
    (fng-jsl-call3 context "ArraySlice" array raw-start raw-end)))

(defn fng-callback-value [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        symbol (fe-resolution-symbol frontend node)
        index (fng-function-index frontend symbol)]
    ;; `fng-capture-count` takes a function ID, not its position in `.functions`. Those happen to
    ;; coincide for many small programs, but diverge as soon as nested declarations are indexed.
    ;; Passing `index` misclassified a capturing Test262 assertion closure as capture-free and
    ;; substituted an unrelated bare function, so `typeof func` became non-callable at runtime.
    (if (and (>= index 0) (= (fng-capture-count frontend symbol) 0))
        (al-get [i64] (load (load (field context functions))) index)
        (fng-expression context node))))

(defn fng-array-callback-function? [(frontend (ptr NativeFrontend)) (node i64) (fun-id i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut found) false
        (mut index) 0]
    (if (and (= kind TSK-CALL) (> (ts-child-count ast node) 1))
        (let [callee (ts-child ast node 0)]
          (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
                   (let [name (ts-text ast (ts-child ast callee 1))]
                     (and (or (= name "map")
                              (or (= name "filter")
                                  (or (= name "reduce") (= name "reduceRight"))))
                          (= (fe-resolution-symbol frontend (ts-child ast node 1)) fun-id))))
              (set! found true) 0)) 0)
    (loop (if (or (load found) (>= (load index) (ts-child-count ast node)))
              (break)
              (do (set! found
                        (fng-array-callback-function? frontend
                                                      (ts-child ast node (load index)) fun-id))
                  (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-array-callback-call [(context FngContext) (node i64) (name (slice u8))] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        ;; `Array.prototype.forEach.call(arrayLike, callback)` is recognized as the same semantic
        ;; operation as `array.forEach(callback)`, but its receiver and callback are explicit call
        ;; arguments rather than the base and first argument of the outer call. The previous
        ;; indexing passed the built-in function identity as `src` and the array-like object as the
        ;; callback, so the DSL correctly attempted to call an object and hit the dispatch trap.
        borrowed
          (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
               (= (ts-text ast (ts-child ast callee 1)) "call"))
        source-node (if borrowed (ts-child ast node 1) (ts-child ast callee 0))
        literal (= (ts-kind ast source-node) TSK-ARRAY-LITERAL)
        literal-count (if literal (ts-child-count ast source-node) 0)
        callback-node (ts-child ast node (if borrowed 2 1))
        callback-symbol (fe-resolution-symbol frontend callback-node)
        callback-index (fng-function-index frontend callback-symbol)
        callback-parameters
          (if (>= callback-index 0)
              (.parameter-count (index (load (field (field frontend functions) data)) callback-index))
              99)
        value-specialized
          (and literal
               (or (and (= literal-count 8)
                        (and (= name "filter") (< callback-parameters 3)))
                   (and (= name "reduce") (< callback-parameters 4))))
        (mut literal-values) (al-new [i64] (malloc-allocator))
        array (if value-specialized NO-NODE (fng-expression context source-node))
        callback (fng-callback-value context callback-node)]
    ;; Preserve array-literal evaluation order even when the allocation itself is proven
    ;; unobservable to this closed callback signature.
    (if value-specialized
        (let [(mut value-index) 0]
          (loop (if (>= (load value-index) literal-count)
                    (break)
                    (do (al-push! [i64] (mut literal-values)
                                  (n-box! (fng-expression context
                                                         (ts-child ast source-node
                                                                   (load value-index)))))
                        (set! value-index (+ (load value-index) 1)))))) 0)
    (let [answer
    (cond (and literal (= name "map"))
            (let [(mut out) (fng-jsl-call0 context "NewArray")
                  (mut index) 0]
              (loop (if (>= (load index) literal-count)
                        (break)
                        (do (store! out (fng-jsl-call4 context "ArrayMapAt" array callback
                                                       (load out) (fng-const (load index))))
                            (store! index (+ (load index) 1)))))
              (load out))
          (and value-specialized (= name "filter"))
            (fng-jsl-call9 context "ArrayFilterLiteral8" callback
                           (al-get [i64] (load literal-values) 0)
                           (al-get [i64] (load literal-values) 1)
                           (al-get [i64] (load literal-values) 2)
                           (al-get [i64] (load literal-values) 3)
                           (al-get [i64] (load literal-values) 4)
                           (al-get [i64] (load literal-values) 5)
                           (al-get [i64] (load literal-values) 6)
                           (al-get [i64] (load literal-values) 7))
          (and value-specialized (= name "reduce") (> (ts-child-count ast node) 2))
            (let [(mut accumulator)
                    (n-box! (fng-expression context (ts-child ast node 2)))
                  (mut index) 0]
              (loop (if (>= (load index) literal-count)
                        (break)
                        (do (store! accumulator
                                    (fng-jsl-call4 context "ArrayReduceValueAt"
                                                   (al-get [i64] (load literal-values) (load index))
                                                   callback
                                                   (load accumulator) (fng-const (load index))))
                            (store! index (+ (load index) 1)))))
              (load accumulator))
          (= name "map") (fng-jsl-call2 context "ArrayMap" array callback)
          (= name "filter") (fng-jsl-call2 context "ArrayFilter" array callback)
          (= name "forEach") (fng-jsl-call2 context "ArrayForEach" array callback)
          (= name "find") (fng-jsl-call2 context "ArrayFind" array callback)
          (= name "findIndex") (fng-jsl-call2 context "ArrayFindIndex" array callback)
          (= name "some") (fng-jsl-call2 context "ArraySome" array callback)
          (= name "every") (fng-jsl-call2 context "ArrayEvery" array callback)
          (= name "flatMap") (fng-jsl-call2 context "ArrayFlatMap" array callback)
          (= name "reduce")
            (if (> (ts-child-count ast node) 2)
                (fng-jsl-call3 context "ArrayReduceInitial" array callback
                               (n-box! (fng-expression context (ts-child ast node 2))))
                (fng-jsl-call2 context "ArrayReduce" array callback))
          :else
            (if (> (ts-child-count ast node) 2)
                (fng-jsl-call3 context "ArrayReduceRightInitial" array callback
                               (n-box! (fng-expression context (ts-child ast node 2))))
                (fng-jsl-call2 context "ArrayReduceRight" array callback)))]
      (al-free! [i64] (mut literal-values))
      answer)))

(defn fng-array-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        name (fng-array-builtin-name context node)]
    (cond (= name "push") (fng-array-push context node)
          (= name "pop") (fng-array-pop context node)
          (= name "shift") (fng-array-shift context node)
          (= name "unshift") (fng-array-unshift context node)
          (= name "fill") (fng-array-fill context node)
          (= name "splice") (fng-array-splice context node)
          (= name "concat") (fng-array-concat context node)
          (= name "flat") (fng-array-flat context node)
          (= name "reverse")
            (let [callee (ts-child ast node 0)
                  array (fng-expression context (ts-child ast callee 0))]
              (fng-jsl-call1 context "ArrayReverse" array))
          (or (= name "keys") (or (= name "values") (= name "entries")))
            (let [callee (ts-child ast node 0)
                  array (fng-expression context (ts-child ast callee 0))]
              (cond (= name "keys") (fng-jsl-call1 context "ArrayKeys" array)
                    (= name "values") (fng-jsl-call1 context "ArrayValues" array)
                    :else (fng-jsl-call1 context "ArrayEntries" array)))
          (= name "indexOf") (fng-array-search context node name)
          (= name "includes") (fng-array-search context node name)
          (= name "lastIndexOf") (fng-array-search context node name)
          (= name "at") (fng-array-at context node)
          (= name "join") (fng-array-join context node)
          (or (= name "map")
              (or (= name "filter")
                  (or (= name "forEach")
                      (or (= name "reduce")
                          (or (= name "reduceRight")
                              (or (= name "find")
                                  (or (= name "findIndex")
                                      (or (= name "some")
                                          (or (= name "every")
                                              (= name "flatMap"))))))))))
            (fng-array-callback-call context node name)
          (= name "sort")
            (let [callee (ts-child ast node 0)
                  array (fng-expression context (ts-child ast callee 0))]
              (if (> (ts-child-count ast node) 1)
                  (fng-jsl-call2 context "ArraySort" array
                                 (fng-callback-value context (ts-child ast node 1)))
                  (fng-jsl-call1 context "ArraySortDefault" array)))
          :else (fng-array-slice context node))))

(defn fng-owner-constructor [(frontend (ptr NativeFrontend)) (owner i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) owner]
    (loop (if (or (>= (load index)
                      (al-len [FePrototypeMethod] (.prototype-methods frontend)))
                  (!= (load answer) owner))
              (break)
              (let [method (al-get [FePrototypeMethod]
                                   (.prototype-methods frontend)
                                   (load index))]
                (if (= (.target method) owner)
                    (set! answer (.constructor method))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-widest-function-target [(frontend (ptr NativeFrontend)) (targets i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1
        (mut widest) -1]
    (loop (if (>= (load index) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load index))) 0)
                    (let [source-target (- (load index) 1)
                          function-index (fng-function-index frontend source-target)]
                      (if (>= function-index 0)
                          (let [fn (al-get [FeFunction]
                                           (.functions frontend)
                                           function-index)
                                count (.parameter-count fn)]
                            (if (> count (load widest))
                                (do (set! answer source-target) (set! widest count))
                                0))
                          0))
                    0)
                (set! index (+ (load index) 1)))))
    (load answer)))

(defn fng-constructor-method [(frontend (ptr NativeFrontend))
                              (constructor i64)
                              (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut current) constructor
        (mut answer) -1
        (mut fuel) 64]
    (loop (if (or (< (load current) 0)
                  (or (<= (load fuel) 0) (>= (load answer) 0)))
              (break)
              (let [(mut index) 0]
                (loop (if (or (>= (load index)
                                  (al-len [FePrototypeMethod]
                                          (.prototype-methods frontend)))
                              (>= (load answer) 0))
                          (break)
                          (let [method (al-get [FePrototypeMethod]
                                               (.prototype-methods frontend)
                                               (load index))]
                            (if (and (= (.constructor method) (load current))
                                     (= name (ts-text ast (.name-node method))))
                                (set! answer (.target method))
                                0)
                            (set! index (+ (load index) 1)))))
                (if (< (load answer) 0)
                    (set! current (fng-prototype-parent frontend (load current)))
                    0)
                (set! fuel (- (load fuel) 1)))))
    (load answer)))

; Resolve closed-world assignments such as Strength.stronger = function (...) {...}.
; -1 means unseen and -2 means the property is reassigned to conflicting targets.
(defn fng-static-method-scan [(frontend (ptr NativeFrontend))
                              (node i64)
                              (receiver-symbol i64)
                              (name (slice u8))] (-> i64)
  (let [ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-BINARY)
             (= (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS))
        (let [left (ts-child ast node 0)
              base (ts-child ast left 0)
              value (ts-child ast node 2)]
          (if (and (= (fe-resolution-symbol frontend base) receiver-symbol)
                   (= (ts-text ast (ts-child ast left 1)) name))
              (if (fe-function-expression-kind? (ts-kind ast value))
                  (let [function-index (fe-function-for-node frontend value)]
                    (if (>= function-index 0)
                        (.id (index (load (field (field frontend functions) data)) function-index))
                        -2))
                  -2)
              -1))
        (let [(mut index) 0
              (mut answer) -1]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (= (load answer) -2))
                    (break)
                    (let [found (fng-static-method-scan frontend
                                                        (ts-child ast node (load index))
                                                        receiver-symbol
                                                        name)]
                      (if (>= found 0)
                          (if (or (= (load answer) -1) (= (load answer) found))
                              (set! answer found)
                              (set! answer -2))
                          (if (= found -2) (set! answer -2) 0))
                      (set! index (+ (load index) 1)))))
          (load answer)))))

(defn fng-static-owner-scan [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> i64)
  (let [ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-BINARY)
             (= (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS)
             (fe-function-expression-kind? (ts-kind ast (ts-child ast node 2))))
        (let [function-index (fe-function-for-node frontend (ts-child ast node 2))]
          (if (and (>= function-index 0)
                   (= (.id (index (load (field (field frontend functions) data))
                                  function-index))
                      owner))
              (fe-resolution-symbol frontend (ts-child ast (ts-child ast node 0) 0))
              -1))
        (let [(mut index) 0
              (mut answer) -1]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (>= (load answer) 0))
                    (break)
                    (do
                      (set! answer
                            (fng-static-owner-scan frontend
                                                   (ts-child ast node (load index))
                                                   owner))
                      (set! index (+ (load index) 1)))))
          (load answer)))))

(defn fng-static-method [(frontend (ptr NativeFrontend))
                         (receiver-node i64)
                         (name-node i64)
                         (owner i64)] (-> i64)
  (let [ast (field frontend ast)
        direct (fe-resolution-symbol frontend receiver-node)
        symbol
          (if (>= direct 0)
              direct
              (if (= (ts-kind ast receiver-node) TSK-THIS)
                  (fng-static-owner-scan frontend (ts-root ast) owner)
                  -1))
        name (ts-text ast name-node)
        (mut index) 0
        (mut cached) false
        (mut answer) -1]
    (set! (fng-profile-static-method-calls-ptr)
          (+ (load (fng-profile-static-method-calls-ptr)) 1))
    (if (< symbol 0)
        -1
        (do
          (loop (if (or (>= (load index) (al-len [i64] (.static-method-symbols frontend)))
                        (load cached))
                    (break)
                    (do
                      (if (and (= (al-get (.static-method-symbols frontend) (load index)) symbol)
                               (= (ts-text ast (al-get (.static-method-names frontend) (load index)))
                                  name))
                          (do
                            (set! answer (al-get (.static-method-results frontend) (load index)))
                            (set! cached true))
                          0)
                      (set! index (+ (load index) 1)))))
          (if (load cached)
              (set! (fng-profile-static-method-hits-ptr)
                    (+ (load (fng-profile-static-method-hits-ptr)) 1))
              (do
                (set! (fng-profile-static-method-scans-ptr)
                      (+ (load (fng-profile-static-method-scans-ptr)) 1))
                (set! answer (fng-static-method-scan frontend (ts-root ast) symbol name))
                (al-push! [i64] (field frontend static-method-symbols) symbol)
                (al-push! [i64] (field frontend static-method-names) name-node)
                (al-push! [i64] (field frontend static-method-results) (load answer))))
          (load answer)))))

;; Resolve the callable denoted by the receiver of Function.prototype.call.  DeltaBlue's
;; inheritance shim publishes constructors as `Ctor.superConstructor` and inherited methods as
;; `Ctor.superConstructor.prototype.method`.  Those relationships are closed-world metadata, so
;; preserve exact function identity instead of loading an unbounded dynamic "call" property.
(defn fng-explicit-call-target [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (= kind TSK-IDENTIFIER)
        (fe-resolution-symbol frontend node)
        (if (= kind TSK-PROPERTY-ACCESS)
            (let [base (ts-child ast node 0)
                  name (ts-text ast (ts-child ast node 1))]
              (if (= name "superConstructor")
                  (fng-prototype-parent frontend (fe-find-function-name frontend base))
                  (if (and (= (ts-kind ast base) TSK-PROPERTY-ACCESS)
                           (= (ts-text ast (ts-child ast base 1)) "prototype"))
                      (let [constructor (fng-explicit-call-target frontend (ts-child ast base 0))]
                        (if (>= constructor 0)
                            (fng-constructor-method frontend constructor (ts-child ast node 1))
                            -1))
                      -1)))
            -1))))

;; An identifier bound by `let f = function (...) { ... }` resolves to the local variable symbol,
;; not directly to the nested function id. Recover the closed-world target from the declaration so
;; calls use the function's parameter ABI while still loading the already-materialized closure
;; environment from the local binding.
(defn fng-local-function-target [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        symbol-id (fe-resolution-symbol frontend node)
        (mut index) 0
        (mut answer) -1
        (mut closure-mutated) false]
    ;; A local whose declaration initializer is a function expression is NOT a stable call
    ;; target when a closure REASSIGNS it: NavierStokes seeds `var uiCallback = function(){}`
    ;; and setUICallback overwrites it, so pinning the call to the initial closure silently
    ;; ran the empty function forever (prepareFrame never fired, density stayed zero).
    ;; Same-function reassignment is already handled by the values[] tracking.
    (loop (if (or (>= (load index) (al-len [FeCapture] (.captures frontend)))
                  (load closure-mutated))
              (break)
              (let [capture (al-get [FeCapture] (.captures frontend) (load index))]
                (if (and (= (.symbol capture) symbol-id)
                         (.mutable capture))
                    (set! closure-mutated true)
                    0)
                (set! index (+ (load index) 1)))))
    (if (load closure-mutated)
        (do (set! answer -2) 0)
        0)
    (set! index 0)
    (loop (if (or (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                  (>= (load answer) 0))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (not (load closure-mutated)) (= (.id symbol) symbol-id))
                    (let [declaration (.node symbol)
                          count (ts-child-count ast declaration)
                          initializer (if (> count 1) (ts-child ast declaration (- count 1)) -1)]
                      (if (and (>= initializer 0)
                               (fe-function-expression-kind? (ts-kind ast initializer)))
                          (let [function-index (fe-function-for-node frontend initializer)]
                            (if (>= function-index 0)
                                (set! answer
                                      (.id (index (load (field (field frontend functions) data))
                                                        function-index)))
                                0))
                          0))
                    0)
                (set! index (+ (load index) 1)))))
    (if (load closure-mutated) -1 (load answer))))

;; Graph-level polymorphic dispatch for a method-call target set the finite 63-bit summary
;; cannot represent. The loaded callee is compared against each candidate's exact callable
;; identity and that target is called directly, so any function id works and the verifier sees
;; ordinary exact calls. The fallthrough throws: a dispatch miss must be loud, never a shifted
;; register file.
(defn fng-method-chain! [(context FngContext)
                         (loaded i64)
                         (receiver i64)
                         (args (ptr (ArrayList i64)))
                         (candidates (ptr (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        (mut no-symbols) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut arm-ctrls) (al-new [i64] (malloc-allocator))
        (mut arm-starts) (al-new [i64] (malloc-allocator))
        (mut arm-values) (al-new [i64] (malloc-allocator))
        (mut call-args) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (set! (fng-profile-method-chains-ptr) (+ (load (fng-profile-method-chains-ptr)) 1))
    (set! (fng-profile-method-candidates-ptr)
          (+ (load (fng-profile-method-candidates-ptr)) (al-len [i64] (load candidates))))
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    (loop (if (>= (load index) (al-len [i64] (load candidates)))
              (break)
              (let [candidate (al-get [i64] (load candidates) (load index))
                    fn (al-get [FeFunction]
                               (.functions frontend)
                               (fng-function-index frontend candidate))
                    fun-node (al-get [i64] (load (load (field context functions))) candidate)
                    ; A candidate is a bare capture-free Fun, so its published value is a tagged
                    ; function constant. Tag bits are disjoint from every other representation, so
                    ; raw 64-bit equality IS JavaScript function identity here — no StrictEqual
                    ; type ladder needed per arm.
                    condition (fng-peep (n-new3 (Eq) NO-NODE loaded (n-box! fun-node)))
                    arms (n-if-arms! (fng-peep (n-new2 (If)
                                                      (load (load (field context ctrl)))
                                                      condition)))
                    branch-start (fng-snapshot! context
                                                (mut no-symbols)
                                                (mut active)
                                                (mut snapshots))]
                (set! (load (field context ctrl)) (arms-t arms))
                (set! (.len call-args) 0)
                (let [(mut ordinal) 0]
                  (loop (if (>= (load ordinal) (al-len [i64] (load args))) (break)
                          (do (al-push! [i64]
                                        (mut call-args)
                                        (al-get [i64] (load args) (load ordinal)))
                              (set! ordinal (+ (load ordinal) 1)))))
                  (fng-normalize-call-arguments! context fn (mut call-args)))
                (fng-ensure-memory! context)
                (if (!= (load (load (field context memory))) NO-NODE)
                    (al-push! [i64] (mut call-args) (load (load (field context memory))))
                    0)
                ; Chain candidates are capture-free (identity comparison against a boxed Fun
                ; constant is only meaningful for them), so the environment slot is undefined.
                (let [call (n-call-receiver! (load (load (field context ctrl)))
                                             fun-node
                                             (fng-undefined)
                                             receiver
                                             (al-slice [i64] (load call-args)))]
                  (set! (load (field context ctrl)) (call-end call))
                  (set! (load (field context memory)) NO-NODE)
                  (al-push! [i64] (mut arm-values)
                            (fng-box-dynamic-argument! (call-value call))))
                (al-push! [i64] (mut arm-ctrls) (load (load (field context ctrl))))
                (al-push! [i64] (mut arm-starts)
                          (fng-snapshot! context
                                         (mut no-symbols)
                                         (mut active)
                                         (mut snapshots)))
                (fng-restore-snapshot! context
                                       (mut no-symbols)
                                       (mut active)
                                       (mut snapshots)
                                       branch-start)
                (set! (load (field context ctrl)) (arms-f arms))
                (set! index (+ (load index) 1)))))
    ; The property held a function value none of the closed-world candidates match.
    (fng-add-return! context
                     (fng-jsl-call1 context "ThrowValue"
                                    (n-box!
                                      (n-string-const!
                                        (jss-from-utf8!
                                          "TypeError: dynamic method call matched no known function target")))))
    (let [(mut answer) NO-NODE]
      (if (= (al-len [i64] (load arm-ctrls)) 1)
          (do
            (set! (load (field context ctrl)) (al-get [i64] (load arm-ctrls) 0))
            (fng-restore-snapshot! context
                                   (mut no-symbols)
                                   (mut active)
                                   (mut snapshots)
                                   (al-get [i64] (load arm-starts) 0))
            (set! answer (al-get [i64] (load arm-values) 0)))
          (let [region (n-new (Region))
                (mut memories) (al-new [i64] (malloc-allocator))
                (mut arm) 0]
            (n-add-def! region NO-NODE)
            (loop (if (>= (load arm) (al-len [i64] (load arm-ctrls)))
                      (break)
                      (do
                        (n-add-def! region (al-get [i64] (load arm-ctrls) (load arm)))
                        (set! arm (+ (load arm) 1)))))
            (set! index 0)
            (loop (if (>= (load index) (al-len [i64] (load active)))
                      (break)
                      (let [alias (al-get [i64] (load active) (load index))
                            phi (n-new (Phi (t-mem-alias alias (t-undef))))]
                        (n-add-def! phi region)
                        (set! arm 0)
                        (loop (if (>= (load arm) (al-len [i64] (load arm-ctrls)))
                                  (break)
                                  (do
                                    (n-add-def! phi
                                                (al-get [i64]
                                                        (load snapshots)
                                                        (+ (al-get [i64] (load arm-starts) (load arm))
                                                           (load index))))
                                    (set! arm (+ (load arm) 1)))))
                        (al-push! [i64] (mut memories) phi)
                        (set! index (+ (load index) 1)))))
            (if (> (al-len [i64] (load memories)) 0)
                (set! (load (field context memory)) (fng-merge memories))
                0)
            (set! (load (field context ctrl)) region)
            (let [phi (n-new (Phi (t-dyn)))]
              (n-add-def! phi region)
              (set! arm 0)
              (loop (if (>= (load arm) (al-len [i64] (load arm-values)))
                        (break)
                        (do
                          (n-add-def! phi (al-get [i64] (load arm-values) (load arm)))
                          (set! arm (+ (load arm) 1)))))
              (set! answer (fng-peep phi)))
            (al-free! [i64] (mut memories))))
      ; Build-time consumers decide whether a value still needs ToNumber by EXACT type identity
      ; with (t-dyn) — see fng-needs-to-number?. A freshly peepholed phi/box carries a refined
      ; dyn that fails that identity test, so the tagged dispatch result would be consumed as raw
      ; bits (an always-true loop bound, concretely). Publish it as plain dyn; the analysis passes
      ; recompute precise types after construction.
      (if (!= (load answer) NO-NODE) (n-set-ty! (load answer) (t-dyn)) 0)
      (al-free! [i64] (mut no-symbols))
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut snapshots))
      (al-free! [i64] (mut arm-ctrls))
      (al-free! [i64] (mut arm-starts))
      (al-free! [i64] (mut arm-values))
      (al-free! [i64] (mut call-args))
      (load answer))))

(defn fng-user-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        construct (= (ts-kind ast node) TSK-NEW-EXPRESSION)
        syntax-callee (ts-child ast node 0)
        explicit-call
          (and (= (ts-kind ast syntax-callee) TSK-PROPERTY-ACCESS)
               (= (ts-text ast (ts-child ast syntax-callee 1)) "call"))
        callee-node (if explicit-call (ts-child ast syntax-callee 0) syntax-callee)
        receiver-call (and (not explicit-call) (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS))
        callee
          (if explicit-call
              (fng-explicit-call-target frontend callee-node)
              (if receiver-call
              (let [object-node (ts-child ast callee-node 0)
                    static (fng-static-method frontend
                                              object-node
                                              (ts-child ast callee-node 1)
                                              (.owner context))
                    inherited
                      (if (= (ts-kind ast object-node) TSK-THIS)
                          (fng-constructor-method
                            frontend
                            (fng-owner-constructor frontend
                                                   (.owner context))
                            (ts-child ast callee-node 1))
                          -1)
                    unique (fng-unique-prototype-method frontend (ts-child ast callee-node 1))
                    resolved (fe-resolution-symbol frontend callee-node)
                    named (fe-find-function-name frontend (ts-child ast callee-node 1))
                    typed
                      (if (and (>= named 0) (fng-function-receiver-aware? frontend named))
                          named
                          resolved)]
                (if (>= static 0)
                    static
                    (if (>= inherited 0)
                        inherited
                        (if (>= unique 0) unique typed))))
              (let [resolved (fe-resolution-symbol frontend callee-node)
                    local-target (fng-local-function-target frontend callee-node)
                    declaration-target
                      (fe-find-function-name-in-owner frontend callee-node (.owner context))]
                (if (>= declaration-target 0) declaration-target
                    (if (>= local-target 0) local-target resolved)))))
        ;; A property-call syntax does not by itself add a receiver slot to a statically resolved
        ;; function. Static namespace helpers such as Strength.stronger(s1, s2) do not compile a
        ;; `this` Parm; passing the base object shifts every explicit argument by one. Unresolved
        ;; method dispatch still needs the receiver because its runtime target is receiver-aware.
        receiver-aware (or explicit-call
                           (or (fng-function-receiver-aware? frontend callee)
                               (and receiver-call (< (fng-function-index frontend callee) 0))))
        ;; A method or superConstructor target that CAPTURES cannot be called off its bare Fun:
        ;; its hidden environment is the closure VALUE stored in the property, so the call must
        ;; dispatch through that loaded value. Demote to the generic path, which passes the
        ;; callee value as the environment.
        function-index
          (let [statically (fng-function-index frontend callee)]
            (if (and (>= statically 0)
                     (and (or receiver-call explicit-call)
                          (> (fng-capture-count frontend callee) 0)))
                -1
                statically))
        method-targets
          (if receiver-call
              (fng-prototype-method-targets frontend (ts-child ast callee-node 1))
              0)
        ;; When the name's method set cannot ride the finite target summary, dispatch through a
        ;; graph-level identity chain over the unbounded candidate list instead of one generic
        ;; call node the backend could never dispatch.
        (mut chain-candidates) (al-new [i64] (malloc-allocator))
        chain-dispatch
          (and receiver-call
               (and (< function-index 0)
                    (and (= method-targets 0)
                         (and (not construct)
                              (and (not explicit-call)
                                   (and (= (ts-role ast node TS-ROLE-OPERATOR 0) -1)
                                        (> (fng-method-candidates!
                                             frontend
                                             (ts-child ast callee-node 1)
                                             (mut chain-candidates))
                                           0)))))))
        argument-function-index
          (if (>= function-index 0)
              function-index
              (if (> method-targets 0)
                  (fng-function-index frontend
                                      (fng-widest-function-target frontend method-targets))
                  -1))
        fn
          (if (>= function-index 0)
              (al-get [FeFunction] (.functions frontend) function-index)
              (zeroed FeFunction))
        argument-fn
          (if (>= argument-function-index 0)
              (al-get [FeFunction] (.functions frontend) argument-function-index)
              (zeroed FeFunction))
        receiver-type (if (>= function-index 0) (.receiver-type-node fn) -1)
        receiver-owner
          (if (and (>= function-index 0) (>= receiver-type 0))
              (fe-type-index-for-node frontend receiver-type)
              -1)
        raw-receiver
          (if construct
              (if (>= receiver-owner 0)
                  (fng-empty-object context receiver-owner)
                  ; `new F()` allocates a fresh object even when F's body never reads `this`
                  ; (receiver-type -1). NO-NODE here compiled a silently-broken store whenever
                  ; the result was USED — DeltaBlue's inheritsFrom body, dead at runtime only
                  ; because its calls are intercepted, was the first thing loud enough to notice.
                  (fng-empty-dynamic-object context))
              (if explicit-call
                  (fng-expression context (ts-child ast node 1))
                  (if receiver-aware
                  (if receiver-call
                      (let [receiver-source (ts-child ast callee-node 0)
                            ;; A METHOD ON A NUMBER HAS NO RECEIVER TO PASS. JavaScript boxes the
                            ;; primitive into a wrapper object; this compiler has no wrapper
                            ;; objects, and the receiver slot takes an object, a function or
                            ;; undefined. `(acc / 4).toFixed(2)` put a raw `Div` in it and the
                            ;; verifier rejected the Call afterwards -- a graph built wrong and
                            ;; caught late, rather than a construct refused where it is written.
                            ;; The declared type is read here because the built node's type is
                            ;; still unanalysed at this point.
                            _ (if (= (fng-infer context receiver-source FNG-DYNAMIC) FNG-NUMBER)
                                  (fng-unsupported-syntax! "method receiver"
                                                           (ts-kind ast node)
                                                           (ts-text ast node))
                                  0)
                            first (fng-expression context receiver-source)]
                        (if (load (fng-omit-receiver-ptr))
                            (fng-undefined)
                            (if (load (fng-duplicate-receiver-ptr))
                                (fng-expression context receiver-source)
                                first)))
                      (fng-undefined))
                  NO-NODE)))
        receiver
          (if (and (not construct) (!= raw-receiver NO-NODE))
              ; Box only a value that is PURELY a function — a bare Fun/closure crossing into a
              ; receiver slot. Testing "could be a function" matched every dyn value (dyn contains
              ; the fun kind), which shadowed the unbox arm below and handed shaped callees a
              ; tagged receiver to raw-load through.
              (if (= (ty-kinds (n-ty raw-receiver)) VK-FUN)
                  (n-box! raw-receiver)
                  (if (and (>= receiver-owner 0) (fng-value-tagged? raw-receiver))
                      (n-unbox! raw-receiver
                                (t-obj-shape
                                  (al-get [i64] (load (load (field context shapes))) receiver-owner)))
                      raw-receiver))
              raw-receiver)
        target
          (if (>= function-index 0)
              (al-get [i64] (load (load (field context functions))) (.id fn))
              (if (and receiver-call (< function-index 0))
                  (do
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    (let [loaded
                            ;; THE SAME LOAD AN ORDINARY READ WOULD DO. This went straight to
                            ;; `GetNamedProperty` -- the runtime property table -- while an object
                            ;; LITERAL stores its properties into static shape slots, so the load
                            ;; never saw the store: `{get: () => 7}` then `o.get()` dispatched on
                            ;; `undefined` and the program returned 0. `o.get` read as a value was
                            ;; already right, because that path is `fng-field-load-value`, which
                            ;; picks the shape slot when the field is statically known and the
                            ;; property table when it is not. A callee is a property read like any
                            ;; other and has no business choosing differently.
                            (fng-field-load-value context callee-node
                                                  (ts-child ast callee-node 0)
                                                  (ts-child ast callee-node 1)
                                                  raw-receiver)
                          targets method-targets]
                      (if (> targets 0)
                          (n-new2 (Cast (t-fun-set targets))
                                  (load (load (field context ctrl))) loaded)
                          loaded)))
                  (fng-expression context callee-node)))
        ;; A syntactically direct Fun/Closure callee stays an EXACT call even when name
        ;; resolution failed (an IIFE, a local closure value): its raw node gives the backend
        ;; the target for a direct branch and reachability, where a boxed value would force
        ;; runtime dispatch against a function the unit never built.
        direct-value-callee
          (and (< function-index 0)
               (or (op-is? target Fun [_]) (op-is? target Closure [_])))
        ;; The hidden environment argument. A generic site passes the callee value itself — a
        ;; closure is its own environment and a bare function ignores the slot. An exact site
        ;; passes the boxed closure value for a capture-carrying target and undefined otherwise.
        call-env
          (if (>= function-index 0)
              (if (> (fng-capture-count frontend (.id fn)) 0)
                  (fng-box-dynamic-argument! (fng-expression context callee-node))
                  (fng-undefined))
              (if direct-value-callee (n-box! target) target))
        ;; The 3833-recovery below fills omitted arguments from a graph-resolved Fun AFTER the
        ;; argument loop — too late for the loop itself, which lowers call-site object literals
        ;; against the callee's EXPECTED parameter shapes. Without this hoisted resolution a
        ;; direct-value callee (top-level JS function, IIFE, local closure) lowered its literal
        ;; arguments DYNAMICALLY while the callee body read the literal-inferred STATIC shape:
        ;; fixed-slot loads against dynamic property storage, i.e. garbage (object-parameters
        ;; computed 7000064 instead of 1507052134 in JS mode).
        argument-function-index
          (if (or (>= argument-function-index 0) (not direct-value-callee))
              argument-function-index
              (let [target-fun (if (op-is? target Closure [_]) (n-in target 0) target)]
                (fng-function-index frontend (- (n-fun-index target-fun) 1))))
        argument-fn
          (if (>= argument-function-index 0)
              (al-get [FeFunction] (.functions frontend) argument-function-index)
              (zeroed FeFunction))
        (mut args) (al-new [i64] (malloc-allocator))
        (mut call-captures) (al-new [i64] (malloc-allocator))
        optional-call
          (and (not construct) (!= (ts-role ast node TS-ROLE-OPERATOR 0) -1))
        conditional-optional (and optional-call (< function-index 0))
        argument-start (if explicit-call 2 (if optional-call 2 1))
        (mut index) argument-start
        (mut optional-symbols) (al-new [i64] (malloc-allocator))
        (mut optional-active) (al-new [i64] (malloc-allocator))
        (mut optional-snapshots) (al-new [i64] (malloc-allocator))
        (mut optional-nullish-ctrl) NO-NODE
        (mut optional-nullish-start) 0]
    ;; The callee (and a method receiver/property lookup) has already been evaluated exactly once.
    ;; Only arguments and invocation belong to the present arm of `?.(`.
    (if conditional-optional
        (do
          (let [(mut argument-index) argument-start]
            (loop (if (>= (load argument-index) (ts-child-count ast node))
                      (break)
                      (do
                        (fng-assigned! frontend
                                       (ts-child ast node (load argument-index))
                                       (mut optional-symbols))
                        (set! argument-index (+ (load argument-index) 1))))))
          (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
          (fng-active-memory! context (mut optional-active))
          (fng-control-aliases! context (mut optional-active))
          (let [condition
                  (if (>= function-index 0)
                      (fng-bool false)
                      (fng-jsl-call1 context "IsNullishCallable" target))
                saved-ctrl (load (load (field context ctrl)))
                saved-start
                  (fng-snapshot! context
                                 (mut optional-symbols)
                                 (mut optional-active)
                                 (mut optional-snapshots))
                arms (n-if-arms! (fng-peep (n-new2 (If) saved-ctrl condition)))]
            (set! (load (field context ctrl)) (arms-t arms))
            (set! optional-nullish-ctrl (load (load (field context ctrl))))
            (set! optional-nullish-start
                  (fng-snapshot! context
                                 (mut optional-symbols)
                                 (mut optional-active)
                                 (mut optional-snapshots)))
            (fng-restore-snapshot! context
                                   (mut optional-symbols)
                                   (mut optional-active)
                                   (mut optional-snapshots)
                                   saved-start)
            (set! (load (field context ctrl)) (arms-f arms))))
        0)
    ;; Every dynamically represented construction with a static target gets the constructor's
    ;; prototype, including a constructor that never reads `this` (receiver-type -1). The latter
    ;; still allocates a real ordinary object above; omitting its link made `new F().constructor`
    ;; undefined and `new F() instanceof F` false. Statically shaped receivers use the closed-world
    ;; shape path; truly polymorphic construction still requires runtime constructor dispatch.
    (if (and construct (and (< receiver-owner 0) (>= function-index 0)))
        (let [prototype (fng-constructor-prototype! context callee)
              linked
                (fng-jsl-call2 context "SetObjectPrototype" receiver prototype)]
          0)
        0)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (do
                (let [ordinal (- (load index) argument-start)
                      ;; The parameter's declared shape is the argument's EXPECTED type, so an
                      ;; object literal written at a call site is built the way the callee reads it.
                      value (fng-expression-expected
                              context
                              (ts-child ast node (load index))
                              (fng-argument-expected frontend argument-fn ordinal
                                                     (>= argument-function-index 0)))]
                  (al-push! [i64]
                            (mut args)
                            (if (>= argument-function-index 0)
                                (fng-call-argument frontend argument-fn ordinal value)
                                ;; A GENERIC CALL'S ABI IS ALL TAGGED, because the callee is not
                                ;; known and every JavaScript function's parameters are `dyn`. With
                                ;; a known callee `fng-call-argument` puts each argument in the
                                ;; representation that callee declares; with an unknown one there is
                                ;; nothing to ask, and this passed the raw expression instead.
                                ;;
                                ;; `o.add(4)` therefore did `mov x2, #4` and the callee tag-tested
                                ;; x2, found no tag, and answered 0 -- EVERY argument to a method
                                ;; loaded from the heap arrived as nothing. The receiver survived
                                ;; only because it is boxed on its own path, which is why `this.v`
                                ;; worked while `k` did not.
                                ;;
                                ;; A direct callee recovered from the graph is excluded: it is
                                ;; called exactly, with its own parameter classification, and boxing
                                ;; would break the raw representation it expects.
                                (if direct-value-callee
                                    value
                                    (fng-box-dynamic-argument! value)))))
                (set! index (+ (load index) 1)))))
    ; Omitted fixed formals become undefined; a final rest formal receives a fresh DSL-built array.
    (if (>= argument-function-index 0)
        (fng-normalize-call-arguments! context argument-fn (mut args))
        0)
    ;; Name/symbol resolution and callable dispatch use separate id spaces.  A call can therefore
    ;; reach an exact Fun even when the source-level lookup above could not recover its FeFunction.
    ;; Recover that identity from the graph target before freezing the native call descriptor, so
    ;; omitted JavaScript arguments still arrive as `undefined` instead of uninitialised registers.
    (if (and (< argument-function-index 0)
             (or (op-is? target Fun [_]) (op-is? target Closure [_])))
        ;; OPTAG-FUN reserves callable identity zero as invalid, so its aux is FeFunction.id + 1.
        ;; A Closure's function identity is its input 0.
        (let [target-fun (if (op-is? target Closure [_]) (n-in target 0) target)
              target-function-index (fng-function-index frontend (- (n-fun-index target-fun) 1))]
          (if (>= target-function-index 0)
              (let [target-fn
                      (al-get [FeFunction]
                              (.functions frontend)
                              target-function-index)]
                (fng-normalize-call-arguments! context target-fn (mut args)))
              0))
        0)
    (if chain-dispatch
        (let [chain-answer
                (fng-method-chain! context target receiver (mut args) (mut chain-candidates))]
          (al-free! [i64] (mut args))
          (al-free! [i64] (mut call-captures))
          (al-free! [i64] (mut chain-candidates))
          (al-free! [i64] (mut optional-symbols))
          (al-free! [i64] (mut optional-active))
          (al-free! [i64] (mut optional-snapshots))
          chain-answer)
        (do
    ;; A trailing memory input is an effect token, not a JavaScript argument. It publishes all
    ;; stores that precede the call and lets the callee's memory Args inherit that heap version.
    (fng-ensure-memory! context)
    (if (!= (load (load (field context memory))) NO-NODE)
        (al-push! [i64] (mut args) (load (load (field context memory))))
        0)
    (let [callable-target
            (let [resolved-target (if (= target NO-NODE) (fng-undefined) target)]
              (if conditional-optional
                  (n-new2 (Cast (t-fun)) (load (load (field context ctrl))) resolved-target)
                  resolved-target))
          ; Every JavaScript call uses the receiver form — a plain `f(x)` passes undefined in the
          ; reserved receiver slot. A call whose target is not statically known is marked DYNAMIC
          ; so selection always dispatches the runtime callee value.
          call
            (let [_ (if (fng-valid-receiver? receiver)
                        0
                        (fng-unsupported-syntax! "method receiver"
                                                 (ts-kind ast node)
                                                 (ts-text ast node)))
                  site (n-call-receiver! (load (load (field context ctrl)))
                                         callable-target
                                         call-env
                                         (if (= receiver NO-NODE) (fng-undefined) receiver)
                                         (al-slice [i64] (load args)))]
              (if (and (< function-index 0)
                       (and (not conditional-optional) (not direct-value-callee)))
                  (do (n-set-op! (call-value site) (Call CALL-ABI-DYNAMIC-RECEIVER)) 0)
                  0)
              (load site))
          value (call-value call)]
      (set! (load (field context ctrl)) (call-end call))
      ;; The callee may have changed any active alias. Re-anchor subsequent alias reads at the
      ;; CallEnd instead of reusing a pre-call memory node.
      (set! (load (field context memory)) NO-NODE)
      ;; A JavaScript call has two successors even though the value ABI stays single-result. The
      ;; pending flag is checked before the result is cast, boxed, or otherwise consumed.
      (fng-check-pending-exception! context value)
      (let [ordinary-value
              (if construct
                  (let [result-owner
                          (if (>= function-index 0)
                              (fe-type-index-for-node frontend (.result-node fn))
                              -1)]
                    (if (>= result-owner 0)
                        (n-new2 (Cast (t-obj-shape
                                  (al-get [i64]
                                          (load (load (field context shapes)))
                                          result-owner)))
                                (load (load (field context ctrl)))
                                value)
                        (fng-pin-after-call! context value receiver)))
                  value)
            (mut answer) ordinary-value]
        (if conditional-optional
            (let [present-value (fng-box-dynamic-argument! ordinary-value)
                  present-ctrl (load (load (field context ctrl)))
                  present-start
                    (fng-snapshot! context
                                   (mut optional-symbols)
                                   (mut optional-active)
                                   (mut optional-snapshots))]
              (if (fng-merge-snapshots! context
                                        (load optional-nullish-ctrl)
                                        (load optional-nullish-start)
                                        present-ctrl
                                        present-start
                                        (mut optional-symbols)
                                        (mut optional-active)
                                        (mut optional-snapshots))
                  (cond (= (load optional-nullish-ctrl) NO-NODE)
                          (store! answer present-value)
                        (= present-ctrl NO-NODE)
                          (store! answer (n-box! (fng-undefined)))
                        :else
                          (let [phi (n-new (Phi (t-dyn)))]
                            (n-add-def! phi (load (load (field context ctrl))))
                            (n-add-def! phi (n-box! (fng-undefined)))
                            (n-add-def! phi present-value)
                            (store! answer (fng-peep phi))))
                  0))
            0)
        (al-free! [i64] (mut args))
        (al-free! [i64] (mut call-captures))
        (al-free! [i64] (mut chain-candidates))
        (al-free! [i64] (mut optional-symbols))
        (al-free! [i64] (mut optional-active))
        (al-free! [i64] (mut optional-snapshots))
        (load answer)))))))

(defn fng-intrinsic-call [(context FngContext) (node i64) (intrinsic i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argc (- (ts-child-count ast node) 1)]
    (cond (= intrinsic FNG-INTRINSIC-OBJECT) (fng-empty-dynamic-object context)
          (= intrinsic FNG-INTRINSIC-ARRAY)
            (let [allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
                  array (n-array-mark! (load (load (field context ctrl)))
                                        (n-obj-ptr allocation))]
              (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
              (if (> argc 0)
                  ;; The length is a JavaScript NUMBER; ResizeArray declares an int. A float
                  ;; length ((w+2)*(h+2) computed in FP) passed raw arrives as its IEEE bit
                  ;; pattern and resizes to ~4.6e18 elements.
                  (let [length-node (ts-child ast node 1)
                        resized
                          (fng-jsl-call3 context "ResizeArray" array
                                         (fng-int-value context length-node
                                                        (fng-expression context length-node))
                                         array)]
                    0)
                  0)
              array)
          (= intrinsic FNG-INTRINSIC-STRING)
            (if (= argc 0)
                (n-string-const! (jss-from-utf8! ""))
                (let [argument (ts-child ast node 1)]
                  (if (= (fe-resolution-symbol frontend argument) FE-INTRINSIC-NAN)
                      (n-string-const! (jss-from-utf8! "NaN"))
                      (fng-jsl-call1 context "ToStringValue"
                                     (fng-expression context argument)))))
          (= intrinsic FNG-INTRINSIC-PARSEINT)
            (fng-jsl-call2 context "ParseIntValue"
                           (fng-expression context (ts-child ast node 1))
                           (if (> argc 1)
                               (fng-expression context (ts-child ast node 2))
                               (fng-const 0)))
          :else
            (let [argument (ts-child ast node 1)]
              (if (= (fe-resolution-symbol frontend argument) FE-INTRINSIC-NAN)
                  (fng-bool true)
                  ;; The GLOBAL isNaN, which coerces before testing — see GlobalIsNaN's note on how
                  ;; it differs from Number.isNaN.
                  (fng-jsl-call1 context "GlobalIsNaN"
                                 (fng-expression context argument)))))))

(defn fng-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        static-inheritance
          (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
               (and (= (ts-text ast (ts-child ast callee 1)) "inheritsFrom")
                    (> (ts-child-count ast node) 1)))
        intrinsic (if static-inheritance FNG-DYNAMIC (fng-infer context callee FNG-DYNAMIC))]
    (if static-inheritance
        (fng-undefined)
    (if (or (= intrinsic FNG-INTRINSIC-OBJECT)
            (or (= intrinsic FNG-INTRINSIC-ARRAY)
            (or (= intrinsic FNG-INTRINSIC-STRING)
                (or (= intrinsic FNG-INTRINSIC-PARSEINT) (= intrinsic FNG-INTRINSIC-ISNAN)))))
        (fng-intrinsic-call context node intrinsic)
        (fng-user-call context node)))))

;; A SPREAD IN AN OBJECT LITERAL IS SILENTLY DROPPED, so it is refused here instead.
;;
;; `fe-index-object-layouts!` gives a literal a static shape only when every property is a plain
;; `TSK-PROPERTY-ASSIGNMENT`; a spread element is a different kind, so the literal gets no layout
;; and the spread contributes nothing. `{...a, y: 2}` then had a shape carrying `y` and not `x`,
;; and reading `b.x` stopped the evaluator with "an object's shape does not carry that field".
;;
;; This is the same defect the ARRAY spread had, and it was fixed the same way: the bridge maps
;; unenumerated syntax to kind 0, `[...a, 3]` silently evaluated to length 2, and the repair was to
;; make the drop loud rather than to guess at semantics. `Object.assign({}, a, {y: 2})` -- the same
;; operation spelled without spread -- is supported and is the workaround.
;;
;; A shorthand property (`{x}`) is also not a `TSK-PROPERTY-ASSIGNMENT`, so it is named here too
;; rather than being lumped in with spread: whatever this refuses, it says exactly what it saw.
;; repros/open/object-spread-narrows-without-proof.js.
;; A SPREAD ELEMENT arrives as bridge kind 0 with real source text starting `...` -- the same
;; kind-0 disambiguation the array literal already does for elisions. It is legal ONLY on the
;; dynamic-object path (`allow-spread`), because a spread precludes the static layout by
;; construction: `fe-index-object-layouts!` gives a literal a shape only when every element is a
;; plain property assignment.
(defn fng-object-spread-element? [(ast (ptr TsAst)) (property i64)] (-> bool)
  (let [text (ts-text ast property)]
    (and (= (ts-kind ast property) 0)
         (and (>= (slice-len text) 3) (= (substr text 0 3) "...")))))

(defn fng-refuse-object-spread! [(context FngContext) (node i64) (allow-spread bool)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        (mut index) 0]
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [property (ts-child ast node (load index))]
                (if (or (or (= (ts-kind ast property) TSK-PROPERTY-ASSIGNMENT)
                            (or (= (ts-kind ast property) TSK-METHOD-DECLARATION)
                                (= (ts-kind ast property) TSK-SHORTHAND-PROPERTY-ASSIGNMENT)))
                        (and allow-spread (fng-object-spread-element? ast property)))
                    0
                    (fng-unsupported-syntax! "object literal element"
                                             (ts-kind ast property)
                                             (ts-text ast property)))
                (set! index (+ (load index) 1))
                0)))
    0))

(defn fng-object [(context FngContext) (node i64) (owner i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        type (al-get [FeTypeDecl] (.types frontend) owner)
        field-start (.field-start type)
        field-count (.field-count type)
        shape (al-get [i64] (load (load (field context shapes))) owner)
        (mut field-values) (al-new [i64] (malloc-allocator))
        (mut incoming) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut stores) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) field-count)
              (break)
              (let [property (ts-child ast node (load index))
                    value-node (fe-object-property-value-node ast property)
                    field-value (al-get [FeField] (.fields frontend) (+ field-start (load index)))
                    expected (fng-type-tag frontend (.type-node field-value))]
                (al-push! [i64] (mut field-values) (fng-expression-expected context value-node expected))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) field-count)
              (break)
              (let [global-field (+ field-start (load index))
                    alias (al-get [i64] (load (load (field context aliases))) global-field)]
                (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                (set! index (+ (load index) 1)))))
    (fng-active-memory! context (mut active))
    (let [nw (n-new-obj! (load (load (field context ctrl))) shape (al-slice [i64] (load incoming)))
          object (n-obj-ptr nw)]
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [global-field (al-get [i64] (load active) (load index))
                      active-field (al-get [FeField] (.fields frontend) global-field)
                      alias (al-get [i64] (load (load (field context aliases))) global-field)]
                  (if (= (.owner active-field) owner)
                      (let [local (fng-field-local-index frontend global-field)]
                        (al-push! [i64]
                                  (mut stores)
                                  (n-store! (n-obj-mem nw local)
                                            object
                                            (let [field-value (al-get [i64] (load field-values) local)]
                                              (if (= (shape-alias-ty alias) (t-dyn))
                                                  (fng-box-dynamic-argument! field-value)
                                                  field-value))
                                            alias)))
                      ;; Compatible fields in different structural declarations deliberately share
                      ;; an alias.  If this shape supplies that alias, its Store above is the new
                      ;; state: retaining an older declaration's state as a second MemMerge input
                      ;; makes a later lookup select the stale object's chain.
                      (if (= (shape-field-by-alias shape alias) SHAPE-NO-FIELD)
                          (al-push! [i64] (mut stores) (fng-current-memory context alias))
                          0))
                  (set! index (+ (load index) 1)))))
      (if (> (al-len [FeCapture] (.captures frontend)) 0)
          (al-push! [i64]
                    (mut stores)
                    (fng-current-memory context (.cell-alias context)))
          0)
      ;; THE DYNAMIC ALIASES SURVIVE THIS ALLOCATION TOO, and until now they did not. `stores` is
      ;; the field aliases this shape supplies plus the ones it does not, plus the capture cell --
      ;; and never the runtime property heap. So an object literal ERASED it: the next
      ;; `fng-current-memory` for JS-PROPERTY-ALIAS finds no leaf in the merge and manufactures a
      ;; fresh `Arg`, which starts the store chain over from nothing.
      ;;
      ;; `[{v: 1}, {v: 2}]` therefore kept only the LAST element store -- the first became
      ;; unreachable and was collected -- so element 0 was a hole and `String(xs[0])` was
      ;; "undefined". It needs no objects in the array to reproduce: any element expression that
      ;; writes another alias does it, and `[(o.v = 1, 5), (o.v = 2, 6)]` answers 6 twice.
      (let [(mut dynamic-at) 0]
        (loop (if (>= (load dynamic-at) (al-len [i64] (load (field context dynamic-aliases))))
                  (break)
                  (do
                    (al-push! [i64]
                              (mut stores)
                              (fng-current-memory
                                context
                                (al-get [i64]
                                        (load (field context dynamic-aliases))
                                        (load dynamic-at))))
                    (set! dynamic-at (+ (load dynamic-at) 1))
                    0))))
      (set! (load (field context memory)) (fng-merge stores))
      ;; Object.prototype identity and constructor wiring are JavaScript semantics, so invoke the
      ;; DSL operation after the structural allocation rather than open-coding either property.
      (fng-jsl-call1 context "InitializeOrdinaryObject" object)
      ;; Static slots are the compiler's fast representation, but JavaScript own-key enumeration
      ;; and computed-name access use the DSL property heap. Publish each initialized property
      ;; through SetNamedProperty as well, so both representations begin with the same values and
      ;; the observable property operation remains DSL-owned.
      (set! index 0)
      (loop (if (>= (load index) field-count)
                (break)
                (let [property (ts-child ast node (load index))
                      name-node (ts-child ast property 0)]
                  (fng-jsl-call3 context "SetNamedProperty"
                                 object
                                 (fng-const
                                   (shape-name-intern! (fng-nonindex-key-text ast name-node)))
                                 (al-get [i64] (load field-values) (load index)))
                  (set! index (+ (load index) 1)))))
      (al-free! [i64] (mut field-values))
      (al-free! [i64] (mut incoming))
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut stores))
      object)))

(defn fng-dynamic-object [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
        object (n-obj-ptr allocation)
        (mut index) 0]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-jsl-call1 context "InitializeOrdinaryObject" object)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (do
                (let [property (ts-child ast node (load index))]
                  ;; `{...a, b: 1}` in source order: a spread copies the source's own enumerable
                  ;; properties through the DSL's `ObjectAssignSource` -- the same step
                  ;; `Object.assign` takes, so the semantics (null/undefined sources are no-ops,
                  ;; later keys overwrite earlier) live in one definition.
                  (if (fng-object-spread-element? ast property)
                      (let [source (fng-expression context (ts-child ast property 0))
                            copied (fng-jsl-call2 context "ObjectAssignSource"
                                                  (fng-box-dynamic-argument! object)
                                                  (fng-box-dynamic-argument! source))]
                        0)
                      (let [name-node (ts-child ast property 0)
                            value-node (fe-object-property-value-node ast property)
                            computed (= (ts-kind ast name-node) TSK-COMPUTED-PROPERTY-NAME)
                            key (if computed (fng-expression context (ts-child ast name-node 0)) NO-NODE)
                            value (fng-expression context value-node)
                            probe (if (= value NO-NODE)
                                      (panic-corrupt (ts-text ast name-node))
                                      0)
                            stored
                              (if computed
                                  (fng-jsl-call3 context "SetProperty" object key value)
                                  (fng-jsl-call3 context "SetNamedProperty" object
                                                 (fng-const
                                                   (shape-name-intern!
                                                     (fng-nonindex-key-text ast name-node)))
                                                 value))]
                        0)))
                (set! index (+ (load index) 1)))))
    object))

(defn fng-array-literal [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
        array (n-array-mark! (load (load (field context ctrl))) (n-obj-ptr allocation))
        (mut index) 0]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-jsl-call1 context "InitializeArray" array)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [element (ts-child ast node (load index))]
                ;; TWO DIFFERENT THINGS ARRIVE AS BRIDGE KIND 0, and skipping both is how
                ;; `[...a, 3]` came to evaluate to length 2 where node says 3 -- a wrong answer
                ;; with no diagnostic anywhere. An ELISION is kind 0 with an EMPTY extent, and
                ;; skipping it is right: `[1, , 3]` really does have a hole at index 1, and the
                ;; `ResizeArray` below still counts it. Any other kind 0 is syntax the bridge does
                ;; not enumerate -- a spread element is the reachable case -- and it has real
                ;; source text, which is the only thing here that separates the two.
                (if (= (ts-kind ast element) 0)
                    (if (> (slice-len (ts-text ast element)) 0)
                        (fng-unsupported-syntax! "array element"
                                                 (ts-kind ast element)
                                                 (ts-text ast element))
                        0)
                    (let [value (fng-expression context element)
                          stored
                            (fng-jsl-call3 context "SetElement" array
                                           (fng-const (load index)) value)]
                      0))
                (set! index (+ (load index) 1)))))
    (let [resized
            (fng-jsl-call3 context "ResizeArray" array
                           (fng-const (ts-child-count ast node)) array)]
      0)
    array))

;; Is this value CERTAINLY a SHAPE-ROOT allocation by construction -- the dynamic object or
;; array `fng-dynamic-object`/`fng-array-literal` builds? Its properties live in the runtime
;; property table, never in shape slots, so a field access on one must take the PropertyKey path
;; even when the property NAME happens to exist in some static shape. `fng-unique-field-index`'s
;; name-guess assumed the collision could not happen; object spread made it routine, because
;; `{...a}` copies from a statically-shaped source and then reads back the same names.
(defn fng-shape-root-object? [(value i64)] (-> bool)
  (if (or (= value NO-NODE) (n-dead? value))
      false
      (match (n-op value)
        (Proj [slot]
          (and (= slot 0)
               (let [parent (n-in value 0)]
                 (and (!= parent NO-NODE)
                      (match (n-op parent) (New [shape] (= shape SHAPE-ROOT)) (_ false))))))
        (ArrayMark [] (fng-shape-root-object? (n-in value 1)))
        (Cast [_] (fng-shape-root-object? (n-in value 1)))
        (_ false))))

(defn fng-field-load-value [(context FngContext)
                            (node i64)
                            (object-node i64)
                            (name-node i64)
                            (raw-object i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        owner (fng-infer context object-node FNG-DYNAMIC)
        globally-compatible (fng-unique-field-index frontend name-node)
        field-index
          ;; A property name must use one representation throughout the closed world. If classes
          ;; assign the same name at incompatible offsets, prototype methods with a dynamic `this`
          ;; cannot address a shape slot soundly; route even statically-known constructor writes
          ;; through the PropertyKey table instead.
          (if (or (= globally-compatible -1) (fng-shape-root-object? raw-object))
              -1
              (if (< owner 0) globally-compatible
                  (fng-field-index frontend owner name-node)))
        field-owner
          (if (< field-index 0)
              owner
              (.owner (index (load (field (field frontend fields) data)) field-index)))
        ;; `this` reaching here as the receiver Parm is a RAW shaped pointer (exact sites pass
        ;; the receiver unboxed), so unboxing it would trap. A LEXICAL `this` is different: the
        ;; closure environment stores the receiver as a TAGGED value, so an arrow's `this`
        ;; arrives as an env-field load and must be unboxed before shaped access like any other
        ;; dynamic object. That decision is STRUCTURAL (which node produced `this`), not a type
        ;; test: a fresh Load's value type is not computed until inference runs, so comparing it
        ;; against the interned `(t-dyn)` never matches here.
        lexical-this
          (and (= (ts-kind ast object-node) TSK-THIS)
               (and (not (op-is? raw-object Parm [_]))
                    (not (op-is? raw-object Cast [_]))))
        object
          ;; The dyn test is STRUCTURAL (fng-tagged-dynamic-value?), not a seed-type read: a
          ;; fresh Load's type is not computed until inference runs, and `w.inner` — a field
          ;; load through a TAGGED (dyn-content) slot — needed this unbox and never got it
          ;; while the test compared the seed against the interned (t-dyn).
          (if (and (>= field-owner 0)
                   (or lexical-this
                       (and (fng-value-tagged? raw-object)
                            (and (not (op-is? raw-object Cast [_]))
                                 (!= (ts-kind ast object-node) TSK-THIS)))))
              ;; A GENERIC OBJECT, NOT `field-owner`'S SHAPE. `field-owner` comes from
              ;; `fng-unique-field-index`, which accepts any field of the right NAME whose local
              ;; index matches -- so two shapes that both begin with `x` share one entry and the
              ;; FIRST owner wins. That approximation is sound for the load, which needs only the
              ;; alias and the offset, and it is a lie about which object this is.
              ;;
              ;; An `Unbox` target is CHECKED by the evaluator, so the lie stopped the program:
              ;; `{x: acc}` nested inside `{inner: {x: acc}}` was unboxed as the OUTER shape
              ;; (`Unbox : obj@4` over an `obj@2`) and failed with "an Unbox input did not satisfy
              ;; its requested type". Asking only for the representation keeps the part that is
              ;; true. repros/nested-object-write-after-an-object-literal.js.
              (n-unbox! raw-object (t-obj))
              raw-object)]
    (if (and (= owner FNG-STRING) (= (ts-text ast name-node) "length"))
        (fng-jsl-call1 context "StringLength" object)
        (if (and (= owner FNG-ARRAY) (= (ts-text ast name-node) "length"))
            (fng-jsl-call1 context "ArrayLength" object)
            (if (= field-index -1)
                ;; An unshaped field lives in the ordinary PropertyKey table. Route the read
                ;; through the semantic [[Get]] operation so Object.defineProperty accessors are
                ;; observed; `%PropLoadNamed` is only a representation primitive and cannot invoke
                ;; a getter by itself.
                (fng-jsl-call2 context "GetProperty"
                               object
                               (n-string-const! (jss-from-utf8! (ts-text ast name-node))))
                (let [alias (al-get [i64] (load (load (field context aliases))) field-index)
                      shape (al-get [i64] (load (load (field context shapes))) field-owner)
                      ;; `owner < 0` MEANS THE SHAPE IS A GUESS, and this line already knew it: the
                      ;; memory below switches to `fng-compatible-field-memory` for exactly that
                      ;; case, because `field-owner` then comes from `fng-unique-field-index` --
                      ;; any field of the right NAME at a matching local index, first owner wins.
                      ;; The Cast was asserting that guess as fact, so `{x: acc}` inside
                      ;; `{inner: {x: acc}}` was cast to the OUTER shape and the evaluator stopped
                      ;; with "a Cast was not satisfied: the compiler narrowed without proof".
                      ;;
                      ;; The alias carries the offset either way, so dropping to a plain object
                      ;; type costs precision and nothing else.
                      ;; repros/nested-object-write-after-an-object-literal.js.
                      cast-node (n-new2 (Cast (if (< owner 0) (t-obj) (t-obj-shape shape)))
                                        (load (load (field context ctrl)))
                                        object)]
                  (n-load-at! (load (load (field context ctrl)))
                              (if (< owner 0)
                                  (fng-compatible-field-memory context name-node field-index)
                                  (fng-current-memory context alias))
                              cast-node alias)))))))

(defn fng-field-load [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object-node (ts-role ast node TS-ROLE-OBJECT 0)
        name-node (ts-role ast node TS-ROLE-PROPERTY 0)
        symbol (fe-resolution-symbol frontend object-node)
        builtin-constructor
          (or (= symbol FE-INTRINSIC-OBJECT)
              (or (= symbol FE-INTRINSIC-ARRAY)
                  (or (= symbol FE-INTRINSIC-STRING)
                      (or (= symbol FE-INTRINSIC-NUMBER)
                          (= symbol FE-INTRINSIC-BOOLEAN)))))]
    ;; Built-in constructors are opaque tagged identities with their observable own properties in
    ;; the DSL property heap. They have no static object layout to load from; syntax resolution is
    ;; used only to choose that representation path, while generic GetProperty owns the operation.
    (if builtin-constructor
        (fng-jsl-call2 context "GetProperty"
                       (fng-expression context object-node)
                       (n-string-const! (jss-from-utf8! (ts-text ast name-node))))
        (fng-field-load-value context node object-node name-node
                              (fng-expression context object-node)))))

(defn fng-optional-field-load [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object-node (ts-role ast node TS-ROLE-OBJECT 0)
        name-node (ts-role ast node TS-ROLE-PROPERTY 0)
        object (fng-expression context object-node)
        condition (fng-jsl-call1 context "IsNullishValue" (n-box! object))
        saved-ctrl (load (load (field context ctrl)))
        (mut symbols) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut answer) NO-NODE]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    (let [saved-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))
          arms (n-if-arms! (fng-peep (n-new2 (If) saved-ctrl condition)))]
      (set! (load (field context ctrl)) (arms-t arms))
      (let [nullish-value (n-box! (fng-undefined))
            nullish-ctrl (load (load (field context ctrl)))
            nullish-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
        (fng-restore-snapshot! context (mut symbols) (mut active) (mut snapshots) saved-start)
        (set! (load (field context ctrl)) (arms-f arms))
        (let [present-value (n-box! (fng-field-load-value context node object-node name-node object))
              present-ctrl (load (load (field context ctrl)))
              present-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
          (if (fng-merge-snapshots! context
                                    nullish-ctrl nullish-start
                                    present-ctrl present-start
                                    (mut symbols) (mut active) (mut snapshots))
              (cond (= nullish-ctrl NO-NODE) (store! answer present-value)
                    (= present-ctrl NO-NODE) (store! answer nullish-value)
                    :else
                      (let [phi (n-new (Phi (t-dyn)))]
                        (n-add-def! phi (load (load (field context ctrl))))
                        (n-add-def! phi nullish-value)
                        (n-add-def! phi present-value)
                        (store! answer (fng-peep phi))))
              0))))
    (al-free! [i64] (mut symbols))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

(defn fng-static-nonindex-key? [(ast TsAst) (node i64)] (-> bool)
  (let [kind (ts-kind ast node)]
    (or (= kind TSK-STRING-LITERAL)
        (or (and (= kind TSK-PREFIX-UNARY)
                 (let [text (ts-text ast node)]
                   (and (> (slice-len text) 0) (= (substr text 0 1) "-"))))
            (and (= kind TSK-NUMERIC-LITERAL)
                 (match (str-parse-int (ts-text ast node))
                   (Some [_] false)
                   (None [] true)))))))

(defn fng-nonindex-key-text [(ast TsAst) (node i64)] (-> (slice u8))
  (let [text (ts-text ast node)]
    (if (= (ts-kind ast node) TSK-STRING-LITERAL)
        (substr text 1 (- (slice-len text) 1))
        text)))

;; A string receiver with a numeric-looking key. Both halves have to be known: `o[i]` on a dynamic
;; receiver stays on the property path, because a string is only one of the things it might be.
(defn fng-string-element? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (and (= (fng-infer context (ts-child ast node 0) FNG-DYNAMIC) FNG-STRING)
         (= (fng-infer context (ts-child ast node 1) FNG-DYNAMIC) FNG-NUMBER))))

(defn fng-string-element [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        key-node (ts-child ast node 1)
        string (fng-expression context (ts-child ast node 0))
        key (fng-expression context key-node)]
    ;; Do not truncate a Number key in the frontend. ToPropertyKey and the string exotic object's
    ;; canonical-index recognition are JavaScript semantics: GetProperty owns both in lib/, and
    ;; the runtime PropertyKey primitive then performs only representation-level lookup.
    (fng-jsl-call2 context "GetProperty" string key)))

(defn fng-lvalue [(context FngContext) (node i64)] (-> FngLValue)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)
        (mut value) (zeroed FngLValue)]
    (if (= kind TSK-IDENTIFIER)
        (do
          (set! (.kind value) FNG-LVALUE-LOCAL)
          (set! (.symbol value) (fe-resolution-symbol frontend node))
          0)
        (if (= kind TSK-PROPERTY-ACCESS)
            (let [object-node (ts-child ast node 0)
                  name-node (ts-child ast node 1)
                  owner (fng-infer context object-node FNG-DYNAMIC)
                  object-value (fng-expression context object-node)
                  globally-compatible (fng-unique-field-index frontend name-node)
                  field-index
                    ;; Same SHAPE-ROOT veto as `fng-field-load-value`: a certainly-dynamic
                    ;; object's writes go through the PropertyKey table whatever static shape
                    ;; happens to share the name.
                    (if (or (= globally-compatible -1) (fng-shape-root-object? object-value))
                        -1
                        (if (< owner 0) globally-compatible
                            (fng-field-index frontend owner name-node)))
                  field-owner
                    (if (< field-index 0)
                        owner
                        (.owner (index (load (field (field frontend fields) data)) field-index)))]
              (set! (.kind value) FNG-LVALUE-FIELD)
              (set! (.object value) object-value)
              (if (= field-index -1)
                  (do
                    (set! (.kind value) FNG-LVALUE-PROPERTYKEY)
                    (set! (.key value) (n-string-const! (jss-from-utf8! (ts-text ast name-node))))
                    (set! (.shape value) -1)
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    0)
                  (do
                    (set! (.alias value) (al-get [i64] (load (load (field context aliases))) field-index))
                    (set! (.shape value) (al-get [i64] (load (load (field context shapes))) field-owner))
                    0)))
            (let [object-node (ts-child ast node 0)
                  key-node (ts-child ast node 1)]
              (if (and (= (fng-infer context object-node FNG-DYNAMIC) FNG-ARRAY)
                       (fng-static-nonindex-key? ast key-node))
                  (do
                    (set! (.kind value) FNG-LVALUE-PROPERTYKEY)
                    (set! (.object value) (fng-expression context object-node))
                    (set! (.key value)
                          (n-string-const!
                            (jss-from-utf8! (fng-nonindex-key-text ast key-node))))
                    (set! (.shape value) -1)
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    0)
                  (do
                    (set! (.kind value)
                          (if (= (fng-infer context key-node FNG-DYNAMIC) FNG-NUMBER)
                              FNG-LVALUE-ELEMENT
                              FNG-LVALUE-PROPERTYKEY))
                    (set! (.object value) (fng-expression context object-node))
                    (let [key (fng-expression context key-node)]
                      (set! (.key value)
                            (if (= (.kind value) FNG-LVALUE-ELEMENT)
                                (fng-int-value context key-node key)
                                key)))
                    0)))))
    (load value)))

;; THE OBJECT OPERAND OF A FIELD ACCESS HAS TO BE A RAW POINTER, and a `Cast` does not make it
;; one: `Cast` relabels the TYPE and leaves the machine word alone. When the object itself came
;; out of a `dyn` slot -- `o.inner.x` where `inner` is a tagged field -- the word is a boxed value
;; and the Store below took a tagged pointer (`Cast is tagged, needs raw-ptr`). The unbox has to
;; happen before the cast.
;;
;; ASSERT ONLY WHAT IS PROVEN. `fng-lvalue` records a shape from `fng-unique-field-index`, which
;; accepts any field of the right NAME whose local index matches -- so two shapes that both begin
;; with `x` share one entry and the FIRST owner wins. That approximation is sound for the load and
;; the store, which need only the alias and the offset, and it is a lie about which object this is.
;;
;; The evaluator checks both `Unbox` targets and `Cast` targets, so the lie stopped the program
;; either way: first as `Unbox : obj@4` over an `obj@2` ("an Unbox input did not satisfy its
;; requested type"), then, once the unbox was made generic, as the Cast ("a Cast was not satisfied:
;; the compiler narrowed without proof"). So when the object arrives tagged -- the case where the
;; frontend is working from the approximate shape rather than a known allocation -- neither the
;; unbox nor the cast names a shape. Only the representation is claimed, which is the part that is
;; true, and the alias still carries the offset.
;;
;; Both the read and the write build this, so they build it here. The write was the half the
;; verifier rejected, because `v-rep-slot-required` pins the Store's pointer slot and not the
;; Load's -- which made the read look correct rather than making it correct.
;; repros/nested-object-write-after-an-object-literal.js.
(defn fng-object-pointer [(context FngContext) (shape i64) (object i64)] (-> i64)
  (if (fng-value-tagged? object)
      (n-new2 (Cast (t-obj))
              (load (load (field context ctrl)))
              (n-unbox! object (t-obj)))
      (n-new2 (Cast (t-obj-shape shape))
              (load (load (field context ctrl)))
              object)))

(defn fng-lvalue-read [(context FngContext) (value FngLValue)] (-> i64)
  (if (= (.kind value) FNG-LVALUE-LOCAL)
      (fng-symbol-node context (.symbol value))
      (if (= (.kind value) FNG-LVALUE-FIELD)
          (if (= (.shape value) -1)
              (fng-jsl-call2 context "GetNamedProperty"
                             (.object value)
                             (fng-const (.key value)))
              (let [cast-node (fng-object-pointer context
                                                  (.shape value)
                                                  (.object value))]
                (n-load! (fng-current-memory context (.alias value))
                         cast-node
                         (.alias value))))
          (if (= (.kind value) FNG-LVALUE-ELEMENT)
              (fng-jsl-call2 context "GetElement"
                             (.object value)
                             (.key value))
              (fng-jsl-call2 context "GetProperty"
                             (.object value)
                             (.key value))))))

(defn fng-element-load-value [(context FngContext)
                              (object-node i64)
                              (object i64)
                              (key-node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (and (= (fng-infer context object-node FNG-DYNAMIC) FNG-ARRAY)
             (fng-static-nonindex-key? ast key-node))
        (do (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
            (fng-jsl-call2 context "GetNamedProperty"
                           object
                           (fng-const (shape-name-intern! (fng-nonindex-key-text ast key-node)))))
        (let [key (fng-expression context key-node)]
          (if (= (fng-infer context key-node FNG-DYNAMIC) FNG-NUMBER)
              (fng-jsl-call2 context "GetElement"
                             object
                             (fng-int-value context key-node key))
              (fng-jsl-call2 context "GetProperty" object key))))))

(defn fng-optional-element-load [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object-node (ts-role ast node TS-ROLE-OBJECT 0)
        key-node (ts-role ast node TS-ROLE-ELEMENT 0)
        object (fng-expression context object-node)
        condition (fng-jsl-call1 context "IsNullishValue" (n-box! object))
        saved-ctrl (load (load (field context ctrl)))
        (mut symbols) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut answer) NO-NODE]
    ;; A computed key is part of the present arm. Its assignments and heap effects must not leak
    ;; from the nullish arm, and must be merged when it does execute.
    (fng-assigned! frontend key-node (mut symbols))
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    (let [saved-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))
          arms (n-if-arms! (fng-peep (n-new2 (If) saved-ctrl condition)))]
      (set! (load (field context ctrl)) (arms-t arms))
      (let [nullish-value (n-box! (fng-undefined))
            nullish-ctrl (load (load (field context ctrl)))
            nullish-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
        (fng-restore-snapshot! context (mut symbols) (mut active) (mut snapshots) saved-start)
        (set! (load (field context ctrl)) (arms-f arms))
        (let [present-value (n-box! (fng-element-load-value context object-node object key-node))
              present-ctrl (load (load (field context ctrl)))
              present-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
          (if (fng-merge-snapshots! context
                                    nullish-ctrl nullish-start
                                    present-ctrl present-start
                                    (mut symbols) (mut active) (mut snapshots))
              (cond (= nullish-ctrl NO-NODE) (store! answer present-value)
                    (= present-ctrl NO-NODE) (store! answer nullish-value)
                    :else
                      (let [phi (n-new (Phi (t-dyn)))]
                        (n-add-def! phi (load (load (field context ctrl))))
                        (n-add-def! phi nullish-value)
                        (n-add-def! phi present-value)
                        (store! answer (fng-peep phi))))
              0))))
    (al-free! [i64] (mut symbols))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

(defn fng-lvalue-write [(context FngContext) (target FngLValue) (new-value i64)] (-> i64)
  (if (= (.kind target) FNG-LVALUE-LOCAL)
      (do (fng-set-symbol! context (.symbol target) new-value) new-value)
      (if (= (.kind target) FNG-LVALUE-FIELD)
          (if (= (.shape target) -1)
              (fng-jsl-call3 context "SetNamedProperty"
                             (.object target)
                             (fng-const (.key target))
                             new-value)
              (let [alias (.alias target)
                    cast-node (fng-object-pointer context
                                                (.shape target)
                                                (.object target))
                    ;; THE SLOT'S REPRESENTATION DECIDES, not an exact match on its type id. The
                    ;; test here used to be `(= (shape-alias-ty alias) (t-flt))`, which is one of
                    ;; the several types `shape-alias-rep` calls raw: a field typed `int`, `bool`
                    ;; or a numeric union took the fallthrough and a boxed value went straight
                    ;; into a raw slot. That is invisible until the verifier runs, and only
                    ;; because the verifier was already classifying by representation -- the two
                    ;; now read the same function. See repros/field-copy-stays-boxed.js.
                    stored-value (fng-coerce-to-alias alias new-value)
                    stored
                      (n-store! (fng-current-memory context alias) cast-node stored-value alias)]
                ;; `fng-preserve-active-memory` RATHER THAN A THIRD HAND-ROLLED MERGE. This walked
                ;; the declared field aliases and nothing else, so a store to `o.v` dropped the
                ;; runtime property heap out of the merge -- and `fng-current-memory` answers a
                ;; missing alias by manufacturing a fresh `Arg`, which restarts that alias's store
                ;; chain from nothing. `let xs = [(o.v = 1, 5), (o.v = 2, 6)]` kept only the last
                ;; element store and read a hole at index 0. The shared helper preserves the
                ;; dynamic aliases and the closure cell as well, which this also owed.
                (set! (load (field context memory))
                      (fng-preserve-active-memory context stored))
                ;; Keep the DSL property heap synchronized with the static slot. Computed reads
                ;; and own-key enumeration observe that heap; the slot remains a representation
                ;; optimization for statically resolved reads.
                (fng-jsl-call3 context "SetNamedProperty"
                               (.object target)
                               (fng-const (.key target))
                               new-value)
                new-value))
          (if (= (.kind target) FNG-LVALUE-ELEMENT)
              (fng-jsl-call3 context "SetElement"
                             (.object target)
                             (.key target)
                             new-value)
              (fng-jsl-call3 context "SetProperty"
                             (.object target)
                             (.key target)
                             new-value)))))

(defn fng-update-local [(context FngContext) (node i64) (prefix bool)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        target (fng-lvalue context (ts-child ast node 0))
        raw-old (fng-lvalue-read context target)
        ;; ASK THE VALUE, NOT ITS DECLARED TYPE. This tested `fng-infer ... = FNG-DYNAMIC`, which is
        ;; a claim about the SOURCE and not about the machine word: every `Math.*` call returns a
        ;; `ToNumber`, which is tagged, while inference reports the local as a plain number. So
        ;; `Math.trunc(x)` followed by `i++` skipped the unbox and fed a tagged word to an Add that
        ;; needs a raw one -- `Add slot 1 <- ToNumber is tagged, needs raw-num`.
        ;;
        ;; `fng-machine-number-value?` is the question actually being asked: does this value carry
        ;; a raw machine number? It follows the graph with fuel instead of trusting a seed type,
        ;; which is what a representation decision requires. Same lesson as `fng-loose-equal`.
        ;; repros/truncate-then-increment-stays-tagged.js.
        raw-number (fng-machine-number-value? raw-old 8)
        text (ts-text ast node)
        length (slice-len text)
        operator
          (if prefix
              (if (>= length 2) (substr text 0 2) "")
              (if (>= length 2) (substr text (- length 2) length) ""))
        ;; `++` IS ToNumeric THEN A NUMERIC ADD, and both halves are the DSL's: `x++` on a string
        ;; is NaN, never concatenation, so the coercion comes first and `JsAdd`'s concat arm can
        ;; never fire. The spec also says POSTFIX returns the COERCED old value, not the raw one.
        ;; For a proven raw number the guards fold and the unboxes below cancel, so `i++` in a
        ;; counted loop still costs one Add.
        old-value (fng-jsl-call1 context "ToNumberValue"
                                 (fng-box-dynamic-argument! raw-old))
        new-value (fng-arith2 context
                              (if (= operator "++") "JsAdd" "JsSub")
                              old-value
                              (fng-const 1))
        ;; Write back in the REPRESENTATION the local already had, so a later read is consistent
        ;; with every other reader of the same symbol. That is the frontend's one remaining
        ;; decision here, and it is structural: `fng-machine-number-value?` follows the graph.
        value (if raw-number (n-unbox! new-value (t-flt)) new-value)]
    (fng-lvalue-write context target value)
    (if prefix value (if raw-number (n-unbox! old-value (t-flt)) old-value))))

;; Lower a value-producing branch. An arm node of -1 uses its already-evaluated fixed value; this
;; is how && and || evaluate their left operand once while still returning that operand.
(defn fng-branch-expression [(context FngContext)
                             (condition i64)
                             (then-node i64)
                             (then-fixed i64)
                             (else-node i64)
                             (else-fixed i64)
                             (box-arms bool)] (-> i64)
  (let [frontend (load (field context frontend))
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        saved-ctrl (load (load (field context ctrl)))
        heap-arms
          (or (and (!= then-node -1)
                   (or (fng-node-has-kind frontend then-node TSK-CALL)
                       (or (fng-node-has-kind frontend then-node TSK-NEW-EXPRESSION)
                           (or (fng-node-has-kind frontend then-node TSK-PROPERTY-ACCESS)
                               (fng-node-has-kind frontend then-node TSK-ELEMENT-ACCESS)))))
              (and (!= else-node -1)
                   (or (fng-node-has-kind frontend else-node TSK-CALL)
                       (or (fng-node-has-kind frontend else-node TSK-NEW-EXPRESSION)
                           (or (fng-node-has-kind frontend else-node TSK-PROPERTY-ACCESS)
                               (fng-node-has-kind frontend else-node TSK-ELEMENT-ACCESS))))))
        (mut answer) NO-NODE]
    (if (!= then-node -1) (fng-assigned! frontend then-node (mut changed)) 0)
    (if (!= else-node -1) (fng-assigned! frontend else-node (mut changed)) 0)
    ;; Expression arms can call any transitioning JSL macro. Snapshot the same conservative alias
    ;; set as statement `if`, including the runtime property/array heap, before either arm exists.
    (if heap-arms
        (do (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
            (fng-active-memory! context (mut active))
            (fng-control-aliases! context (mut active)))
        0)
    (let [saved-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))
          arms (n-if-arms! (fng-peep (n-new2 (If) saved-ctrl condition)))]
      (set! (load (field context ctrl)) (arms-t arms))
      (let [raw-then-value (if (= then-node -1) then-fixed (fng-expression context then-node))
            then-value (if box-arms (n-box! raw-then-value) raw-then-value)
            then-ctrl (load (load (field context ctrl)))
            then-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
        (fng-restore-snapshot! context (mut changed) (mut active) (mut snapshots) saved-start)
        (set! (load (field context ctrl)) (arms-f arms))
        (let [raw-else-value (if (= else-node -1) else-fixed (fng-expression context else-node))
              else-value (if box-arms (n-box! raw-else-value) raw-else-value)
              else-ctrl (load (load (field context ctrl)))
              else-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
          (if (fng-merge-snapshots! context
                                    then-ctrl then-start
                                    else-ctrl else-start
                                    (mut changed) (mut active) (mut snapshots))
              (cond (= then-ctrl NO-NODE) (store! answer else-value)
                    (= else-ctrl NO-NODE) (store! answer then-value)
                    :else
                      (let [value-phi (n-new (Phi (t-dyn)))]
                        (n-add-def! value-phi (load (load (field context ctrl))))
                        (n-add-def! value-phi then-value)
                        (n-add-def! value-phi else-value)
                        (store! answer (fng-peep value-phi))))
              0))))
    (al-free! [i64] (mut changed))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

;; A TYPED CONTEXT IS A REPRESENTATION BOUNDARY, decided HERE from the DECLARED type, because the
;; declaration is the one fact available while the graph is still being built. The value's shape
;; cannot decide it: the DSL's arithmetic returns its result TAGGED behind guards that have not
;; folded yet -- `n + 1` at this point is a `Phi dyn` over the concat and numeric arms -- so a
;; shape test written against the folded boxed-Add shape never fires. (`fng-return-representation` was
;; exactly that test; it matched nothing, and `main` returned a NaN-boxed word to a native caller
;; expecting a raw number.)
;;
;; This used to live inside the identifier case only, which coerced `return n` and left `return
;; n + 1` tagged. It applies to EVERY expression a number-typed context consumes: `fng-number-value`
;; leaves alone what is already raw, so a literal or raw arithmetic chain costs nothing, and a
;; tagged value takes the DSL's `ToNumberValue`, whose guards fold against the producer's own
;; boxing once analysis proves the types.
(defn fng-expression-expected [(context FngContext) (node i64) (expected i64)] (-> i64)
  (let [value (fng-expression-lowered context node expected)]
    (if (and (= expected FNG-NUMBER) (!= value NO-NODE))
        (fng-number-value context node value)
        value)))

(defn fng-expression-lowered [(context FngContext) (node i64) (expected i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-IDENTIFIER)
            (let [symbol (fe-resolution-symbol frontend node)]
              (cond (= symbol FE-INTRINSIC-UNDEFINED) (fng-undefined)
                    (= symbol FE-INTRINSIC-NAN) (n-new1 (Const (t-flt-bits JSV-NAN)) (g-start))
                    (= symbol FE-INTRINSIC-INFINITY) (fng-jsl-call0 context "Infinity")
                    (= symbol FE-INTRINSIC-ERROR) (fng-error-constructor-value context node)
                    (or (= symbol FE-INTRINSIC-OBJECT)
                        (or (= symbol FE-INTRINSIC-ARRAY)
                            (or (= symbol FE-INTRINSIC-STRING)
                                (or (= symbol FE-INTRINSIC-NUMBER)
                                    (= symbol FE-INTRINSIC-BOOLEAN)))))
                      (fng-builtin-constructor-value context symbol)
                    (= symbol FE-INTRINSIC-UNBOUND) (fng-unbound-reference context node)
                    (< symbol 0) NO-NODE
                    :else
                      (let [stored (fng-symbol-node context symbol)
                            declaration
                              (fe-find-function-name-in-owner frontend node (.owner context))
                            ; The stored binding wins whenever it holds a value: a nested
                            ; declaration's binding is its materialized CLOSURE, and preferring
                            ; the bare Fun here handed callers an environment-less callable.
                            ; The resolved lexical function id is the hoisting fallback for a name
                            ; read before its statement was reached.
                            value
                              (if (= stored NO-NODE)
                                  (if (>= declaration 0)
                                      (al-get [i64]
                                              (load (load (field context functions)))
                                              declaration)
                                      stored)
                                  stored)]
                        value)))
          (= kind TSK-THIS) (load (field context receiver))
          (= kind TSK-NUMERIC-LITERAL)
            (fng-numeric-literal ast node)
          (= kind TSK-STRING-LITERAL) (fng-string-literal ast node)
          (= kind TSK-TEMPLATE-EXPRESSION) (fng-template-expression context node)
          (= kind TSK-NULL) (fng-null)
          (= kind TSK-TRUE) (fng-bool true)
          (= kind TSK-FALSE) (fng-bool false)
          (= kind TSK-PARENTHESIZED-EXPRESSION) (fng-expression-expected context (ts-child ast node 0) expected)
          (= kind TSK-PREFIX-UNARY)
            (let [text (ts-text ast node)
                  length (slice-len text)
                  operator (if (> length 0) (substr text 0 1) "")]
              (if (or (and (>= length 2) (= (substr text 0 2) "++"))
                      (and (>= length 2) (= (substr text 0 2) "--")))
                  (fng-update-local context node true)
                  (let [source (ts-child ast node 0)
                        value (fng-expression context source)]
                    ;; UNARY `+` IS ToNumber, NOT A NO-OP. This returned the operand unchanged,
                    ;; which is right for a number and wrong for everything else: `+String(acc)`
                    ;; handed a string straight to the arithmetic that consumed it. The same
                    ;; guarded coercion unary `-` already uses is what this needs, and
                    ;; `fng-number-value` exempts values that are already machine numbers, so
                    ;; `+x` on a number still costs nothing.
                    ;; repros/unary-plus-does-not-coerce.js.
                    ;; UNARY `+` IS ToNumber, NOT A NO-OP. This returned the operand unchanged,
                    ;; which is right for a number and wrong for everything else: `+String(acc)`
                    ;; handed a string straight to the arithmetic that consumed it.
                    ;;
                    ;; `fng-number-value` is not enough either, because `fng-needs-to-number?`
                    ;; asks whether the value is `dyn` -- and a string is not `dyn`, so it was
                    ;; waved through a second time. The question is whether the value IS a number,
                    ;; which is what `fng-machine-number-value?` answers; `ToNumberValue` carries
                    ;; the spec's own "already a Number" step, so the guarded call costs nothing on
                    ;; the numeric path. Same lesson as `fng-loose-equal`.
                    ;; repros/unary-plus-does-not-coerce.js.
                    (cond (= operator "+")
                            (if (= (fng-infer context source FNG-DYNAMIC) FNG-STRING)
                                ;; The same lowering `Number(x)` uses, BOXING FIRST. Reaching
                                ;; `ToNumberValue` through `fng-to-number-operand` instead --
                                ;; which passes the operand unboxed, because its callers hand it
                                ;; an already-tagged `dyn` -- left the string's node collected out
                                ;; from under the inlined macro and produced `VERR-DEAD-INPUT`.
                                (n-unbox! (fng-jsl-call1 context "ToNumberValue" (n-box! value))
                                          (t-flt))
                                value)
                          ;; `!` IS THE DSL'S `LogicalNot`. The hand-written form was
                          ;; `value == 0` with a StringLength detour when inference said string --
                          ;; wrong for every operand inference could not classify, exactly like
                          ;; the relational operators before their migration.
                          (= operator "!")
                            (fng-jsl-call1 context "LogicalNot" (n-box! value))
                          ;; UNARY `-` IS THE DSL'S `JsNegate`, the last arithmetic operator that
                          ;; was still hand-written here as `Sub(0, ToNumber(x))`. Same argument
                          ;; as the binary operators at `fng-arith2`: the coercion is ECMAScript's,
                          ;; and the guards fold to a bare negate when the operand proves numeric.
                          (= operator "-")
                            (fng-arith1 context "JsNegate" value)
                          (= operator "~")
                            (fng-bitwise1 context "BitwiseNot" value)
                          :else NO-NODE))))
          (= kind TSK-POSTFIX-UNARY) (fng-update-local context node false)
          (= kind TSK-VOID-EXPRESSION)
            (fng-jsl-call1 context "VoidValue"
                           (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0)))
          (= kind TSK-DELETE-EXPRESSION)
            (let [target (ts-role ast node TS-ROLE-EXPRESSION 0)
                  object-node (ts-child ast target 0)
                  name-node (ts-child ast target 1)]
              (if (= (ts-kind ast target) TSK-PROPERTY-ACCESS)
                  (fng-jsl-call2 context "DeleteProperty"
                                 (fng-expression context object-node)
                                 (n-string-const! (jss-from-utf8! (ts-text ast name-node))))
                  (fng-jsl-call2 context "DeleteProperty"
                                 (fng-expression context object-node)
                                 (fng-expression context name-node))))
          (= kind TSK-TYPEOF-EXPRESSION)
            (let [source (ts-role ast node TS-ROLE-EXPRESSION 0)
                  expected (fng-infer context source FNG-DYNAMIC)
                  value (fng-expression context source)]
              (fng-jsl-call1 context "TypeOfValue"
                ;; `typeof` observes an ordinary expression value. Callback specialization is
                ;; only for APIs that invoke a statically known callback; applying it here could
                ;; replace a parameter with an unrelated function sharing its symbol id.
                ;;
                ;; Dynamic, numeric, array, and structural-object parameters already use the
                ;; tagged JavaScript ABI (see `fng-call-argument`). Boxing such a Parm again turns
                ;; a captured closure into an object-looking pointer. String and boolean
                ;; parameters are raw and still need the ordinary box below.
                (if (and (op-is? value Parm [_])
                         (or (>= expected 0)
                             (or (= expected FNG-DYNAMIC)
                                 (or (= expected FNG-NUMBER) (= expected FNG-ARRAY)))))
                    value
                    (n-box! value))))
          (= kind TSK-CONDITIONAL-EXPRESSION)
            (let [condition-node (ts-role ast node TS-ROLE-CONDITION 0)
                  then-node (ts-role ast node TS-ROLE-WHEN-TRUE 0)
                  else-node (ts-role ast node TS-ROLE-WHEN-FALSE 0)
                  condition (fng-condition-representation context condition-node)]
              ;; THE ARMS ARE BOXED, and they have to be: `n > 0 ? "yes" : 5` merges a raw string
              ;; pointer with a raw integer into one Phi, and nothing downstream can read both. The
              ;; consumer that noticed was `String(v)`, which took the runtime's tag dispatch on an
              ;; untagged `5` and printed "2.4703282292062327e-323" -- the double whose bit pattern
              ;; is 5, twenty-three characters where node prints one.
              ;;
              ;; Boxing unconditionally rather than deciding per pair is the same bargain the rest
              ;; of this file takes: `box-idealize` peels the box off an arm that was already
              ;; tagged, and `Unbox(Box(v))` cancels for a numeric consumer, so `n > 0 ? 3 : 5`
              ;; reaching arithmetic still compiles to the raw phi it did before.
              (fng-branch-expression context condition then-node NO-NODE else-node NO-NODE true))
          (= kind TSK-BINARY)
            (let [left-node (ts-child ast node 0)
                  operator (ts-text ast (ts-child ast node 1))
                  right-node (ts-child ast node 2)]
              (if (or (= operator "&&")
                      (or (= operator "||") (= operator "??")))
                  (let [left (fng-expression context left-node)]
                    (if (= operator "??")
                        (fng-branch-expression context
                                               (fng-jsl-call1 context "IsNullishValue" (n-box! left))
                                               right-node
                                               NO-NODE
                                               -1
                                               left
                                               true)
                    ;; A string-valued condition BOXES rather than measuring its length -- `If`
                    ;; owns truthiness; see `fng-condition-representation`.
                    (if (= operator "&&")
                        (fng-branch-expression context
                                               (if (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                   (n-box! left)
                                                   left)
                                               right-node
                                               NO-NODE
                                               -1
                                               left
                                               false)
                        (fng-branch-expression context
                                               (if (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                   (n-box! left)
                                                   left)
                                               -1
                                               left
                                               right-node
                                               NO-NODE
                                               false))))
                  (if (or (= operator "=")
                          (or (= operator "+=")
                              (or (= operator "-=")
                                  (or (= operator "*=")
                                      (or (= operator "/=")
                                          (or (= operator "%=")
                                              (or (= operator "&=")
                                                  (or (= operator "|=")
                                                      (or (= operator "^=")
                                                          (or (= operator "<<=")
                                                              (or (= operator ">>=")
                                                                  (= operator ">>>="))))))))))))
                      (let [target (fng-lvalue context left-node)
                            left
                              (if (= operator "=")
                                  NO-NODE
                                  (fng-lvalue-read context target))
                            right (fng-expression context right-node)
                            value
                              (cond (= operator "=") right
                                    (= operator "+=")
                                      (fng-arith2 context "JsAdd" left right)
                                    (= operator "-=")
                                      (fng-arith2 context "JsSub" left right)
                                    (= operator "*=")
                                      (fng-arith2 context "JsMul" left right)
                                    (= operator "/=")
                                      (fng-arith2 context "JsDiv" left right)
                                    (= operator "%=")
                                      (fng-arith2 context "JsMod" left right)
                                    (= operator "&=")
                                      (fng-bitwise2 context "BitwiseAnd" left right)
                                    (= operator "|=")
                                      (fng-bitwise2 context "BitwiseOr" left right)
                                    (= operator "^=")
                                      (fng-bitwise2 context "BitwiseXor" left right)
                                    (= operator "<<=")
                                      (fng-bitwise2 context "ShiftLeft" left right)
                                    (= operator ">>=")
                                      (fng-bitwise2 context "ShiftRight" left right)
                                    :else
                                      (fng-bitwise2 context "ShiftRightUnsigned" left right))]
                        (if (= value NO-NODE)
                            (do (panic-corrupt (ts-text ast node)) 0)
                            0)
                        (fng-lvalue-write context target value))
                      (let [left (fng-expression context left-node)
                            right (fng-expression context right-node)]
                        (cond (= operator "+")
                                (fng-arith2 context "JsAdd" left right)
                              (= operator "-")
                                (fng-arith2 context "JsSub" left right)
                              (= operator "*")
                                (fng-arith2 context "JsMul" left right)
                              (= operator "/")
                                (fng-arith2 context "JsDiv" left right)
                              (= operator "%")
                                (fng-arith2 context "JsMod" left right)
                              (= operator "&")
                                (fng-bitwise2 context "BitwiseAnd" left right)
                              (= operator "|")
                                (fng-bitwise2 context "BitwiseOr" left right)
                              (= operator "^")
                                (fng-bitwise2 context "BitwiseXor" left right)
                              (= operator "<<")
                                (fng-bitwise2 context "ShiftLeft" left right)
                              (= operator ">>")
                                (fng-bitwise2 context "ShiftRight" left right)
                              (= operator ">>>")
                                (fng-bitwise2 context "ShiftRightUnsigned" left right)
                              ;; THE RELATIONAL OPERATORS ARE THE DSL'S, not four hand-written
                              ;; shapes. Each was a static test -- "did inference say both sides
                              ;; are strings?" -- with a numeric compare as the fallback, over a
                              ;; coercion helper that only fires on `dyn`. A string beside a number
                              ;; matched neither, and `"5" < 6` stopped the evaluator where node
                              ;; says true.
                              ;;
                              ;; `>` and `>=` are the same operations with the operands swapped,
                              ;; which is what the spec says they are; `<=` is NOT `not (< )` and
                              ;; has its own definition, because that identity is false for NaN.
                              ;; See docs/DSL-OWNERSHIP.md.
                              (= operator "<")
                                (fng-relational context "IsLessThan" left right)
                              (= operator "<=")
                                (fng-relational context "IsLessEqual" left right)
                              (= operator ">")
                                (fng-relational context "IsLessThan" right left)
                              (= operator ">=")
                                (fng-relational context "IsLessEqual" right left)
                              ;; `===` AND `!==` ARE THE DSL'S, WHOLE. The number/number and
                              ;; string/string fast paths that lived here were the compiler
                              ;; holding an opinion about what strict equality means; the
                              ;; specialisation is in `StrictEqual` itself, which leads with the
                              ;; Number/Number case so proven operands fold to one compare. The
                              ;; negation is `StrictNotEqual` -- spelling it here as `== 0` was
                              ;; itself a hand-written semantic.
                              (= operator "===")
                                (fng-jsl-call2 context "StrictEqual"
                                               (fng-box-dynamic-argument! left)
                                               (fng-box-dynamic-argument! right))
                              (= operator "!==")
                                (fng-jsl-call2 context "StrictNotEqual"
                                               (fng-box-dynamic-argument! left)
                                               (fng-box-dynamic-argument! right))
                              ;; `==` AND `!=` ARE THE DSL'S, WHOLE. The nullish-literal and
                              ;; string/string dispatches that lived here were pre-specialisations
                              ;; of `LooseEqual`'s own leading cases: `x == null` folds through
                              ;; the IsNullish guards because the null constant's kinds prove
                              ;; them, and two proven strings fold to the StringEquals arm.
                              (= operator "!=")
                                (fng-jsl-call2 context "LooseNotEqual"
                                               (fng-box-dynamic-argument! left)
                                               (fng-box-dynamic-argument! right))
                              (= operator "==")
                                (fng-jsl-call2 context "LooseEqual"
                                               (fng-box-dynamic-argument! left)
                                               (fng-box-dynamic-argument! right))
                              (= operator "in")
                                (if (or (= (ts-kind ast left-node) TSK-STRING-LITERAL)
                                        (= (ts-kind ast left-node) TSK-NUMERIC-LITERAL))
                                    (fng-jsl-call2 context "HasNamedProperty"
                                                   right
                                                   (fng-const
                                                     (fng-static-property-name ast left-node)))
                                    (fng-jsl-call2 context "HasProperty" right left))
                              (= operator "instanceof")
                                (if (and (= (ts-kind ast right-node) TSK-IDENTIFIER)
                                         (= (fe-resolution-symbol frontend right-node)
                                            FE-INTRINSIC-ERROR))
                                    (fng-jsl-call2 context "InstanceOfErrorValue" left right)
                                (let [constructor (fe-find-function-name frontend right-node)]
                                  (if (>= constructor 0)
                                      (let [prototype
                                              (fng-constructor-prototype! context constructor)]
                                        (fng-jsl-call2 context "OrdinaryHasInstance"
                                                       left prototype))
                                      ;; NO CONSTRUCTOR AND NO VALUE EITHER. `x instanceof Object`
                                      ;; resolves no user function, and `Object` has no value node
                                      ;; to fall back on -- it is a name this frontend knows only
                                      ;; as the owner of `Object.keys` and friends, never as a
                                      ;; value. `right` is then NO-NODE, and handing that to the
                                      ;; JSL layer aborted with `jsl argument 1 is NO-NODE`: the
                                      ;; graph was already corrupt by the time anything complained,
                                      ;; and the message named the callee rather than the source.
                                      ;;
                                      ;; The operand is checked here because this is where the
                                      ;; evidence is. See repros/instanceof-against-a-global.js.
                                      ;; A name with NO value binding may still be one of the
                                      ;; three globals whose prototype chains the runtime itself
                                      ;; maintains -- those dispatch by name to the DSL's
                                      ;; specialised predicates. A user binding named `Object`
                                      ;; never reaches here: it resolves to a constructor or a
                                      ;; value above.
                                      (if (= right NO-NODE)
                                          (let [global-name (ts-text ast right-node)]
                                            (cond (= global-name "Object")
                                                    (fng-jsl-call1 context "InstanceOfObjectValue"
                                                                   (fng-box-dynamic-argument! left))
                                                  (= global-name "Array")
                                                    (fng-jsl-call1 context "InstanceOfArrayValue"
                                                                   (fng-box-dynamic-argument! left))
                                                  :else
                                                    (fng-unsupported-syntax!
                                                      "instanceof right-operand"
                                                      (ts-kind ast right-node)
                                                      (ts-text ast right-node))))
                                          (fng-jsl-call2 context "OrdinaryInstanceOf" left right)))))
                              (= operator ",") right
                              :else NO-NODE)))))
          (= kind TSK-CALL)
            (if (fng-json-stringify? context node)
                (fng-json-stringify context node)
            (if (fng-json-parse? context node)
                (fng-json-parse context node)
            (if (fng-math-builtin? context node)
                (fng-math-call context node)
            (if (fng-number-static? context node)
                (fng-number-static context node)
            (if (fng-parse-float? context node)
                (fng-parse-float context node)
            (if (fng-number-convert? context node)
                (fng-number-convert context node)
            (if (fng-boolean-convert? context node)
                (fng-boolean-convert context node)
            (if (fng-object-convert? context node)
                (fng-object-convert context node)
            (if (fng-string-convert? context node)
                (fng-string-convert context node false)
            (if (fng-array-convert? context node)
                (fng-array-convert context node)
            (if (fng-number-to-string? context node)
                (fng-number-to-string context node)
            (if (fng-number-to-fixed? context node)
                (fng-number-to-fixed context node)
                (if (fng-array-from? context node)
                    (fng-array-from context node)
                (if (fng-array-is-array? context node)
                    (fng-array-is-array context node)
                (if (fng-array-of? context node)
                    (fng-array-of context node)
                (if (fng-array-iterator-next? context node)
                    (fng-array-iterator-next context node)
                (if (fng-object-enumeration? context node)
                    (fng-object-enumeration context node)
                (if (fng-object-assign? context node)
                    (fng-object-assign context node)
            (if (fng-object-descriptor-call? context node)
                (fng-object-descriptor-call context node)
            (if (fng-object-integrity-call? context node)
                (fng-object-integrity-call context node)
            (if (fng-object-prototype-borrowed? context node)
                (fng-object-prototype-borrowed context node)
            (if (fng-object-prototype-call? context node)
                (fng-object-prototype-call context node)
                (if (fng-object-freeze? context node)
                    (fng-object-freeze context node)
                (if (fng-string-raw? context node)
                    (fng-string-raw context node)
                (if (fng-string-from-char-code? context node)
                    (fng-string-from-char-code context node)
                    (if (fng-string-builtin? context node)
                        (fng-string-call context node)
                        (if (fng-array-builtin? context node)
                            (fng-array-call context node)
                            (fng-call context node))))))))))))))))))))))))))))
          (= kind TSK-NEW-EXPRESSION)
            (if (fng-object-convert? context node)
                (fng-object-convert context node)
            (if (fng-string-convert? context node)
                (fng-string-convert context node true)
            (if (fng-array-convert? context node)
                (fng-array-convert context node)
            (if (fng-primitive-wrapper? context node FE-INTRINSIC-NUMBER)
                (fng-primitive-wrapper context node true)
            (if (fng-primitive-wrapper? context node FE-INTRINSIC-BOOLEAN)
                (fng-primitive-wrapper context node false)
            (if (fng-error-constructor? context node)
                (fng-error-constructor context node)
                (fng-call context node)))))))
          (= kind TSK-OBJECT-LITERAL)
            (let [inferred (fe-type-index-for-decl-node frontend node)
                  dynamic (and (= expected FNG-DYNAMIC) (< inferred 0))
                  _ (fng-refuse-object-spread! context node dynamic)]
            (if dynamic
                (fng-dynamic-object context node)
                (fng-object context node (if (= expected FNG-DYNAMIC) inferred expected))))
          (= kind TSK-ARRAY-LITERAL) (fng-array-literal context node)
          (fe-function-expression-kind? kind) (fng-closure-expression context node)
          (= kind TSK-PROPERTY-ACCESS)
            (if (!= (ts-role ast node TS-ROLE-OPERATOR 0) -1)
                (fng-optional-field-load context node)
            (let [math-member (fng-math-member-id context node)]
              (if (fng-number-constant? context node)
                  (fng-jsl-call0 context (fng-number-constant-name context node))
              (if (fng-object-method-value? context node)
                  (fng-object-method-value context node)
              (if (>= math-member 0)
                  NO-NODE
                  (if (= (ts-text ast node) "Math.LN2")
                      (n-new1 (Const (t-flt-con 0.6931471805599453)) (g-start))
                      (fng-field-load context node)))))))
          (= kind TSK-ELEMENT-ACCESS)
            (if (!= (ts-role ast node TS-ROLE-OPERATOR 0) -1)
                (fng-optional-element-load context node)
                ;; `s[i]` ON A STRING IS NOT AN ARRAY LOAD. It enters the DSL's generic property
                ;; path, which applies ToPropertyKey before the runtime recognizes canonical string
                ;; indices. This distinction matters for Number keys such as NaN and -0.
                (if (fng-string-element? context node)
                    (fng-string-element context node)
                    (fng-lvalue-read context (fng-lvalue context node))))
          ;; AN UNRECOGNISED EXPRESSION KIND MUST NOT RETURN `NO-NODE`. The bridge maps every
          ;; syntax it does not enumerate to kind 0 (native/typescript-go-bridge/main.go, the
          ;; `default` of the kind switch), so this arm is where unsupported syntax arrives.
          ;; Returning NO-NODE handed a non-node to whatever asked for a value: `x as number`
          ;; segfaulted the builder, and a spread element inside an array literal was dropped
          ;; silently, so `[...a, 3]` evaluated to length 2 where node says 3. A wrong answer
          ;; with no diagnostic is strictly worse than a crash, and both are worse than saying
          ;; which construct is not supported.
          :else (do (fng-unsupported-syntax! "expression" kind (ts-text ast node)) NO-NODE))))

(defn fng-ensure-memory! [(context FngContext)] (-> i64)
  (if (and (!= (load (load (field context memory))) NO-NODE)
           (fng-memory-node? (load (load (field context memory)))))
      0
      (let [(mut active) (al-new [i64] (malloc-allocator))
            (mut memories) (al-new [i64] (malloc-allocator))
            (mut index) 0]
        ; A branch snapshot must never publish a scalar in the effect slot. Recover by
        ; re-anchoring every active alias at current control; verification still checks the
        ; resulting explicit memory graph.
        (set! (load (field context memory)) NO-NODE)
        (fng-active-memory! context (mut active))
        (loop (if (>= (load index) (al-len [i64] (load active)))
                  (break)
                  (let [field-index (al-get [i64] (load active) (load index))
                        alias (al-get [i64] (load (load (field context aliases))) field-index)]
                    (al-push! [i64] (mut memories) (fng-memory (load (load (field context ctrl))) alias))
                    (set! index (+ (load index) 1)))))
        (if (> (al-len [FeCapture] (.captures (load (field context frontend)))) 0)
            (al-push! [i64]
                      (mut memories)
                      (fng-memory (load (load (field context ctrl)))
                                  (.cell-alias context)))
            0)
        (if (> (al-len [i64] (load memories)) 0)
            (set! (load (field context memory)) (fng-merge memories))
            0)
        (al-free! [i64] (mut active))
        (al-free! [i64] (mut memories))
        0)))

;; THE RETURN IS A REPRESENTATION BOUNDARY only when the function DECLARES a numeric result, and
;; that case is handled where the return expression is lowered: `fng-statement`'s TSK-RETURN passes
;; the declared type to `fng-expression-expected`, which coerces to the raw representation the
;; native ABI reads. Nothing here inspects the value -- a shape test at this point cannot work,
;; because the DSL's guards have not folded yet (see `fng-expression-expected`).
(defn fng-add-return! [(context FngContext) (value i64)] (-> i64)
  (fng-ensure-memory! context)
  (let [ctrl (load (load (field context ctrl)))
        memory (load (load (field context memory)))]
    (if (.top-level context)
        (let [ret
                (if (= memory NO-NODE)
                    (n-new2 (Return) ctrl value)
                    (n-new3 (Return) ctrl value memory))]
          (n-add-def! (g-stop) ret)
          ret)
        (let [ret
                (if (= memory NO-NODE)
                    (n-new2 (Return) ctrl value)
                    (n-new3 (Return) ctrl value memory))
              first (load (field context first-return))
              fun (.fun context)]
          (if (= (load first) NO-NODE)
              (do (n-fun-close! fun ret) (set! first ret))
              (n-fun-add-return! fun ret))
          ret))))

;; Initialize one formal parameter after its incoming Parm has been published. Argument omission
;; and an explicit `undefined` share the same tagged value; JSL owns that classification. The
;; initializer is built only on the true control arm, preserving JavaScript's laziness and order.
(defn fng-default-parameter! [(context FngContext)
                              (fn FeFunction)
                              (ordinal i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        symbol (al-get [FeSymbol]
                       (.symbols frontend)
                       (+ (.parameter-start fn) ordinal))
        symbol-id (.id symbol)
        parameter-type (fng-parameter-type frontend fn ordinal)
        initializer (ts-role ast (.node symbol) TS-ROLE-INITIALIZER 0)]
    (if (= initializer -1)
        0
        (let [incoming (fng-symbol-node context symbol-id)
              incoming-value
                (if (= parameter-type FNG-NUMBER)
                    (fng-number-value context (.name-node symbol) incoming)
                    incoming)
              condition (fng-jsl-call1 context "IsUndefinedValue" incoming)
              saved-ctrl (load (load (field context ctrl)))
              (mut symbols) (al-new [i64] (malloc-allocator))
              (mut active) (al-new [i64] (malloc-allocator))
              (mut snapshots) (al-new [i64] (malloc-allocator))
              (mut answer) incoming-value]
          (fng-assigned! frontend initializer (mut symbols))
          (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
          (fng-active-memory! context (mut active))
          (fng-control-aliases! context (mut active))
          (let [saved-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))
                arms (n-if-arms! (fng-peep (n-new2 (If) saved-ctrl condition)))]
            (set! (load (field context ctrl)) (arms-t arms))
            (let [expected parameter-type
                  raw-default (fng-expression-expected context initializer expected)
                  default-value
                    (if (= parameter-type FNG-NUMBER)
                        raw-default
                        (fng-call-argument frontend fn ordinal raw-default))
                  default-ctrl (load (load (field context ctrl)))
                  default-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
              (fng-restore-snapshot! context (mut symbols) (mut active) (mut snapshots) saved-start)
              (set! (load (field context ctrl)) (arms-f arms))
              (let [incoming-ctrl (load (load (field context ctrl)))
                    incoming-start (fng-snapshot! context (mut symbols) (mut active) (mut snapshots))]
                (if (fng-merge-snapshots! context
                                          default-ctrl default-start
                                          incoming-ctrl incoming-start
                                          (mut symbols) (mut active) (mut snapshots))
                    (cond (= default-ctrl NO-NODE) (store! answer incoming-value)
                          (= incoming-ctrl NO-NODE) (store! answer default-value)
                          :else
                            (let [phi (n-new (Phi (if (= parameter-type FNG-NUMBER)
                                                 (t-num)
                                                 (t-dyn))))]
                              (n-add-def! phi (load (load (field context ctrl))))
                              (n-add-def! phi default-value)
                              (n-add-def! phi incoming-value)
                              (store! answer (fng-peep phi))))
                    0))))
          (fng-set-symbol! context symbol-id (load answer))
          (al-free! [i64] (mut symbols))
          (al-free! [i64] (mut active))
          (al-free! [i64] (mut snapshots))
          0))))

(defn fng-list-has [(values (ptr (ArrayList i64))) (value i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [i64] (load values))) (load found))
              (break)
              (do
                (if (= (al-get [i64] (load values) (load index)) value) (set! found true) 0)
                (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-top-level-initialize! [(context FngContext)
                                 (reachable-functions (ptr (ArrayList bool)))] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        root (ts-root ast)
        (mut index) 0]
    ; Script-level `var` bindings exist as undefined before any initializer runs. This is
    ; observable when an early function/prototype closure captures a global declared later.
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.role symbol) FE-ROLE-GLOBAL)
                         (= (fng-symbol-storage context (.id symbol)) NO-NODE))
                    (do
                      (fng-set-symbol! context (.id symbol) (fng-undefined))
                      (fng-set-symbol-type! context (.id symbol) FNG-VOID))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    ; JavaScript function declarations are objects as well as call targets. Materialize one stable
    ; object per declaration before executing top-level initializers, and publish its real
    ; `prototype` property so constructor static fields and inheritance helpers use ordinary
    ; dynamic property semantics.
    (loop (if (>= (load index) (al-len [FeFunction] (.functions frontend)))
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                ; Nested declarations belong to their lexical invocation. Publishing
                ; their function object/prototype here would embed a parent function's
                ; allocation directly in the synthetic top-level graph.
                (if (and (al-get [bool] (load reachable-functions) (load index))
                         (and (= (ts-kind ast (.node fn)) TSK-FUNCTION-DECLARATION)
                         (and (!= (.id fn) (.owner context))
                              (= (.parent fn) -1))))
                    (let [object
                            (al-get [i64]
                                    (load (load (field context functions)))
                                    (.id fn))]
                      ; Publish identity before prototype materialization: a prototype method may
                      ; capture its own constructor. A top-level non-capturing declaration's Fun
                      ; id is also its JavaScript object identity; the runtime property side table
                      ; canonicalizes boxed and raw function ids to this same owner.
                      (fng-set-symbol! context (.source-id fn) object)
                      (let [prototype (fng-constructor-prototype! context (.id fn))
                          stored
                            (n-peephole
                              (n-new4 (PropStore (shape-name-intern! "prototype"))
                                      (load (load (field context ctrl)))
                                      (fng-current-memory context JS-PROPERTY-ALIAS)
                                      object
                                      (n-box! prototype)))]
                        (set! (load (field context memory)) (fng-preserve-active-memory context stored))))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (ts-child-count ast root))
              (break)
              (let [statement (ts-child ast root (load index))
                    kind (ts-kind ast statement)
                    expression (if (= kind TSK-EXPRESSION-STATEMENT) (ts-child ast statement 0) -1)]
                ;; Prototype metadata gives the closed-world call machinery precise targets, but
                ;; it is not JavaScript execution. Every source assignment still runs here, in
                ;; source order, through the ordinary lvalue/SetProperty path. Skipping every
                ;; `.prototype` assignment made method publication appear to work only because
                ;; materialization duplicated function-valued entries; data properties vanished
                ;; completely and writes before first use acquired the wrong observable timing.
                (if (or (= kind TSK-VARIABLE-STATEMENT) (= kind TSK-EXPRESSION-STATEMENT))
                    (fng-statement context statement)
                    false)
                (set! index (+ (load index) 1)))))
    0))

(defn fng-static-global-value [(frontend (ptr NativeFrontend))
                               (values (ptr (ArrayList i64)))
                               (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-NUMERIC-LITERAL)
            (fng-numeric-literal ast node)
          (= kind TSK-STRING-LITERAL) (fng-string-literal ast node)
          (= kind TSK-NULL) (fng-null)
          (= kind TSK-TRUE) (fng-bool true)
          (= kind TSK-FALSE) (fng-bool false)
          (= kind TSK-PARENTHESIZED-EXPRESSION)
            (fng-static-global-value frontend values (ts-child ast node 0))
          (= kind TSK-IDENTIFIER)
            (al-get [i64] (load values) (fe-resolution-symbol frontend node))
          (= kind TSK-PREFIX-UNARY)
            (let [value (fng-static-global-value frontend values (ts-child ast node 0))
                  text (ts-text ast node)]
              ;; STATIC GLOBAL INITIALISERS, not runtime semantics: the operand is a literal that
              ;; `fng-static-global-value` has already reduced to a constant, there is no
              ;; `FngContext` here to make a library call with, and the only inputs reachable are
              ;; numbers. Recorded in `DSL-OWED` so it is a decision rather than an oversight.
              (cond (= (substr text 0 1) "~") (n-new2 (BitNot) NO-NODE value)
                    (= (substr text 0 1) "-") (n-new2 (Minus) NO-NODE value)
                    (= (substr text 0 1) "!") (n-new2 (Not) NO-NODE value)
                    :else value))
          (= kind TSK-BINARY)
            (let [left (fng-static-global-value frontend values (ts-child ast node 0))
                  right (fng-static-global-value frontend values (ts-child ast node 2))
                  operator (ts-text ast (ts-child ast node 1))]
              (fng-peep (n-new3 (cond (= operator "+") (Add)
                             (= operator "-") (Sub)
                             (= operator "*") (Mul)
                             (= operator "/") (Div)
                             (= operator "%") (Mod)
                             (= operator "&") (BitAnd)
                             (= operator "|") (BitOr)
                             (= operator "^") (BitXor)
                             (= operator "<<") (Shl)
                             (= operator ">>") (Shr)
                             :else (UShr))
                       NO-NODE left right)))
          :else NO-NODE)))

(defn fng-initialize-static-globals! [(frontend (ptr NativeFrontend))
                                      (values (mut (ArrayList i64)))
                                      (value-types (mut (ArrayList i64)))] (-> i64)
  (let [ast (field frontend ast)
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))
                    symbol-id (.id symbol)]
                (if (fng-static-global-symbol? frontend symbol-id)
                    (let [declaration (.node symbol)
                          initializer (ts-child ast declaration (- (ts-child-count ast declaration) 1))
                          kind (ts-kind ast initializer)
                          value (fng-static-global-value frontend values initializer)]
                      (al-set! [i64] (mut values) symbol-id value)
                      (al-set! [i64]
                               (mut value-types)
                               symbol-id
                               (cond (= kind TSK-NUMERIC-LITERAL) FNG-NUMBER
                                     (= kind TSK-STRING-LITERAL) FNG-STRING
                                     (= kind TSK-NULL) FNG-NULL
                                     (or (= kind TSK-TRUE) (= kind TSK-FALSE)) FNG-BOOLEAN
                                     :else FNG-NUMBER)))
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fng-assigned! [(frontend (ptr NativeFrontend))
                     (node i64)
                     (assigned (mut (ArrayList i64)))] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (= kind TSK-BINARY)
        (let [operator (ts-text ast (ts-child ast node 1))
              left (ts-child ast node 0)]
          (if (and (or (= operator "=")
                       (or (= operator "+=")
                           (or (= operator "-=")
                               (or (= operator "*=")
                                   (or (= operator "/=")
                                       (or (= operator "%=")
                                           (or (= operator "&=")
                                               (or (= operator "|=")
                                                   (or (= operator "^=")
                                                       (or (= operator "<<=")
                                                           (or (= operator ">>=")
                                                               (= operator ">>>="))))))))))))
                   (= (ts-kind ast left) TSK-IDENTIFIER))
              (let [symbol (fe-resolution-symbol frontend left)]
                (if (fng-list-has assigned symbol) 0 (al-push! [i64] (mut assigned) symbol)))
              0))
        0)
    (if (or (= kind TSK-PREFIX-UNARY) (= kind TSK-POSTFIX-UNARY))
        (let [text (ts-text ast node)
              length (slice-len text)
              prefix-op (if (>= length 2) (substr text 0 2) "")
              postfix-op (if (>= length 2) (substr text (- length 2) length) "")
              operand (ts-child ast node 0)]
          (if (and (or (= prefix-op "++")
                       (or (= prefix-op "--")
                           (or (= postfix-op "++") (= postfix-op "--"))))
                   (= (ts-kind ast operand) TSK-IDENTIFIER))
              (let [symbol (fe-resolution-symbol frontend operand)]
                (if (fng-list-has assigned symbol) 0 (al-push! [i64] (mut assigned) symbol)))
              0))
        0)
    (let [(mut index) 0]
      (loop (if (>= (load index) (ts-child-count ast node))
                (break)
                (do
                  (fng-assigned! frontend (ts-child ast node (load index)) (mut assigned))
                  (set! index (+ (load index) 1))))))
    0))

(defn fng-target-make [(label-node i64)
                       (can-break bool)
                       (can-continue bool)
                       (symbol-start i64)
                       (symbol-count i64)
                       (active-start i64)
                       (active-count i64)
                       (jump-start i64)
                       (jump-value-start i64)] (-> FngTarget)
  (FngTarget :label-node
             label-node
             :can-break
             can-break
             :can-continue
             can-continue
             :active
             true
             :symbol-start
             symbol-start
             :symbol-count
             symbol-count
             :active-start
             active-start
             :active-count
             active-count
             :jump-start
             jump-start
             :jump-value-start
             jump-value-start))

(defn fng-jump-make [(target i64) (kind i64) (ctrl i64) (value-start i64) (dependency i64)] (-> FngJump)
  (FngJump :target target :kind kind :ctrl ctrl :value-start value-start :dependency dependency))

(defn fng-push-target! [(context FngContext)
                        (label-node i64)
                        (can-break bool)
                        (can-continue bool)
                        (symbols (ptr (ArrayList i64)))] (-> i64)
  (let [targets (load (field context targets))
        target-symbols (load (field context target-symbols))
        target-active (load (field context target-active))
        jumps (load (field context jumps))
        jump-values (load (field context jump-values))
        symbol-start (al-len [i64] (load target-symbols))
        active-start (al-len [i64] (load target-active))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (al-push! [i64]
                          (mut target-symbols)
                          (al-get [i64] (load symbols) (load index)))
                (set! index (+ (load index) 1)))))
    (fng-active-memory! context (mut active))
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-push! [i64]
                          (mut target-active)
                          (al-get [i64] (load active) (load index)))
                (set! index (+ (load index) 1)))))
    (let [answer (al-len [FngTarget] (load targets))]
      (al-push! [FngTarget]
                (mut targets)
                (fng-target-make label-node
                                 can-break
                                 can-continue
                                 symbol-start
                                 (al-len [i64] (load symbols))
                                 active-start
                                 (al-len [i64] (load active))
                                 (al-len [FngJump] (load jumps))
                                 (al-len [i64] (load jump-values))))
      (al-free! [i64] (mut active))
      answer)))

(defn fng-find-target [(context FngContext) (node i64) (kind i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        label (ts-role ast node TS-ROLE-LABEL 0)
        targets (load (field context targets))
        (mut index) (- (al-len [FngTarget] (load targets)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (!= (load answer) -1))
              (break)
              (let [target (al-get [FngTarget] (load targets) (load index))
                    capable
                      (and (.active target)
                           (if (= kind FNG-JUMP-CONTINUE)
                               (.can-continue target)
                               (.can-break target)))
                    matches
                      (if (= label -1)
                          true
                          (and (!= (.label-node target) -1)
                               (= (ts-text ast label) (ts-text ast (.label-node target)))))]
                (if (and capable matches) (set! answer (load index)) 0)
                (set! index (- (load index) 1)))))
    (load answer)))

(defn fng-capture-target! [(context FngContext) (target-index i64) (kind i64) (dependency i64)] (-> i64)
  (let [targets (load (field context targets))
        target (al-get [FngTarget] (load targets) target-index)
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        jumps (load (field context jumps))
        values (load (field context jump-values))
        value-start (al-len [i64] (load values))
        (mut index) 0]
    (loop (if (>= (load index) (.symbol-count target))
              (break)
              (do
                (al-push! [i64]
                          (mut values)
                          (fng-symbol-node context
                                           (al-get [i64]
                                                   (load symbols)
                                                   (+ (.symbol-start target) (load index)))))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (.active-count target))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (.active-start target) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut values) (fng-current-memory context alias))
                (set! index (+ (load index) 1)))))
    (al-push! [FngJump]
              (mut jumps)
              (fng-jump-make target-index kind
                             (load (load (field context ctrl))) value-start dependency))
    (set! (load (field context ctrl)) NO-NODE)
    target-index))

(defn fng-capture-jump! [(context FngContext) (node i64) (kind i64)] (-> i64)
  (fng-capture-target! context (fng-find-target context node kind) kind NO-NODE))

;; A RECORDED JUMP HOLDS NODE IDS, AND THE GRAPH KEEPS MOVING AFTER THE JUMP IS RECORDED.
;;
;; `jump-values` is a frontend table, not a def-use edge, so `n-subsume!` does not retarget it: a
;; node captured by a `break` and then replaced leaves the id of a DEAD node in the log, and
;; `fng-merge-target!` wires that id straight into a phi. That is VERR-DEAD-INPUT --
;; repros/loop-exit-then-allocation.js -- and it is silent until the verifier runs, because
;; nothing between the two ever dereferences the stale entry.
;;
;; The scan covers the WHOLE log rather than the target's own slice. A `break`/`continue` aimed at
;; an OUTER loop from inside this one captured this loop's memory as well, and that jump belongs to
;; a target whose merge has not happened yet, so restricting the scan would miss exactly the
;; labelled-jump case.
(defn fng-retarget-jumps! [(context FngContext) (old i64) (new i64)] (-> i64)
  (let [values (load (field context jump-values))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load values)))
              (break)
              (do
                (if (= (al-get [i64] (load values) (load index)) old)
                    (al-set! [i64] (mut values) (load index) new)
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fng-merge-target! [(context FngContext)
                         (target-index i64)
                         (kind i64)
                         (normal bool)] (-> bool)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        jumps (load (field context jumps))
        jump-values (load (field context jump-values))
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        (mut matching) (al-new [i64] (malloc-allocator))
        (mut normal-memory) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        (mut index) (.jump-start target)]
    (loop (if (>= (load index) (al-len [FngJump] (load jumps)))
              (break)
              (let [jump (al-get [FngJump] (load jumps) (load index))]
                (if (and (= (.target jump) target-index)
                         (= (.kind jump) kind))
                    (al-push! [i64] (mut matching) (load index))
                    0)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (.active-count target))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (.active-start target) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut normal-memory) (fng-current-memory context alias))
                (set! index (+ (load index) 1)))))
    (let [count (+ (if normal 1 0) (al-len [i64] (load matching)))]
      (cond (= count 0) 0
            (= count 1)
              (if normal
                  0
                  (let [jump (al-get [FngJump] (load jumps) (al-get [i64] (load matching) 0))]
                    (store! (load (field context ctrl)) (load (field jump ctrl)))
                    (if (= kind FNG-JUMP-THROW)
                        (store! (load (field context exception-dependency))
                                (load (field jump dependency)))
                        0)
                    (store! index 0)
                    (loop (if (>= (load index) (load (field target symbol-count)))
                              (break)
                              (do
                                (fng-set-symbol! context
                                                 (al-get [i64]
                                                         (load symbols)
                                                         (+ (load (field target symbol-start)) (load index)))
                                                 (al-get [i64]
                                                         (load jump-values)
                                                         (+ (load (field jump value-start)) (load index))))
                                (store! index (+ (load index) 1)))))
                    (store! index 0)
                    (loop (if (>= (load index) (load (field target active-count)))
                              (break)
                              (do
                                (al-push! [i64]
                                          (mut memory-phis)
                                          (al-get [i64]
                                                  (load jump-values)
                                                  (+ (+ (load (field jump value-start))
                                                        (load (field target symbol-count)))
                                                     (load index))))
                                (store! index (+ (load index) 1)))))
                    (if (> (al-len [i64] (load memory-phis)) 0)
                        (store! (load (field context memory)) (fng-merge memory-phis))
                        0)))
            :else
              (let [region (n-new (Region))]
                (n-add-def! region NO-NODE)
                (if normal (n-add-def! region (load (load (field context ctrl)))) 0)
                (store! index 0)
                (loop (if (>= (load index) (al-len [i64] (load matching)))
                          (break)
                          (let [jump
                                  (al-get [FngJump]
                                          (load jumps)
                                          (al-get [i64] (load matching) (load index)))]
                            (n-add-def! region (load (field jump ctrl)))
                            (store! index (+ (load index) 1)))))
                (if (= kind FNG-JUMP-THROW)
                    (let [dependency (n-new (Phi (t-dyn)))
                          (mut ji) 0]
                      (n-add-def! dependency region)
                      (loop (if (>= (load ji) (al-len [i64] (load matching)))
                                (break)
                                (let [jump
                                        (al-get [FngJump]
                                                (load jumps)
                                                (al-get [i64] (load matching) (load ji)))]
                                  (n-add-def! dependency (load (field jump dependency)))
                                  (store! ji (+ (load ji) 1)))))
                      (store! (load (field context exception-dependency)) dependency))
                    0)
                (store! index 0)
                (loop (if (>= (load index) (load (field target symbol-count)))
                          (break)
                          (let [symbol
                                  (al-get [i64]
                                          (load symbols)
                                          (+ (load (field target symbol-start)) (load index)))
                                phi (n-new (Phi (fng-symbol-coil-type context symbol)))
                                (mut ji) 0]
                            (n-add-def! phi region)
                            (if normal
                                (n-add-def! phi
                                            (fng-symbol-node context
                                                             (al-get [i64]
                                                                     (load symbols)
                                                                     (+ (load (field target symbol-start))
                                                                        (load index)))))
                                0)
                            (loop (if (>= (load ji) (al-len [i64] (load matching)))
                                      (break)
                                      (let [jump
                                              (al-get [FngJump]
                                                      (load jumps)
                                                      (al-get [i64] (load matching) (load ji)))]
                                        (n-add-def! phi
                                                    (al-get [i64]
                                                            (load jump-values)
                                                            (+ (load (field jump value-start)) (load index))))
                                        (store! ji (+ (load ji) 1)))))
                            (fng-set-symbol! context symbol phi)
                            (store! index (+ (load index) 1)))))
                (store! index 0)
                (loop (if (>= (load index) (load (field target active-count)))
                          (break)
                          (let [field-index
                                  (al-get [i64]
                                          (load active)
                                          (+ (load (field target active-start)) (load index)))
                                alias (al-get [i64] (load (load (field context aliases))) field-index)
                                phi (n-new (Phi (t-mem-alias alias (t-undef))))
                                (mut ji) 0]
                            (n-add-def! phi region)
                            (if normal (n-add-def! phi (al-get [i64] (load normal-memory) (load index))) 0)
                            (loop (if (>= (load ji) (al-len [i64] (load matching)))
                                      (break)
                                      (let [jump
                                              (al-get [FngJump]
                                                      (load jumps)
                                                      (al-get [i64] (load matching) (load ji)))]
                                        (n-add-def! phi
                                                    (al-get [i64]
                                                            (load jump-values)
                                                            (+ (+ (load (field jump value-start))
                                                                  (load (field target symbol-count)))
                                                               (load index))))
                                        (store! ji (+ (load ji) 1)))))
                            (al-push! [i64] (mut memory-phis) phi)
                            (store! index (+ (load index) 1)))))
                (if (> (al-len [i64] (load memory-phis)) 0)
                    (store! (load (field context memory)) (fng-merge memory-phis))
                    0)
                (store! (load (field context ctrl)) region)))
      (al-free! [i64] (mut matching))
      (al-free! [i64] (mut normal-memory))
      (al-free! [i64] (mut memory-phis))
      (> count 0))))

(defn fng-pop-target! [(context FngContext) (target-index i64)] (-> i64)
  (let [targets (load (field context targets))
        target (index (load (field targets data)) target-index)]
    ;; Target ids are monotonic for the whole function. Jumps to an outer target may be recorded
    ;; while an inner target is active, so truncating shared logs here would erase those exits.
    (set! (.active target) false)
    0))

(defn fng-snapshot-target! [(context FngContext)
                            (target-index i64)
                            (values (mut (ArrayList i64)))] (-> i64)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        start (al-len [i64] (load values))
        (mut index) 0]
    (loop (if (>= (load index) (.symbol-count target))
              (break)
              (do
                (al-push! [i64]
                          (mut values)
                          (fng-symbol-node context
                                           (al-get [i64]
                                                   (load symbols)
                                                   (+ (.symbol-start target) (load index)))))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (.active-count target))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (.active-start target) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut values) (fng-current-memory context alias))
                (set! index (+ (load index) 1)))))
    start))

(defn fng-restore-target! [(context FngContext)
                           (target-index i64)
                           (values (ptr (ArrayList i64)))
                           (start i64)] (-> i64)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        symbols (load (field context target-symbols))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (.symbol-count target))
              (break)
              (do
                (fng-set-symbol! context
                                 (al-get [i64]
                                         (load symbols)
                                         (+ (.symbol-start target) (load index)))
                                 (al-get [i64] (load values) (+ start (load index))))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (.active-count target))
              (break)
              (do
                (al-push! [i64]
                          (mut memories)
                          (al-get [i64]
                                  (load values)
                                  (+ (+ start (.symbol-count target)) (load index))))
                (set! index (+ (load index) 1)))))
    (if (> (al-len [i64] (load memories)) 0)
        (set! (load (field context memory)) (fng-merge memories))
        (set! (load (field context memory)) NO-NODE))
    (al-free! [i64] (mut memories))
    0))

(defn fng-snapshot! [(context FngContext)
                     (symbols (ptr (ArrayList i64)))
                     (active (ptr (ArrayList i64)))
                     (out (mut (ArrayList i64)))] (-> i64)
  (let [start (al-len [i64] (load out))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (al-push! [i64]
                          (mut out)
                          (fng-symbol-node context (al-get [i64] (load symbols) (load index))))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (let [alias (al-get [i64] (load active) (load index))]
                (al-push! [i64] (mut out) (fng-current-memory context alias))
                (set! index (+ (load index) 1)))))
    start))

(defn fng-restore-snapshot! [(context FngContext)
                             (symbols (ptr (ArrayList i64)))
                             (active (ptr (ArrayList i64)))
                             (values (ptr (ArrayList i64)))
                             (start i64)] (-> i64)
  (let [(mut memories) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (fng-set-symbol! context
                                 (al-get [i64] (load symbols) (load index))
                                 (al-get [i64] (load values) (+ start (load index))))
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-push! [i64]
                          (mut memories)
                          (al-get [i64]
                                  (load values)
                                  (+ (+ start (al-len [i64] (load symbols))) (load index))))
                (set! index (+ (load index) 1)))))
    (if (> (al-len [i64] (load memories)) 0)
        (set! (load (field context memory)) (fng-merge memories))
        0)
    (al-free! [i64] (mut memories))
    0))

(defn fng-merge-snapshots! [(context FngContext)
                            (left-ctrl i64)
                            (left-start i64)
                            (right-ctrl i64)
                            (right-start i64)
                            (symbols (ptr (ArrayList i64)))
                            (active (ptr (ArrayList i64)))
                            (values (ptr (ArrayList i64)))] (-> bool)
  (cond (= left-ctrl NO-NODE)
          (if (= right-ctrl NO-NODE)
              false
              (do
                (store! (load (field context ctrl)) right-ctrl)
                (fng-restore-snapshot! context symbols active values right-start)
                true))
        (= right-ctrl NO-NODE)
          (do
            (store! (load (field context ctrl)) left-ctrl)
            (fng-restore-snapshot! context symbols active values left-start)
            true)
        :else
          (let [region (n-new (Region))
                (mut memories) (al-new [i64] (malloc-allocator))
                symbol-count (al-len [i64] (load symbols))
                (mut index) 0]
            (n-add-def! region NO-NODE)
            (n-add-def! region left-ctrl)
            (n-add-def! region right-ctrl)
            (loop (if (>= (load index) symbol-count)
                      (break)
                      (let [symbol (al-get [i64] (load symbols) (load index))
                            phi (n-new (Phi (fng-symbol-coil-type context symbol)))
                            left-value (al-get [i64] (load values) (+ left-start (load index)))
                            right-value (al-get [i64] (load values) (+ right-start (load index)))
                            ;; A PHI HAS ONE REPRESENTATION, and these arms need not arrive with
                            ;; the same one. `Math.trunc(x)` is a `ToNumber`, which is TAGGED,
                            ;; while the arm that went through `x += 1000` is a raw machine number
                            ;; -- so `Math.trunc(acc); if (c) { acc += 1000; }` merged a tagged
                            ;; value with a raw one and consumers had to guess.
                            ;;
                            ;; It surfaced when the guess went stale rather than when it was made:
                            ;; with `if (true)` the tagged arm is dead, the phi narrows to the raw
                            ;; arm's type, and an `Unbox` built while the phi looked tagged is left
                            ;; unboxing a raw number (`Unbox slot 1 <- Phi is raw-num, needs
                            ;; tagged`). The same mismatch with a live condition is a phi whose two
                            ;; halves mean different things.
                            ;;
                            ;; Boxing the raw arm is the direction that always exists: any consumer
                            ;; can unbox a tagged value, and there is no tagged word to recover
                            ;; from a raw one once the other arm's tag is gone. Two raw arms stay
                            ;; raw, so the ordinary arithmetic case pays nothing.
                            ;; repros/truncate-then-live-branch.js.
                            left-raw (fng-machine-number-value? left-value 8)
                            right-raw (fng-machine-number-value? right-value 8)]
                        (n-add-def! phi region)
                        (n-add-def! phi
                                    (if (and left-raw (not right-raw))
                                        (n-box! left-value)
                                        left-value))
                        (n-add-def! phi
                                    (if (and right-raw (not left-raw))
                                        (n-box! right-value)
                                        right-value))
                        (fng-set-symbol! context symbol phi)
                        (store! index (+ (load index) 1)))))
            (store! index 0)
            (loop (if (>= (load index) (al-len [i64] (load active)))
                      (break)
                      ;; The phi's CONTENT type must be the alias's declared type, exactly like
                      ;; fng-loop's memory phis: a (t-undef) content tells inference the merged
                      ;; memory holds undefined, and the fold pass replaces loads through it
                      ;; with constants (an ArrayLoad through the captured-cell alias read
                      ;; undefined instead of the array the branch stored).
                      (let [alias (al-get [i64] (load active) (load index))
                            phi (n-new (Phi (t-mem-alias alias
                                                    (if (shape-alias-defined? alias)
                                                        (shape-alias-ty alias)
                                                        (t-undef)))))]
                        (n-add-def! phi region)
                        (n-add-def! phi
                                    (al-get [i64]
                                            (load values)
                                            (+ (+ left-start symbol-count) (load index))))
                        (n-add-def! phi
                                    (al-get [i64]
                                            (load values)
                                            (+ (+ right-start symbol-count) (load index))))
                        (al-push! [i64] (mut memories) phi)
                        (store! index (+ (load index) 1)))))
            (if (> (al-len [i64] (load memories)) 0)
                (store! (load (field context memory)) (fng-merge memories))
                0)
            (store! (load (field context ctrl)) region)
            (al-free! [i64] (mut memories))
            true)))

(defn fng-control-aliases! [(context FngContext) (active (mut (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        (mut index) 0]
    ;; fng-active-memory! publishes declared-field indices for layout consumers. Control snapshots
    ;; instead carry aliases, including the runtime JavaScript property heap.
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-set! [i64]
                         (mut active)
                         (load index)
                         (al-get [i64]
                                 (load (load (field context aliases)))
                                 (al-get [i64] (load active) (load index))))
                (set! index (+ (load index) 1)))))
    ;; TWO FIELDS MAY SHARE ONE ALIAS -- `{p, q}` and a later `{p}` share `p`'s entry -- so the
    ;; field->alias mapping above can leave the same alias in the list twice. A snapshot then
    ;; records a state per LIST ENTRY, the two entries can disagree about which state is current,
    ;; and the merge builds two phis for one alias class: `MemMerge` carrying `mem#1` twice, and
    ;; the evaluator stops with "a memory edge does not describe the alias class being touched".
    ;; Latent as long as duplicate entries happened to record identical states; a change in node
    ;; processing order made them diverge. Compact to first occurrence.
    (let [(mut w) 0 (mut r) 0]
      (loop (if (>= (load r) (al-len [i64] (load active)))
                (break)
                (do
                  (let [v (al-get [i64] (load active) (load r))
                        (mut seen) false
                        (mut s) 0]
                    (loop (if (or (>= (load s) (load w)) (load seen))
                              (break)
                              (do (if (= (al-get [i64] (load active) (load s)) v)
                                      (set! seen true)
                                      0)
                                  (set! s (+ (load s) 1)))))
                    (if (load seen)
                        0
                        (do (al-set! [i64] (mut active) (load w) v)
                            (set! w (+ (load w) 1))
                            0)))
                  (set! r (+ (load r) 1)))))
      (loop (if (<= (al-len [i64] (load active)) (load w))
                (break)
                (do (al-pop! [i64] (mut active)) 0))))
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load (field context dynamic-aliases))))
              (break)
              (do
                (let [alias (al-get [i64] (load (field context dynamic-aliases)) (load index))]
                  (if (fng-list-has active alias) 0 (al-push! [i64] (mut active) alias)))
                (set! index (+ (load index) 1)))))
    ;; Captured cells ALWAYS join a control snapshot, exactly as fng-loop force-includes them
    ;; for loop memory phis: the branch being lowered may contain the function's FIRST cell
    ;; touch, which records the alias only after the snapshot list was fixed. Without the phi,
    ;; a cell store that happens only inside one branch is silently dropped at the merge —
    ;; `setIterations = function(v) { if (v > 0) iterations = v; }` left the shared cell at its
    ;; initial value forever (repros/cell-store-in-branch.js; NavierStokes ran lin_solve with
    ;; iterations=10 instead of 2).
    (if (and (> (al-len [FeCapture] (.captures frontend)) 0)
             (not (fng-list-has active (.cell-alias context))))
        (al-push! [i64] (mut active) (.cell-alias context))
        0)
    0))

(defn fng-if [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        condition-node (ts-child ast node 0)
        then-node (ts-child ast node 1)
        else-node (if (> (ts-child-count ast node) 2) (ts-child ast node 2) -1)
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut answer) true]
    (fng-assigned! frontend then-node (mut changed))
    (if (!= else-node -1) (fng-assigned! frontend else-node (mut changed)) 0)
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    ;; Condition evaluation may itself contain calls, assignments, or short-circuit control.
    ;; Both branch snapshots and the outer If must begin after those effects have completed.
    (let [condition (fng-condition-representation context condition-node)
          condition-ctrl (load (load (field context ctrl)))
          saved-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))
          arms (n-if-arms! (fng-peep (n-new2 (If) condition-ctrl condition)))]
      (set! (load (field context ctrl)) (arms-t arms))
      (let [then-continues (fng-statement context then-node)
            then-ctrl (if then-continues (load (load (field context ctrl))) NO-NODE)
            then-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
        (fng-restore-snapshot! context (mut changed) (mut active) (mut snapshots) saved-start)
        (set! (load (field context ctrl)) (arms-f arms))
        (let [else-continues (if (= else-node -1) true (fng-statement context else-node))
              else-ctrl (if else-continues (load (load (field context ctrl))) NO-NODE)
              else-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
          (set! answer
                (fng-merge-snapshots! context
                                      then-ctrl then-start
                                      else-ctrl else-start
                                      (mut changed) (mut active) (mut snapshots))))))
    (al-free! [i64] (mut changed))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

(defn fng-loop-lexical-cell-symbol [(context FngContext) (initializer i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (and (!= initializer -1)
             (= (ts-kind ast initializer) TSK-VARIABLE-DECLARATION-LIST))
        (let [text (ts-text ast initializer)]
          (if (and (or (and (>= (slice-len text) 3) (= (substr text 0 3) "let"))
                       (and (>= (slice-len text) 5) (= (substr text 0 5) "const")))
                   (= (ts-child-count ast initializer) 1))
              (let [declaration (ts-child ast initializer 0)
                    symbol (fe-symbol-for-declaration frontend declaration (.owner context))]
                (if (and (>= symbol 0) (fng-symbol-cell? context symbol)) symbol -1))
              -1))
        -1)))

;; Binding patterns are syntax structure. Array extraction deliberately goes through the same JSL
;; iterator protocol as source `for-of`; the frontend only walks the pattern and publishes each
;; resulting value into its lexical symbol.
(defn fng-bind-pattern! [(context FngContext) (pattern i64) (value i64)] (-> i64)
  (let [frontend (load (field context frontend)) ast (field frontend ast) kind (ts-kind ast pattern)]
    (if (= kind TSK-IDENTIFIER)
        (let [symbol (fe-symbol-for-binding-name frontend pattern (.owner context))]
          (fng-set-symbol! context symbol value)
          (fng-set-symbol-type! context symbol FNG-DYNAMIC))
        (if (= kind TSK-BINDING-ELEMENT)
            (fng-bind-pattern! context (ts-role ast pattern TS-ROLE-NAME 0) value)
            (if (= kind TSK-ARRAY-BINDING-PATTERN)
                (let [iterator (fng-jsl-call1 context "GetIterator" (n-box! value))
                      (mut i) 0]
                  (loop (if (>= (load i) (ts-child-count ast pattern)) (break)
                          (let [step (fng-jsl-call1 context "ArrayIteratorNext" iterator)
                                element (fng-jsl-call1 context "IteratorValue" step)]
                            (fng-bind-pattern! context (ts-child ast pattern (load i)) element)
                            (set! i (+ (load i) 1))))))
                0))))
  value)

(defn fng-loop [(context FngContext)
                (condition-node i64)
                (body-node i64)
                (increment-node i64)
                (label-node i64)
                ;; `for ... of` only, and NO-NODE/-1 for every other loop: the iterator object
                ;; built once BEFORE the Loop, and the syntax node receiving each iteration value.
                ;; Everything that makes for-of a loop rather than a syntax -- the phi set, the
                ;; memory phis, the break/continue target, the label -- is this function's job
                ;; already, so the two differences are passed in rather than copied out.
                (iterator i64)
                (binding-node i64)
                ;; A captured `let`/`const` loop-header binding gets a fresh cell each iteration.
                (fresh-symbol i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        (mut carried) (al-new [i64] (malloc-allocator))
        (mut initial-values) (al-new [i64] (malloc-allocator))
        (mut phis) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        loop-node (n-new (Loop))
        (mut index) 0]
    (fng-assigned! frontend body-node (mut carried))
    (if (!= increment-node -1) (fng-assigned! frontend increment-node (mut carried)) 0)
    (if (!= condition-node -1) (fng-assigned! frontend condition-node (mut carried)) 0)
    ;; An existing local assigned by `for (x of xs)` is itself loop-carried even when the body
    ;; contains no other write to x. Declaration bindings are fresh loop locals and need no such
    ;; addition; property/element targets carry their state through memory phis.
    (if (and (!= binding-node -1) (= (ts-kind ast binding-node) TSK-IDENTIFIER))
        (let [symbol (fe-resolution-symbol frontend binding-node)]
          (if (and (>= symbol 0) (not (fng-list-has (mut carried) symbol)))
              (al-push! [i64] (mut carried) symbol)
              0))
        0)
    ;; Snapshot scalar entry values BEFORE replacing current memory with loop-header memory Phis.
    ;; A captured local is a load through its cell alias; reading it after that replacement makes
    ;; the value depend on the loop header while wiring it to the preheader Phi arm.
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load carried)))
              (break)
              (do
                (al-push! [i64]
                          (mut initial-values)
                          (fng-symbol-node context
                                           (al-get [i64] (load carried) (load index))))
                (set! index (+ (load index) 1)))))
    (let [target-index (fng-push-target! context label-node true true (mut carried))]
      (n-add-def! loop-node NO-NODE)
      (n-add-def! loop-node (load (load (field context ctrl))))
      (n-add-def! loop-node NO-NODE)
      ;; EVERY loop carries memory phis, not just those with break/continue. Without them the
      ;; exit arm's memory is the BODY's final store chain, and a body store does not dominate
      ;; the exit: the first post-loop merge with no intervening call hands the backend a memory
      ;; Phi input from a non-dominating block (NavierStokes' dynamic element stores).
      ;;
      ;; The phi set is the CONTROL alias list — declared fields converted to aliases plus every
      ;; dynamic alias — with the runtime property heap force-included: the body's first dynamic
      ;; store may be the function's first, so entry-time recording alone misses it, and a body
      ;; store with no phi is unreachable once the exit stops exposing body memory. Captured
      ;; cells join for the same reason.
      (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
      (fng-active-memory! context (mut active))
      (fng-control-aliases! context (mut active))
      (if (and (> (al-len [FeCapture] (.captures frontend)) 0)
               (not (fng-list-has (mut active) (.cell-alias context))))
          (al-push! [i64] (mut active) (.cell-alias context))
          0)
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [alias (al-get [i64] (load active) (load index))
                      ;; The phi's CONTENT type must be the alias's declared type, exactly like
                      ;; `fng-memory`: a `(t-undef)` content told inference the loop-carried
                      ;; memory holds undefined and the fold pass replaced every load through
                      ;; it with a constant.
                      phi (n-new (Phi (t-mem-alias alias
                                              (if (shape-alias-defined? alias)
                                                  (shape-alias-ty alias)
                                                  (t-undef)))))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-current-memory context alias))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut memory-phis) phi)
                  (set! index (+ (load index) 1)))))
      (if (> (al-len [i64] (load memory-phis)) 0)
          (set! (load (field context memory)) (fng-merge memory-phis))
          0)
      ;; Phi nodes are allocated first, then initialized in source assignment order.
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (do
                  (let [symbol (al-get [i64] (load carried) (load index))
                        phi (n-new (Phi (fng-symbol-coil-type context symbol)))]
                    (al-push! [i64] (mut phis) phi))
                  (set! index (+ (load index) 1)))))
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (let [symbol (al-get [i64] (load carried) (load index))
                      phi (al-get [i64] (load phis) (load index))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (al-get [i64] (load initial-values) (load index)))
                  (n-add-def! phi NO-NODE)
                  (fng-set-symbol! context symbol phi)
                  (set! index (+ (load index) 1)))))
      (set! (load (field context ctrl)) loop-node)
      ;; `for ... of` has NO condition expression. Its test is the iterator's own answer, so the
      ;; step runs in the loop header and the If asks whether the iterator is DONE -- which puts
      ;; the body on the FALSE arm and the exit on the true one, the mirror of every other loop.
      (let [step (if (= iterator NO-NODE)
                     NO-NODE
                     (fng-jsl-call1 context "ArrayIteratorNext" iterator))
            condition (if (= iterator NO-NODE)
                          (fng-condition-representation context condition-node)
                          (fng-jsl-call1 context "IteratorComplete" step))
            ; The condition may itself emit control (a ToNumber diamond, a short-circuit merge, an
            ; inlined JSL call). The loop test must anchor at whatever control the condition left
            ; behind; pinning it to the Loop node put two Ifs on one control and broke the CFG.
            arms (n-if-arms! (fng-peep (n-new2 (If)
                                               (load (load (field context ctrl)))
                                               condition)))
            body-arm (if (= iterator NO-NODE) (arms-t arms) (arms-f arms))
            exit-arm (if (= iterator NO-NODE) (arms-f arms) (arms-t arms))]
        (set! (load (field context ctrl)) body-arm)
        ;; CreatePerIterationEnvironment: carry the prior iteration's VALUE through the scalar Phi,
        ;; but publish a fresh CELL before closures in this iteration are materialized. Existing
        ;; `fng-set-symbol!` allocation and closure capture then implement the identity semantics.
        (if (>= fresh-symbol 0)
            (let [value (fng-symbol-node context fresh-symbol)]
              (al-set! [i64]
                       (mut (load (field context values)))
                       fresh-symbol
                       NO-NODE)
              (fng-set-symbol! context fresh-symbol value))
            0)
        ;; The binding is written INSIDE the body arm, after the done test: on the exhausted trip
        ;; there is no value, and IteratorValue would be reading `undefined` out of the result
        ;; object for nothing.
        (if (= iterator NO-NODE)
            0
            (let [value (fng-jsl-call1 context "IteratorValue" step)]
              (if (= (ts-kind ast binding-node) TSK-VARIABLE-DECLARATION)
                  (fng-bind-pattern! context
                                     (ts-role ast binding-node TS-ROLE-NAME 0)
                                     value)
                  (fng-lvalue-write context (fng-lvalue context binding-node) value))))
        (let [body-continues (fng-statement context body-node)
              reaches-increment (fng-merge-target! context target-index FNG-JUMP-CONTINUE body-continues)]
          ;; A classic `for (let i = ...; ...; i++)` creates the next iteration environment
          ;; AFTER the body and BEFORE increment. Closures created by the body therefore retain
          ;; the pre-increment cell; increment and the next condition operate on the fresh one.
          (if (and (= iterator NO-NODE) (and reaches-increment (>= fresh-symbol 0)))
              (let [value (fng-symbol-node context fresh-symbol)]
                (al-set! [i64]
                         (mut (load (field context values)))
                         fresh-symbol
                         NO-NODE)
                (fng-set-symbol! context fresh-symbol value))
              0)
          (if (and reaches-increment (!= increment-node -1)) (fng-expression context increment-node) 0)
          (set! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (let [symbol (al-get [i64] (load carried) (load index))
                          phi (al-get [i64] (load phis) (load index))]
                      (n-set-def! phi 2 (fng-symbol-node context symbol))
                      (fng-reconcile-phi-arms! phi)
                      (set! index (+ (load index) 1)))))
          (set! index 0)
          (loop (if (>= (load index) (al-len [i64] (load active)))
                    (break)
                    (let [alias (al-get [i64] (load active) (load index))
                          phi (al-get [i64] (load memory-phis) (load index))
                          back (fng-current-memory context alias)]
                      ;; A body that never touched this alias hands the phi ITSELF back as the
                      ;; backedge. Such a phi is exactly its initial memory; keeping the
                      ;; self-referential node alive leaks it once consumers fold to the init.
                      (if (= back phi)
                          (let [init (n-in phi 1)]
                            ;; A jump out of this body may have captured the phi as its memory for
                            ;; this alias; that entry has to follow the replacement or the merge
                            ;; wires a dead node into a phi. See `fng-retarget-jumps!`.
                            (fng-retarget-jumps! context phi init)
                            (n-subsume! phi init)
                            (al-set! [i64] (mut memory-phis) (load index) init)
                            0)
                          (do (n-set-def! phi 2 back) 0))
                      (set! index (+ (load index) 1)))))
          ;; A BODY THAT NEVER FALLS OUT STILL NEEDS A BACK EDGE. `while (c) { return x; }` reaches
          ;; the increment on no path, so this slot had nothing to write and kept `NO-NODE` --
          ;; which is `n-in-progress?`, which is `VERR-IN-PROGRESS`, and the whole program was
          ;; rejected for a shape JavaScript writes deliberately. The back edge is not missing, it
          ;; is UNREACHABLE, and the graph has a node that says exactly that: `XCtrl`. `loop-compute`
          ;; reads slot 1 alone, so the loop stays as reachable as its entry, and the carried phis
          ;; -- whose slot 2 was written unconditionally just above -- meet a proven-dead path and
          ;; collapse onto their entry arm.
          (n-set-def! loop-node 2 (if reaches-increment (load (load (field context ctrl))) (n-xctrl)))
          (if (not (load (fng-optimize-ptr)))
              (let [(mut reset-index) 0]
                (n-set-ty! loop-node (t-top))
                (loop (if (>= (load reset-index) (al-len [i64] (load phis)))
                          (break)
                          (do
                            (n-set-ty! (al-get [i64] (load phis) (load reset-index)) (t-top))
                            (set! reset-index (+ (load reset-index) 1))))))
              0)
          (set! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (do
                      (fng-set-symbol! context
                                       (al-get [i64] (load carried) (load index))
                                       (al-get [i64] (load phis) (load index)))
                      (set! index (+ (load index) 1)))))
          (set! (load (field context ctrl)) exit-arm)
          ;; On exit the observable memory is the loop HEADER's state — the phis — not the
          ;; body's final store chain (which does not dominate the exit arm). The phis also
          ;; keep the body's stores reachable through their backedge inputs.
          (if (> (al-len [i64] (load memory-phis)) 0)
              (set! (load (field context memory)) (fng-merge memory-phis))
              (set! (load (field context memory)) NO-NODE))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK true)]
            (fng-pop-target! context target-index)
    (al-free! [i64] (mut carried))
    (al-free! [i64] (mut initial-values))
    (al-free! [i64] (mut phis))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut memory-phis))
            continues))))))

(defn fng-do-loop [(context FngContext) (body-node i64) (condition-node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        (mut carried) (al-new [i64] (malloc-allocator))
        (mut phis) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        loop-node (n-new (Loop))
        (mut index) 0]
    (fng-assigned! frontend body-node (mut carried))
    (fng-assigned! frontend condition-node (mut carried))
    (let [target-index (fng-push-target! context label-node true true (mut carried))]
      (n-add-def! loop-node NO-NODE)
      (n-add-def! loop-node (load (load (field context ctrl))))
      (n-add-def! loop-node NO-NODE)
      ;; THE SAME ALIAS SET `fng-loop` CARRIES, and for the reasons stated at its matching site.
      ;; This copy took `fng-active-memory!` alone, which publishes DECLARED FIELDS only, so a
      ;; `do`/`while` had no memory phi for the runtime property heap, for any dynamic alias, or
      ;; for a captured cell. The header then read pre-loop memory on every iteration and the
      ;; loop computed the wrong answer -- silently, since the graph is well formed:
      ;;
      ;;   do { a[d] = (a[0] + d + 1) | 0; d++; } while (d < 4);   // dynamic alias
      ;;   do { acc = (acc + bump()) | 0; d++; } while (d < 3);    // captured cell
      ;;
      ;; Both are correct written as `while`, which is what named the divergence.
      ;;
      ;; `fng-control-aliases!` rewrites the list IN PLACE from field indices to aliases, so
      ;; everything below reads an alias directly, as `fng-loop` does.
      (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
      (fng-active-memory! context (mut active))
      (fng-control-aliases! context (mut active))
      (if (and (> (al-len [FeCapture] (.captures frontend)) 0)
               (not (fng-list-has (mut active) (.cell-alias context))))
          (al-push! [i64] (mut active) (.cell-alias context))
          0)
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [alias (al-get [i64] (load active) (load index))
                      ;; The alias's DECLARED content type, for the reason `fng-loop` states at the
                      ;; matching site: a `(t-undef)` content tells inference the loop-carried
                      ;; memory holds undefined, and the fold pass then replaces every load through
                      ;; it with a constant.
                      phi (n-new (Phi (t-mem-alias alias
                                              (if (shape-alias-defined? alias)
                                                  (shape-alias-ty alias)
                                                  (t-undef)))))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-current-memory context alias))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut memory-phis) phi)
                  (set! index (+ (load index) 1)))))
      (if (> (al-len [i64] (load memory-phis)) 0)
          (set! (load (field context memory)) (fng-merge memory-phis))
          0)
      ;; RESET. `index` still holds the length of `active` from the memory-phi loop above, so
      ;; without this the carried-symbol phis are simply not created whenever the loop is preceded
      ;; by an allocation -- and the reconcile pass below, which DOES iterate `carried` from zero,
      ;; then indexes a `phis` list that is short or empty. That is the `n-in: input index out of
      ;; range` on an object literal followed by a `do`/`while`, and a segfault once the object is
      ;; wide enough. `fng-loop` resets at the matching site; this copy did not.
      (set! index 0)
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (let [symbol (al-get [i64] (load carried) (load index))
                      phi (n-new (Phi (fng-symbol-coil-type context symbol)))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-symbol-node context symbol))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut phis) phi)
                  (fng-set-symbol! context symbol phi)
                  (set! index (+ (load index) 1)))))
      (set! (load (field context ctrl)) loop-node)
      (let [body-continues (fng-statement context body-node)
            reaches-condition (fng-merge-target! context target-index FNG-JUMP-CONTINUE body-continues)]
        (let [condition
                (if reaches-condition
                    (fng-condition-representation context condition-node)
                    (fng-const 0))
              arms (n-if-arms! (fng-peep (n-new2 (If) (load (load (field context ctrl))) condition)))]
          (set! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (let [symbol (al-get [i64] (load carried) (load index))
                          phi (al-get [i64] (load phis) (load index))]
                      (n-set-def! phi 2 (fng-symbol-node context symbol))
                      (fng-reconcile-phi-arms! phi)
                      (set! index (+ (load index) 1)))))
          (set! index 0)
          (loop (if (>= (load index) (al-len [i64] (load active)))
                    (break)
                    (let [alias (al-get [i64] (load active) (load index))
                          phi (al-get [i64] (load memory-phis) (load index))
                          back (fng-current-memory context alias)]
                      ;; A body that never touched this alias hands the phi ITSELF back as the
                      ;; backedge, and `fng-loop` subsumes it for that reason. This copy set the
                      ;; back edge unconditionally, so the self-referential phi survived and
                      ;; `verify` reported VERR-PHI-ARITY. It needed an alias that was ACTIVE but
                      ;; untouched by the body to show up at all, which is why it took a control
                      ;; merge before the loop -- a `do`/`while` on its own has no such alias.
                      (if (= back phi)
                          (let [init (n-in phi 1)]
                            ;; A jump out of this body may have captured the phi as its memory for
                            ;; this alias; that entry has to follow the replacement or the merge
                            ;; wires a dead node into a phi. See `fng-retarget-jumps!`.
                            (fng-retarget-jumps! context phi init)
                            (n-subsume! phi init)
                            (al-set! [i64] (mut memory-phis) (load index) init)
                            0)
                          (do (n-set-def! phi 2 back) 0))
                      (set! index (+ (load index) 1)))))
          (n-set-def! loop-node 2 (arms-t arms))
          (if (not (load (fng-optimize-ptr)))
              (let [(mut reset-index) 0]
                (n-set-ty! loop-node (t-top))
                (loop (if (>= (load reset-index) (al-len [i64] (load phis)))
                          (break)
                          (do
                            (n-set-ty! (al-get [i64] (load phis) (load reset-index)) (t-top))
                            (set! reset-index (+ (load reset-index) 1))))))
              0)
          (set! (load (field context ctrl)) (arms-f arms))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK reaches-condition)]
            (fng-pop-target! context target-index)
            (al-free! [i64] (mut carried))
            (al-free! [i64] (mut phis))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut memory-phis))
            continues))))))

(defn fng-switch [(context FngContext) (node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        case-block (ts-role ast node TS-ROLE-CLAUSE 0)
        clause-count (ts-child-count ast case-block)
        discriminant (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0))
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut entry-ctrls) (al-new [i64] (malloc-allocator))
        (mut entry-starts) (al-new [i64] (malloc-allocator))
        (mut index) 0
        (mut default-index) -1]
    (fng-assigned! frontend node (mut changed))
    (fng-active-memory! context (mut active))
    (loop (if (>= (load index) clause-count)
              (break)
              (do
                (al-push! [i64] (mut entry-ctrls) NO-NODE)
                (al-push! [i64] (mut entry-starts) -1)
                (set! index (+ (load index) 1)))))
    (let [target-index (fng-push-target! context label-node true false (mut changed))]
      ;; Ordered case-test chain. Default is selected only if every case test fails.
      (set! index 0)
      (loop (if (>= (load index) clause-count)
                (break)
                (let [clause (ts-role ast case-block TS-ROLE-CLAUSE (load index))
                      kind (ts-kind ast clause)]
                  (if (= kind TSK-DEFAULT-CLAUSE)
                      (set! default-index (load index))
                      ;; `switch` matches with `===`; the call is lowered before the If reads the
                      ;; control, for the reason given at the other switch lowering above.
                      (let [case-value (fng-expression context (ts-role ast clause TS-ROLE-EXPRESSION 0))
                            matches
                              (fng-jsl-call2 context "StrictEqual"
                                             (fng-box-dynamic-argument! discriminant)
                                             (fng-box-dynamic-argument! case-value))
                            arms
                              (n-if-arms! (fng-peep (n-new2 (If)
                                                            (load (load (field context ctrl)))
                                                            matches)))]
                        (al-set! [i64] (mut entry-ctrls) (load index) (arms-t arms))
                        (al-set! [i64]
                                 (mut entry-starts)
                                 (load index)
                                 (fng-snapshot! context changed active (mut snapshots)))
                        (set! (load (field context ctrl)) (arms-f arms))))
                  (set! index (+ (load index) 1)))))
      (let [no-match-ctrl (load (load (field context ctrl)))
            no-match-start (fng-snapshot! context changed active (mut snapshots))
            (mut fall-ctrl) NO-NODE
            (mut fall-start) -1]
        (if (!= (load default-index) -1)
            (do
              (al-set! [i64] (mut entry-ctrls) (load default-index) no-match-ctrl)
              (al-set! [i64] (mut entry-starts) (load default-index) no-match-start))
            0)
        ;; Clause bodies are lowered in source order. The selected entry and previous fallthrough
        ;; are explicit peers at each clause head.
        (set! index 0)
        (loop (if (>= (load index) clause-count)
                  (break)
                  (let [clause (ts-role ast case-block TS-ROLE-CLAUSE (load index))
                        entry-ctrl (al-get [i64] (load entry-ctrls) (load index))
                        entry-start (al-get [i64] (load entry-starts) (load index))
                        reaches
                          (fng-merge-snapshots! context
                                                entry-ctrl
                                                entry-start
                                                (load fall-ctrl)
                                                (load fall-start)
                                                changed
                                                active
                                                snapshots)
                        first (if (= (ts-kind ast clause) TSK-CASE-CLAUSE) 1 0)
                        (mut child) first
                        (mut continues) reaches]
                    (loop (if (or (not (load continues))
                                  (>= (load child) (ts-child-count ast clause)))
                              (break)
                              (do
                                (set! continues (fng-statement context (ts-child ast clause (load child))))
                                (set! child (+ (load child) 1)))))
                    (if (load continues)
                        (do
                          (set! fall-ctrl (load (load (field context ctrl))))
                          (set! fall-start (fng-snapshot! context changed active (mut snapshots))))
                        (do (set! fall-ctrl NO-NODE) (set! fall-start -1)))
                    (set! index (+ (load index) 1)))))
        (let [(mut normal) false]
          (if (= (load default-index) -1)
              (set! normal
                    (fng-merge-snapshots! context
                                          no-match-ctrl
                                          no-match-start
                                          (load fall-ctrl)
                                          (load fall-start)
                                          changed
                                          active
                                          snapshots))
              (if (!= (load fall-ctrl) NO-NODE)
                  (do
                    (set! (load (field context ctrl)) (load fall-ctrl))
                    (fng-restore-snapshot! context changed active snapshots (load fall-start))
                    (set! normal true))
                  0))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK (load normal))]
            (fng-pop-target! context target-index)
            (al-free! [i64] (mut changed))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut snapshots))
            (al-free! [i64] (mut entry-ctrls))
            (al-free! [i64] (mut entry-starts))
            continues))))))

(defn fng-labeled-block [(context FngContext) (statement i64) (label i64)] (-> bool)
  (let [frontend (load (field context frontend))
        (mut assigned) (al-new [i64] (malloc-allocator))]
    (fng-assigned! frontend statement (mut assigned))
    (let [target-index (fng-push-target! context label true false (mut assigned))
          normal (fng-statement context statement)
          answer (fng-merge-target! context target-index FNG-JUMP-BREAK normal)]
      (fng-pop-target! context target-index)
      (al-free! [i64] (mut assigned))
      answer)))

(defn fng-variable-declaration! [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        count (ts-child-count ast node)
        name (ts-role ast node TS-ROLE-NAME 0)
        ;; The initializer is a ROLE, not the last child: `let x: any;` has the TYPE ANNOTATION
        ;; as its last child, and lowering that as an expression panicked the initializer
        ;; tripwire on every annotated-but-uninitialized declaration.
        value-node (ts-role ast node TS-ROLE-INITIALIZER 0)
        has-value (and (!= value-node -1) (!= value-node name))
        pattern (= (ts-kind ast name) TSK-ARRAY-BINDING-PATTERN)
        symbol (if pattern -1 (fe-symbol-for-declaration frontend node (.owner context)))
        declared (if pattern FNG-DYNAMIC (fng-declared-symbol-type frontend symbol))
        value (if has-value
                  (fng-expression-expected context value-node declared)
                  (fng-symbol-node context symbol))]
    (if (and has-value (= value NO-NODE))
        (do (panic-corrupt "declaration initializer evaluated to NO-NODE") 0)
        0)
    (if has-value
        (if pattern
            (fng-bind-pattern! context name value)
            (do
              (fng-set-symbol! context symbol value)
              (fng-set-symbol-type! context symbol (fng-infer context value-node declared))))
        0)
    value))

(defn fng-initialize-locals! [(context FngContext)] (-> i64)
  (let [frontend (load (field context frontend))
        owner (.owner context)
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.owner symbol) owner)
                         (and (= (.role symbol) FE-ROLE-LOCAL)
                              (let [declaration (.node symbol)
                                    name (.name-node symbol)]
                                (and (= (ts-child-count (field frontend ast) declaration) 1)
                                     (= (ts-child (field frontend ast) declaration 0) name)))))
                    (do
                      (fng-set-symbol! context (.id symbol) (fng-undefined))
                      (fng-set-symbol-type! context (.id symbol) FNG-VOID))
                    0)
                (set! index (+ (load index) 1)))))
    0))

;; `for (const x of xs)` -- ForIn/OfBodyEvaluation over an array iterator, ECMAScript's own
;; desugaring rather than an index loop written here.
;;
;; THE ITERATOR IS WHY THIS NEEDS NO SYNTHETIC COUNTER. An index loop wants a loop-carried integer,
;; and a loop-carried value in this builder is a phi over a SYMBOL -- there is no symbol for a
;; counter the source never wrote, and `fng-assigned!` derives the carried set from the source. The
;; iterator keeps its index in an internal slot, so the state crosses the back edge through the
;; loop's memory phis, which `fng-loop` builds for every loop already.
;;
;; `GetIterator` is called ONCE, before the Loop, so a non-array throws before the first trip
;; rather than on each one.
(defn fng-for-of [(context FngContext) (node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        initializer (ts-role ast node TS-ROLE-INITIALIZER 0)
        declaration (if (= (ts-kind ast initializer) TSK-VARIABLE-DECLARATION-LIST)
                        (ts-child ast initializer 0) initializer)
        iterable (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0))
        iterator (fng-jsl-call1 context "GetIterator" (n-box! iterable))]
    ;; The element type is whatever the iterable holds, which nothing here claims to know. The
    ;; symbol was initialized to `undefined`/FNG-VOID by `fng-initialize-locals!`, and leaving it
    ;; there would tell inference the binding is undefined on every read.
    (if (and (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION)
             (= (ts-kind ast (ts-role ast declaration TS-ROLE-NAME 0)) TSK-IDENTIFIER))
        (fng-set-symbol-type! context
                              (fe-symbol-for-declaration frontend declaration (.owner context))
                              FNG-DYNAMIC)
        0)
    (fng-loop context
              -1
              (ts-role ast node TS-ROLE-STATEMENT 0)
              -1
              label-node
              iterator
              declaration
              (fng-loop-lexical-cell-symbol context initializer))))

;; `for (const key in object)` enumerates through DSL-owned ObjectKeys. The frontend owns only the
;; syntax binding and loop graph; coercion, key discovery, ordering, and iterator behavior remain
;; JavaScript operations in `lib/`.
(defn fng-for-in [(context FngContext) (node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        initializer (ts-role ast node TS-ROLE-INITIALIZER 0)
        declaration (if (= (ts-kind ast initializer) TSK-VARIABLE-DECLARATION-LIST)
                        (ts-child ast initializer 0) initializer)
        object (n-box! (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0)))
        keys (fng-jsl-call1 context "ObjectKeys" object)
        iterator (fng-jsl-call1 context "GetIterator" (n-box! keys))]
    (if (and (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION)
             (= (ts-kind ast (ts-role ast declaration TS-ROLE-NAME 0)) TSK-IDENTIFIER))
        (fng-set-symbol-type! context
                              (fe-symbol-for-declaration frontend declaration (.owner context))
                              FNG-DYNAMIC)
        0)
    (fng-loop context
              -1
              (ts-role ast node TS-ROLE-STATEMENT 0)
              -1
              label-node
              iterator
              declaration
              (fng-loop-lexical-cell-symbol context initializer))))

(defn fng-try-catch [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        try-block (ts-role ast node TS-ROLE-TRY-BLOCK 0)
        catch-clause (ts-role ast node TS-ROLE-CATCH 0)
        catch-block (ts-role ast catch-clause TS-ROLE-BODY 0)
        catch-declaration (ts-role ast catch-clause TS-ROLE-CATCH-BINDING 0)
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut answer) false]
    (fng-assigned! frontend node (mut changed))
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    (let [target
            (fng-push-target! context FNG-EXCEPTION-TARGET-LABEL false false (mut changed))
          try-continues (fng-statement context try-block)
          try-ctrl (if try-continues (load (load (field context ctrl))) NO-NODE)
          try-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))
          has-exception (fng-merge-target! context target FNG-JUMP-THROW false)]
      ;; A rethrow from the catch belongs to the next enclosing handler, never this one.
      (fng-pop-target! context target)
      (if has-exception
          (let [thrown
                  (fng-exception-runtime context FNG-EXCEPTION-TAKE-DESCRIPTOR
                                         (load (load (field context exception-dependency))))]
            (if (!= catch-declaration -1)
                (fng-set-symbol! context
                                 (fe-symbol-for-declaration frontend catch-declaration (.owner context))
                                 thrown)
                0)
            (let [catch-continues (fng-statement context catch-block)
                  catch-ctrl (if catch-continues (load (load (field context ctrl))) NO-NODE)
                  catch-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
              (set! answer
                    (fng-merge-snapshots! context
                                          try-ctrl try-start
                                          catch-ctrl catch-start
                                          (mut changed) (mut active) (mut snapshots)))))
          (do
            (if try-continues
                (do (set! (load (field context ctrl)) try-ctrl)
                    (fng-restore-snapshot! context
                                           (mut changed) (mut active) (mut snapshots) try-start))
                0)
            (set! answer try-continues)))
      0)
    (al-free! [i64] (mut changed))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

(defn fng-statement [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-BLOCK)
            (let [(mut index) 0
                  (mut continues) true]
              (loop (if (or (>= (load index) (ts-child-count ast node)) (not (load continues)))
                        (break)
                        (do
                          (store! continues (fng-statement context (ts-child ast node (load index))))
                          (store! index (+ (load index) 1)))))
              (load continues))
          (= kind TSK-EMPTY-STATEMENT) true
          (= kind TSK-VARIABLE-STATEMENT)
            (let [list (ts-child ast node 0)
                  (mut declaration-index) 0]
              (loop (if (>= (load declaration-index) (ts-child-count ast list))
                        (break)
                        (do
                          (fng-variable-declaration! context
                                                     (ts-child ast list (load declaration-index)))
                          (store! declaration-index (+ (load declaration-index) 1)))))
              true)
          (= kind TSK-EXPRESSION-STATEMENT) (do (fng-expression context (ts-child ast node 0)) true)
          (= kind TSK-IF) (fng-if context node)
          (= kind TSK-DO)
            (fng-do-loop context
                         (ts-role ast node TS-ROLE-STATEMENT 0)
                         (ts-role ast node TS-ROLE-CONDITION 0)
                         -1)
          (= kind TSK-WHILE)
            (fng-loop context (ts-child ast node 0) (ts-child ast node 1) -1 -1 NO-NODE -1 -1)
          (= kind TSK-FOR)
            (let [count (ts-child-count ast node)
                  initialize (ts-child ast node 0)
                  condition (ts-child ast node 1)
                  increment (ts-child ast node 2)
                  body (ts-child ast node (- count 1))]
              (fng-statement context initialize)
              (fng-loop context condition body increment -1 NO-NODE -1
                        (fng-loop-lexical-cell-symbol context initialize)))
          (= kind TSK-FOR-OF) (fng-for-of context node -1)
          (= kind TSK-FOR-IN) (fng-for-in context node -1)
          (= kind TSK-SWITCH) (fng-switch context node -1)
          (= kind TSK-TRY) (fng-try-catch context node)
          (= kind TSK-VARIABLE-DECLARATION-LIST) (do (fng-statement context (ts-child ast node 0)) true)
          (= kind TSK-BREAK) (do (fng-capture-jump! context node FNG-JUMP-BREAK) false)
          (= kind TSK-CONTINUE) (do (fng-capture-jump! context node FNG-JUMP-CONTINUE) false)
          (= kind TSK-LABELED)
            (let [statement (ts-role ast node TS-ROLE-STATEMENT 0)
                  label (ts-role ast node TS-ROLE-LABEL 0)]
              (cond (= (ts-kind ast statement) TSK-DO)
                      (fng-do-loop context
                                   (ts-role ast statement TS-ROLE-STATEMENT 0)
                                   (ts-role ast statement TS-ROLE-CONDITION 0)
                                   label)
                    (= (ts-kind ast statement) TSK-WHILE)
                      (fng-loop context
                                (ts-child ast statement 0)
                                (ts-child ast statement 1)
                                -1
                                label
                                NO-NODE
                                -1
                                -1)
                    (= (ts-kind ast statement) TSK-FOR)
                      (let [count (ts-child-count ast statement)
                            initialize (ts-child ast statement 0)
                            condition (ts-child ast statement 1)
                            increment (ts-child ast statement 2)
                            body (ts-child ast statement (- count 1))]
                        (fng-statement context initialize)
                        (fng-loop context condition body increment label NO-NODE -1
                                  (fng-loop-lexical-cell-symbol context initialize)))
                    (= (ts-kind ast statement) TSK-FOR-OF) (fng-for-of context statement label)
                    (= (ts-kind ast statement) TSK-FOR-IN) (fng-for-in context statement label)
                    (= (ts-kind ast statement) TSK-SWITCH) (fng-switch context statement label)
                    :else (fng-labeled-block context statement label)))
          (= kind TSK-VARIABLE-DECLARATION)
            (do (fng-variable-declaration! context node) true)
          (= kind TSK-RETURN)
            (let [fn
                    (al-get [FeFunction]
                            (load (field frontend functions))
                            (fng-function-index frontend (load (field context owner))))
                  expected (fng-type-tag frontend (load (field fn result-node)))
                  value-node (if (> (ts-child-count ast node) 0) (ts-child ast node 0) -1)]
              ;; A bare `return;` has no expression child; it returns undefined. Lowering the
              ;; missing child produced a Return with an EMPTY value slot (VERR-DATA-SLOT).
              (fng-add-return! context
                               (if (< value-node 0)
                                   (fng-undefined)
                                   (fng-expression-expected context value-node expected)))
              false)
          (= kind TSK-THROW)
            (let [raised
                    (fng-jsl-call1 context "ThrowValue"
                                   (n-box! (fng-expression context (ts-child ast node 0))))]
              ;; ThrowValue set the runtime pending value. Source `throw` is already known abrupt,
              ;; so it routes directly. `%Throw` is an anchored effect in this block; unlike a call,
              ;; source throw does not need a runtime query to decide whether this edge is abrupt.
              (fng-abrupt-exception! context raised)
              (set! (load (field context ctrl)) NO-NODE)
              false)
          ;; A nested function declaration contributes no statement effect here — its body is
          ;; compiled as its own graph function. It MUST report fall-through: the default `false`
          ;; means "control diverged" and silently dropped every statement after the declaration.
          (= kind TSK-FUNCTION-DECLARATION) true
          ;; Same reasoning as the expression dispatch, and the note above is the evidence: a
          ;; default of `false` says "control diverged", so an unrecognised statement does not
          ;; merely fail to compile -- it silently deletes every statement after it. `for (const v
          ;; of xs)` reached here as bridge kind 0 and produced a graph whose control was stuck at
          ;; the Start node, with nothing to say why.
          :else (do (fng-unsupported-syntax! "statement" kind (ts-text ast node)) false))))

(defn fng-node-has-kind [(frontend (ptr NativeFrontend)) (node i64) (wanted i64)] (-> bool)
  (let [ast (field frontend ast)
        (mut index) 0
        (mut found) (= (ts-kind ast node) wanted)]
    (loop (if (or (load found) (>= (load index) (ts-child-count ast node)))
              (break)
              (do
                (set! found (fng-node-has-kind frontend (ts-child ast node (load index)) wanted))
                (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-node-accesses-type? [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        type (al-get [FeTypeDecl] (.types frontend) owner)
        (mut found) false
        (mut i) 0]
    (if (= kind TSK-PROPERTY-ACCESS)
        (let [property (ts-child ast node 1)]
          (loop (if (or (load found) (>= (load i) (.field-count type)))
                    (break)
                    (let [field-index (+ (.field-start type) (load i))]
                      (if (= (ts-text ast property) (fe-field-name frontend field-index))
                          (set! found true)
                          0)
                      (set! i (+ (load i) 1))))))
        0)
    (set! i 0)
    (loop (if (or (load found) (>= (load i) (ts-child-count ast node)))
              (break)
              (do
                (set! found (fng-node-accesses-type? frontend (ts-child ast node (load i)) owner))
                (set! i (+ (load i) 1)))))
    (load found)))

(defn fng-node-calls-effect [(frontend (ptr NativeFrontend))
                             (effects (ptr (ArrayList bool)))
                             (type-count i64)
                             (node i64)
                             (owner i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut found) false
        (mut index) 0]
    (if (or (= kind TSK-CALL) (= kind TSK-NEW-EXPRESSION))
        (let [callee-node (ts-child ast node 0)
              callee
                (if (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS)
                    (fe-find-function-name frontend (ts-child ast callee-node 1))
                    (fe-resolution-symbol frontend callee-node))]
          (if (>= callee 0)
              (set! found (al-get [bool] (load effects) (+ (* callee type-count) owner)))
              0))
        0)
    (loop (if (or (load found) (>= (load index) (ts-child-count ast node)))
              (break)
              (do
                (set! found
                      (fng-node-calls-effect frontend
                                             effects
                                             type-count
                                             (ts-child ast node (load index))
                                             owner))
                (set! index (+ (load index) 1)))))
    (load found)))

(defn fng-compute-effects! [(frontend (ptr NativeFrontend)) (effects (mut (ArrayList bool)))] (-> i64)
  (let [function-count (al-len [FeFunction] (.functions frontend))
        type-count (al-len [FeTypeDecl] (.types frontend))
        (mut fi) 0
        (mut ti) 0
        (mut changed) true]
    (loop (if (>= (load fi) function-count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load fi))
                    result-owner (fe-type-index-for-node frontend (.result-node fn))]
                (if (and (>= result-owner 0)
                         (fng-node-has-kind frontend (.body-node fn) TSK-OBJECT-LITERAL))
                    (al-set! [bool] (mut effects) (+ (* (.id fn) type-count) result-owner) true)
                    0)
                (set! ti 0)
                (loop (if (>= (load ti) type-count)
                          (break)
                          (do
                            (if (fng-node-accesses-type? frontend (.body-node fn) (load ti))
                                (al-set! [bool]
                                         (mut effects)
                                         (+ (* (.id fn) type-count) (load ti))
                                         true)
                                0)
                            (set! ti (+ (load ti) 1)))))
                (set! fi (+ (load fi) 1)))))
    (loop (if (not (load changed))
              (break)
              (do
                (set! changed false)
                (set! fi 0)
                (loop (if (>= (load fi) function-count)
                          (break)
                          (let [fn (al-get [FeFunction] (.functions frontend) (load fi))]
                            (set! ti 0)
                            (loop (if (>= (load ti) type-count)
                                      (break)
                                      (let [slot (+ (* (.id fn) type-count) (load ti))]
                                        (if (and (not (al-get [bool] (load effects) slot))
                                                 (fng-node-calls-effect frontend
                                                                        effects
                                                                        type-count
                                                                        (.body-node fn)
                                                                        (load ti)))
                                            (do (al-set! [bool] (mut effects) slot true) (set! changed true))
                                            0)
                                        (set! ti (+ (load ti) 1)))))
                            (set! fi (+ (load fi) 1)))))))
      0)))

(defn fng-build-layouts! [(frontend (ptr NativeFrontend))
                          (shapes (mut (ArrayList i64)))
                          (aliases (mut (ArrayList i64)))] (-> i64)
  (let [(mut ti) 0
        (mut fi) 0]
    (loop (if (>= (load ti) (al-len [FeTypeDecl] (.types frontend)))
              (break)
              (let [type (al-get [FeTypeDecl] (.types frontend) (load ti))
                    (mut shape) SHAPE-ROOT]
                (set! fi 0)
                (loop (if (>= (load fi) (.field-count type))
                          (break)
                          (let [field-index (+ (.field-start type) (load fi))
                                field-value (al-get [FeField] (.fields frontend) field-index)]
                            (set! shape
                                  (shape-transition (load shape)
                                                    (fe-field-name frontend field-index)
                                                    (fng-field-coil-type
                                                      frontend
                                                      shapes
                                                      (.type-node field-value))))
                            (set! fi (+ (load fi) 1)))))
                (al-push! [i64] (mut shapes) (load shape))
                (set! fi 0)
                (loop (if (>= (load fi) (.field-count type))
                          (break)
                          (do
                            (al-push! [i64] (mut aliases) (shape-field-alias (load shape) (load fi)))
                            (set! fi (+ (load fi) 1)))))
                (set! ti (+ (load ti) 1)))))
    0))

;; JavaScript hoists nested function declarations: their bindings hold callable closures from the
;; top of the enclosing body. Materialize each nested declaration's closure after locals (and so
;; capture cells) exist. Two phases make mutual references work: every cell-held identity first
;; gets a defined slot, then each closure is built in source order — a sibling captured through
;; its identity cell observes the closure stored a moment later. Every values[] slot touched is
;; recorded for restoration; a closure is a value owned by THIS function's control and must never
;; leak into another function's graph.
(defn fng-materialize-nested-declarations! [(context FngContext)
                                            (saved-symbols (mut (ArrayList i64)))
                                            (saved-values (mut (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        owner (.owner context)
        function-count (al-len [FeFunction] (.functions frontend))
        (mut any) false
        (mut index) 0]
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))
                    fn-id (.id fn)]
                (if (and (= (.parent fn) owner)
                         (and (= (ts-kind ast (.node fn)) TSK-FUNCTION-DECLARATION)
                              (or (> (fng-capture-count frontend fn-id) 0)
                                  (fng-symbol-cell? context fn-id))))
                    (do
                      (set! any true)
                      (al-push! [i64] (mut saved-symbols) fn-id)
                      (al-push! [i64]
                                (mut saved-values)
                                (al-get [i64] (load (load (field context values))) fn-id))
                      (if (fng-symbol-cell? context fn-id)
                          (do (fng-set-symbol! context fn-id (fng-undefined)) 0)
                          0))
                    0)
                (set! index (+ (load index) 1)))))
    ; A hoisted closure may capture a local whose initializer has not run yet — `var` semantics
    ; say that binding already exists as undefined. Give every cell-held local its cell now, so
    ; the closure captures the cell and observes the later assignment, not a missing value.
    (if (load any)
        (do
          (set! index 0)
          (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
                    (break)
                    (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))
                          symbol-id (.id symbol)]
                      (if (and (= (.owner symbol) owner)
                               (and (= (.role symbol) FE-ROLE-LOCAL)
                                    (and (fng-symbol-cell? context symbol-id)
                                         (= (fng-symbol-storage context symbol-id) NO-NODE))))
                          (do (fng-set-symbol! context symbol-id (fng-undefined)) 0)
                          0)
                      (set! index (+ (load index) 1))))))
        0)
    (set! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))
                    fn-id (.id fn)]
                (if (and (= (.parent fn) owner)
                         (and (= (ts-kind ast (.node fn)) TSK-FUNCTION-DECLARATION)
                              (or (> (fng-capture-count frontend fn-id) 0)
                                  (fng-symbol-cell? context fn-id))))
                    (let [closure (fng-closure-expression context (.node fn))]
                      (fng-set-symbol! context fn-id closure)
                      0)
                    0)
                (set! index (+ (load index) 1)))))
    0))

(defn fng-compile-function! [(frontend (ptr NativeFrontend))
                             (values (mut (ArrayList i64)))
                             (value-types (mut (ArrayList i64)))
                             (functions (mut (ArrayList i64)))
                             (prototypes (mut (ArrayList i64)))
                             (shapes (mut (ArrayList i64)))
                             (aliases (mut (ArrayList i64)))
                             (effects (mut (ArrayList bool)))
                             (reachable-functions (ptr (ArrayList bool)))
                             (type-count i64)
                             (cell-shape i64)
                             (cell-alias i64)
                             (function-index i64)
                             (top-level bool)] (-> i64)
  (let [fn (al-get [FeFunction] (.functions frontend) function-index)
        fun-id (.id fn)
        fun (if top-level NO-NODE (al-get [i64] (load functions) fun-id))
        (mut ctrl) (if top-level (g-start) (n-fun-entry fun))
        (mut memory) NO-NODE
        (mut first-return) NO-NODE
        (mut targets) (al-new [FngTarget] (malloc-allocator))
        (mut target-symbols) (al-new [i64] (malloc-allocator))
        (mut target-active) (al-new [i64] (malloc-allocator))
        (mut jumps) (al-new [FngJump] (malloc-allocator))
        (mut jump-values) (al-new [i64] (malloc-allocator))
        (mut exception-dependency) NO-NODE
        (mut dynamic-aliases) (al-new [i64] (malloc-allocator))
        (mut saved-capture-symbols) (al-new [i64] (malloc-allocator))
        (mut saved-capture-values) (al-new [i64] (malloc-allocator))
        (mut receiver) NO-NODE
        (mut index) 0]
    (if top-level
        0
        ;; The uniform callable ABI: parameter 0 is the hidden closure environment (dead for a
        ;; capture-free function, but the slot is always reserved so every generic call places
        ;; the receiver and arguments identically), the receiver sits at parameter 1, and the
        ;; declared parameters follow. Captured state arrives as cell pointers loaded from the
        ;; environment's fields at entry, and a lexical `this` is the environment's last field.
        (let [symbol-capture-count (fng-symbol-capture-count frontend fun-id)
              capture-count (fng-capture-count frontend fun-id)]
          (if (> capture-count 0)
              (let [entry (n-fun-entry fun)
                    env-shape (fng-env-shape-of frontend cell-shape fun-id)
                    ; The environment arrives as a TAGGED closure value — exact call sites box
                    ; it and generic call sites pass the callee value itself. Unbox, don't cast:
                    ; a wrong-tag value must trap here, not read garbage fields.
                    env (n-unbox! (n-parm! fun 0) (t-obj-shape env-shape))]
                ; The incoming memory's CONTENT type must be the field's declared type, not
                ; undefined: a `(t-undef)` content told inference the loads were provably
                ; undefined and the fold pass replaced every capture cell with a constant.
                (loop (if (>= (load index) symbol-capture-count)
                          (break)
                          (let [symbol (fng-capture-symbol frontend fun-id (load index))
                                alias (shape-field-alias env-shape (+ (load index) 1))
                                incoming (n-new1 (Arg (t-mem-alias alias (shape-alias-ty alias)))
                                                 entry)]
                            (al-push! [i64] (mut saved-capture-symbols) symbol)
                            (al-push! [i64]
                                      (mut saved-capture-values)
                                      (al-get [i64] (load values) symbol))
                            (al-set! [i64] (mut values) symbol (n-load! incoming env alias))
                            (set! index (+ (load index) 1)))))
                (if (fng-lexical-this? frontend fun-id)
                    (let [alias (shape-field-alias env-shape (+ symbol-capture-count 1))
                          incoming (n-new1 (Arg (t-mem-alias alias (shape-alias-ty alias)))
                                           entry)]
                      (set! receiver (n-load! incoming env alias))
                      0)
                    0))
              0)
          ; The receiver slot is reserved for EVERY callable — a function that never reads `this`
          ; simply leaves parameter 1 dead — so a value call needs no knowledge of its target's
          ; receiver-awareness: [env, receiver, arguments...] is the whole convention.
          (let [receiver-count
                  (if (and (not (.arrow fn))
                           (!= (.receiver-type-node fn) -1))
                      1
                      0)]
            (if (= receiver-count 1) (set! receiver (n-parm! fun 1)) 0)
            (set! index 0)
            (loop (if (>= (load index) (.parameter-count fn))
                      (break)
                      (let [symbol
                              (al-get [FeSymbol]
                                      (.symbols frontend)
                                      (+ (.parameter-start fn) (load index)))]
                        (let [parameter
                                (n-parm! fun (+ 2 (load index)))
                              declared (fng-parameter-type frontend fn (load index))]
                          ;; A declared `number` parameter already has a tagged-number ABI at every
                          ;; statically typed call boundary. Publish its machine value directly;
                          ;; rebuilding JavaScript's generic ToNumber control diamond in the callee
                          ;; made tiny callbacks impossible to inline and repeated work the caller's
                          ;; type contract had already established.
                          (al-set! [i64]
                                   (mut values)
                                   (.id symbol)
                                   (if (and (= declared FNG-NUMBER)
                                            (and (fng-array-callback-function?
                                                   frontend (ts-root (field frontend ast)) fun-id)
                                            (= (ts-role (field frontend ast)
                                                        (.node symbol)
                                                        TS-ROLE-INITIALIZER 0)
                                               -1)))
                                       (n-unbox! parameter (t-flt))
                                       parameter)))
                        (set! index (+ (load index) 1))))))))
    (let [context
            (fng-context frontend
                         values
                         value-types
                         functions
                         prototypes
                         shapes
                         aliases
                         effects
                         dynamic-aliases
                         type-count
                         ctrl
                         memory
                         first-return
                         targets
                         target-symbols
                         target-active
                         jumps
                         jump-values
                         exception-dependency
                         cell-shape
                         cell-alias
                         (load receiver)
                         fun-id
                         fun
                         top-level)]
      (if top-level
          ;; MAIN'S PARAMETERS NEED THE SAME CELLS. The loop below materializes a cell for every
          ;; parameter a nested closure captures, and it was skipped entirely for the top level --
          ;; so `main`'s parameters stayed bare `Arg` nodes in `values[]`. `fng-closure-expression`
          ;; then stored the RAW ARGUMENT into an environment slot typed as a cell pointer, while
          ;; the callee's body read that slot with `fng-symbol-node`, which for a captured symbol
          ;; is a `Cast` plus a `Load`. `function main(n) { let f = () => n; return f()|0; }`
          ;; therefore dereferenced the integer 5 and took SIGSEGV -- which the harness reported as
          ;; the answer 0, because a crashed program prints nothing and `atoll("")` is 0.
          ;;
          ;; Only the cell materialization is shared. `fng-default-parameter!` is not: a top-level
          ;; entry's arguments are `Arg` nodes that always exist, and it has its own `.top-level`
          ;; guard for exactly that reason.
          (do
            (set! index 0)
            (loop (if (>= (load index) (.parameter-count fn))
                      (break)
                      (do
                        (let [parameter-symbol
                                (al-get [FeSymbol]
                                        (.symbols frontend)
                                        (+ (.parameter-start fn) (load index)))
                              symbol-id (.id parameter-symbol)]
                          (if (fng-symbol-cell? context symbol-id)
                              ;; Clear the binding first, for the reason the non-top-level copy
                              ;; states: a raw node sitting in `values[]` is indistinguishable
                              ;; from an existing cell, and the parameter would be stored into
                              ;; itself.
                              (let [incoming (al-get [i64] (load (load (field context values)))
                                                     symbol-id)]
                                (al-set! [i64] (mut (load (field context values))) symbol-id NO-NODE)
                                (fng-set-symbol! context symbol-id incoming)
                                0)
                              0))
                        (set! index (+ (load index) 1)))))
            0)
          (do
            (set! index 0)
            (loop (if (>= (load index) (.parameter-count fn))
                      (break)
                      (do
                        (let [parameter-symbol
                                (al-get [FeSymbol]
                                        (.symbols frontend)
                                        (+ (.parameter-start fn) (load index)))
                              symbol-id (.id parameter-symbol)]
                          (fng-set-symbol-type! context
                                                symbol-id
                                                (fng-parameter-type frontend fn (load index)))
                          ;; A parameter captured by a nested closure lives in a CELL like any
                          ;; other captured local. Binding the raw Parm directly made the
                          ;; closure builder store the TAGGED parameter value into a cell-typed
                          ;; environment slot, and every reader dereferenced it as a cell
                          ;; (Field(dens,u,v)'s array params, read through getDensity's env).
                          ;; Re-storing through the symbol machinery materializes the cell.
                          (if (fng-symbol-cell? context symbol-id)
                              ;; Clear the binding first: the raw Parm sitting in values[] would
                              ;; otherwise be mistaken for an existing cell and the boxed
                              ;; parameter stored INTO ITSELF. NO-NODE routes fng-set-symbol!
                              ;; through cell creation.
                              (let [incoming (al-get [i64] (load (load (field context values)))
                                                     symbol-id)]
                                (al-set! [i64] (mut (load (field context values))) symbol-id NO-NODE)
                                (fng-set-symbol! context symbol-id incoming)
                                0)
                              0))
                        (fng-default-parameter! context fn (load index))
                        (set! index (+ (load index) 1)))))))
      (fng-initialize-locals! context)
      (fng-materialize-nested-declarations! context
                                            (mut saved-capture-symbols)
                                            (mut saved-capture-values))
      (if top-level (fng-top-level-initialize! context (mut reachable-functions)) 0)
      (let [body-node (.body-node fn)
            expression-body (!= (ts-kind (field frontend ast) body-node) TSK-BLOCK)
            falls-through
              (if expression-body
                  (let [expected (fng-type-tag frontend (.result-node fn))]
                    (fng-add-return! context
                                     (fng-expression-expected context body-node expected))
                    false)
                  (fng-statement context body-node))]
        (if (and (not top-level) falls-through)
            (fng-add-return! context (fng-undefined))
            0)
        ; An empty JavaScript function still returns undefined. Keep the graph callable even when
        ; an empty/nested body contributed no statement node to the fallthrough calculation.
        (if (and (not top-level) (= (load first-return) NO-NODE))
            (fng-add-return! context (fng-undefined))
            0)))
    (set! index 0)
    (loop (if (>= (load index) (al-len [i64] (load saved-capture-symbols)))
              (break)
              (do
                (al-set! [i64]
                         (mut values)
                         (al-get [i64] (load saved-capture-symbols) (load index))
                         (al-get [i64] (load saved-capture-values) (load index)))
                (set! index (+ (load index) 1)))))
    (al-free! [FngTarget] (mut targets))
    (al-free! [i64] (mut target-symbols))
    (al-free! [i64] (mut target-active))
    (al-free! [FngJump] (mut jumps))
    (al-free! [i64] (mut jump-values))
    (al-free! [i64] (mut dynamic-aliases))
    (al-free! [i64] (mut saved-capture-symbols))
    (al-free! [i64] (mut saved-capture-values))
    0))

(defn frontend-native-build-mode! [(frontend (mut NativeFrontend)) (seed i64) (optimize bool) (analyze bool)] (-> i64)
  (graph-reset! seed)
  (g-rep-strict! 1)
  (shape-reset!)
  (jss-reset!)
  ;; The JSL runtime library is READ and CHECKED here but nothing is lowered. `jsl-require!` pulls a
  ;; definition and its callees the first time the frontend emits a call to it, so a program that
  ;; uses no library builtin gets exactly the graph it got before this existed — which is what the
  ;; exact-`g-render` migration oracle in tests/frontend-exact-graph-test.mjs compares.
  (let [reuse (load (fng-reuse-jsl-index-ptr))
        ready (load (fng-jsl-index-ready-ptr))
        status (if (and reuse ready)
                   (jsl-reuse-checked!)
                   (do
                     (jsl-reset!)
                     (let [loaded (jsl-load-index! "lib/index")]
                       (if (and reuse (= loaded JSL-OK))
                           (set! (fng-jsl-index-ready-ptr) true)
                           0)
                       loaded)))]
  (if (!= status JSL-OK)
      (do (panic-corrupt "frontend: the JSL runtime library did not load") 0)
      0)
  )
  (jl-reset!)
  (set! (fng-window-calls-cell) 0)
  (set! (fng-window-scans-cell) 0)
  (set! (fng-profile-memory-alias-calls-ptr) 0)
  (set! (fng-profile-memory-alias-edges-ptr) 0)
  (set! (fng-profile-preserve-calls-ptr) 0)
  (set! (fng-profile-preserve-fields-ptr) 0)
  (set! (fng-profile-current-scans-ptr) 0)
  (set! (fng-profile-method-chains-ptr) 0)
  (set! (fng-profile-method-candidates-ptr) 0)
  (set! (fng-profile-static-method-calls-ptr) 0)
  (set! (fng-profile-static-method-hits-ptr) 0)
  (set! (fng-profile-static-method-scans-ptr) 0)
  (set! (fng-optimize-ptr) optimize)
  (let [main-index (fng-main-index frontend)
        main (al-get [FeFunction] (.functions frontend) main-index)
        main-id (.id main)
        function-count (al-len [FeFunction] (.functions frontend))
        (mut reachable-functions) (fng-reachable-functions frontend main-index)
        type-count (al-len [FeTypeDecl] (.types frontend))
        symbol-count (+ function-count (al-len [FeSymbol] (.symbols frontend)))
        (mut values) (al-new [i64] (malloc-allocator))
        (mut value-types) (al-new [i64] (malloc-allocator))
        (mut functions) (al-new [i64] (malloc-allocator))
        (mut prototypes) (al-new [i64] (malloc-allocator))
        (mut shapes) (al-new [i64] (malloc-allocator))
        (mut aliases) (al-new [i64] (malloc-allocator))
        (mut effects) (al-new [bool] (malloc-allocator))
        (mut cell-shape) SHAPE-ROOT
        (mut cell-alias) 0
        (mut index) 0
        (mut profile-start) (fng-profile-now)]
    (loop (if (>= (load index) symbol-count)
              (break)
              (do
                (al-push! [i64] (mut values) NO-NODE)
                (al-push! [i64] (mut value-types) FNG-DYNAMIC)
                (set! index (+ (load index) 1)))))
    ;; Install declared parameter/local types without creating graph nodes.
    (set! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (al-set! [i64]
                         (mut value-types)
                         (.id symbol)
                         (fng-type-tag frontend (.type-node symbol)))
                (set! index (+ (load index) 1)))))
    (fng-initialize-static-globals! frontend (mut values) (mut value-types))
    (set! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (do
                (al-push! [i64] (mut functions) NO-NODE)
                (al-push! [i64] (mut prototypes) NO-NODE)
                (set! index (+ (load index) 1)))))
    (set! index 0)
    (loop (if (>= (load index) (* function-count type-count))
              (break)
              (do (al-push! [bool] (mut effects) false) (set! index (+ (load index) 1)))))
    (fng-compute-effects! frontend (mut effects))
    (set! profile-start (fng-profile-note! "frontend_effects" (load profile-start)))
    ;; Shapes and aliases precede every graph function binding.
    (fng-build-layouts! frontend (mut shapes) (mut aliases))
    (set! profile-start (fng-profile-note! "frontend_layouts" (load profile-start)))
    (if (> (al-len [FeCapture] (.captures frontend)) 0)
        (do
          (set! cell-shape (shape-transition SHAPE-ROOT "__closure_cell" (t-dyn)))
          (set! cell-alias (shape-field-alias (load cell-shape) 0)))
        0)
    ;; JavaScript values use nonzero low finite-target ids because those identities cross the
    ;; tagged call boundary. Zero remains the runtime side-table's invalid-owner sentinel. Internal
    ;; JSL builtins occupy a disjoint namespace above them and are reached directly by their Fun
    ;; nodes; they do not consume dynamic-dispatch bits.
    ;; `FeFunction.id` is an exact identity and may exceed the finite target-summary width.
    ;; `fe-prioritize-prototype-functions!` has already moved dynamically published prototype
    ;; methods into the low summary namespace; all later functions are reached through exact
    ;; Fun/Closure identity and therefore do not consume a summary bit.
    (jsl-set-fidx-base! (+ function-count 1))
    (set! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (and (!= (.id fn) main-id)
                         (al-get [bool] (load reachable-functions) (load index)))
                    (al-set! [i64] (mut functions) (.id fn)
                             (n-fun-open! (+ (.id fn) 1)))
                    0)
                (set! index (+ (load index) 1)))))
    ;; Main Args are created immediately after the function roots.
    (set! index 0)
    (loop (if (>= (load index) (.parameter-count main))
              (break)
              (let [symbol
                      (al-get [FeSymbol]
                              (.symbols frontend)
                              (+ (.parameter-start main) (load index)))]
                (al-set! [i64]
                         (mut values)
                         (.id symbol)
                         (n-new1 (Arg (fng-coil-type frontend shapes (.type-node symbol)))
                                 (g-start)))
                (set! index (+ (load index) 1)))))
    ;; Bodies retain source declaration order, excluding main until the end.
    (set! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (.functions frontend) (load index))]
                (if (and (!= (.id fn) main-id)
                         (al-get [bool] (load reachable-functions) (load index)))
                    (do
                      (fng-compile-function! frontend
                                             (mut values)
                                             (mut value-types)
                                             (mut functions)
                                             (mut prototypes)
                                             (mut shapes)
                                             (mut aliases)
                                             (mut effects)
                                             (mut reachable-functions)
                                             type-count
                                             (load cell-shape)
                                             (load cell-alias)
                                             (load index)
                                             false)
                      ; Prototype allocations are ordinary runtime values owned by
                      ; the function control that created them. Do not leak one
                      ; function's lazy materialization into another CFG owner.
                      (let [(mut prototype-index) 0]
                        (loop (if (>= (load prototype-index) function-count)
                                  (break)
                                  (do
                                    (al-set! [i64] (mut prototypes)
                                             (load prototype-index) NO-NODE)
                                    (set! prototype-index (+ (load prototype-index) 1))))))
                      0)
                    0)
                (set! index (+ (load index) 1)))))
    ;; Nested capture parameters temporarily reuse the captured symbol's global slot while their
    ;; body is built. Parent locals must begin at NO-NODE when their own declarations execute.
    (set! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (.symbols frontend)))
              (break)
              (let [symbol (al-get [FeSymbol] (.symbols frontend) (load index))]
                (if (and (= (.owner symbol) main-id)
                         (= (.role symbol) FE-ROLE-LOCAL))
                    (al-set! [i64] (mut values) (.id symbol) NO-NODE)
                    0)
                (set! index (+ (load index) 1)))))
    (fng-compile-function! frontend
                           (mut values)
                           (mut value-types)
                           (mut functions)
                           (mut prototypes)
                           (mut shapes)
                           (mut aliases)
                           (mut effects)
                           (mut reachable-functions)
                           type-count
                           (load cell-shape)
                           (load cell-alias)
                           main-index
                           true)
    (fng-distribute-deferred-phi-boxes!)
    (fmt (stderr) "AOTK_PROFILE phase=frontend_build_shape nodes={d} live={d} peeps={d} window_calls={d} window_scans={d}\n"
         (n-count) (g-live-count) (g-profile-peeps)
         (load (fng-window-calls-cell)) (load (fng-window-scans-cell)))
    (fmt (stderr) "AOTK_PROFILE phase=jsl_dynamic_calls target_calls={d} target_scans={d} jsl_scans={d} max_calls={d} max_scans={d} param_scans={d} lower_ns={d} lower_calls={d} lower_nodes={d}\n"
         (jl-profile-target-calls) (jl-profile-target-scans) (jl-profile-jsl-scans)
         (jl-profile-max-calls) (jl-profile-max-scans) (jl-profile-param-scans)
         (jl-profile-lower-ns) (jl-profile-lower-calls) (jl-profile-lower-nodes))
    (fmt (stderr) "AOTK_PROFILE phase=frontend_memory alias_calls={d} alias_edges={d} preserve_calls={d} preserve_fields={d} current_scans={d} method_chains={d} method_candidates={d} static_method_calls={d} static_method_hits={d} static_method_scans={d}\n"
         (load (fng-profile-memory-alias-calls-ptr))
         (load (fng-profile-memory-alias-edges-ptr))
         (load (fng-profile-preserve-calls-ptr))
         (load (fng-profile-preserve-fields-ptr))
         (load (fng-profile-current-scans-ptr))
         (load (fng-profile-method-chains-ptr))
         (load (fng-profile-method-candidates-ptr))
         (load (fng-profile-static-method-calls-ptr))
         (load (fng-profile-static-method-hits-ptr))
         (load (fng-profile-static-method-scans-ptr)))
    (set! profile-start (fng-profile-note! "frontend_graph_build" (load profile-start)))
    (if analyze
        (do
          (let [phase (fng-profile-now)]
          (fng-discard-memory-scaffolding!)
          (fmt (stderr) "AOTK_TIMING phase=frontend_discard_memory ns={d}\n"
               (- (fng-profile-now) phase)))
          (fng-analyze-fresh!)
          (let [phase (fng-profile-now)
                inlined (if optimize (jl-inline-callback-calls!) 0)]
            (fmt (stderr) "AOTK_TIMING phase=frontend_inline_callbacks ns={d}\n"
                 (- (fng-profile-now) phase))
            (if (> inlined 0)
                (do (fng-analyze-fresh!)
                    (let [eliminate-phase (fng-profile-now)
                          eliminated (g-eliminate-dead-local-arrays!)]
                      (fmt (stderr) "AOTK_TIMING phase=frontend_eliminate_arrays ns={d}\n"
                           (- (fng-profile-now) eliminate-phase))
                      (if (> eliminated 0) (fng-analyze-fresh!) 0))) 0)))
        0)
    (let [phase (fng-profile-now)]
    (fng-discard-unused!)
      (fmt (stderr) "AOTK_TIMING phase=frontend_discard_unused ns={d}\n"
           (- (fng-profile-now) phase)))
    ;; A LOOP NOBODY READS SURVIVES EVERY FOLD. `n-kill!` refuses a node that still has users, and
    ;; each node in a loop's Phi cycle has one -- the next node round the cycle -- so a definition
    ;; from `lib/` whose result goes unread stays live, reachable from no root, and `v-pass-leaks`
    ;; refuses the graph. `"abcdef".toLowerCase()` compared only against `undefined` is the witness:
    ;; the comparison folds away, the loop does not, and the program does not compile.
    ;;
    ;; It runs HERE, after every rewrite and after the memory scaffolding is settled, because
    ;; reachability is a whole-graph question and the answer is only meaningful once the graph is
    ;; the one that will be verified -- inside the analyse/fold fixpoint the function's own memory
    ;; `Arg`s are not wired to the `Return` yet and every one of them looks unreachable.
    ;; The uncalled functions go FIRST: their bodies are full of memory nodes and calls, and the
    ;; sweep below refuses to run at all when an unreachable node has an effect. Pruning them here
    ;; leaves the sweep the question it was written for -- a dead loop with no consumer.
    (if analyze
        (let [phase (fng-profile-now)]
          (g-kill-uncalled-functions!)
          (g-sweep-unreachable!)
          (fmt (stderr) "AOTK_TIMING phase=frontend_sweep_unreachable ns={d}\n"
               (- (fng-profile-now) phase))
          0)
        0)
    ; The first-parameter symbol may not exist: a zero-parameter main leaves the symbol list
    ; empty and parameter-start at 0, so the lookup must sit INSIDE the count guard. Binding
    ; it unconditionally was an out-of-bounds al-get that only ever ran because the previous
    ; compiler inlined al-get and dead-code-eliminated the unused load.
    (let [answer
            (if (> (.parameter-count main) 0)
                (let [first (al-get [FeSymbol]
                                    (.symbols frontend)
                                    (.parameter-start main))]
                  (al-get [i64] (load values) (.id first)))
                NO-NODE)]
      (al-free! [i64] (mut values))
      (al-free! [i64] (mut value-types))
      (al-free! [i64] (mut functions))
      (al-free! [i64] (mut prototypes))
      (al-free! [i64] (mut shapes))
      (al-free! [i64] (mut aliases))
      (al-free! [bool] (mut effects))
      (al-free! [bool] (mut reachable-functions))
      answer)))

(defn frontend-native-build! [(frontend (mut NativeFrontend)) (seed i64) (optimize bool)] (-> i64)
  (frontend-native-build-mode! (mut frontend) seed optimize true))
