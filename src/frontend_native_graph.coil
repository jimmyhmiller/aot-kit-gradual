;; Direct ideal-graph construction from the Coil-owned native TypeScript frontend.
;; Node creation order intentionally mirrors frontend_coil_codegen.mjs. Exact
;; g-render equality, not merely execution equivalence, is the acceptance test.
(module frontendnativegraph)

(import "frontendnative" :use *)
(import "typescriptnative" :use *)
(import "ty" :use *)
(import "node" :use *)
(import "shape" :use *)
(import "jsstring" :use *)
(import "jsbuiltin" :use *)
(import "jsbuiltin_desc" :use *)
(import "jsl" :use *)
(import "jsl_lower" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)

(const FNG-DYNAMIC i64 -1)
(const FNG-NUMBER i64 -2)
(const FNG-BOOLEAN i64 -3)
(const FNG-NULL i64 -4)
(const FNG-VOID i64 -5)
(const FNG-LVALUE-LOCAL i64 0)
(const FNG-LVALUE-FIELD i64 1)
(const FNG-LVALUE-ELEMENT i64 2)
(const FNG-ARRAY i64 -6)
(const FNG-STRING i64 -7)
(const FNG-INTRINSIC-STRING i64 -8)
(const FNG-INTRINSIC-PARSEINT i64 -9)
(const FNG-INTRINSIC-ISNAN i64 -10)
(const FNG-INTRINSIC-ERROR i64 -11)
(const FNG-INTRINSIC-ARRAY i64 -12)
(const FNG-INTRINSIC-OBJECT i64 -13)
(const FNG-JUMP-BREAK i64 0)
(const FNG-JUMP-CONTINUE i64 1)

(defstruct FngLValue
  [(kind i64) (symbol i64) (object i64) (key i64) (alias i64) (shape i64)])

(defstruct FngTarget
  [(label-node i64)
   (can-break bool)
   (can-continue bool)
   (active bool)
   (symbol-start i64)
   (symbol-count i64)
   (active-start i64)
   (active-count i64)
   (jump-start i64)
   (jump-value-start i64)])

(defstruct FngJump [(target i64) (kind i64) (ctrl i64) (value-start i64)])

(defstruct FngContext
  [(frontend (ptr NativeFrontend))
   (values (ptr (ArrayList i64)))
   (value-types (ptr (ArrayList i64)))
   (functions (ptr (ArrayList i64)))
   (prototypes (ptr (ArrayList i64)))
   (shapes (ptr (ArrayList i64)))
   (aliases (ptr (ArrayList i64)))
   (effects (ptr (ArrayList bool)))
   (dynamic-aliases (ptr (ArrayList i64)))
   (type-count i64)
   (ctrl (ptr i64))
   (memory (ptr i64))
   (first-return (ptr i64))
   (targets (ptr (ArrayList FngTarget)))
   (target-symbols (ptr (ArrayList i64)))
   (target-active (ptr (ArrayList i64)))
   (jumps (ptr (ArrayList FngJump)))
   (jump-values (ptr (ArrayList i64)))
   (cell-shape i64)
   (cell-alias i64)
   (receiver i64)
   (owner i64)
   (fun i64)
   (top-level bool)])

(defn fng-context [(frontend (ptr NativeFrontend))
                   (values (ptr (ArrayList i64)))
                   (value-types (ptr (ArrayList i64)))
                   (functions (ptr (ArrayList i64)))
                   (prototypes (ptr (ArrayList i64)))
                   (shapes (ptr (ArrayList i64)))
                   (aliases (ptr (ArrayList i64)))
                   (effects (ptr (ArrayList bool)))
                   (dynamic-aliases (ptr (ArrayList i64)))
                   (type-count i64)
                   (ctrl (ptr i64))
                   (memory (ptr i64))
                   (first-return (ptr i64))
                   (targets (ptr (ArrayList FngTarget)))
                   (target-symbols (ptr (ArrayList i64)))
                   (target-active (ptr (ArrayList i64)))
                   (jumps (ptr (ArrayList FngJump)))
                   (jump-values (ptr (ArrayList i64)))
                   (cell-shape i64)
                   (cell-alias i64)
                   (receiver i64)
                   (owner i64)
                   (fun i64)
                   (top-level bool)] (-> FngContext)
  (let [(mut context) (zeroed FngContext)]
    (store! (field context frontend) frontend)
    (store! (field context values) values)
    (store! (field context value-types) value-types)
    (store! (field context functions) functions)
    (store! (field context prototypes) prototypes)
    (store! (field context shapes) shapes)
    (store! (field context aliases) aliases)
    (store! (field context effects) effects)
    (store! (field context dynamic-aliases) dynamic-aliases)
    (store! (field context type-count) type-count)
    (store! (field context ctrl) ctrl)
    (store! (field context memory) memory)
    (store! (field context first-return) first-return)
    (store! (field context targets) targets)
    (store! (field context target-symbols) target-symbols)
    (store! (field context target-active) target-active)
    (store! (field context jumps) jumps)
    (store! (field context jump-values) jump-values)
    (store! (field context cell-shape) cell-shape)
    (store! (field context cell-alias) cell-alias)
    (store! (field context receiver) receiver)
    (store! (field context owner) owner)
    (store! (field context fun) fun)
    (store! (field context top-level) top-level)
    (load context)))

(defn fng-optimize-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))

(defn fng-numeric-string-add-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))

(defn fng-falsify-numeric-string-add! [(enabled bool)] (-> i64)
  (store! (fng-numeric-string-add-ptr) enabled)
  0)

(defn fng-capture-by-value-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))

(defn fng-omit-receiver-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))

(defn fng-duplicate-receiver-ptr [] (-> (ptr bool))
  (let [enabled (static bool)] enabled))

(defn fng-analyze-fresh! [] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) (n-count))
              (break)
              (do
                (if (n-dead? (load index)) 0 (n-set-ty! (load index) (t-top)))
                (store! index (+ (load index) 1)))))
    (g-analyze!)
    ;; Analysis proves; this is what acts on the proof. See g-fold-proven!.
    (g-fold-proven!)))

(defn fng-peep [(node i64)] (-> i64)
  (if (load (fng-optimize-ptr)) (n-peephole node) node))

(defn fng-const [(value i64)] (-> i64)
  (n-new1 OP-CONST (t-int-con value) (g-start)))

(defn fng-bool [(value bool)] (-> i64)
  (n-new1 OP-CONST (t-bool-con value) (g-start)))

(defn fng-null [] (-> i64)
  (n-new1 OP-CONST (t-null) (g-start)))

(defn fng-undefined [] (-> i64)
  (n-new1 OP-CONST (t-undef) (g-start)))

(defn fng-string-literal [(ast TsAst) (node i64)] (-> i64)
  (let [(mut bytes) (al-new [u8] (malloc-allocator))
        text (ts-literal-text! ast node (mut bytes))
        string (jss-from-utf8! text)]
    (al-free! [u8] (mut bytes))
    (n-string-const! string)))

(defn fng-numeric-literal [(ast TsAst) (node i64)] (-> i64)
  (let [bits (ts-numeric-bits ast node)
        number (bits-f64 bits)]
    ;; TypeScript accepts hexadecimal, binary, and octal integer spellings that the decimal text
    ;; parser does not. Recover every exactly represented safe integer from the parser's numeric
    ;; value so bitwise loop Phis start in the GPR representation instead of an accidental FPR.
    (if (and (>= number -9007199254740991.0)
             (and (<= number 9007199254740991.0)
                  (= bits (f64-bits (cast f64 (cast i64 number))))))
        (fng-const (cast i64 number))
        (n-new1 OP-CONST (t-flt-bits bits) (g-start)))))

(defn fng-bin [(op i64) (left i64) (right i64)] (-> i64)
  (fng-peep (n-new3 op 0 NO-NODE left right)))

(defn fng-string-coerce [(context FngContext) (source i64) (value i64)] (-> i64)
  (if (= (fng-infer context source FNG-DYNAMIC) FNG-STRING) value (n-to-string! value)))

(defn fng-direct-call-object-type [(value i64)] (-> i64)
  (if (and (>= value 0) (= (n-op value) OP-CALL))
      (let [callee (n-in value 1)
            target (if (= (n-op callee) OP-CLOSURE) (n-in callee 0) callee)
            (mut index) 1
            (mut answer) (t-top)
            (mut valid) (= (n-op target) OP-FUN)]
        (loop (if (or (>= (load index) (n-nins target)) (not (load valid)))
                  (break)
                  (let [ret (n-in target (load index))]
                    (if (= (n-op ret) OP-RETURN)
                        (let [result-type (n-ty (n-in ret 1))]
                          (if (ty-only-obj? result-type)
                              (if (= (load answer) (t-top))
                                  (store! answer result-type)
                                  (if (!= (load answer) result-type) (store! valid false) 0))
                              (store! valid false)))
                        0)
                    (store! index (+ (load index) 1)))))
        (if (load valid) (load answer) (t-top)))
      (t-top)))

(defn fng-box-dynamic-argument! [(value i64)] (-> i64)
  ;; A Phi's semantic `dyn` type does not prove that its incoming machine words are tagged.
  ;; Lift the representation conversion through the merge so raw null/object arms are boxed,
  ;; while inputs already produced in the tagged ABI remain unchanged by backend selection.
  (let [(mut closed) true (mut probe) 1]
    (if (and (>= value 0) (= (n-op value) OP-PHI))
        (loop (if (or (>= (load probe) (n-nins value)) (not (load closed)))
                  (break)
                  (do
                    (if (= (n-in value (load probe)) NO-NODE) (store! closed false) 0)
                    (store! probe (+ (load probe) 1))
                    0)))
        0)
  (if (and (>= value 0) (and (= (n-op value) OP-PHI) (load closed)))
      (let [boxed (n-new OP-PHI (t-dyn))
            (mut index) 1]
        (n-add-def! boxed (n-in value 0))
        (loop (if (>= (load index) (n-nins value))
                  (break)
                  (do
                    (n-add-def! boxed
                                (if (= (n-in value (load index)) value)
                                    boxed
                                    (n-box! (n-in value (load index)))))
                    (store! index (+ (load index) 1)))))
        boxed)
      (let [object-type (fng-direct-call-object-type value)]
        (n-box! (if (= object-type (t-top))
                    value
                    (n-new2 OP-CAST object-type (n-in value 0) value)))))))

(defn fng-tagged-dynamic-value? [(value i64)] (-> bool)
  ;; Type computation can lag graph construction, so `n-ty == dyn` alone is not reliable while
  ;; lowering a body. These producers have a defined tagged-JavaScript-value machine ABI.
  (if (< value 0)
      false
      (let [op (n-op value)]
        (or (= op OP-PROPLOAD)
            (or (= op OP-ARRAYLOAD)
                (and (= op OP-LOAD) (= (shape-alias-ty (n-aux value)) (t-dyn))))))))

;; A dynamic argument can be consumed while a loop Phi is still open. At that point its backedge
;; is unknown, so `fng-box-dynamic-argument!` must leave a Box(Phi) placeholder. Once all function
;; bodies have closed their loops, distribute those placeholders across the incoming CFG edges.
;; Doing this as a graph repair (rather than an ordinary peephole replacement) is essential for a
;; loop Phi: the tagged replacement is self-referential and recursively peepholing it never reaches
;; a leaf.
(defn fng-distribute-deferred-phi-boxes! [] (-> i64)
  (let [limit (n-count)
        (mut node) 0]
    (loop (if (>= (load node) limit)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (= (n-op (load node)) OP-BOX))
                    (let [value (n-in (load node) 1)]
                      (if (and (!= value NO-NODE)
                               (and (not (n-dead? value)) (= (n-op value) OP-PHI)))
                          (let [(mut input) 1
                                (mut closed) true]
                            (loop (if (or (>= (load input) (n-nins value))
                                          (not (load closed)))
                                      (break)
                                      (do
                                        (if (= (n-in value (load input)) NO-NODE)
                                            (store! closed false)
                                            0)
                                        (store! input (+ (load input) 1)))))
                            (if (load closed)
                                (let [boxed (n-new OP-PHI (t-dyn))]
                                  (n-add-def! boxed (n-in value 0))
                                  (store! input 1)
                                  (loop (if (>= (load input) (n-nins value))
                                            (break)
                                            (do
                                              (let [incoming (n-in value (load input))]
                                                (n-add-def! boxed
                                                            (if (= incoming value)
                                                                boxed
                                                                (n-box! incoming))))
                                              (store! input (+ (load input) 1)))))
                                  (n-keep! boxed)
                                  (n-subsume! (load node) boxed)
                                  (n-unkeep! boxed)
                                  0)
                                0))
                          0))
                    0)
                (store! node (+ (load node) 1)))))
    0))

(defn fng-call-argument [(frontend (ptr NativeFrontend))
                         (fn FeFunction)
                         (ordinal i64)
                         (value i64)] (-> i64)
  (if (or (< ordinal 0) (>= ordinal (load (field fn parameter-count))))
      value
      (let [symbol
              (al-get [FeSymbol]
                      (load (field frontend symbols))
                      (+ (load (field fn parameter-start)) ordinal))
            parameter-type (fng-type-tag frontend (load (field symbol type-node)))]
        ;; Parm nodes carry JavaScript values. Numeric consumers therefore unbox typed number
        ;; parameters just as they unbox dynamic parameters; publish numeric actuals in that same
        ;; tagged ABI instead of passing an FPR/GPR word to a callee expecting a boxed value.
        (if (or (= parameter-type FNG-DYNAMIC) (= parameter-type FNG-NUMBER))
            (if (fng-tagged-dynamic-value? value) value (fng-box-dynamic-argument! value))
            value))))

(defn fng-condition-expression [(context FngContext) (source i64)] (-> i64)
  (let [value (fng-expression context source)]
    (if (= (fng-infer context source FNG-DYNAMIC) FNG-STRING)
        (n-string-length! value)
        value)))

(defn fng-nullish-literal? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)]
    (or (= kind TSK-NULL)
        (and (= kind TSK-IDENTIFIER)
             (= (fe-resolution-symbol frontend node) FE-INTRINSIC-UNDEFINED)))))

(defn fng-nullish-equal [(context FngContext) (source i64) (value i64)] (-> i64)
  (if (= (fng-infer context source FNG-DYNAMIC) FNG-DYNAMIC)
      (fng-bin OP-BITOR
               (fng-bin OP-EQ value (n-box! (fng-null)))
               (fng-bin OP-EQ value (n-box! (fng-undefined))))
      (fng-bin OP-EQ value (fng-null))))

(defn fng-int-value [(context FngContext) (source i64) (value i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        captured-cell
          (and (= (ts-kind ast source) TSK-IDENTIFIER)
               (let [symbol (fe-resolution-symbol frontend source)]
                 (and (>= symbol 0) (fng-symbol-cell? context symbol))))]
  (if (or (= (n-ty value) (t-dyn)) captured-cell)
      (if (or (= (n-op value) OP-CALL)
              (or (= (n-op value) OP-ADD)
                  (or (= (n-op value) OP-SUB)
                      (or (= (n-op value) OP-MUL)
                          (or (= (n-op value) OP-DIV) (= (n-op value) OP-MOD))))))
          value
          (fng-bin OP-BITOR (n-unbox! value (t-flt)) (fng-const 0)))
      (if (ty-isa (n-ty value) (t-num)) value value))))

(defn fng-number-value [(context FngContext) (source i64) (value i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        captured-cell
          (and (= (ts-kind ast source) TSK-IDENTIFIER)
               (let [symbol (fe-resolution-symbol frontend source)]
                 (and (>= symbol 0) (fng-symbol-cell? context symbol))))]
  (if (or (= (n-ty value) (t-dyn)) captured-cell)
      (if (or (= (n-op value) OP-CALL)
              (or (= (n-op value) OP-ADD)
                  (or (= (n-op value) OP-SUB)
                      (or (= (n-op value) OP-MUL)
                          (or (= (n-op value) OP-DIV) (= (n-op value) OP-MOD))))))
          value
          (n-unbox! value (t-flt)))
      (if (ty-isa (n-ty value) (t-num)) value value))))

(defn fng-numeric-equality-peer? [(value i64)] (-> bool)
  (let [ty (n-ty value)]
    (and (and (!= (ty-kinds ty) VK-NULL) (!= (ty-kinds ty) VK-UNDEF))
         (and (ty-isa ty (t-num))
         (if (!= (n-op value) OP-PHI)
             true
             ;; An open Phi initially has bottom type, which is below every concrete type.  Its
             ;; first real value is the only available evidence until the backedge is installed.
             (if (> (n-nins value) 1)
                 (let [initial-ty (n-ty (n-in value 1))]
                   (and (!= initial-ty (t-bot))
                        (and (!= initial-ty (t-dyn)) (ty-isa initial-ty (t-num)))))
                 false))))))

(defn fng-equal-value [(context FngContext)
                       (left-source i64) (left i64)
                       (right-source i64) (right i64)] (-> i64)
  (let [left-dynamic (or (= (n-ty left) (t-dyn)) (fng-tagged-dynamic-value? left))
        right-dynamic (or (= (n-ty right) (t-dyn)) (fng-tagged-dynamic-value? right))]
    ;; `dyn` includes numeric values, so `ty-isa dyn num` is true.  It is not proof that a
    ;; particular dynamic value is numeric.  In particular, an open loop Phi has bottom type before
    ;; its backedge arrives; bottom satisfies every `ty-isa` query and is not numeric evidence.
    (cond (or (fng-nullish-literal? context left-source)
              (fng-nullish-literal? context right-source))
            (fng-bin OP-EQ
                     (if left-dynamic left (n-box! left))
                     (if right-dynamic right (n-box! right)))
          (and left-dynamic (fng-numeric-equality-peer? right))
            (fng-bin OP-EQ (n-unbox! left (t-flt)) right)
          (and right-dynamic (fng-numeric-equality-peer? left))
            (fng-bin OP-EQ left (n-unbox! right (t-flt)))
          (or left-dynamic right-dynamic)
            (fng-bin OP-EQ
                     (if left-dynamic left (n-box! left))
                     (if right-dynamic right (n-box! right)))
          :else (fng-bin OP-EQ left right))))

(defn fng-type-tag [(frontend (ptr NativeFrontend)) (type-node i64)] (-> i64)
  (if (<= type-node -1)
      FNG-DYNAMIC
      (let [ast (field frontend ast)
            kind (ts-kind ast type-node)
            named (fe-type-index-for-node frontend type-node)]
        (cond (!= named -1) named
              (= kind TSK-NUMBER) FNG-NUMBER
              (= kind TSK-BOOLEAN) FNG-BOOLEAN
              (= kind TSK-NULL) FNG-NULL
              (= kind TSK-STRING) FNG-STRING
              (= kind TSK-ARRAY-LITERAL) FNG-ARRAY
              (= kind TSK-VOID) FNG-VOID
              :else FNG-DYNAMIC))))

(defn fng-coil-type [(frontend (ptr NativeFrontend))
                     (shapes (ptr (ArrayList i64)))
                     (type-node i64)] (-> i64)
  (let [tag (fng-type-tag frontend type-node)
        kind (if (<= type-node -1) -1 (ts-kind (field frontend ast) type-node))]
    (cond (= tag FNG-NUMBER) (t-int)
          (= tag FNG-BOOLEAN) (t-bool)
          ;; `null` is frequently only a mutable variable's initializer in JavaScript.
          ;; Using it as a Phi's declared upper bound freezes loop/branch merges at null
          ;; even after an object assignment reaches a backedge (DeltaBlue's prev/first/
          ;; last variables are the concrete witness). Constants remain precisely null;
          ;; only mutable-symbol merge declarations need the open dynamic bound.
          (= tag FNG-NULL) (t-dyn)
          (= tag FNG-STRING) (t-str)
          (>= tag 0) (t-obj-shape (al-get [i64] (load shapes) tag))
          (or (= kind TSK-TYPE-LITERAL) (= kind TSK-UNION-TYPE)) (t-obj)
          :else (t-int))))

(defn fng-field-coil-type [(frontend (ptr NativeFrontend))
                           (shapes (ptr (ArrayList i64)))
                           (type-node i64)] (-> i64)
  ;; Source `number` values use the JavaScript numeric ABI at calls, but a static object field must
  ;; have one raw in-memory representation. Use f64 so integer and fractional assignments share
  ;; the same slot representation across constructors and methods.
  (let [kind (if (<= type-node -1) -1 (ts-kind (field frontend ast) type-node))]
    (if (= (fng-type-tag frontend type-node) FNG-NUMBER)
        (t-flt)
        ;; Nullable and other union fields need the tagged representation: a raw object slot
        ;; cannot distinguish null from an object pointer while preserving both values.
        (if (= kind TSK-UNION-TYPE)
            (t-dyn)
            (fng-coil-type frontend shapes type-node)))))

(defn fng-field-index [(frontend (ptr NativeFrontend)) (owner i64) (name-node i64)] (-> i64)
  (let [name (ts-text (field frontend ast) name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeField] (load (field frontend fields)))) (!= (load answer) -1))
              (break)
              (let [field-value (al-get [FeField] (load (field frontend fields)) (load index))]
                (if (and (= (load (field field-value owner)) owner)
                         (str-eq name (fe-field-name frontend (load index))))
                    (store! answer (load index))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-unique-field-index [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (>= (load index) (al-len [FeField] (load (field frontend fields))))
              (break)
              (let [field-value (al-get [FeField] (load (field frontend fields)) (load index))]
                (if (str-eq name (fe-field-name frontend (load index)))
                    (if (= (load answer) -1)
                        (store! answer (load index))
                        (store! answer -2))
                    0)
                (store! index (+ (load index) 1)))))
    (if (= (load answer) -2) -1 (load answer))))

(defn fng-field-local-index [(frontend (ptr NativeFrontend)) (field-index i64)] (-> i64)
  (let [field-value (al-get [FeField] (load (field frontend fields)) field-index)
        owner (load (field field-value owner))
        type (al-get [FeTypeDecl] (load (field frontend types)) owner)]
    (- field-index (load (field type field-start)))))

(defn fng-memory [(ctrl i64) (alias i64)] (-> i64)
  ;; A function-entry memory argument represents an existing heap, not a freshly undefined field.
  ;; Static shape aliases carry their declared field type across calls; dynamic/runtime aliases
  ;; retain the conservative undefined seed until an explicit effect supplies stronger evidence.
  (n-new1 OP-ARG
          (t-mem-alias alias
                       (if (shape-alias-defined? alias) (shape-alias-ty alias) (t-undef)))
          ctrl))

(defn fng-merge [(memories (ptr (ArrayList i64)))] (-> i64)
  (let [merge (n-new OP-MEMMERGE 0)
        (mut index) 0]
    (n-add-def! merge NO-NODE)
    (loop (if (>= (load index) (al-len [i64] (load memories)))
              (break)
              (do
                (n-add-def! merge (al-get [i64] (load memories) (load index)))
                (store! index (+ (load index) 1)))))
    (fng-peep merge)))

(defn fng-memory-has-alias? [(memory i64) (alias i64)] (-> bool)
  (if (= memory NO-NODE)
      false
      (let [op (n-op memory)]
        (cond (= op OP-STORE) (= (n-aux memory) alias)
              (or (= op OP-PROPSTORE)
                  (or (= op OP-SETPROTO)
                      (or (= op OP-ARRAYSTORE) (or (= op OP-ARRAYRESIZE) (= op OP-ARRAYCOPY)))))
                (= alias JS-PROPERTY-ALIAS)
              (= op OP-MEMMERGE)
                (let [(mut index) 1
                      (mut found) false]
                  (loop (if (or (>= (load index) (n-nins memory)) (load found))
                            (break)
                            (do
                              (if (fng-memory-has-alias? (n-in memory (load index)) alias)
                                  (store! found true)
                                  0)
                              (store! index (+ (load index) 1)))))
                  (load found))
              (and (= op OP-PROJ) (= (n-op (n-in memory 0)) OP-NEW))
                (let [projection (n-aux memory)
                      nw (n-in memory 0)]
                  (and (> projection 0)
                       (= (shape-field-alias (n-aux nw) (- projection 1)) alias)))
              :else
              ;; A freshly built Phi has not computed its type yet; its declared memory slice is aux.
              (let [t (if (= op OP-PHI) (n-aux memory) (n-ty memory))]
                (and (ty-mem? t) (!= (& (ty-mem-aliases t) (<< 1 alias)) 0)))))))

(defn fng-memory-node? [(memory i64)] (-> bool)
  (if (= memory NO-NODE)
      false
      (let [op (n-op memory)]
        (or (= op OP-STORE)
            (or (= op OP-PROPSTORE)
                (or (= op OP-SETPROTO)
                    (or (= op OP-ARRAYSTORE)
                        (or (= op OP-ARRAYRESIZE)
                            (or (= op OP-ARRAYCOPY)
                                (or (= op OP-MEMMERGE)
                                    (or (and (= op OP-PROJ)
                                             (= (n-op (n-in memory 0)) OP-NEW))
                                        (let [t (if (= op OP-PHI) (n-aux memory) (n-ty memory))]
                                          (ty-mem? t)))))))))))))

(defn fng-current-memory [(context FngContext) (alias i64)] (-> i64)
  (let [memory (load (load (field context memory)))]
    (if (= memory NO-NODE)
        (fng-memory (load (load (field context ctrl))) alias)
        (if (= (n-op memory) OP-MEMMERGE)
            (let [(mut index) 1
                  (mut answer) NO-NODE]
              (loop (if (or (>= (load index) (n-nins memory)) (!= (load answer) NO-NODE))
                        (break)
                        (let [candidate (n-in memory (load index))]
                          (if (fng-memory-has-alias? candidate alias) (store! answer candidate) 0)
                          (store! index (+ (load index) 1)))))
              (if (= (load answer) NO-NODE)
                  (fng-memory (load (load (field context ctrl))) alias)
                  (load answer)))
            (if (fng-memory-has-alias? memory alias)
                memory
                (fng-memory (load (load (field context ctrl))) alias))))))

(defn fng-control [(context FngContext)] (-> i64)
  (load (load (field context ctrl))))

(defn fng-prop-load! [(context FngContext) (mem i64) (ptr i64) (name (slice u8))] (-> i64)
  (n-prop-load-at! (fng-control context) mem ptr name))

(defn fng-prop-store! [(context FngContext)
                        (mem i64)
                        (ptr i64)
                        (value i64)
                        (name (slice u8))] (-> i64)
  (n-prop-store-at! (fng-control context) mem ptr value name))

(defn fng-set-prototype! [(context FngContext) (mem i64) (ptr i64) (prototype i64)] (-> i64)
  (n-set-prototype-at! (fng-control context) mem ptr prototype))

(defn fng-array-load! [(context FngContext) (mem i64) (ptr i64) (index i64)] (-> i64)
  (n-array-load-at! (fng-control context) mem ptr index))

(defn fng-array-store! [(context FngContext)
                         (mem i64)
                         (ptr i64)
                         (index i64)
                         (value i64)] (-> i64)
  (n-array-store-at! (fng-control context) mem ptr index value))

(defn fng-array-length! [(context FngContext) (mem i64) (ptr i64)] (-> i64)
  (n-array-length-at! (fng-control context) mem ptr))

(defn fng-array-resize! [(context FngContext) (mem i64) (ptr i64) (length i64)] (-> i64)
  (n-array-resize-at! (fng-control context) mem ptr length))

(defn fng-array-resize-after! [(context FngContext)
                                (mem i64)
                                (ptr i64)
                                (length i64)
                                (value i64)] (-> i64)
  (n-array-resize-after-at! (fng-control context) mem ptr length value))

(defn fng-array-copy! [(context FngContext)
                        (mem i64)
                        (source i64)
                        (result i64)
                        (start i64)] (-> i64)
  (n-array-copy-at! (fng-control context) mem source result start))

(defn fng-effect? [(context FngContext) (owner i64)] (-> bool)
  (let [function-id (load (field context owner))
        type-count (load (field context type-count))]
    (al-get [bool] (load (load (field context effects))) (+ (* function-id type-count) owner))))

(defn fng-active-memory! [(context FngContext) (out (mut (ArrayList i64)))] (-> i64)
  (let [frontend (load (field context frontend))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeField] (load (field frontend fields))))
              (break)
              (let [field-value (al-get [FeField] (load (field frontend fields)) (load index))]
                ; Preserve every declared field alias at JavaScript calls and allocations. Receiver
                ; calls can expose an object through a closure or detached function, so the older
                ; return-type-only effect summary is not sound enough to discard an alias.
                (al-push! [i64] (mut out) (load index))
                (store! index (+ (load index) 1)))))
    0))

(defn fng-preserve-active-memory [(context FngContext) (primary i64)] (-> i64)
  (let [(mut active) (al-new [i64] (malloc-allocator))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (al-push! [i64] (mut memories) primary)
    (fng-active-memory! context (mut active))
    (loop (if (>= (load i) (al-len [i64] (load active)))
              (break)
              (let [field-index (al-get [i64] (load active) (load i))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (if (not (fng-memory-has-alias? primary alias))
                    (al-push! [i64] (mut memories) (fng-current-memory context alias))
                    0)
                (store! i (+ (load i) 1)))))
    (store! i 0)
    (loop (if (>= (load i) (al-len [i64] (load (field context dynamic-aliases))))
              (break)
              (let [alias (al-get [i64] (load (field context dynamic-aliases)) (load i))]
                (if (not (fng-memory-has-alias? primary alias))
                    (al-push! [i64] (mut memories) (fng-current-memory context alias))
                    0)
                (store! i (+ (load i) 1)))))
    (if (and (!= (load (field context cell-shape)) SHAPE-ROOT)
             (not (fng-memory-has-alias? primary (load (field context cell-alias)))))
        (al-push! [i64]
                  (mut memories)
                  (fng-current-memory context (load (field context cell-alias))))
        0)
    (let [answer (fng-merge memories)]
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut memories))
      answer)))

(defn fng-discard-memory-scaffolding! [] (-> i64)
  (let [limit (n-count)
        (mut node) 0]
    (loop (if (>= (load node) limit)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (= (n-op (load node)) OP-MEMMERGE)
                              (= (n-nouts (load node)) 0)))
                    (n-discard-scaffolding! (load node))
                    0)
                (store! node (+ (load node) 1)))))
    0))

;; Values held only in frontend construction tables are not graph uses. Once all bodies are closed,
;; sweep their unused leaves so speculative prototype/cell setup cannot survive as verifier leaks.
(defn fng-discard-unused! [] (-> i64)
  (let [(mut node) (- (n-count) 1)]
    (loop (if (< (load node) 0)
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (and (= (n-nouts (load node)) 0)
                              (and (= (n-keeps (load node)) 0)
                                   (and (!= (load node) (g-start))
                                        (and (!= (load node) (g-stop))
                                             ;; Parameter position is part of the callable ABI even
                                             ;; when this body does not read the value.
                                             (!= (n-op (load node)) OP-PARM))))))
                    (n-kill! (load node))
                    0)
                (store! node (- (load node) 1)))))
    0))

(defn fng-main-index [(frontend (ptr NativeFrontend))] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (load (field frontend functions)))) (!= (load answer) -1))
              (break)
              (if (str-eq (fe-function-name frontend (load index)) "main")
                  (store! answer (load index))
                  (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-function-index [(frontend (ptr NativeFrontend)) (id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (load (field frontend functions)))) (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load index))]
                (if (= (load (field fn id)) id) (store! answer (load index)) 0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-function-node-index [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeFunction] (load (field frontend functions))))
                  (!= (load answer) -1))
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load index))]
                (if (= (load (field fn node)) node) (store! answer (load index)) 0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-function-receiver-aware? [(frontend (ptr NativeFrontend)) (id i64)] (-> bool)
  (let [index (fng-function-index frontend id)]
    (if (< index 0)
        false
        (let [fn (al-get [FeFunction] (load (field frontend functions)) index)]
          (!= (load (field fn receiver-type-node)) -1)))))

(defn fng-static-global-expression? [(frontend (ptr NativeFrontend)) (node i64) (fuel i64)] (-> bool)
  (if (<= fuel 0)
      false
      (let [ast (field frontend ast)
            kind (ts-kind ast node)]
        (cond (= kind TSK-NUMERIC-LITERAL) true
              (= kind TSK-STRING-LITERAL) true
              (= kind TSK-NULL) true
              (= kind TSK-TRUE) true
              (= kind TSK-FALSE) true
              (= kind TSK-PARENTHESIZED-EXPRESSION)
                (fng-static-global-expression? frontend (ts-child ast node 0) (- fuel 1))
              (= kind TSK-IDENTIFIER)
                (fng-static-global-symbol-fuel? frontend (fe-resolution-symbol frontend node) (- fuel 1))
              (= kind TSK-PREFIX-UNARY)
                (fng-static-global-expression? frontend (ts-child ast node 0) (- fuel 1))
              (= kind TSK-BINARY)
                (and (fng-static-global-expression? frontend (ts-child ast node 0) (- fuel 1))
                     (fng-static-global-expression? frontend (ts-child ast node 2) (- fuel 1)))
              :else false))))

;; An immutable primitive constant expression has no runtime environment identity. Publish it as a
;; compilation-unit value so every function can reference it without manufacturing closure cells.
(defn fng-static-global-symbol-fuel? [(frontend (ptr NativeFrontend))
                                      (symbol-id i64)
                                      (fuel i64)] (-> bool)
  (let [ast (field frontend ast)
        (mut symbol-index) 0
        (mut declaration) -1
        (mut mutable) false
        (mut capture-index) 0]
    (loop (if (or (>= (load symbol-index) (al-len [FeSymbol] (load (field frontend symbols))))
                  (!= (load declaration) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load symbol-index))]
                (if (and (= (load (field symbol id)) symbol-id)
                         (= (load (field symbol role)) FE-ROLE-GLOBAL))
                    (store! declaration (load (field symbol node)))
                    0)
                (store! symbol-index (+ (load symbol-index) 1)))))
    (loop (if (or (load mutable)
                  (>= (load capture-index) (al-len [FeCapture] (load (field frontend captures)))))
              (break)
              (let [capture (al-get [FeCapture] (load (field frontend captures)) (load capture-index))]
                (if (and (= (load (field capture symbol)) symbol-id)
                         (load (field capture mutable)))
                    (store! mutable true)
                    0)
                (store! capture-index (+ (load capture-index) 1)))))
    (if (or (<= fuel 0)
            (or (= (load declaration) -1)
                (or (load mutable) (< (ts-child-count ast (load declaration)) 2))))
        false
        (let [initializer (ts-child ast (load declaration)
                                    (- (ts-child-count ast (load declaration)) 1))]
          (fng-static-global-expression? frontend initializer (- fuel 1))))))

(defn fng-static-global-symbol? [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> bool)
  (fng-static-global-symbol-fuel? frontend symbol-id 32))

(defn fng-runtime-capture? [(frontend (ptr NativeFrontend)) (capture FeCapture)] (-> bool)
  (not (fng-static-global-symbol? frontend (load (field capture symbol)))))

(defn fng-capture-count [(frontend (ptr NativeFrontend)) (function-id i64)] (-> i64)
  (let [(mut index) 0
        (mut count) 0]
    (loop (if (>= (load index) (al-len [FeCapture] (load (field frontend captures))))
              (break)
              (let [capture (al-get [FeCapture] (load (field frontend captures)) (load index))]
                (if (and (= (load (field capture function)) function-id)
                         (fng-runtime-capture? frontend capture))
                    (store! count (+ (load count) 1))
                    0)
                (store! index (+ (load index) 1)))))
    (load count)))

(defn fng-capture-symbol [(frontend (ptr NativeFrontend)) (function-id i64) (ordinal i64)] (-> i64)
  (let [(mut rank) 0
        (mut prior) -1
        (mut answer) -1]
    ; Canonical symbol order makes normalized polymorphic environments ABI-identical regardless
    ; of the source order in which each method first discovered a capture.
    (loop (if (> (load rank) ordinal)
              (break)
              (let [(mut index) 0 (mut next) 9223372036854775807]
                (loop (if (>= (load index)
                              (al-len [FeCapture] (load (field frontend captures))))
                          (break)
                          (let [capture (al-get [FeCapture]
                                               (load (field frontend captures))
                                               (load index))
                                symbol (load (field capture symbol))]
                            (if (and (= (load (field capture function)) function-id)
                                     (and (fng-runtime-capture? frontend capture)
                                          (and (> symbol (load prior)) (< symbol (load next)))))
                                (store! next symbol)
                                0)
                            (store! index (+ (load index) 1)))))
                (store! answer (load next))
                (store! prior (load next))
                (store! rank (+ (load rank) 1)))))
    (if (= (load answer) 9223372036854775807) -1 (load answer))))

(defn fng-capture-field-name [(ordinal i64)] (-> (slice u8))
  (case ordinal 0 "__capture0" 1 "__capture1" 2 "__capture2" 3 "__capture3"
        4 "__capture4" 5 "__capture5" 6 "__capture6" 7 "__capture7"
        8 "__capture8" 9 "__capture9" 10 "__capture10" 11 "__capture11"
        12 "__capture12" 13 "__capture13" 14 "__capture14" 15 "__capture15"
        16 "__capture16" 17 "__capture17" 18 "__capture18" 19 "__capture19"
        20 "__capture20" 21 "__capture21" 22 "__capture22" 23 "__capture23"
        24 "__capture24" 25 "__capture25" 26 "__capture26" 27 "__capture27"
        28 "__capture28" 29 "__capture29" 30 "__capture30" "__capture31"))

(defn fng-captured-symbol? [(frontend (ptr NativeFrontend)) (symbol i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (load (field frontend captures))))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (load (field frontend captures)) (load index))]
                (if (and (= (load (field capture symbol)) symbol)
                         (fng-runtime-capture? frontend capture))
                    (store! found true)
                    0)
                (store! index (+ (load index) 1)))))
    (load found)))

(defn fng-function-captures-symbol? [(frontend (ptr NativeFrontend))
                                     (function i64)
                                     (symbol i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [FeCapture] (load (field frontend captures))))
                  (load found))
              (break)
              (let [capture (al-get [FeCapture] (load (field frontend captures)) (load index))]
                (if (and (= (load (field capture function)) function)
                         (and (= (load (field capture symbol)) symbol)
                              (fng-runtime-capture? frontend capture)))
                    (store! found true)
                    0)
                (store! index (+ (load index) 1)))))
    (load found)))

(defn fng-symbol-cell? [(context FngContext) (symbol i64)] (-> bool)
  (let [frontend (load (field context frontend))
        owner (load (field context owner))]
    ; An owner materializes cells for locals/globals captured by descendants. A different
    ; function only treats the symbol as a cell when that function actually has the capture.
    (if (= (fe-symbol-owner frontend symbol) owner)
        (fng-captured-symbol? frontend symbol)
        (fng-function-captures-symbol? frontend owner symbol))))

(defn fng-record-dynamic-alias! [(context FngContext) (alias i64)] (-> i64)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [i64] (load (field context dynamic-aliases))))
                  (load found))
              (break)
              (do
                (if (= (al-get [i64] (load (field context dynamic-aliases)) (load index)) alias)
                    (store! found true)
                    0)
                (store! index (+ (load index) 1)))))
    (if (not (load found))
        (al-push! [i64] (mut (load (field context dynamic-aliases))) alias)
        0)
    alias))

(defn fng-symbol-storage [(context FngContext) (symbol i64)] (-> i64)
  (al-get [i64] (load (load (field context values))) symbol))

(defn fng-symbol-node [(context FngContext) (symbol i64)] (-> i64)
  (if (or (load (fng-capture-by-value-ptr))
          (not (fng-symbol-cell? context symbol)))
      (fng-symbol-storage context symbol)
      (let [cell (fng-symbol-storage context symbol)
            alias (load (field context cell-alias))
            cast-node
              (n-new2 OP-CAST
                      (t-obj-shape (load (field context cell-shape)))
                      (load (load (field context ctrl)))
                      cell)]
        (n-load! (fng-current-memory context alias) cast-node alias))))

(defn fng-set-symbol! [(context FngContext) (symbol i64) (node i64)] (-> i64)
  (if (or (load (fng-capture-by-value-ptr))
          (not (fng-symbol-cell? context symbol)))
      (al-set! [i64] (mut (load (field context values))) symbol node)
      (let [cell (fng-symbol-storage context symbol)
            alias (load (field context cell-alias))]
        (if (= cell NO-NODE)
            (let [incoming (stack (array i64 1))]
              (store! (index incoming 0) (fng-current-memory context alias))
              (let [nw
                      (n-new-obj! (load (load (field context ctrl)))
                                  (load (field context cell-shape))
                                  (slice-new [i64] (cast (ptr i64) incoming) 1))
                    object (n-obj-ptr nw)
                    stored
                      (n-store! (n-obj-mem nw 0)
                                object
                                (fng-box-dynamic-argument! node)
                                alias)]
                (al-set! [i64] (mut (load (field context values))) symbol object)
                (store! (load (field context memory)) (fng-preserve-active-memory context stored))
                node))
            (let [cast-node
                    (n-new2 OP-CAST
                            (t-obj-shape (load (field context cell-shape)))
                            (load (load (field context ctrl)))
                            cell)
                  stored
                    (n-store! (fng-current-memory context alias)
                              cast-node
                              (fng-box-dynamic-argument! node)
                              alias)]
              (store! (load (field context memory)) (fng-preserve-active-memory context stored))
              node)))))

(defn fng-symbol-type [(context FngContext) (symbol i64)] (-> i64)
  (al-get [i64] (load (load (field context value-types))) symbol))

(defn fng-symbol-coil-type [(context FngContext) (symbol i64)] (-> i64)
  (let [tag (fng-symbol-type context symbol)]
    (cond (= tag FNG-NUMBER) (t-int)
          (= tag FNG-BOOLEAN) (t-bool)
          ;; Null is commonly only the initializer of a mutable JavaScript
          ;; variable. Keep its merge bound open so an object assignment on a
          ;; branch or loop backedge can widen the Phi.
          (= tag FNG-NULL) (t-dyn)
          :else (t-dyn))))

(defn fng-set-symbol-type! [(context FngContext) (symbol i64) (type i64)] (-> i64)
  (al-set! [i64] (mut (load (field context value-types))) symbol type))

(defn fng-intrinsic-type [(symbol i64)] (-> i64)
  (cond (= symbol FE-INTRINSIC-STRING) FNG-INTRINSIC-STRING
        (= symbol FE-INTRINSIC-PARSEINT) FNG-INTRINSIC-PARSEINT
        (= symbol FE-INTRINSIC-ISNAN) FNG-INTRINSIC-ISNAN
        (= symbol FE-INTRINSIC-UNDEFINED) FNG-VOID
        (= symbol FE-INTRINSIC-NAN) FNG-NUMBER
        (= symbol FE-INTRINSIC-ERROR) FNG-INTRINSIC-ERROR
        (= symbol FE-INTRINSIC-ARRAY) FNG-INTRINSIC-ARRAY
        (= symbol FE-INTRINSIC-OBJECT) FNG-INTRINSIC-OBJECT
        :else FNG-DYNAMIC))

(defn fng-declared-symbol-type [(frontend (ptr NativeFrontend)) (symbol-id i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) FNG-DYNAMIC]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
                  (!= (load answer) FNG-DYNAMIC))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (= (load (field symbol id)) symbol-id)
                    (store! answer (fng-type-tag frontend (load (field symbol type-node))))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

; Closed-world JavaScript field inference. A dynamic property is array-valued only
; when every direct assignment to that property in the compilation unit creates an
; array. State: 0 = unseen, 1 = array-only, 2 = conflicting/non-array assignment.
(defn fng-array-property-scan [(frontend (ptr NativeFrontend))
                               (node i64)
                               (name (slice u8))] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (and (= kind TSK-BINARY)
             (str-eq (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS)
             (str-eq (ts-text ast (ts-child ast (ts-child ast node 0) 1)) name))
        (let [value (ts-child ast node 2)
              value-kind (ts-kind ast value)]
          (if (or (= value-kind TSK-ARRAY-LITERAL)
                  (and (= value-kind TSK-NEW-EXPRESSION)
                       (= (fe-resolution-symbol frontend (ts-child ast value 0))
                          FE-INTRINSIC-ARRAY)))
              1
              2))
        (let [(mut index) 0
              (mut state) 0]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (= (load state) 2))
                    (break)
                    (let [child-state
                            (fng-array-property-scan frontend
                                                     (ts-child ast node (load index))
                                                     name)]
                      (if (= child-state 2)
                          (store! state 2)
                          (if (= child-state 1) (store! state 1) 0))
                      (store! index (+ (load index) 1)))))
          (load state)))))

(defn fng-array-property? [(frontend (ptr NativeFrontend)) (name-node i64)] (-> bool)
  (= (fng-array-property-scan frontend
                              (ts-root (field frontend ast))
                              (ts-text (field frontend ast) name-node))
     1))

(defn fng-call-result-type [(frontend (ptr NativeFrontend))
                            (callee i64)
                            (construct bool)] (-> i64)
  (let [function-index (fng-function-index frontend callee)]
    ;; Prototype and other dynamic property calls can have closed-world targets without one direct
    ;; function symbol. Their result remains dynamic at this stage; never index functions at -1.
    (if (< function-index 0)
        FNG-DYNAMIC
        (let [fn (al-get [FeFunction] (load (field frontend functions)) function-index)
              result (fng-type-tag frontend (load (field fn result-node)))]
          ;; TypeScript permits constructor-style factory functions which return a declared object
          ;; type without using `this` (for example `new Tree(left, right): Tree`).  In that case
          ;; the explicit object return, not the absent receiver annotation, describes the value
          ;; produced by `new`.  Primitive returns still fall back to the receiver because
          ;; JavaScript ignores them for constructor calls.
          (if (and construct (>= result 0))
              result
              (if construct
                  (fng-type-tag frontend (load (field fn receiver-type-node)))
                  result))))))

(defn fng-infer [(context FngContext) (node i64) (expected i64)] (-> i64)
  (if (!= expected FNG-DYNAMIC)
      expected
      (let [frontend (load (field context frontend))
            ast (field frontend ast)
            kind (ts-kind ast node)]
        (cond (= kind TSK-IDENTIFIER)
                (let [symbol (fe-resolution-symbol frontend node)]
                  (if (< symbol 0) (fng-intrinsic-type symbol) (fng-symbol-type context symbol)))
              (= kind TSK-THIS)
                (let [fn
                        (al-get [FeFunction]
                                (load (field frontend functions))
                                (fng-function-index frontend (load (field context owner))))]
                  (fng-type-tag frontend (load (field fn receiver-type-node))))
              (= kind TSK-NUMERIC-LITERAL) FNG-NUMBER
              (= kind TSK-STRING-LITERAL) FNG-STRING
              (= kind TSK-PARENTHESIZED-EXPRESSION)
                (fng-infer context (ts-child ast node 0) FNG-DYNAMIC)
              (or (= kind TSK-TRUE) (= kind TSK-FALSE)) FNG-BOOLEAN
              (= kind TSK-NULL) FNG-NULL
              (= kind TSK-ARRAY-LITERAL) FNG-ARRAY
              (or (= kind TSK-CALL) (= kind TSK-NEW-EXPRESSION))
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-OBJECT))
                    FNG-DYNAMIC
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ARRAY))
                    FNG-ARRAY
                (if (and (= kind TSK-NEW-EXPRESSION)
                         (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ERROR))
                    FNG-DYNAMIC
                (let [callee-type
                        (if (= kind TSK-CALL)
                            (fng-infer context (ts-child ast node 0) FNG-DYNAMIC)
                            FNG-DYNAMIC)]
                  (if (or (= callee-type FNG-INTRINSIC-STRING)
                          (or (= callee-type FNG-INTRINSIC-PARSEINT)
                              (= callee-type FNG-INTRINSIC-ISNAN)))
                      (if (= callee-type FNG-INTRINSIC-STRING)
                          FNG-STRING
                          (if (= callee-type FNG-INTRINSIC-ISNAN) FNG-BOOLEAN FNG-NUMBER))
                      (if (and (= kind TSK-CALL) (fng-number-to-string? context node))
                          FNG-STRING
                          (if (and (= kind TSK-CALL) (fng-string-from-char-code? context node))
                              FNG-STRING
                              (if (and (= kind TSK-CALL) (fng-string-builtin? context node))
                                  (let [builtin (fng-string-builtin-name context node)]
                                    (if (str-eq builtin "charCodeAt")
                                        FNG-NUMBER
                                        (if (str-eq builtin "indexOf")
                                            FNG-NUMBER
                                            (if (str-eq builtin "split") FNG-ARRAY FNG-STRING))))
                                  (if (and (= kind TSK-CALL) (fng-math-builtin? context node))
                                      FNG-NUMBER
                                  (if (and (= kind TSK-CALL) (fng-array-builtin? context node))
                                      (let [builtin (fng-array-builtin-name context node)]
                                        (if (str-eq builtin "push")
                                            FNG-NUMBER
                                            (if (str-eq builtin "slice") FNG-ARRAY FNG-DYNAMIC)))
                                      (let [callee-node (ts-child ast node 0)
                                            callee
                                              (if (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS)
                                                  (fe-find-function-name frontend (ts-child ast callee-node 1))
                                                  (fe-resolution-symbol frontend callee-node))]
                                      (fng-call-result-type
                                        frontend callee (= kind TSK-NEW-EXPRESSION)))))))))))))
              (= kind TSK-PROPERTY-ACCESS)
                (let [owner (fng-infer context (ts-child ast node 0) FNG-DYNAMIC)
                      name-node (ts-child ast node 1)
                      field-index
                        (if (= owner FNG-DYNAMIC)
                            -1
                            (fng-field-index frontend owner name-node))]
                  (if (< field-index 0)
                      (if (and (= owner FNG-DYNAMIC)
                               (fng-array-property? frontend name-node))
                          FNG-ARRAY
                          FNG-DYNAMIC)
                      (let [field-value (al-get [FeField] (load (field frontend fields)) field-index)]
                        (fng-type-tag frontend (load (field field-value type-node))))))
              (= kind TSK-PREFIX-UNARY)
                (let [text (ts-text ast node)]
                  (if (and (> (slice-len text) 0) (str-eq (substr text 0 1) "!"))
                      FNG-BOOLEAN
                      FNG-NUMBER))
              (= kind TSK-POSTFIX-UNARY) FNG-NUMBER
              (= kind TSK-CONDITIONAL-EXPRESSION) expected
              (= kind TSK-BINARY)
                (let [operator (ts-text ast (ts-child ast node 1))]
                  (if (or (str-eq operator "<")
                          (str-eq operator "<=")
                          (str-eq operator ">")
                          (str-eq operator ">=")
                          (str-eq operator "==")
                          (str-eq operator "!=")
                          (str-eq operator "===")
                          (str-eq operator "!=="))
                      FNG-BOOLEAN
                      (if (or (str-eq operator "%")
                              (or (str-eq operator "&")
                                  (or (str-eq operator "|")
                                      (or (str-eq operator "^")
                                          (or (str-eq operator "<<")
                                              (or (str-eq operator ">>")
                                                  (str-eq operator ">>>")))))))
                          FNG-NUMBER
                          (fng-infer context (ts-child ast node 0) FNG-DYNAMIC))))
              :else FNG-DYNAMIC))))

(defn fng-expression [(context FngContext) (node i64)] (-> i64)
  (fng-expression-expected context node FNG-DYNAMIC))

(defn fng-closure-expression [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        function-index (fng-function-node-index frontend node)
        fn (al-get [FeFunction] (load (field frontend functions)) function-index)
        function-id (load (field fn id))
        target (al-get [i64] (load (load (field context functions))) function-id)
        (mut captures) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (fng-capture-count frontend function-id))
              (break)
              (let [symbol (fng-capture-symbol frontend function-id (load index))]
                (al-push! [i64]
                          (mut captures)
                          (if (load (fng-capture-by-value-ptr))
                              (fng-symbol-node context symbol)
                              (fng-symbol-storage context symbol)))
                (store! index (+ (load index) 1)))))
    (let [closure
            (if (= (al-len [i64] (load captures)) 0)
                target
                (if (load (fng-capture-by-value-ptr))
                    (n-closure! target (al-slice [i64] (load captures)))
                (let [(mut shape) SHAPE-ROOT
                      (mut incoming) (al-new [i64] (malloc-allocator))
                      (mut stores) (al-new [i64] (malloc-allocator))
                      (mut i) 0]
                  ; Captures are shared cell pointers. A shape per ordered symbol list gives the moving
                  ; collector an exact pointer layout for the environment object.
                  (loop (if (>= (load i) (al-len [i64] (load captures)))
                            (break)
                            (do
                              (store! shape
                                      (shape-transition (load shape)
                                                        (fng-capture-field-name (load i))
                                                        (t-obj-shape (load (field context cell-shape)))))
                              (store! i (+ (load i) 1)))))
                  (store! i 0)
                  (loop (if (>= (load i) (shape-field-count (load shape)))
                            (break)
                            (let [alias
                                    (fng-record-dynamic-alias! context
                                                               (shape-field-alias (load shape) (load i)))]
                              (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                              (store! i (+ (load i) 1))
                              0)))
                  (let [nw
                          (n-new-obj! (load (load (field context ctrl)))
                                      (load shape)
                                      (al-slice [i64] (load incoming)))
                        object (n-obj-ptr nw)]
                    (store! i 0)
                    (loop (if (>= (load i) (al-len [i64] (load captures)))
                              (break)
                              (do
                                (al-push! [i64]
                                          (mut stores)
                                          (n-store! (n-obj-mem nw (load i))
                                                    object
                                                    (al-get [i64] (load captures) (load i))
                                                    (shape-field-alias (load shape) (load i))))
                                (store! i (+ (load i) 1))
                                0)))
                    (store! (load (field context memory))
                            (fng-preserve-active-memory context (fng-merge stores)))
                    (let [answer (n-materialized-closure! target object (al-slice [i64] (load captures)))]
                      (al-free! [i64] (mut incoming))
                      (al-free! [i64] (mut stores))
                      answer)))))]
      (al-free! [i64] (mut captures))
      closure)))

(defn fng-empty-object [(context FngContext) (owner i64)] (-> i64)
  (let [frontend (load (field context frontend))
        type (al-get [FeTypeDecl] (load (field frontend types)) owner)
        shape (al-get [i64] (load (load (field context shapes))) owner)
        field-start (load (field type field-start))
        field-count (load (field type field-count))
        (mut incoming) (al-new [i64] (malloc-allocator))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) field-count)
              (break)
              (let [alias (al-get [i64] (load (load (field context aliases))) (+ field-start (load i)))]
                (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                (store! i (+ (load i) 1)))))
    (let [nw (n-new-obj! (load (load (field context ctrl))) shape (al-slice [i64] (load incoming)))
          object (n-obj-ptr nw)]
      (store! i 0)
      (loop (if (>= (load i) field-count)
                (break)
                (do
                  (al-push! [i64] (mut memories) (n-obj-mem nw (load i)))
                  (store! i (+ (load i) 1))
                  0)))
      (fng-active-memory! context (mut active))
      (store! i 0)
      (loop (if (>= (load i) (al-len [i64] (load active)))
                (break)
                (let [field-index (al-get [i64] (load active) (load i))
                      field (al-get [FeField] (load (field frontend fields)) field-index)]
                  (if (= (load (field field owner)) owner)
                      0
                      (let [alias (al-get [i64] (load (load (field context aliases))) field-index)]
                        (al-push! [i64] (mut memories) (fng-current-memory context alias))))
                  (store! i (+ (load i) 1)))))
      (if (> (al-len [FeCapture] (load (field frontend captures))) 0)
          (al-push! [i64]
                    (mut memories)
                    (fng-current-memory context (load (field context cell-alias))))
          0)
      (store! (load (field context memory)) (fng-merge memories))
      (al-free! [i64] (mut incoming))
      (al-free! [i64] (mut memories))
      (al-free! [i64] (mut active))
      object)))

(defn fng-empty-dynamic-object [(context FngContext)] (-> i64)
  (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
  (n-obj-ptr (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)))

(defn fng-pin-after-call! [(context FngContext) (dependency i64) (value i64)] (-> i64)
  ; Both truthiness arms rejoin immediately. The branch exists only to make the post-call control
  ; dependency explicit; unlike `dependency === dependency`, it cannot fold away under peep.
  (let [arms (n-if-arms! (n-new2 OP-IF 0 (load (load (field context ctrl))) dependency))
        region (n-new OP-REGION 0)]
    (n-add-def! region NO-NODE)
    (n-add-def! region (arms-t arms))
    (n-add-def! region (arms-f arms))
    (store! (load (field context ctrl)) region)
    value))

(defn fng-prototype-parent [(frontend (ptr NativeFrontend)) (constructor i64)] (-> i64)
  (let [(mut index) 0 (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FePrototypeParent] (load (field frontend prototype-parents))))
                  (!= (load answer) -1))
              (break)
              (let [relation
                      (al-get [FePrototypeParent]
                              (load (field frontend prototype-parents))
                              (load index))]
                (if (= (load (field relation constructor)) constructor)
                    (store! answer (load (field relation parent)))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

;; Resolve a prototype method by property name when the closed world contains exactly one
;; implementation.  This covers the common monomorphic JavaScript method-call case while
;; leaving genuinely polymorphic names as dynamic calls for later dispatch lowering.
(defn fng-unique-prototype-method [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (load (field frontend prototype-methods))))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (load (field frontend prototype-methods))
                              (load index))]
                (if (str-eq name (ts-text ast (load (field method name-node))))
                    (if (= (load answer) -1)
                        (store! answer (load (field method target)))
                        (store! answer -2))
                    0)
                (store! index (+ (load index) 1)))))
    (if (= (load answer) -2) -1 (load answer))))

(defn fng-prototype-method-targets [(frontend (ptr NativeFrontend)) (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut index) 0
        (mut targets) 0
        (mut captures) -1
        (mut valid) true]
    (loop (if (>= (load index)
                  (al-len [FePrototypeMethod] (load (field frontend prototype-methods))))
              (break)
              (let [method
                      (al-get [FePrototypeMethod]
                              (load (field frontend prototype-methods))
                              (load index))
                    target (load (field method target))]
                (if (str-eq name (ts-text ast (load (field method name-node))))
                    (let [count (fng-capture-count frontend target)]
                      (if (or (< target 0) (>= target 63))
                          (store! valid false)
                          (if (= (load captures) -1)
                              (store! captures count)
                              (if (!= (load captures) count) (store! valid false) 0)))
                      (store! targets (| (load targets) (<< 1 target))))
                    0)
                (store! index (+ (load index) 1)))))
    (if (load valid) (load targets) 0)))

(defn fng-constructor-descends-from? [(frontend (ptr NativeFrontend))
                                      (constructor i64)
                                      (ancestor i64)] (-> bool)
  (let [(mut current) constructor
        (mut fuel) 64
        (mut found) false]
    (loop (if (or (< (load current) 0)
                  (or (<= (load fuel) 0) (load found)))
              (break)
              (do
                (if (= (load current) ancestor) (store! found true) 0)
                (if (not (load found))
                    (store! current (fng-prototype-parent frontend (load current)))
                    0)
                (store! fuel (- (load fuel) 1)))))
    (load found)))

(defn fng-constructor-prototype! [(context FngContext) (constructor i64)] (-> i64)
  (let [prototypes (load (field context prototypes))
        existing (al-get [i64] (load prototypes) constructor)]
    (if (!= existing NO-NODE)
        existing
        (let [frontend (load (field context frontend))
              ast (field frontend ast)
              object (fng-empty-dynamic-object context)
              parent (fng-prototype-parent frontend constructor)
              (mut index) 0]
          (if (>= parent 0)
              (let [linked
                      (fng-set-prototype! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                        object
                                        (fng-constructor-prototype! context parent))]
                (store! (load (field context memory)) (fng-preserve-active-memory context linked)))
              0)
          (loop (if (>= (load index)
                        (al-len [FePrototypeMethod] (load (field frontend prototype-methods))))
                    (break)
                    (let [method
                            (al-get [FePrototypeMethod]
                                    (load (field frontend prototype-methods))
                                    (load index))]
                      ; Publish the inherited closed-world method set directly on each synthesized
                      ; prototype as well as linking its parent. Prototype assignments are indexed
                      ; in source order, so a child override is stored after its ancestor's value.
                      ; This prevents an early instance lookup from observing a recursively-created
                      ; ancestor whose initialization was locally scheduled too late.
                      (if (fng-constructor-descends-from?
                            frontend constructor (load (field method constructor)))
                          (let [target-index
                                  (fng-function-index frontend (load (field method target)))
                                target-function
                                  (al-get [FeFunction]
                                          (load (field frontend functions))
                                          target-index)
                                target
                                  ; Closed-world prototype dispatch supplies the normalized method
                                  ; environment at the call site, so the property carries exact
                                  ; function identity rather than a target-specific closure object.
                                  (al-get [i64]
                                          (load (load (field context functions)))
                                          (load (field method target)))
                                stored
                                  (fng-prop-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                                 object
                                                 (n-box! target)
                                                 (ts-text ast (load (field method name-node))))]
                            (store! (load (field context memory)) (fng-preserve-active-memory context stored)))
                          0)
                      (store! index (+ (load index) 1)))))
          (al-set! [i64] (mut (load (field context prototypes))) constructor object)
          object))))

(defn fng-array-builtin-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
             (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-ARRAY))
        (ts-text ast (ts-child ast callee 1))
        "")))

(defn fng-array-builtin? [(context FngContext) (node i64)] (-> bool)
  (let [name (fng-array-builtin-name context node)]
    (or (str-eq name "push")
        (or (str-eq name "pop")
            (or (str-eq name "shift") (str-eq name "slice"))))))

(defn fng-math-member-id [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-PROPERTY-ACCESS)
             (str-eq (ts-text ast (ts-child ast node 0)) "Math"))
        (jbi-find (ts-text ast node))
        JBI-NONE)))

(defn fng-symbol-declaration-node [(context FngContext) (id i64)] (-> i64)
  (let [frontend (load (field context frontend))
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
                  (!= (load answer) -1))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (= (load (field symbol id)) id)
                    (store! answer (load (field symbol node)))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-math-alias-id [(context FngContext) (callee i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)]
    (if (!= (ts-kind ast callee) TSK-IDENTIFIER)
        JBI-NONE
        (let [symbol (fe-resolution-symbol frontend callee)
              declaration (if (>= symbol 0) (fng-symbol-declaration-node context symbol) -1)]
          (if (and (>= declaration 0) (= (ts-kind ast declaration) TSK-VARIABLE-DECLARATION))
              (let [count (ts-child-count ast declaration)
                    initializer (if (> count 1) (ts-child ast declaration (- count 1)) -1)]
                (if (>= initializer 0) (fng-math-member-id context initializer) JBI-NONE))
              JBI-NONE)))))

(defn fng-math-builtin-id [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (let [direct (fng-math-member-id context callee)]
      (if (>= direct 0) direct (fng-math-alias-id context callee)))))

(defn fng-math-builtin? [(context FngContext) (node i64)] (-> bool)
  (>= (fng-math-builtin-id context node) 0))

(defn fng-math-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        descriptor (fng-math-builtin-id context node)
        argc (- (ts-child-count ast node) 1)
        arg0 (if (> argc 0) (fng-expression context (ts-child ast node 1)) (fng-undefined))
        arg1 (if (> argc 1) (fng-expression context (ts-child ast node 2)) (fng-undefined))]
    (if (not (jbi-valid-arity? descriptor argc))
        NO-NODE
      ;; The one-argument rounding family comes from lib/math/rounding.jsl. The transcendentals
      ;; (sqrt, pow, exp, log, the trig functions) and Math.random stay on OP-JSBUILTIN: they are
      ;; libm calls, not JavaScript semantics, and there is nothing for a DSL to express about them.
      ;; Math.max and Math.min go through the binary MathMax2/MathMin2. They are variadic in the
      ;; language but not in this frontend: `jbi-max-arity` is `jbi-min-arity`, so exactly two
      ;; arguments reach here and anything else is rejected before this point.
      ;;
      ;; WHAT MAKES THIS FREE IS `typetest-idealize`, NOT THIS CODE. The library's MathFloor is
      ;; `if (%IsInt v) v else (%FloorNum v)`, and `%FloorNum` lowers to the same OP-JSBUILTIN the
      ;; hand-written form emitted — so the conversion is that node plus a guard. The guard folds
      ;; against a boxed argument whose input type is proven, which is why the box is built here
      ;; from a value the frontend has already typed rather than from something opaque.
      ;;
      ;; THE RESULT GOES THROUGH ToNumber, NOT AN UNBOX TO `flt`. OP-JSBUILTIN always answers a
      ;; double, so unboxing its result as a float is right. A JSL definition is not the same:
      ;; `MathAbs` of a boxed integer returns a boxed INTEGER, and reading that as a float
      ;; reinterprets the bits. Math.abs(-7) takes exactly that path.
      (let [jsl-name (if (= descriptor JBI-ABS) "MathAbs"
                       (if (= descriptor JBI-FLOOR) "MathFloor"
                         (if (= descriptor JBI-CEIL) "MathCeil"
                           (if (= descriptor JBI-ROUND) "MathRound"
                             (if (= descriptor JBI-MAX) "MathMax2"
                               (if (= descriptor JBI-MIN) "MathMin2" ""))))))]
        (if (= (str-len jsl-name) 0)
            (n-unbox! (n-js-builtin! descriptor (n-box! arg0) (n-box! arg1)) (t-flt))
            (if (or (= descriptor JBI-MAX) (= descriptor JBI-MIN))
                (n-to-number! (fng-jsl-call2 context jsl-name (n-box! arg0) (n-box! arg1)))
                (n-to-number! (fng-jsl-call1 context jsl-name (n-box! arg0)))))))))

(defn fng-error-constructor? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend)) ast (field frontend ast)]
    (= (fe-resolution-symbol frontend (ts-child ast node 0)) FE-INTRINSIC-ERROR)))

(defn fng-error-constructor [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object (fng-empty-dynamic-object context)
        message
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (n-string-const! (jss-from-utf8! "")))
        stored
          (fng-prop-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                         object (n-box! message) "message")]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (store! (load (field context memory)) (fng-preserve-active-memory context stored))
    object))

(defn fng-string-builtin-name [(context FngContext) (node i64)] (-> (slice u8))
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (if (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
        (ts-text ast (ts-child ast callee 1))
        "")))

(defn fng-string-from-char-code? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fe-resolution-symbol frontend (ts-child ast callee 0)) FE-INTRINSIC-STRING)
              (str-eq (ts-text ast (ts-child ast callee 1)) "fromCharCode")))))

(defn fng-number-to-string? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-NUMBER)
              (str-eq (ts-text ast (ts-child ast callee 1)) "toString")))))

(defn fng-number-to-string [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        value (fng-expression context (ts-child ast callee 0))
        radix
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (fng-const 10))]
    (n-number-to-string! value radix)))

(defn fng-string-from-char-code [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        count (ts-child-count ast node)
        (mut index) 1
        (mut result) (n-string-const! (jss-from-utf8! ""))]
    (loop (if (>= (load index) count)
              (break)
              (do
                (store! result
                        (n-string-concat! (load result)
                                          (n-string-from-code-unit! (fng-expression context
                                                                                    (ts-child ast node (load index))))))
                (store! index (+ (load index) 1)))))
    (load result)))

(defn fng-string-builtin? [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        name (fng-string-builtin-name context node)]
    (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
         (and (= (fng-infer context (ts-child ast callee 0) FNG-DYNAMIC) FNG-STRING)
              (or (str-eq name "charAt")
                  (or (str-eq name "charCodeAt")
                      (or (str-eq name "substring")
                          (or (str-eq name "substr")
                              (or (str-eq name "slice")
                                  (or (str-eq name "split")
                                      (or (str-eq name "indexOf")
                                          (or (str-eq name "toLowerCase")
                                              (str-eq name "toUpperCase")))))))))))))

;; Emit a call to a JSL runtime-library definition.
;;
;; THE SEAM IS REPRESENTATION, and it is narrower than "everything is NaN-boxed". A JSL `dyn`
;; parameter holds whatever the value's representation already is: a string literal inside a `.jsl`
;; file lowers to `n-string-const!`, a raw pointer, and `%StringIndexOf` reads it as one. So a string
;; the frontend already has is passed straight through, and boxing it here would hand the library a
;; tagged word where it expects a pointer. Definitions whose parameters are declared `int` take raw
;; machine integers for the same reason. Only a definition returning `dyn` needs unboxing at this
;; boundary, and none of the ones called here do.
;;
;; THE BODY IS INLINED, NOT CALLED, and that is a measured decision rather than a preference. Going
;; through `jsl-call!` made `benchmarks/typescript-aot/math-loop.ts` 1.55x slower — 48.9ms to
;; 75.9ms — because every `Math.abs` became a function call where it had been an inline node, and
;; there is no inliner downstream to give that back. `jsl-inline!` expands the body into this graph
;; with these argument nodes bound to the parameters, so the library costs what the hand-written
;; node cost. It is the same split Torque draws between an inlined `macro` and a called `builtin`,
;; except the caller chooses: the frontend is emitting the operation, not invoking it.
;;
;; The control cell is passed through because a body containing an `if` ends on its merge, and
;; everything the frontend sequences afterwards belongs there.
(defn fng-jsl-call [(context FngContext) (name (slice u8)) (args (slice i64))] (-> i64)
  (if (!= (jsl-require-body-only! name) JSL-OK)
      (do (panic-corrupt "frontend: a JSL definition the frontend emits did not resolve") 0)
      0)
  (jsl-inline! (load (field context ctrl)) name args))

(defn fng-jsl-call1 [(context FngContext) (name (slice u8)) (a i64)] (-> i64)
  (let [buf (stack (array i64 1))
        p (cast (ptr i64) buf)]
    (store! (index p 0) a)
    (fng-jsl-call context name (slice-new [i64] p 1))))

(defn fng-jsl-call2 [(context FngContext) (name (slice u8)) (a i64) (b i64)] (-> i64)
  (let [buf (stack (array i64 2))
        p (cast (ptr i64) buf)]
    (store! (index p 0) a)
    (store! (index p 1) b)
    (fng-jsl-call context name (slice-new [i64] p 2))))

(defn fng-jsl-call3 [(context FngContext) (name (slice u8)) (a i64) (b i64) (c i64)] (-> i64)
  (let [buf (stack (array i64 3))
        p (cast (ptr i64) buf)]
    (store! (index p 0) a)
    (store! (index p 1) b)
    (store! (index p 2) c)
    (fng-jsl-call context name (slice-new [i64] p 3))))

(defn fng-string-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        string (fng-expression context (ts-child ast callee 0))
        name (fng-string-builtin-name context node)
        argc (- (ts-child-count ast node) 1)
        needs-start
          (or (str-eq name "split")
              (or (str-eq name "charCodeAt")
                  (or (str-eq name "charAt")
                      (or (str-eq name "substring")
                          (or (str-eq name "substr") (str-eq name "slice"))))))
        start
          (if needs-start
              (if (> argc 0)
                  (fng-expression context (ts-child ast node 1))
                  (if (str-eq name "split") (fng-undefined) (fng-const 0)))
              NO-NODE)]
    (if (str-eq name "split")
        (let [incoming (fng-current-memory context JS-PROPERTY-ALIAS)
              allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
              result (n-array-mark! (n-obj-ptr allocation))
              split (n-string-split! incoming string start result)]
          (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
          (store! (load (field context memory)) (fng-preserve-active-memory context split))
          result)
        (if (str-eq name "toLowerCase")
            (fng-jsl-call1 context "StringToLowerCase" string)
            (if (str-eq name "toUpperCase")
                (fng-jsl-call1 context "StringToUpperCase" string)
                (if (str-eq name "indexOf")
                    ;; Steps 5-7 of String.prototype.indexOf, from lib/string/index-of.jsl rather
                    ;; than a hand-written IR node. The receiver is known to be a string here (the
                    ;; `fng-string-builtin?` guard proves it), so ToString on it is the identity and
                    ;; the coerced core is the right entry point; the missing-argument case keeps
                    ;; the frontend's existing `"undefined"` string, which is what ToString of an
                    ;; absent argument produces.
                    (let [buf (stack (array i64 3))
                          p (cast (ptr i64) buf)]
                      (store! (index p 0) string)
                      (store! (index p 1)
                              (if (> argc 0)
                                  (fng-expression context (ts-child ast node 1))
                                  (n-string-const! (jss-from-utf8! "undefined"))))
                      (store! (index p 2)
                              (if (> argc 1)
                                  (fng-expression context (ts-child ast node 2))
                                  (fng-const 0)))
                      (fng-jsl-call context "StringIndexOfFrom" (slice-new [i64] p 3)))
                    ;; Every remaining extractor comes from lib/string/, which does its own bounds
                    ;; and negative-index handling — the work the C runtime used to do behind these
                    ;; IR nodes. The three are separate definitions rather than one clamped helper
                    ;; because they genuinely differ: substr's second argument is a COUNT, and
                    ;; substring SWAPS out-of-order arguments where slice yields the empty string.
                    (if (str-eq name "charCodeAt")
                        (fng-jsl-call2 context "StringCharCodeAt" string start)
                        (if (str-eq name "charAt")
                            (fng-jsl-call2 context "StringCharAt" string start)
                            (let [end
                                    (if (> argc 1)
                                        (fng-expression context (ts-child ast node 2))
                                        (n-string-length! string))
                                  jsl-name (if (str-eq name "substring") "StringSubstring"
                                             (if (str-eq name "substr") "StringSubstr"
                                               "StringSlice"))]
                              (fng-jsl-call3 context jsl-name string start end))))))))))

(defn fng-array-push [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        initial (fng-array-length! context (fng-current-memory context JS-PROPERTY-ALIAS) array)
        (mut index) 1]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [value (fng-expression context (ts-child ast node (load index)))
                    position (fng-bin OP-ADD initial (fng-const (- (load index) 1)))
                    stored
                      (fng-array-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                      array
                                      position
                                      (n-box! value))]
                (store! (load (field context memory)) (fng-preserve-active-memory context stored))
                (store! index (+ (load index) 1)))))
    (fng-array-length! context (fng-current-memory context JS-PROPERTY-ALIAS) array)))

(defn fng-array-pop [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        memory (fng-current-memory context JS-PROPERTY-ALIAS)
        length (fng-array-length! context memory array)
        new-length (fng-bin OP-SUB length (fng-const 1))
        value (fng-array-load! context memory array new-length)
        resized (fng-array-resize-after! context memory array new-length value)]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (store! (load (field context memory)) (fng-preserve-active-memory context resized))
    value))

(defn fng-array-shift [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        memory (fng-current-memory context JS-PROPERTY-ALIAS)
        length (fng-array-length! context memory array)
        value (fng-array-load! context memory array (fng-const 0))
        copied (fng-array-copy! context memory array array (fng-const 1))
        resized (fng-array-resize-after! context copied
                                       array
                                       (fng-max context
                                                (fng-bin OP-SUB length (fng-const 1))
                                                (fng-const 0))
                                       value)]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (store! (load (field context memory)) (fng-preserve-active-memory context resized))
    value))

(defn fng-select [(context FngContext) (predicate i64) (when-true i64) (when-false i64)] (-> i64)
  (let [entry (load (load (field context ctrl)))
        arms (n-if-arms! (fng-peep (n-new2 OP-IF 0 entry predicate)))
        region (n-new OP-REGION 0)
        phi (n-new OP-PHI (t-int))]
    (n-add-def! region NO-NODE)
    (n-add-def! region (arms-t arms))
    (n-add-def! region (arms-f arms))
    (n-add-def! phi region)
    (n-add-def! phi when-true)
    (n-add-def! phi when-false)
    (store! (load (field context ctrl)) region)
    phi))

(defn fng-min [(context FngContext) (left i64) (right i64)] (-> i64)
  (fng-select context (fng-bin OP-LT left right) left right))

(defn fng-max [(context FngContext) (left i64) (right i64)] (-> i64)
  (fng-select context (fng-bin OP-LT left right) right left))

(defn fng-slice-bound [(context FngContext) (raw i64) (length i64)] (-> i64)
  (if (and (= (n-op raw) OP-CONST)
           (and (ty-int-only? (n-aux raw)) (ty-const? (n-aux raw))))
      (let [value (ty-int-lo (n-aux raw))]
        (if (< value 0)
            (fng-max context (fng-bin OP-ADD length raw) (fng-const 0))
            (fng-min context raw length)))
      (let [negative (fng-bin OP-LT raw (fng-const 0))
            from-end (fng-max context (fng-bin OP-ADD length raw) (fng-const 0))
            from-start (fng-min context raw length)]
        (fng-select context negative from-end from-start))))

(defn fng-array-slice [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        array (fng-expression context (ts-child ast callee 0))
        incoming (fng-current-memory context JS-PROPERTY-ALIAS)
        length (fng-array-length! context incoming array)
        raw-start
          (if (> (ts-child-count ast node) 1)
              (fng-expression context (ts-child ast node 1))
              (fng-const 0))
        raw-end
          (if (> (ts-child-count ast node) 2)
              (fng-expression context (ts-child ast node 2))
              length)
        start (fng-slice-bound context raw-start length)
        end (fng-slice-bound context raw-end length)
        count (fng-max context (fng-bin OP-SUB end start) (fng-const 0))
        allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
        result (n-array-mark! (n-obj-ptr allocation))]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (let [resized (fng-array-resize! context incoming result count)
          copied (fng-array-copy! context resized array result start)]
      (store! (load (field context memory)) (fng-preserve-active-memory context copied))
      result)))

(defn fng-array-call [(context FngContext) (node i64)] (-> i64)
  (let [name (fng-array-builtin-name context node)]
    (cond (str-eq name "push") (fng-array-push context node)
          (str-eq name "pop") (fng-array-pop context node)
          (str-eq name "shift") (fng-array-shift context node)
          :else (fng-array-slice context node))))

(defn fng-owner-constructor [(frontend (ptr NativeFrontend)) (owner i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) owner]
    (loop (if (or (>= (load index)
                      (al-len [FePrototypeMethod] (load (field frontend prototype-methods))))
                  (!= (load answer) owner))
              (break)
              (let [method (al-get [FePrototypeMethod]
                                   (load (field frontend prototype-methods))
                                   (load index))]
                (if (= (load (field method target)) owner)
                    (store! answer (load (field method constructor)))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-first-function-target [(targets i64)] (-> i64)
  (let [(mut index) 0 (mut answer) -1]
    (loop (if (or (>= (load index) 63) (>= (load answer) 0))
              (break)
              (do
                (if (!= (& targets (<< 1 (load index))) 0)
                    (store! answer (load index))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-widest-function-target [(frontend (ptr NativeFrontend)) (targets i64)] (-> i64)
  (let [(mut index) 0
        (mut answer) -1
        (mut widest) -1]
    (loop (if (>= (load index) 63)
              (break)
              (do
                (if (!= (& targets (<< 1 (load index))) 0)
                    (let [function-index (fng-function-index frontend (load index))]
                      (if (>= function-index 0)
                          (let [fn (al-get [FeFunction]
                                           (load (field frontend functions))
                                           function-index)
                                count (load (field fn parameter-count))]
                            (if (> count (load widest))
                                (do (store! answer (load index)) (store! widest count))
                                0))
                          0))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-constructor-method [(frontend (ptr NativeFrontend))
                              (constructor i64)
                              (name-node i64)] (-> i64)
  (let [ast (field frontend ast)
        name (ts-text ast name-node)
        (mut current) constructor
        (mut answer) -1
        (mut fuel) 64]
    (loop (if (or (< (load current) 0)
                  (or (<= (load fuel) 0) (>= (load answer) 0)))
              (break)
              (let [(mut index) 0]
                (loop (if (or (>= (load index)
                                  (al-len [FePrototypeMethod]
                                          (load (field frontend prototype-methods))))
                              (>= (load answer) 0))
                          (break)
                          (let [method (al-get [FePrototypeMethod]
                                               (load (field frontend prototype-methods))
                                               (load index))]
                            (if (and (= (load (field method constructor)) (load current))
                                     (str-eq name
                                             (ts-text ast (load (field method name-node)))))
                                (store! answer (load (field method target)))
                                0)
                            (store! index (+ (load index) 1)))))
                (if (< (load answer) 0)
                    (store! current (fng-prototype-parent frontend (load current)))
                    0)
                (store! fuel (- (load fuel) 1)))))
    (load answer)))

; Resolve closed-world assignments such as Strength.stronger = function (...) {...}.
; -1 means unseen and -2 means the property is reassigned to conflicting targets.
(defn fng-static-method-scan [(frontend (ptr NativeFrontend))
                              (node i64)
                              (receiver-symbol i64)
                              (name (slice u8))] (-> i64)
  (let [ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-BINARY)
             (str-eq (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS))
        (let [left (ts-child ast node 0)
              base (ts-child ast left 0)
              value (ts-child ast node 2)]
          (if (and (= (fe-resolution-symbol frontend base) receiver-symbol)
                   (str-eq (ts-text ast (ts-child ast left 1)) name))
              (if (= (ts-kind ast value) TSK-FUNCTION-EXPRESSION)
                  (let [function-index (fe-function-for-node frontend value)]
                    (if (>= function-index 0)
                        (load (field (index (load (field (field frontend functions) data)) function-index) id))
                        -2))
                  -2)
              -1))
        (let [(mut index) 0
              (mut answer) -1]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (= (load answer) -2))
                    (break)
                    (let [found (fng-static-method-scan frontend
                                                        (ts-child ast node (load index))
                                                        receiver-symbol
                                                        name)]
                      (if (>= found 0)
                          (if (or (= (load answer) -1) (= (load answer) found))
                              (store! answer found)
                              (store! answer -2))
                          (if (= found -2) (store! answer -2) 0))
                      (store! index (+ (load index) 1)))))
          (load answer)))))

(defn fng-static-owner-scan [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> i64)
  (let [ast (field frontend ast)]
    (if (and (= (ts-kind ast node) TSK-BINARY)
             (str-eq (ts-text ast (ts-child ast node 1)) "=")
             (= (ts-kind ast (ts-child ast node 0)) TSK-PROPERTY-ACCESS)
             (= (ts-kind ast (ts-child ast node 2)) TSK-FUNCTION-EXPRESSION))
        (let [function-index (fe-function-for-node frontend (ts-child ast node 2))]
          (if (and (>= function-index 0)
                   (= (load (field (index (load (field (field frontend functions) data))
                                          function-index)
                                   id))
                      owner))
              (fe-resolution-symbol frontend (ts-child ast (ts-child ast node 0) 0))
              -1))
        (let [(mut index) 0
              (mut answer) -1]
          (loop (if (or (>= (load index) (ts-child-count ast node)) (>= (load answer) 0))
                    (break)
                    (do
                      (store! answer
                              (fng-static-owner-scan frontend
                                                     (ts-child ast node (load index))
                                                     owner))
                      (store! index (+ (load index) 1)))))
          (load answer)))))

(defn fng-static-method [(frontend (ptr NativeFrontend))
                         (receiver-node i64)
                         (name-node i64)
                         (owner i64)] (-> i64)
  (let [ast (field frontend ast)
        direct (fe-resolution-symbol frontend receiver-node)
        symbol
          (if (>= direct 0)
              direct
              (if (= (ts-kind ast receiver-node) TSK-THIS)
                  (fng-static-owner-scan frontend (ts-root ast) owner)
                  -1))]
    (if (< symbol 0)
        -1
        (fng-static-method-scan frontend
                                (ts-root ast)
                                symbol
                                (ts-text ast name-node)))))

;; Resolve the callable denoted by the receiver of Function.prototype.call.  DeltaBlue's
;; inheritance shim publishes constructors as `Ctor.superConstructor` and inherited methods as
;; `Ctor.superConstructor.prototype.method`.  Those relationships are closed-world metadata, so
;; preserve exact function identity instead of loading an unbounded dynamic "call" property.
(defn fng-explicit-call-target [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (= kind TSK-IDENTIFIER)
        (fe-resolution-symbol frontend node)
        (if (= kind TSK-PROPERTY-ACCESS)
            (let [base (ts-child ast node 0)
                  name (ts-text ast (ts-child ast node 1))]
              (if (str-eq name "superConstructor")
                  (fng-prototype-parent frontend (fe-find-function-name frontend base))
                  (if (and (= (ts-kind ast base) TSK-PROPERTY-ACCESS)
                           (str-eq (ts-text ast (ts-child ast base 1)) "prototype"))
                      (let [constructor (fng-explicit-call-target frontend (ts-child ast base 0))]
                        (if (>= constructor 0)
                            (fng-constructor-method frontend constructor (ts-child ast node 1))
                            -1))
                      -1)))
            -1))))

;; An identifier bound by `let f = function (...) { ... }` resolves to the local variable symbol,
;; not directly to the nested function id. Recover the closed-world target from the declaration so
;; calls use the function's parameter ABI while still loading the already-materialized closure
;; environment from the local binding.
(defn fng-local-function-target [(frontend (ptr NativeFrontend)) (node i64)] (-> i64)
  (let [ast (field frontend ast)
        symbol-id (fe-resolution-symbol frontend node)
        (mut index) 0
        (mut answer) -1]
    (loop (if (or (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
                  (>= (load answer) 0))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (= (load (field symbol id)) symbol-id)
                    (let [declaration (load (field symbol node))
                          count (ts-child-count ast declaration)
                          initializer (if (> count 1) (ts-child ast declaration (- count 1)) -1)]
                      (if (and (>= initializer 0)
                               (= (ts-kind ast initializer) TSK-FUNCTION-EXPRESSION))
                          (let [function-index (fe-function-for-node frontend initializer)]
                            (if (>= function-index 0)
                                (store! answer
                                        (load (field (index (load (field (field frontend functions) data))
                                                                  function-index)
                                                     id)))
                                0))
                          0))
                    0)
                (store! index (+ (load index) 1)))))
    (load answer)))

(defn fng-user-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        construct (= (ts-kind ast node) TSK-NEW-EXPRESSION)
        syntax-callee (ts-child ast node 0)
        explicit-call
          (and (= (ts-kind ast syntax-callee) TSK-PROPERTY-ACCESS)
               (str-eq (ts-text ast (ts-child ast syntax-callee 1)) "call"))
        callee-node (if explicit-call (ts-child ast syntax-callee 0) syntax-callee)
        receiver-call (and (not explicit-call) (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS))
        callee
          (if explicit-call
              (fng-explicit-call-target frontend callee-node)
              (if receiver-call
              (let [object-node (ts-child ast callee-node 0)
                    static (fng-static-method frontend
                                              object-node
                                              (ts-child ast callee-node 1)
                                              (load (field context owner)))
                    inherited
                      (if (= (ts-kind ast object-node) TSK-THIS)
                          (fng-constructor-method
                            frontend
                            (fng-owner-constructor frontend
                                                   (load (field context owner)))
                            (ts-child ast callee-node 1))
                          -1)
                    unique (fng-unique-prototype-method frontend (ts-child ast callee-node 1))
                    resolved (fe-resolution-symbol frontend callee-node)
                    named (fe-find-function-name frontend (ts-child ast callee-node 1))
                    typed
                      (if (and (>= named 0) (fng-function-receiver-aware? frontend named))
                          named
                          resolved)]
                (if (>= static 0)
                    static
                    (if (>= inherited 0)
                        inherited
                        (if (>= unique 0) unique typed))))
              (let [resolved (fe-resolution-symbol frontend callee-node)
                    local-target (fng-local-function-target frontend callee-node)]
                (if (>= local-target 0) local-target resolved))))
        ;; A property-call syntax does not by itself add a receiver slot to a statically resolved
        ;; function. Static namespace helpers such as Strength.stronger(s1, s2) do not compile a
        ;; `this` Parm; passing the base object shifts every explicit argument by one. Unresolved
        ;; method dispatch still needs the receiver because its runtime target is receiver-aware.
        receiver-aware (or explicit-call
                           (or (fng-function-receiver-aware? frontend callee)
                               (and receiver-call (< (fng-function-index frontend callee) 0))))
        function-index (fng-function-index frontend callee)
        method-targets
          (if receiver-call
              (fng-prototype-method-targets frontend (ts-child ast callee-node 1))
              0)
        argument-function-index
          (if (>= function-index 0)
              function-index
              (if (> method-targets 0)
                  (fng-function-index frontend
                                      (fng-widest-function-target frontend method-targets))
                  -1))
        fn
          (if (>= function-index 0)
              (al-get [FeFunction] (load (field frontend functions)) function-index)
              (zeroed FeFunction))
        argument-fn
          (if (>= argument-function-index 0)
              (al-get [FeFunction] (load (field frontend functions)) argument-function-index)
              (zeroed FeFunction))
        receiver-type (if (>= function-index 0) (load (field fn receiver-type-node)) -1)
        receiver-owner
          (if (and (>= function-index 0) (>= receiver-type 0))
              (fe-type-index-for-node frontend receiver-type)
              -1)
        raw-receiver
          (if construct
              (if (>= receiver-owner 0)
                  (fng-empty-object context receiver-owner)
                  (if (= receiver-type FE-RECEIVER-DYNAMIC)
                      (fng-empty-dynamic-object context)
                      NO-NODE))
              (if explicit-call
                  (fng-expression context (ts-child ast node 1))
                  (if receiver-aware
                  (if receiver-call
                      (let [first (fng-expression context (ts-child ast callee-node 0))]
                        (if (load (fng-omit-receiver-ptr))
                            (fng-undefined)
                            (if (load (fng-duplicate-receiver-ptr))
                                (fng-expression context (ts-child ast callee-node 0))
                                first)))
                      (fng-undefined))
                  NO-NODE)))
        receiver
          (if (and (not construct)
                   (and (>= receiver-owner 0)
                        (= (n-ty raw-receiver) (t-dyn))))
              (n-unbox! raw-receiver
                        (t-obj-shape
                          (al-get [i64] (load (load (field context shapes))) receiver-owner)))
              raw-receiver)
        target
          (if (and (>= callee 0)
                   (< callee (al-len [FeFunction] (load (field frontend functions)))))
                  (if (> method-targets 0)
                  (al-get [i64] (load (load (field context functions))) callee)
                  (if (> (fng-capture-count frontend callee) 0)
                  (fng-expression context callee-node)
                  (al-get [i64] (load (load (field context functions))) callee)))
              (if (and receiver-call (< function-index 0))
                  (do
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    (let [loaded
                            (fng-prop-load! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                          receiver
                                          (ts-text ast (ts-child ast callee-node 1)))
                          targets method-targets]
                      (if (> targets 0)
                          (n-new2 OP-CAST (t-fun-set targets)
                                  (load (load (field context ctrl))) loaded)
                          loaded)))
                  (fng-expression context callee-node)))
        (mut args) (al-new [i64] (malloc-allocator))
        (mut call-captures) (al-new [i64] (malloc-allocator))
        (mut index) (if explicit-call 2 1)]
    (if (and construct (and (= receiver-type FE-RECEIVER-DYNAMIC) (>= callee 0)))
        (let [prototype (fng-constructor-prototype! context callee)
              linked
                (fng-set-prototype! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                  receiver
                                  prototype)]
          (store! (load (field context memory)) (fng-preserve-active-memory context linked)))
        0)
    (if (> method-targets 0)
        (let [representative (fng-first-function-target method-targets)
              count (fng-capture-count frontend representative)
              (mut capture-index) 0]
          (loop (if (>= (load capture-index) count)
                    (break)
                    (do
                      (al-push! [i64]
                                (mut call-captures)
                                (fng-symbol-storage
                                  context
                                  (fng-capture-symbol frontend representative
                                                      (load capture-index))))
                      (store! capture-index (+ (load capture-index) 1))))))
        0)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (do
                (let [value (fng-expression context (ts-child ast node (load index)))]
                  (al-push! [i64]
                            (mut args)
                            (if (>= argument-function-index 0)
                                (fng-call-argument frontend argument-fn
                                                   (- (load index) (if explicit-call 2 1))
                                                   value)
                                value)))
                (store! index (+ (load index) 1)))))
    ; JavaScript fills omitted formal parameters with undefined. Native calls use a fixed register
    ; ABI, so materialize those values explicitly for statically known targets.
    (if (>= argument-function-index 0)
        (loop (if (>= (al-len [i64] (load args)) (load (field argument-fn parameter-count)))
                  (break)
                  (let [ordinal (al-len [i64] (load args))]
                    (al-push! [i64]
                              (mut args)
                              (fng-call-argument frontend argument-fn ordinal (fng-undefined))))))
        0)
    ;; A trailing memory input is an effect token, not a JavaScript argument. It publishes all
    ;; stores that precede the call and lets the callee's memory Args inherit that heap version.
    (fng-ensure-memory! context)
    (if (!= (load (load (field context memory))) NO-NODE)
        (al-push! [i64] (mut args) (load (load (field context memory))))
        0)
    (let [call
            (if receiver-aware
                (if (> (al-len [i64] (load call-captures)) 0)
                    (n-call-captured-receiver! (load (load (field context ctrl)))
                                               target
                                               (al-slice [i64] (load call-captures))
                                               receiver
                                               (al-slice [i64] (load args)))
                    (n-call-receiver! (load (load (field context ctrl)))
                                      target
                                      receiver
                                      (al-slice [i64] (load args))))
                (n-call! (load (load (field context ctrl)))
                         target
                         (al-slice [i64] (load args))))
          value (call-value call)]
      (store! (load (field context ctrl)) (call-end call))
      ;; The callee may have changed any active alias. Re-anchor subsequent alias reads at the
      ;; CallEnd instead of reusing a pre-call memory node.
      (store! (load (field context memory)) NO-NODE)
      (al-free! [i64] (mut args))
      (al-free! [i64] (mut call-captures))
      (if construct
          (let [result-owner
                  (if (>= function-index 0)
                      (fe-type-index-for-node frontend (load (field fn result-node)))
                      -1)]
            (if (>= result-owner 0)
                (n-new2 OP-CAST
                        (t-obj-shape
                          (al-get [i64] (load (load (field context shapes))) result-owner))
                        (load (load (field context ctrl)))
                        value)
                (fng-pin-after-call! context value receiver)))
          value))))

(defn fng-intrinsic-call [(context FngContext) (node i64) (intrinsic i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        argc (- (ts-child-count ast node) 1)]
    (cond (= intrinsic FNG-INTRINSIC-OBJECT) (fng-empty-dynamic-object context)
          (= intrinsic FNG-INTRINSIC-ARRAY)
            (let [allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
                  array (n-array-mark! (n-obj-ptr allocation))]
              (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
              (if (> argc 0)
                  (let [resized
                          (fng-array-resize! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                           array
                                           (fng-expression context (ts-child ast node 1)))]
                    (store! (load (field context memory))
                            (fng-preserve-active-memory context resized)))
                  0)
              array)
          (= intrinsic FNG-INTRINSIC-STRING)
            (if (= argc 0)
                (n-string-const! (jss-from-utf8! ""))
                (let [argument (ts-child ast node 1)]
                  (if (= (fe-resolution-symbol frontend argument) FE-INTRINSIC-NAN)
                      (n-string-const! (jss-from-utf8! "NaN"))
                      (n-to-string! (fng-expression context argument)))))
          (= intrinsic FNG-INTRINSIC-PARSEINT)
            (n-parse-int! (fng-expression context (ts-child ast node 1))
                          (if (> argc 1)
                              (fng-expression context (ts-child ast node 2))
                              (fng-const 0)))
          :else
            (let [argument (ts-child ast node 1)]
              (if (= (fe-resolution-symbol frontend argument) FE-INTRINSIC-NAN)
                  (fng-bool true)
                  (n-is-nan! (fng-expression context argument)))))))

(defn fng-call [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        callee (ts-child ast node 0)
        static-inheritance
          (and (= (ts-kind ast callee) TSK-PROPERTY-ACCESS)
               (and (str-eq (ts-text ast (ts-child ast callee 1)) "inheritsFrom")
                    (> (ts-child-count ast node) 1)))
        intrinsic (if static-inheritance FNG-DYNAMIC (fng-infer context callee FNG-DYNAMIC))]
    (if static-inheritance
        (fng-undefined)
    (if (or (= intrinsic FNG-INTRINSIC-OBJECT)
            (or (= intrinsic FNG-INTRINSIC-ARRAY)
            (or (= intrinsic FNG-INTRINSIC-STRING)
                (or (= intrinsic FNG-INTRINSIC-PARSEINT) (= intrinsic FNG-INTRINSIC-ISNAN)))))
        (fng-intrinsic-call context node intrinsic)
        (fng-user-call context node)))))

(defn fng-object [(context FngContext) (node i64) (owner i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        type (al-get [FeTypeDecl] (load (field frontend types)) owner)
        field-start (load (field type field-start))
        field-count (load (field type field-count))
        shape (al-get [i64] (load (load (field context shapes))) owner)
        (mut field-values) (al-new [i64] (malloc-allocator))
        (mut incoming) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut stores) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) field-count)
              (break)
              (let [property (ts-child ast node (load index))
                    value-node (ts-child ast property (- (ts-child-count ast property) 1))
                    field-value (al-get [FeField] (load (field frontend fields)) (+ field-start (load index)))
                    expected (fng-type-tag frontend (load (field field-value type-node)))]
                (al-push! [i64] (mut field-values) (fng-expression-expected context value-node expected))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) field-count)
              (break)
              (let [global-field (+ field-start (load index))
                    alias (al-get [i64] (load (load (field context aliases))) global-field)]
                (al-push! [i64] (mut incoming) (fng-current-memory context alias))
                (store! index (+ (load index) 1)))))
    (fng-active-memory! context (mut active))
    (let [nw (n-new-obj! (load (load (field context ctrl))) shape (al-slice [i64] (load incoming)))
          object (n-obj-ptr nw)]
      (store! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [global-field (al-get [i64] (load active) (load index))
                      active-field (al-get [FeField] (load (field frontend fields)) global-field)
                      alias (al-get [i64] (load (load (field context aliases))) global-field)]
                  (if (= (load (field active-field owner)) owner)
                      (let [local (fng-field-local-index frontend global-field)]
                        (al-push! [i64]
                                  (mut stores)
                                  (n-store! (n-obj-mem nw local)
                                            object
                                            (let [field-value (al-get [i64] (load field-values) local)]
                                              (if (= (shape-alias-ty alias) (t-dyn))
                                                  (fng-box-dynamic-argument! field-value)
                                                  field-value))
                                            alias)))
                      (al-push! [i64] (mut stores) (fng-current-memory context alias)))
                  (store! index (+ (load index) 1)))))
      (if (> (al-len [FeCapture] (load (field frontend captures))) 0)
          (al-push! [i64]
                    (mut stores)
                    (fng-current-memory context (load (field context cell-alias))))
          0)
      (store! (load (field context memory)) (fng-merge stores))
      (al-free! [i64] (mut field-values))
      (al-free! [i64] (mut incoming))
      (al-free! [i64] (mut active))
      (al-free! [i64] (mut stores))
      object)))

(defn fng-dynamic-object [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
        object (n-obj-ptr allocation)
        (mut index) 0]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [property (ts-child ast node (load index))
                    name-node (ts-child ast property 0)
                    value-node (ts-child ast property (- (ts-child-count ast property) 1))
                    value (fng-expression context value-node)
                    stored
                      (fng-prop-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                     object
                                     (n-box! value)
                                     (ts-text ast name-node))]
                (store! (load (field context memory)) (fng-preserve-active-memory context stored))
                (store! index (+ (load index) 1)))))
    object))

(defn fng-array-literal [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        allocation (n-new-obj0! (load (load (field context ctrl))) SHAPE-ROOT)
        array (n-array-mark! (n-obj-ptr allocation))
        (mut index) 0]
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (loop (if (>= (load index) (ts-child-count ast node))
              (break)
              (let [element (ts-child ast node (load index))]
                (if (!= (ts-kind ast element) 0)
                    (let [value (fng-expression context element)
                          stored
                            (fng-array-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                            array
                                            (fng-const (load index))
                                            (n-box! value))]
                      (store! (load (field context memory)) (fng-preserve-active-memory context stored)))
                    0)
                (store! index (+ (load index) 1)))))
    (let [resized
            (fng-array-resize! context (fng-current-memory context JS-PROPERTY-ALIAS)
                             array
                             (fng-const (ts-child-count ast node)))]
      (store! (load (field context memory)) (fng-preserve-active-memory context resized)))
    array))

(defn fng-field-load [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        object-node (ts-child ast node 0)
        name-node (ts-child ast node 1)
        owner (fng-infer context object-node FNG-DYNAMIC)
        raw-object (fng-expression context object-node)
        field-index
          (if (< owner 0)
              (fng-unique-field-index frontend name-node)
              (fng-field-index frontend owner name-node))
        field-owner
          (if (< field-index 0)
              owner
              (load (field (index (load (field (field frontend fields) data)) field-index) owner)))
        object
          (if (and (>= field-owner 0)
                   (and (= (n-ty raw-object) (t-dyn))
                        (and (!= (n-op raw-object) OP-CAST)
                             (!= (ts-kind ast object-node) TSK-THIS))))
              (n-unbox! raw-object
                        (t-obj-shape
                          (al-get [i64] (load (load (field context shapes))) field-owner)))
              raw-object)]
    (if (and (= owner FNG-STRING) (str-eq (ts-text ast name-node) "length"))
        (n-string-length! object)
        (if (and (= owner FNG-ARRAY) (str-eq (ts-text ast name-node) "length"))
            (do
              (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
              (fng-array-length! context (fng-current-memory context JS-PROPERTY-ALIAS) object))
            (if (= field-index -1)
                (do
                  (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                  (fng-prop-load! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                object
                                (ts-text ast name-node)))
                (let [alias (al-get [i64] (load (load (field context aliases))) field-index)
                      shape (al-get [i64] (load (load (field context shapes))) field-owner)
                      cast-node (n-new2 OP-CAST (t-obj-shape shape) (load (load (field context ctrl))) object)]
                  (n-load! (fng-current-memory context alias) cast-node alias)))))))

(defn fng-static-nonindex-key? [(ast TsAst) (node i64)] (-> bool)
  (let [kind (ts-kind ast node)]
    (or (= kind TSK-STRING-LITERAL)
        (or (and (= kind TSK-PREFIX-UNARY)
                 (let [text (ts-text ast node)]
                   (and (> (slice-len text) 0) (str-eq (substr text 0 1) "-"))))
            (and (= kind TSK-NUMERIC-LITERAL)
                 (match (str-parse-int (ts-text ast node))
                   (Some [_] false)
                   (None [] true)))))))

(defn fng-nonindex-key-text [(ast TsAst) (node i64)] (-> (slice u8))
  (let [text (ts-text ast node)]
    (if (= (ts-kind ast node) TSK-STRING-LITERAL)
        (substr text 1 (- (slice-len text) 1))
        text)))

(defn fng-lvalue [(context FngContext) (node i64)] (-> FngLValue)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)
        (mut value) (zeroed FngLValue)]
    (if (= kind TSK-IDENTIFIER)
        (do
          (store! (field value kind) FNG-LVALUE-LOCAL)
          (store! (field value symbol) (fe-resolution-symbol frontend node))
          0)
        (if (= kind TSK-PROPERTY-ACCESS)
            (let [object-node (ts-child ast node 0)
                  name-node (ts-child ast node 1)
                  owner (fng-infer context object-node FNG-DYNAMIC)
                  field-index (if (< owner 0) -1 (fng-field-index frontend owner name-node))]
              (store! (field value kind) FNG-LVALUE-FIELD)
              (store! (field value object) (fng-expression context object-node))
              (if (= field-index -1)
                  (do
                    (store! (field value alias) JS-PROPERTY-ALIAS)
                    (store! (field value key) (shape-name-intern! (ts-text ast name-node)))
                    (store! (field value shape) -1)
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    0)
                  (do
                    (store! (field value alias)
                            (al-get [i64] (load (load (field context aliases))) field-index))
                    (store! (field value shape)
                            (al-get [i64] (load (load (field context shapes))) owner))
                    0)))
            (let [object-node (ts-child ast node 0)
                  key-node (ts-child ast node 1)]
              (if (and (= (fng-infer context object-node FNG-DYNAMIC) FNG-ARRAY)
                       (fng-static-nonindex-key? ast key-node))
                  (do
                    (store! (field value kind) FNG-LVALUE-FIELD)
                    (store! (field value object) (fng-expression context object-node))
                    (store! (field value alias) JS-PROPERTY-ALIAS)
                    (store! (field value key)
                            (shape-name-intern! (fng-nonindex-key-text ast key-node)))
                    (store! (field value shape) -1)
                    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
                    0)
                  (do
                    (store! (field value kind) FNG-LVALUE-ELEMENT)
                    (store! (field value object) (fng-expression context object-node))
                    (let [key (fng-expression context key-node)]
                      (store! (field value key) (fng-int-value context key-node key)))
                    0)))))
    (load value)))

(defn fng-lvalue-read [(context FngContext) (value FngLValue)] (-> i64)
  (if (= (load (field value kind)) FNG-LVALUE-LOCAL)
      (fng-symbol-node context (load (field value symbol)))
      (if (= (load (field value kind)) FNG-LVALUE-FIELD)
          (if (= (load (field value shape)) -1)
              (n-peephole (n-new3 OP-PROPLOAD
                                  (load (field value key))
                                  (load (load (field context ctrl)))
                                  (fng-current-memory context JS-PROPERTY-ALIAS)
                                  (load (field value object))))
              (let [cast-node
                      (n-new2 OP-CAST
                              (t-obj-shape (load (field value shape)))
                              (load (load (field context ctrl)))
                              (load (field value object)))]
                (n-load! (fng-current-memory context (load (field value alias)))
                         cast-node
                         (load (field value alias)))))
          (do
            (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
            (fng-array-load! context (fng-current-memory context JS-PROPERTY-ALIAS)
                           (load (field value object))
                           (load (field value key)))))))

(defn fng-lvalue-write [(context FngContext) (target FngLValue) (new-value i64)] (-> i64)
  (if (= (load (field target kind)) FNG-LVALUE-LOCAL)
      (do (fng-set-symbol! context (load (field target symbol)) new-value) new-value)
      (if (= (load (field target kind)) FNG-LVALUE-FIELD)
          (if (= (load (field target shape)) -1)
              (let [stored
                      (n-peephole (n-new4 OP-PROPSTORE
                                          (load (field target key))
                                          (load (load (field context ctrl)))
                                          (fng-current-memory context JS-PROPERTY-ALIAS)
                                          (load (field target object))
                                          (n-box! new-value)))]
                (store! (load (field context memory)) (fng-preserve-active-memory context stored))
                new-value)
              (let [alias (load (field target alias))
                    cast-node
                      (n-new2 OP-CAST
                              (t-obj-shape (load (field target shape)))
                              (load (load (field context ctrl)))
                              (load (field target object)))
                    stored-value
                      (if (= (shape-alias-ty alias) (t-dyn))
                          (fng-box-dynamic-argument! new-value)
                          (if (and (= (shape-alias-ty alias) (t-flt))
                                   (= (n-ty new-value) (t-dyn)))
                              (n-unbox! new-value (t-flt))
                              new-value))
                    stored
                      (n-store! (fng-current-memory context alias) cast-node stored-value alias)
                    (mut memories) (al-new [i64] (malloc-allocator))
                    (mut index) 0]
                (loop (if (>= (load index) (al-len [i64] (load (field context aliases))))
                          (break)
                          (let [candidate (al-get [i64] (load (load (field context aliases))) (load index))]
                            (al-push! [i64]
                                      (mut memories)
                                      (if (= candidate alias)
                                          stored
                                          (fng-current-memory context candidate)))
                            (store! index (+ (load index) 1)))))
                (store! (load (field context memory)) (fng-merge memories))
                (al-free! [i64] (mut memories))
                new-value))
          (let [stored
                  (fng-array-store! context (fng-current-memory context JS-PROPERTY-ALIAS)
                                  (load (field target object))
                                  (load (field target key))
                                  (n-box! new-value))]
            (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
            (store! (load (field context memory)) (fng-preserve-active-memory context stored))
            new-value))))

(defn fng-update-local [(context FngContext) (node i64) (prefix bool)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        target (fng-lvalue context (ts-child ast node 0))
        raw-old (fng-lvalue-read context target)
        dynamic (= (fng-infer context (ts-child ast node 0) FNG-DYNAMIC) FNG-DYNAMIC)
        old
          (if dynamic
              (n-unbox! raw-old (t-flt))
              raw-old)
        text (ts-text ast node)
        length (slice-len text)
        operator
          (if prefix
              (if (>= length 2) (substr text 0 2) "")
              (if (>= length 2) (substr text (- length 2) length) ""))
        numeric-value (fng-bin (if (str-eq operator "++") OP-ADD OP-SUB) old (fng-const 1))
        value (if dynamic (n-box! numeric-value) numeric-value)]
    (fng-lvalue-write context target value)
    (if prefix value raw-old)))

;; Lower a value-producing branch. An arm node of -1 uses its already-evaluated fixed value; this
;; is how && and || evaluate their left operand once while still returning that operand.
(defn fng-branch-expression [(context FngContext)
                             (condition i64)
                             (then-node i64)
                             (then-fixed i64)
                             (else-node i64)
                             (else-fixed i64)] (-> i64)
  (let [frontend (load (field context frontend))
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut saved-values) (al-new [i64] (malloc-allocator))
        (mut then-values) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        saved-ctrl (load (load (field context ctrl)))
        saved-memory (load (load (field context memory)))
        (mut index) 0]
    (if (!= then-node -1) (fng-assigned! frontend then-node (mut changed)) 0)
    (if (!= else-node -1) (fng-assigned! frontend else-node (mut changed)) 0)
    (loop (if (>= (load index) (al-len [i64] (load changed)))
              (break)
              (do
                (al-push! [i64]
                          (mut saved-values)
                          (fng-symbol-node context
                                           (al-get [i64] (load changed) (load index))))
                (store! index (+ (load index) 1)))))
    (let [arms (n-if-arms! (fng-peep (n-new2 OP-IF 0 saved-ctrl condition)))]
      (store! (load (field context ctrl)) (arms-t arms))
      (let [then-value (if (= then-node -1) then-fixed (fng-expression context then-node))
            then-ctrl (load (load (field context ctrl)))]
        (store! index 0)
        (loop (if (>= (load index) (al-len [i64] (load changed)))
                  (break)
                  (do
                    (al-push! [i64]
                              (mut then-values)
                              (fng-symbol-node context
                                               (al-get [i64] (load changed) (load index))))
                    (store! index (+ (load index) 1)))))
        (store! (load (field context memory)) saved-memory)
        (store! (load (field context ctrl)) (arms-f arms))
        (fng-restore-values! context changed saved-values)
        (let [else-value (if (= else-node -1) else-fixed (fng-expression context else-node))
              else-ctrl (load (load (field context ctrl)))
              region (n-new OP-REGION 0)
              value-phi (n-new OP-PHI (t-dyn))]
          (n-add-def! region NO-NODE)
          (n-add-def! region then-ctrl)
          (n-add-def! region else-ctrl)
          (n-add-def! value-phi region)
          (n-add-def! value-phi then-value)
          (n-add-def! value-phi else-value)
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load changed)))
                    (break)
                    (let [symbol (al-get [i64] (load changed) (load index))
                          phi (n-new OP-PHI (fng-symbol-coil-type context symbol))]
                      (n-add-def! phi region)
                      (n-add-def! phi (al-get [i64] (load then-values) (load index)))
                      (n-add-def! phi
                                  (fng-symbol-node context
                                                   (al-get [i64] (load changed) (load index))))
                      (fng-set-symbol! context symbol phi)
                      (store! index (+ (load index) 1)))))
          (fng-active-memory! context (mut active))
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load active)))
                    (break)
                    (let [field-index (al-get [i64] (load active) (load index))
                          alias (al-get [i64] (load (load (field context aliases))) field-index)
                          phi (n-new OP-PHI (t-mem-alias alias (t-undef)))]
                      (n-add-def! phi region)
                      (n-add-def! phi (fng-memory then-ctrl alias))
                      (n-add-def! phi (fng-memory else-ctrl alias))
                      (al-push! [i64] (mut memory-phis) phi)
                      (store! index (+ (load index) 1)))))
          (store! (load (field context memory))
                  (if (> (al-len [i64] (load memory-phis)) 0)
                      (fng-merge memory-phis)
                      saved-memory))
          (store! (load (field context ctrl)) region)
          (al-free! [i64] (mut changed))
          (al-free! [i64] (mut saved-values))
          (al-free! [i64] (mut then-values))
          (al-free! [i64] (mut active))
          (al-free! [i64] (mut memory-phis))
          (fng-peep value-phi))))))

(defn fng-expression-expected [(context FngContext) (node i64) (expected i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-IDENTIFIER)
            (let [symbol (fe-resolution-symbol frontend node)]
              (cond (= symbol FE-INTRINSIC-UNDEFINED) (fng-undefined)
                    (= symbol FE-INTRINSIC-NAN) (n-new1 OP-CONST (t-flt-bits JSV-NAN) (g-start))
                    (< symbol 0) NO-NODE
                    :else
                      (let [value (fng-symbol-node context symbol)]
                        ;; Parameter nodes use the tagged JavaScript call ABI. When a typed
                        ;; context consumes a numeric identifier directly (object fields,
                        ;; annotated initializers, and returns), make the representation boundary
                        ;; explicit just as arithmetic lowering does.
                        (if (= expected FNG-NUMBER)
                            (fng-number-value context node value)
                            value))))
          (= kind TSK-THIS) (load (field context receiver))
          (= kind TSK-NUMERIC-LITERAL)
            (fng-numeric-literal ast node)
          (= kind TSK-STRING-LITERAL) (fng-string-literal ast node)
          (= kind TSK-NULL) (fng-null)
          (= kind TSK-TRUE) (fng-bool true)
          (= kind TSK-FALSE) (fng-bool false)
          (= kind TSK-PARENTHESIZED-EXPRESSION) (fng-expression-expected context (ts-child ast node 0) expected)
          (= kind TSK-PREFIX-UNARY)
            (let [text (ts-text ast node)
                  length (slice-len text)
                  operator (if (> length 0) (substr text 0 1) "")]
              (if (or (and (>= length 2) (str-eq (substr text 0 2) "++"))
                      (and (>= length 2) (str-eq (substr text 0 2) "--")))
                  (fng-update-local context node true)
                  (let [source (ts-child ast node 0)
                        value (fng-expression context source)]
                    (cond (str-eq operator "+") value
                          (str-eq operator "!")
                            (fng-bin OP-EQ
                                     (if (= (fng-infer context source FNG-DYNAMIC) FNG-STRING)
                                         (n-string-length! value)
                                         value)
                                     (fng-const 0))
                          (str-eq operator "-") (fng-bin OP-SUB (fng-const 0) value)
                          (str-eq operator "~") (n-new2 OP-BITNOT 0 NO-NODE value)
                          :else NO-NODE))))
          (= kind TSK-POSTFIX-UNARY) (fng-update-local context node false)
          (= kind TSK-CONDITIONAL-EXPRESSION)
            (let [condition-node (ts-role ast node TS-ROLE-CONDITION 0)
                  then-node (ts-role ast node TS-ROLE-WHEN-TRUE 0)
                  else-node (ts-role ast node TS-ROLE-WHEN-FALSE 0)
                  condition (fng-condition-expression context condition-node)]
              (fng-branch-expression context condition then-node NO-NODE else-node NO-NODE))
          (= kind TSK-BINARY)
            (let [left-node (ts-child ast node 0)
                  operator (ts-text ast (ts-child ast node 1))
                  right-node (ts-child ast node 2)]
              (if (or (str-eq operator "&&") (str-eq operator "||"))
                  (let [left (fng-expression context left-node)]
                    (if (str-eq operator "&&")
                        (fng-branch-expression context
                                               (if (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                   (n-string-length! left)
                                                   left)
                                               right-node
                                               NO-NODE
                                               -1
                                               left)
                        (fng-branch-expression context
                                               (if (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                   (n-string-length! left)
                                                   left)
                                               -1
                                               left
                                               right-node
                                               NO-NODE)))
                  (if (or (str-eq operator "=")
                          (or (str-eq operator "+=")
                              (or (str-eq operator "-=")
                                  (or (str-eq operator "*=")
                                      (or (str-eq operator "/=")
                                          (or (str-eq operator "%=")
                                              (or (str-eq operator "&=")
                                                  (or (str-eq operator "|=")
                                                      (or (str-eq operator "^=")
                                                          (or (str-eq operator "<<=")
                                                              (or (str-eq operator ">>=")
                                                                  (str-eq operator ">>>="))))))))))))
                      (let [target (fng-lvalue context left-node)
                            left
                              (if (str-eq operator "=")
                                  NO-NODE
                                  (fng-lvalue-read context target))
                            right (fng-expression context right-node)
                            value
                              (cond (str-eq operator "=") right
                                    (str-eq operator "+=")
                                      (if (and (not (load (fng-numeric-string-add-ptr)))
                                               (or (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                   (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING)))
                                          (n-string-concat! (fng-string-coerce context left-node left)
                                                            (fng-string-coerce context right-node right))
                                          (fng-bin OP-ADD
                                                   (fng-number-value context left-node left)
                                                   (fng-number-value context right-node right)))
                                    (str-eq operator "-=")
                                      (fng-bin OP-SUB
                                               (fng-number-value context left-node left)
                                               (fng-number-value context right-node right))
                                    (str-eq operator "*=")
                                      (fng-bin OP-MUL
                                               (fng-number-value context left-node left)
                                               (fng-number-value context right-node right))
                                    (str-eq operator "/=")
                                      (fng-bin OP-DIV
                                               (fng-number-value context left-node left)
                                               (fng-number-value context right-node right))
                                    (str-eq operator "%=")
                                      (fng-bin OP-MOD
                                               (fng-number-value context left-node left)
                                               (fng-number-value context right-node right))
                                    (str-eq operator "&=")
                                      (fng-bin OP-BITAND
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right))
                                    (str-eq operator "|=")
                                      (fng-bin OP-BITOR
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right))
                                    (str-eq operator "^=")
                                      (fng-bin OP-BITXOR
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right))
                                    (str-eq operator "<<=")
                                      (fng-bin OP-SHL
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right))
                                    (str-eq operator ">>=")
                                      (fng-bin OP-SHR
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right))
                                    :else
                                      (fng-bin OP-USHR
                                               (fng-int-value context left-node left)
                                               (fng-int-value context right-node right)))]
                        (fng-lvalue-write context target value))
                      (let [left (fng-expression context left-node)
                            right (fng-expression context right-node)]
                        (cond (str-eq operator "+")
                                (if (and (not (load (fng-numeric-string-add-ptr)))
                                         (or (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                             (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING)))
                                    (n-string-concat! (fng-string-coerce context left-node left)
                                                      (fng-string-coerce context right-node right))
                                    (fng-bin OP-ADD
                                             (fng-number-value context left-node left)
                                             (fng-number-value context right-node right)))
                              (str-eq operator "-")
                                (fng-bin OP-SUB
                                         (fng-number-value context left-node left)
                                         (fng-number-value context right-node right))
                              (str-eq operator "*")
                                (fng-bin OP-MUL
                                         (fng-number-value context left-node left)
                                         (fng-number-value context right-node right))
                              (str-eq operator "/")
                                (fng-bin OP-DIV
                                         (fng-number-value context left-node left)
                                         (fng-number-value context right-node right))
                              (str-eq operator "%")
                                (fng-bin OP-MOD
                                         (fng-number-value context left-node left)
                                         (fng-number-value context right-node right))
                              (str-eq operator "&")
                                (fng-bin OP-BITAND
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator "|")
                                (fng-bin OP-BITOR
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator "^")
                                (fng-bin OP-BITXOR
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator "<<")
                                (fng-bin OP-SHL
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator ">>")
                                (fng-bin OP-SHR
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator ">>>")
                                (fng-bin OP-USHR
                                         (fng-int-value context left-node left)
                                         (fng-int-value context right-node right))
                              (str-eq operator "<")
                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                    (fng-bin OP-LT (n-string-compare! left right) (fng-const 0))
                                    (fng-bin OP-LT
                                             (fng-number-value context left-node left)
                                             (fng-number-value context right-node right)))
                              (str-eq operator "<=")
                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                    (fng-bin OP-LE (n-string-compare! left right) (fng-const 0))
                                    (fng-bin OP-LE
                                             (fng-number-value context left-node left)
                                             (fng-number-value context right-node right)))
                              (str-eq operator ">")
                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                    (fng-bin OP-LT (fng-const 0) (n-string-compare! left right))
                                    (fng-bin OP-LT
                                             (fng-number-value context right-node right)
                                             (fng-number-value context left-node left)))
                              (str-eq operator ">=")
                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                    (fng-bin OP-LE (fng-const 0) (n-string-compare! left right))
                                    (fng-bin OP-LE
                                             (fng-number-value context right-node right)
                                             (fng-number-value context left-node left)))
                              (str-eq operator "===")
                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                    (n-string-equal! left right)
                                    (fng-equal-value context left-node left right-node right))
                              (str-eq operator "!==")
                                (let [equal
                                        (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                 (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                            (n-string-equal! left right)
                                            (fng-bin OP-EQ left right))]
                                  (fng-bin OP-EQ equal (fng-const 0)))
                              (str-eq operator "!=")
                                (let [equal
                                        (if (fng-nullish-literal? context left-node)
                                            (fng-nullish-equal context right-node right)
                                            (if (fng-nullish-literal? context right-node)
                                                (fng-nullish-equal context left-node left)
                                                (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                         (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                                    (n-string-equal! left right)
                                                    (fng-equal-value context left-node left right-node right))))]
                                  (fng-bin OP-EQ equal (fng-const 0)))
                              (str-eq operator "==")
                                (if (fng-nullish-literal? context left-node)
                                    (fng-nullish-equal context right-node right)
                                    (if (fng-nullish-literal? context right-node)
                                        (fng-nullish-equal context left-node left)
                                        (if (and (= (fng-infer context left-node FNG-DYNAMIC) FNG-STRING)
                                                 (= (fng-infer context right-node FNG-DYNAMIC) FNG-STRING))
                                            (n-string-equal! left right)
                                            (fng-equal-value context left-node left right-node right))))
                              (str-eq operator ",") right
                              :else NO-NODE)))))
          (= kind TSK-CALL)
            (if (fng-math-builtin? context node)
                (fng-math-call context node)
            (if (fng-number-to-string? context node)
                (fng-number-to-string context node)
                (if (fng-string-from-char-code? context node)
                    (fng-string-from-char-code context node)
                    (if (fng-string-builtin? context node)
                        (fng-string-call context node)
                        (if (fng-array-builtin? context node)
                            (fng-array-call context node)
                            (fng-call context node))))))
          (= kind TSK-NEW-EXPRESSION)
            (if (fng-error-constructor? context node) (fng-error-constructor context node) (fng-call context node))
          (= kind TSK-OBJECT-LITERAL)
            (if (= expected FNG-DYNAMIC)
                (fng-dynamic-object context node)
                (fng-object context node expected))
          (= kind TSK-ARRAY-LITERAL) (fng-array-literal context node)
          (= kind TSK-FUNCTION-EXPRESSION) (fng-closure-expression context node)
          (= kind TSK-PROPERTY-ACCESS)
            (let [math-member (fng-math-member-id context node)]
              (if (>= math-member 0)
                  NO-NODE
                  (if (str-eq (ts-text ast node) "Math.LN2")
                      (n-new1 OP-CONST (t-flt-con 0.6931471805599453) (g-start))
                      (fng-field-load context node))))
          (= kind TSK-ELEMENT-ACCESS) (fng-lvalue-read context (fng-lvalue context node))
          :else NO-NODE)))

(defn fng-ensure-memory! [(context FngContext)] (-> i64)
  (if (and (!= (load (load (field context memory))) NO-NODE)
           (fng-memory-node? (load (load (field context memory)))))
      0
      (let [(mut active) (al-new [i64] (malloc-allocator))
            (mut memories) (al-new [i64] (malloc-allocator))
            (mut index) 0]
        ; A branch snapshot must never publish a scalar in the effect slot. Recover by
        ; re-anchoring every active alias at current control; verification still checks the
        ; resulting explicit memory graph.
        (store! (load (field context memory)) NO-NODE)
        (fng-active-memory! context (mut active))
        (loop (if (>= (load index) (al-len [i64] (load active)))
                  (break)
                  (let [field-index (al-get [i64] (load active) (load index))
                        alias (al-get [i64] (load (load (field context aliases))) field-index)]
                    (al-push! [i64] (mut memories) (fng-memory (load (load (field context ctrl))) alias))
                    (store! index (+ (load index) 1)))))
        (if (> (al-len [FeCapture] (load (field (load (field context frontend)) captures))) 0)
            (al-push! [i64]
                      (mut memories)
                      (fng-memory (load (load (field context ctrl)))
                                  (load (field context cell-alias))))
            0)
        (if (> (al-len [i64] (load memories)) 0)
            (store! (load (field context memory)) (fng-merge memories))
            0)
        (al-free! [i64] (mut active))
        (al-free! [i64] (mut memories))
        0)))

(defn fng-add-return! [(context FngContext) (value i64)] (-> i64)
  (fng-ensure-memory! context)
  (let [ctrl (load (load (field context ctrl)))
        memory (load (load (field context memory)))]
    (if (load (field context top-level))
        (let [ret
                (if (= memory NO-NODE)
                    (n-new2 OP-RETURN 0 ctrl value)
                    (n-new3 OP-RETURN 0 ctrl value memory))]
          (n-add-def! (g-stop) ret)
          ret)
        (let [ret
                (if (= memory NO-NODE)
                    (n-new2 OP-RETURN 0 ctrl value)
                    (n-new3 OP-RETURN 0 ctrl value memory))
              first (load (field context first-return))
              fun (load (field context fun))]
          (if (= (load first) NO-NODE)
              (do (n-fun-close! fun ret) (store! first ret))
              (n-fun-add-return! fun ret))
          ret))))

(defn fng-list-has [(values (ptr (ArrayList i64))) (value i64)] (-> bool)
  (let [(mut index) 0
        (mut found) false]
    (loop (if (or (>= (load index) (al-len [i64] (load values))) (load found))
              (break)
              (do
                (if (= (al-get [i64] (load values) (load index)) value) (store! found true) 0)
                (store! index (+ (load index) 1)))))
    (load found)))

(defn fng-top-level-initialize! [(context FngContext)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        root (ts-root ast)
        (mut index) 0]
    ; Script-level `var` bindings exist as undefined before any initializer runs. This is
    ; observable when an early function/prototype closure captures a global declared later.
    (loop (if (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (and (= (load (field symbol role)) FE-ROLE-GLOBAL)
                         (= (fng-symbol-storage context (load (field symbol id))) NO-NODE))
                    (do
                      (fng-set-symbol! context (load (field symbol id)) (fng-undefined))
                      (fng-set-symbol-type! context (load (field symbol id)) FNG-VOID))
                    0)
                (store! index (+ (load index) 1)))))
    (store! index 0)
    ; JavaScript function declarations are objects as well as call targets. Materialize one stable
    ; object per declaration before executing top-level initializers, and publish its real
    ; `prototype` property so constructor static fields and inheritance helpers use ordinary
    ; dynamic property semantics.
    (loop (if (>= (load index) (al-len [FeFunction] (load (field frontend functions))))
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load index))]
                ; Nested declarations belong to their lexical invocation. Publishing
                ; their function object/prototype here would embed a parent function's
                ; allocation directly in the synthetic top-level graph.
                (if (and (= (load (field fn parent)) -1)
                         (= (fng-symbol-storage context (load index)) NO-NODE))
                    (let [object (fng-empty-dynamic-object context)]
                      ; Publish identity before prototype materialization: a prototype method may
                      ; capture its own constructor object.
                      (fng-set-symbol! context (load index) object)
                      (let [prototype (fng-constructor-prototype! context (load index))
                          stored
                            (n-peephole
                              (n-new4 OP-PROPSTORE
                                      (shape-name-intern! "prototype")
                                      (load (load (field context ctrl)))
                                      (fng-current-memory context JS-PROPERTY-ALIAS)
                                      object
                                      (n-box! prototype)))]
                        (store! (load (field context memory))
                                (fng-preserve-active-memory context stored))))
                    0)
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (ts-child-count ast root))
              (break)
              (let [statement (ts-child ast root (load index))
                    kind (ts-kind ast statement)
                    expression (if (= kind TSK-EXPRESSION-STATEMENT) (ts-child ast statement 0) -1)
                    static-prototype
                      (if (and (!= expression -1) (= (ts-kind ast expression) TSK-BINARY))
                          (let [left (ts-child ast expression 0)]
                            (if (= (ts-kind ast left) TSK-PROPERTY-ACCESS)
                                (let [base (ts-child ast left 0)]
                                  (and (= (ts-kind ast base) TSK-PROPERTY-ACCESS)
                                       (str-eq (ts-text ast (ts-child ast base 1)) "prototype")))
                                false))
                          false)]
                (if (and (or (= kind TSK-VARIABLE-STATEMENT) (= kind TSK-EXPRESSION-STATEMENT))
                         (not static-prototype))
                    (fng-statement context statement)
                    false)
                (store! index (+ (load index) 1)))))
    0))

(defn fng-static-global-value [(frontend (ptr NativeFrontend))
                               (values (ptr (ArrayList i64)))
                               (node i64)] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-NUMERIC-LITERAL)
            (fng-numeric-literal ast node)
          (= kind TSK-STRING-LITERAL) (fng-string-literal ast node)
          (= kind TSK-NULL) (fng-null)
          (= kind TSK-TRUE) (fng-bool true)
          (= kind TSK-FALSE) (fng-bool false)
          (= kind TSK-PARENTHESIZED-EXPRESSION)
            (fng-static-global-value frontend values (ts-child ast node 0))
          (= kind TSK-IDENTIFIER)
            (al-get [i64] (load values) (fe-resolution-symbol frontend node))
          (= kind TSK-PREFIX-UNARY)
            (let [value (fng-static-global-value frontend values (ts-child ast node 0))
                  text (ts-text ast node)]
              (cond (str-eq (substr text 0 1) "~") (n-new2 OP-BITNOT 0 NO-NODE value)
                    (str-eq (substr text 0 1) "-") (n-new2 OP-MINUS 0 NO-NODE value)
                    (str-eq (substr text 0 1) "!") (n-new2 OP-NOT 0 NO-NODE value)
                    :else value))
          (= kind TSK-BINARY)
            (let [left (fng-static-global-value frontend values (ts-child ast node 0))
                  right (fng-static-global-value frontend values (ts-child ast node 2))
                  operator (ts-text ast (ts-child ast node 1))]
              (fng-bin (cond (str-eq operator "+") OP-ADD
                             (str-eq operator "-") OP-SUB
                             (str-eq operator "*") OP-MUL
                             (str-eq operator "/") OP-DIV
                             (str-eq operator "%") OP-MOD
                             (str-eq operator "&") OP-BITAND
                             (str-eq operator "|") OP-BITOR
                             (str-eq operator "^") OP-BITXOR
                             (str-eq operator "<<") OP-SHL
                             (str-eq operator ">>") OP-SHR
                             :else OP-USHR)
                       left right))
          :else NO-NODE)))

(defn fng-initialize-static-globals! [(frontend (ptr NativeFrontend))
                                      (values (mut (ArrayList i64)))
                                      (value-types (mut (ArrayList i64)))] (-> i64)
  (let [ast (field frontend ast)
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))
                    symbol-id (load (field symbol id))]
                (if (fng-static-global-symbol? frontend symbol-id)
                    (let [declaration (load (field symbol node))
                          initializer (ts-child ast declaration (- (ts-child-count ast declaration) 1))
                          kind (ts-kind ast initializer)
                          value (fng-static-global-value frontend values initializer)]
                      (al-set! [i64] (mut values) symbol-id value)
                      (al-set! [i64]
                               (mut value-types)
                               symbol-id
                               (cond (= kind TSK-NUMERIC-LITERAL) FNG-NUMBER
                                     (= kind TSK-STRING-LITERAL) FNG-STRING
                                     (= kind TSK-NULL) FNG-NULL
                                     (or (= kind TSK-TRUE) (= kind TSK-FALSE)) FNG-BOOLEAN
                                     :else FNG-NUMBER)))
                    0)
                (store! index (+ (load index) 1)))))
    0))

(defn fng-assigned! [(frontend (ptr NativeFrontend))
                     (node i64)
                     (assigned (mut (ArrayList i64)))] (-> i64)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)]
    (if (= kind TSK-BINARY)
        (let [operator (ts-text ast (ts-child ast node 1))
              left (ts-child ast node 0)]
          (if (and (or (str-eq operator "=")
                       (or (str-eq operator "+=")
                           (or (str-eq operator "-=")
                               (or (str-eq operator "*=")
                                   (or (str-eq operator "/=")
                                       (or (str-eq operator "%=")
                                           (or (str-eq operator "&=")
                                               (or (str-eq operator "|=")
                                                   (or (str-eq operator "^=")
                                                       (or (str-eq operator "<<=")
                                                           (or (str-eq operator ">>=")
                                                               (str-eq operator ">>>="))))))))))))
                   (= (ts-kind ast left) TSK-IDENTIFIER))
              (let [symbol (fe-resolution-symbol frontend left)]
                (if (fng-list-has assigned symbol) 0 (al-push! [i64] (mut assigned) symbol)))
              0))
        0)
    (if (or (= kind TSK-PREFIX-UNARY) (= kind TSK-POSTFIX-UNARY))
        (let [text (ts-text ast node)
              length (slice-len text)
              prefix-op (if (>= length 2) (substr text 0 2) "")
              postfix-op (if (>= length 2) (substr text (- length 2) length) "")
              operand (ts-child ast node 0)]
          (if (and (or (str-eq prefix-op "++")
                       (or (str-eq prefix-op "--")
                           (or (str-eq postfix-op "++") (str-eq postfix-op "--"))))
                   (= (ts-kind ast operand) TSK-IDENTIFIER))
              (let [symbol (fe-resolution-symbol frontend operand)]
                (if (fng-list-has assigned symbol) 0 (al-push! [i64] (mut assigned) symbol)))
              0))
        0)
    (let [(mut index) 0]
      (loop (if (>= (load index) (ts-child-count ast node))
                (break)
                (do
                  (fng-assigned! frontend (ts-child ast node (load index)) (mut assigned))
                  (store! index (+ (load index) 1))))))
    0))

(defn fng-restore-values! [(context FngContext)
                           (symbols (ptr (ArrayList i64)))
                           (saved (ptr (ArrayList i64)))] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (fng-set-symbol! context
                                 (al-get [i64] (load symbols) (load index))
                                 (al-get [i64] (load saved) (load index)))
                (store! index (+ (load index) 1)))))
    0))

(defn fng-target-make [(label-node i64)
                       (can-break bool)
                       (can-continue bool)
                       (symbol-start i64)
                       (symbol-count i64)
                       (active-start i64)
                       (active-count i64)
                       (jump-start i64)
                       (jump-value-start i64)] (-> FngTarget)
  (let [(mut target) (zeroed FngTarget)]
    (store! (field target label-node) label-node)
    (store! (field target can-break) can-break)
    (store! (field target can-continue) can-continue)
    (store! (field target active) true)
    (store! (field target symbol-start) symbol-start)
    (store! (field target symbol-count) symbol-count)
    (store! (field target active-start) active-start)
    (store! (field target active-count) active-count)
    (store! (field target jump-start) jump-start)
    (store! (field target jump-value-start) jump-value-start)
    (load target)))

(defn fng-jump-make [(target i64) (kind i64) (ctrl i64) (value-start i64)] (-> FngJump)
  (let [(mut jump) (zeroed FngJump)]
    (store! (field jump target) target)
    (store! (field jump kind) kind)
    (store! (field jump ctrl) ctrl)
    (store! (field jump value-start) value-start)
    (load jump)))

(defn fng-push-target! [(context FngContext)
                        (label-node i64)
                        (can-break bool)
                        (can-continue bool)
                        (symbols (ptr (ArrayList i64)))] (-> i64)
  (let [targets (load (field context targets))
        target-symbols (load (field context target-symbols))
        target-active (load (field context target-active))
        jumps (load (field context jumps))
        jump-values (load (field context jump-values))
        symbol-start (al-len [i64] (load target-symbols))
        active-start (al-len [i64] (load target-active))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (al-push! [i64]
                          (mut target-symbols)
                          (al-get [i64] (load symbols) (load index)))
                (store! index (+ (load index) 1)))))
    (fng-active-memory! context (mut active))
    (store! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-push! [i64]
                          (mut target-active)
                          (al-get [i64] (load active) (load index)))
                (store! index (+ (load index) 1)))))
    (let [answer (al-len [FngTarget] (load targets))]
      (al-push! [FngTarget]
                (mut targets)
                (fng-target-make label-node
                                 can-break
                                 can-continue
                                 symbol-start
                                 (al-len [i64] (load symbols))
                                 active-start
                                 (al-len [i64] (load active))
                                 (al-len [FngJump] (load jumps))
                                 (al-len [i64] (load jump-values))))
      (al-free! [i64] (mut active))
      answer)))

(defn fng-find-target [(context FngContext) (node i64) (kind i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        label (ts-role ast node TS-ROLE-LABEL 0)
        targets (load (field context targets))
        (mut index) (- (al-len [FngTarget] (load targets)) 1)
        (mut answer) -1]
    (loop (if (or (< (load index) 0) (!= (load answer) -1))
              (break)
              (let [target (al-get [FngTarget] (load targets) (load index))
                    capable
                      (and (load (field target active))
                           (if (= kind FNG-JUMP-CONTINUE)
                               (load (field target can-continue))
                               (load (field target can-break))))
                    matches
                      (if (= label -1)
                          true
                          (and (!= (load (field target label-node)) -1)
                               (str-eq (ts-text ast label)
                                       (ts-text ast (load (field target label-node))))))]
                (if (and capable matches) (store! answer (load index)) 0)
                (store! index (- (load index) 1)))))
    (load answer)))

(defn fng-capture-target! [(context FngContext) (target-index i64) (kind i64)] (-> i64)
  (let [targets (load (field context targets))
        target (al-get [FngTarget] (load targets) target-index)
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        jumps (load (field context jumps))
        values (load (field context jump-values))
        value-start (al-len [i64] (load values))
        (mut index) 0]
    (loop (if (>= (load index) (load (field target symbol-count)))
              (break)
              (do
                (al-push! [i64]
                          (mut values)
                          (fng-symbol-node context
                                           (al-get [i64]
                                                   (load symbols)
                                                   (+ (load (field target symbol-start)) (load index)))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (load (field target active-count)))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (load (field target active-start)) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut values) (fng-current-memory context alias))
                (store! index (+ (load index) 1)))))
    (al-push! [FngJump]
              (mut jumps)
              (fng-jump-make target-index kind (load (load (field context ctrl))) value-start))
    (store! (load (field context ctrl)) NO-NODE)
    target-index))

(defn fng-capture-jump! [(context FngContext) (node i64) (kind i64)] (-> i64)
  (fng-capture-target! context (fng-find-target context node kind) kind))

(defn fng-merge-target! [(context FngContext)
                         (target-index i64)
                         (kind i64)
                         (normal bool)] (-> bool)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        jumps (load (field context jumps))
        jump-values (load (field context jump-values))
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        (mut matching) (al-new [i64] (malloc-allocator))
        (mut normal-memory) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        (mut index) (load (field target jump-start))]
    (loop (if (>= (load index) (al-len [FngJump] (load jumps)))
              (break)
              (let [jump (al-get [FngJump] (load jumps) (load index))]
                (if (and (= (load (field jump target)) target-index)
                         (= (load (field jump kind)) kind))
                    (al-push! [i64] (mut matching) (load index))
                    0)
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (load (field target active-count)))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (load (field target active-start)) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut normal-memory) (fng-current-memory context alias))
                (store! index (+ (load index) 1)))))
    (let [count (+ (if normal 1 0) (al-len [i64] (load matching)))]
      (cond (= count 0) 0
            (= count 1)
              (if normal
                  0
                  (let [jump (al-get [FngJump] (load jumps) (al-get [i64] (load matching) 0))]
                    (store! (load (field context ctrl)) (load (field jump ctrl)))
                    (store! index 0)
                    (loop (if (>= (load index) (load (field target symbol-count)))
                              (break)
                              (do
                                (fng-set-symbol! context
                                                 (al-get [i64]
                                                         (load symbols)
                                                         (+ (load (field target symbol-start)) (load index)))
                                                 (al-get [i64]
                                                         (load jump-values)
                                                         (+ (load (field jump value-start)) (load index))))
                                (store! index (+ (load index) 1)))))
                    (store! index 0)
                    (loop (if (>= (load index) (load (field target active-count)))
                              (break)
                              (do
                                (al-push! [i64]
                                          (mut memory-phis)
                                          (al-get [i64]
                                                  (load jump-values)
                                                  (+ (+ (load (field jump value-start))
                                                        (load (field target symbol-count)))
                                                     (load index))))
                                (store! index (+ (load index) 1)))))
                    (if (> (al-len [i64] (load memory-phis)) 0)
                        (store! (load (field context memory)) (fng-merge memory-phis))
                        0)))
            :else
              (let [region (n-new OP-REGION 0)]
                (n-add-def! region NO-NODE)
                (if normal (n-add-def! region (load (load (field context ctrl)))) 0)
                (store! index 0)
                (loop (if (>= (load index) (al-len [i64] (load matching)))
                          (break)
                          (let [jump
                                  (al-get [FngJump]
                                          (load jumps)
                                          (al-get [i64] (load matching) (load index)))]
                            (n-add-def! region (load (field jump ctrl)))
                            (store! index (+ (load index) 1)))))
                (store! index 0)
                (loop (if (>= (load index) (load (field target symbol-count)))
                          (break)
                          (let [symbol
                                  (al-get [i64]
                                          (load symbols)
                                          (+ (load (field target symbol-start)) (load index)))
                                phi (n-new OP-PHI (fng-symbol-coil-type context symbol))
                                (mut ji) 0]
                            (n-add-def! phi region)
                            (if normal
                                (n-add-def! phi
                                            (fng-symbol-node context
                                                             (al-get [i64]
                                                                     (load symbols)
                                                                     (+ (load (field target symbol-start))
                                                                        (load index)))))
                                0)
                            (loop (if (>= (load ji) (al-len [i64] (load matching)))
                                      (break)
                                      (let [jump
                                              (al-get [FngJump]
                                                      (load jumps)
                                                      (al-get [i64] (load matching) (load ji)))]
                                        (n-add-def! phi
                                                    (al-get [i64]
                                                            (load jump-values)
                                                            (+ (load (field jump value-start)) (load index))))
                                        (store! ji (+ (load ji) 1)))))
                            (fng-set-symbol! context symbol phi)
                            (store! index (+ (load index) 1)))))
                (store! index 0)
                (loop (if (>= (load index) (load (field target active-count)))
                          (break)
                          (let [field-index
                                  (al-get [i64]
                                          (load active)
                                          (+ (load (field target active-start)) (load index)))
                                alias (al-get [i64] (load (load (field context aliases))) field-index)
                                phi (n-new OP-PHI (t-mem-alias alias (t-undef)))
                                (mut ji) 0]
                            (n-add-def! phi region)
                            (if normal (n-add-def! phi (al-get [i64] (load normal-memory) (load index))) 0)
                            (loop (if (>= (load ji) (al-len [i64] (load matching)))
                                      (break)
                                      (let [jump
                                              (al-get [FngJump]
                                                      (load jumps)
                                                      (al-get [i64] (load matching) (load ji)))]
                                        (n-add-def! phi
                                                    (al-get [i64]
                                                            (load jump-values)
                                                            (+ (+ (load (field jump value-start))
                                                                  (load (field target symbol-count)))
                                                               (load index))))
                                        (store! ji (+ (load ji) 1)))))
                            (al-push! [i64] (mut memory-phis) phi)
                            (store! index (+ (load index) 1)))))
                (if (> (al-len [i64] (load memory-phis)) 0)
                    (store! (load (field context memory)) (fng-merge memory-phis))
                    0)
                (store! (load (field context ctrl)) region)))
      (al-free! [i64] (mut matching))
      (al-free! [i64] (mut normal-memory))
      (al-free! [i64] (mut memory-phis))
      (> count 0))))

(defn fng-pop-target! [(context FngContext) (target-index i64)] (-> i64)
  (let [targets (load (field context targets))
        target (index (load (field targets data)) target-index)]
    ;; Target ids are monotonic for the whole function. Jumps to an outer target may be recorded
    ;; while an inner target is active, so truncating shared logs here would erase those exits.
    (store! (field target active) false)
    0))

(defn fng-snapshot-target! [(context FngContext)
                            (target-index i64)
                            (values (mut (ArrayList i64)))] (-> i64)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        symbols (load (field context target-symbols))
        active (load (field context target-active))
        start (al-len [i64] (load values))
        (mut index) 0]
    (loop (if (>= (load index) (load (field target symbol-count)))
              (break)
              (do
                (al-push! [i64]
                          (mut values)
                          (fng-symbol-node context
                                           (al-get [i64]
                                                   (load symbols)
                                                   (+ (load (field target symbol-start)) (load index)))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (load (field target active-count)))
              (break)
              (let [field-index
                      (al-get [i64]
                              (load active)
                              (+ (load (field target active-start)) (load index)))
                    alias (al-get [i64] (load (load (field context aliases))) field-index)]
                (al-push! [i64] (mut values) (fng-current-memory context alias))
                (store! index (+ (load index) 1)))))
    start))

(defn fng-restore-target! [(context FngContext)
                           (target-index i64)
                           (values (ptr (ArrayList i64)))
                           (start i64)] (-> i64)
  (let [target (al-get [FngTarget] (load (load (field context targets))) target-index)
        symbols (load (field context target-symbols))
        (mut memories) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (load (field target symbol-count)))
              (break)
              (do
                (fng-set-symbol! context
                                 (al-get [i64]
                                         (load symbols)
                                         (+ (load (field target symbol-start)) (load index)))
                                 (al-get [i64] (load values) (+ start (load index))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (load (field target active-count)))
              (break)
              (do
                (al-push! [i64]
                          (mut memories)
                          (al-get [i64]
                                  (load values)
                                  (+ (+ start (load (field target symbol-count))) (load index))))
                (store! index (+ (load index) 1)))))
    (if (> (al-len [i64] (load memories)) 0)
        (store! (load (field context memory)) (fng-merge memories))
        (store! (load (field context memory)) NO-NODE))
    (al-free! [i64] (mut memories))
    0))

(defn fng-switch-path-copy-unused [(context FngContext) (node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        clauses (ts-role ast node TS-ROLE-CLAUSE 0)
        (mut assigned) (al-new [i64] (malloc-allocator))
        (mut entry-clauses) (al-new [i64] (malloc-allocator))
        (mut entry-ctrls) (al-new [i64] (malloc-allocator))
        (mut entry-starts) (al-new [i64] (malloc-allocator))
        (mut entry-values) (al-new [i64] (malloc-allocator))
        discriminant (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0))
        (mut default-index) -1
        (mut index) 0]
    (fng-assigned! frontend clauses (mut assigned))
    (let [target-index (fng-push-target! context label-node true false (mut assigned))]
      ;; Case expressions execute left-to-right only while no earlier case matched.
      (loop (let [clause (ts-role ast clauses TS-ROLE-CLAUSE (load index))]
              (if (= clause -1)
                  (break)
                  (do
                    (if (= (ts-kind ast clause) TSK-DEFAULT-CLAUSE)
                        (store! default-index (load index))
                        (let [test (fng-expression context (ts-role ast clause TS-ROLE-EXPRESSION 0))
                              arms
                                (n-if-arms! (fng-peep (n-new2 OP-IF
                                                              0
                                                              (load (load (field context ctrl)))
                                                              (fng-equal-value
                                                                context
                                                                (ts-role ast node TS-ROLE-EXPRESSION 0)
                                                                discriminant
                                                                (ts-role ast clause TS-ROLE-EXPRESSION 0)
                                                                test))))]
                          (al-push! [i64] (mut entry-clauses) (load index))
                          (al-push! [i64] (mut entry-ctrls) (arms-t arms))
                          (al-push! [i64]
                                    (mut entry-starts)
                                    (fng-snapshot-target! context target-index (mut entry-values)))
                          (store! (load (field context ctrl)) (arms-f arms))))
                    (store! index (+ (load index) 1))))))
      ;; The final false arm selects default, or exits directly when no default exists.
      (al-push! [i64] (mut entry-clauses) (load default-index))
      (al-push! [i64] (mut entry-ctrls) (load (load (field context ctrl))))
      (al-push! [i64]
                (mut entry-starts)
                (fng-snapshot-target! context target-index (mut entry-values)))
      ;; Compile every selected fallthrough suffix independently, then merge its exits.
      (store! index 0)
      (loop (if (>= (load index) (al-len [i64] (load entry-clauses)))
                (break false)
                (let [entry (al-get [i64] (load entry-clauses) (load index))
                      (mut clause-index) entry
                      (mut continues) true]
                  (store! (load (field context ctrl))
                          (al-get [i64] (load entry-ctrls) (load index)))
                  (fng-restore-target! context
                                       target-index
                                       entry-values
                                       (al-get [i64] (load entry-starts) (load index)))
                  (cond (= entry -1) (fng-capture-target! context target-index FNG-JUMP-BREAK)
                        :else
                          (loop (if (not (load continues))
                                    (break)
                                    (let [clause (ts-role ast clauses TS-ROLE-CLAUSE (load clause-index))]
                                      (if (= clause -1)
                                          (break)
                                          (let [expression (ts-role ast clause TS-ROLE-EXPRESSION 0)
                                                (mut child-index) 0]
                                            (loop (if (or (>= (load child-index) (ts-child-count ast clause))
                                                          (not (load continues)))
                                                      (break)
                                                      (let [child (ts-child ast clause (load child-index))]
                                                        (if (!= child expression)
                                                            (store! continues (fng-statement context child))
                                                            0)
                                                        (store! child-index (+ (load child-index) 1)))))
                                            (store! clause-index (+ (load clause-index) 1)))))))
                        (if (load continues)
                            (fng-capture-target! context target-index FNG-JUMP-BREAK)
                            0)
                          (store! index (+ (load index) 1)))))
        (let [answer (fng-merge-target! context target-index FNG-JUMP-BREAK false)]
          (fng-pop-target! context target-index)
          (al-free! [i64] (mut assigned))
          (al-free! [i64] (mut entry-clauses))
          (al-free! [i64] (mut entry-ctrls))
          (al-free! [i64] (mut entry-starts))
          (al-free! [i64] (mut entry-values))
          answer)))))

(defn fng-snapshot! [(context FngContext)
                     (symbols (ptr (ArrayList i64)))
                     (active (ptr (ArrayList i64)))
                     (out (mut (ArrayList i64)))] (-> i64)
  (let [start (al-len [i64] (load out))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (al-push! [i64]
                          (mut out)
                          (fng-symbol-node context (al-get [i64] (load symbols) (load index))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (let [alias (al-get [i64] (load active) (load index))]
                (al-push! [i64] (mut out) (fng-current-memory context alias))
                (store! index (+ (load index) 1)))))
    start))

(defn fng-restore-snapshot! [(context FngContext)
                             (symbols (ptr (ArrayList i64)))
                             (active (ptr (ArrayList i64)))
                             (values (ptr (ArrayList i64)))
                             (start i64)] (-> i64)
  (let [(mut memories) (al-new [i64] (malloc-allocator))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [i64] (load symbols)))
              (break)
              (do
                (fng-set-symbol! context
                                 (al-get [i64] (load symbols) (load index))
                                 (al-get [i64] (load values) (+ start (load index))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-push! [i64]
                          (mut memories)
                          (al-get [i64]
                                  (load values)
                                  (+ (+ start (al-len [i64] (load symbols))) (load index))))
                (store! index (+ (load index) 1)))))
    (if (> (al-len [i64] (load memories)) 0)
        (store! (load (field context memory)) (fng-merge memories))
        0)
    (al-free! [i64] (mut memories))
    0))

(defn fng-merge-snapshots! [(context FngContext)
                            (left-ctrl i64)
                            (left-start i64)
                            (right-ctrl i64)
                            (right-start i64)
                            (symbols (ptr (ArrayList i64)))
                            (active (ptr (ArrayList i64)))
                            (values (ptr (ArrayList i64)))] (-> bool)
  (cond (= left-ctrl NO-NODE)
          (if (= right-ctrl NO-NODE)
              false
              (do
                (store! (load (field context ctrl)) right-ctrl)
                (fng-restore-snapshot! context symbols active values right-start)
                true))
        (= right-ctrl NO-NODE)
          (do
            (store! (load (field context ctrl)) left-ctrl)
            (fng-restore-snapshot! context symbols active values left-start)
            true)
        :else
          (let [region (n-new OP-REGION 0)
                (mut memories) (al-new [i64] (malloc-allocator))
                symbol-count (al-len [i64] (load symbols))
                (mut index) 0]
            (n-add-def! region NO-NODE)
            (n-add-def! region left-ctrl)
            (n-add-def! region right-ctrl)
            (loop (if (>= (load index) symbol-count)
                      (break)
                      (let [symbol (al-get [i64] (load symbols) (load index))
                            phi (n-new OP-PHI (fng-symbol-coil-type context symbol))]
                        (n-add-def! phi region)
                        (n-add-def! phi (al-get [i64] (load values) (+ left-start (load index))))
                        (n-add-def! phi (al-get [i64] (load values) (+ right-start (load index))))
                        (fng-set-symbol! context symbol phi)
                        (store! index (+ (load index) 1)))))
            (store! index 0)
            (loop (if (>= (load index) (al-len [i64] (load active)))
                      (break)
                      (let [alias (al-get [i64] (load active) (load index))
                            phi (n-new OP-PHI (t-mem-alias alias (t-undef)))]
                        (n-add-def! phi region)
                        (n-add-def! phi
                                    (al-get [i64]
                                            (load values)
                                            (+ (+ left-start symbol-count) (load index))))
                        (n-add-def! phi
                                    (al-get [i64]
                                            (load values)
                                            (+ (+ right-start symbol-count) (load index))))
                        (al-push! [i64] (mut memories) phi)
                        (store! index (+ (load index) 1)))))
            (if (> (al-len [i64] (load memories)) 0)
                (store! (load (field context memory)) (fng-merge memories))
                0)
            (store! (load (field context ctrl)) region)
            (al-free! [i64] (mut memories))
            true)))

(defn fng-control-aliases! [(context FngContext) (active (mut (ArrayList i64)))] (-> i64)
  (let [(mut index) 0]
    ;; fng-active-memory! publishes declared-field indices for layout consumers. Control snapshots
    ;; instead carry aliases, including the runtime JavaScript property heap.
    (loop (if (>= (load index) (al-len [i64] (load active)))
              (break)
              (do
                (al-set! [i64]
                         (mut active)
                         (load index)
                         (al-get [i64]
                                 (load (load (field context aliases)))
                                 (al-get [i64] (load active) (load index))))
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (al-len [i64] (load (field context dynamic-aliases))))
              (break)
              (do
                (let [alias (al-get [i64] (load (field context dynamic-aliases)) (load index))]
                  (if (fng-list-has active alias) 0 (al-push! [i64] (mut active) alias)))
                (store! index (+ (load index) 1)))))
    0))

(defn fng-if [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        condition-node (ts-child ast node 0)
        then-node (ts-child ast node 1)
        else-node (if (> (ts-child-count ast node) 2) (ts-child ast node 2) -1)
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut answer) true]
    (fng-assigned! frontend then-node (mut changed))
    (if (!= else-node -1) (fng-assigned! frontend else-node (mut changed)) 0)
    (fng-record-dynamic-alias! context JS-PROPERTY-ALIAS)
    (fng-active-memory! context (mut active))
    (fng-control-aliases! context (mut active))
    ;; Condition evaluation may itself contain calls, assignments, or short-circuit control.
    ;; Both branch snapshots and the outer If must begin after those effects have completed.
    (let [condition (fng-condition-expression context condition-node)
          condition-ctrl (load (load (field context ctrl)))
          saved-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))
          arms (n-if-arms! (fng-peep (n-new2 OP-IF 0 condition-ctrl condition)))]
      (store! (load (field context ctrl)) (arms-t arms))
      (let [then-continues (fng-statement context then-node)
            then-ctrl (if then-continues (load (load (field context ctrl))) NO-NODE)
            then-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
        (fng-restore-snapshot! context (mut changed) (mut active) (mut snapshots) saved-start)
        (store! (load (field context ctrl)) (arms-f arms))
        (let [else-continues (if (= else-node -1) true (fng-statement context else-node))
              else-ctrl (if else-continues (load (load (field context ctrl))) NO-NODE)
              else-start (fng-snapshot! context (mut changed) (mut active) (mut snapshots))]
          (store! answer
                  (fng-merge-snapshots! context
                                        then-ctrl then-start
                                        else-ctrl else-start
                                        (mut changed) (mut active) (mut snapshots))))))
    (al-free! [i64] (mut changed))
    (al-free! [i64] (mut active))
    (al-free! [i64] (mut snapshots))
    (load answer)))

(defn fng-loop [(context FngContext)
                (condition-node i64)
                (body-node i64)
                (increment-node i64)
                (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        (mut carried) (al-new [i64] (malloc-allocator))
        (mut phis) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        loop-node (n-new OP-LOOP 0)
        (mut index) 0]
    (fng-assigned! frontend body-node (mut carried))
    (if (!= increment-node -1) (fng-assigned! frontend increment-node (mut carried)) 0)
    (fng-assigned! frontend condition-node (mut carried))
    (let [target-index (fng-push-target! context label-node true true (mut carried))]
      (n-add-def! loop-node NO-NODE)
      (n-add-def! loop-node (load (load (field context ctrl))))
      (n-add-def! loop-node NO-NODE)
      (if (or (fng-node-has-kind frontend body-node TSK-BREAK)
              (fng-node-has-kind frontend body-node TSK-CONTINUE))
          (fng-active-memory! context (mut active))
          0)
      (store! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [field-index (al-get [i64] (load active) (load index))
                      alias (al-get [i64] (load (load (field context aliases))) field-index)
                      phi (n-new OP-PHI (t-mem-alias alias (t-undef)))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-current-memory context alias))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut memory-phis) phi)
                  (store! index (+ (load index) 1)))))
      (if (> (al-len [i64] (load memory-phis)) 0)
          (store! (load (field context memory)) (fng-merge memory-phis))
          0)
      ;; Phi nodes are allocated first, then initialized in source assignment order.
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (do
                  (let [symbol (al-get [i64] (load carried) (load index))
                        phi (n-new OP-PHI (fng-symbol-coil-type context symbol))]
                    (al-push! [i64] (mut phis) phi))
                  (store! index (+ (load index) 1)))))
      (store! index 0)
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (let [symbol (al-get [i64] (load carried) (load index))
                      phi (al-get [i64] (load phis) (load index))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-symbol-node context symbol))
                  (n-add-def! phi NO-NODE)
                  (fng-set-symbol! context symbol phi)
                  (store! index (+ (load index) 1)))))
      (store! (load (field context ctrl)) loop-node)
      (let [condition (fng-condition-expression context condition-node)
            arms (n-if-arms! (fng-peep (n-new2 OP-IF 0 loop-node condition)))]
        (store! (load (field context ctrl)) (arms-t arms))
        (let [body-continues (fng-statement context body-node)
              reaches-increment (fng-merge-target! context target-index FNG-JUMP-CONTINUE body-continues)]
          (if (and reaches-increment (!= increment-node -1)) (fng-expression context increment-node) 0)
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (let [symbol (al-get [i64] (load carried) (load index))
                          phi (al-get [i64] (load phis) (load index))]
                      (n-set-def! phi 2 (fng-symbol-node context symbol))
                      (store! index (+ (load index) 1)))))
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load active)))
                    (break)
                    (let [field-index (al-get [i64] (load active) (load index))
                          alias (al-get [i64] (load (load (field context aliases))) field-index)]
                      (n-set-def! (al-get [i64] (load memory-phis) (load index))
                                  2
                                  (fng-current-memory context alias))
                      (store! index (+ (load index) 1)))))
          (n-set-def! loop-node 2 (if reaches-increment (load (load (field context ctrl))) NO-NODE))
          (if (not (load (fng-optimize-ptr)))
              (let [(mut reset-index) 0]
                (n-set-ty! loop-node (t-top))
                (loop (if (>= (load reset-index) (al-len [i64] (load phis)))
                          (break)
                          (do
                            (n-set-ty! (al-get [i64] (load phis) (load reset-index)) (t-top))
                            (store! reset-index (+ (load reset-index) 1))))))
              0)
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (do
                      (fng-set-symbol! context
                                       (al-get [i64] (load carried) (load index))
                                       (al-get [i64] (load phis) (load index)))
                      (store! index (+ (load index) 1)))))
          (store! (load (field context ctrl)) (arms-f arms))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK true)]
            (fng-pop-target! context target-index)
            (al-free! [i64] (mut carried))
            (al-free! [i64] (mut phis))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut memory-phis))
            continues))))))

(defn fng-do-loop [(context FngContext) (body-node i64) (condition-node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        (mut carried) (al-new [i64] (malloc-allocator))
        (mut phis) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut memory-phis) (al-new [i64] (malloc-allocator))
        loop-node (n-new OP-LOOP 0)
        (mut index) 0]
    (fng-assigned! frontend body-node (mut carried))
    (fng-assigned! frontend condition-node (mut carried))
    (let [target-index (fng-push-target! context label-node true true (mut carried))]
      (n-add-def! loop-node NO-NODE)
      (n-add-def! loop-node (load (load (field context ctrl))))
      (n-add-def! loop-node NO-NODE)
      (fng-active-memory! context (mut active))
      (store! index 0)
      (loop (if (>= (load index) (al-len [i64] (load active)))
                (break)
                (let [field-index (al-get [i64] (load active) (load index))
                      alias (al-get [i64] (load (load (field context aliases))) field-index)
                      phi (n-new OP-PHI (t-mem-alias alias (t-undef)))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-current-memory context alias))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut memory-phis) phi)
                  (store! index (+ (load index) 1)))))
      (if (> (al-len [i64] (load memory-phis)) 0)
          (store! (load (field context memory)) (fng-merge memory-phis))
          0)
      (loop (if (>= (load index) (al-len [i64] (load carried)))
                (break)
                (let [symbol (al-get [i64] (load carried) (load index))
                      phi (n-new OP-PHI (fng-symbol-coil-type context symbol))]
                  (n-add-def! phi loop-node)
                  (n-add-def! phi (fng-symbol-node context symbol))
                  (n-add-def! phi NO-NODE)
                  (al-push! [i64] (mut phis) phi)
                  (fng-set-symbol! context symbol phi)
                  (store! index (+ (load index) 1)))))
      (store! (load (field context ctrl)) loop-node)
      (let [body-continues (fng-statement context body-node)
            reaches-condition (fng-merge-target! context target-index FNG-JUMP-CONTINUE body-continues)]
        (let [condition
                (if reaches-condition
                    (fng-condition-expression context condition-node)
                    (fng-const 0))
              arms (n-if-arms! (fng-peep (n-new2 OP-IF 0 (load (load (field context ctrl))) condition)))]
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load carried)))
                    (break)
                    (let [symbol (al-get [i64] (load carried) (load index))
                          phi (al-get [i64] (load phis) (load index))]
                      (n-set-def! phi 2 (fng-symbol-node context symbol))
                      (store! index (+ (load index) 1)))))
          (store! index 0)
          (loop (if (>= (load index) (al-len [i64] (load active)))
                    (break)
                    (let [field-index (al-get [i64] (load active) (load index))
                          alias (al-get [i64] (load (load (field context aliases))) field-index)]
                      (n-set-def! (al-get [i64] (load memory-phis) (load index))
                                  2
                                  (fng-current-memory context alias))
                      (store! index (+ (load index) 1)))))
          (n-set-def! loop-node 2 (arms-t arms))
          (if (not (load (fng-optimize-ptr)))
              (let [(mut reset-index) 0]
                (n-set-ty! loop-node (t-top))
                (loop (if (>= (load reset-index) (al-len [i64] (load phis)))
                          (break)
                          (do
                            (n-set-ty! (al-get [i64] (load phis) (load reset-index)) (t-top))
                            (store! reset-index (+ (load reset-index) 1))))))
              0)
          (store! (load (field context ctrl)) (arms-f arms))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK reaches-condition)]
            (fng-pop-target! context target-index)
            (al-free! [i64] (mut carried))
            (al-free! [i64] (mut phis))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut memory-phis))
            continues))))))

(defn fng-switch [(context FngContext) (node i64) (label-node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        case-block (ts-role ast node TS-ROLE-CLAUSE 0)
        clause-count (ts-child-count ast case-block)
        discriminant (fng-expression context (ts-role ast node TS-ROLE-EXPRESSION 0))
        (mut changed) (al-new [i64] (malloc-allocator))
        (mut active) (al-new [i64] (malloc-allocator))
        (mut snapshots) (al-new [i64] (malloc-allocator))
        (mut entry-ctrls) (al-new [i64] (malloc-allocator))
        (mut entry-starts) (al-new [i64] (malloc-allocator))
        (mut index) 0
        (mut default-index) -1]
    (fng-assigned! frontend node (mut changed))
    (fng-active-memory! context (mut active))
    (loop (if (>= (load index) clause-count)
              (break)
              (do
                (al-push! [i64] (mut entry-ctrls) NO-NODE)
                (al-push! [i64] (mut entry-starts) -1)
                (store! index (+ (load index) 1)))))
    (let [target-index (fng-push-target! context label-node true false (mut changed))]
      ;; Ordered case-test chain. Default is selected only if every case test fails.
      (store! index 0)
      (loop (if (>= (load index) clause-count)
                (break)
                (let [clause (ts-role ast case-block TS-ROLE-CLAUSE (load index))
                      kind (ts-kind ast clause)]
                  (if (= kind TSK-DEFAULT-CLAUSE)
                      (store! default-index (load index))
                      (let [case-value (fng-expression context (ts-role ast clause TS-ROLE-EXPRESSION 0))
                            arms
                              (n-if-arms! (fng-peep (n-new2 OP-IF
                                                            0
                                                            (load (load (field context ctrl)))
                                                            (fng-equal-value
                                                              context
                                                              (ts-role ast node TS-ROLE-EXPRESSION 0)
                                                              discriminant
                                                              (ts-role ast clause TS-ROLE-EXPRESSION 0)
                                                              case-value))))]
                        (al-set! [i64] (mut entry-ctrls) (load index) (arms-t arms))
                        (al-set! [i64]
                                 (mut entry-starts)
                                 (load index)
                                 (fng-snapshot! context changed active (mut snapshots)))
                        (store! (load (field context ctrl)) (arms-f arms))))
                  (store! index (+ (load index) 1)))))
      (let [no-match-ctrl (load (load (field context ctrl)))
            no-match-start (fng-snapshot! context changed active (mut snapshots))
            (mut fall-ctrl) NO-NODE
            (mut fall-start) -1]
        (if (!= (load default-index) -1)
            (do
              (al-set! [i64] (mut entry-ctrls) (load default-index) no-match-ctrl)
              (al-set! [i64] (mut entry-starts) (load default-index) no-match-start))
            0)
        ;; Clause bodies are lowered in source order. The selected entry and previous fallthrough
        ;; are explicit peers at each clause head.
        (store! index 0)
        (loop (if (>= (load index) clause-count)
                  (break)
                  (let [clause (ts-role ast case-block TS-ROLE-CLAUSE (load index))
                        entry-ctrl (al-get [i64] (load entry-ctrls) (load index))
                        entry-start (al-get [i64] (load entry-starts) (load index))
                        reaches
                          (fng-merge-snapshots! context
                                                entry-ctrl
                                                entry-start
                                                (load fall-ctrl)
                                                (load fall-start)
                                                changed
                                                active
                                                snapshots)
                        first (if (= (ts-kind ast clause) TSK-CASE-CLAUSE) 1 0)
                        (mut child) first
                        (mut continues) reaches]
                    (loop (if (or (not (load continues))
                                  (>= (load child) (ts-child-count ast clause)))
                              (break)
                              (do
                                (store! continues
                                        (fng-statement context (ts-child ast clause (load child))))
                                (store! child (+ (load child) 1)))))
                    (if (load continues)
                        (do
                          (store! fall-ctrl (load (load (field context ctrl))))
                          (store! fall-start (fng-snapshot! context changed active (mut snapshots))))
                        (do (store! fall-ctrl NO-NODE) (store! fall-start -1)))
                    (store! index (+ (load index) 1)))))
        (let [(mut normal) false]
          (if (= (load default-index) -1)
              (store! normal
                      (fng-merge-snapshots! context
                                            no-match-ctrl
                                            no-match-start
                                            (load fall-ctrl)
                                            (load fall-start)
                                            changed
                                            active
                                            snapshots))
              (if (!= (load fall-ctrl) NO-NODE)
                  (do
                    (store! (load (field context ctrl)) (load fall-ctrl))
                    (fng-restore-snapshot! context changed active snapshots (load fall-start))
                    (store! normal true))
                  0))
          (let [continues (fng-merge-target! context target-index FNG-JUMP-BREAK (load normal))]
            (fng-pop-target! context target-index)
            (al-free! [i64] (mut changed))
            (al-free! [i64] (mut active))
            (al-free! [i64] (mut snapshots))
            (al-free! [i64] (mut entry-ctrls))
            (al-free! [i64] (mut entry-starts))
            continues))))))

(defn fng-labeled-block [(context FngContext) (statement i64) (label i64)] (-> bool)
  (let [frontend (load (field context frontend))
        (mut assigned) (al-new [i64] (malloc-allocator))]
    (fng-assigned! frontend statement (mut assigned))
    (let [target-index (fng-push-target! context label true false (mut assigned))
          normal (fng-statement context statement)
          answer (fng-merge-target! context target-index FNG-JUMP-BREAK normal)]
      (fng-pop-target! context target-index)
      (al-free! [i64] (mut assigned))
      answer)))

(defn fng-variable-declaration! [(context FngContext) (node i64)] (-> i64)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        count (ts-child-count ast node)
        name (ts-child-of-kind ast node TSK-IDENTIFIER)
        value-node (if (> count 1) (ts-child ast node (- count 1)) -1)
        has-value (and (!= value-node -1) (!= value-node name))
        symbol (fe-symbol-for-declaration frontend node (load (field context owner)))
        declared (fng-declared-symbol-type frontend symbol)
        value (if has-value
                  (fng-expression-expected context value-node declared)
                  (fng-symbol-node context symbol))]
    (if has-value
        (do
          (fng-set-symbol! context symbol value)
          (fng-set-symbol-type! context symbol (fng-infer context value-node declared)))
        0)
    value))

(defn fng-initialize-locals! [(context FngContext)] (-> i64)
  (let [frontend (load (field context frontend))
        owner (load (field context owner))
        (mut index) 0]
    (loop (if (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (and (= (load (field symbol owner)) owner)
                         (and (= (load (field symbol role)) FE-ROLE-LOCAL)
                              (let [declaration (load (field symbol node))
                                    name (load (field symbol name-node))]
                                (and (= (ts-child-count (field frontend ast) declaration) 1)
                                     (= (ts-child (field frontend ast) declaration 0) name)))))
                    (do
                      (fng-set-symbol! context (load (field symbol id)) (fng-undefined))
                      (fng-set-symbol-type! context (load (field symbol id)) FNG-VOID))
                    0)
                (store! index (+ (load index) 1)))))
    0))

(defn fng-statement [(context FngContext) (node i64)] (-> bool)
  (let [frontend (load (field context frontend))
        ast (field frontend ast)
        kind (ts-kind ast node)]
    (cond (= kind TSK-BLOCK)
            (let [(mut index) 0
                  (mut continues) true]
              (loop (if (or (>= (load index) (ts-child-count ast node)) (not (load continues)))
                        (break)
                        (do
                          (store! continues (fng-statement context (ts-child ast node (load index))))
                          (store! index (+ (load index) 1)))))
              (load continues))
          (= kind TSK-VARIABLE-STATEMENT)
            (let [list (ts-child ast node 0)
                  (mut declaration-index) 0]
              (loop (if (>= (load declaration-index) (ts-child-count ast list))
                        (break)
                        (do
                          (fng-variable-declaration! context
                                                     (ts-child ast list (load declaration-index)))
                          (store! declaration-index (+ (load declaration-index) 1)))))
              true)
          (= kind TSK-EXPRESSION-STATEMENT) (do (fng-expression context (ts-child ast node 0)) true)
          (= kind TSK-IF) (fng-if context node)
          (= kind TSK-DO)
            (fng-do-loop context
                         (ts-role ast node TS-ROLE-STATEMENT 0)
                         (ts-role ast node TS-ROLE-CONDITION 0)
                         -1)
          (= kind TSK-WHILE) (fng-loop context (ts-child ast node 0) (ts-child ast node 1) -1 -1)
          (= kind TSK-FOR)
            (let [count (ts-child-count ast node)
                  initialize (ts-child ast node 0)
                  condition (ts-child ast node 1)
                  increment (ts-child ast node 2)
                  body (ts-child ast node (- count 1))]
              (fng-statement context initialize)
              (fng-loop context condition body increment -1))
          (= kind TSK-SWITCH) (fng-switch context node -1)
          (= kind TSK-VARIABLE-DECLARATION-LIST) (do (fng-statement context (ts-child ast node 0)) true)
          (= kind TSK-BREAK) (do (fng-capture-jump! context node FNG-JUMP-BREAK) false)
          (= kind TSK-CONTINUE) (do (fng-capture-jump! context node FNG-JUMP-CONTINUE) false)
          (= kind TSK-LABELED)
            (let [statement (ts-role ast node TS-ROLE-STATEMENT 0)
                  label (ts-role ast node TS-ROLE-LABEL 0)]
              (cond (= (ts-kind ast statement) TSK-DO)
                      (fng-do-loop context
                                   (ts-role ast statement TS-ROLE-STATEMENT 0)
                                   (ts-role ast statement TS-ROLE-CONDITION 0)
                                   label)
                    (= (ts-kind ast statement) TSK-WHILE)
                      (fng-loop context
                                (ts-child ast statement 0)
                                (ts-child ast statement 1)
                                -1
                                label)
                    (= (ts-kind ast statement) TSK-FOR)
                      (let [count (ts-child-count ast statement)
                            initialize (ts-child ast statement 0)
                            condition (ts-child ast statement 1)
                            increment (ts-child ast statement 2)
                            body (ts-child ast statement (- count 1))]
                        (fng-statement context initialize)
                        (fng-loop context condition body increment label))
                    (= (ts-kind ast statement) TSK-SWITCH) (fng-switch context statement label)
                    (= (ts-kind ast statement) TSK-SWITCH) (fng-switch context statement label)
                    :else (fng-labeled-block context statement label)))
          (= kind TSK-VARIABLE-DECLARATION)
            (do (fng-variable-declaration! context node) true)
          (= kind TSK-RETURN)
            (let [fn
                    (al-get [FeFunction]
                            (load (field frontend functions))
                            (fng-function-index frontend (load (field context owner))))
                  expected (fng-type-tag frontend (load (field fn result-node)))]
              (fng-add-return! context (fng-expression-expected context (ts-child ast node 0) expected))
              false)
          (= kind TSK-THROW)
            (do
              (fng-add-return! context (n-js-throw! (n-box! (fng-expression context (ts-child ast node 0)))))
              false)
          :else false)))

(defn fng-node-has-kind [(frontend (ptr NativeFrontend)) (node i64) (wanted i64)] (-> bool)
  (let [ast (field frontend ast)
        (mut index) 0
        (mut found) (= (ts-kind ast node) wanted)]
    (loop (if (or (load found) (>= (load index) (ts-child-count ast node)))
              (break)
              (do
                (store! found (fng-node-has-kind frontend (ts-child ast node (load index)) wanted))
                (store! index (+ (load index) 1)))))
    (load found)))

(defn fng-node-accesses-type? [(frontend (ptr NativeFrontend)) (node i64) (owner i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        type (al-get [FeTypeDecl] (load (field frontend types)) owner)
        (mut found) false
        (mut i) 0]
    (if (= kind TSK-PROPERTY-ACCESS)
        (let [property (ts-child ast node 1)]
          (loop (if (or (load found) (>= (load i) (load (field type field-count))))
                    (break)
                    (let [field-index (+ (load (field type field-start)) (load i))]
                      (if (str-eq (ts-text ast property) (fe-field-name frontend field-index))
                          (store! found true)
                          0)
                      (store! i (+ (load i) 1))))))
        0)
    (store! i 0)
    (loop (if (or (load found) (>= (load i) (ts-child-count ast node)))
              (break)
              (do
                (store! found (fng-node-accesses-type? frontend (ts-child ast node (load i)) owner))
                (store! i (+ (load i) 1)))))
    (load found)))

(defn fng-node-calls-effect [(frontend (ptr NativeFrontend))
                             (effects (ptr (ArrayList bool)))
                             (type-count i64)
                             (node i64)
                             (owner i64)] (-> bool)
  (let [ast (field frontend ast)
        kind (ts-kind ast node)
        (mut found) false
        (mut index) 0]
    (if (or (= kind TSK-CALL) (= kind TSK-NEW-EXPRESSION))
        (let [callee-node (ts-child ast node 0)
              callee
                (if (= (ts-kind ast callee-node) TSK-PROPERTY-ACCESS)
                    (fe-find-function-name frontend (ts-child ast callee-node 1))
                    (fe-resolution-symbol frontend callee-node))]
          (if (>= callee 0)
              (store! found (al-get [bool] (load effects) (+ (* callee type-count) owner)))
              0))
        0)
    (loop (if (or (load found) (>= (load index) (ts-child-count ast node)))
              (break)
              (do
                (store! found
                        (fng-node-calls-effect frontend
                                               effects
                                               type-count
                                               (ts-child ast node (load index))
                                               owner))
                (store! index (+ (load index) 1)))))
    (load found)))

(defn fng-compute-effects! [(frontend (ptr NativeFrontend)) (effects (mut (ArrayList bool)))] (-> i64)
  (let [function-count (al-len [FeFunction] (load (field frontend functions)))
        type-count (al-len [FeTypeDecl] (load (field frontend types)))
        (mut fi) 0
        (mut ti) 0
        (mut changed) true]
    (loop (if (>= (load fi) function-count)
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load fi))
                    result-owner (fe-type-index-for-node frontend (load (field fn result-node)))]
                (if (and (>= result-owner 0)
                         (fng-node-has-kind frontend (load (field fn body-node)) TSK-OBJECT-LITERAL))
                    (al-set! [bool] (mut effects) (+ (* (load (field fn id)) type-count) result-owner) true)
                    0)
                (store! ti 0)
                (loop (if (>= (load ti) type-count)
                          (break)
                          (do
                            (if (fng-node-accesses-type? frontend (load (field fn body-node)) (load ti))
                                (al-set! [bool]
                                         (mut effects)
                                         (+ (* (load (field fn id)) type-count) (load ti))
                                         true)
                                0)
                            (store! ti (+ (load ti) 1)))))
                (store! fi (+ (load fi) 1)))))
    (loop (if (not (load changed))
              (break)
              (do
                (store! changed false)
                (store! fi 0)
                (loop (if (>= (load fi) function-count)
                          (break)
                          (let [fn (al-get [FeFunction] (load (field frontend functions)) (load fi))]
                            (store! ti 0)
                            (loop (if (>= (load ti) type-count)
                                      (break)
                                      (let [slot (+ (* (load (field fn id)) type-count) (load ti))]
                                        (if (and (not (al-get [bool] (load effects) slot))
                                                 (fng-node-calls-effect frontend
                                                                        effects
                                                                        type-count
                                                                        (load (field fn body-node))
                                                                        (load ti)))
                                            (do (al-set! [bool] (mut effects) slot true) (store! changed true))
                                            0)
                                        (store! ti (+ (load ti) 1)))))
                            (store! fi (+ (load fi) 1)))))))
      0)))

(defn fng-build-layouts! [(frontend (ptr NativeFrontend))
                          (shapes (mut (ArrayList i64)))
                          (aliases (mut (ArrayList i64)))] (-> i64)
  (let [(mut ti) 0
        (mut fi) 0]
    (loop (if (>= (load ti) (al-len [FeTypeDecl] (load (field frontend types))))
              (break)
              (let [type (al-get [FeTypeDecl] (load (field frontend types)) (load ti))
                    (mut shape) SHAPE-ROOT]
                (store! fi 0)
                (loop (if (>= (load fi) (load (field type field-count)))
                          (break)
                          (let [field-index (+ (load (field type field-start)) (load fi))
                                field-value (al-get [FeField] (load (field frontend fields)) field-index)]
                            (store! shape
                                    (shape-transition (load shape)
                                                      (fe-field-name frontend field-index)
                                                      (fng-field-coil-type
                                                        frontend
                                                        shapes
                                                        (load (field field-value type-node)))))
                            (store! fi (+ (load fi) 1)))))
                (al-push! [i64] (mut shapes) (load shape))
                (store! fi 0)
                (loop (if (>= (load fi) (load (field type field-count)))
                          (break)
                          (do
                            (al-push! [i64] (mut aliases) (shape-field-alias (load shape) (load fi)))
                            (store! fi (+ (load fi) 1)))))
                (store! ti (+ (load ti) 1)))))
    0))

(defn fng-compile-function! [(frontend (ptr NativeFrontend))
                             (values (mut (ArrayList i64)))
                             (value-types (mut (ArrayList i64)))
                             (functions (mut (ArrayList i64)))
                             (prototypes (mut (ArrayList i64)))
                             (shapes (mut (ArrayList i64)))
                             (aliases (mut (ArrayList i64)))
                             (effects (mut (ArrayList bool)))
                             (type-count i64)
                             (cell-shape i64)
                             (cell-alias i64)
                             (function-index i64)
                             (top-level bool)] (-> i64)
  (let [fn (al-get [FeFunction] (load (field frontend functions)) function-index)
        fun-id (load (field fn id))
        fun (if top-level NO-NODE (al-get [i64] (load functions) fun-id))
        (mut ctrl) (if top-level (g-start) (n-fun-entry fun))
        (mut memory) NO-NODE
        (mut first-return) NO-NODE
        (mut targets) (al-new [FngTarget] (malloc-allocator))
        (mut target-symbols) (al-new [i64] (malloc-allocator))
        (mut target-active) (al-new [i64] (malloc-allocator))
        (mut jumps) (al-new [FngJump] (malloc-allocator))
        (mut jump-values) (al-new [i64] (malloc-allocator))
        (mut dynamic-aliases) (al-new [i64] (malloc-allocator))
        (mut saved-capture-symbols) (al-new [i64] (malloc-allocator))
        (mut saved-capture-values) (al-new [i64] (malloc-allocator))
        (mut receiver) NO-NODE
        (mut index) 0]
    (if top-level
        0
        (let [capture-count (fng-capture-count frontend fun-id)]
          (loop (if (>= (load index) capture-count)
                    (break)
                    (let [symbol (fng-capture-symbol frontend fun-id (load index))]
                      (al-push! [i64] (mut saved-capture-symbols) symbol)
                      (al-push! [i64]
                                (mut saved-capture-values)
                                (al-get [i64] (load values) symbol))
                      (al-set! [i64] (mut values) symbol (n-parm! fun (load index)))
                      (store! index (+ (load index) 1)))))
          (let [receiver-count (if (= (load (field fn receiver-type-node)) -1) 0 1)]
            (if (= receiver-count 1) (store! receiver (n-parm! fun capture-count)) 0)
            (store! index 0)
            (loop (if (>= (load index) (load (field fn parameter-count)))
                      (break)
                      (let [symbol
                              (al-get [FeSymbol]
                                      (load (field frontend symbols))
                                      (+ (load (field fn parameter-start)) (load index)))]
                        (al-set! [i64]
                                 (mut values)
                                 (load (field symbol id))
                                 (n-parm! fun (+ (+ capture-count receiver-count) (load index))))
                        (store! index (+ (load index) 1))))))))
    (let [context
            (fng-context frontend
                         values
                         value-types
                         functions
                         prototypes
                         shapes
                         aliases
                         effects
                         dynamic-aliases
                         type-count
                         ctrl
                         memory
                         first-return
                         targets
                         target-symbols
                         target-active
                         jumps
                         jump-values
                         cell-shape
                         cell-alias
                         (load receiver)
                         fun-id
                         fun
                         top-level)]
      (fng-initialize-locals! context)
      (if top-level (fng-top-level-initialize! context) 0)
      (let [falls-through (fng-statement context (load (field fn body-node)))]
        (if (and (not top-level) falls-through)
            (fng-add-return! context (fng-undefined))
            0)
        ; An empty JavaScript function still returns undefined. Keep the graph callable even when
        ; an empty/nested body contributed no statement node to the fallthrough calculation.
        (if (and (not top-level) (= (load first-return) NO-NODE))
            (fng-add-return! context (fng-undefined))
            0)))
    (store! index 0)
    (loop (if (>= (load index) (al-len [i64] (load saved-capture-symbols)))
              (break)
              (do
                (al-set! [i64]
                         (mut values)
                         (al-get [i64] (load saved-capture-symbols) (load index))
                         (al-get [i64] (load saved-capture-values) (load index)))
                (store! index (+ (load index) 1)))))
    (al-free! [FngTarget] (mut targets))
    (al-free! [i64] (mut target-symbols))
    (al-free! [i64] (mut target-active))
    (al-free! [FngJump] (mut jumps))
    (al-free! [i64] (mut jump-values))
    (al-free! [i64] (mut dynamic-aliases))
    (al-free! [i64] (mut saved-capture-symbols))
    (al-free! [i64] (mut saved-capture-values))
    0))

(defn frontend-native-build-mode! [(frontend (mut NativeFrontend)) (seed i64) (optimize bool) (analyze bool)] (-> i64)
  (graph-reset! seed)
  (shape-reset!)
  (jss-reset!)
  ;; The JSL runtime library is READ and CHECKED here but nothing is lowered. `jsl-require!` pulls a
  ;; definition and its callees the first time the frontend emits a call to it, so a program that
  ;; uses no library builtin gets exactly the graph it got before this existed — which is what the
  ;; exact-`g-render` migration oracle in tests/frontend-exact-graph-test.mjs compares.
  (jsl-reset!)
  (if (!= (jsl-load-index! "lib/index") JSL-OK)
      (do (panic-corrupt "frontend: the JSL runtime library did not load") 0)
      0)
  (jl-reset!)
  (store! (fng-optimize-ptr) optimize)
  (let [main-index (fng-main-index frontend)
        main (al-get [FeFunction] (load (field frontend functions)) main-index)
        main-id (load (field main id))
        function-count (al-len [FeFunction] (load (field frontend functions)))
        type-count (al-len [FeTypeDecl] (load (field frontend types)))
        symbol-count (+ function-count (al-len [FeSymbol] (load (field frontend symbols))))
        (mut values) (al-new [i64] (malloc-allocator))
        (mut value-types) (al-new [i64] (malloc-allocator))
        (mut functions) (al-new [i64] (malloc-allocator))
        (mut prototypes) (al-new [i64] (malloc-allocator))
        (mut shapes) (al-new [i64] (malloc-allocator))
        (mut aliases) (al-new [i64] (malloc-allocator))
        (mut effects) (al-new [bool] (malloc-allocator))
        (mut cell-shape) SHAPE-ROOT
        (mut cell-alias) 0
        (mut index) 0]
    (loop (if (>= (load index) symbol-count)
              (break)
              (do
                (al-push! [i64] (mut values) NO-NODE)
                (al-push! [i64] (mut value-types) FNG-DYNAMIC)
                (store! index (+ (load index) 1)))))
    ;; Install declared parameter/local types without creating graph nodes.
    (store! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (al-set! [i64]
                         (mut value-types)
                         (load (field symbol id))
                         (fng-type-tag frontend (load (field symbol type-node))))
                (store! index (+ (load index) 1)))))
    (fng-initialize-static-globals! frontend (mut values) (mut value-types))
    (store! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (do
                (al-push! [i64] (mut functions) NO-NODE)
                (al-push! [i64] (mut prototypes) NO-NODE)
                (store! index (+ (load index) 1)))))
    (store! index 0)
    (loop (if (>= (load index) (* function-count type-count))
              (break)
              (do (al-push! [bool] (mut effects) false) (store! index (+ (load index) 1)))))
    (fng-compute-effects! frontend (mut effects))
    ;; Shapes and aliases precede every graph function binding.
    (fng-build-layouts! frontend (mut shapes) (mut aliases))
    (if (> (al-len [FeCapture] (load (field frontend captures))) 0)
        (do
          (store! cell-shape (shape-transition SHAPE-ROOT "__closure_cell" (t-dyn)))
          (store! cell-alias (shape-field-alias (load cell-shape) 0)))
        0)
    ;; All non-main function roots are opened before main Args and before bodies.
    (store! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load index))]
                (if (!= (load (field fn id)) main-id)
                    (al-set! [i64] (mut functions) (load (field fn id)) (n-fun-open! (load (field fn id))))
                    0)
                (store! index (+ (load index) 1)))))
    ;; Main Args are created immediately after the function roots.
    (store! index 0)
    (loop (if (>= (load index) (load (field main parameter-count)))
              (break)
              (let [symbol
                      (al-get [FeSymbol]
                              (load (field frontend symbols))
                              (+ (load (field main parameter-start)) (load index)))]
                (al-set! [i64]
                         (mut values)
                         (load (field symbol id))
                         (n-new1 OP-ARG
                                 (fng-coil-type frontend shapes (load (field symbol type-node)))
                                 (g-start)))
                (store! index (+ (load index) 1)))))
    ;; Bodies retain source declaration order, excluding main until the end.
    (store! index 0)
    (loop (if (>= (load index) function-count)
              (break)
              (let [fn (al-get [FeFunction] (load (field frontend functions)) (load index))]
                (if (!= (load (field fn id)) main-id)
                    (do
                      (fng-compile-function! frontend
                                             (mut values)
                                             (mut value-types)
                                             (mut functions)
                                             (mut prototypes)
                                             (mut shapes)
                                             (mut aliases)
                                             (mut effects)
                                             type-count
                                             (load cell-shape)
                                             (load cell-alias)
                                             (load index)
                                             false)
                      ; Prototype allocations are ordinary runtime values owned by
                      ; the function control that created them. Do not leak one
                      ; function's lazy materialization into another CFG owner.
                      (let [(mut prototype-index) 0]
                        (loop (if (>= (load prototype-index) function-count)
                                  (break)
                                  (do
                                    (al-set! [i64] (mut prototypes)
                                             (load prototype-index) NO-NODE)
                                    (store! prototype-index
                                            (+ (load prototype-index) 1))))))
                      0)
                    0)
                (store! index (+ (load index) 1)))))
    ;; Nested capture parameters temporarily reuse the captured symbol's global slot while their
    ;; body is built. Parent locals must begin at NO-NODE when their own declarations execute.
    (store! index 0)
    (loop (if (>= (load index) (al-len [FeSymbol] (load (field frontend symbols))))
              (break)
              (let [symbol (al-get [FeSymbol] (load (field frontend symbols)) (load index))]
                (if (and (= (load (field symbol owner)) main-id)
                         (= (load (field symbol role)) FE-ROLE-LOCAL))
                    (al-set! [i64] (mut values) (load (field symbol id)) NO-NODE)
                    0)
                (store! index (+ (load index) 1)))))
    (fng-compile-function! frontend
                           (mut values)
                           (mut value-types)
                           (mut functions)
                           (mut prototypes)
                           (mut shapes)
                           (mut aliases)
                           (mut effects)
                           type-count
                           (load cell-shape)
                           (load cell-alias)
                           main-index
                           true)
    (fng-distribute-deferred-phi-boxes!)
    (if analyze (do (fng-discard-memory-scaffolding!) (fng-analyze-fresh!)) 0)
    (fng-discard-unused!)
    (let [first (al-get [FeSymbol] (load (field frontend symbols)) (load (field main parameter-start)))
          answer
            (if (> (load (field main parameter-count)) 0)
                (al-get [i64] (load values) (load (field first id)))
                NO-NODE)]
      (al-free! [i64] (mut values))
      (al-free! [i64] (mut value-types))
      (al-free! [i64] (mut functions))
      (al-free! [i64] (mut prototypes))
      (al-free! [i64] (mut shapes))
      (al-free! [i64] (mut aliases))
      (al-free! [bool] (mut effects))
      answer)))

(defn frontend-native-build! [(frontend (mut NativeFrontend)) (seed i64) (optimize bool)] (-> i64)
  (frontend-native-build-mode! (mut frontend) seed optimize true))
