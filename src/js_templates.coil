;; THE JAVASCRIPT THE FUZZER WRITES, described once.
;;
;; An `Op` chooses a language subsystem and its payload chooses values; `js-emit-feature!` turns
;; that into one self-contained TypeScript block. Every block starts and ends with an integer
;; accumulator, so any sequence of any blocks is a valid program and no rejection filter is
;; needed -- which is the property that lets both consumers below splice blocks freely.
;;
;; TWO CONSUMERS, AND THAT IS WHY THIS IS NOT IN THE TEST FILE. `tests/js-source-prop.coil` runs
;; these programs as a `defprop`, generating opcodes and shrinking a counterexample.
;; `tools/js-sweep.coil` runs them as an exhaustive matrix instead -- every op, every pair of ops --
;; and catalogues everything that fails rather than shrinking to one thing. They must emit the
;; SAME language or the catalogue would describe a dialect the property never runs.
;;
;; EVERY BODY HERE WAS RUN AGAINST NODE BEFORE IT WAS ADDED. That matters more here than anywhere
;; else: these blocks compose, so with eight steps drawn from ninety-odd variants a single body the
;; frontend cannot lower poisons about 8% of all generated cases, the shrinker converges on it, and
;; the property reports that one known failure for ever instead of exploring. A body that belongs
;; here is one that (a) node and the frontend already agree on, and (b) reads and writes only the
;; integer accumulator, so it composes with every other body unconditionally.
;;
;; See docs/FUZZ-FINDINGS.md for what a template was bent around, and when it was straightened.
(module jstemplates)

(import "ty" :use *)
(import "node" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.slice" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.str" :use *)

;; Eight statements keeps the emitted source well inside the buffer and the case fast.
(const JS-MAX-OPS i64 8)

;; ONLY `+` AND `-`, and the omission is the whole reason this property can compare anything.
;; JavaScript's `&`, `|` and `^` are int32 operators: they run ToInt32 on both operands and yield a
;; signed 32-bit result. The IR's bitwise nodes do not. Generating them would produce a disagreement
;; on every wide value and report the language's own semantics as a compiler bug.
(defn js-op-add? [(b i64)] (-> bool)
  (= (% b 2) 0))

;; Does this step use a fresh constant, or an earlier variable?
(defn js-uses-const? [(b i64)] (-> bool)
  (= (% (/ b 4) 2) 0))

(defn js-const-of [(b i64)] (-> i64)
  (+ 1 (% (/ b 8) 7)))

(defn js-var-of [(b i64) (n i64)] (-> i64)
  (% (/ b 8) n))

(defn js-limit [(ops (slice u8))] (-> i64)
  (if (> (slice-len ops) JS-MAX-OPS) JS-MAX-OPS (slice-len ops)))

;; ---------------------------------------------------------------------------
;; Backend 1: TypeScript source
;; ---------------------------------------------------------------------------
(defn lift-js! [(ops (slice u8)) (buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (alloc/stack FixBuf)
        w (alloc/stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ps w "function main(n: number): number {\n")
    ;; v0 seeds from the parameter so the argument is always live.
    (ps w "  let v0 = n + 3;\n")
    (let [(mut k) 0
          limit (js-limit ops)]
      (loop (if (>= (load k) limit)
                (break)
                (let [b (cast i64 (slice-get ops (load k)))
                      cur (+ (load k) 1)]
                  (fmt w "  let v{d} = v{d} " cur (load k))
                  (ps w (if (js-op-add? b) "+ " "- "))
                  (if (js-uses-const? b)
                      (fmt w "{d};\n" (js-const-of b))
                      (fmt w "v{d};\n" (js-var-of b cur)))
                  (set! k (+ (load k) 1))
                  0)))
      (fmt w "  return v{d};\n" (js-limit ops))
      (ps w "}\n"))
    (let [n (.len fb)]
      (if (>= n cap)
          (do (fmt (stderr) "lift-js!: source did not fit the buffer\n") (abort) 0)
          0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

;; ---------------------------------------------------------------------------
;; Op-driven program description
;; ---------------------------------------------------------------------------
;; Keep this conversion explicit and exhaustive in shape.  Arbitrary generates the full `Op` sum,
;; including payloads; operations outside the exact-integer subset are deterministically projected
;; onto it rather than rejected, so every generated case remains a useful program and shrinking
;; never falls out of the valid language.
(defn js-exact-op [(op Op)] (-> Op)
  (match op
    (Add [] (Add))
    (Sub [] (Sub))
    (Mul [] (Mul))
    (_ (let [tag (op-encode-tag op)]
         (if (= (% tag 3) 0)
             (Add)
             (if (= (% tag 3) 1) (Sub) (Mul)))))))

(defn js-op-token [(op Op)] (-> (slice u8))
  (match (js-exact-op op)
    (Add [] "+ ")
    (Sub [] "- ")
    (Mul [] "* ")
    (_ "+ ")))

(defn js-mul-op? [(op Op)] (-> bool)
  (match (js-exact-op op) (Mul [] true) (_ false)))

(defn js-op-list-limit [(ops (ArrayList Op))] (-> i64)
  (if (> (al-len [Op] ops) JS-MAX-OPS) JS-MAX-OPS (al-len [Op] ops)))

(defn js-needs-prototype? [(ops (ArrayList Op))] (-> bool)
  (let [limit (js-op-list-limit ops)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) limit) (load found))
              (break)
              (do
                (if (match (al-get [Op] ops (load i))
                      (SetProto [] true)
                      (ProtoHas [] true)
                      (_ false))
                    (set! found true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

;; Operand choice remains a separate arbitrary tape.  Ops choose semantics; these bytes choose
;; graph topology and constants, so coverage guidance can mutate either axis independently.
(defn js-choice [(choices (slice u8)) (k i64)] (-> i64)
  (if (= (slice-len choices) 0)
      k
      (cast i64 (slice-get choices (% k (slice-len choices))))))

(defn lift-js-ops! [(ops (ArrayList Op))
                    (choices (slice u8))
                    (buf (ptr i8))
                    (cap i64)] (-> (slice u8))
  (let [fb (alloc/stack FixBuf)
        w (alloc/stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (ps w "function main(n: number): number {\n")
    (ps w "  let v0 = n + 3;\n")
    (let [(mut k) 0
          limit (js-op-list-limit ops)]
      (loop (if (>= (load k) limit)
                (break)
                (let [b (js-choice choices (load k))
                      cur (+ (load k) 1)]
                  (fmt w "  let v{d} = v{d} " cur (load k))
                  (ps w (js-op-token (al-get [Op] ops (load k))))
                  (if (or (js-mul-op? (al-get [Op] ops (load k))) (js-uses-const? b))
                      (fmt w "{d};\n" (js-const-of b))
                      (fmt w "v{d};\n" (js-var-of b cur)))
                  (set! k (+ (load k) 1))
                  0)))
      (fmt w "  return v{d};\n" limit)
      (ps w "}\n"))
    (let [n (.len fb)]
      (if (>= n cap)
          (do (fmt (stderr) "lift-js-ops!: source did not fit the buffer\n") (abort) 0)
          0)
      (slice-new [u8] (cast (ptr u8) buf) n))))

;; A semantic family for every IR opcode.  This is deliberately a match over the sum rather than
;; arithmetic on serialization tags: adding or changing an Op variant makes the generator's
;; coverage decision a compile-time-visible edit.
(defn js-op-family [(op Op)] (-> i64)
  (match op
    (Add [] 0)
    (Sub [] 0)
    (Mul [] 0)
    (Div [] 0)
    (Mod [] 0)
    (Minus [] 0)
    (Eq [] 1)
    (Lt [] 1)
    (Le [] 1)
    (Not [] 1)
    (If [] 1)
    (Region [] 1)
    (Loop [] 1)
    (BitAnd [] 2)
    (BitOr [] 2)
    (BitXor [] 2)
    (Shl [] 2)
    (Shr [] 2)
    (UShr [] 2)
    (BitNot [] 2)
    (StringConst [_] 3)
    (StringLen [] 3)
    (StringEq [] 3)
    (StringConcat [] 3)
    (StringCharCode [] 3)
    (StringSubstring [_] 3)
    (StringSplit [] 3)
    (StringFromCodeUnit [] 3)
    (StringLower [] 3)
    (StringUpper [] 3)
    (StringIndexOf [] 3)
    (StringCompare [] 3)
    (StringNormalize [] 3)
    (ArrayMark [] 4)
    (ArrayLoad [_] 4)
    (ArrayStore [] 4)
    (ArrayLen [] 4)
    (ArrayResize [] 4)
    (ArrayCopy [] 4)
    (ArrayTest [] 4)
    (ArrayUnbox [] 4)
    (New [_] 5)
    (Load [_] 5)
    (Store [_] 5)
    (PropLoad [_] 5)
    (PropStore [_] 5)
    (PropHas [_] 5)
    (PropDelete [_] 5)
    (SetProto [] 5)
    (ProtoHas [] 5)
    (PropLoadKey [] 5)
    (PropStoreKey [] 5)
    (PropHasKey [] 5)
    (PropDeleteKey [] 5)
    (OwnKeyCount [] 5)
    (OwnKeyAt [] 5)
    (ObjectFreeze [] 5)
    (Fun [_] 6)
    (Parm [_] 6)
    (Call [_] 6)
    (FunStart [] 6)
    (CallEnd [] 6)
    (Closure [_] 6)
    (Safepoint [] 6)
    (ToString [] 7)
    (ToInteger [] 7)
    (ToNumber [] 7)
    (ParseInt [] 7)
    (ParseFloat [] 7)
    (NumberToString [] 7)
    (IsNaN [] 7)
    (TypeTest [_] 7)
    (_ 8)))

(defn js-small [(op Op)] (-> i64)
  (+ 1 (% (op-encode-payload op) 5)))

;; Variant-specific JavaScript spellings.  Returning false delegates structural/internal variants
;; to the broader family templates below; true means this arm emitted a complete accumulator step.
(defn js-emit-special! [(w (ptr Writer)) (op Op) (c i64) (k i64)] (-> bool)
  (match op
    (Eq [] (do (fmt w "  acc = (acc === {d}) ? 1 : 0;\n" c) true))
    (Lt [] (do (fmt w "  acc = (acc < {d}) ? acc + 1 : acc - 1;\n" c) true))
    (Le [] (do (fmt w "  acc = (acc <= {d}) ? acc + 2 : acc - 2;\n" c) true))
    (Not [] (do (ps w "  acc = (!acc) ? 1 : 0;\n") true))
    (If [] (do (fmt w "  if ((acc & 1) === 0) {{ acc += {d}; }} else {{ acc -= {d}; }}\n" c c) true))
    (Region [] (do (fmt w "  acc = acc > 0 ? acc + {d} : acc - {d};\n" c c) true))
    (Loop []
          (do
            (fmt w
                 "  {{ let i{d} = 0; while (i{d} < {d}) {{ acc += i{d}; i{d}++; }} }}\n"
                 k
                 k
                 (% c 3)
                 k
                 k)
            true))
    ;; Summing array elements in a loop -- a loop-carried local whose update goes through `| 0`,
    ;; which is a different shape from the `Loop` block above (that one carries `acc` and never
    ;; masks). This is the graph that exposed the loop-phi fixpoint bug, so the generator should
    ;; keep producing it.
    (ArrayUnbox []
                (do
                  (fmt w
                       "  {{ let au{d} = [acc, {d}, 3]; let as{d} = 0; for (let ai{d} = 0; ai{d} < 3; ai{d}++) {{ as{d} = (as{d} + au{d}[ai{d}]) | 0; }} acc = as{d} | 0; }}\n"
                       k
                       c
                       k
                       k
                       k
                       k
                       k
                       k
                       k
                       k
                       k)
                  true))
    (StringLen [] (do (fmt w "  acc = (acc + (\"abc\" + String({d})).length) | 0;\n" c) true))
    (StringEq [] (do (ps w "  acc += (String(acc) === String(acc)) ? 1 : 9;\n") true))
    (StringConcat [] (do (fmt w "  acc = (acc + (\"a\" + \"bc{d}\").length) | 0;\n" c) true))
    (StringCharCode [] (do (ps w "  acc = (acc + \"Az\".charCodeAt(1)) | 0;\n") true))
    (StringSubstring [_] (do (ps w "  acc = (acc + \"abcdef\".substring(1, 4).length) | 0;\n") true))
    (StringSplit [] (do (ps w "  acc = (acc + \"a,b,c\".split(\",\").length) | 0;\n") true))
    (StringFromCodeUnit [] (do (ps w "  acc = (acc + String.fromCharCode(65).length) | 0;\n") true))
    (StringLower [] (do (ps w "  acc = (acc + \"ABC\".toLowerCase().length) | 0;\n") true))
    (StringUpper [] (do (ps w "  acc = (acc + \"abc\".toUpperCase().length) | 0;\n") true))
    (StringIndexOf [] (do (ps w "  acc = (acc + \"abcabc\".indexOf(\"ca\")) | 0;\n") true))
    (StringCompare [] (do (ps w "  acc = (acc + (\"a\" < \"b\" ? 1 : 0)) | 0;\n") true))
    (StringNormalize [] (do (ps w "  acc = (acc + \"abc\".normalize().length) | 0;\n") true))
    (ArrayLen [] (do (fmt w "  {{ let a{d} = [1, 2, 3]; acc = (acc + a{d}.length) | 0; }}\n" k k) true))
    (ArrayLoad [_] (do (fmt w "  {{ let a{d} = [acc, {d}, 3]; acc = a{d}[1] | 0; }}\n" k c k) true))
    (ArrayStore [] (do (fmt w "  {{ let a{d} = [1, 2]; a{d}[1] = acc; acc = a{d}[1] | 0; }}\n" k k k) true))
    (ArrayResize []
                 (do
                   (fmt w "  {{ let a{d} = [1, 2, 3]; a{d}.length = 2; acc = (acc + a{d}.length) | 0; }}\n" k k k)
                   true))
    (ArrayCopy []
               (do
                 (fmt w
                      "  {{ let a{d} = [1, 2, 3, 4]; let b{d} = a{d}.slice(1, 3); acc = (acc + b{d}.length) | 0; }}\n"
                      k
                      k
                      k
                      k)
                 true))
    (ArrayTest [] (do (fmt w "  {{ let a{d} = [1, 2]; acc += Array.isArray(a{d}) ? 1 : 10; }}\n" k k) true))
    (ArrayMark [] (do (fmt w "  {{ let a{d}: number[] = []; a{d}.push(acc); acc = a{d}.pop() | 0; }}\n" k k k) true))
    (PropLoad [_] (do (fmt w "  {{ let o{d} = {{x: acc}}; acc = o{d}.x | 0; }}\n" k k) true))
    (PropStore [_] (do (fmt w "  {{ let o{d} = {{x: 0}}; o{d}.x = acc; acc = o{d}.x | 0; }}\n" k k k) true))
    (PropLoadKey []
                 (do
                   (fmt w "  {{ let o{d}: any = {{x: acc}}; let q{d} = \"x\"; acc = o{d}[q{d}] | 0; }}\n" k k k k)
                   true))
    (PropStoreKey []
                  (do
                    (fmt w
                         "  {{ let o{d}: any = {{}}; let q{d} = \"x\"; o{d}[q{d}] = acc; acc = o{d}.x | 0; }}\n"
                         k
                         k
                         k
                         k
                         k)
                    true))
    (PropHas [_] (do (fmt w "  {{ let o{d} = {{x: 1}}; acc += \"x\" in o{d} ? 1 : 8; }}\n" k k) true))
    (PropHasKey []
                (do
                  (fmt w "  {{ let o{d}: any = {{x: 1}}; let q{d} = \"x\"; acc += q{d} in o{d} ? 1 : 8; }}\n" k k k k)
                  true))
    (PropDelete [_]
                (do
                  (fmt w
                       "  {{ let o{d}: any = {{x: 1, y: 2}}; delete o{d}.x; acc += (\"x\" in o{d}) ? 9 : 1; }}\n"
                       k
                       k
                       k)
                  true))
    (PropDeleteKey []
                   (do
                     (fmt w
                          "  {{ let o{d}: any = {{x: 1}}; let q{d} = \"x\"; delete o{d}[q{d}]; acc += q{d} in o{d} ? 9 : 1; }}\n"
                          k
                          k
                          k
                          k
                          k
                          k)
                     true))
    (SetProto [] (do (fmt w "  {{ let o{d}: any = new FuzzBox(acc); acc = o{d}.bump({d}) | 0; }}\n" k k c) true))
    (ProtoHas [] (do (fmt w "  {{ let o{d}: any = new FuzzBox(acc); acc += \"bump\" in o{d} ? 1 : 8; }}\n" k k) true))
    (ObjectFreeze []
                  (do (fmt w "  {{ let o{d} = Object.freeze({{x: {d}}}); acc = (acc + o{d}.x) | 0; }}\n" k c k) true))
    (OwnKeyCount [] (do (fmt w "  {{ let o{d} = {{a: 1, b: 2}}; acc += Object.keys(o{d}).length; }}\n" k k) true))
    (Fun [_]
         (do
           (fmt w "  {{ function f{d}(x: number): number {{ return (x + {d}) | 0; }} acc = f{d}(acc); }}\n" k c k)
           true))
    ;; SELF-RECURSION, WITH THE PARAMETER LIVE ACROSS THE CALL. This slot held a two-argument
    ;; arrow, which is family 6's one-argument arrow with a second operand -- the same path twice.
    ;; Recursion is a different one: the evaluator has to save and restore a frame, and it got that
    ;; wrong for every function the frontend emits until `repros/parm-live-across-recursive-call.js`
    ;; was fixed. The bound is small because the depth is a real evaluator stack.
    (Call [_]
          (do
            (fmt w
                 "  {{ function rc{d}(x: number): number {{ if (x <= 0) {{ return 0; }} return (x + rc{d}(x - 1)) | 0; }} acc = (acc + rc{d}({d})) | 0; }}\n"
                 k
                 k
                 k
                 c)
            true))
    (Closure [_]
             (do
               (fmt w
                    "  {{ let y{d} = {d}; const f{d} = (x: number) => (x + y{d}) | 0; acc = f{d}(acc); }}\n"
                    k
                    c
                    k
                    k
                    k)
               true))
    (ToString [] (do (ps w "  acc = (String(acc).length + acc) | 0;\n") true))
    (ToNumber [] (do (ps w "  acc = Number(String(acc)) | 0;\n") true))
    (ToInteger [] (do (ps w "  acc = Math.trunc(acc + 0.75) | 0;\n") true))
    (ParseInt [] (do (ps w "  acc = parseInt(String(acc), 10) | 0;\n") true))
    (ParseFloat [] (do (ps w "  acc = parseFloat(String(acc)) | 0;\n") true))
    (NumberToString [] (do (ps w "  acc = (acc + String(12.5).length) | 0;\n") true))
    (IsNaN [] (do (ps w "  acc += Number.isNaN(acc) ? 9 : 1;\n") true))
    (_ false)))

;; THE STRUCTURAL VARIANTS, WHICH HAD NO SPELLING OF THEIR OWN.
;;
;; `js-op-family` sorted eighteen of them -- Start, Stop, Return, CProj, XCtrl, Const, Arg, Proj,
;; Phi, Cast, MemMerge, Box, Unbox, Barrier, JsBuiltin, JsThrow, InternalLoad, InternalStore -- into
;; the `_ 8` catch-all, and ten more (New, Load, Store, StringConst, OwnKeyAt, Parm, FunStart,
;; CallEnd, Safepoint, TypeTest) into a family whose generic template ignores which variant it was.
;; Twenty-eight distinct opcodes therefore produced two distinct programs between them. The fuzzer
;; explores opcodes; the compiler only ever sees what is emitted here, so that collapse -- not the
;; size of `Op` -- was the coverage ceiling.
;;
;; EVERY BODY BELOW WAS RUN AGAINST NODE BEFORE IT WAS ADDED. That matters more here than anywhere
;; else in the file: these blocks compose, so with eight steps drawn from ninety-two variants a
;; single body the frontend cannot lower would poison about 8% of all generated cases, and the
;; shrinker would converge on it and report the same known failure for ever instead of exploring.
;; A body that belongs here is one that (a) node and the frontend already agree on, and (b) reads
;; and writes only the integer accumulator, so it composes with every other body unconditionally.
(defn js-emit-structural! [(w (ptr Writer)) (op Op) (c i64) (k i64)] (-> bool)
  (match op
    (Start []
           (do
             (fmt w
                  "  {{ const fe{d} = function (x: number): number {{ return (x + {d}) | 0; }}; acc = fe{d}(acc); }}\n"
                  k
                  c
                  k)
             true))
    (Stop []
          (do
            (fmt w
                 "  {{ function rt{d}(x: number): number {{ if (x > 0) {{ return (x + {d}) | 0; }} return (x - {d}) | 0; }} acc = rt{d}(acc); }}\n"
                 k
                 c
                 c
                 k)
            true))
    (Return []
            (do
              (fmt w
                   "  {{ let re{d} = 0; if (acc > 100) {{ re{d} = 1; }} else if (acc > 0) {{ re{d} = 2; }} else {{ re{d} = 3; }} acc = (acc + re{d}) | 0; }}\n"
                   k
                   k
                   k
                   k
                   k)
              true))
    (CProj [_]
           (do
             (fmt w
                  "  {{ switch (acc & 3) {{ case 0: acc += {d}; break; case 1: acc += {d}; break; default: acc -= {d}; }} }}\n"
                  c
                  (+ c 1)
                  c)
             true))
    ;; A branch the compiler can prove dead is the only way to reach XCtrl from source.
    (XCtrl [] (do (fmt w "  {{ if (false) {{ acc += 1000; }} else {{ acc = (acc + {d}) | 0; }} }}\n" c) true))
    ;; Wide enough to exercise the int32 wrap that `| 0` imposes on both sides.
    (Const [_] (do (fmt w "  acc = (acc + {d}) | 0;\n" (+ 2147483640 c)) true))
    (Arg [_]
         (do
           (fmt w
                "  {{ const ap{d} = (a: number, b: number, d: number): number => (a + b * d) | 0; acc = ap{d}(acc, {d}, 4); }}\n"
                k
                k
                c)
           true))
    (Proj [_]
          (do
            (fmt w
                 "  {{ let pk{d}: any = {{a: 1, b: {d}, c: 3}}; let pj{d} = Object.keys(pk{d}); acc = (acc + pj{d}.length + pk{d}[pj{d}[1]]) | 0; }}\n"
                 k
                 c
                 k
                 k
                 k
                 k
                 k)
            true))
    (Phi [_]
         (do
           (fmt w
                "  {{ let ph{d} = 0; if ((acc & 1) === 0) {{ ph{d} = (acc + {d}) | 0; }} else {{ ph{d} = (acc - {d}) | 0; }} acc = ph{d} | 0; }}\n"
                k
                k
                c
                k
                c
                k)
           true))
    ;; Narrowing after a type test is exactly what a Cast node records. `x as number` cannot be
    ;; used: it is bridge kind 0, which the frontend now reports as unsupported syntax.
    (Cast [_]
          (do
            (fmt w
                 "  {{ let cg{d}: any = acc; if (typeof cg{d} === \"number\") {{ acc = (cg{d} + {d}) | 0; }} }}\n"
                 k
                 k
                 k
                 c)
            true))
    (MemMerge []
              (do
                (fmt w
                     "  {{ let mm{d} = {{x: acc, y: 1}}; if ((acc & 1) === 0) {{ mm{d}.x = (acc + {d}) | 0; }} else {{ mm{d}.y = (acc - {d}) | 0; }} acc = (mm{d}.x + mm{d}.y) | 0; }}\n"
                     k
                     k
                     c
                     k
                     c
                     k
                     k)
                true))
    (Box [_]
         (do
           (fmt w
                "  {{ let bx{d}: any = acc; let bs{d}: any = \"ab\"; acc = (Number(bx{d}) + String(bs{d}).length + {d}) | 0; }}\n"
                k
                k
                k
                k
                c)
           true))
    (Unbox [_] (do (fmt w "  {{ let ub{d}: any = acc; acc = (Number(ub{d}) * {d}) | 0; }}\n" k k (% c 3)) true))
    ;; A reference stored into an object field is what a write barrier guards.
    (Barrier []
             (do
               (fmt w
                    "  {{ let bi{d} = {{v: acc}}; let bo{d}: any = {{p: null}}; bo{d}.p = bi{d}; acc = (bo{d}.p.v + {d}) | 0; }}\n"
                    k
                    k
                    k
                    k
                    k
                    c)
               true))
    (JsBuiltin [_] (do (fmt w "  acc = (Math.abs(acc) + Math.max(1, {d}) + Math.min(3, 4)) | 0;\n" c) true))
    ;; `acc !== acc` is false for every integer, so the throw is built and never taken -- there is
    ;; no `catch` in this frontend, so a throw that RUNS would end the program.
    (JsThrow []
             (do
               (fmt w "  {{ if (acc !== acc) {{ throw new Error(\"unreachable\"); }} acc = (acc + {d}) | 0; }}\n" c)
               true))
    (InternalLoad [_]
                  (do (fmt w "  {{ let il{d} = acc; il{d}++; ++il{d}; il{d}--; acc = il{d} | 0; }}\n" k k k k k) true))
    ;; NO `do`/`while` HERE, though three of this session's fixes came from putting one after an
    ;; object literal. `fng-do-loop` is a copy of `fng-loop` that has missed several of its fixes,
    ;; and the ones repaired so far were not all of them: a do-while composed with a preceding
    ;; function expression and a following array read still disagrees with node on the VALUE, which
    ;; is worse than the crashes. See docs/FUZZ-FINDINGS.md; the pinned do-while cases in the
    ;; deftests above keep the repaired behaviour from regressing meanwhile.
    (InternalStore [_]
                   (do
                     (fmt w
                          "  {{ let is{d}: number[] = [1, 2]; is{d}.push(acc); is{d}.length = 2; acc = (is{d}[0] + is{d}.length) | 0; }}\n"
                          k
                          k
                          k
                          k
                          k)
                     true))
    (StringConst [_] (do (fmt w "  {{ let tp{d} = `v{d}${{acc}}`; acc = (acc + tp{d}.length) | 0; }}\n" k c k) true))
    (New [_]
         (do
           (fmt w
                "  {{ let ws{d} = {{a: acc, b: {d}, c: 3, d: 4}}; acc = (ws{d}.a + ws{d}.b + ws{d}.c + ws{d}.d) | 0; }}\n"
                k
                c
                k
                k
                k
                k)
           true))
    (Load [_] (do (fmt w "  {{ let ar{d} = [acc, {d}, 3]; acc = (ar{d}[0] + ar{d}[2]) | 0; }}\n" k c k k) true))
    ;; A BARE `o.q = o.p` between two fields of different representation -- `p` boxed from a
    ;; variable, `q` raw from a literal. The arithmetic that used to be here was load-bearing: it
    ;; forced the unbox that the copy itself did not do. `fng-coerce-to-alias` does it now, so the
    ;; template is the shape that found the defect rather than the shape that dodged it.
    (Store [_]
           (do
             (fmt w
                  "  {{ let cs{d} = {{p: acc, q: 1}}; cs{d}.q = cs{d}.p; acc = (cs{d}.p + cs{d}.q + {d}) | 0; }}\n"
                  k
                  k
                  k
                  k
                  k
                  c)
             true))
    ;; THE ABRUPT EXITS, both labelled, out of a nest so the label is doing work. These waited on
    ;; the fix for VERR-DEAD-INPUT: a jump captures the memory for each alias by NODE ID, and the
    ;; loop then collapsed a self-referential memory phi that the capture pointed at, so the merge
    ;; wired a dead node into a phi. Because these blocks compose and most of them allocate, an
    ;; abrupt exit failed a large share of every case and the shrinker reported nothing else.
    ;; `fng-retarget-jumps!` is the fix; repros/loop-exit-then-allocation.js is the shape.
    (OwnKeyAt []
              (do
                (fmt w
                     "  {{ let bk{d} = 0; ou{d}: for (let i{d} = 0; i{d} < 4; i{d}++) {{ for (let j{d} = 0; j{d} < 3; j{d}++) {{ if (j{d} > 1) {{ continue ou{d}; }} if (i{d} > 2) {{ break ou{d}; }} bk{d} = (bk{d} + 1) | 0; }} }} acc = (acc + bk{d} + {d}) | 0; }}\n"
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     k
                     c)
                true))
    (Parm [_]
          (do
            (fmt w
                 "  {{ let nu{d}: any = undefined; acc += (nu{d} === undefined) ? 1 : 5; acc += (null == nu{d}) ? {d} : 5; }}\n"
                 k
                 k
                 k
                 c)
            true))
    (FunStart []
              (do
                (fmt w
                     "  {{ const ca{d} = (x: number): number => (x + {d}) | 0; const cb{d} = (x: number): number => (x * 2) | 0; acc = cb{d}(ca{d}(acc)); }}\n"
                     k
                     c
                     k
                     k
                     k)
                true))
    ;; A call on ONE arm of a conditional: the merge after it is what CallEnd names.
    (CallEnd []
             (do
               (fmt w
                    "  {{ const ce{d} = (x: number): number => (x + {d}) | 0; acc = ((acc & 1) === 0) ? ce{d}(acc) : (acc - {d}) | 0; }}\n"
                    k
                    c
                    k
                    c)
               true))
    (Safepoint [] (do (fmt w "  {{ let lg{d}: any = 0; acc = ((lg{d} || acc) + (acc && 1)) | 0; }}\n" k k) true))
    (TypeTest [_]
              (do (fmt w "  {{ let tt{d}: any = acc; acc += (typeof tt{d} === \"number\") ? {d} : 7; }}\n" k k c) true))
    (_ false)))

;; Emit one self-contained, type-safe feature block.  Every block starts and ends with an integer
;; accumulator, so arbitrary families compose without a rejection filter.  The `Op` chooses the
;; language subsystem and its payload chooses values; `salt` supplies entropy to payload-free ops.
(defn js-emit-feature! [(w (ptr Writer)) (op Op) (salt i64) (k i64)] (-> i64)
  (let [c (+ 1 (% (+ (js-small op) salt) 5))
        family (js-op-family op)]
    (if (or (js-emit-special! w op c k) (js-emit-structural! w op c k))
        0
        (case family 0
              (match op
                (Sub [] (do (fmt w "  acc = (acc - {d}) | 0;\n" c) 0))
                (Mul [] (do (fmt w "  acc = (acc * {d}) | 0;\n" c) 0))
                (Div [] (do (fmt w "  acc = Math.trunc(acc / {d});\n" c) 0))
                (Mod [] (do (fmt w "  acc = acc % {d};\n" c) 0))
                (Minus [] (ps w "  acc = -acc;\n"))
                (_ (do (fmt w "  acc = (acc + {d}) | 0;\n" c) 0)))
                1
              (do
                (fmt w
                     "  if (acc < {d}) {{ acc += {d}; }} else {{ acc -= {d}; }}\n"
                     c
                     (+ c 1)
                     c)
                0)
                2
              (match op
                (BitAnd [] (do (fmt w "  acc = acc & {d};\n" (+ c 7)) 0))
                (BitOr [] (do (fmt w "  acc = acc | {d};\n" c) 0))
                (BitXor [] (do (fmt w "  acc = acc ^ {d};\n" c) 0))
                (Shl [] (do (fmt w "  acc = acc << {d};\n" (% c 3)) 0))
                (Shr [] (do (fmt w "  acc = acc >> {d};\n" (% c 3)) 0))
                (UShr [] (do (fmt w "  acc = acc >>> {d};\n" (% c 3)) 0))
                (_ (ps w "  acc = ~acc;\n")))
                3
              (do
                (fmt w
                     "  {{ let s{d} = (\"Ab\" + String(acc)).toLowerCase(); acc = (acc + s{d}.length + s{d}.indexOf(\"b\")) | 0; }}\n"
                     k
                     k
                     k)
                0)
                4
              (do
                (fmt w
                     "  {{ let a{d}: number[] = [acc, {d}, 3]; a{d}.push(4); acc = (a{d}[0] + a{d}.length) | 0; }}\n"
                     k
                     c
                     k
                     k
                     k)
                0)
                5
              (do
                (fmt w
                     "  {{ let o{d}: {{x: number, y: number}} = {{x: acc, y: {d}}}; o{d}.x += o{d}.y; acc = o{d}.x | 0; }}\n"
                     k
                     c
                     k
                     k
                     k)
                0)
                6
              (do
                (fmt w
                     "  {{ const f{d} = (x: number): number => (x + {d}) | 0; acc = f{d}(acc); }}\n"
                     k
                     c
                     k)
                0)
                7
              (ps w "  acc = Number(String(acc)) | 0;\n")
              ;; A COUNTED LOOP, IN ALL THREE SPELLINGS. The default family is "a loop" and JavaScript
              ;; writes one three ways; this emitted `for` only, so `while` was reached solely through
              ;; hand-written deftests and `do`/`while` was not reached at all. They are not the same
              ;; path: `fng-loop` and `fng-do-loop` are separate functions, and every defect found in
              ;; the do-while lowering so far was absent from `fng-loop` or already fixed there.
              (case (% c 3) 0
                    (do
                      (fmt w
                           "  {{ let z{d} = 0; for (let i{d} = 0; i{d} < {d}; i{d}++) {{ z{d} += i{d}; }} acc = (acc + z{d}) | 0; }}\n"
                           k
                           k
                           k
                           (% c 3)
                           k
                           k
                           k
                           k)
                      0)
                      1
                    (do
                      (fmt w
                           "  {{ let z{d} = 0; let i{d} = 0; while (i{d} < {d}) {{ z{d} += i{d}; i{d}++; }} acc = (acc + z{d}) | 0; }}\n"
                           k
                           k
                           k
                           (+ (% c 3) 1)
                           k
                           k
                           k
                           k
                           k)
                      0)
                    ;; The `do` body always runs, so the trip count is at least one whatever the bound is
                    ;; -- which is the asymmetry that made `fng-do-loop` a separate function in the first
                    ;; place, and the reason this arm is worth its own spelling rather than a flag.
                    (do
                      (fmt w
                           "  {{ let z{d} = 0; let i{d} = 0; do {{ z{d} += i{d}; i{d}++; }} while (i{d} < {d}); acc = (acc + z{d}) | 0; }}\n"
                           k
                           k
                           k
                           k
                           k
                           k
                           (% c 3)
                           k
                           k)
                      0)))))
  0)

(defn lift-js-opcode-program! [(ops (ArrayList Op))
                               (choices (slice u8))
                               (buf (ptr i8))
                               (cap i64)] (-> (slice u8))
  (let [fb (alloc/stack FixBuf)
        w (alloc/stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    ;; A shared constructor makes prototype operations composable with every generated body and
    ;; exercises the supported closed-world prototype path without relying on Object.create, whose
    ;; current unsupported-intrinsic validation bug is recorded by this fuzzer's first finding.
    (if (js-needs-prototype? ops)
        (do
          (ps w "function FuzzBox(value) { this.value = value; }\n")
          (ps w "function fuzzBump(amount) { return this.value + amount; }\n")
          (ps w "FuzzBox.prototype.bump = fuzzBump;\n")
          0)
        0)
    (ps w "function main(n: number): number {\n  let acc = n | 0;\n")
    (let [(mut k) 0
          limit (js-op-list-limit ops)]
      (loop (if (>= (load k) limit)
                (break)
                (do
                  (js-emit-feature! w
                                    (al-get [Op] ops (load k))
                                    (js-choice choices (load k))
                                    (load k))
                  (set! k (+ (load k) 1))
                  0))))
    (ps w "  return acc | 0;\n}\n")
    (let [n (.len fb)]
      (if (>= n cap) (do (fmt (stderr) "lift-js-opcode-program!: source overflow\n") (abort) 0) 0)
      (slice-new [u8] (cast (ptr u8) buf) n))))
