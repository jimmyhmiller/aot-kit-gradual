;; Interference construction, register allocation, spill layout, and ABI verification.
(module backend_allocate)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

; ---------------------------------------------------------------------------
; G7 CFG interference and constrained allocation.
; ---------------------------------------------------------------------------

(defn mra-result [] (-> i64)
  (.allocation-result (machine-unit)))
(defn mra-result-item [] (-> i64)
  (.allocation-item (machine-unit)))
(defn mra-seed [] (-> i64)
  (.allocation-seed (machine-unit)))
(defn mra-reg [(vreg i64)] (-> i64)
  (al-get (.alloc-reg (machine-unit)) vreg))
(defn mra-spill [(vreg i64)] (-> i64)
  (al-get (.alloc-spill (machine-unit)) vreg))
(defn mra-owner [(vreg i64)] (-> i64)
  (al-get (.alloc-owner (machine-unit)) vreg))
(defn mra-spill-kind [(vreg i64)] (-> i64)
  (al-get (.alloc-spill-kind (machine-unit)) vreg))
(defn mra-safepoint-reg [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-reg vreg) -2))
(defn mra-safepoint-spill [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-spill vreg) -2))
(defn mra-safepoint-kind [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (ml-value-kind vreg) -1))
(defn mra-interferes? [(a i64) (b i64)] (-> bool)
  (!= (al-get (.alloc-interference (machine-unit))
              (+ (* a (ml-vreg-count)) b))
      0))

(defn mra-phys-reg [(color i64)] (-> i64)
  (if (< color 8)
      color
      ; x28 is the native GC thread-state register.  It is fixed for the whole
      ; generated unit and therefore never participates in graph coloring.
      (if (< color 17)
          (+ 19 (- color 8))
          (if (< color 24) (+ 8 (- color 17)) -1))))

(defn mra-phys-reg-for-class [(class i64) (color i64)] (-> i64)
  (if (= class MRC-FPR)
      ; d0-d7 are ABI ingress/egress, d8-d15 callee-saved, and d16-d31 caller-saved.
      (if (< color 32) (+ 32 color) -1)
      (mra-phys-reg color)))

(defn mra-init! [] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut i) 0]
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (loop (if (>= (load i) (* vregs vregs))
              (break)
              (do
                (al-push! [i64] (field u alloc-interference) 0)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u alloc-live) 0)
                (al-push! [i64] (field u alloc-reg) -1)
                (al-push! [i64] (field u alloc-spill) -1)
                (al-push! [i64] (field u alloc-owner) -1)
                (al-push! [i64] (field u alloc-forbidden) 0)
                (al-push! [i64] (field u alloc-spill-kind) (ml-value-kind (load i)))
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))
                      dst (.dst m)]
                  (if (>= dst 0)
                      (do
                        (al-set! [i64] (field u alloc-owner) dst (.owner m))
                        (if (= (.op m) MI-ARG)
                            (al-set! [i64]
                                     (field u alloc-reg)
                                     dst
                                     (+ (.imm m)
                                        (if (= (ml-register-class dst) MRC-FPR) 32 0)))
                            0))
                      0))
                (set! i (+ (load i) 1))
                0)))
    ;; Ingress copies are sequential moves. A fresh destination must avoid every still-fixed
    ;; ingress register in its function, or one copy can overwrite another argument before that
    ;; argument has been copied. Calls/safepoints remain governed by ordinary liveness masks.
    (set! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (.op m) MI-ABI-COPY)
                      (let [source-def (ms-owner-def-inst (.owner m)
                                                          (.a m))
                            dst (.dst m)
                            owner (.owner m)
                            (mut at) 0
                            (mut mask) 0]
                        (if (and (>= source-def 0)
                                 (or (= (ms-inst-op source-def) MI-ARG)
                                     (= (ms-inst-op source-def) MI-STACKARG)))
                            (do
                              (loop (if (>= (load at) (be-inst-count))
                                        (break)
                                        (do
                                          (let [arg (be-inst (load at))]
                                            (if (and (= (.owner arg) owner)
                                                     (= (.op arg) MI-ARG))
                                                (set! mask
                                                      (| (load mask)
                                                         (<< 1
                                                             (+ (.imm arg)
                                                                (if (= (ml-register-class (.dst arg))
                                                                       MRC-FPR)
                                                                    32
                                                                    0)))))
                                                0))
                                          (set! at (+ (load at) 1)))))
                              (al-set! [i64] (field u alloc-forbidden) dst (load mask)))
                            0))
                      0))
                (set! i (+ (load i) 1)))))
    0))

(defn mra-add-interference! [(a i64) (b i64)] (-> i64)
  (if (or (< a 0) (or (< b 0) (= a b)))
      0
      (let [u (machine-unit)
            n (ml-vreg-count)]
        (al-set! [i64] (field u alloc-interference) (+ (* a n) b) 1)
        (al-set! [i64] (field u alloc-interference) (+ (* b n) a) 1)
        0)))

(defstruct MraUseScratch [(list (ArrayList i64)) (inited bool)])
(defn mra-use-scratch [] (-> (ptr MraUseScratch))
  (let [c (alloc/static MraUseScratch)]
    (if (.inited c)
        0
        (do
          (set! (.list c) (al-new [i64] (malloc-allocator)))
          (set! (.inited c) true)
          0))
    c))

(defn mra-note-use! [(vreg i64)] (-> i64)
  (let [c (mra-use-scratch)
        n (al-len [i64] (.list c))
        (mut k) 0
        (mut seen) false]
    (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
        (do
          (loop (if (or (>= (load k) n) (load seen))
                    (break)
                    (do
                      (if (= (al-get [i64] (.list c) (load k)) vreg)
                          (set! seen true)
                          0)
                      (set! k (+ (load k) 1))
                      0)))
          (if (load seen) 0 (do (al-push! [i64] (field c list) vreg) 0)))
        0)))

;; The instruction's used vregs, deduplicated, into the scratch list. Replaces the verifier
;; and interference walks that asked ml-inst-uses? for EVERY vreg at every instruction, which
;; was quadratic in program size.
(defn mra-collect-inst-uses! [(at i64)] (-> i64)
  (let [c (mra-use-scratch)
        m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)]
    (al-clear! [i64] (field c list))
    (if (> inputs 0) (mra-note-use! (.a m)) 0)
    (if (> inputs 1) (mra-note-use! (.b m)) 0)
    (if (= op MI-CSEL) (mra-note-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (mra-note-use! (al-get (.call-args (machine-unit))
                                         (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    (al-len [i64] (.list c))))

(defn mra-mark-uses-live! [(at i64)] (-> i64)
  (let [u (machine-unit)
        uses (mra-collect-inst-uses! at)
        (mut k) 0]
    (loop (if (>= (load k) uses)
              (break)
              (do
                (al-set! [i64] (field u alloc-live)
                         (al-get [i64] (.list (mra-use-scratch)) (load k))
                         1)
                (set! k (+ (load k) 1))
                0)))
    0))

(defn mra-build-interference! [] (-> i64)
  (let [u (machine-unit)
        blocks (mu-block-count)
        vregs (ml-vreg-count)
        (mut bid) 0]
    (loop (if (>= (load bid) blocks)
              (break)
              (do
                (let [(mut vr) 0]
                  (loop (if (>= (load vr) vregs)
                            (break)
                            (do
                              (al-set! [i64]
                                       (field u alloc-live)
                                       (load vr)
                                       (if (ml-live-out? (load bid) (load vr)) 1 0))
                              (set! vr (+ (load vr) 1))
                              0))))
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) count
                      (mut vr) 0]
                  (loop (if (<= (load i) 0)
                            (break)
                            (do
                              (set! i (- (load i) 1))
                              (let [at (+ first (load i))
                                    m (be-inst (+ first (load i)))
                                    dst (.dst m)]
                                ; Values live after any call-like instruction cannot occupy its clobber mask.
                                (if (!= (mi-desc-clobbers (mi-desc (.op m))) 0)
                                    (let [(mut vr) 0]
                                      (loop (if (>= (load vr) vregs)
                                                (break)
                                                (do
                                                  (if (and (!= (load vr) dst)
                                                           (!= (al-get (.alloc-live u) (load vr)) 0))
                                                      (al-set! [i64]
                                                               (field u alloc-forbidden)
                                                               (load vr)
                                                               (| (al-get (.alloc-forbidden u) (load vr))
                                                                  (mi-desc-clobbers (mi-desc (.op m)))))
                                                      0)
                                                  (set! vr (+ (load vr) 1))
                                                  0))))
                                    0)
                                (if (>= dst 0)
                                    (do
                                      (set! vr 0)
                                      (loop (if (>= (load vr) vregs)
                                                (break)
                                                (do
                                                  (if (!= (al-get (.alloc-live u) (load vr)) 0)
                                                      (mra-add-interference! dst (load vr))
                                                      0)
                                                  (set! vr (+ (load vr) 1))
                                                  0)))
                                      (al-set! [i64] (field u alloc-live) dst 0))
                                    0)
                                (mra-mark-uses-live! at))))))
                (set! bid (+ (load bid) 1))
                0)))
    0))

(defn mra-reg-legal? [(vreg i64) (reg i64)] (-> bool)
  (if (< reg 0)
      false
      (let [u (machine-unit)
            forbidden (al-get (.alloc-forbidden u) vreg)
            vregs (ml-vreg-count)
            (mut other) 0
            (mut ok) true]
        (if (or (!= (= (ml-register-class vreg) MRC-FPR) (>= reg 32))
                (!= (& forbidden (<< 1 reg)) 0))
            false
            (do
              (loop (if (or (>= (load other) vregs) (not (load ok)))
                        (break)
                        (do
                          (if (and (mra-interferes? vreg (load other))
                                   (= (mra-reg (load other)) reg))
                              (set! ok false)
                              0)
                          (set! other (+ (load other) 1))
                          0)))
              (load ok))))))

(defn mra-copy-preference [(vreg i64)] (-> i64)
  (let [(mut at) 0
        (mut preferred) -1]
    (loop (if (or (>= (load at) (be-inst-count)) (>= (load preferred) 0))
              (break)
              (do
                (let [m (be-inst (load at))]
                  (if (= (.op m) MI-COPY)
                      (let [dst (.dst m)
                            src (.a m)
                            other (if (= dst vreg) src (if (= src vreg) dst -1))]
                        (if (and (>= other 0)
                                 (and (not (mra-interferes? vreg other))
                                      (= (ml-value-kind vreg) (ml-value-kind other))))
                            (set! preferred (mra-reg other))
                            0))
                      0))
                (set! at (+ (load at) 1))
                0)))
    (load preferred)))

(defn mra-assign! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        funcs (mu-function-count)
        (mut owner) 0
        (mut rank) 0
        (mut spills) 0]
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (set! (.frame-size (mu-function (load owner))) 0)
                (set! (.callee-mask (mu-function (load owner))) 0)
                (set! (.callee-count (mu-function (load owner))) 0)
                (set! owner (+ (load owner) 1))
                0)))
    (loop (if (>= (load rank) vregs)
              (break)
              (do
                (let [vreg (if (= (& seed 1) 0) (load rank) (- vregs (+ (load rank) 1)))]
                  (if (or (< (mra-owner vreg) 0) (>= (mra-reg vreg) 0))
                      0
                      (let [preferred (mra-copy-preference vreg)
                            (mut color) 0
                            (mut chosen) -1]
                        (if (and (>= preferred 0) (mra-reg-legal? vreg preferred))
                            (set! chosen preferred)
                            0)
                        (loop (if (or (>= (load color) nregs) (>= (load chosen) 0))
                                  (break)
                                  (do
                                    (let [physical
                                            (mra-phys-reg-for-class (ml-register-class vreg)
                                                                    (load color))]
                                      (if (mra-reg-legal? vreg physical) (set! chosen physical) 0))
                                    (set! color (+ (load color) 1))
                                    0)))
                        (if (>= (load chosen) 0)
                            (al-set! [i64] (field u alloc-reg) vreg (load chosen))
                            (let [fun (mra-owner vreg)
                                  slot (.frame-size (mu-function (mra-owner vreg)))]
                              (al-set! [i64] (field u alloc-spill) vreg slot)
                              (set! (.frame-size (mu-function fun)) (+ slot 1))
                              (set! spills (+ (load spills) 1)))))))
                (set! rank (+ (load rank) 1))
                0)))
    ; Derive each function's callee-save area, then convert spill counts to aligned frame bytes.
    (let [(mut vr) 0]
      (loop (if (>= (load vr) vregs)
                (break)
                (do
                  (let [fun (mra-owner (load vr))
                        reg (mra-reg (load vr))]
                    (if (and (>= fun 0)
                             (or (and (>= reg 19) (<= reg 28))
                                 (and (>= reg 40) (<= reg 47))))
                        (set! (.callee-mask (mu-function fun))
                              (| (.callee-mask (mu-function fun)) (<< 1 reg)))
                        0))
                  (set! vr (+ (load vr) 1))
                  0))))
    (set! owner 0)
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (let [slots (.frame-size (mu-function (load owner)))
                      saves (popcount64 (.callee-mask (mu-function (load owner))))]
                  (set! (.callee-count (mu-function (load owner))) saves)
                  (set! (.frame-size (mu-function (load owner))) (& (+ (+ 16 (* (+ saves slots) 8)) 15) -16)))
                (set! owner (+ (load owner) 1))
                0)))
    (load spills)))

(defn mra-publish! [] (-> i64)
  (let [n (be-inst-count)
        (mut at) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      dst (.dst m)]
                  (if (>= dst 0)
                      (do
                        (set! (.reg m) (mra-reg dst))
                        (set! (.spill m) (mra-spill dst)))
                      0))
                (set! at (+ (load at) 1))
                0)))
    0))

(defn mra-expected-interferes? [(a i64) (b i64)] (-> bool)
  (if (= a b)
      false
      (let [blocks (mu-block-count)
            (mut bid) 0
            (mut found) false]
        (loop (if (or (>= (load bid) blocks) (load found))
                  (break)
                  (do
                    (let [first (mu-block-inst-first (load bid))
                          count (mu-block-inst-count (load bid))
                          (mut i) count
                          (mut alive) (ml-live-out? (load bid) a)
                          (mut blive) (ml-live-out? (load bid) b)]
                      (loop (if (or (<= (load i) 0) (load found))
                                (break)
                                (do
                                  (set! i (- (load i) 1))
                                  (let [at (+ first (load i))
                                        dst (ms-inst-dst (+ first (load i)))]
                                    (if (and (= dst a) (load blive)) (set! found true) 0)
                                    (if (and (= dst b) (load alive)) (set! found true) 0)
                                    (if (= dst a) (set! alive false) 0)
                                    (if (= dst b) (set! blive false) 0)
                                    (if (ml-inst-uses? at a) (set! alive true) 0)
                                    (if (ml-inst-uses? at b) (set! blive true) 0))))))
                    (set! bid (+ (load bid) 1))
                    0)))
        (load found))))

(defn mra-verify! [] (-> bool)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut vr) 0]
    (set! (.allocation-result u) MRA-OK)
    (set! (.allocation-item u) -1)
    (loop (if (or (>= (load vr) vregs) (!= (mra-result) MRA-OK))
              (break)
              (do
                (if (>= (mra-owner (load vr)) 0)
                    (do
                      (if (= (>= (mra-reg (load vr)) 0) (>= (mra-spill (load vr)) 0))
                          (do
                            (set! (.allocation-result u) MRA-LOCATION)
                            (set! (.allocation-item u) (load vr)))
                          0)
                      (if (and (>= (mra-reg (load vr)) 0)
                               (not (mra-reg-legal? (load vr) (mra-reg (load vr)))))
                          (do
                            (set! (.allocation-result u) MRA-INTERFERENCE)
                            (set! (.allocation-item u) (load vr)))
                          0)
                      (if (!= (mra-spill-kind (load vr)) (ml-value-kind (load vr)))
                          (do
                            (set! (.allocation-result u) MRA-SPILL-KIND)
                            (set! (.allocation-item u) (load vr)))
                          0))
                    0)
                (set! vr (+ (load vr) 1))
                0)))
    (if (= (mra-result) MRA-OK)
        (let [cells (* vregs vregs) (mut cell) 0]
          ;; Snapshot the published graph, rebuild it with the same reverse-liveness construction,
          ;; and compare matrices linearly. Calling mra-expected-interferes? for every pair scanned
          ;; every block again, making verification quartic on whole benchmark programs.
          (al-clear! [i64] (field u alloc-expected))
          (loop (if (>= (load cell) cells)
                    (break)
                    (do
                      (al-push! [i64]
                                (field u alloc-expected)
                                (al-get (.alloc-interference u) (load cell)))
                      (al-set! [i64] (field u alloc-interference) (load cell) 0)
                      (set! cell (+ (load cell) 1)))))
          (mra-build-interference!)
          (set! cell 0)
          (loop (if (or (>= (load cell) cells) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (if (!= (al-get (.alloc-interference u) (load cell))
                              (al-get (.alloc-expected u) (load cell)))
                          (do
                            (set! (.allocation-result u) MRA-INTERFERENCE)
                            (set! (.allocation-item u) (load cell)))
                          0)
                      (set! cell (+ (load cell) 1))))))
        0)
    ; Positional cross-call diagnostic (liveness-independent): within each block walked
    ; FORWARD, any instruction that reads a vreg whose register is caller-clobbered, after a
    ; call has occurred since that vreg's in-block definition, is a corruption in waiting.
    (if (= (mra-result) MRA-OK)
        (let [blocks (mu-block-count) (mut bid) 0]
          (loop (if (>= (load bid) blocks)
                    (break)
                    (do
                      (let [first (mu-block-inst-first (load bid))
                            count (mu-block-inst-count (load bid))
                            (mut last-call) -1
                            (mut i) 0]
                        (loop (if (>= (load i) count)
                                  (break)
                                  (let [at (+ first (load i))
                                        m (be-inst at)
                                        mask (mi-desc-clobbers (mi-desc (.op m)))]
                                    ; Diagnostic only: on a clean allocation nothing prints, so
                                    ; walking the instruction's operands (instead of every vreg
                                    ; ascending) is observable only when a clobber bug exists.
                                    (if (>= (load last-call) 0)
                                        (let [uses (mra-collect-inst-uses! at)
                                              (mut k) 0]
                                          (loop (if (>= (load k) uses)
                                                    (break)
                                                    (do
                                                      (let [vr2 (al-get [i64]
                                                                        (.list (mra-use-scratch))
                                                                        (load k))]
                                                        (if (and (>= (mra-reg vr2) 0)
                                                                 (and (!= (& -280379760046081
                                                                            (<< 1 (mra-reg vr2)))
                                                                         0)
                                                                      (let [def (ms-owner-def-inst
                                                                                  (.owner m)
                                                                                  vr2)]
                                                                        (or (< def first)
                                                                            (< def (load last-call))))))
                                                            (do
                                                              (fmt (stderr)
                                                                   "CROSS-CALL-CLOBBER vreg={d} reg={d} use-inst={d} use-op={d} last-call={d} block={d} live-out={d}\n"
                                                                   vr2 (mra-reg vr2) at
                                                                   (load (field m op)) (load last-call) (load bid)
                                                                   (if (ml-live-out? (load bid) vr2) 1 0))
                                                              0)
                                                            0))
                                                      (set! k (+ (load k) 1))
                                                      0))))
                                        0)
                                    (if (!= mask 0) (set! last-call at) 0)
                                    (set! i (+ (load i) 1))
                                    0))))
                      (set! bid (+ (load bid) 1))
                      0))))
        0)
    ; Independent clobber check: recompute liveness across every call-like instruction and
    ; verify no vreg assigned a caller-clobbered register survives it. This duplicates what
    ; alloc-forbidden SHOULD encode; a failure here names the exact hole.
    (if (= (mra-result) MRA-OK)
        (let [blocks (mu-block-count) (mut bid) 0]
          (loop (if (or (>= (load bid) blocks) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (let [(mut vr2) 0]
                        (loop (if (>= (load vr2) vregs)
                                  (break)
                                  (do
                                    (al-set! [i64] (field u alloc-live) (load vr2)
                                             (if (ml-live-out? (load bid) (load vr2)) 1 0))
                                    (set! vr2 (+ (load vr2) 1))
                                    0))))
                      (let [first (mu-block-inst-first (load bid))
                            count (mu-block-inst-count (load bid))
                            (mut i) count]
                        (loop (if (or (<= (load i) 0) (!= (mra-result) MRA-OK))
                                  (break)
                                  (do
                                    (set! i (- (load i) 1))
                                    (let [at (+ first (load i))
                                          m (be-inst at)
                                          dst (.dst m)
                                          mask (mi-desc-clobbers (mi-desc (.op m)))]
                                      (if (!= mask 0)
                                          (let [(mut vr2) 0]
                                            (loop (if (>= (load vr2) vregs)
                                                      (break)
                                                      (do
                                                        (if (and (!= (load vr2) dst)
                                                                 (and (!= (al-get (.alloc-live u) (load vr2)) 0)
                                                                      (and (>= (mra-reg (load vr2)) 0)
                                                                           (!= (& mask (<< 1 (mra-reg (load vr2)))) 0))))
                                                            (do
                                                              (fmt (stderr)
                                                                   "CLOBBER-LIVE vreg={d} reg={d} call-inst={d} op={d} block={d} forbidden={d}\n"
                                                                   (load vr2) (mra-reg (load vr2)) at
                                                                   (load (field m op)) (load bid)
                                                                   (al-get (load (field u alloc-forbidden)) (load vr2)))
                                                              (set! (.allocation-result u) MRA-INTERFERENCE)
                                                              (set! (.allocation-item u) (load vr2)))
                                                            0)
                                                        (set! vr2 (+ (load vr2) 1))
                                                        0))))
                                          0)
                                      (if (>= dst 0)
                                          (al-set! [i64] (field u alloc-live) dst 0)
                                          0)
                                      (mra-mark-uses-live! at))
                                    0)))
                      (set! bid (+ (load bid) 1))
                      0)))))
        0)
    ; Every definition of a vreg, including Phi edge copies, publishes the same location.
    (if (= (mra-result) MRA-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (let [m (be-inst (load at))
                            dst (.dst m)]
                        (if (and (>= dst 0)
                                 (or (!= (.reg m) (mra-reg dst))
                                     (!= (.spill m) (mra-spill dst))))
                            (do
                              (set! (.allocation-result u) MRA-LOCATION)
                              (set! (.allocation-item u) (load at)))
                            0))
                      (let [m (be-inst (load at))]
                        (if (and (= (.op m) MI-ARG)
                                 (!= (mra-reg (.dst m))
                                     (+ (.imm m)
                                        (if (= (ml-register-class (.dst m)) MRC-FPR)
                                            32
                                            0))))
                            (do
                              (set! (.allocation-result u) MRA-FIXED)
                              (set! (.allocation-item u) (load at)))
                            0))
                      (set! at (+ (load at) 1))
                      0))))
        0)
    (= (mra-result) MRA-OK)))

(defn mra-corrupt-reg! [(vreg i64) (reg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-reg) vreg reg)
  (al-set! [i64] (field (machine-unit) alloc-spill) vreg -1)
  (mra-publish!)
  0)
(defn mra-corrupt-spill-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-spill-kind) vreg kind)
  0)
(defn mra-corrupt-interference! [(a i64) (b i64) (present bool)] (-> i64)
  (let [u (machine-unit)
        n (ml-vreg-count)
        value (if present 1 0)]
    (al-set! [i64] (field u alloc-interference) (+ (* a n) b) value)
    (al-set! [i64] (field u alloc-interference) (+ (* b n) a) value)
    0))

(defn mra-allocate! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)]
    (set! (.allocation-seed u) seed)
    (set! (.allocation-result u) MRA-OK)
    (set! (.allocation-item u) -1)
    (mra-init!)
    (mra-build-interference!)
    (let [spills (mra-assign! nregs seed)]
      (mra-publish!)
      (if (mra-verify!) spills -1))))

;; Greedy coloring over the exact interval interference graph. Values beyond the register budget
;; receive distinct spill slots; lowering treats each slot boundary as a split point.
(defn be-color-linear! [(nregs i64)] (-> i64)
  (let [p (backend)
        n (be-inst-count)
        (mut i) 0]
    (set! (.spills p) 0)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (set! (.frame-size (mu-function (load owner))) 0)
                  (set! owner (+ (load owner) 1))
                  0))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (.reg (be-inst (load i)))
                      (if (= (.op (be-inst (load i))) MI-ARG)
                          (.imm (be-inst (load i)))
                          -1))
                (set! (.spill (be-inst (load i))) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (or (< (.dst m) 0) (= (.op m) MI-ARG))
                      0
                      (let [(mut color) 0
                            (mut found) false]
                        (loop (if (or (>= (load color) nregs) (load found))
                                  (break)
                                  (let [(mut j) 0
                                        (mut conflict) false]
                                    (loop (if (>= (load j) n)
                                              (break)
                                              (do
                                                (let [q (be-inst (load j))]
                                                  (if (and (!= (load j) (load i))
                                                           (and (= (.reg q) (load color))
                                                                (intervals-overlap? m q)))
                                                      (set! conflict true)
                                                      0))
                                                (set! j (+ (load j) 1))
                                                0)))
                                    (if (load conflict) (set! color (+ (load color) 1)) (set! found true)))))
                        (if (load found)
                            (set! (.reg m) (load color))
                            (let [owner (.owner m)]
                              (if (>= owner 0)
                                  (let [slot (.frame-size (mu-function owner))]
                                    (set! (.spill m) slot)
                                    (set! (.frame-size (mu-function owner)) (+ slot 1)))
                                  (do
                                    (set! (.spill m) (.spills p))
                                    (set! (.spills p) (+ (.spills p) 1))
                                    0))))))
                  (set! i (+ (load i) 1))
                  0))))
    (let [funcs (mu-function-count)
          (mut owner) 0]
      (loop (if (>= (load owner) funcs)
                (break)
                (do
                  (let [slots (.frame-size (mu-function (load owner)))
                        bytes (& (+ (+ 16 (* slots 8)) 15) -16)]
                    (set! (.frame-size (mu-function (load owner))) bytes)
                    (set! (.spills p) (+ (.spills p) slots)))
                  (set! owner (+ (load owner) 1))
                  0))))
    (.spills p)))

(defn be-color-seeded! [(nregs i64) (seed i64)] (-> i64)
  (if (and (> (be-inst-count) 0) (>= (ms-inst-owner 0) 0))
      (let [spills (mra-allocate! nregs seed)]
        (set! (.spills (backend)) (if (< spills 0) 0 spills))
        spills)
      (be-color-linear! nregs)))

(defn be-color! [(nregs i64)] (-> i64)
  (be-color-seeded! nregs 0))

; Repack whole function instruction ranges before liveness/allocation. Seeds rotate function text
; order, including moving the exported entry away from offset zero. Block-local scheduled order is
; unchanged.
(defn be-function-layout-seeded! [(seed i64)] (-> i64)
  (let [p (backend)
        u (machine-unit)
        funcs (mu-function-count)
        n (be-inst-count)
        work (field u schedule-work)
        (mut rank) 0]
    (al-clear! [MInst] work)
    (loop (if (>= (load rank) funcs)
              (break)
              (do
                (let [owner (% (+ (load rank) seed) funcs)
                      (mut at) 0]
                  (loop (if (>= (load at) n)
                            (break)
                            (do
                              (if (= (ms-inst-owner (load at)) owner)
                                  (al-push! [MInst] work (load (be-inst (load at))))
                                  0)
                              (set! at (+ (load at) 1))
                              0))))
                (set! rank (+ (load rank) 1))
                0)))
    (if (!= (al-len [MInst] (load work)) n)
        -1
        (do
          (al-clear! [MInst] (field p ins))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (al-push! [MInst] (field p ins) (load (be-al-elem [MInst] work (load at))))
                        (set! at (+ (load at) 1))
                        0))))
          (let [(mut bid) 0]
            (loop (if (>= (load bid) (mu-block-count))
                      (break)
                      (do
                        (set! (.inst-first (mu-block (load bid))) -1)
                        (set! (.inst-count (mu-block (load bid))) 0)
                        (set! bid (+ (load bid) 1))
                        0))))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (let [bid (ms-inst-block (load at))]
                          (if (>= bid 0)
                              (let [b (mu-block bid)]
                                (if (< (.inst-first b) 0)
                                    (set! (.inst-first b) (load at))
                                    0)
                                (set! (.inst-count b) (+ (.inst-count b) 1)))
                              0))
                        (set! at (+ (load at) 1))
                        0)))
            n)))))

(defn be-color-checked! [(nregs i64)] (-> bool)
  (if (<= nregs 0)
      (be-fail! BER-ALLOCATION NO-NODE)
      (do (be-color! nregs) true)))

(defn be-spills [] (-> i64)
  (.spills (backend)))

(defn be-verify-abi! [] (-> i64)
  (let [funcs (mu-function-count)
        n (be-inst-count)
        (mut owner) 0
        (mut at) 0
        (mut result) MABI-OK]
    (loop (if (or (>= (load owner) funcs) (!= (load result) MABI-OK))
              (break)
              (do
                (let [frame (mu-function-frame-size (load owner))]
                  (if (or (< frame 16) (!= (& frame 15) 0)) (set! result MABI-FRAME) 0))
                (set! owner (+ (load owner) 1))
                0)))
    (loop (if (or (>= (load at) n) (!= (load result) MABI-OK))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (.op m)
                      own (.owner m)
                      spill (.spill m)]
                  (if (and (>= own 0) (>= spill 0))
                      (if (> (+ 16 (* (+ (mu-function-callee-count own) (+ spill 1)) 8))
                             (mu-function-frame-size own))
                          (set! result MABI-SPILL)
                          0)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (or (and (= op MI-ARG)
                                    (or (< (.imm m) 0) (>= (.imm m) 8)))
                               (and (= op MI-STACKARG)
                                    (or (< (.imm m) 0) (>= (.imm m) 16)))))
                      (set! result MABI-ARGUMENT)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (and (> (ms-inst-arg-count (load at)) 0)
                                (not (ms-call-args-valid? (load at)))))
                      (set! result MABI-ARGUMENT)
                      0))
                (set! at (+ (load at) 1))
                0)))
    (load result)))

(defn be-corrupt-frame-size! [(owner i64) (bytes i64)] (-> i64)
  (set! (.frame-size (mu-function owner)) bytes)
  0)
(defn be-corrupt-spill-slot! [(at i64) (slot i64)] (-> i64)
  (set! (.spill (be-inst at)) slot)
  (set! (.reg (be-inst at)) -1)
  0)
(defn be-corrupt-arg-index! [(at i64) (idx i64)] (-> i64)
  (set! (.imm (be-inst at)) idx)
  0)

(defn be-falsify-shift-mask-ptr [] (-> (ptr bool))
  (let [enabled (alloc/static bool)] enabled))
(defn be-falsify-unsigned-shift-ptr [] (-> (ptr bool))
  (let [enabled (alloc/static bool)] enabled))
(defn be-falsify-shift-mask! [] (-> i64)
  (set! (be-falsify-shift-mask-ptr) true)
  0)
(defn be-falsify-unsigned-shift! [] (-> i64)
  (set! (be-falsify-unsigned-shift-ptr) true)
  0)

; Focused phase tests use this after coloring to exercise lowering's spill boundary independent of
; the later CFG allocator milestone. Every definition of a Phi vreg must name the same location.
(defn be-force-spill-vreg! [(vreg i64) (slot i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut owner) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (.dst m) vreg)
                      (do
                        (set! (.reg m) -1)
                        (set! (.spill m) slot)
                        (set! owner (.owner m))
                        0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (<= (.spills (backend)) slot)
        (set! (.spills (backend)) (+ slot 1))
        0)
    (if (>= (load owner) 0)
        (let [need
                (& (+ (+ 16
                         (* (+ (mu-function-callee-count (load owner))
                               (+ slot 1))
                            8))
                      15)
                   -16)]
          (if (< (mu-function-frame-size (load owner)) need)
              (set! (.frame-size (mu-function (load owner))) need)
              0))
        0)
    0))

; AArch64 word encoders used by lowering.
