;; Interference construction, register allocation, spill layout, and ABI verification.
(module backend_allocate)
(import "coil.primitive" :as primitive)

(import "backend_core" :use *)
(import "backend_cfg" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_schedule" :use *)
(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

; ---------------------------------------------------------------------------
; G7 CFG interference and constrained allocation.
; ---------------------------------------------------------------------------

(defn mra-result [] (-> i64)
  (.allocation-result (machine-unit)))
(defn mra-reg [(vreg i64)] (-> i64)
  (al-get (.alloc-reg (machine-unit)) vreg))
(defn mra-spill [(vreg i64)] (-> i64)
  (al-get (.alloc-spill (machine-unit)) vreg))
(defn mra-owner [(vreg i64)] (-> i64)
  (al-get (.alloc-owner (machine-unit)) vreg))
(defn mra-spill-kind [(vreg i64)] (-> i64)
  (al-get (.alloc-spill-kind (machine-unit)) vreg))
(defn mra-safepoint-reg [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-reg vreg) -2))
(defn mra-safepoint-spill [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (mra-spill vreg) -2))
(defn mra-safepoint-kind [(at i64) (vreg i64)] (-> i64)
  (if (and (ml-safepoint? at) (ml-live-before? at vreg)) (ml-value-kind vreg) -1))
(defn mra-intervals-overlap? [(a i64) (b i64)] (-> bool)
  (let [u (machine-unit)
        a-start (al-get (.alloc-interval-start u) a)
        a-end (al-get (.alloc-interval-end u) a)
        b-start (al-get (.alloc-interval-start u) b)
        b-end (al-get (.alloc-interval-end u) b)]
    (and (>= a-start 0)
         (and (>= b-start 0) (and (<= a-start b-end) (<= b-start a-end))))))

(defn mra-phys-reg [(color i64)] (-> i64)
  (if (< color 8)
      color
      ; x28 is the native GC thread-state register.  It is fixed for the whole
      ; generated unit and therefore never participates in graph coloring.
      (if (< color 17)
          (+ 19 (- color 8))
          (if (< color 24) (+ 8 (- color 17)) -1))))

(defn mra-phys-reg-for-class [(class i64) (color i64)] (-> i64)
  (if (= class MRC-FPR)
      ; d0-d7 are ABI ingress/egress, d8-d15 callee-saved, and d16-d31 caller-saved.
      (if (< color 32) (+ 32 color) -1)
      (mra-phys-reg color)))

(defn mra-init! [] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut ingress-masks) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-live-list))
    (al-clear! [i64] (field u alloc-live-pos))
    (al-clear! [i64] (field u alloc-owner-head))
    (al-clear! [i64] (field u alloc-owner-next))
    (al-clear! [i64] (field u alloc-copy-peer))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (al-clear! [i64] (field u alloc-interval-start))
    (al-clear! [i64] (field u alloc-interval-end))
    (al-clear! [i64] (field u alloc-start-head))
    (al-clear! [i64] (field u alloc-start-next))
    (al-clear! [i64] (field u alloc-end-head))
    (al-clear! [i64] (field u alloc-end-next))
    (al-clear! [i64] (field u alloc-clobber-tree))
    (al-clear! [i64] (field u alloc-fixed-tree))
    (set! (.alloc-tree-capacity u) 0)
    (set! i 0)
    (loop (if (>= (load i) vregs)
              (break)
              (do
                (al-push! [i64] (field u alloc-live) 0)
                (al-push! [i64] (field u alloc-live-pos) -1)
                (al-push! [i64] (field u alloc-owner-next) -1)
                (al-push! [i64] (field u alloc-copy-peer) -1)
                (al-push! [i64] (field u alloc-reg) -1)
                (al-push! [i64] (field u alloc-spill) -1)
                (al-push! [i64] (field u alloc-owner) -1)
                (al-push! [i64] (field u alloc-forbidden) 0)
                (al-push! [i64] (field u alloc-spill-kind) (ml-value-kind (load i)))
                (al-push! [i64] (field u alloc-interval-start) -1)
                (al-push! [i64] (field u alloc-interval-end) -1)
                (al-push! [i64] (field u alloc-start-next) -1)
                (al-push! [i64] (field u alloc-end-next) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    ;; One extra event coordinate represents live-after the final instruction of a block.
    (loop (if (> (load i) (be-inst-count))
              (break)
              (do
                (al-push! [i64] (field u alloc-start-head) -1)
                (al-push! [i64] (field u alloc-end-head) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) (mu-function-count))
              (break)
              (do
                (al-push! [i64] (field u alloc-owner-head) -1)
                (al-push! [i64] (mut ingress-masks) 0)
                (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))
                      dst (.dst m)]
                  (if (>= dst 0)
                      (do
                        (if (< (al-get (.alloc-owner u) dst) 0)
                            (al-set! [i64] (field u alloc-owner) dst (.owner m))
                            0)
                        (if (= (.op m) MI-ARG)
                            (let [reg (+ (.imm m)
                                         (if (= (ml-register-class dst) MRC-FPR) 32 0))]
                              (al-set! [i64] (field u alloc-reg) dst reg)
                              (al-set! [i64]
                                       (mut ingress-masks)
                                       (.owner m)
                                       (| (al-get [i64] (load ingress-masks) (.owner m))
                                          (<< 1 reg))))
                            0)
                        0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    ;; Build each owner's list in ascending vreg order so independent consumers (including stack
    ;; map publication) retain the canonical root order while skipping other functions' vregs.
    (set! i vregs)
    (loop (if (<= (load i) 0)
              (break)
              (do
                (set! i (- (load i) 1))
                (let [owner (al-get (.alloc-owner u) (load i))]
                  (if (>= owner 0)
                      (do
                        (al-set! [i64] (field u alloc-owner-next) (load i)
                                 (al-get (.alloc-owner-head u) owner))
                        (al-set! [i64] (field u alloc-owner-head) owner (load i)))
                      0)))))
    ;; Ingress copies are sequential moves. A fresh destination must avoid every still-fixed
    ;; ingress register in its function, or one copy can overwrite another argument before that
    ;; argument has been copied. Calls/safepoints remain governed by ordinary liveness masks.
    (set! i 0)
    (loop (if (>= (load i) (be-inst-count))
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (.op m) MI-STACKARG)
                      ;; Register arguments still occupy their fixed ABI registers until their
                      ;; ingress copies run. A provisional stack load must not be allocated into
                      ;; one of those registers and overwrite the corresponding parameter.
                      (al-set! [i64]
                               (field u alloc-forbidden)
                               (.dst m)
                               (al-get [i64] (load ingress-masks) (.owner m)))
                      0)
                  (if (= (.op m) MI-ABI-COPY)
                      (let [source-def (ms-owner-def-inst (.owner m)
                                                          (.a m))
                            dst (.dst m)
                            owner (.owner m)]
                        (if (and (>= source-def 0)
                                 (or (= (ms-inst-op source-def) MI-ARG)
                                     (= (ms-inst-op source-def) MI-STACKARG)))
                            (al-set! [i64]
                                     (field u alloc-forbidden)
                                     dst
                                     (al-get [i64] (load ingress-masks) owner))
                            0))
                      0)
                  0)
                (set! i (+ (load i) 1)))))
    (al-free! [i64] (mut ingress-masks))
    0))

(defn mra-live-add! [(vreg i64)] (-> i64)
  (let [u (machine-unit)]
    (if (= (al-get [i64] (.alloc-live u) vreg) 0)
        (do
          (al-set! [i64] (field u alloc-live) vreg 1)
          (al-set! [i64] (field u alloc-live-pos) vreg
                   (al-len [i64] (.alloc-live-list u)))
          (al-push! [i64] (field u alloc-live-list) vreg)
          0)
        0)))

(defn mra-live-remove! [(vreg i64)] (-> i64)
  (let [u (machine-unit)
        pos (al-get [i64] (.alloc-live-pos u) vreg)
        last-pos (- (al-len [i64] (.alloc-live-list u)) 1)]
    (if (< pos 0)
        0
        (let [last (al-get [i64] (.alloc-live-list u) last-pos)]
          (al-set! [i64] (field u alloc-live-list) pos last)
          (al-set! [i64] (field u alloc-live-pos) last pos)
          (al-pop! [i64] (field u alloc-live-list))
          (al-set! [i64] (field u alloc-live-pos) vreg -1)
          (al-set! [i64] (field u alloc-live) vreg 0)
          0))))

(defn mra-live-from-block-out! [(bid i64)] (-> i64)
  (let [u (machine-unit)
        owner (mu-block-owner bid)
        (mut pos) 0
        (mut chunk) (ml-set-first (ml-block-set ML-SET-OUT bid))]
    ;; Clear exactly the prior sparse members; unrelated vregs were already zero.
    (loop (if (>= (load pos) (al-len [i64] (.alloc-live-list u)))
              (break)
              (do
                (let [vr (al-get (.alloc-live-list u) (load pos))]
                  (al-set! [i64] (field u alloc-live) vr 0)
                  (al-set! [i64] (field u alloc-live-pos) vr -1))
                (set! pos (+ (load pos) 1)))))
    (al-clear! [i64] (field u alloc-live-list))
    ;; The live-out set's own chunks, not one word per vreg in the function.
    (loop (if (< (load chunk) 0)
              (break)
              (do
                (let [word (ml-chunk-word (load chunk))
                      bits (ml-chunk-bits (load chunk))]
                  (if (!= bits 0)
                      (let [(mut bit) 0]
                        (loop (if (>= (load bit) 64)
                                  (break)
                                  (do
                                    (if (!= (& bits (<< 1 (load bit))) 0)
                                        (let [local (+ (* word 64) (load bit))]
                                          (if (< local
                                                 (al-get (.live-owner-count u) owner))
                                              (mra-live-add! (ml-owner-vreg owner local))
                                              0))
                                        0)
                                    (set! bit (+ (load bit) 1))
                                    0))))
                      0))
                (set! chunk (ml-chunk-next (load chunk)))
                0)))
    0))

(defstruct MraUseScratch [(list (ArrayList i64)) (inited bool)])
(defn mra-use-scratch [] (-> (ptr MraUseScratch))
  (let [c (primitive/alloc-static MraUseScratch)]
    (if (.inited c)
        0
        (do
          (set! (.list c) (al-new [i64] (malloc-allocator)))
          (set! (.inited c) true)
          0))
    c))

(defn mra-note-use! [(vreg i64)] (-> i64)
  (let [c (mra-use-scratch)
        n (al-len [i64] (.list c))
        (mut k) 0
        (mut seen) false]
    (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
        (do
          (loop (if (or (>= (load k) n) (load seen))
                    (break)
                    (do
                      (if (= (al-get [i64] (.list c) (load k)) vreg)
                          (set! seen true)
                          0)
                      (set! k (+ (load k) 1))
                      0)))
          (if (load seen) 0 (do (al-push! [i64] (field c list) vreg) 0)))
        0)))

;; The instruction's used vregs, deduplicated, into the scratch list. Replaces the verifier
;; and interference walks that asked ml-inst-uses? for EVERY vreg at every instruction, which
;; was quadratic in program size.
(defn mra-collect-inst-uses! [(at i64)] (-> i64)
  (let [c (mra-use-scratch)
        m (be-inst at)
        op (.op m)
        inputs (mi-inputs op)]
    (al-clear! [i64] (field c list))
    (if (> inputs 0) (mra-note-use! (.a m)) 0)
    (if (> inputs 1) (mra-note-use! (.b m)) 0)
    (if (= op MI-CSEL) (mra-note-use! (.imm m)) 0)
    (let [args (.arg-count m)
          base (.arg-first m)
          (mut k) 0]
      (loop (if (>= (load k) args)
                (break)
                (do
                  (mra-note-use! (al-get (.call-args (machine-unit))
                                         (+ base (load k))))
                  (set! k (+ (load k) 1))
                  0))))
    (al-len [i64] (.list c))))

(defn mra-note-interval-position! [(vreg i64) (position i64)] (-> i64)
  (if (and (>= vreg 0) (< vreg (ml-vreg-count)))
      (let [u (machine-unit)
            start (al-get (.alloc-interval-start u) vreg)
            end (al-get (.alloc-interval-end u) vreg)]
        (if (or (< start 0) (< position start))
            (al-set! [i64] (field u alloc-interval-start) vreg position)
            0)
        (if (> position end)
            (al-set! [i64] (field u alloc-interval-end) vreg position)
            0))
      0))

(defn mra-lowest-set-bit-index [(word i64)] (-> i64)
  ;; `word` is nonzero. Binary narrowing avoids a 64-position scan for sparse liveness words.
  (let [(mut value) word (mut index) 0]
    (if (= (& (load value) 4294967295) 0)
        (do (set! value (>> (load value) 32)) (set! index 32)) 0)
    (if (= (& (load value) 65535) 0)
        (do (set! value (>> (load value) 16)) (set! index (+ (load index) 16))) 0)
    (if (= (& (load value) 255) 0)
        (do (set! value (>> (load value) 8)) (set! index (+ (load index) 8))) 0)
    (if (= (& (load value) 15) 0)
        (do (set! value (>> (load value) 4)) (set! index (+ (load index) 4))) 0)
    (if (= (& (load value) 3) 0)
        (do (set! value (>> (load value) 2)) (set! index (+ (load index) 2))) 0)
    (if (= (& (load value) 1) 0) (+ (load index) 1) (load index))))

(defn mra-note-block-live-set! [(bid i64) (set i64) (position i64)] (-> i64)
  (let [u (machine-unit)
        owner (mu-block-owner bid)
        locals (al-get (.live-owner-count u) owner)
        (mut chunk) (ml-set-first set)]
    (loop (if (< (load chunk) 0) (break)
              (let [word (ml-chunk-word (load chunk))
                    (mut word-bits) (ml-chunk-bits (load chunk))]
                (loop (if (= (load word-bits) 0) (break)
                          (let [bit (mra-lowest-set-bit-index (load word-bits))
                                local (+ (* word 64) bit)]
                            (if (< local locals)
                                (let [vreg (ml-owner-vreg owner local)
                                      start (al-get (.alloc-interval-start u) vreg)
                                      end (al-get (.alloc-interval-end u) vreg)]
                                  (if (or (< start 0) (< position start))
                                      (al-set! [i64] (field u alloc-interval-start)
                                               vreg position) 0)
                                  (if (> position end)
                                      (al-set! [i64] (field u alloc-interval-end)
                                               vreg position) 0))
                                0)
                            (set! word-bits (& (load word-bits) (- (load word-bits) 1))))))
                (set! chunk (ml-chunk-next (load chunk))))))
    0))

;; Construct the conservative linear live-range product from the frozen instruction sequence.
;; Multiple physical writes of one logical Phi value extend the same interval. Holes and mutually
;; exclusive branches may therefore consume extra registers, but can never create an illegal
;; overlap; this is the same deliberate safety tradeoff as Torque's unsplit initial live ranges.
(defn mra-build-intervals! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        vregs (ml-vreg-count)
        (mut at) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))]
                  (mra-note-interval-position! (.dst m) (load at)))
                (let [uses (mra-collect-inst-uses! (load at)) (mut k) 0]
                  (loop (if (>= (load k) uses)
                            (break)
                            (do
                              (mra-note-interval-position!
                                (al-get [i64] (.list (mra-use-scratch)) (load k))
                                (load at))
                              (set! k (+ (load k) 1))))))
                (set! at (+ (load at) 1)))))
    ;; Definition/use extrema alone do not cover a value that is live through a block without an
    ;; instruction-level use there. Materialize both CFG boundaries: live-in at block entry and
    ;; live-out at the exclusive block exit. This keeps interval construction independent of RPO,
    ;; dominance, and Phi-layout assumptions. Backedge boundaries extend loop-carried values across
    ;; the textual loop.
    (let [(mut bid) 0]
      (loop (if (>= (load bid) (mu-block-count)) (break)
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))]
                  (mra-note-block-live-set! (load bid) (ml-block-set ML-SET-IN (load bid)) first)
                  (mra-note-block-live-set! (load bid) (ml-block-set ML-SET-OUT (load bid))
                                            (+ first count))
                  (set! bid (+ (load bid) 1))))))
    (let [(mut vr) 0]
      (loop (if (>= (load vr) vregs)
                (break)
                (do
                  (let [start (al-get (.alloc-interval-start u) (load vr))
                        end (al-get (.alloc-interval-end u) (load vr))]
                    (if (>= start 0)
                        (do
                          (al-set! [i64] (field u alloc-start-next) (load vr)
                                   (al-get (.alloc-start-head u) start))
                          (al-set! [i64] (field u alloc-start-head) start (load vr))
                          (al-set! [i64] (field u alloc-end-next) (load vr)
                                   (al-get (.alloc-end-head u) end))
                          (al-set! [i64] (field u alloc-end-head) end (load vr)))
                        0))
                  (set! vr (+ (load vr) 1))))))
    0))

;; Calls constrain every value live across them, but this is a unary property of the value. Do
;; not encode it by constructing pairwise interference adjacency.
;; Query an OR segment tree over the half-open instruction range [left,right).
(defn mra-constraint-range-mask [(tree (ArrayList i64)) (capacity i64)
                                 (left i64) (right i64)] (-> i64)
  (let [(mut lo) (+ capacity left)
        (mut hi) (+ capacity right)
        (mut answer) 0]
    (loop (if (>= (load lo) (load hi))
              (break)
              (do
                (if (!= (& (load lo) 1) 0)
                    (do (set! answer (| (load answer) (al-get tree (load lo))))
                        (set! lo (+ (load lo) 1))) 0)
                (if (!= (& (load hi) 1) 0)
                    (do (set! hi (- (load hi) 1))
                        (set! answer (| (load answer) (al-get tree (load hi))))) 0)
                (set! lo (/ (load lo) 2))
                (set! hi (/ (load hi) 2)))))
    (load answer)))

;; Publish unary register constraints from the frozen instruction order. Conservative interval
;; range queries may forbid a register across a control-flow hole, which can only increase spills;
;; the independent verifier below still proves legality from exact CFG liveness.
(defn mra-build-clobber-constraints! [] (-> i64)
  (let [u (machine-unit)
        n (be-inst-count)
        vregs (ml-vreg-count)
        (mut capacity) 1
        (mut at) 0]
    (loop (if (>= (load capacity) (if (> n 0) n 1))
              (break)
              (set! capacity (* (load capacity) 2))))
    (set! (.alloc-tree-capacity u) (load capacity))
    (let [(mut cells) (* (load capacity) 2)]
      (loop (if (<= (load cells) 0)
                (break)
                (do
                  (al-push! [i64] (field u alloc-clobber-tree) 0)
                  (al-push! [i64] (field u alloc-fixed-tree) 0)
                  (set! cells (- (load cells) 1))))))
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      leaf (+ (load capacity) (load at))
                      mask (mi-desc-clobbers (mi-desc (.op m)))]
                  (if (!= mask 0)
                      (al-set! [i64] (field u alloc-clobber-tree) leaf mask) 0)
                  (if (and (>= (.dst m) 0) (>= (mra-reg (.dst m)) 0))
                      (al-set! [i64] (field u alloc-fixed-tree) leaf
                               (| (al-get (.alloc-fixed-tree u) leaf)
                                  (<< 1 (mra-reg (.dst m)))))
                      0))
                (set! at (+ (load at) 1)))))
    (let [(mut parent) (- (load capacity) 1)]
      (loop (if (<= (load parent) 0)
                (break)
                (do
                  (al-set! [i64] (field u alloc-clobber-tree) (load parent)
                           (| (al-get (.alloc-clobber-tree u) (* (load parent) 2))
                              (al-get (.alloc-clobber-tree u) (+ (* (load parent) 2) 1))))
                  (al-set! [i64] (field u alloc-fixed-tree) (load parent)
                           (| (al-get (.alloc-fixed-tree u) (* (load parent) 2))
                              (al-get (.alloc-fixed-tree u) (+ (* (load parent) 2) 1))))
                  (set! parent (- (load parent) 1))))))
    (let [(mut vr) 0]
      (loop (if (>= (load vr) vregs)
                (break)
                (do
                  (let [start (al-get (.alloc-interval-start u) (load vr))
                        end (al-get (.alloc-interval-end u) (load vr))]
                    (if (>= start 0)
                        (let [call-mask
                                (if (< (+ start 1) end)
                                    (mra-constraint-range-mask
                                      (.alloc-clobber-tree u) (load capacity)
                                      (+ start 1) end)
                                    0)
                              fixed-mask
                                (if (< (mra-reg (load vr)) 0)
                                    (mra-constraint-range-mask
                                      (.alloc-fixed-tree u) (load capacity)
                                      start (+ end 1))
                                    0)]
                          (al-set! [i64] (field u alloc-forbidden) (load vr)
                                   (| (al-get (.alloc-forbidden u) (load vr))
                                      (| call-mask fixed-mask))))
                        0))
                  (set! vr (+ (load vr) 1))))))
    0))

(defn mra-mark-uses-live! [(at i64)] (-> i64)
  (let [u (machine-unit)
        uses (mra-collect-inst-uses! at)
        (mut k) 0]
    (loop (if (>= (load k) uses)
              (break)
              (do
                (mra-live-add! (al-get [i64] (.list (mra-use-scratch)) (load k)))
                (set! k (+ (load k) 1))
                0)))
    0))

(defn mra-reg-basic-legal? [(vreg i64) (reg i64)] (-> bool)
  (and (>= reg 0)
       (and (= (= (ml-register-class vreg) MRC-FPR) (>= reg 32))
            (= (& (al-get (.alloc-forbidden (machine-unit)) vreg) (<< 1 reg)) 0))))

(defn mra-copy-preference [(vreg i64)] (-> i64)
  (let [peer (al-get [i64] (.alloc-copy-peer (machine-unit)) vreg)]
    (if (>= peer 0) (mra-reg peer) -1)))

(defn mra-build-copy-preferences! [] (-> i64)
  (let [u (machine-unit) (mut at) 0]
    (loop (if (>= (load at) (be-inst-count)) (break)
              (do
                (let [m (be-inst (load at))]
                  (if (= (.op m) MI-COPY)
                      (let [dst (.dst m) src (.a m)]
                        (if (and (>= dst 0)
                                 (and (>= src 0)
                                      (= (ml-value-kind dst) (ml-value-kind src))))
                            (do
                              (if (= (al-get [i64] (.alloc-copy-peer u) dst) -1)
                                  (al-set! [i64] (field u alloc-copy-peer) dst src) 0)
                              (if (= (al-get [i64] (.alloc-copy-peer u) src) -1)
                                  (al-set! [i64] (field u alloc-copy-peer) src dst) 0))
                            0))
                      0))
                (set! at (+ (load at) 1)))))
    0))

(defn mra-assign! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        funcs (mu-function-count)
        (mut occupied) (al-new [i64] (malloc-allocator))
        (mut owner) 0
        (mut position) 0
        (mut spills) 0]
    ;; Physical register numbers occupy 0..63 across the GPR and FPR domains.
    (let [(mut reg) 0]
      (loop (if (>= (load reg) 64)
                (break)
                (do (al-push! [i64] (mut occupied) -1)
                    (set! reg (+ (load reg) 1))))))
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (set! (.frame-size (mu-function (load owner))) 0)
                (set! (.callee-mask (mu-function (load owner))) 0)
                (set! (.callee-count (mu-function (load owner))) 0)
                (set! owner (+ (load owner) 1))
                0)))
    (loop (if (or (> (load position) (be-inst-count))
                  (!= (mra-result) MRA-OK))
              (break)
              (do
                ;; Values whose last read is this instruction may share the instruction's result
                ;; register: machine operations consume inputs before publishing their output.
                (let [(mut ending) (al-get (.alloc-end-head u) (load position))]
                  (loop (if (< (load ending) 0)
                            (break)
                            (do
                              (let [reg (mra-reg (load ending))]
                                (if (and (>= reg 0)
                                         (= (al-get [i64] (load occupied) reg) (load ending)))
                                    (al-set! [i64] (mut occupied) reg -1)
                                    0))
                              (set! ending (al-get (.alloc-end-next u) (load ending)))))))
                (let [(mut starting) (al-get (.alloc-start-head u) (load position))]
                  (loop (if (< (load starting) 0)
                            (break)
                            (do
                              (let [vreg (load starting)
                                    fixed (mra-reg (load starting))
                                    end (al-get (.alloc-interval-end u) (load starting))
                                    preferred (mra-copy-preference (load starting))
                                    (mut color) 0
                                    (mut chosen) -1]
                                (if (>= fixed 0)
                                    ;; Fixed values are checked and imposed from exact CFG
                                    ;; liveness above. Do not let holes in a conservative interval
                                    ;; make mutually exclusive ABI values appear to conflict.
                                    (set! chosen fixed)
                                    (do
                                      (if (and (>= preferred 0)
                                               (and (= (al-get [i64] (load occupied) preferred) -1)
                                                    (mra-reg-basic-legal? vreg preferred)))
                                          (set! chosen preferred)
                                          0)
                                      (loop (if (or (>= (load color) nregs)
                                                    (>= (load chosen) 0))
                                                (break)
                                                (do
                                                  (let [physical
                                                          (mra-phys-reg-for-class
                                                            (ml-register-class vreg) (load color))]
                                                    (if (and (>= physical 0)
                                                             (and (= (al-get [i64]
                                                                             (load occupied)
                                                                             physical) -1)
                                                                  (mra-reg-basic-legal?
                                                                    vreg physical)))
                                                        (set! chosen physical)
                                                        0))
                                                  (set! color (+ (load color) 1)))))))
                                (if (>= (load chosen) 0)
                                    (do
                                      (al-set! [i64] (field u alloc-reg) vreg (load chosen))
                                      ;; Fixed ABI ranges are imposed on ordinary values by the
                                      ;; fixed-range index and checked against each other by exact
                                      ;; CFG verification. Do not turn conservative CFG holes into
                                      ;; false fixed/fixed conflicts in this linear active set.
                                      (if (and (< fixed 0) (>= end (load position)))
                                          (if (= (al-get [i64] (load occupied)
                                                        (load chosen)) -1)
                                              (al-set! [i64] (mut occupied) (load chosen) vreg)
                                              (do
                                                (set! (.allocation-result u) MRA-INTERFERENCE)
                                                (set! (.allocation-item u) vreg)))
                                          0))
                                    (if (= (mra-result) MRA-OK)
                                        (let [fun (mra-owner vreg)
                                              slot (.frame-size (mu-function (mra-owner vreg)))]
                                          (al-set! [i64] (field u alloc-spill) vreg slot)
                                          (set! (.frame-size (mu-function fun)) (+ slot 1))
                                          (set! spills (+ (load spills) 1)))
                                        0)))
                              (set! starting
                                    (al-get (.alloc-start-next u) (load starting)))))))
                (set! position (+ (load position) 1))
                0)))
    ; Derive each function's callee-save area, then convert spill counts to aligned frame bytes.
    (let [(mut vr) 0]
      (loop (if (>= (load vr) vregs)
                (break)
                (do
                  (let [fun (mra-owner (load vr))
                        reg (mra-reg (load vr))]
                    (if (and (>= fun 0)
                             (or (and (>= reg 19) (<= reg 28))
                                 (and (>= reg 40) (<= reg 47))))
                        (set! (.callee-mask (mu-function fun))
                              (| (.callee-mask (mu-function fun)) (<< 1 reg)))
                        0))
                  (set! vr (+ (load vr) 1))
                  0))))
    (set! owner 0)
    (loop (if (>= (load owner) funcs)
              (break)
              (do
                (let [slots (.frame-size (mu-function (load owner)))
                      saves (popcount64 (.callee-mask (mu-function (load owner))))]
                  (set! (.callee-count (mu-function (load owner))) saves)
                  (set! (.frame-size (mu-function (load owner))) (& (+ (+ 16 (* (+ saves slots) 8)) 15) -16)))
                (set! owner (+ (load owner) 1))
                0)))
    (load spills)))

(defn mra-publish! [] (-> i64)
  (let [n (be-inst-count)
        (mut at) 0]
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      dst (.dst m)]
                  (if (>= dst 0)
                      (do
                        (set! (.reg m) (mra-reg dst))
                        (set! (.spill m) (mra-spill dst)))
                      0))
                (set! at (+ (load at) 1))
                0)))
    0))

(defn mra-verify-register-liveness! [] (-> i64)
  (let [u (machine-unit)
        (mut occupied) (al-new [i64] (malloc-allocator))
        (mut reg) 0
        (mut bid) 0]
    (loop (if (>= (load reg) 64)
              (break)
              (do (al-push! [i64] (mut occupied) -1)
                  (set! reg (+ (load reg) 1)))))
    (loop (if (or (>= (load bid) (mu-block-count)) (!= (mra-result) MRA-OK))
              (break)
              (do
                (set! reg 0)
                (loop (if (>= (load reg) 64)
                          (break)
                          (do (al-set! [i64] (mut occupied) (load reg) -1)
                              (set! reg (+ (load reg) 1)))))
                (mra-live-from-block-out! (load bid))
                (let [(mut live-at) 0]
                  (loop (if (or (>= (load live-at) (al-len [i64] (.alloc-live-list u)))
                                (!= (mra-result) MRA-OK))
                            (break)
                            (do
                              (let [vr (al-get (.alloc-live-list u) (load live-at))
                                    physical (mra-reg vr)]
                                (if (>= physical 0)
                                    (if (= (al-get [i64] (load occupied) physical) -1)
                                        (al-set! [i64] (mut occupied) physical vr)
                                        (do
                                          (set! (.allocation-result u) MRA-INTERFERENCE)
                                          (set! (.allocation-item u) vr)))
                                    0))
                              (set! live-at (+ (load live-at) 1))))))
                (let [first (mu-block-inst-first (load bid))
                      count (mu-block-inst-count (load bid))
                      (mut i) count]
                  (loop (if (or (<= (load i) 0) (!= (mra-result) MRA-OK))
                            (break)
                            (do
                              (set! i (- (load i) 1))
                              (let [at (+ first (load i))
                                    m (be-inst at)
                                    dst (.dst m)
                                    mask (mi-desc-clobbers (mi-desc (.op m)))]
                                ;; `occupied` is the independently reconstructed exact live-after
                                ;; register map. A clobber check is therefore a 64-register mask
                                ;; walk, not a second traversal of every live value in the block.
                                (if (!= mask 0)
                                    (let [(mut physical) 0]
                                      (loop (if (or (>= (load physical) 64)
                                                    (!= (mra-result) MRA-OK))
                                                (break)
                                                (do
                                                  (let [live-vreg
                                                          (al-get [i64] (load occupied)
                                                                  (load physical))]
                                                    (if (and (!= (& mask (<< 1 (load physical))) 0)
                                                             (and (>= live-vreg 0)
                                                                  (!= live-vreg dst)))
                                                        (do
                                                          (set! (.allocation-result u)
                                                                MRA-INTERFERENCE)
                                                          (set! (.allocation-item u) live-vreg))
                                                        0))
                                                  (set! physical (+ (load physical) 1))))))
                                    0)
                                ;; Every physical destination writes its assigned register even if
                                ;; the logical result is dead. It must not overwrite a different
                                ;; value that is live after this instruction.
                                (if (>= dst 0)
                                    (let [physical (mra-reg dst)]
                                      (if (and (>= physical 0)
                                               (let [other (al-get [i64] (load occupied) physical)]
                                                 (and (>= other 0) (!= other dst))))
                                          (do
                                            (set! (.allocation-result u) MRA-INTERFERENCE)
                                            (set! (.allocation-item u) dst))
                                          0))
                                    0)
                                (if (and (>= dst 0) (!= (al-get (.alloc-live u) dst) 0))
                                    (do
                                      (let [physical (mra-reg dst)]
                                        (if (and (>= physical 0)
                                                 (= (al-get [i64] (load occupied) physical) dst))
                                            (al-set! [i64] (mut occupied) physical -1)
                                            0))
                                      (mra-live-remove! dst))
                                    0)
                                (let [uses (mra-collect-inst-uses! at) (mut k) 0]
                                  (loop (if (or (>= (load k) uses)
                                                (!= (mra-result) MRA-OK))
                                            (break)
                                            (do
                                              (let [vr (al-get [i64]
                                                                (.list (mra-use-scratch))
                                                                (load k))]
                                                (if (= (al-get (.alloc-live u) vr) 0)
                                                    (let [physical (mra-reg vr)]
                                                      (if (>= physical 0)
                                                          (if (= (al-get [i64]
                                                                          (load occupied)
                                                                          physical) -1)
                                                              (al-set! [i64] (mut occupied)
                                                                       physical vr)
                                                              (do
                                                                (set! (.allocation-result u)
                                                                      MRA-INTERFERENCE)
                                                                (set! (.allocation-item u) vr)))
                                                          0)
                                                      (mra-live-add! vr))
                                                    0))
                                              (set! k (+ (load k) 1)))))))))))
                (set! bid (+ (load bid) 1)))))
    0))

(defn mra-verify! [] (-> bool)
  (let [u (machine-unit)
        vregs (ml-vreg-count)
        (mut vr) 0
        (mut profile-start) (ms-profile-now)]
    ;; Verification refines an already-successful allocation; it must never erase a failure from
    ;; interval assignment or another earlier allocation phase.
    (loop (if (or (>= (load vr) vregs) (!= (mra-result) MRA-OK))
              (break)
              (do
                (if (>= (mra-owner (load vr)) 0)
                    (do
                      (if (= (>= (mra-reg (load vr)) 0) (>= (mra-spill (load vr)) 0))
                          (do
                            (set! (.allocation-result u) MRA-LOCATION)
                            (set! (.allocation-item u) (load vr)))
                          0)
                      (if (and (>= (mra-reg (load vr)) 0)
                               (not (mra-reg-basic-legal? (load vr) (mra-reg (load vr)))))
                          (do
                            (set! (.allocation-result u) MRA-INTERFERENCE)
                            (set! (.allocation-item u) (load vr)))
                          0)
                      (if (!= (mra-spill-kind (load vr)) (ml-value-kind (load vr)))
                          (do
                            (set! (.allocation-result u) MRA-SPILL-KIND)
                            (set! (.allocation-item u) (load vr)))
                          0))
                    0)
                (set! vr (+ (load vr) 1))
                0)))
    (set! profile-start (ms-profile-note! "allocation_verify_rows" (load profile-start)))
    (if (= (mra-result) MRA-OK) (mra-verify-register-liveness!) 0)
    (set! profile-start (ms-profile-note! "allocation_verify_register_liveness"
                                          (load profile-start)))
    ; Positional cross-call diagnostic (liveness-independent): within each block walked
    ; FORWARD, any instruction that reads a vreg whose register is caller-clobbered, after a
    ; call has occurred since that vreg's in-block definition, is a corruption in waiting.
    (if (= (mra-result) MRA-OK)
        (let [blocks (mu-block-count) (mut bid) 0]
          (loop (if (>= (load bid) blocks)
                    (break)
                    (do
                      (let [first (mu-block-inst-first (load bid))
                            count (mu-block-inst-count (load bid))
                            (mut last-call) -1
                            (mut i) 0]
                        (loop (if (>= (load i) count)
                                  (break)
                                  (let [at (+ first (load i))
                                        m (be-inst at)
                                        mask (mi-desc-clobbers (mi-desc (.op m)))]
                                    ; Diagnostic only: on a clean allocation nothing prints, so
                                    ; walking the instruction's operands (instead of every vreg
                                    ; ascending) is observable only when a clobber bug exists.
                                    (if (>= (load last-call) 0)
                                        (let [uses (mra-collect-inst-uses! at)
                                              (mut k) 0]
                                          (loop (if (>= (load k) uses)
                                                    (break)
                                                    (do
                                                      (let [vr2 (al-get [i64]
                                                                        (.list (mra-use-scratch))
                                                                        (load k))]
                                                        (if (and (>= (mra-reg vr2) 0)
                                                                 (and (!= (& -280379760046081
                                                                            (<< 1 (mra-reg vr2)))
                                                                         0)
                                                                      (let [def (ms-owner-def-inst
                                                                                  (.owner m)
                                                                                  vr2)]
                                                                        (or (< def first)
                                                                            (< def (load last-call))))))
                                                            (do
                                                              (fmt (stderr)
                                                                   "CROSS-CALL-CLOBBER vreg={d} reg={d} use-inst={d} use-op={d} last-call={d} block={d} live-out={d}\n"
                                                                   vr2 (mra-reg vr2) at
                                                                   (load (field m op)) (load last-call) (load bid)
                                                                   (if (ml-live-out? (load bid) vr2) 1 0))
                                                              0)
                                                            0))
                                                      (set! k (+ (load k) 1))
                                                      0))))
                                        0)
                                    (if (!= mask 0) (set! last-call at) 0)
                                    (set! i (+ (load i) 1))
                                    0))))
                      (set! bid (+ (load bid) 1))
                      0))))
        0)
    (set! profile-start (ms-profile-note! "allocation_verify_cross_call"
                                          (load profile-start)))
    ; Every definition of a vreg, including Phi edge copies, publishes the same location.
    (if (= (mra-result) MRA-OK)
        (let [(mut at) 0]
          (loop (if (or (>= (load at) (be-inst-count)) (!= (mra-result) MRA-OK))
                    (break)
                    (do
                      (let [m (be-inst (load at))
                            dst (.dst m)]
                        (if (and (>= dst 0)
                                 (or (!= (.reg m) (mra-reg dst))
                                     (!= (.spill m) (mra-spill dst))))
                            (do
                              (set! (.allocation-result u) MRA-LOCATION)
                              (set! (.allocation-item u) (load at)))
                            0))
                      (let [m (be-inst (load at))]
                        (if (and (= (.op m) MI-ARG)
                                 (!= (mra-reg (.dst m))
                                     (+ (.imm m)
                                        (if (= (ml-register-class (.dst m)) MRC-FPR)
                                            32
                                            0))))
                            (do
                              (set! (.allocation-result u) MRA-FIXED)
                              (set! (.allocation-item u) (load at)))
                            0))
                      (set! at (+ (load at) 1))
                      0))))
        0)
    (set! profile-start (ms-profile-note! "allocation_verify_publication"
                                          (load profile-start)))
    (let [answer (and (= (mra-result) MRA-OK) (mra-abi-parallel-moves-valid?))]
      (ms-profile-note! "allocation_verify_abi" (load profile-start))
      answer)))

(defn mra-vreg-location [(vreg i64)] (-> MLocation)
  (let [reg (mra-reg vreg)]
    (if (>= reg 0)
        (mloc-new MLOC-REGISTER (ml-register-class vreg) reg)
        (mloc-new MLOC-SPILL (ml-register-class vreg) (mra-spill vreg)))))

(defn mra-reserve-result-pointer-slots! [] (-> i64)
  (let [(mut owner) 0
        (mut outgoing) (al-new [bool] (malloc-allocator))]
    (loop (if (>= (load owner) (mu-function-count)) (break)
              (let [f (mu-function (load owner))
                    area (be-function-result-area-size (load owner))]
                (al-push! [bool] (mut outgoing) false)
                (set! (.result-area-size f) area)
                (if (> area 0)
                    (let [old-frame (.frame-size f)]
                      (set! (.result-pointer-offset f) old-frame)
                      (set! (.frame-size f) (+ old-frame 16)))
                    (set! (.result-pointer-offset f) -1))
                (set! owner (+ (load owner) 1)))))
    ;; A caller with any overflow-result call retains that area's base in its own stable frame so
    ;; stack walking can find typed result-area roots while a nested callee is at a safepoint.
    (let [(mut at) 0]
      (loop (if (>= (load at) (be-inst-count)) (break)
                (do
                  (let [m (be-inst (load at))]
                    (if (and (>= (.owner m) 0)
                             (and (= (.op m) MI-CALL)
                                  (> (be-call-result-area-size (.node m)) 0)))
                        (al-set! [bool] (mut outgoing) (.owner m) true)
                        0))
                  (set! at (+ (load at) 1))))))
    (set! owner 0)
    (loop (if (>= (load owner) (mu-function-count)) (break)
              (let [f (mu-function (load owner))]
                (if (al-get [bool] (load outgoing) (load owner))
                    (do
                      (set! (.outgoing-result-pointer-offset f) (.frame-size f))
                      (set! (.frame-size f) (+ (.frame-size f) 16)))
                    (set! (.outgoing-result-pointer-offset f) -1))
                (set! owner (+ (load owner) 1)))))
    0))

(defn mra-location-equal? [(a MLocation) (b MLocation)] (-> bool)
  (and (= (.kind a) (.kind b))
       (and (= (.class a) (.class b)) (= (.index a) (.index b)))))

(defn mra-abi-work-dst-used-as-source? [(at i64)] (-> bool)
  (let [u (machine-unit)
        dst (al-get [MLocation] (.abi-work-dst u) at)
        n (al-len [i64] (.abi-work-live u))
        (mut i) 0 (mut used) false]
    (loop (if (or (>= (load i) n) (load used)) (break)
              (do
                (if (and (!= (al-get [i64] (.abi-work-live u) (load i)) 0)
                         (mra-location-equal?
                           (al-get [MLocation] (.abi-work-src u) (load i)) dst))
                    (set! used true) 0)
                (set! i (+ (load i) 1)))))
    (load used)))

(defn mra-resolve-abi-work! [(owner i64) (inst i64)] (-> i64)
  (let [u (machine-unit)
        first (al-len [MParallelMove] (.abi-moves u))
        n (al-len [i64] (.abi-work-live u))
        (mut remaining) 0 (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do
                (if (!= (al-get [i64] (.abi-work-live u) (load i)) 0)
                    (set! remaining (+ (load remaining) 1)) 0)
                (set! i (+ (load i) 1)))))
    (loop (if (<= (load remaining) 0) (break)
              (let [(mut ready) -1 (mut first-live) -1]
                (set! i 0)
                (loop (if (>= (load i) n) (break)
                          (do
                            (if (!= (al-get [i64] (.abi-work-live u) (load i)) 0)
                                (do
                                  (if (< (load first-live) 0) (set! first-live (load i)) 0)
                                  (if (not (mra-abi-work-dst-used-as-source? (load i)))
                                      (do (set! ready (load i)) (set! i n)) 0)) 0)
                            (set! i (+ (load i) 1)))))
                (if (>= (load ready) 0)
                    (do
                      (al-push! [MParallelMove] (field u abi-moves)
                                (mpm-new owner inst
                                  (al-get [MLocation] (.abi-work-dst u) (load ready))
                                  (al-get [MLocation] (.abi-work-src u) (load ready)) false))
                      (al-set! [i64] (field u abi-work-live) (load ready) 0)
                      (set! remaining (- (load remaining) 1)))
                    (let [old-src (al-get [MLocation] (.abi-work-src u) (load first-live))
                          temp (mloc-new MLOC-SCRATCH (.class old-src) 0)]
                      (al-push! [MParallelMove] (field u abi-moves)
                                (mpm-new owner inst temp old-src true))
                      (set! i 0)
                      (loop (if (>= (load i) n) (break)
                                (do
                                  (if (and (!= (al-get [i64] (.abi-work-live u) (load i)) 0)
                                           (mra-location-equal?
                                             (al-get [MLocation] (.abi-work-src u) (load i))
                                             old-src))
                                      (al-set! [MLocation] (field u abi-work-src) (load i) temp) 0)
                                  (set! i (+ (load i) 1)))))))))
    (let [count (- (al-len [MParallelMove] (.abi-moves u)) first)]
      (al-set! [i64] (field u abi-move-first) inst (if (= count 0) -1 first))
      (al-set! [i64] (field u abi-move-count) inst count))
    0)))

(defn mra-abi-work-add! [(dst MLocation) (src MLocation)] (-> i64)
  (let [u (machine-unit)]
    (if (mra-location-equal? dst src) 0
        (do
          (if (!= (.class dst) (.class src))
              (panic-corrupt "parallel ABI copy changes register class") 0)
          (al-push! [MLocation] (field u abi-work-dst) dst)
          (al-push! [MLocation] (field u abi-work-src) src)
          (al-push! [i64] (field u abi-work-live) 1)
          0))))

(defn mra-build-abi-parallel-moves! [] (-> i64)
  (let [u (machine-unit) n (be-inst-count) (mut at) 0]
    (al-clear! [MParallelMove] (field u abi-moves))
    (al-clear! [i64] (field u abi-move-first))
    (al-clear! [i64] (field u abi-move-count))
    (loop (if (>= (load at) n) (break)
              (do
                (al-push! [i64] (field u abi-move-first) -1)
                (al-push! [i64] (field u abi-move-count) 0)
                (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) n) (break)
              (let [m (be-inst (load at)) op (.op m)]
                (if (= op MI-CALL)
                    (let [bundle (mu-call-bundle (mu-inst-call-bundle (load at)))]
                      (if (> (.capture-count bundle) 0)
                          (let [owner (.owner m) call (.node m) (mut slot) 0]
                            (al-clear! [MLocation] (field u abi-work-dst))
                            (al-clear! [MLocation] (field u abi-work-src))
                            (al-clear! [i64] (field u abi-work-live))
                            (loop (if (>= (load slot) (.capture-count bundle)) (break)
                                      (let [q (be-inst (+ (.capture-first bundle) (load slot)))
                                            dst (mra-vreg-location (.dst q))
                                            ordinal (be-call-result-register-index
                                                      call (.imm q))
                                            class (ml-register-class (.dst q))
                                            src (if (= (be-call-result-location-kind
                                                         call (.imm q)) MABI-RESULT-AREA)
                                                    (mloc-new MLOC-RESULT-AREA class
                                                      (be-call-result-area-offset call (.imm q)))
                                                    (mloc-new MLOC-REGISTER class
                                                      (+ ordinal
                                                         (if (= class MRC-FPR) 32 0))))]
                                        (mra-abi-work-add! dst src)
                                        (set! slot (+ (load slot) 1)))))
                            (mra-resolve-abi-work! owner (.capture-first bundle)))
                          0))
                    0)
                (if (and (= op MI-RET) (> (.imm m) 1))
                    (let [owner (.owner m) results (.imm m) (mut slot) 0]
                      (al-clear! [MLocation] (field u abi-work-dst))
                      (al-clear! [MLocation] (field u abi-work-src))
                      (al-clear! [i64] (field u abi-work-live))
                      (loop (if (>= (load slot) results) (break)
                                (let [vr (if (= (load slot) 0) (.a m)
                                             (ms-inst-arg (load at) (- (load slot) 1)))
                                      class (ml-register-class vr)
                                      ordinal (be-function-result-register-index
                                                owner (load slot))
                                      dst (if (= (be-function-result-location-kind
                                                   owner (load slot)) MABI-RESULT-AREA)
                                              (mloc-new MLOC-RESULT-AREA class
                                                        (be-function-result-area-offset
                                                          owner (load slot)))
                                              (mloc-new MLOC-REGISTER class
                                                (+ ordinal (if (= class MRC-FPR) 32 0))))]
                                  (mra-abi-work-add! dst (mra-vreg-location vr))
                                  (set! slot (+ (load slot) 1)))))
                      (mra-resolve-abi-work! owner (load at))) 0)
                (set! at (+ (load at) 1)))))
    0))

(defn mra-location-fields-valid? [(kind i64) (class i64) (index i64)] (-> bool)
  (and (or (= class MRC-GPR) (= class MRC-FPR))
       (and (or (= kind MLOC-REGISTER)
                (or (= kind MLOC-SPILL)
                    (or (= kind MLOC-SCRATCH) (= kind MLOC-RESULT-AREA))))
            (if (= kind MLOC-SCRATCH) (= index 0) (>= index 0)))))

(defn mra-abi-parallel-moves-valid? [] (-> bool)
  (let [u (machine-unit) insts (be-inst-count) total (mu-abi-move-total)
        (mut at) 0 (mut ok) true]
    (if (or (!= (al-len [i64] (.abi-move-first u)) insts)
            (!= (al-len [i64] (.abi-move-count u)) insts))
        false
        (do
          (loop (if (or (>= (load at) insts) (not (load ok))) (break)
                    (let [first (al-get [i64] (.abi-move-first u) (load at))
                          count (al-get [i64] (.abi-move-count u) (load at))
                          (mut move) 0]
                      (if (or (< count 0)
                              (if (= count 0) (!= first -1)
                                  (or (< first 0) (> (+ first count) total))))
                          (set! ok false) 0)
                      (loop (if (or (>= (load move) count) (not (load ok))) (break)
                                (let [p (mu-abi-move (load at) (load move))]
                                  (if (or (!= (.inst p) (load at))
                                          (or (!= (.owner p) (ms-inst-owner (load at)))
                                              (or (!= (.dst-class p) (.src-class p))
                                                  (or (not (mra-location-fields-valid?
                                                             (.dst-kind p) (.dst-class p)
                                                             (.dst-index p)))
                                                      (not (mra-location-fields-valid?
                                                             (.src-kind p) (.src-class p)
                                                             (.src-index p)))))))
                                      (set! ok false) 0)
                                  (set! move (+ (load move) 1)))))
                      (set! at (+ (load at) 1)))))
          (load ok)))))

(defn mra-corrupt-reg! [(vreg i64) (reg i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-reg) vreg reg)
  (al-set! [i64] (field (machine-unit) alloc-spill) vreg -1)
  (mra-publish!)
  0)
(defn mra-corrupt-spill-kind! [(vreg i64) (kind i64)] (-> i64)
  (al-set! [i64] (field (machine-unit) alloc-spill-kind) vreg kind)
  0)
(defn mra-allocate! [(nregs i64) (seed i64)] (-> i64)
  (let [u (machine-unit)
        (mut profile-start) (ms-profile-now)]
    (set! (.allocation-seed u) seed)
    (set! (.allocation-result u) MRA-OK)
    (set! (.allocation-item u) -1)
    (mra-init!)
    (set! profile-start (ms-profile-note! "allocation_init" (load profile-start)))
    (mra-build-intervals!)
    (mra-build-clobber-constraints!)
    (set! profile-start (ms-profile-note! "allocation_intervals" (load profile-start)))
    (if (be-profiling?)
        (do
          (fmt (stderr)
               "AOTK_PROFILE phase=allocation_shape vregs={d} intervals={d} interference_edges=0 adjacency_entries=0\n"
               (ml-vreg-count) (ml-vreg-count))
          0)
        0)
    (mra-build-copy-preferences!)
    (set! profile-start (ms-profile-note! "allocation_preferences" (load profile-start)))
    (let [spills (mra-assign! nregs seed)]
      (set! profile-start (ms-profile-note! "allocation_assign" (load profile-start)))
      ;; Assignment owns fixed-range conflict detection. A failed assignment is not a partial
      ;; product: do not publish locations, build ABI moves, or let verification reset its status.
      (if (= (mra-result) MRA-OK)
          (do
            (mra-reserve-result-pointer-slots!)
            (mra-publish!)
            (set! profile-start (ms-profile-note! "allocation_publish" (load profile-start)))
            (mra-build-abi-parallel-moves!))
          0)
      (let [ok (and (= (mra-result) MRA-OK)
                    (if (be-verification?) (mra-verify!) true))]
        (ms-profile-note! "allocation_verify" (load profile-start))
        (if (not ok)
            (do
              (fmt (stderr) "allocation: verification failed code={d} item={d}\n"
                   (mra-result) (.allocation-item u))
              (if (and (>= (.allocation-item u) 0)
                       (< (.allocation-item u) (ml-vreg-count)))
                  (let [item (.allocation-item u)]
                    (do
                      (fmt (stderr)
                           "allocation: value owner={d} reg={d} spill={d} start={d} end={d}\n"
                           (mra-owner item) (mra-reg item) (mra-spill item)
                           (al-get (.alloc-interval-start u) item)
                           (al-get (.alloc-interval-end u) item))
                      0))
                  0)
              0)
            0)
        (if ok spills -1)))))

;; Greedy coloring over the exact interval interference graph. Values beyond the register budget
;; receive distinct spill slots; lowering treats each slot boundary as a split point.
(defn be-color-linear! [(nregs i64)] (-> i64)
  (let [p (backend)
        n (be-inst-count)
        (mut i) 0]
    (set! (.spills p) 0)
    (let [(mut owner) 0]
      (loop (if (>= (load owner) (mu-function-count))
                (break)
                (do
                  (set! (.frame-size (mu-function (load owner))) 0)
                  (set! owner (+ (load owner) 1))
                  0))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (.reg (be-inst (load i)))
                      (if (= (.op (be-inst (load i))) MI-ARG)
                          (.imm (be-inst (load i)))
                          -1))
                (set! (.spill (be-inst (load i))) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (or (< (.dst m) 0) (= (.op m) MI-ARG))
                      0
                      (let [(mut color) 0
                            (mut found) false]
                        (loop (if (or (>= (load color) nregs) (load found))
                                  (break)
                                  (let [(mut j) 0
                                        (mut conflict) false]
                                    (loop (if (>= (load j) n)
                                              (break)
                                              (do
                                                (let [q (be-inst (load j))]
                                                  (if (and (!= (load j) (load i))
                                                           (and (= (.reg q) (load color))
                                                                (intervals-overlap? m q)))
                                                      (set! conflict true)
                                                      0))
                                                (set! j (+ (load j) 1))
                                                0)))
                                    (if (load conflict) (set! color (+ (load color) 1)) (set! found true)))))
                        (if (load found)
                            (set! (.reg m) (load color))
                            (let [owner (.owner m)]
                              (if (>= owner 0)
                                  (let [slot (.frame-size (mu-function owner))]
                                    (set! (.spill m) slot)
                                    (set! (.frame-size (mu-function owner)) (+ slot 1)))
                                  (do
                                    (set! (.spill m) (.spills p))
                                    (set! (.spills p) (+ (.spills p) 1))
                                    0))))))
                  (set! i (+ (load i) 1))
                  0))))
    (let [funcs (mu-function-count)
          (mut owner) 0]
      (loop (if (>= (load owner) funcs)
                (break)
                (do
                  (let [slots (.frame-size (mu-function (load owner)))
                        bytes (& (+ (+ 16 (* slots 8)) 15) -16)]
                    (set! (.frame-size (mu-function (load owner))) bytes)
                    (set! (.spills p) (+ (.spills p) slots)))
                  (set! owner (+ (load owner) 1))
                  0))))
    (.spills p)))

(defn be-color-seeded! [(nregs i64) (seed i64)] (-> i64)
  (if (and (> (be-inst-count) 0) (>= (ms-inst-owner 0) 0))
      (let [spills (mra-allocate! nregs seed)]
        (set! (.spills (backend)) (if (< spills 0) 0 spills))
        spills)
      (be-color-linear! nregs)))

(defn be-color! [(nregs i64)] (-> i64)
  (be-color-seeded! nregs 0))

; Repack whole function instruction ranges before liveness/allocation. Seeds rotate function text
; order, including moving the exported entry away from offset zero. Block-local scheduled order is
; unchanged.
(defn be-function-layout-seeded! [(seed i64)] (-> i64)
  (let [p (backend)
        u (machine-unit)
        funcs (mu-function-count)
        n (be-inst-count)
        work (field u schedule-work)
        (mut rank) 0
        (mut at) 0]
    (al-clear! [MInst] work)
    (al-clear! [i64] (field u pack-next))
    (al-clear! [i64] (field u pack-term-next))
    (loop (if (>= (load rank) funcs)
              (break)
              (do
                (al-push! [i64] (field u pack-next) 0)
                (al-push! [i64] (field u pack-term-next) 0)
                (set! rank (+ (load rank) 1))
                0)))
    ;; Count once, prefix in seeded owner order, then stable-scatter each function's text. The old
    ;; owner-outer scan was O(functions*instructions) on every publication/layout verification.
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [owner (ms-inst-owner (load at))]
                  (if (and (>= owner 0) (< owner funcs))
                      (al-set! [i64] (field u pack-next) owner
                               (+ (al-get (.pack-next u) owner) 1))
                      0))
                (set! at (+ (load at) 1)))))
    (set! rank 0)
    (let [(mut first) 0]
      (loop (if (>= (load rank) funcs)
                (break)
                (do
                  (let [owner (% (+ (load rank) seed) funcs)
                        count (al-get (.pack-next u) owner)]
                    (al-set! [i64] (field u pack-term-next) owner (load first))
                    (set! first (+ (load first) count)))
                  (set! rank (+ (load rank) 1))))))
    (set! at 0)
    (loop (if (>= (load at) n)
              (break)
              (do
                (al-push! [MInst] work (load (be-inst (load at))))
                (set! at (+ (load at) 1)))))
    (set! at 0)
    (loop (if (>= (load at) n)
              (break)
              (do
                (let [m (be-inst (load at))
                      owner (.owner m)
                      out (al-get (.pack-term-next u) owner)]
                  (al-set! [MInst] work out (load m))
                  (al-set! [i64] (field u pack-term-next) owner (+ out 1)))
                (set! at (+ (load at) 1)))))
    (if (!= (al-len [MInst] (load work)) n)
        -1
        (do
          (al-clear! [MInst] (field p ins))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (al-push! [MInst] (field p ins) (load (be-al-elem [MInst] work (load at))))
                        (set! at (+ (load at) 1))
                        0))))
          (let [(mut bid) 0]
            (loop (if (>= (load bid) (mu-block-count))
                      (break)
                      (do
                        (set! (.inst-first (mu-block (load bid))) -1)
                        (set! (.inst-count (mu-block (load bid))) 0)
                        (set! bid (+ (load bid) 1))
                        0))))
          (let [(mut at) 0]
            (loop (if (>= (load at) n)
                      (break)
                      (do
                        (let [bid (ms-inst-block (load at))]
                          (if (>= bid 0)
                              (let [b (mu-block bid)]
                                (if (< (.inst-first b) 0)
                                    (set! (.inst-first b) (load at))
                                    0)
                                (set! (.inst-count b) (+ (.inst-count b) 1)))
                              0))
                        (set! at (+ (load at) 1))
                        0)))
            ;; Function layout republishes every machine-instruction index. Call bundles are an
            ;; indexed machine descriptor, so publishing the new order and leaving their reverse
            ;; map behind would make allocation and encoding consume a descriptor for the old
            ;; program. Rebuild and verify at the same publication boundary as block ranges.
            (if (and (ms-build-call-bundles!) (ms-call-bundles-valid?)) n -1))))))

(defn be-spills [] (-> i64)
  (.spills (backend)))

(defn be-verify-abi! [] (-> i64)
  (let [funcs (mu-function-count)
        n (be-inst-count)
        (mut owner) 0
        (mut at) 0
        (mut result) MABI-OK]
    (loop (if (or (>= (load owner) funcs) (!= (load result) MABI-OK))
              (break)
              (do
                (let [frame (mu-function-frame-size (load owner))]
                  (if (or (< frame 16) (!= (& frame 15) 0)) (set! result MABI-FRAME) 0))
                (set! owner (+ (load owner) 1))
                0)))
    (loop (if (or (>= (load at) n) (!= (load result) MABI-OK))
              (break)
              (do
                (let [m (be-inst (load at))
                      op (.op m)
                      own (.owner m)
                      spill (.spill m)]
                  (if (and (>= own 0) (>= spill 0))
                      (if (> (+ 16 (* (+ (mu-function-callee-count own) (+ spill 1)) 8))
                             (mu-function-frame-size own))
                          (set! result MABI-SPILL)
                          0)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (or (and (= op MI-ARG)
                                    (or (< (.imm m) 0) (>= (.imm m) 8)))
                               (and (= op MI-STACKARG)
                                    (or (< (.imm m) 0) (>= (.imm m) 16)))))
                      (set! result MABI-ARGUMENT)
                      0)
                  (if (and (= (load result) MABI-OK)
                           (and (> (ms-inst-arg-count (load at)) 0)
                                (not (ms-call-args-valid? (load at)))))
                      (set! result MABI-ARGUMENT)
                      0))
                (set! at (+ (load at) 1))
                0)))
    (load result)))

(defn be-corrupt-frame-size! [(owner i64) (bytes i64)] (-> i64)
  (set! (.frame-size (mu-function owner)) bytes)
  0)
(defn be-corrupt-spill-slot! [(at i64) (slot i64)] (-> i64)
  (set! (.spill (be-inst at)) slot)
  (set! (.reg (be-inst at)) -1)
  0)
(defn be-corrupt-arg-index! [(at i64) (idx i64)] (-> i64)
  (set! (.imm (be-inst at)) idx)
  0)

(defn be-falsify-shift-mask-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))
(defn be-falsify-unsigned-shift-ptr [] (-> (ptr bool))
  (let [enabled (primitive/alloc-static bool)] enabled))
; Focused phase tests use this after coloring to exercise lowering's spill boundary independent of
; the later CFG allocator milestone. Every definition of a Phi vreg must name the same location.
(defn be-force-spill-vreg! [(vreg i64) (slot i64)] (-> i64)
  (let [n (be-inst-count)
        (mut i) 0
        (mut owner) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [m (be-inst (load i))]
                  (if (= (.dst m) vreg)
                      (do
                        (set! (.reg m) -1)
                        (set! (.spill m) slot)
                        (set! owner (.owner m))
                        0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (<= (.spills (backend)) slot)
        (set! (.spills (backend)) (+ slot 1))
        0)
    (if (>= (load owner) 0)
        (let [need
                (& (+ (+ 16
                         (* (+ (mu-function-callee-count (load owner))
                               (+ slot 1))
                            8))
                      15)
                   -16)]
          (if (< (mu-function-frame-size (load owner)) need)
              (set! (.frame-size (mu-function (load owner))) need)
              0))
        0)
    0))

; AArch64 word encoders used by lowering.
