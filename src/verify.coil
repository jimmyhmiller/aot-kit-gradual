;; The graph verifier: is this graph well formed, and are its types at a fixpoint.
;;
;; DESIGN.md section 8 wants a verifier runnable after any phase, and DECISIONS.md D2 makes it
;; the mechanism the GC invariants R1 and R2 land in at M8, so its shape is set here rather than
;; improvised later. M3's gate is that it is GREEN on the whole corpus and RED on a set of
;; deliberately corrupted graphs, because a verifier that never fails is not a verifier.
;;
;; ONE NAMED CODE PER CHECK, and `g-verify` records the first one it hit. That is what stops the
;; corrupted-graph half of the gate from being vacuous: "verify returned non-zero" is satisfied
;; by a verifier that always fails, whereas "corrupting the phi/region lockstep reports
;; VERR-PHI-ARITY" is a claim about a specific check being the one that noticed.
;;
;; IT RUNS `compute` AND NEVER `idealize`, and that is the central design constraint here rather
;; than a detail. Simple's equivalent assertion re-peepholes the graph, which it can afford
;; because its `idealize` is pure. Here it is not: `region-remove-path!` deletes edges and
;; `stop-idealize` deletes an input, both mutating before they return. A verifier that checked
;; "no node is peephole-reducible" would therefore silently TRANSFORM the graph it was
;; verifying, which is the worst bug a checker can have. `compute` is not free of side effects
;; either (`phi-compute` records a dependency), which is what the `verifying` flag in node.coil
;; exists for.
;;
;; The one thing left out is a "no node is reducible" check. It is not implementable without
;; running idealize, and the peephole fixpoint is already gated by the golden tests.
(module verify)

(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "ty" :use *)
(import "shape" :use *)  ; a New's shape and a memory op's alias are checked against it
(import "node" :use *)

; ============================================================================
; Failure codes
; ============================================================================
(const VERR-NONE i64 0)  ; no violation

;; A graph mid-construction is not claimed to be well formed at all, so this is a PRECONDITION
;; and not a finding: an open merge has a null final input, reports CONTROL rather than the meet
;; of its paths, and every Phi on it reports its declared type. Verifying one would trip arity,
;; slot and stale-type checks at once and bury whatever the caller was actually looking for.
(const VERR-IN-PROGRESS i64 1)

(const VERR-EDGE-ASYM i64 2)  ; def-use and use-def disagree, multiplicity included
(const VERR-DEAD-INPUT i64 3)  ; a live node reads a dead one
(const VERR-DEAD-HAS-INS i64 4)  ; a dead node still holds inputs (n-kill! clears them)
(const VERR-ARITY i64 5)  ; wrong number of inputs for the op
(const VERR-MERGE-IN0 i64 6)  ; a Region/Loop whose input 0 is not null
(const VERR-PHI-REGION i64 7)  ; a Phi whose input 0 is not a merge
(const VERR-PHI-ARITY i64 8)  ; phi and region are out of lockstep
(const VERR-CTRL-SLOT i64 9)  ; a slot that must hold control does not
(const VERR-DATA-SLOT i64 10)  ; a slot that must hold a value holds control
(const VERR-PROJ-SLOT i64 11)  ; a projection off a non-multi node, or a slot out of range
(const VERR-STOP-INPUT i64 12)  ; a Stop input that is not a Return
(const VERR-STALE-TYPE i64 13)  ; n-ty differs from n-compute: the types are not at fixpoint
(const VERR-LEAK i64 14)  ; a live node nothing can reach

;; A slot that must hold a MEMORY state does not. It is its own code rather than an instance of
;; VERR-DATA-SLOT because the failure it catches is different in kind: an ordinary value in a
;; memory slot type-checks all the way through (`ty-mem-contents` answers ALL for it, so every
;; load below reports "could be anything"), the graph stays internally consistent, and the only
;; symptom is that memory silently stopped being tracked.
(const VERR-MEM-SLOT i64 15)
(const VERR-SHAPE i64 16)  ; a New whose aux is not a defined shape id
(const VERR-ALIAS i64 17)  ; a Load or Store whose aux is not an allocated alias number

;; A LOAD OR STORE WHOSE POINTER CANNOT BE A MANAGED REFERENCE. This is R1 (D2) made checkable,
;; and until now it held only because nothing in the IR was NAMED an address: the pointer slot
;; asks `v-need-value`, which is satisfied by any op at or past OPTAG-CONST, so `Load(mem, Const
;; int=8)` and `Load(mem, Add(o, 8))` both build, verify, round trip and run. D2 claims both GC
;; rules are machine-checked on every phase; that claim was not true for R1, and the moment M8's
;; safepoints or any address-computing lowering exists there would be nothing to go red.
;;
;; IT IS A TYPE CHECK AND SO IT LIVES IN THE TYPE PASS, which runs last and only on an otherwise
;; clean graph. A structural whitelist in the style of `v-mem-producer?` is not available here:
;; unlike a memory state, a reference is an ORDINARY value, and an Arg, a Phi, a Cast and another
;; Load (`o.y.x`) are all legitimate producers, so there is no finite producer set to enumerate.
;;
;; It ABSTAINS on a high pointer, which is the same optimistic case `load-compute` special-cases:
;; nothing reaches this access, so there is no pointer to object to. Otherwise the pointer must be
;; an object and NOTHING ELSE (`ty-only-obj?`): "could be an object" would accept `dyn`, and
;; `arith-compute` types `o + 8` as exactly that, so the weaker form accepts the address
;; arithmetic R1 exists to keep out. It deliberately does NOT ask which SHAPES: that question
;; belongs to the interpreter, which is what EV-SHAPE is, and to M9's guards. See DECISIONS.md D13
;; for what M5 owes here.
(const VERR-PTR-SLOT i64 18)

;; A MEMORY STATE IN A SLOT THAT MUST HOLD A VALUE: the mirror of VERR-MEM-SLOT, and its own code
;; for the same reason that one is. See `v-need-value` for why nothing caught it before.
(const VERR-VALUE-IS-MEM i64 19)
(const VERR-SAFEPOINT-INTERIOR i64 20)
(const VERR-PRE-SAFEPOINT-REF i64 21)
(const VERR-CALL-TAG i64 22)
(const VERR-CALL-ARITY i64 23)
(const VERR-CLOSURE-LAYOUT i64 24)
(const VERR-CALL-TARGETS i64 25)
(const VERR-CALL-RECEIVER i64 26)
(const VERR-CALL-RECEIVER-TAG i64 27)

;; A value edge whose producer and consumer disagree about machine REPRESENTATION — a tagged
;; NaN-boxed word where a raw pointer belongs, a raw pointer in a tagged slot, float bits fed
;; to an integer op. Nearly every hard bug in the NavierStokes campaign was an instance; the
;; classification is structural and only certain disagreements fail (see n-rep-of in node.coil).
(const VERR-REPRESENTATION i64 28)

(defn verr-name [(c i64)] (-> (slice u8))
  (case c VERR-NONE
        "VERR-NONE" VERR-IN-PROGRESS
        "VERR-IN-PROGRESS" VERR-EDGE-ASYM
        "VERR-EDGE-ASYM" VERR-DEAD-INPUT
        "VERR-DEAD-INPUT" VERR-DEAD-HAS-INS
        "VERR-DEAD-HAS-INS" VERR-ARITY
        "VERR-ARITY" VERR-MERGE-IN0
        "VERR-MERGE-IN0" VERR-PHI-REGION
        "VERR-PHI-REGION" VERR-PHI-ARITY
        "VERR-PHI-ARITY" VERR-CTRL-SLOT
        "VERR-CTRL-SLOT" VERR-DATA-SLOT
        "VERR-DATA-SLOT" VERR-PROJ-SLOT
        "VERR-PROJ-SLOT" VERR-STOP-INPUT
        "VERR-STOP-INPUT" VERR-STALE-TYPE
        "VERR-STALE-TYPE" VERR-LEAK
        "VERR-LEAK" VERR-MEM-SLOT
        "VERR-MEM-SLOT" VERR-SHAPE
        "VERR-SHAPE" VERR-ALIAS
        "VERR-ALIAS" VERR-PTR-SLOT
        "VERR-PTR-SLOT" VERR-VALUE-IS-MEM
        "VERR-VALUE-IS-MEM" VERR-SAFEPOINT-INTERIOR
        "VERR-SAFEPOINT-INTERIOR" VERR-PRE-SAFEPOINT-REF
        "VERR-PRE-SAFEPOINT-REF" VERR-CALL-TAG
        "VERR-CALL-TAG" VERR-CALL-ARITY
        "VERR-CALL-ARITY" VERR-CLOSURE-LAYOUT
        "VERR-CLOSURE-LAYOUT" VERR-CALL-TARGETS
        "VERR-CALL-TARGETS" VERR-CALL-RECEIVER
        "VERR-CALL-RECEIVER" VERR-CALL-RECEIVER-TAG
        "VERR-CALL-RECEIVER-TAG" VERR-REPRESENTATION
        "VERR-REPRESENTATION" "VERR-?"))

; ============================================================================
; The last run's result
; ============================================================================
;; Only the FIRST failure is kept, with the node it was found on. Keeping every one would need a
;; growable list on a struct that has no owner, and a caller that wants the rest can fix the
;; first and run again, which is the loop you are in anyway.
(defstruct Verify
  [(count i64)
   (code i64)
   (node i64)])

(defn verify-state [] (-> (ptr Verify))
  (alloc/static Verify))

(defn g-verify-count [] (-> i64)
  (load (field (verify-state) count)))
(defn g-verify-code [] (-> i64)
  (load (field (verify-state) code)))
(defn g-verify-node [] (-> i64)
  (load (field (verify-state) node)))

(defn v-reset! [] (-> i64)
  (let [p (verify-state)]
    (store! (field p count) 0)
    (store! (field p code) VERR-NONE)
    (store! (field p node) NO-NODE)
    0))

(defn v-fail! [(code i64) (n i64)] (-> i64)
  (let [p (verify-state)]
    (if (= (load (field p count)) 0)
        (do (store! (field p code) code) (store! (field p node) n) 0)
        0)
    (store! (field p count) (+ (load (field p count)) 1))
    0))

(defn v-need [(ok bool) (code i64) (n i64)] (-> i64)
  (if ok 0 (v-fail! code n)))

(defn g-verify-print [(w (ptr Writer))] (-> i64)
  (let [p (verify-state)]
    (if (= (load (field p count)) 0)
        (ps w "verify: clean\n")
        (do
          (fmt w "verify: {d} violation(s), first " (load (field p count)))
          (ps w (verr-name (load (field p code))))
          (fmt w " at n{d}\n" (load (field p node)))
          0))))

; ============================================================================
; Edge symmetry
; ============================================================================
;; MULTIPLICITY MATTERS. `phi(r, x, x)` legitimately holds the same def twice, so the two
;; directions are MULTISETS and comparing "does it appear at all" would miss a `del-def!` that
;; removed one copy of an edge and left the other. That is precisely the bug that makes a phi
;; read the wrong arm.
(defn v-count-ins [(u i64) (d i64)] (-> i64)
  (let [len (n-nins u)
        (mut i) 0
        (mut c) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (if (= (n-in u (load i)) d) (store! c (+ (load c) 1)) 0)
                (store! i (+ (load i) 1))
                0)))
    (load c)))

(defn v-count-outs [(d i64) (u i64)] (-> i64)
  (let [len (n-nouts d)
        (mut i) 0
        (mut c) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (if (= (n-out d (load i)) u) (store! c (+ (load c) 1)) 0)
                (store! i (+ (load i) 1))
                0)))
    (load c)))

;; The index of the first occurrence of `u` in `d`'s outputs, or NO-NODE. Used only to visit
;; each distinct pair once, so a mismatch is one violation and not one per duplicated edge.
(defn v-first-out [(d i64) (u i64)] (-> i64)
  (let [len (n-nouts d)
        (mut i) 0
        (mut at) NO-NODE]
    (loop (if (or (>= (load i) len) (!= (load at) NO-NODE))
              (break)
              (do
                (if (= (n-out d (load i)) u) (store! at (load i)) 0)
                (store! i (+ (load i) 1))
                0)))
    (load at)))

(defn v-check-edges [(u i64)] (-> i64)
  ; use-def side: for each distinct def this node reads, the two multiplicities must agree
  (let [len (n-nins u)
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [d (n-in u (load i))]
                  (if (or (= d NO-NODE) (!= (n-find-in u d) (load i)))
                      0
                      (v-need (= (v-count-ins u d) (v-count-outs d u)) VERR-EDGE-ASYM u)))
                (store! i (+ (load i) 1))
                0))))
  ; def-use side, for the case the loop above cannot see: an out edge u->x where x does not
  ; read u at all. Walking inputs finds nothing to compare, so it has to be walked from here.
  ; A dead x lands here too, since `n-kill!` clears its inputs: a dead node must not be
  ; anybody's listed user.
  (let [len (n-nouts u)
        (mut k) 0]
    (loop (if (>= (load k) len)
              (break)
              (do
                (let [x (n-out u (load k))]
                  (if (!= (v-first-out u x) (load k))
                      0
                      (v-need (> (v-count-ins x u) 0) VERR-EDGE-ASYM u)))
                (store! k (+ (load k) 1))
                0))))
  0)

; ============================================================================
; Arity
; ============================================================================
;; The per-op input contract. `Stop` is the only genuinely variable one (it collects Returns and
;; may end up with none), and `Region`/`Phi` are variable above a floor because a merge's path
;; count is the program's, not the op's.
;;
;; An op with no entry here is an ERROR rather than a default, because a new op silently
;; inheriting "three inputs" is how a verifier stops verifying the thing it was added for.
(defn v-check-arity [(n i64)] (-> i64)
  (let [k (n-nins n)]
    (match (n-op n)
      (Start [] (v-need (= k 0) VERR-ARITY n))
      (XCtrl [] (v-need (= k 0) VERR-ARITY n))
      (Stop [] 0)
      (Return [] (v-need (or (= k 2) (= k 3)) VERR-ARITY n))
      (If [] (v-need (= k 2) VERR-ARITY n))
      (Region [] (v-need (>= k 2) VERR-ARITY n))
      (Loop [] (v-need (= k 3) VERR-ARITY n))
      (CProj [slot] (v-need (= k 1) VERR-ARITY n))
      (Proj [slot] (v-need (= k 1) VERR-ARITY n))
      (Const [ty] (v-need (= k 1) VERR-ARITY n))
      (Arg [ty] (v-need (= k 1) VERR-ARITY n))
      (Phi [declared] (v-need (>= k 2) VERR-ARITY n))
      (Cast [target] (v-need (= k 2) VERR-ARITY n))
      (Box [mode] (v-need (= k 2) VERR-ARITY n))
      (Unbox [target] (v-need (= k 2) VERR-ARITY n))
      (TypeTest [target] (v-need (= k 2) VERR-ARITY n))
      (CallEnd [] (v-need (= k 2) VERR-ARITY n))
      (Fun [index] (v-need (>= k 2) VERR-ARITY n))
      (Parm [index] (v-need (= k 1) VERR-ARITY n))
      (Call [abi] (v-need (>= k 2) VERR-ARITY n))
      (FunStart [] (v-need (= k 1) VERR-ARITY n))
      (Closure [captures] (v-need (>= k 1) VERR-ARITY n))
      (Safepoint [] (v-need (>= k 1) VERR-ARITY n))
      (Barrier [] (v-need (= k 4) VERR-ARITY n))
      (Minus [] (v-need (= k 2) VERR-ARITY n))
      (Not [] (v-need (= k 2) VERR-ARITY n))
      (BitNot [] (v-need (= k 2) VERR-ARITY n))
          ;; A NEW'S ARITY IS ITS SHAPE'S, which is why the shape is checked first and the count is
          ;; not checked at all when it is wrong: `shape-field-count` aborts by name on an undefined
          ;; id, and an abort inside the verifier would take the process with it on exactly the
          ;; corrupted graph the verifier exists to report on.
      (New [shape]
            (if (not (shape-defined? shape))
                (v-fail! VERR-SHAPE n)
                (v-need (= k (+ 1 (shape-field-count shape))) VERR-ARITY n)))
      (Load [alias]
            (do
              (v-need (shape-alias-defined? alias) VERR-ALIAS n)
              (v-need (= k 3) VERR-ARITY n)
              0))
      (Store [alias]
            (do
              (v-need (shape-alias-defined? alias) VERR-ALIAS n)
              (v-need (= k 4) VERR-ARITY n)
              0))
      (PropLoad [name]
            (do
              (v-need (and (>= name 0) (< name (shape-name-count))) VERR-ALIAS n)
              (v-need (= k 3) VERR-ARITY n)
              0))
      (PropHas [name]
            (do
              (v-need (and (>= name 0) (< name (shape-name-count))) VERR-ALIAS n)
              (v-need (= k 3) VERR-ARITY n)
              0))
      (PropDelete [name]
            (do
              (v-need (and (>= name 0) (< name (shape-name-count))) VERR-ALIAS n)
              (v-need (= k 3) VERR-ARITY n)
              0))
      (ProtoHas [] (v-need (= k 4) VERR-ARITY n))
      (PropLoadKey [] (v-need (= k 4) VERR-ARITY n))
      (PropStoreKey [] (v-need (= k 5) VERR-ARITY n))
      (PropHasKey [] (v-need (= k 4) VERR-ARITY n))
      (PropDeleteKey [] (v-need (= k 4) VERR-ARITY n))
      (OwnKeyCount [] (v-need (= k 3) VERR-ARITY n))
      (OwnKeyAt [] (v-need (= k 4) VERR-ARITY n))
      (ObjectFreeze [] (v-need (= k 3) VERR-ARITY n))
      (InternalLoad [slot]
        (do (v-need (and (>= slot INTERNAL-TARGET) (<= slot INTERNAL-KIND)) VERR-ARITY n)
            (v-need (= k 3) VERR-ARITY n) 0))
      (InternalStore [operation]
        (do (v-need (or (= operation INTERNAL-INIT) (= operation INTERNAL-SET-INDEX)) VERR-ARITY n)
            (v-need (= k (if (= operation INTERNAL-INIT) 5 4)) VERR-ARITY n) 0))
      (PropStore [name]
            (do
              (v-need (and (>= name 0) (< name (shape-name-count))) VERR-ALIAS n)
              (v-need (= k 4) VERR-ARITY n)
              0))
      (SetProto [] (v-need (= k 4) VERR-ARITY n))
      (ArrayMark [] (v-need (= k 2) VERR-ARITY n))
      (ArrayLoad [alias] (v-need (= k 4) VERR-ARITY n))
      (ArrayStore [] (v-need (= k 5) VERR-ARITY n))
      (ArrayLen [] (v-need (= k 3) VERR-ARITY n))
      (ArrayResize [] (v-need (= k 5) VERR-ARITY n))
      (ArrayCopy [] (v-need (= k 5) VERR-ARITY n))
      (StringConst [id] (v-need (= k 1) VERR-ARITY n))
      (StringLen [] (v-need (= k 2) VERR-ARITY n))
      (StringEq [] (v-need (= k 3) VERR-ARITY n))
      (StringConcat [] (v-need (= k 3) VERR-ARITY n))
      (StringCharCode [] (v-need (= k 3) VERR-ARITY n))
      (StringSubstring [mode] (v-need (= k 4) VERR-ARITY n))
      (ToString [] (v-need (= k 2) VERR-ARITY n))
      (ToInteger [] (v-need (= k 2) VERR-ARITY n))
      (ToNumber [] (v-need (= k 2) VERR-ARITY n))
      (ArrayTest [] (v-need (= k 2) VERR-ARITY n))
      (ArrayUnbox [] (v-need (= k 2) VERR-ARITY n))
      (ParseFloat [] (v-need (= k 2) VERR-ARITY n))
      (ParseInt [] (v-need (= k 3) VERR-ARITY n))
      (IsNaN [] (v-need (= k 2) VERR-ARITY n))
      (StringSplit [] (v-need (= k 5) VERR-ARITY n))
      (StringFromCodeUnit [] (v-need (= k 2) VERR-ARITY n))
      (NumberToString [] (v-need (= k 3) VERR-ARITY n))
      (ToFixed [] (v-need (= k 3) VERR-ARITY n))
      (StringLower [] (v-need (= k 2) VERR-ARITY n))
      (StringUpper [] (v-need (= k 2) VERR-ARITY n))
      (StringIndexOf [] (v-need (= k 4) VERR-ARITY n))
      (StringCompare [] (v-need (= k 3) VERR-ARITY n))
      (StringNormalize [] (v-need (= k 3) VERR-ARITY n))
      (JsBuiltin [descriptor] (v-need (= k 3) VERR-ARITY n))
      (JsThrow [] (v-need (= k 2) VERR-ARITY n))
      (MemMerge [] (v-need (>= k 2) VERR-ARITY n))
      (Add [] (v-need (= k 3) VERR-ARITY n))
      (Sub [] (v-need (= k 3) VERR-ARITY n))
      (Mul [] (v-need (= k 3) VERR-ARITY n))
      (Div [] (v-need (= k 3) VERR-ARITY n))
      (Eq [] (v-need (= k 3) VERR-ARITY n))
      (Lt [] (v-need (= k 3) VERR-ARITY n))
      (Le [] (v-need (= k 3) VERR-ARITY n))
      (Mod [] (v-need (= k 3) VERR-ARITY n))
      (BitAnd [] (v-need (= k 3) VERR-ARITY n))
      (BitOr [] (v-need (= k 3) VERR-ARITY n))
      (BitXor [] (v-need (= k 3) VERR-ARITY n))
      (Shl [] (v-need (= k 3) VERR-ARITY n))
      (Shr [] (v-need (= k 3) VERR-ARITY n))
      (UShr [] (v-need (= k 3) VERR-ARITY n)))))

;; How many slots a multi-output node's tuple has. Only meaningful for a multi node, so asking
;; about anything else is a caller bug rather than a question with a harmless answer.
;;
;; IT TAKES THE NODE AND NOT THE OP, because two of the three answers are not functions of the op:
;; a New's tuple is one slot per field of ITS shape, and a Return's is two or three depending on
;; whether it carries memory. Asking the op alone would have to pick one, and a projection checked
;; against the wrong arity is either a false report or a missed one.
(defn v-multi-arity [(n i64)] (-> i64)
  (match (n-op n)
    (If [] 2)
    (Return [] (n-nins n))
    (New [shape]
        (if (shape-defined? shape)
            (+ 1 (shape-field-count shape))
            ; the arity pass already reported VERR-SHAPE; no slot index can be in range
            0))
    (Safepoint [] (n-nins n))
    (_ (do (panic-corrupt "v-multi-arity: not a multi-output op") 0))))

; ============================================================================
; Slots
; ============================================================================
;; A MISSING slot counts as that slot's violation. "Input 0 does not hold control" is what
;; VERR-CTRL-SLOT means, and a null is the degenerate case of it; giving absence its own code
;; would double up with VERR-ARITY, which already reports the count.
(defn v-need-ctrl [(n i64) (i i64)] (-> i64)
  (if (>= i (n-nins n))
      (v-fail! VERR-CTRL-SLOT n)
      (let [d (n-in n i)]
        (v-need (and (!= d NO-NODE) (op-control? (n-op d))) VERR-CTRL-SLOT n))))

;; A slot that must hold a MEMORY STATE, decided STRUCTURALLY. It would be shorter to ask
;; `ty-mem?` of the input's computed type, and it would be wrong here for the reason the pass
;; order at the bottom of this file already states: `v-pass-structure` runs BEFORE the types are
;; evidence of anything, and on a graph that is still settling every memory edge legitimately
;; reports ANY. So the question is which nodes can produce memory at all, and that is a fact about
;; the graph's shape:
;;
;;   Proj      of a New, at slot 1 or later; slot 0 is the OBJECT and is an ordinary value
;;   Store     its whole result
;;   MemMerge  likewise
;;   Phi / Arg when their DECLARED type (aux, which no analysis writes) is a memory type
;;
;; An Arg is on that list because a declared memory state is how memory ENTERS a graph: the
;; program's initial heap is empty, a function's incoming memory is its caller's, and both are
;; opaque values of a declared type, which is exactly what an Arg is.
;;
;; THE SLOT NUMBER IS PART OF THE ANSWER and it did not used to be. A New's slot 0 is the object,
;; which is the pointer every Load and Store reads, so "any Proj of a New is memory" was harmless
;; only while this predicate had one direction: now that `v-need-value` rejects a memory producer,
;; it would report every store's own pointer as a memory state in a value slot.
(defn v-mem-producer? [(d i64)] (-> bool)
  (match (n-op d)
    (Proj [slot]
      (and (>= (n-nins d) 1)
           (let [parent (n-in d 0)]
             (and (!= parent NO-NODE)
                  (match (n-op parent) (New [shape] (>= slot 1)) (_ false))))))
    (Store [alias] true)
    (PropStore [name] true)
    (PropDelete [name] true)
    (PropStoreKey [] true)
    (PropDeleteKey [] true)
    (ObjectFreeze [] true)
    (InternalStore [operation] true)
    (SetProto [] true)
    (ArrayStore [] true)
    (ArrayResize [] true)
    (ArrayCopy [] true)
    (StringSplit [] true)
    (MemMerge [] true)
    (Barrier [] true)
    (Phi [declared] (ty-mem? declared))
    (Arg [ty] (ty-mem? ty))
    (_ false)))

;; THE MIRROR OF `v-need-mem`, AND IT IS NOT SYMMETRIC BY ACCIDENT. `op-value?` is `>= OPTAG-CONST`
;; and Store is 24, MemMerge 25, so every memory producer already satisfied the value test: a
;; memory state parked in an If's predicate, a Return's value, a binop's operand or a Store's
;; value slot verified CLEAN. src/eval.coil documents that hole for the If predicate and works
;; around it at run time with `rt-condition?`; the Store's value slot had no such backstop and
;; reached the lattice instead, where it minted a memory type nested inside a memory type and
;; aborted the printer.
;;
;; It is decided structurally for exactly the reason `v-mem-producer?` gives: this pass runs
;; before types are evidence, so the question is which nodes can PRODUCE memory, and the same
;; predicate answers both directions.
(defn v-need-value [(n i64) (i i64)] (-> i64)
  (if (>= i (n-nins n))
      (v-fail! VERR-DATA-SLOT n)
      (let [d (n-in n i)]
        (if (and (!= d NO-NODE) (v-mem-producer? d))
            (v-fail! VERR-VALUE-IS-MEM n)
            (v-need (and (!= d NO-NODE) (op-value? (n-op d))) VERR-DATA-SLOT n)))))

(defn v-need-mem [(n i64) (i i64)] (-> i64)
  (if (>= i (n-nins n))
      (v-fail! VERR-MEM-SLOT n)
      (let [d (n-in n i)]
        (v-need (and (!= d NO-NODE) (v-mem-producer? d)) VERR-MEM-SLOT n))))

(defn v-need-mem-from [(n i64) (lo i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) lo]
    (loop (if (>= (load i) len)
              (break)
              (do (v-need-mem n (load i)) (store! i (+ (load i) 1)) 0))))
  0)

(defn v-need-ctrl-from [(n i64) (lo i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) lo]
    (loop (if (>= (load i) len)
              (break)
              (do (v-need-ctrl n (load i)) (store! i (+ (load i) 1)) 0))))
  0)

(defn v-need-value-from [(n i64) (lo i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) lo]
    (loop (if (>= (load i) len)
              (break)
              (do (v-need-value n (load i)) (store! i (+ (load i) 1)) 0))))
  0)

;; Calls may carry one final heap version as an effect dependency. It is not an ABI argument,
;; and memory anywhere else in the argument list remains a value-slot violation.
(defn v-need-call-args [(n i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) 2]
    (loop (if (>= (load i) len)
              (break)
              (do
                (if (and (= (load i) (- len 1))
                         (v-mem-producer? (n-in n (load i))))
                    (v-need-mem n (load i))
                    (v-need-value n (load i)))
                (store! i (+ (load i) 1))
                0))))
  0)

;; A merge's slot 0 is unused by construction: `region-compute` starts its meet at 1, and a node
;; in that slot would be a use nothing reads, which is how a stale edge survives a rewrite.
(defn v-check-merge [(n i64)] (-> i64)
  (if (>= (n-nins n) 1) (v-need (= (n-in n 0) NO-NODE) VERR-MERGE-IN0 n) 0)
  (v-need-ctrl-from n 1))

;; LAW: region and phi arity are ONE invariant. Checked here as the equality it is, because the
;; failure it catches (a phi reading the arm of a path that was dropped) is a miscompile that
;; typechecks cleanly and shows up in no golden string.
(defn v-check-phi [(n i64)] (-> i64)
  (match (n-op n)
    (Phi [declared]
      (let [r (if (>= (n-nins n) 1) (n-in n 0) NO-NODE)]
        (if (or (= r NO-NODE) (not (op-merge? (n-op r))))
            (v-fail! VERR-PHI-REGION n)
            (do
              (v-need (= (n-nins n) (n-nins r)) VERR-PHI-ARITY n)
          ;; A MEMORY PHI'S ARMS ARE MEMORY, and which kind of Phi this is is its DECLARED type,
          ;; which no analysis writes. Before `v-need-value` learned to reject a memory producer
          ;; the two cases were one line, because every memory producer is also a value op by the
          ;; numbering; now they have to be told apart, and telling them apart is a strictly
          ;; better check in both directions.
              (if (ty-mem? declared) (v-need-mem-from n 1) (v-need-value-from n 1))
              0))))
    (_ (do (panic-corrupt "v-check-phi: not a Phi") 0))))

;; A projection reads a slot of a tuple, so its parent has to actually produce one and the slot
;; has to exist. `aux` is the slot index, and an out-of-range one would have `proj-compute`
;; reporting ALL, which reads as "anything at all" rather than as the error it is.
(defn v-check-proj [(n i64)] (-> i64)
  (let [m (if (>= (n-nins n) 1) (n-in n 0) NO-NODE)
        idx (match (n-op n) (CProj [slot] slot) (Proj [slot] slot) (_ -1))]
    (if (or (= m NO-NODE) (not (op-multi? (n-op m))))
        (v-fail! VERR-PROJ-SLOT n)
        (v-need (and (>= idx 0) (< idx (v-multi-arity m))) VERR-PROJ-SLOT n))))

;; Stop collects Returns and nothing else. Anything else in there means some rewrite pointed the
;; program's exit at a node that does not end a path.
(defn v-check-stop [(n i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [d (n-in n (load i))]
                  (v-need (and (!= d NO-NODE) (v-return-node? d)) VERR-STOP-INPUT n))
                (store! i (+ (load i) 1))
                0))))
  0)

;; Which slots must hold what, per op.
;;
;; Slot 0 of a floating data node (an Add, a Minus) is the control anchor and is unconstrained:
;; it is null today and will hold control once a division has to be pinned to the block that
;; proved its divisor non-zero. Constraining it now would encode "always null" as a law, and
;; that is not the law.
(defn v-call-node? [(n i64)] (-> bool)
  (match (n-op n) (Call [abi] true) (_ false)))
(defn v-fun-node? [(n i64)] (-> bool)
  (match (n-op n) (Fun [index] true) (_ false)))
(defn v-funstart-node? [(n i64)] (-> bool)
  (match (n-op n) (FunStart [] true) (_ false)))
(defn v-return-node? [(n i64)] (-> bool)
  (match (n-op n) (Return [] true) (_ false)))

(defn v-check-slots [(n i64)] (-> i64)
  (match (n-op n)
    (Start [] 0)
    (XCtrl [] 0)
    (Stop [] (v-check-stop n))
    (Return [] (do
            (v-need-ctrl n 0)
            (v-need-value n 1)
            (if (>= (n-nins n) 3) (v-need-mem n 2) 0)
            0))
    (If [] (do (v-need-ctrl n 0) (v-need-value n 1) 0))
    (Region [] (v-check-merge n))
    (Loop [] (v-check-merge n))
    (CProj [slot] (v-check-proj n))
    (Proj [slot] (v-check-proj n))
    (Const [ty] (v-need-ctrl n 0))
    (Arg [ty] (v-need-ctrl n 0))
    (Phi [declared] (v-check-phi n))
    (Cast [target] (do (v-need-ctrl n 0) (v-need-value n 1) 0))
    (Box [mode] (do
            (if (= (n-in n 0) NO-NODE) 0 (v-need-ctrl n 0))
            (v-need-value n 1)
            0))
    (Unbox [target] (do
            (if (= (n-in n 0) NO-NODE) 0 (v-need-ctrl n 0))
            (v-need-value n 1)
            0))
    (TypeTest [target] (do
            (if (= (n-in n 0) NO-NODE) 0 (v-need-ctrl n 0))
            (v-need-value n 1)
            0))
    (CallEnd [] (do
            (v-need-ctrl n 0)
            (v-need (v-call-node? (n-in n 1)) VERR-DATA-SLOT n)
            0))
    (Fun [index] (let [(mut i) 1]
            (v-need (v-funstart-node? (n-in n 0)) VERR-CTRL-SLOT n)
            (loop (if (>= (load i) (n-nins n))
                      (break)
                      (do
                        (v-need (v-return-node? (n-in n (load i))) VERR-DATA-SLOT n)
                        (store! i (+ (load i) 1))
                        0)))
            0))
    (Parm [index] (v-need (v-fun-node? (n-in n 0)) VERR-DATA-SLOT n))
    (Call [abi] (do (v-need-ctrl n 0) (v-need-value n 1) (v-need-call-args n) 0))
    (FunStart [] (v-need (v-fun-node? (n-in n 0)) VERR-DATA-SLOT n))
    (Closure [captures] (do
            (v-need (v-fun-node? (n-in n 0)) VERR-DATA-SLOT n)
            (v-need-value-from n 1)
            0))
    (Safepoint [] (do (v-need-ctrl n 0) (v-need-value-from n 1) 0))
    (Barrier [] (do
            (v-need-ctrl n 0)
            (v-need-mem n 1)
            (v-need-value n 2)
            (v-need-value n 3)
            0))
    (Minus [] (v-need-value n 1))
    (Not [] (v-need-value n 1))
    (BitNot [] (v-need-value n 1))
          ;; A New's control input is REAL, unlike a Load's or a Store's slot 0: two executions of an
          ;; allocation are two objects, so it cannot float out of the block it is in. Everything from
          ;; slot 1 is the incoming memory of one field, in field order.
    (New [shape] (do (v-need-ctrl n 0) (v-need-mem-from n 1) 0))
    (Load [alias] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (Store [alias] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (PropLoad [name] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (PropHas [name] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (PropDelete [name] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (ProtoHas [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (PropLoadKey [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (PropStoreKey [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) (v-need-value n 4) 0))
    (PropHasKey [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (PropDeleteKey [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (OwnKeyCount [] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (OwnKeyAt [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (ObjectFreeze [] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (InternalLoad [slot] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (InternalStore [operation]
      (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3)
          (if (= operation INTERNAL-INIT) (v-need-value n 4) 0) 0))
    (PropStore [name] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (SetProto [] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (ArrayMark [] (v-need-value n 1))
    (ArrayLoad [alias] (do (v-need-mem n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (ArrayStore [] (do
              (v-need-mem n 1)
              (v-need-value n 2)
              (v-need-value n 3)
              (v-need-value n 4)
              0))
    (ArrayLen [] (do (v-need-mem n 1) (v-need-value n 2) 0))
    (ArrayResize [] (do
              (v-need-mem n 1)
              (v-need-value n 2)
              (v-need-value n 3)
              (v-need-value n 4)
              0))
    (ArrayCopy [] (do
              (v-need-mem n 1)
              (v-need-value n 2)
              (v-need-value n 3)
              (v-need-value n 4)
              0))
    (StringConst [id] (v-need-ctrl n 0))
    (StringLen [] (v-need-value n 1))
    (StringEq [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (StringConcat [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (StringCharCode [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (StringSubstring [mode] (do (v-need-value n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (ToString [] (v-need-value n 1))
    (ToInteger [] (v-need-value n 1))
    (ToNumber [] (v-need-value n 1))
    (ArrayTest [] (v-need-value n 1))
    (ArrayUnbox [] (v-need-value n 1))
    (ParseFloat [] (v-need-value n 1))
    (ParseInt [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (IsNaN [] (v-need-value n 1))
    (StringSplit [] (do
              (v-need-mem n 1)
              (v-need-value n 2)
              (v-need-value n 3)
              (v-need-value n 4)
              0))
    (StringFromCodeUnit [] (v-need-value n 1))
    (NumberToString [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (ToFixed [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (StringLower [] (v-need-value n 1))
    (StringUpper [] (v-need-value n 1))
    (StringIndexOf [] (do (v-need-value n 1) (v-need-value n 2) (v-need-value n 3) 0))
    (StringCompare [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (StringNormalize [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (JsBuiltin [descriptor] (do (v-need-value n 1) (v-need-value n 2) 0))
    (JsThrow [] (v-need-value n 1))
          ;; Slot 0 is unused for the same reason a Region's is, and reported with the same code: a
          ;; node parked in it is a use nothing reads, which is how a stale edge survives a rewrite.
    (MemMerge [] (do
              (if (>= (n-nins n) 1) (v-need (= (n-in n 0) NO-NODE) VERR-MERGE-IN0 n) 0)
              (v-need-mem-from n 1)
              0))
    (Add [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Sub [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Mul [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Div [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Eq [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Lt [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Le [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Mod [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (BitAnd [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (BitOr [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (BitXor [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Shl [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (Shr [] (do (v-need-value n 1) (v-need-value n 2) 0))
    (UShr [] (do (v-need-value n 1) (v-need-value n 2) 0))))

; ============================================================================
; The passes
; ============================================================================
;; THE PRECONDITION, reported on its own and before anything else. See VERR-IN-PROGRESS.
(defn v-pass-in-progress [] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (if (n-in-progress? (load i)) (v-fail! VERR-IN-PROGRESS (load i)) 0))
                (store! i (+ (load i) 1))
                0))))
  0)

;; The DEAD contract, in a pass of its own and before the live one. A dead node has exactly one
;; obligation: `n-kill!` released its inputs. Checking it here rather than in node-id order with
;; everything else is what makes the two dead-node failures distinguishable: a node killed while
;; it still had users has cleared inputs and so reports VERR-DEAD-INPUT from its users, while a
;; node marked dead without releasing anything reports VERR-DEAD-HAS-INS whatever its id is.
;; Interleaved, whichever node happened to have the lower id decided which check "fired", and a
;; per-check gate on that is a gate on node numbering.
(defn v-pass-dead [] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i))
                    (v-need (= (n-nins (load i)) 0) VERR-DEAD-HAS-INS (load i))
                    0)
                (store! i (+ (load i) 1))
                0))))
  0)

(defn v-check-node [(n i64)] (-> i64)
  ; a live node reading a dead one is checked before arity and slots, because it explains
  ; every other complaint about that node
  (let [len (n-nins n)
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [d (n-in n (load i))]
                  (if (= d NO-NODE) 0 (v-need (not (n-dead? d)) VERR-DEAD-INPUT n)))
                (store! i (+ (load i) 1))
                0))))
  (v-check-edges n)
  (v-check-arity n)
  (v-check-slots n)
  0)

(defn v-pass-structure [] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i)) 0 (v-check-node (load i)))
                (store! i (+ (load i) 1))
                0))))
  0)

;; ARE THE TYPES AT A FIXPOINT. This is all a snapshot can say about monotonicity: `compute` is
;; a function of the inputs' types, so if re-running it changes an answer then some node was
;; never revisited after an input changed, which is a missing dependency. The claim that every
;; `compute` only ever FALLS is a claim about a sequence and is checked where sequences happen,
;; in `g-analyze!`.
;; The pointer contract, per node. See VERR-PTR-SLOT.
(defn v-check-ptr [(n i64)] (-> i64)
  (match (n-op n)
    (Load [alias]
      (if (>= (n-nins n) 3)
          (let [t (n-in-ty n 2)]
            (if (ty-high? t) 0 (v-need (ty-only-obj? t) VERR-PTR-SLOT n)))
          0))
    (Store [alias]
      (if (>= (n-nins n) 3)
          (let [t (n-in-ty n 2)]
            (if (ty-high? t) 0 (v-need (ty-only-obj? t) VERR-PTR-SLOT n)))
          0))
    (_ 0)))

(defn v-fun-parm-count [(fun i64)] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (match (n-op (load i)) (Parm [index] true) (_ false))
                              (= (n-in (load i) 0) fun)))
                    (store! count (+ (load count) 1))
                    0)
                (store! i (+ (load i) 1))
                0)))
    (load count)))

(defn v-direct-callee-fun [(callee i64)] (-> i64)
  (match (n-op callee)
    (Fun [index] callee)
    (Closure [captures] (n-in callee 0))
    (_ NO-NODE)))

(defn v-check-closure-contract [(n i64)] (-> i64)
  (match (n-op n)
    (Closure [captures]
      (let [fun (n-in n 0)
            fidx (match (n-op fun) (Fun [index] index) (_ -1))
            materialized (= (n-nins n) (+ captures 2))]
        (v-need (or (= (n-nins n) (+ captures 1)) materialized) VERR-CLOSURE-LAYOUT n)
        (if materialized (v-need (ty-only-obj? (n-ty (n-in n 1))) VERR-CLOSURE-LAYOUT n) 0)
        ; The finite target-set type is a 63-bit optimization summary. Exact direct identity for
        ; larger programs remains on Fun.aux / Closure.input0.
        (if (< fidx 63)
            (v-need (= (ty-fun-targets (n-ty n)) (<< 1 fidx)) VERR-CALL-TARGETS n)
            0)))
    (Call [abi]
      (let [callee (n-in n 1)
                targets (ty-fun-targets (n-ty callee))]
            (v-need (or (= abi CALL-ABI-LEGACY)
                        (>= abi CALL-ABI-RECEIVER))
                    VERR-CALL-RECEIVER
                    n)
            (if (or (= abi CALL-ABI-RECEIVER) (= abi CALL-ABI-DYNAMIC-RECEIVER))
                (do
                  ;; Input 2 is the hidden closure environment, input 3 the receiver: every
                  ;; callable reserves exactly one environment slot, which is what lets generic
                  ;; dispatch use one descriptor. Explicit capture-prefix aux forms above
                  ;; DYNAMIC are hand-built positional graphs (tests) and are judged by the
                  ;; arity relation alone.
                  (let [receiver-slot 3]
                  (v-need (> (n-nins n) receiver-slot) VERR-CALL-RECEIVER n)
                  (if (> (n-nins n) receiver-slot)
                      (let [receiver-type (n-ty (n-in n receiver-slot))]
                        (if (ty-high? receiver-type)
                            0
                            (v-need (or (= (ty-kinds receiver-type) VK-UNDEF)
                                        (or (!= (& (ty-kinds receiver-type) VK-OBJ) 0)
                                            (!= (& (ty-kinds receiver-type) VK-FUN) 0)))
                                    VERR-CALL-RECEIVER-TAG
                                    n)))
                      0)))
                0)
            (v-need (!= (& (ty-kinds (n-ty callee)) VK-FUN) 0) VERR-CALL-TAG n)
            (let [direct (v-direct-callee-fun callee)
                  fidx (if (= direct NO-NODE)
                           (ty-fun-singleton (n-ty callee))
                           (match (n-op direct) (Fun [index] index) (_ -1)))]
              (if (< fidx 0)
                  0
                  (let [fun (if (= direct NO-NODE) (n-find-fun-index fidx) direct)
                        raw (- (n-nins n) 2)
                        mem (and (> raw 0) (v-mem-producer? (n-in n (- (n-nins n) 1))))
                        explicit (- raw (if mem 1 0))
                        captures (match (n-op callee) (Closure [count] count) (_ 0))
                        parms (if (= fun NO-NODE) 0 (v-fun-parm-count fun))]
                    (v-need (and (!= fun NO-NODE)
                                 (or (= parms 0) (>= (+ captures explicit) parms)))
                            VERR-CALL-ARITY
                            n))))))
    (_ 0)))

(defn v-pass-types [] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (do
                      (v-need (= (n-compute (load i)) (n-ty (load i))) VERR-STALE-TYPE (load i))
                      (v-check-ptr (load i))
                      0))
                (store! i (+ (load i) 1))
                0))))
  0)

(defn v-pass-closure-contracts [] (-> i64)
  (let [lim (n-count)
        (mut i) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i)) 0 (v-check-closure-contract (load i)))
                (store! i (+ (load i) 1))
                0))))
  0)

(defn v-ctrl-after-safepoint? [(ctrl i64) (sp i64)] (-> bool)
  (if (or (= ctrl NO-NODE) (n-dead? ctrl))
      false
      (match (n-op ctrl)
        (CProj [slot] (= (n-in ctrl 0) sp))
        (CallEnd [] (v-ctrl-after-safepoint? (n-in ctrl 0) sp))
        (_ false))))

(defn v-check-safepoint [(sp i64)] (-> i64)
  (let [(mut i) 1]
    (loop (if (>= (load i) (n-nins sp))
              (break)
              (do
                (let [ref (n-in sp (load i))]
                  (v-need (ty-only-obj? (n-ty ref)) VERR-SAFEPOINT-INTERIOR sp)
                  (let [len (n-nouts ref)
                        (mut j) 0]
                    (loop (if (>= (load j) len)
                              (break)
                              (do
                                (let [u (n-out ref (load j))]
                                  (if (or (= u sp) (n-dead? u))
                                      0
                                      (if (and (> (n-nins u) 0)
                                               (v-ctrl-after-safepoint? (n-in u 0) sp))
                                          (v-fail! VERR-PRE-SAFEPOINT-REF u)
                                          0)))
                                (store! j (+ (load j) 1))
                                0))))
                  (store! i (+ (load i) 1))
                  0))))
    0))

(defn v-pass-gc [] (-> i64)
  (let [lim (n-count)
        (mut i) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (match (n-op (load i))
                      (Safepoint [] (v-check-safepoint (load i)))
                      (_ 0)))
                (store! i (+ (load i) 1))
                0)))
    0))

;; One violation per leaked node, and the node is NO-NODE because reachability is a whole-graph
;; question rather than a property of one node: `g-print-flat` is how you find which one. The
;; check itself is delegated, so there is one definition of "nothing can reach this".
(defn v-pass-leaks [] (-> i64)
  (let [k (g-leaked-count)
        (mut i) 0]
    (loop (if (>= (load i) k)
              (break)
              (do (v-fail! VERR-LEAK NO-NODE) (store! i (+ (load i) 1)) 0))))
  0)

; ============================================================================
; Value representation (Phase 1 of the hardening plan)
;
; Every value edge carries one machine representation — a TAGGED NaN-boxed word, a RAW managed
; pointer, or a RAW machine number — and nearly every hard bug in the NavierStokes campaign was
; a producer and consumer disagreeing about which. The classification here is STRUCTURAL (which
; op produced the value), never a read of the node's type seed: seeds lag construction and
; lying seeds were themselves one of the bug classes. UNKNOWN is deliberately quiet — ops are
; promoted into the classification as their contracts are pinned down, so this pass only ever
; reports certain violations.
; ============================================================================



;; The classifier itself is `n-rep-of` in node.coil, because the verifier is not its only reader:
;; `box-idealize` and `unbox-idealize` must answer "is this value certainly tagged" before they
;; delete a representation conversion, and two copies of the table would disagree eventually.
;; One difference matters to the verifier not at all and to the idealizations completely: a Phi
;; with an absent arm classifies UNKNOWN (see the note on `n-rep-of`).

;; What representation this consumer requires at this input slot, REP-UNKNOWN for slots the
;; contract has not been pinned down for. One table serves the verbose report and the hard
;; verify pass so they can never disagree.
(defn v-rep-slot-required [(n i64) (slot i64)] (-> i64)
  (match (n-op n)
    (Unbox [target] (if (= slot 1) REP-TAGGED REP-UNKNOWN))
    (TypeTest [target] (if (= slot 1) REP-TAGGED REP-UNKNOWN))
    (ArrayTest [] (if (= slot 1) REP-TAGGED REP-UNKNOWN))
    (ArrayUnbox [] (if (= slot 1) REP-TAGGED REP-UNKNOWN))
    (Store [alias]
      (cond (= slot 2) REP-RAW-PTR (= slot 3) (shape-alias-rep alias) :else REP-UNKNOWN))
    (Load [alias] (if (= slot 2) REP-RAW-PTR REP-UNKNOWN))
    (ArrayStore []
      (cond (= slot 3) REP-RAW-NUM (= slot 4) REP-TAGGED :else REP-UNKNOWN))
    (ArrayLoad [alias] (if (= slot 3) REP-RAW-NUM REP-UNKNOWN))
    (ArrayResize [] (if (= slot 3) REP-RAW-NUM REP-UNKNOWN))
    (PropStore [name] (if (= slot 3) REP-TAGGED REP-UNKNOWN))
    (PropStoreKey [] (if (= slot 4) REP-TAGGED REP-UNKNOWN))
    (Call [abi]
      (if (and (= slot 2)
               (or (= abi CALL-ABI-RECEIVER) (= abi CALL-ABI-DYNAMIC-RECEIVER)))
          REP-TAGGED REP-UNKNOWN))
          ;; Numeric arithmetic and bitwise ops consume MACHINE NUMBERS. A tagged word in one of
          ;; these slots makes the op compute on the NaN-box bits themselves — unary minus on an
          ;; ArrayLoad negated the box bits and zeroed the cell (repros/negload.js). The frontend's
          ;; guarded ToNumber (fng-number-value / fng-int-value) is what satisfies this contract.
          ;; EQ/LT/LE are NOT here: equality legitimately consumes tagged operands through the
          ;; dyn-boundary runtime call.
    (Add [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Sub [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Mul [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Div [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Mod [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (BitAnd [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (BitOr [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (BitXor [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Shl [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Shr [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (UShr [] (if (or (= slot 1) (= slot 2)) REP-RAW-NUM REP-UNKNOWN))
    (Minus [] (if (= slot 1) REP-RAW-NUM REP-UNKNOWN))
    (ToFixed [] (cond (= slot 1) REP-TAGGED (= slot 2) REP-RAW-NUM :else REP-UNKNOWN))
    (BitNot [] (if (= slot 1) REP-RAW-NUM REP-UNKNOWN))
    (_ REP-UNKNOWN)))

;; The first slot of `n` whose input's representation certainly disagrees with the slot's
;; requirement, or -1.
(defn v-rep-first-violation [(n i64)] (-> i64)
  (let [(mut slot) 1 (mut found) -1]
    (loop (if (or (>= (load slot) (n-nins n)) (>= (load found) 0))
              (break)
              (do
                (let [required (v-rep-slot-required n (load slot))
                      input (n-in n (load slot))
                      actual (if (= input NO-NODE) REP-UNKNOWN (n-rep-of input 8))]
                  (if (and (!= required REP-UNKNOWN)
                           (and (!= actual REP-UNKNOWN) (!= actual required)))
                      (store! found (load slot))
                      0))
                (store! slot (+ (load slot) 1))
                0)))
    (load found)))

;; Warn-mode sweep: report every certain producer/consumer representation disagreement. This is
;; NOT yet part of g-verify — it runs from the resident emitter so the whole conformance corpus
;; can be triaged; it becomes a hard VERR once the corpus is clean.
(defn g-rep-report [(w (ptr Writer))] (-> i64)
  (let [lim (n-count)
        (mut count) 0
        (mut i) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (let [slot (v-rep-first-violation (load i))]
                      (if (>= slot 0)
                          (let [input (n-in (load i) slot)]
                            (fmt w "REP n{d}:{s} slot {d} <- n{d}:{s} is {s}, needs {s}\n"
                                 (load i) (op-name (n-op (load i))) slot
                                 input (op-name (n-op input))
                                 (rep-name (n-rep-of input 8))
                                 (rep-name (v-rep-slot-required (load i) slot)))
                            (store! count (+ (load count) 1))
                            0)
                          0)))
                (store! i (+ (load i) 1))
                0)))
    (load count)))

(defn v-pass-representation [] (-> i64)
  (let [lim (n-count)
        (mut i) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (let [slot (v-rep-first-violation (load i))]
                      (if (>= slot 0)
                          (let [input (n-in (load i) slot)
                            w (stderr)]
                            (fmt w "REP n{d}:{s} slot {d} <- n{d}:{s} is {s}, needs {s}\n"
                                 (load i) (op-name (n-op (load i))) slot
                                 input (op-name (n-op input))
                                 (rep-name (n-rep-of input 8))
                                 (rep-name (v-rep-slot-required (load i) slot)))
                            (v-fail! VERR-REPRESENTATION (load i))
                            0)
                          0)))
                (store! i (+ (load i) 1))
                0)))
    0))

;; Returns the number of violations; `g-verify-code` then names the first check that fired.
;;
;; THE PASSES ARE ORDERED CAUSE BEFORE CONSEQUENCE, and the type pass runs LAST and only on an
;; otherwise clean graph. `compute` reads its inputs' types, so on a graph with the wrong number
;; of inputs, a control node in a value slot, or a node nothing can reach, its answers are not
;; evidence of anything: nothing ever had a reason to revisit that node. Reporting them anyway
;; would bury the one real failure under a pile of its own consequences, and the recorded first
;; code would name the wrong check.
(defn g-verify [] (-> i64)
  (v-reset!)
  (g-set-verifying! true)
  (v-pass-in-progress)
  (if (> (g-verify-count) 0)
      0
      (do
        (v-pass-dead)
        (v-pass-structure)
        (v-pass-leaks)
        (if (> (g-verify-count) 0)
            0
            (do
              (v-pass-closure-contracts)
              (if (> (g-verify-count) 0) 0 (v-pass-types))
              ; after types so a precise code (VERR-PTR-SLOT etc.) wins the report when both
              ; catch the same edge; JS-frontend graphs only (see g-rep-strict-cell)
              (if (or (> (g-verify-count) 0) (= (g-rep-strict?) 0))
                  0
                  (v-pass-representation))
              (if (> (g-verify-count) 0) 0 (v-pass-gc))
              0))
        0))
  (g-set-verifying! false)
  (g-verify-count))
