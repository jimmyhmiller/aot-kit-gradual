;; JSL: the language the JavaScript runtime library is written in. This file is the READER and the
;; CHECKER; `jsl_lower.coil` turns a checked declaration into an ideal graph. See docs/JSL.md for
;; why the language exists at all — the short version is that a builtin currently costs an opcode
;; plus about ten dispatch arms across five modules, and ECMAScript has a thousand of them.
;;
;; THE SURFACE IS READ WITH `coil.reader`. An earlier version of this file was written against the
;; old `coil.sexp`, which had no string tokenization, no comment syntax, and no bracket delimiters;
;; it needed a quote-aware comment stripper and an encoding of whitespace and parens inside quoted
;; runs just to express a multi-word error message. `coil.reader` has real `KStr`, `KKw`, `KVec` and
;; `KFloat` tokens and skips comments, so all of that is gone and the surface is ordinary Coil
;; syntax: brackets for parameter lists and bindings, `:keyword` for options, `"..."` for strings.
;;
;; THERE IS ONE TYPE SYSTEM IN THIS PROJECT AND JSL DOES NOT ADD A SECOND. A type annotation is
;; `text.coil`'s exact form, verbatim. Torque had to invent a type system to mirror C++ object
;; layouts; `ty.coil` already has an interned lattice with meet/join/isa carrying integer ranges,
;; function-index sets and shape sets, which is strictly more than Torque's. Reusing it means a
;; JSL annotation and a printed IR type can never disagree about what a spelling means.
;;
;; EVERY REFUSAL HAS A NAME, following `text.coil` and D11. A reader that returns a plausible
;; declaration on malformed input turns a format bug into a miscompile hunt, so `jsl-load!` keeps
;; the FIRST failure with the offending name and refuses to leave a half-built declaration in the
;; table: a definition either enters complete or does not enter.
;;
;; WHAT IS DESIGNED BUT NOT BUILT IS REFUSED BY NAME, never approximated. `macro`, `:labels`,
;; `:otherwise`, `loop` and `class` all report JSL-ERR-UNSUPPORTED naming the form. There is no
;; path by which a `.jsl` file using one of them produces a graph.
(module jsl)

(import "coil.alloc"     :use *)
(import "coil.arraylist" :use *)
(import "coil.slice"     :use *)
(import "coil.str"       :use *)
(import "coil.control"   :use *)
(import "coil.io"        :use *)
(import "coil.fs"        :use *)
(import "coil.result"    :use *)
(import "coil.match"     :use *)
(import "coil.reader"    :as rd)
(import "ty"   :use *)
(import "text" :use *)
(import "node" :use *)
(import "jsbuiltin_desc" :use *)

; ============================================================================
; Failure codes
; ============================================================================
;; ONE NAMED CODE PER FAILURE CLASS. "It was rejected" is satisfied by a checker that rejects
;; everything, so each code names a SPECIFIC check and the suite asserts the specific code.
(const JSL-OK                        i64 0)
(const JSL-ERR-NOT-A-LIST            i64 1)   ; a top-level form that is not a list
(const JSL-ERR-UNKNOWN-FORM          i64 2)   ; a top-level head that is not `builtin`
(const JSL-ERR-UNSUPPORTED           i64 3)   ; designed, not built; the form is named
(const JSL-ERR-BAD-NAME              i64 4)   ; a missing or non-symbol definition name
(const JSL-ERR-DUP-NAME              i64 5)   ; two definitions of one name
(const JSL-ERR-BAD-KEY               i64 6)   ; an unknown `:keyword`, or one with no value
(const JSL-ERR-BAD-PARAMS            i64 7)   ; `:params` is not a list of `(name type)` pairs
(const JSL-ERR-BAD-TYPE              i64 8)   ; an annotation `ty-try-parse` rejects
(const JSL-ERR-BAD-BOOL              i64 9)   ; a flag value that is not `true` or `false`
(const JSL-ERR-NO-BODY               i64 10)  ; no body expression, or more than one
(const JSL-ERR-UNBOUND               i64 11)  ; a symbol that is no parameter, binding or literal
(const JSL-ERR-UNKNOWN-PRIM          i64 12)  ; a `%Name` with no entry in the primitive table
(const JSL-ERR-UNKNOWN-CALL          i64 13)  ; a call to a name that is not a declared `builtin`
(const JSL-ERR-ARITY                 i64 14)  ; wrong operand count for a primitive or a call
(const JSL-ERR-BAD-LET               i64 15)  ; a `let` whose bindings are not `(name expr)` pairs
(const JSL-ERR-BAD-IF                i64 16)  ; an `if` without exactly three operands
(const JSL-ERR-EMPTY-CALL            i64 17)  ; `()`
(const JSL-ERR-TOO-MANY-PARAMS       i64 18)  ; more parameters than JSL-MAX-PARAMS
(const JSL-ERR-UNDECLARED-TRANSITION i64 19)  ; checked against the LOWERED GRAPH, in jsl_lower
(const JSL-ERR-NO-SUCH-FILE          i64 20)  ; an index entry, or an index, that will not open
(const JSL-ERR-EMPTY-INDEX           i64 21)  ; an index that named no unit at all
(const JSL-ERR-MACRO-RECURSION       i64 22)  ; a macro that expands into itself, directly or not
(const JSL-ERR-BAD-LABELS            i64 23)  ; `:labels` malformed, or declared on a `builtin`
(const JSL-ERR-TOO-MANY-LABELS       i64 24)  ; more labels than JSL-MAX-LABELS
(const JSL-ERR-BAD-GOTO              i64 25)  ; `goto` naming no label of the enclosing macro
(const JSL-ERR-MISSING-OTHERWISE     i64 26)  ; a labelled macro called with no `:otherwise`
(const JSL-ERR-UNEXPECTED-OTHERWISE  i64 27)  ; `:otherwise` on a callee that has no label
(const JSL-ERR-PARSE                 i64 28)  ; `coil.reader` refused the bytes; its Diag is kept
(const JSL-ERR-BAD-LOOP              i64 29)  ; a `loop` whose bindings are not a vector of pairs
(const JSL-ERR-BAD-RECUR             i64 30)  ; `recur` with the wrong argument count
(const JSL-ERR-RECUR-OUTSIDE-LOOP    i64 31)  ; `recur` with no enclosing `loop`
(const JSL-ERR-LOOP-NO-RECUR         i64 32)  ; a `loop` no path recurs to: that is a `let`
(const JSL-ERR-LOOP-NO-EXIT          i64 33)  ; a `loop` every path recurs from: it cannot terminate
(const JSL-ERR-HEAP-IN-BUILTIN       i64 34)  ; a `builtin` that reads the heap; see the note below

(defn jsl-err-name [(code i64)] (-> (slice u8))
  (case code
        JSL-OK                        "JSL-OK"
        JSL-ERR-NOT-A-LIST            "JSL-ERR-NOT-A-LIST"
        JSL-ERR-UNKNOWN-FORM          "JSL-ERR-UNKNOWN-FORM"
        JSL-ERR-UNSUPPORTED           "JSL-ERR-UNSUPPORTED"
        JSL-ERR-BAD-NAME              "JSL-ERR-BAD-NAME"
        JSL-ERR-DUP-NAME              "JSL-ERR-DUP-NAME"
        JSL-ERR-BAD-KEY               "JSL-ERR-BAD-KEY"
        JSL-ERR-BAD-PARAMS            "JSL-ERR-BAD-PARAMS"
        JSL-ERR-BAD-TYPE              "JSL-ERR-BAD-TYPE"
        JSL-ERR-BAD-BOOL              "JSL-ERR-BAD-BOOL"
        JSL-ERR-NO-BODY               "JSL-ERR-NO-BODY"
        JSL-ERR-UNBOUND               "JSL-ERR-UNBOUND"
        JSL-ERR-UNKNOWN-PRIM          "JSL-ERR-UNKNOWN-PRIM"
        JSL-ERR-UNKNOWN-CALL          "JSL-ERR-UNKNOWN-CALL"
        JSL-ERR-ARITY                 "JSL-ERR-ARITY"
        JSL-ERR-BAD-LET               "JSL-ERR-BAD-LET"
        JSL-ERR-BAD-IF                "JSL-ERR-BAD-IF"
        JSL-ERR-EMPTY-CALL            "JSL-ERR-EMPTY-CALL"
        JSL-ERR-TOO-MANY-PARAMS       "JSL-ERR-TOO-MANY-PARAMS"
        JSL-ERR-UNDECLARED-TRANSITION "JSL-ERR-UNDECLARED-TRANSITION"
        JSL-ERR-NO-SUCH-FILE          "JSL-ERR-NO-SUCH-FILE"
        JSL-ERR-EMPTY-INDEX           "JSL-ERR-EMPTY-INDEX"
        JSL-ERR-MACRO-RECURSION       "JSL-ERR-MACRO-RECURSION"
        JSL-ERR-BAD-LABELS            "JSL-ERR-BAD-LABELS"
        JSL-ERR-TOO-MANY-LABELS       "JSL-ERR-TOO-MANY-LABELS"
        JSL-ERR-BAD-GOTO              "JSL-ERR-BAD-GOTO"
        JSL-ERR-MISSING-OTHERWISE     "JSL-ERR-MISSING-OTHERWISE"
        JSL-ERR-UNEXPECTED-OTHERWISE  "JSL-ERR-UNEXPECTED-OTHERWISE"
        JSL-ERR-PARSE                 "JSL-ERR-PARSE"
        JSL-ERR-BAD-LOOP              "JSL-ERR-BAD-LOOP"
        JSL-ERR-BAD-RECUR             "JSL-ERR-BAD-RECUR"
        JSL-ERR-RECUR-OUTSIDE-LOOP    "JSL-ERR-RECUR-OUTSIDE-LOOP"
        JSL-ERR-LOOP-NO-RECUR         "JSL-ERR-LOOP-NO-RECUR"
        JSL-ERR-LOOP-NO-EXIT          "JSL-ERR-LOOP-NO-EXIT"
        JSL-ERR-HEAP-IN-BUILTIN       "JSL-ERR-HEAP-IN-BUILTIN"
        "<unknown jsl code>"))

; ============================================================================
; The primitive table
; ============================================================================
;; A primitive is spelled `%Name` and is EXACTLY ONE IR OP. One function per column, the same shape
;; `jsbuiltin_desc.coil` uses, so adding a primitive touches one place per column and a column
;; nobody filled is a `-1` that `jsp-check` refuses rather than a plausible default.
;;
;; THIS LAYER IS THE WHOLE PORTING SURFACE, and it is thin for a structural reason. Torque's
;; `base.tq` is ~70% `extern` because CodeStubAssembler is machine-level, so Torque has to import
;; ~500 primitives before it can say anything. Our IR is a sea of nodes that already has PropLoad,
;; ArrayStore, StringConcat, Box and TypeTest as ops, so JSL starts above the line where base.tq
;; ends.
(const JSP-NONE i64 -1)
(const JSP-ADD              i64 0)
(const JSP-SUB              i64 1)
(const JSP-MUL              i64 2)
(const JSP-DIV              i64 3)
(const JSP-MOD              i64 4)
(const JSP-NEG              i64 5)
(const JSP-NOT              i64 6)
(const JSP-EQ               i64 7)
(const JSP-LT               i64 8)
(const JSP-LE               i64 9)
(const JSP-BITAND           i64 10)
(const JSP-BITOR            i64 11)
(const JSP-BITXOR           i64 12)
(const JSP-SHL              i64 13)
(const JSP-SHR              i64 14)
(const JSP-USHR             i64 15)
(const JSP-BITNOT           i64 16)
(const JSP-STRINGLEN        i64 17)
(const JSP-STRINGEQ         i64 18)
(const JSP-STRINGCONCAT     i64 19)
(const JSP-STRINGCHARCODE   i64 20)
(const JSP-STRINGINDEXOF    i64 21)
(const JSP-STRINGCOMPARE    i64 22)
(const JSP-STRINGFROMCODE   i64 23)
(const JSP-STRINGLOWER      i64 24)
(const JSP-STRINGUPPER      i64 25)
(const JSP-TOSTRING         i64 26)
(const JSP-PARSEINT         i64 27)
(const JSP-ISNAN            i64 28)
(const JSP-NUMBERTOSTRING   i64 29)
(const JSP-THROW            i64 30)
(const JSP-TOINTEGER        i64 31)
(const JSP-SUBSTRING        i64 32)
(const JSP-TONUMBER         i64 33)
(const JSP-ISINT            i64 34)
(const JSP-ISFLT            i64 35)
(const JSP-ISSTRING         i64 36)
(const JSP-ARRAYLEN         i64 37)
(const JSP-ARRAYLOAD        i64 38)
(const JSP-NEWARRAY         i64 39)
(const JSP-ARRAYSTORE       i64 40)
(const JSP-BOX              i64 41)
(const JSP-UNBOXINT         i64 42)
(const JSP-UNBOXFLT         i64 43)
(const JSP-FLOORNUM         i64 44)
(const JSP-CEILNUM          i64 45)
(const JSP-ROUNDNUM         i64 46)
(const JSP-UNBOXBOOL        i64 47)
;; `%ArrayResize a n v` — set the array's length to `n`, and ORDER the resize after `v`. The third
;; operand is not data the resize consumes; it is the value whose read must happen first. `pop`
;; loads the last element and then shortens the array, and nothing in the memory chain says the
;; load precedes the write that destroys what it read, so the load floats past it and selection
;; refuses the block with `MSEL-MEMORY-ORDER`. `OP-ARRAYRESIZE`'s fifth input exists for exactly
;; this, and JSL has to name it because JSL has no other way to say "after".
(const JSP-ARRAYRESIZE      i64 48)
(const JSP-UNBOXOBJ         i64 49)
(const JSP-PROPLOADNAMED    i64 50)
(const JSP-PROPSTORENAMED   i64 51)
(const JSP-ISARRAY          i64 52)
(const JSP-UNBOXARRAY       i64 53)
(const JSP-UNBOXSTRING      i64 54)
(const JSP-PARSEFLOAT       i64 55)
(const JSP-ISUNDEFINED      i64 56)
(const JSP-ISNULL           i64 57)
(const JSP-ISBOOL           i64 58)
(const JSP-ISOBJECT         i64 59)
(const JSP-ISFUNCTION       i64 60)
(const JSP-PROPHASNAMED     i64 61)
(const JSP-PROPDELETENAMED  i64 62)
(const JSP-COUNT            i64 63)

(defn jsp-name [(id i64)] (-> (slice u8))
  (case id
        JSP-ADD            "%Add"
        JSP-SUB            "%Sub"
        JSP-MUL            "%Mul"
        JSP-DIV            "%Div"
        JSP-MOD            "%Mod"
        JSP-NEG            "%Neg"
        JSP-NOT            "%Not"
        JSP-EQ             "%Eq"
        JSP-LT             "%Lt"
        JSP-LE             "%Le"
        JSP-BITAND         "%BitAnd"
        JSP-BITOR          "%BitOr"
        JSP-BITXOR         "%BitXor"
        JSP-SHL            "%Shl"
        JSP-SHR            "%Shr"
        JSP-USHR           "%Ushr"
        JSP-BITNOT         "%BitNot"
        JSP-STRINGLEN      "%StringLen"
        JSP-STRINGEQ       "%StringEq"
        JSP-STRINGCONCAT   "%StringConcat"
        JSP-STRINGCHARCODE "%StringCharCode"
        JSP-STRINGINDEXOF  "%StringIndexOf"
        JSP-STRINGCOMPARE  "%StringCompare"
        JSP-STRINGFROMCODE "%StringFromCode"
        JSP-STRINGLOWER    "%StringLower"
        JSP-STRINGUPPER    "%StringUpper"
        JSP-TOSTRING       "%ToString"
        JSP-PARSEINT       "%ParseInt"
        JSP-ISNAN          "%IsNaN"
        JSP-NUMBERTOSTRING "%NumberToString"
        JSP-THROW          "%Throw"
        JSP-TOINTEGER      "%ToInteger"
        JSP-SUBSTRING      "%Substring"
        JSP-TONUMBER       "%ToNumber"
        JSP-ISINT          "%IsInt"
        JSP-ISFLT          "%IsFlt"
        JSP-ISSTRING       "%IsString"
        JSP-ARRAYLEN       "%ArrayLen"
        JSP-ARRAYLOAD      "%ArrayLoad"
        JSP-NEWARRAY       "%NewArray"
        JSP-ARRAYSTORE     "%ArrayStore"
        JSP-BOX            "%Box"
        JSP-UNBOXINT       "%UnboxInt"
        JSP-UNBOXFLT       "%UnboxFlt"
        JSP-FLOORNUM       "%FloorNum"
        JSP-CEILNUM        "%CeilNum"
        JSP-ROUNDNUM       "%RoundNum"
        JSP-UNBOXBOOL      "%UnboxBool"
        JSP-ARRAYRESIZE    "%ArrayResize"
        JSP-UNBOXOBJ       "%UnboxObj"
        JSP-PROPLOADNAMED  "%PropLoadNamed"
        JSP-PROPSTORENAMED "%PropStoreNamed"
        JSP-ISARRAY        "%IsArray"
        JSP-UNBOXARRAY     "%UnboxArray"
        JSP-UNBOXSTRING    "%UnboxString"
        JSP-PARSEFLOAT     "%ParseFloat"
        JSP-ISUNDEFINED    "%IsUndefined"
        JSP-ISNULL         "%IsNull"
        JSP-ISBOOL         "%IsBool"
        JSP-ISOBJECT       "%IsObject"
        JSP-ISFUNCTION     "%IsFunction"
        JSP-PROPHASNAMED   "%PropHasNamed"
        JSP-PROPDELETENAMED "%PropDeleteNamed"
        "<unknown jsl primitive>"))

(defn jsp-op [(id i64)] (-> i64)
  (case id
        JSP-ADD            OP-ADD
        JSP-SUB            OP-SUB
        JSP-MUL            OP-MUL
        JSP-DIV            OP-DIV
        JSP-MOD            OP-MOD
        JSP-NEG            OP-MINUS
        JSP-NOT            OP-NOT
        JSP-EQ             OP-EQ
        JSP-LT             OP-LT
        JSP-LE             OP-LE
        JSP-BITAND         OP-BITAND
        JSP-BITOR          OP-BITOR
        JSP-BITXOR         OP-BITXOR
        JSP-SHL            OP-SHL
        JSP-SHR            OP-SHR
        JSP-USHR           OP-USHR
        JSP-BITNOT         OP-BITNOT
        JSP-STRINGLEN      OP-STRINGLEN
        JSP-STRINGEQ       OP-STRINGEQ
        JSP-STRINGCONCAT   OP-STRINGCONCAT
        JSP-STRINGCHARCODE OP-STRINGCHARCODE
        JSP-STRINGINDEXOF  OP-STRINGINDEXOF
        JSP-STRINGCOMPARE  OP-STRINGCOMPARE
        JSP-STRINGFROMCODE OP-STRINGFROMCODEUNIT
        JSP-STRINGLOWER    OP-STRINGLOWER
        JSP-STRINGUPPER    OP-STRINGUPPER
        JSP-TOSTRING       OP-TOSTRING
        JSP-PARSEINT       OP-PARSEINT
        JSP-ISNAN          OP-ISNAN
        JSP-NUMBERTOSTRING OP-NUMBERTOSTRING
        JSP-THROW          OP-JSTHROW
        JSP-TOINTEGER      OP-TOINTEGER
        JSP-SUBSTRING      OP-STRINGSUBSTRING
        JSP-TONUMBER       OP-TONUMBER
        JSP-ISINT          OP-TYPETEST
        JSP-ISFLT          OP-TYPETEST
        JSP-ISSTRING       OP-TYPETEST
        JSP-ARRAYLEN       OP-ARRAYLEN
        JSP-ARRAYLOAD      OP-ARRAYLOAD
        JSP-NEWARRAY       OP-NEW
        JSP-ARRAYSTORE     OP-ARRAYSTORE
        JSP-BOX            OP-BOX
        JSP-UNBOXINT       OP-UNBOX
        JSP-UNBOXFLT       OP-UNBOX
        JSP-FLOORNUM       OP-JSBUILTIN
        JSP-CEILNUM        OP-JSBUILTIN
        JSP-ROUNDNUM       OP-JSBUILTIN
        JSP-UNBOXBOOL      OP-UNBOX
        JSP-ARRAYRESIZE    OP-ARRAYRESIZE
        JSP-UNBOXOBJ       OP-UNBOX
        JSP-PROPLOADNAMED  OP-PROPLOAD
        JSP-PROPSTORENAMED OP-PROPSTORE
        JSP-ISARRAY        OP-ARRAYTEST
        JSP-UNBOXARRAY     OP-ARRAYUNBOX
        JSP-UNBOXSTRING    OP-UNBOX
        JSP-PARSEFLOAT     OP-PARSEFLOAT
        JSP-ISUNDEFINED    OP-TYPETEST
        JSP-ISNULL         OP-TYPETEST
        JSP-ISBOOL         OP-TYPETEST
        JSP-ISOBJECT       OP-TYPETEST
        JSP-ISFUNCTION     OP-TYPETEST
        JSP-PROPHASNAMED   OP-PROPHAS
        JSP-PROPDELETENAMED OP-PROPDELETE
        -1))

;; How many OPERANDS the primitive takes. Slot 0 of every one of these ops is the ordinary control
;; anchor and is not an operand, so the node built in `jsl_lower` has arity+1 inputs.
(defn jsp-arity [(id i64)] (-> i64)
  (case id
        JSP-ADD            2
        JSP-SUB            2
        JSP-MUL            2
        JSP-DIV            2
        JSP-MOD            2
        JSP-NEG            1
        JSP-NOT            1
        JSP-EQ             2
        JSP-LT             2
        JSP-LE             2
        JSP-BITAND         2
        JSP-BITOR          2
        JSP-BITXOR         2
        JSP-SHL            2
        JSP-SHR            2
        JSP-USHR           2
        JSP-BITNOT         1
        JSP-STRINGLEN      1
        JSP-STRINGEQ       2
        JSP-STRINGCONCAT   2
        JSP-STRINGCHARCODE 2
        JSP-STRINGINDEXOF  3
        JSP-STRINGCOMPARE  2
        JSP-STRINGFROMCODE 1
        JSP-STRINGLOWER    1
        JSP-STRINGUPPER    1
        JSP-TOSTRING       1
        JSP-PARSEINT       2
        JSP-ISNAN          1
        JSP-NUMBERTOSTRING 2
        JSP-THROW          1
        JSP-TOINTEGER      1
        JSP-SUBSTRING      3
        JSP-TONUMBER       1
        JSP-ISINT          1
        JSP-ISFLT          1
        JSP-ISSTRING       1
        JSP-ARRAYLEN       1
        JSP-ARRAYLOAD      2
        JSP-NEWARRAY       0
        JSP-ARRAYSTORE     3
        JSP-BOX            1
        JSP-UNBOXINT       1
        JSP-UNBOXFLT       1
        JSP-FLOORNUM       1
        JSP-CEILNUM        1
        JSP-ROUNDNUM       1
        JSP-UNBOXBOOL      1
        JSP-ARRAYRESIZE    3
        JSP-UNBOXOBJ       1
        JSP-PROPLOADNAMED  2
        JSP-PROPSTORENAMED 3
        JSP-ISARRAY        1
        JSP-UNBOXARRAY     1
        JSP-UNBOXSTRING    1
        JSP-PARSEFLOAT     1
        JSP-ISUNDEFINED    1
        JSP-ISNULL         1
        JSP-ISBOOL         1
        JSP-ISOBJECT       1
        JSP-ISFUNCTION     1
        JSP-PROPHASNAMED   2
        JSP-PROPDELETENAMED 2
        -1))

;; The aux word a primitive's node carries. Almost every op takes 0, but `OP-TYPETEST` takes the
;; TESTED TYPE, and a type id is interned at run time rather than being a compile-time constant —
;; which is why this is a function evaluated at lowering rather than a column of literals.
;; How a primitive relates to the heap. Memory is IMPLICIT in JSL: a definition never writes memory
;; plumbing, because threading a memory SSA value by hand is exactly the mechanical work the language
;; exists to remove. The lowering supplies the current memory to a reader and takes the new one back
;; from a writer.
;;
;; JSP-MEM-WRITE is declared but no primitive uses it yet: a write inside an `if` or a `loop` needs a
;; memory Phi at the merge, and until that exists a writing primitive would be silently wrong on any
;; branch. `jsp-writes-memory?` is what `jl-prim` refuses on, so the gap is a named error rather than
;; a miscompile.
(const JSP-MEM-NONE  i64 0)
(const JSP-MEM-READ  i64 1)
(const JSP-MEM-WRITE i64 2)

;; JSP-MEM-ALLOC needs the current CONTROL rather than the current memory: an allocation happening
;; twice is two objects, so `New` is the one memory-family op whose control input is real. With
;; SHAPE-ROOT it has no field memories at all, so it neither reads nor writes the property heap —
;; the elements written into it afterwards are what do.
(const JSP-MEM-ALLOC i64 3)

(defn jsp-mem [(id i64)] (-> i64)
  (case id
        JSP-ARRAYLEN   JSP-MEM-READ
        JSP-ARRAYLOAD  JSP-MEM-READ
        JSP-ARRAYSTORE JSP-MEM-WRITE
        JSP-ARRAYRESIZE JSP-MEM-WRITE
        JSP-PROPLOADNAMED JSP-MEM-READ
        JSP-PROPSTORENAMED JSP-MEM-WRITE
        JSP-PROPHASNAMED JSP-MEM-READ
        JSP-PROPDELETENAMED JSP-MEM-WRITE
        JSP-NEWARRAY   JSP-MEM-ALLOC
        JSP-MEM-NONE))

(defn jsp-touches-memory? [(id i64)] (-> bool) (!= (jsp-mem id) JSP-MEM-NONE))
;; Allocation is excluded here on purpose: it does not read the CALLER's heap, so a definition that
;; only allocates may still be an ordinary `builtin`.
(defn jsp-reads-memory? [(id i64)] (-> bool)
  (or (= (jsp-mem id) JSP-MEM-READ) (= (jsp-mem id) JSP-MEM-WRITE)))
(defn jsp-writes-memory? [(id i64)] (-> bool) (= (jsp-mem id) JSP-MEM-WRITE))

(defn jsp-aux [(id i64)] (-> i64)
  (case id
        JSP-ISINT    (t-int)
        JSP-ISFLT    (t-flt)
        JSP-UNBOXINT (t-int)
        JSP-UNBOXFLT (t-flt)
        JSP-UNBOXBOOL (t-bool)
        JSP-UNBOXOBJ  (t-obj)
        JSP-UNBOXSTRING (t-str)
        ;; The descriptor id the `OP-JSBUILTIN` runtime dispatches on. Rounding a double needs a
        ;; real rounding operation, which is the machine surface rather than something JSL can
        ;; compose; the descriptor table already has libc behind it and both execution modes take
        ;; the same dynamic-value ABI.
        JSP-FLOORNUM JBI-FLOOR
        JSP-CEILNUM  JBI-CEIL
        JSP-ROUNDNUM JBI-ROUND
        JSP-ISSTRING (t-str)
        JSP-ISUNDEFINED (t-undef)
        JSP-ISNULL (t-null)
        JSP-ISBOOL (t-bool)
        JSP-ISOBJECT (t-obj)
        JSP-ISFUNCTION (t-fun)
        0))

(defn jsp-find [(name (slice u8))] (-> i64)
  (let [(mut id) 0 (mut found) JSP-NONE]
    (loop (if (or (>= (load id) JSP-COUNT) (!= (load found) JSP-NONE))
              (break)
              (do
                (if (str-eq name (jsp-name (load id))) (store! found (load id)) 0)
                (store! id (+ (load id) 1)))))
    (load found)))

; ============================================================================
; The declaration table
; ============================================================================
;; A cap rather than an unbounded list, because a parameter index becomes an `OP-PARM` aux and the
;; call ABI lays arguments out positionally. Eight is far beyond anything the spec needs (the
;; widest ECMAScript builtin signature is well under it) and the refusal is named, so the ninth
;; parameter is a diagnostic rather than a silently truncated signature.
(const JSL-MAX-PARAMS i64 8)

;; A `builtin` gets its own `OP-FUN` and is reached through `OP-CALL`; a `macro` is INLINED into the
;; caller's graph. Only a macro may carry a label, and the reason is structural rather than a
;; simplification: a label is a control edge into the caller's CFG, and a control edge cannot cross
;; a call boundary. Torque draws the same line for the same reason.
(const JSL-KIND-BUILTIN i64 0)
(const JSL-KIND-MACRO   i64 1)

;; ONE LABEL. The pattern a label exists for is a fast path with a bail-out to a generic path, which
;; needs exactly one. Supporting N is not hard, but an unbounded design here would be untested
;; generality, and the refusal above it is named.
(const JSL-MAX-LABELS i64 1)

(defstruct JslParam [(name (slice u8)) (ty i64)])

(defstruct JslDecl
  [(name          (slice u8))
   (kind          i64)          ; JSL-KIND-BUILTIN or JSL-KIND-MACRO
   (label         (slice u8))   ; the one label, or empty when the callable has none
   (transitioning bool)
   (cold          bool)
   (params-off    i64)          ; window into the shared `params` array
   (nparams       i64)
   (ret           i64)          ; a TyId; TY-NO-ID when `:ret` was omitted
   (usesmem       bool)         ; reads the heap, so it takes memory as a trailing parameter
   (heapparams    i64)          ; bitset: parameters whose value reaches a heap-array operand
   (body          (ptr rd/Sexp))
   (fun           i64)])        ; the OP-FUN node once lowered; NO-NODE until then

;; SOURCE RANGES ON EVERY REFUSAL. The roadmap requires that unsupported input "fail before object
;; publication with a stable diagnostic and source range", and `coil.reader` puts `lo`/`hi`/`source`
;; on every node, so the range is free — provided something remembers WHICH node the walk was on.
;;
;; A CURRENT-FORM CURSOR rather than a node argument threaded through thirty call sites. Each walk
;; entry point stamps the form it is about to inspect, and `jsl-fail!` copies whatever is stamped.
;; The failing check is therefore attributed to the innermost form that was under inspection, which
;; is the one a reader wants pointed at.
(defstruct Jsl
  [(decls   (ArrayList JslDecl))
   (params  (ArrayList JslParam))
   (binds   (ArrayList (slice u8)))   ; the checker's binding stack
   (marks   (ArrayList i64))          ; DFS colours, for macro-cycle detection
   (arities (ArrayList i64))          ; enclosing `loop` binding counts, innermost last
   (paths   (ArrayList (slice u8)))   ; source id -> the path it was read from
   (err     i64)
   (where   (slice u8))               ; the name the first failure was about
   (err-src i64)                      ; and the range it was at
   (err-lo  i64)
   (err-hi  i64)
   (cur-src i64)                      ; the form currently under inspection
   (cur-lo  i64)
   (cur-hi  i64)
   (inited  bool)])

;; The one global, the same `static`-in-an-accessor idiom `types`, `shapes` and `graph` use.
(defn jsl [] (-> (ptr Jsl))
  (let [p (static Jsl)]
    (if (load (field p inited)) 0
      (do (store! (field p inited) true)   ; set FIRST: `jsl-reset!` re-enters through here
          (store! (field p decls)  (al-new [JslDecl] (malloc-allocator)))
          (store! (field p params) (al-new [JslParam] (malloc-allocator)))
          (store! (field p binds)  (al-new [(slice u8)] (malloc-allocator)))
          (store! (field p marks)  (al-new [i64] (malloc-allocator)))
          (store! (field p paths)  (al-new [(slice u8)] (malloc-allocator)))
          (store! (field p arities) (al-new [i64] (malloc-allocator)))
          (store! (field p err)    JSL-OK)
          (store! (field p where)  "")
          0))
    p))

(defn jsl-reset! [] (-> i64)
  (let [p (jsl)]
    (al-clear! [JslDecl]     (field p decls))
    (al-clear! [JslParam]    (field p params))
    (al-clear! [(slice u8)]  (field p binds))
    (al-clear! [i64]         (field p marks))
    (al-clear! [(slice u8)]  (field p paths))
    (al-clear! [i64]         (field p arities))
    (store! (field p err-src) -1)
    (store! (field p err-lo) 0)
    (store! (field p err-hi) 0)
    (store! (field p cur-src) -1)
    (store! (field p cur-lo) 0)
    (store! (field p cur-hi) 0)
    (store! (field p err)   JSL-OK)
    (store! (field p where) "")
    0))

(defn jsl-err [] (-> i64) (load (field (jsl) err)))
(defn jsl-where [] (-> (slice u8)) (load (field (jsl) where)))
(defn jsl-ok? [] (-> bool) (= (jsl-err) JSL-OK))

;; Record a failure and hand its code back so a caller can propagate it in one expression. The
;; FIRST failure is kept: a later, derived complaint is noise, and the one that matters is the one
;; that noticed.
;; Stamp the form the walk is about to inspect. Cheap enough to do unconditionally: three stores,
;; and the alternative is a node parameter on every checking function.
(defn jsl-at! [(x (ptr rd/Sexp))] (-> i64)
  (let [p (jsl)]
    (store! (field p cur-src) (load (field x source)))
    (store! (field p cur-lo)  (load (field x lo)))
    (store! (field p cur-hi)  (load (field x hi)))
    0))

(defn jsl-fail! [(code i64) (where (slice u8))] (-> i64)
  (let [p (jsl)]
    (if (= (load (field p err)) JSL-OK)
        (do (store! (field p err) code)
            (store! (field p where) where)
            (store! (field p err-src) (load (field p cur-src)))
            (store! (field p err-lo)  (load (field p cur-lo)))
            (store! (field p err-hi)  (load (field p cur-hi)))
            0)
        0))
  code)

(defn jsl-err-src [] (-> i64) (load (field (jsl) err-src)))
(defn jsl-err-lo [] (-> i64) (load (field (jsl) err-lo)))
(defn jsl-err-hi [] (-> i64) (load (field (jsl) err-hi)))

(defn jsl-source-count [] (-> i64) (al-len [(slice u8)] (load (field (jsl) paths))))
(defn jsl-source-path [(i i64)] (-> (slice u8))
  (if (and (>= i 0) (< i (jsl-source-count)))
      (al-get (load (field (jsl) paths)) i)
      "<string>"))
(defn jsl-source-add! [(path (slice u8))] (-> i64)
  (al-push! [(slice u8)] (field (jsl) paths) path)
  (- (jsl-source-count) 1))

(defn jsl-decl-count [] (-> i64) (al-len [JslDecl] (load (field (jsl) decls))))
(defn jsl-param-count [] (-> i64) (al-len [JslParam] (load (field (jsl) params))))

;; `al-elem` returns a POINTER to the live element, so a field read is one expression and a field
;; write needs no read-modify-write. This used to be ten by-ref accessor functions plus an
;; `al-get`/`al-set!` round trip, because `al-get` returns an rvalue and `field` needs a place;
;; `al-elem` became public in coil.arraylist on 2026-08-07 and the boilerplate went with it.
;;
;; THE CONTRACT: A `-p` POINTER MUST NOT OUTLIVE THE EXPRESSION THAT DEREFERENCES IT. It aims into
;; the list's live storage, and the two ways it stops being right are different enough that
;; reasoning about one misses the other:
;;
;;   - GROWTH (`al-push!` past capacity, `al-reserve!`) moves the block, and the pointer dangles.
;;     This is the one people think of, and it is the one that crashes.
;;   - SLOT REUSE (`al-pop!` then any later `al-push!`) leaves the pointer perfectly valid AS
;;     MEMORY while the element it names stops being the one you asked for. `al-pop!` only
;;     decrements the length, so a read straight after a pop still returns the CORRECT value — and
;;     keeps returning it until an unrelated push happens to reuse that slot, at which point it
;;     silently returns a different record. A latent, order-dependent wrong answer that passes its
;;     tests, which is worse than a crash.
;;
;; Every accessor below dereferences immediately and hands back a value, so no caller can hold one.
;; `jl-drop!` in jsl_lower.coil is the one place the rule had to be applied by hand.
(defn jsl-decl-p [(i i64)] (-> (ptr JslDecl)) (al-elem [JslDecl] (field (jsl) decls) i))

(defn jsl-decl-name [(i i64)] (-> (slice u8)) (load (field (jsl-decl-p i) name)))
(defn jsl-decl-kind [(i i64)] (-> i64) (load (field (jsl-decl-p i) kind)))
(defn jsl-decl-label [(i i64)] (-> (slice u8)) (load (field (jsl-decl-p i) label)))
(defn jsl-macro? [(i i64)] (-> bool) (= (jsl-decl-kind i) JSL-KIND-MACRO))
(defn jsl-labelled? [(i i64)] (-> bool) (> (slice-len (jsl-decl-label i)) 0))
;; THE CLOSED-WORLD FUNCTION INDEX, WHICH IS NOT THE DECLARATION INDEX.
;;
;; A function index is a BIT in `Val.fidxs`, a 64-bit set, and the backend reads it as one:
;; `be-call-return-kind-fuel` matches a call's target mask against `(<< 1 (n-aux fun))` and skips
;; any function whose index is 63 or above. So the index is a scarce resource with a hard ceiling,
;; and spending one on a declaration that is never a function spends it for nothing.
;;
;; This used to be the declaration index, which meant every `macro` — 55 of the 88 entries, and none
;; of which has an `OP-FUN` at all — consumed a bit. The library crossed 63 declarations and
;; `StringIndexOfFrom` landed at index 66. Its bit fell outside the mask, so `be-call-return-kind`
;; could not identify the callee of a call to it, `be-js-tag-for-value` answered -1 for the boxed
;; result, and `String.prototype.indexOf` failed selection with `MSEL-UNSUPPORTED` — a definition
;; that neither used nor called the array entries that had just been added. Counting only the
;; builtins takes the same declaration from 66 to 29 and makes the index independent of how many
;; macros the library has.
;;
;; It is still DERIVED FROM DECLARATION ORDER rather than allocated on demand, because two paths
;; open a Fun — `jl-open-all!` for the whole library and `jl-require-decl!` on demand — and they
;; must agree on the index for the same definition whichever ran.
(defn jsl-decl-fidx [(i i64)] (-> i64)
  (let [(mut k) 0 (mut n) 0]
    (loop (if (>= (load k) i) (break)
            (do (if (jsl-macro? (load k)) 0 (store! n (+ (load n) 1)))
                (store! k (+ (load k) 1))
                0)))
    (load n)))

(defn jsl-decl-nparams [(i i64)] (-> i64) (load (field (jsl-decl-p i) nparams)))
(defn jsl-decl-transitioning? [(i i64)] (-> bool) (load (field (jsl-decl-p i) transitioning)))
(defn jsl-decl-cold? [(i i64)] (-> bool) (load (field (jsl-decl-p i) cold)))
(defn jsl-decl-ret [(i i64)] (-> i64) (load (field (jsl-decl-p i) ret)))
(defn jsl-decl-body [(i i64)] (-> (ptr rd/Sexp)) (load (field (jsl-decl-p i) body)))
(defn jsl-decl-fun [(i i64)] (-> i64) (load (field (jsl-decl-p i) fun)))
(defn jsl-decl-uses-memory? [(i i64)] (-> bool) (load (field (jsl-decl-p i) usesmem)))
(defn jsl-decl-heap-params [(i i64)] (-> i64) (load (field (jsl-decl-p i) heapparams)))
(defn jsl-decl-set-heap-params! [(i i64) (v i64)] (-> i64)
  (store! (field (jsl-decl-p i) heapparams) v) 0)
(defn jsl-decl-set-uses-memory! [(i i64) (v bool)] (-> i64)
  (store! (field (jsl-decl-p i) usesmem) v) 0)

;; How many arguments a caller supplies: the declared parameters, plus the heap when the callee
;; reads it. The IR already has this convention — `v-need-call-args` permits the LAST argument of a
;; call to be a memory producer — so passing the heap positionally is what the verifier expects
;; rather than something invented here.
(defn jsl-decl-call-arity [(i i64)] (-> i64) (jsl-decl-nparams i))

;; A store straight into the live element.
(defn jsl-decl-set-fun! [(i i64) (fun i64)] (-> i64)
  (store! (field (jsl-decl-p i) fun) fun)
  0)

(defn jsl-param-p [(d i64) (k i64)] (-> (ptr JslParam))
  (al-elem [JslParam] (field (jsl) params) (+ (load (field (jsl-decl-p d) params-off)) k)))
(defn jsl-param-name [(d i64) (k i64)] (-> (slice u8)) (load (field (jsl-param-p d k) name)))
(defn jsl-param-ty [(d i64) (k i64)] (-> i64) (load (field (jsl-param-p d k) ty)))

;; The parameter index a name denotes in this declaration, or -1. Linear because a signature is
;; capped at JSL-MAX-PARAMS and a hash here would cost more than it saves.
(defn jsl-param-index [(d i64) (name (slice u8))] (-> i64)
  (let [n (jsl-decl-nparams d) (mut k) 0 (mut found) -1]
    (loop (if (or (>= (load k) n) (>= (load found) 0))
              (break)
              (do
                (if (str-eq name (jsl-param-name d (load k))) (store! found (load k)) 0)
                (store! k (+ (load k) 1)))))
    (load found)))

(defn jsl-find [(name (slice u8))] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (str-eq name (jsl-decl-name (load i))) (store! found (load i)) 0)
                (store! i (+ (load i) 1)))))
    (load found)))

;; Does the definition under this NAME touch the heap? The frontend asks before it inlines, because
;; the dynamic alias has to be declared BEFORE the body's loads and stores exist rather than after:
;; every hand-written array path in `frontend_native_graph.coil` records it first, and a body built
;; ahead of the declaration leaves its memory nodes outside the alias subsequently declared dynamic.
;; An unknown name answers false; `jsl-inline!` is what refuses it, with a name.
(defn jsl-name-uses-memory? [(name (slice u8))] (-> bool)
  (let [d (jsl-find name)]
    (and (>= d 0) (jsl-decl-uses-memory? d))))

; ============================================================================
; Symbol classification
; ============================================================================
(const JSL-CH-COLON   i64 58)
(const JSL-CH-QUOTE   i64 34)
(const JSL-CH-PERCENT i64 37)
(const JSL-CH-HASH    i64 35)
(const JSL-CH-NEWLINE i64 10)
(const JSL-CH-SPACE   i64 32)
(const JSL-CH-SEMI    i64 59)
(const JSL-CH-TAB     i64 9)
(const JSL-CH-LPAREN  i64 40)
(const JSL-CH-RPAREN  i64 41)

(defn jsl-byte [(s (slice u8)) (i i64)] (-> i64) (cast i64 (slice-get s i)))

(defn jsl-starts-with? [(s (slice u8)) (c i64)] (-> bool)
  (and (> (slice-len s) 0) (= (jsl-byte s 0) c)))

(defn jsl-keyword? [(x (ptr rd/Sexp))] (-> bool) (rd/sexp-kw? x))

(defn jsl-prim-name? [(s (slice u8))] (-> bool) (jsl-starts-with? s JSL-CH-PERCENT))


;; A type annotation, or TY-NO-ID. A bare symbol carries the spellings with no bracket or space (`dyn`, `int=0`);
;; a string carries the rest of `text.coil`'s grammar verbatim (`"int=[0..9]"`). Both go to the one
;; type parser, so JSL cannot drift from the printed form.
(defn jsl-type-of [(x (ptr rd/Sexp))] (-> i64)
  (if (rd/sexp-str? x) (ty-try-parse (rd/sexp-str x))
    (if (rd/sexp-sym? x) (ty-try-parse (rd/sexp-sym x))
      TY-NO-ID)))

;; The lattice constant a bare literal symbol denotes, or TY-NO-ID when it is not one. These four
;; are the only symbols that are values rather than references, which is what makes an unbound
;; name detectable at all.
(defn jsl-literal-ty [(s (slice u8))] (-> i64)
  (if (str-eq s "true")      (t-bool-con true)
    (if (str-eq s "false")     (t-bool-con false)
      (if (str-eq s "undefined") (t-undef)
        (if (str-eq s "null")      (t-null)
          TY-NO-ID)))))

; ============================================================================
; The checker's binding stack
; ============================================================================
(defn jsl-scope-depth [] (-> i64) (al-len [(slice u8)] (load (field (jsl) binds))))

(defn jsl-scope-push! [(name (slice u8))] (-> i64)
  (al-push! [(slice u8)] (field (jsl) binds) name))

;; Pop back to a remembered depth. `let` is sequential, so a binding is visible to the bindings
;; after it and to the body, and to nothing outside.
(defn jsl-scope-drop! [(depth i64)] (-> i64)
  (loop (if (<= (jsl-scope-depth) depth) (break)
          (do (al-pop! [(slice u8)] (field (jsl) binds)) 0)))
  0)

(defn jsl-scope-has? [(name (slice u8))] (-> bool)
  (let [n (jsl-scope-depth) (mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) n) (load found))
              (break)
              (do
                (if (str-eq name (al-get (load (field (jsl) binds)) (load i)))
                    (store! found true) 0)
                (store! i (+ (load i) 1)))))
    (load found)))

; ============================================================================
; The body walk
; ============================================================================
;; Resolve every symbol and check every head, so that `jsl_lower` may PANIC on anything it does not
;; recognise instead of quietly emitting a plausible node. That division is the whole point of
;; having a checker: the lowering is allowed to assume the shape it walks is legal, and the only
;; place that assumption is established is here. `jsl-check-expr` is defined below and used above;
;; forward references resolve within a file, so the walk reads top-down in dependency order.
(defn jsl-check-args [(x (ptr rd/Sexp)) (d i64) (from i64)] (-> i64)
  (let [n (rd/sexp-count x) (mut i) from (mut err) JSL-OK]
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
              (break)
              (do
                (store! err (jsl-check-expr (rd/sexp-nth x (load i)) d))
                (store! i (+ (load i) 1)))))
    (load err)))

(defn jsl-check-let [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (< (rd/sexp-count x) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d))) 0)
    (let [binds (rd/sexp-nth x 1)]
      (if (not (rd/sexp-vec? binds))
          (return-from :done (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d))) 0)
      (let [depth (jsl-scope-depth)
            nb (rd/sexp-count binds)
            (mut i) 0
            (mut err) JSL-OK]
        (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (let [b (rd/sexp-nth binds (load i))]
                      (if (or (not (rd/sexp-list? b)) (!= (rd/sexp-count b) 2))
                          (store! err (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d)))
                          (if (not (rd/sexp-sym? (rd/sexp-nth b 0)))
                              (store! err (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d)))
                              (do
                                (store! err (jsl-check-expr (rd/sexp-nth b 1) d))
                                (if (= (load err) JSL-OK)
                                    (jsl-scope-push! (rd/sexp-sym (rd/sexp-nth b 0)))
                                    0)
                                0))))
                    (store! i (+ (load i) 1)))))
        (if (= (load err) JSL-OK)
            (store! err (jsl-check-args x d 2)) 0)
        (jsl-scope-drop! depth)
        (load err)))))

;; Where `:otherwise` sits in a call form, or -1. It is always the last two items when present, so
;; the positional argument count is everything before it.
(defn jsl-otherwise-at [(x (ptr rd/Sexp))] (-> i64)
  (let [n (rd/sexp-count x) (mut i) 1 (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0)) (break)
            (do
              (let [it (rd/sexp-nth x (load i))]
                (if (and (rd/sexp-kw? it) (str-eq (rd/sexp-kw it) "otherwise"))
                    (store! found (load i)) 0))
              (store! i (+ (load i) 1))
              0)))
    (load found)))

;; `(goto L)`. Legal only inside a macro that declares `L`, which is what makes a label a LEXICAL
;; construct rather than a dynamic one: the jump target is fixed by the definition that contains
;; the jump, not by whoever happens to be expanding it.
(defn jsl-check-goto [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (!= (rd/sexp-count x) 2)
        (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (jsl-decl-name d))) 0)
    (let [t (rd/sexp-nth x 1)]
      (if (not (rd/sexp-sym? t))
          (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (jsl-decl-name d))) 0)
      (if (not (str-eq (rd/sexp-sym t) (jsl-decl-label d)))
          (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (rd/sexp-sym t))) 0))
    JSL-OK))

(defn jsl-check-call [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (let [head (rd/sexp-nth x 0)]
      (if (not (rd/sexp-sym? head))
          (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM (jsl-decl-name d))) 0)
      (let [name (rd/sexp-sym head)
            owa (jsl-otherwise-at x)
            n (rd/sexp-count x)
            nargs (if (>= owa 0) (- owa 1) (- n 1))]
        ; `:otherwise` must be last-but-one and carry exactly one handler expression.
        (if (and (>= owa 0) (!= owa (- n 2)))
            (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)
        (if (jsl-prim-name? name)
            (do
              (if (>= owa 0)
                  (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)
              (let [id (jsp-find name)]
                (if (= id JSP-NONE) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-PRIM name)) 0)
                (if (!= nargs (jsp-arity id)) (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)))
            (let [callee (jsl-find name)]
              (if (< callee 0) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-CALL name)) 0)
              ; The heap argument is supplied by the lowering, never written in the source, so the
              ; DECLARED parameter count is what a call site is checked against.
              (if (!= nargs (jsl-decl-nparams callee))
                  (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
              ; A LABEL MUST HAVE SOMEWHERE TO GO, and only a label may be given one. Both
              ; directions are refused: a labelled macro with no handler would lower a `goto` into
              ; a control edge with no destination, and a handler on an unlabelled callee is a
              ; belief about the callee that the callee does not share.
              (if (and (jsl-labelled? callee) (< owa 0))
                  (return-from :done (jsl-fail! JSL-ERR-MISSING-OTHERWISE name)) 0)
              (if (and (not (jsl-labelled? callee)) (>= owa 0))
                  (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)))
        ; Positional arguments, then the handler expression when there is one. The handler is
        ; checked in the CALLER's scope, because that is where it is written and where it runs.
        (let [(mut err) JSL-OK (mut k) 1]
          (loop (if (or (> (load k) nargs) (!= (load err) JSL-OK)) (break)
                  (do (store! err (jsl-check-expr (rd/sexp-nth x (load k)) d))
                      (store! k (+ (load k) 1))
                      0)))
          (if (and (= (load err) JSL-OK) (>= owa 0))
              (store! err (jsl-check-expr (rd/sexp-nth x (+ owa 1)) d)) 0)
          (load err))))))

;; `(call fn arg ...)` invokes a JavaScript function value. It is a control/effect form rather
;; than a `%` primitive: calls have variable arity, produce a CallEnd control, and invalidate the
;; heap. The receiver ABI is deliberately separate; this form implements ordinary callback calls
;; with an undefined/unused receiver, while the universal JavaScript receiver convention is
;; standardised independently.
(defn jsl-check-js-call [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (< (rd/sexp-count x) 2)
      (jsl-fail! JSL-ERR-ARITY "call")
      (if (> (- (rd/sexp-count x) 2) JSL-MAX-PARAMS)
          (jsl-fail! JSL-ERR-TOO-MANY-PARAMS "call")
          (jsl-check-args x d 1))))

;; `(loop [(name init) ...] BODY...)`. The body is an expression: if it evaluates to `(recur ...)`
;; the loop iterates with those values, and otherwise its value is the loop's value. That is a
;; tail-recursive binding group, which is exactly what a loop Phi is — one phi per binding, the
;; init on the entry edge and the recur value on the back edge — so the surface and the IR agree
;; without an assignment form or a mutable local anywhere in the language.
(defn jsl-loop-depth [] (-> i64) (al-len [i64] (load (field (jsl) arities))))
(defn jsl-loop-arity [] (-> i64)
  (if (= (jsl-loop-depth) 0) -1
      (al-get (load (field (jsl) arities)) (- (jsl-loop-depth) 1))))

(defn jsl-check-loop [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (< (rd/sexp-count x) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d))) 0)
    (let [binds (rd/sexp-nth x 1)]
      (if (not (rd/sexp-vec? binds))
          (return-from :done (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d))) 0)
      (let [nb (rd/sexp-count binds)]
        (if (> nb JSL-MAX-PARAMS)
            (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS (jsl-decl-name d))) 0)
        (let [depth (jsl-scope-depth) (mut i) 0 (mut err) JSL-OK]
          ; The INITIALISERS are checked in the enclosing scope: they run once, before the loop
          ; exists, so a binding cannot see itself or its siblings.
          (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK)) (break)
                  (do
                    (let [b (rd/sexp-nth binds (load i))]
                      (if (or (not (rd/sexp-list? b)) (!= (rd/sexp-count b) 2))
                          (store! err (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d)))
                        (if (not (rd/sexp-sym? (rd/sexp-nth b 0)))
                            (store! err (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d)))
                          (store! err (jsl-check-expr (rd/sexp-nth b 1) d)))))
                    (store! i (+ (load i) 1))
                    0)))
          ; Then every binding is in scope for the body, all at once.
          (store! i 0)
          (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK)) (break)
                  (do (jsl-scope-push! (rd/sexp-sym (rd/sexp-nth (rd/sexp-nth binds (load i)) 0)))
                      (store! i (+ (load i) 1))
                      0)))
          (if (= (load err) JSL-OK)
              (do (al-push! [i64] (field (jsl) arities) nb)
                  (store! err (jsl-check-args x d 2))
                  (al-pop! [i64] (field (jsl) arities))
                  0)
              0)
          (jsl-scope-drop! depth)
          (load err))))))

(defn jsl-check-recur [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (= (jsl-loop-depth) 0)
        (return-from :done (jsl-fail! JSL-ERR-RECUR-OUTSIDE-LOOP (jsl-decl-name d))) 0)
    (if (!= (- (rd/sexp-count x) 1) (jsl-loop-arity))
        (return-from :done (jsl-fail! JSL-ERR-BAD-RECUR (jsl-decl-name d))) 0)
    (jsl-check-args x d 1)))

(defn jsl-check-if [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (!= (rd/sexp-count x) 4)
      (jsl-fail! JSL-ERR-BAD-IF (jsl-decl-name d))
      (jsl-check-args x d 1)))

;; Designed in docs/JSL.md, not built. Refused BY NAME so that a `.jsl` file using one cannot
;; produce a graph, and so that the diagnostic says which form stopped it rather than "unknown".
(defn jsl-unsupported-form? [(name (slice u8))] (-> bool) (str-eq name "class"))

(defn jsl-check-expr [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (jsl-at! x)
  (block :done
    (if (rd/sexp-int? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-float? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-str? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-sym? x)
        (let [s (rd/sexp-sym x)]
          ; THE ORDER IS THE LOWERING'S ORDER. `jl-lookup` searches the binding stack innermost
          ; first and parameters are its outermost entries, so a `let` shadows a parameter there;
          ; resolving parameters first here would make the two disagree about which node a name
          ; denotes, and only in a program that shadows.
          (if (!= (jsl-literal-ty s) TY-NO-ID) (return-from :done JSL-OK) 0)
          (if (jsl-scope-has? s) (return-from :done JSL-OK) 0)
          (if (>= (jsl-param-index d s) 0) (return-from :done JSL-OK) 0)
          (return-from :done (jsl-fail! JSL-ERR-UNBOUND s)))
        0)
    (if (= (rd/sexp-count x) 0)
        (return-from :done (jsl-fail! JSL-ERR-EMPTY-CALL (jsl-decl-name d))) 0)
    (let [head (rd/sexp-nth x 0)]
      (if (not (rd/sexp-sym? head))
          (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM (jsl-decl-name d))) 0)
      (let [name (rd/sexp-sym head)]
        (if (jsl-unsupported-form? name) (return-from :done (jsl-fail! JSL-ERR-UNSUPPORTED name)) 0)
        (if (str-eq name "let") (return-from :done (jsl-check-let x d)) 0)
        (if (str-eq name "if")  (return-from :done (jsl-check-if x d)) 0)
        (if (str-eq name "goto") (return-from :done (jsl-check-goto x d)) 0)
        (if (str-eq name "loop") (return-from :done (jsl-check-loop x d)) 0)
        (if (str-eq name "recur") (return-from :done (jsl-check-recur x d)) 0)
        (if (str-eq name "call") (return-from :done (jsl-check-js-call x d)) 0)
        (jsl-check-call x d)))))

; ============================================================================
; Macro recursion
; ============================================================================
;; A macro is expanded INTO the caller's graph, so a macro that reaches itself has no fixed point
;; and the lowering would not terminate. That has to be a diagnostic rather than a hang, and it has
;; to be found statically: a depth cap in the lowering would report the wrong thing (a legal deep
;; nest) at the wrong time (after nodes had been built).
;;
;; A standard three-colour DFS over the macro call graph. GREY means "on the current path", so
;; reaching a GREY node is a cycle; BLACK means "finished, and no cycle was found through it", which
;; is what stops a shared macro being walked once per caller.
(const JSL-MARK-WHITE i64 0)
(const JSL-MARK-GREY  i64 1)
(const JSL-MARK-BLACK i64 2)

(defn jsl-mark [(i i64)] (-> i64) (al-get (load (field (jsl) marks)) i))
(defn jsl-set-mark! [(i i64) (v i64)] (-> i64) (al-set! [i64] (field (jsl) marks) i v))

;; Walk one body for calls to macros, recursing through each. Split from the sexp walk below only
;; because the walk has to happen at every nesting depth and the colour logic should appear once.
(defn jsl-macro-edge [(from i64) (callee i64)] (-> i64)
  (if (not (jsl-macro? callee)) JSL-OK
    (if (= (jsl-mark callee) JSL-MARK-GREY)
        (jsl-fail! JSL-ERR-MACRO-RECURSION (jsl-decl-name callee))
      (if (= (jsl-mark callee) JSL-MARK-BLACK) JSL-OK
        (jsl-macro-dfs callee)))))

;; Descends into vectors too, for the reason `jsl-body-reads-memory?` documents: a macro called from
;; inside a `let` or `loop` binding would otherwise be invisible to cycle detection.
(defn jsl-macro-walk [(x (ptr rd/Sexp)) (from i64)] (-> i64)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) JSL-OK
    (let [n (rd/sexp-count x) (mut i) 0 (mut err) JSL-OK]
      ; The head, when it is a symbol, may name a macro; every item is then walked for nested calls.
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [callee (jsl-find (rd/sexp-sym (rd/sexp-nth x 0)))]
            (if (>= callee 0) (store! err (jsl-macro-edge from callee)) 0))
          0)
      (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
              (do (store! err (jsl-macro-walk (rd/sexp-nth x (load i)) from))
                  (store! i (+ (load i) 1))
                  0)))
      (load err))))

(defn jsl-macro-dfs [(d i64)] (-> i64)
  (jsl-set-mark! d JSL-MARK-GREY)
  (let [err (jsl-macro-walk (jsl-decl-body d) d)]
    (jsl-set-mark! d JSL-MARK-BLACK)
    err))

;; Which definitions read the heap, to a fixpoint over the call graph. A definition reads it if its
;; body names a heap-reading primitive, or if it calls one that does — and a `macro` propagates its
;; use to the caller it is inlined into, which is why this is computed over calls rather than read
;; off each body in isolation.
;; DESCENDS INTO VECTORS AS WELL AS LISTS. Since the surface moved to brackets, `let` and `loop`
;; bindings live in a `KVec`, so a walk that only recursed into `KList` would miss every call and
;; every primitive written inside one — silently, because a missed use just means "does not read the
;; heap" rather than an error.
(defn jsl-body-reads-memory? [(x (ptr rd/Sexp))] (-> bool)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) false
    (let [n (rd/sexp-count x) (mut i) 0 (mut found) false]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (str-eq name "call")
                (store! found true)
              (if (jsl-prim-name? name)
                (let [id (jsp-find name)]
                  (if (and (!= id JSP-NONE) (jsp-reads-memory? id)) (store! found true) 0))
              (let [c (jsl-find name)]
                (if (and (>= c 0) (jsl-decl-uses-memory? c)) (store! found true) 0)))))
          0)
      (loop (if (or (>= (load i) n) (load found)) (break)
              (do (if (jsl-body-reads-memory? (rd/sexp-nth x (load i))) (store! found true) 0)
                  (store! i (+ (load i) 1))
                  0)))
      (load found))))

;; THE HEAP MAY ONLY BE READ THROUGH AN OBJECT THE ENCLOSING FUNCTION CREATED, and this is an IR
;; fact rather than a style rule.
;;
;; Memory reaches a function as an `OP-ARG` carrying a memory aux — `v-mem-producer?` decides that
;; STRUCTURALLY, and `OP-PARM` is not on its list, so memory cannot be a parameter however it is
;; typed. Each function therefore synthesises its own entry heap: an opaque "some heap" that is NOT
;; its caller's. Objects the function allocates itself thread through that heap correctly, so a
;; builtin reading back its own writes is fine. What is not fine is reading through an array that
;; arrived as a PARAMETER: its contents live in the caller's chain, so the read sees nothing. An
;; `ArrayIndexOf` written that way answered -1 for an element the caller had just stored, verified
;; clean, and ran to completion. Nothing downstream notices.
;;
;; So the refusal is about parameters, not about heap use as such. `heapparams` is the set of a
;; definition's parameters whose value reaches the array operand of a heap primitive, computed to a
;; fixpoint through calls; a `builtin` with any is refused. A `macro` may have them, because it is
;; lowered into its caller's graph and therefore reads the caller's heap.
;;
;; KNOWN GAP: the flow analysis follows a parameter used directly and a parameter passed to a call,
;; plus a `let` that binds one to a new name. A parameter laundered through a call that RETURNS it
;; is not followed. That is narrower than the rule wants to be, and it is why this is documented
;; here rather than presented as a proof.
(defn jsl-param-of [(d i64) (x (ptr rd/Sexp))] (-> i64)
  (if (not (rd/sexp-sym? x)) -1 (jsl-param-index d (rd/sexp-sym x))))

(defn jsl-heap-walk [(x (ptr rd/Sexp)) (d i64) (acc (ptr i64))] (-> i64)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) 0
    (let [n (rd/sexp-count x)]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (jsl-prim-name? name)
                ; Operand 1 of every heap primitive is the array.
                (let [id (jsp-find name)]
                  (if (and (and (!= id JSP-NONE) (jsp-reads-memory? id)) (> n 1))
                      (let [k (jsl-param-of d (rd/sexp-nth x 1))]
                        (if (>= k 0) (store! acc (| (load acc) (<< 1 k))) 0))
                      0))
              (let [callee (jsl-find name)]
                (if (< callee 0) 0
                  (let [bits (jsl-decl-heap-params callee) (mut a) 1]
                    (loop (if (>= (load a) n) (break)
                            (do (if (!= (& bits (<< 1 (- (load a) 1))) 0)
                                    (let [k (jsl-param-of d (rd/sexp-nth x (load a)))]
                                      (if (>= k 0) (store! acc (| (load acc) (<< 1 k))) 0))
                                    0)
                                (store! a (+ (load a) 1))
                                0)))
                    0)))))
          0)
      (let [(mut i) 0]
        (loop (if (>= (load i) n) (break)
                (do (jsl-heap-walk (rd/sexp-nth x (load i)) d acc)
                    (store! i (+ (load i) 1))
                    0))))
      0)))

(defn jsl-resolve-heap-params! [] (-> i64)
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0]
    (loop (if (not (load changed)) (break)
            (do (store! changed false)
                (let [(mut i) 0]
                  (loop (if (>= (load i) n) (break)
                          (let [(mut acc) (jsl-decl-heap-params (load i))]
                            (jsl-heap-walk (jsl-decl-body (load i)) (load i) (mut acc))
                            (if (!= (load acc) (jsl-decl-heap-params (load i)))
                                (do (jsl-decl-set-heap-params! (load i) (load acc))
                                    (store! changed true) 0)
                                0)
                            (store! i (+ (load i) 1))
                            0))))
                (store! rounds (+ (load rounds) 1))
                (if (> (load rounds) (+ n 2))
                    (do (jsl-fail! JSL-ERR-MACRO-RECURSION "heap-parameter fixpoint") 0) 0)
                0)))
    JSL-OK))

(defn jsl-check-heap-shape [] (-> i64)
  (let [r (jsl-resolve-heap-params!)]
    (if (!= r JSL-OK) r
      (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
                (do (if (and (!= (jsl-decl-heap-params (load i)) 0) (not (jsl-macro? (load i))))
                        (store! err (jsl-fail! JSL-ERR-HEAP-IN-BUILTIN (jsl-decl-name (load i))))
                        0)
                    (store! i (+ (load i) 1))
                    0)))
        (load err)))))

(defn jsl-resolve-memory-use! [] (-> i64)
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0]
    (loop (if (not (load changed)) (break)
            (do
              (store! changed false)
              (let [(mut i) 0]
                (loop (if (>= (load i) n) (break)
                        (do
                          (if (jsl-decl-uses-memory? (load i)) 0
                            (if (jsl-body-reads-memory? (jsl-decl-body (load i)))
                                (do (jsl-decl-set-uses-memory! (load i) true)
                                    (store! changed true) 0)
                                0))
                          (store! i (+ (load i) 1))
                          0))))
              (store! rounds (+ (load rounds) 1))
              ; Each round either sets a flag that never clears or stops, so this terminates in at
              ; most one round per declaration. The cap makes that a named failure, not a hang.
              (if (> (load rounds) (+ n 1))
                  (do (jsl-fail! JSL-ERR-MACRO-RECURSION "memory-use fixpoint") 0)
                  0)
              0)))
    JSL-OK))

(defn jsl-check-macro-cycles [] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK]
    (al-clear! [i64] (field (jsl) marks))
    (loop (if (>= (load i) n) (break)
            (do (al-push! [i64] (field (jsl) marks) JSL-MARK-WHITE)
                (store! i (+ (load i) 1))
                0)))
    (store! i 0)
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
            (do (if (and (jsl-macro? (load i)) (= (jsl-mark (load i)) JSL-MARK-WHITE))
                    (store! err (jsl-macro-dfs (load i))) 0)
                (store! i (+ (load i) 1))
                0)))
    (load err)))

;; Check every declaration's body. Separate from `jsl-load!` because a body may call a definition
;; that appears LATER in the file: resolution has to see the whole table, so the table is built
;; first and walked second.
(defn jsl-check [] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK]
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
              (break)
              (do
                (al-clear! [(slice u8)] (field (jsl) binds))
                (store! err (jsl-check-expr (jsl-decl-body (load i)) (load i)))
                (store! i (+ (load i) 1)))))
    ; Cycles LAST: a body that does not resolve has no meaningful call graph, so reporting a
    ; recursion through an unknown name would name the wrong problem.
    (if (!= (load err) JSL-OK) (load err)
      (let [cycles (jsl-check-macro-cycles)]
        (if (!= cycles JSL-OK) cycles
          (let [mem (jsl-resolve-memory-use!)]
            (if (!= mem JSL-OK) mem (jsl-check-heap-shape))))))))

; ============================================================================
; The reader
; ============================================================================
(defn jsl-bool-of [(x (ptr rd/Sexp)) (out (ptr bool))] (-> bool)
  (if (not (rd/sexp-sym? x)) false
    (let [s (rd/sexp-sym x)]
      (if (str-eq s "true")  (do (store! out true) true)
        (if (str-eq s "false") (do (store! out false) true)
          false)))))

;; `:params [(name type) ...]`. A VECTOR of pairs. `coil.reader` distinguishes `KVec` from `KList`,
;; so the surface has one spelling and the parenthesised form is a named refusal rather than a
;; second accepted syntax.
(defn jsl-read-params! [(x (ptr rd/Sexp)) (name (slice u8)) (out (ptr i64))] (-> i64)
  (jsl-at! x)
  (block :done
    ; A VECTOR, not a list. `coil.reader` distinguishes them, so `:params ((x dyn))` is refused
    ; rather than silently accepted — the surface is one spelling, and it is the Coil-idiomatic one.
    (if (not (rd/sexp-vec? x)) (return-from :done (jsl-fail! JSL-ERR-BAD-PARAMS name)) 0)
    (let [n (rd/sexp-count x)]
      (if (> n JSL-MAX-PARAMS) (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS name)) 0)
      (let [(mut i) 0 (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (let [pr (rd/sexp-nth x (load i))]
                      (if (or (not (rd/sexp-list? pr)) (!= (rd/sexp-count pr) 2))
                          (store! err (jsl-fail! JSL-ERR-BAD-PARAMS name))
                          (if (not (rd/sexp-sym? (rd/sexp-nth pr 0)))
                              (store! err (jsl-fail! JSL-ERR-BAD-PARAMS name))
                              (let [t (jsl-type-of (rd/sexp-nth pr 1))]
                                (if (= t TY-NO-ID)
                                    (store! err (jsl-fail! JSL-ERR-BAD-TYPE
                                                           (rd/sexp-sym (rd/sexp-nth pr 0))))
                                    (let [(mut p) (zeroed JslParam)]
                                      (store! (field p name) (rd/sexp-sym (rd/sexp-nth pr 0)))
                                      (store! (field p ty) t)
                                      (al-push! [JslParam] (field (jsl) params) (load p))
                                      0))))))
                    (store! i (+ (load i) 1)))))
        (store! out n)
        (load err)))))

;; `:labels (Name)`. A label may only appear on a `macro`: a label is a control edge into the
;; caller's CFG and a control edge cannot cross a call boundary, so declaring one on a `builtin` is
;; refused rather than ignored.
(defn jsl-read-labels! [(x (ptr rd/Sexp)) (name (slice u8)) (kind i64) (out (ptr (slice u8)))] (-> i64)
  (block :done
    (if (!= kind JSL-KIND-MACRO) (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (if (not (rd/sexp-vec? x)) (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (if (> (rd/sexp-count x) JSL-MAX-LABELS)
        (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-LABELS name)) 0)
    (if (= (rd/sexp-count x) 0) (return-from :done JSL-OK) 0)
    (if (not (rd/sexp-sym? (rd/sexp-nth x 0)))
        (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (store! out (rd/sexp-sym (rd/sexp-nth x 0)))
    JSL-OK))

;; One top-level form. The declaration is assembled in locals and pushed ONLY on success, so a
;; malformed form leaves the table exactly as it found it — a half-built declaration is the state
;; from which a later pass produces a plausible wrong answer.
(defn jsl-read-decl! [(form (ptr rd/Sexp))] (-> i64)
  (jsl-at! form)
  (block :done
    (if (not (rd/sexp-list? form)) (return-from :done (jsl-fail! JSL-ERR-NOT-A-LIST "")) 0)
    (if (< (rd/sexp-count form) 2) (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "")) 0)
    (let [head (rd/sexp-nth form 0)]
      (if (not (rd/sexp-sym? head)) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM "")) 0)
      (let [kw (rd/sexp-sym head)]
        (if (jsl-unsupported-form? kw)
            (return-from :done (jsl-fail! JSL-ERR-UNSUPPORTED kw)) 0)
        (if (or (str-eq kw "builtin") (str-eq kw "macro")) 0
            (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM kw))))
      (let [nameform (rd/sexp-nth form 1)]
        (if (not (rd/sexp-sym? nameform)) (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "")) 0)
        (let [name (rd/sexp-sym nameform)]
          (if (>= (jsl-find name) 0) (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
          (let [n (rd/sexp-count form)
                kind (if (str-eq (rd/sexp-sym (rd/sexp-nth form 0)) "macro")
                         JSL-KIND-MACRO JSL-KIND-BUILTIN)
                params-off (jsl-param-count)
                (mut nparams) 0
                (mut ret) TY-NO-ID
                (mut label) ""
                (mut transitioning) false
                (mut cold) false
                (mut i) 2
                (mut err) JSL-OK]
            ; The keyword prefix. Each key consumes its value, so the first non-keyword ends it.
            (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
                    (let [k (rd/sexp-nth form (load i))]
                      (if (not (jsl-keyword? k)) (break)
                        (if (>= (+ (load i) 1) n)
                            (do (store! err (jsl-fail! JSL-ERR-BAD-KEY name)) (break))
                          (let [key (rd/sexp-kw k)
                                v (rd/sexp-nth form (+ (load i) 1))]
                            (if (str-eq key "params")
                                (store! err (jsl-read-params! v name (mut nparams)))
                              (if (str-eq key "ret")
                                  (let [t (jsl-type-of v)]
                                    (if (= t TY-NO-ID)
                                        (store! err (jsl-fail! JSL-ERR-BAD-TYPE name))
                                        (store! ret t))
                                    0)
                                (if (str-eq key "transitioning")
                                    (if (jsl-bool-of v (mut transitioning)) 0
                                        (store! err (jsl-fail! JSL-ERR-BAD-BOOL name)))
                                  (if (str-eq key "cold")
                                      (if (jsl-bool-of v (mut cold)) 0
                                          (store! err (jsl-fail! JSL-ERR-BAD-BOOL name)))
                                    (if (str-eq key "labels")
                                        (store! err (jsl-read-labels! v name kind (mut label)))
                                      (store! err (jsl-fail! JSL-ERR-BAD-KEY key)))))))
                            (store! i (+ (load i) 2))
                            0))))))
            (if (!= (load err) JSL-OK) (return-from :done (load err)) 0)
            ; EXACTLY ONE BODY. Zero is a declaration with nothing to lower; more than one would
            ; need a sequencing rule, and every JSL form is an expression, so there is none.
            (if (!= (- n (load i)) 1) (return-from :done (jsl-fail! JSL-ERR-NO-BODY name)) 0)
            (let [(mut d) (zeroed JslDecl)]
              (store! (field d name)          name)
              (store! (field d kind)          kind)
              (store! (field d label)         (load label))
              (store! (field d transitioning) (load transitioning))
              (store! (field d cold)          (load cold))
              (store! (field d params-off)    params-off)
              (store! (field d nparams)       (load nparams))
              (store! (field d ret)           (load ret))
              (store! (field d body)          (rd/sexp-nth form (load i)))
              (store! (field d fun)           NO-NODE)
              (al-push! [JslDecl] (field (jsl) decls) (load d))
              JSL-OK)))))))

;; Read a `.jsl` unit and check it. THE CALLER OWNS `src` AND MUST KEEP IT ALIVE: the reader hands
;; back symbols that are VIEWS into these bytes, and a declaration holds those views rather than
;; copying them. Freeing the source under a loaded table is a use-after-free, so tests pass string
;; literals, which have static storage.
;; Read one unit's declarations into the table WITHOUT checking. Reading and checking are separate
;; because a library spans several files and a body may call a definition in any of them: the whole
;; table has to exist before any name is resolved.
;;
;; THE CALLER OWNS `src` AND MUST KEEP IT ALIVE. `coil.reader` hands back `KSym`/`KStr` payloads that
;; are VIEWS into these bytes, and a declaration holds those views rather than copying them, so
;; freeing the source under a loaded table is a use-after-free. That is why `jsl-read-file!` below
;; leaks its buffer on purpose.
(defn jsl-read! [(raw (slice u8))] (-> i64)
  (jsl-read-source! raw (jsl-source-add! "<string>")))

;; Read one unit under a known source id, so every span the checker reports can be attributed to
;; the file it came from. `coil.reader` stamps the id onto each node, so nothing has to be threaded.
(defn jsl-read-source! [(raw (slice u8)) (source i64)] (-> i64)
  (match (rd/read-all (malloc-allocator) raw source)
    ; The reader's own refusal is kept as a named JSL failure rather than being retold: its Diag
    ; already carries the message and the byte range that noticed.
    (Err [d] (let [dd d] (jsl-fail! JSL-ERR-PARSE (load (field dd msg)))))
    (Ok [forms]
      (let [items (al-slice [rd/Sexp] (load forms))
            n (slice-len items)
            (mut i) 0
            (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (store! err (jsl-read-decl! (index (slice-data items) (load i))))
                    (store! i (+ (load i) 1)))))
        (load err)))))

;; Read one source and check it: the single-unit entry point.
(defn jsl-load! [(src (slice u8))] (-> i64)
  (let [err (jsl-read! src)]
    (if (= err JSL-OK) (jsl-check) err)))

; ============================================================================
; Loading the library off disk
; ============================================================================
;; THE BUFFER IS DELIBERATELY NEVER FREED. Declarations hold `(slice u8)` views into it for the
;; lifetime of the table, so freeing it is a use-after-free rather than tidiness. A `.jsl` library
;; is loaded once per process and lives as long as the compilation does, which bounds the leak by
;; the library's size on disk rather than by anything a compiled program does.
(defn jsl-read-file! [(path (slice u8))] (-> i64)
  (let [r (read-file (malloc-allocator) path)]
    (match r
      (Ok  [src] (jsl-read-source! src (jsl-source-add! path)))
      (Err [e]   (jsl-fail! JSL-ERR-NO-SUCH-FILE path)))))

(defn jsl-index-line-usable? [(s (slice u8))] (-> bool)
  (and (> (slice-len s) 0) (!= (jsl-byte s 0) JSL-CH-HASH)))

;; Trim ASCII whitespace. Written out rather than reached for from a string library because the
;; index is a two-rule format and a general splitter would be more code than the rules.
(defn jsl-trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0 (mut hi) (slice-len s)]
    (loop (if (or (>= (load lo) (load hi)) (> (jsl-byte s (load lo)) JSL-CH-SPACE)) (break)
            (do (store! lo (+ (load lo) 1)) 0)))
    (loop (if (or (>= (load lo) (load hi)) (> (jsl-byte s (- (load hi) 1)) JSL-CH-SPACE)) (break)
            (do (store! hi (- (load hi) 1)) 0)))
    (subslice s (load lo) (load hi))))

;; Load every unit an index names, then check the whole table once.
;;
;; AN EXPLICIT INDEX RATHER THAN A DIRECTORY SCAN. A scan's order is the filesystem's, and load
;; order is observable: it fixes declaration indices, which are closed-world function indices,
;; which appear in every printed graph and every golden hash. A library that reordered itself when
;; a file was renamed would make a golden diff mean nothing. Paths are used verbatim and are
;; therefore relative to the process working directory, which is the repository root under the gate.
(defn jsl-load-index! [(path (slice u8))] (-> i64)
  (let [r (read-file (malloc-allocator) path)]
    (match r
      (Err [e] (jsl-fail! JSL-ERR-NO-SUCH-FILE path))
      (Ok [src]
        (let [n (slice-len src) (mut at) 0 (mut err) JSL-OK (mut loaded) 0]
          (loop (if (or (>= (load at) n) (!= (load err) JSL-OK)) (break)
                  (let [(mut end) (load at)]
                    (loop (if (or (>= (load end) n) (= (jsl-byte src (load end)) JSL-CH-NEWLINE))
                              (break)
                            (do (store! end (+ (load end) 1)) 0)))
                    (let [line (jsl-trim (subslice src (load at) (load end)))]
                      (if (jsl-index-line-usable? line)
                          (do (store! err (jsl-read-file! line))
                              (store! loaded (+ (load loaded) 1))
                              0)
                          0))
                    (store! at (+ (load end) 1))
                    0)))
          ; AN EMPTY INDEX IS A FAILURE, not an empty library. Every assertion a suite makes over a
          ; loaded library is vacuously true of one that loaded nothing, and a mistyped index path
          ; is exactly how that happens in practice.
          (if (!= (load err) JSL-OK) (load err)
            (if (= (load loaded) 0) (jsl-fail! JSL-ERR-EMPTY-INDEX path)
              (jsl-check))))))))

;; The diagnostic. Printed by the tools and by a failing test, so the message names the code and
;; the definition rather than reporting that something, somewhere, was wrong.
;; `path:lo-hi: CODE at "name"`. The range comes from whichever form the walk was inspecting, which
;; is the innermost one under the failing check.
(defn jsl-report [(w (ptr Writer))] (-> i64)
  (if (jsl-ok?) 0
    (do (print-str w (jsl-source-path (jsl-err-src)))
        (ps w ":")
        (dec-print w (jsl-err-lo))
        (ps w "-")
        (dec-print w (jsl-err-hi))
        (ps w ": ")
        (ps w (jsl-err-name (jsl-err)))
        (ps w " at \"")
        (print-str w (jsl-where))
        (ps w "\"\n")
        0)))
