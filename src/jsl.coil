;; JSL: the language the JavaScript runtime library is written in. This file is the READER and the
;; CHECKER; `jsl_lower.coil` turns a checked declaration into an ideal graph. See docs/JSL.md for
;; why the language exists at all — the short version is that a builtin currently costs an opcode
;; plus about ten dispatch arms across five modules, and ECMAScript has a thousand of them.
;;
;; THE SURFACE IS READ WITH `coil.reader`. An earlier version of this file was written against the
;; old `coil.sexp`, which had no string tokenization, no comment syntax, and no bracket delimiters;
;; it needed a quote-aware comment stripper and an encoding of whitespace and parens inside quoted
;; runs just to express a multi-word error message. `coil.reader` has real `KStr`, `KKw`, `KVec` and
;; `KFloat` tokens and skips comments, so all of that is gone and the surface is ordinary Coil
;; syntax: brackets for parameter lists and bindings, `:keyword` for options, `"..."` for strings.
;;
;; THERE IS ONE TYPE SYSTEM IN THIS PROJECT AND JSL DOES NOT ADD A SECOND. A type annotation is
;; `text.coil`'s exact form, verbatim. Torque had to invent a type system to mirror C++ object
;; layouts; `ty.coil` already has an interned lattice with meet/join/isa carrying integer ranges,
;; function-index sets and shape sets, which is strictly more than Torque's. Reusing it means a
;; JSL annotation and a printed IR type can never disagree about what a spelling means.
;;
;; EVERY REFUSAL HAS A NAME, following `text.coil` and D11. A reader that returns a plausible
;; declaration on malformed input turns a format bug into a miscompile hunt, so `jsl-load!` keeps
;; the FIRST failure with the offending name and refuses to leave a half-built declaration in the
;; table: a definition either enters complete or does not enter.
;;
;; WHAT IS DESIGNED BUT NOT BUILT IS REFUSED BY NAME, never approximated. `macro`, `:labels`,
;; `:otherwise`, `loop` and `class` all report JSL-ERR-UNSUPPORTED naming the form. There is no
;; path by which a `.jsl` file using one of them produces a graph.
(module jsl)
(import "coil.fmt" :use *)
(import "coil.primitive" :as primitive)

(import "coil.alloc"     :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice"     :use *)
(import "coil.str"       :use *)
(import "coil.control"   :use *)
(import "coil.io"        :use *)
(import "coil.fs"        :use *)
(import "coil.result"    :use *)
(import "coil.match"     :use *)
(import "coil.reader"    :as rd)
(import "ty"   :use *)
(import "text" :use *)
(import "node" :use *)
(import "jsbuiltin_desc" :use *)

; ============================================================================
; Failure codes
; ============================================================================
;; ONE NAMED CODE PER FAILURE CLASS. "It was rejected" is satisfied by a checker that rejects
;; everything, so each code names a SPECIFIC check and the suite asserts the specific code.
(const JSL-OK                        i64 0)
(const JSL-ERR-NOT-A-LIST            i64 1)   ; a top-level form that is not a list
(const JSL-ERR-UNKNOWN-FORM          i64 2)   ; a top-level head that is not `builtin`
(const JSL-ERR-UNSUPPORTED           i64 3)   ; designed, not built; the form is named
(const JSL-ERR-BAD-NAME              i64 4)   ; a missing or non-symbol definition name
(const JSL-ERR-DUP-NAME              i64 5)   ; two definitions of one name
(const JSL-ERR-BAD-KEY               i64 6)   ; an unknown `:keyword`, or one with no value
(const JSL-ERR-BAD-PARAMS            i64 7)   ; `:params` is not a list of `(name type)` pairs
(const JSL-ERR-BAD-TYPE              i64 8)   ; an annotation `ty-try-parse` rejects
(const JSL-ERR-BAD-BOOL              i64 9)   ; a flag value that is not `true` or `false`
(const JSL-ERR-NO-BODY               i64 10)  ; no body expression, or more than one
(const JSL-ERR-UNBOUND               i64 11)  ; a symbol that is no parameter, binding or literal
(const JSL-ERR-UNKNOWN-PRIM          i64 12)  ; a `%Name` with no entry in the primitive table
(const JSL-ERR-UNKNOWN-CALL          i64 13)  ; a call to a name that is not a declared `builtin`
(const JSL-ERR-ARITY                 i64 14)  ; wrong operand count for a primitive or a call
(const JSL-ERR-BAD-LET               i64 15)  ; a `let` whose bindings are not `(name expr)` pairs
(const JSL-ERR-BAD-IF                i64 16)  ; an `if` without exactly three operands
(const JSL-ERR-EMPTY-CALL            i64 17)  ; `()`
(const JSL-ERR-TOO-MANY-PARAMS       i64 18)  ; more parameters than JSL-MAX-PARAMS
(const JSL-ERR-UNDECLARED-TRANSITION i64 19)  ; checked against the LOWERED GRAPH, in jsl_lower
(const JSL-ERR-NO-SUCH-FILE          i64 20)  ; an index entry, or an index, that will not open
(const JSL-ERR-EMPTY-INDEX           i64 21)  ; an index that named no unit at all
(const JSL-ERR-MACRO-RECURSION       i64 22)  ; a macro that expands into itself, directly or not
(const JSL-ERR-BAD-LABELS            i64 23)  ; `:labels` malformed, or declared on a `builtin`
(const JSL-ERR-TOO-MANY-LABELS       i64 24)  ; more labels than JSL-MAX-LABELS
(const JSL-ERR-BAD-GOTO              i64 25)  ; `goto` naming no label of the enclosing macro
(const JSL-ERR-MISSING-OTHERWISE     i64 26)  ; a labelled macro called with no `:otherwise`
(const JSL-ERR-UNEXPECTED-OTHERWISE  i64 27)  ; `:otherwise` on a callee that has no label
(const JSL-ERR-PARSE                 i64 28)  ; `coil.reader` refused the bytes; its Diag is kept
(const JSL-ERR-BAD-LOOP              i64 29)  ; a `loop` whose bindings are not a vector of pairs
(const JSL-ERR-BAD-RECUR             i64 30)  ; `recur` with the wrong argument count
(const JSL-ERR-RECUR-OUTSIDE-LOOP    i64 31)  ; `recur` with no enclosing `loop`
(const JSL-ERR-LOOP-NO-RECUR         i64 32)  ; a `loop` no path recurs to: that is a `let`
(const JSL-ERR-LOOP-NO-EXIT          i64 33)  ; a `loop` every path recurs from: it cannot terminate
(const JSL-ERR-HEAP-IN-BUILTIN       i64 34)  ; a `builtin` that reads the heap; see the note below
(const JSL-ERR-BAD-SPEC-METADATA      i64 35)  ; incomplete/invalid provenance or status combination
(const JSL-ERR-DUP-SPEC-CLAIM         i64 36)  ; two declarations claim one canonical spec item
(const JSL-ERR-BAD-REST               i64 37)  ; `(rest T)` is not the final parameter of a macro
(const JSL-ERR-BAD-RECORD             i64 38)  ; malformed record declaration/construction
(const JSL-ERR-DUP-RECORD             i64 39)  ; two schemas have the same name
(const JSL-ERR-UNKNOWN-RECORD         i64 40)  ; a record type names no declared schema
(const JSL-ERR-BAD-RECORD-FIELD       i64 41)  ; missing, duplicate, or unknown named field
(const JSL-ERR-RECORD-ESCAPE          i64 42)  ; a compile-away record crosses a runtime ABI
(const JSL-ERR-BAD-RECORD-LIST        i64 43)  ; malformed or schema-mismatched record List use
(const JSL-ERR-BAD-SLOT-LIST          i64 44)  ; malformed/duplicate internal-slot List declaration
(const JSL-ERR-SLOT-LIST-ESCAPE       i64 45)  ; compile-time slot List crossed a runtime ABI
(const JSL-ERR-BAD-INTERNAL-SLOT      i64 46)  ; malformed/unknown internal-slot declaration/use
(const JSL-ERR-BAD-METHOD-FAMILY      i64 47)  ; malformed/unknown internal-method family
(const JSL-ERR-BAD-INTERNAL-METHOD    i64 48)  ; malformed/unknown essential internal method

(defn jsl-err-name [(code i64)] (-> (slice u8))
  (case code
        JSL-OK                        "JSL-OK"
        JSL-ERR-NOT-A-LIST            "JSL-ERR-NOT-A-LIST"
        JSL-ERR-UNKNOWN-FORM          "JSL-ERR-UNKNOWN-FORM"
        JSL-ERR-UNSUPPORTED           "JSL-ERR-UNSUPPORTED"
        JSL-ERR-BAD-NAME              "JSL-ERR-BAD-NAME"
        JSL-ERR-DUP-NAME              "JSL-ERR-DUP-NAME"
        JSL-ERR-BAD-KEY               "JSL-ERR-BAD-KEY"
        JSL-ERR-BAD-PARAMS            "JSL-ERR-BAD-PARAMS"
        JSL-ERR-BAD-TYPE              "JSL-ERR-BAD-TYPE"
        JSL-ERR-BAD-BOOL              "JSL-ERR-BAD-BOOL"
        JSL-ERR-NO-BODY               "JSL-ERR-NO-BODY"
        JSL-ERR-UNBOUND               "JSL-ERR-UNBOUND"
        JSL-ERR-UNKNOWN-PRIM          "JSL-ERR-UNKNOWN-PRIM"
        JSL-ERR-UNKNOWN-CALL          "JSL-ERR-UNKNOWN-CALL"
        JSL-ERR-ARITY                 "JSL-ERR-ARITY"
        JSL-ERR-BAD-LET               "JSL-ERR-BAD-LET"
        JSL-ERR-BAD-IF                "JSL-ERR-BAD-IF"
        JSL-ERR-EMPTY-CALL            "JSL-ERR-EMPTY-CALL"
        JSL-ERR-TOO-MANY-PARAMS       "JSL-ERR-TOO-MANY-PARAMS"
        JSL-ERR-UNDECLARED-TRANSITION "JSL-ERR-UNDECLARED-TRANSITION"
        JSL-ERR-NO-SUCH-FILE          "JSL-ERR-NO-SUCH-FILE"
        JSL-ERR-EMPTY-INDEX           "JSL-ERR-EMPTY-INDEX"
        JSL-ERR-MACRO-RECURSION       "JSL-ERR-MACRO-RECURSION"
        JSL-ERR-BAD-LABELS            "JSL-ERR-BAD-LABELS"
        JSL-ERR-TOO-MANY-LABELS       "JSL-ERR-TOO-MANY-LABELS"
        JSL-ERR-BAD-GOTO              "JSL-ERR-BAD-GOTO"
        JSL-ERR-MISSING-OTHERWISE     "JSL-ERR-MISSING-OTHERWISE"
        JSL-ERR-UNEXPECTED-OTHERWISE  "JSL-ERR-UNEXPECTED-OTHERWISE"
        JSL-ERR-PARSE                 "JSL-ERR-PARSE"
        JSL-ERR-BAD-LOOP              "JSL-ERR-BAD-LOOP"
        JSL-ERR-BAD-RECUR             "JSL-ERR-BAD-RECUR"
        JSL-ERR-RECUR-OUTSIDE-LOOP    "JSL-ERR-RECUR-OUTSIDE-LOOP"
        JSL-ERR-LOOP-NO-RECUR         "JSL-ERR-LOOP-NO-RECUR"
        JSL-ERR-LOOP-NO-EXIT          "JSL-ERR-LOOP-NO-EXIT"
        JSL-ERR-BAD-SLOT-LIST          "JSL-ERR-BAD-SLOT-LIST"
        JSL-ERR-SLOT-LIST-ESCAPE       "JSL-ERR-SLOT-LIST-ESCAPE"
        JSL-ERR-BAD-INTERNAL-SLOT      "JSL-ERR-BAD-INTERNAL-SLOT"
        JSL-ERR-BAD-METHOD-FAMILY      "JSL-ERR-BAD-METHOD-FAMILY"
        JSL-ERR-BAD-INTERNAL-METHOD    "JSL-ERR-BAD-INTERNAL-METHOD"
        JSL-ERR-HEAP-IN-BUILTIN       "JSL-ERR-HEAP-IN-BUILTIN"
        JSL-ERR-BAD-SPEC-METADATA      "JSL-ERR-BAD-SPEC-METADATA"
        JSL-ERR-DUP-SPEC-CLAIM         "JSL-ERR-DUP-SPEC-CLAIM"
        JSL-ERR-BAD-REST               "JSL-ERR-BAD-REST"
        JSL-ERR-BAD-RECORD             "JSL-ERR-BAD-RECORD"
        JSL-ERR-DUP-RECORD             "JSL-ERR-DUP-RECORD"
        JSL-ERR-UNKNOWN-RECORD         "JSL-ERR-UNKNOWN-RECORD"
        JSL-ERR-BAD-RECORD-FIELD       "JSL-ERR-BAD-RECORD-FIELD"
        JSL-ERR-RECORD-ESCAPE          "JSL-ERR-RECORD-ESCAPE"
        JSL-ERR-BAD-RECORD-LIST        "JSL-ERR-BAD-RECORD-LIST"
        "<unknown jsl code>"))

; ============================================================================
; The primitive table
; ============================================================================
;; A primitive is spelled `%Name` and is EXACTLY ONE IR OP. One function per column, the same shape
;; `jsbuiltin_desc.coil` uses, so adding a primitive touches one place per column and a column
;; nobody filled is a `-1` that `jsp-check` refuses rather than a plausible default.
;;
;; THIS LAYER IS THE WHOLE PORTING SURFACE, and it is thin for a structural reason. Torque's
;; `base.tq` is ~70% `extern` because CodeStubAssembler is machine-level, so Torque has to import
;; ~500 primitives before it can say anything. Our IR is a sea of nodes that already has PropLoad,
;; ArrayStore, StringConcat, Box and TypeTest as ops, so JSL starts above the line where base.tq
;; ends.
(const JSP-NONE i64 -1)
(const JSP-ADD              i64 0)
(const JSP-SUB              i64 1)
(const JSP-MUL              i64 2)
(const JSP-DIV              i64 3)
(const JSP-MOD              i64 4)
(const JSP-NEG              i64 5)
(const JSP-NOT              i64 6)
(const JSP-EQ               i64 7)
(const JSP-LT               i64 8)
(const JSP-LE               i64 9)
(const JSP-BITAND           i64 10)
(const JSP-BITOR            i64 11)
(const JSP-BITXOR           i64 12)
(const JSP-SHL              i64 13)
(const JSP-SHR              i64 14)
(const JSP-USHR             i64 15)
(const JSP-BITNOT           i64 16)
(const JSP-STRINGLEN        i64 17)
(const JSP-STRINGEQ         i64 18)
(const JSP-STRINGCONCAT     i64 19)
(const JSP-STRINGCHARCODE   i64 20)
(const JSP-STRINGINDEXOF    i64 21)
(const JSP-STRINGCOMPARE    i64 22)
(const JSP-STRINGFROMCODE   i64 23)
;; 24 and 25 are retired: `%StringLower`/`%StringUpper` are lib/string/case.jsl now.
(const JSP-TOSTRING         i64 26)
(const JSP-PARSEINT         i64 27)
(const JSP-ISNAN            i64 28)
(const JSP-NUMBERTOSTRING   i64 29)
(const JSP-THROW            i64 30)
(const JSP-TOINTEGER        i64 31)
(const JSP-SUBSTRING        i64 32)
(const JSP-TONUMBER         i64 33)
(const JSP-ISINT            i64 34)
(const JSP-ISFLT            i64 35)
(const JSP-ISSTRING         i64 36)
(const JSP-ARRAYLEN         i64 37)
(const JSP-ARRAYLOAD        i64 38)
(const JSP-NEWARRAY         i64 39)
(const JSP-ARRAYSTORE       i64 40)
(const JSP-BOX              i64 41)
(const JSP-UNBOXINT         i64 42)
(const JSP-UNBOXFLT         i64 43)
(const JSP-FLOORNUM         i64 44)
(const JSP-CEILNUM          i64 45)
(const JSP-ROUNDNUM         i64 46)
;; `%ArrayResize a n v` — set the array's length to `n`, and ORDER the resize after `v`. The third
;; operand is not data the resize consumes; it is the value whose read must happen first. `pop`
;; loads the last element and then shortens the array, and nothing in the memory chain says the
;; load precedes the write that destroys what it read, so the load floats past it and selection
;; refuses the block with `MSEL-MEMORY-ORDER`. `OPTAG-ARRAYRESIZE`'s fifth input exists for exactly
;; this, and JSL has to name it because JSL has no other way to say "after".
(const JSP-ARRAYRESIZE      i64 48)
(const JSP-UNBOXOBJ         i64 49)
(const JSP-PROPLOADNAMED    i64 50)
(const JSP-PROPSTORENAMED   i64 51)
(const JSP-ISARRAY          i64 52)
(const JSP-UNBOXARRAY       i64 53)
(const JSP-UNBOXSTRING      i64 54)
(const JSP-PARSEFLOAT       i64 55)
(const JSP-ISUNDEFINED      i64 56)
(const JSP-ISNULL           i64 57)
(const JSP-ISBOOL           i64 58)
(const JSP-ISOBJECT         i64 59)
(const JSP-ISFUNCTION       i64 60)
(const JSP-PROPHASNAMED     i64 61)
(const JSP-PROTOTYPEHAS     i64 63)
(const JSP-EXPNUM           i64 64)
(const JSP-LOGNUM           i64 65)
(const JSP-SINNUM           i64 66)
(const JSP-COSNUM           i64 67)
(const JSP-TANNUM           i64 68)
(const JSP-ASINNUM          i64 69)
(const JSP-ACOSNUM          i64 70)
(const JSP-ATANNUM          i64 71)
(const JSP-SQRTNUM          i64 72)
(const JSP-POWNUM           i64 73)
(const JSP-RANDOMNUM        i64 74)
(const JSP-SETPROTOTYPE     i64 75)
(const JSP-PROPLOADKEY      i64 76)
(const JSP-PROPSTOREKEY     i64 77)
(const JSP-PROPHASKEY       i64 78)
(const JSP-PROPDELETEKEY    i64 79)
(const JSP-NEWOBJECT        i64 80)
(const JSP-OWNKEYCOUNT      i64 81)
(const JSP-OWNKEYAT         i64 82)
(const JSP-OBJECTFREEZE     i64 83)
(const JSP-INTERNALINIT     i64 84)
(const JSP-INTERNALTARGET   i64 85)
(const JSP-INTERNALINDEX    i64 86)
(const JSP-INTERNALKIND     i64 87)
(const JSP-INTERNALSETINDEX i64 88)
(const JSP-STRINGNORMALIZE  i64 89)
(const JSP-BOXARRAY         i64 90)
;; `%IsNumber` -- one test against the numeric union, where `%IsInt`/`%IsFlt` are the two single
;; tags underneath it. It exists because the disjunction is PROVABLE where neither half is: a
;; boxed operand carries the kind `int|flt`, so `ty-isa num num` decides and `ty-isa num int` does
;; not, and without this every `ToNumberValue` guard in `lib/` survives into the final graph.
;; Selection emits two `MI-JSTEST`s and an OR, exactly as the callable test already does.
;; `%UnboxNumber` -- a tagged number as a raw double, as a CONVERSION rather than an assertion.
;;
;; `%UnboxFlt` lowers through `jl-unbox`, which wraps its operand in a `Cast` to the target type,
;; and the evaluator checks that Cast. A number that is int-tagged does not satisfy `Cast flt`,
;; even though the unbox underneath converts it correctly -- `ev-unbox` turns RT-INT into RFlt and
;; aarch64 emits `sxt48`/`scvtf`. So the assertion refuses exactly the values the operation
;; handles.
;;
;; This is the node the frontend has always used for the same job: `fng-to-number-operand` is
;; `n-unbox!` with no Cast in front of it.
(const JSP-UNBOXNUMBER      i64 92)
(const JSP-ISNUMBER         i64 91)
(const JSP-TOFIXED          i64 93)
;; The string atoms. `%StringNew` answers a fresh string whose units must then be written in
;; ascending order by `%StringSetUnit`, which answers the SAME string so the writes order
;; themselves by data dependence: `(recur (%Add i 1) (%StringSetUnit out i u))`.
(const JSP-STRINGNEW        i64 94)
(const JSP-STRINGSETUNIT    i64 95)
(const JSP-ERRORCONSTRUCTOR i64 96)
(const JSP-OWNPROPERTYATTRS i64 97)
(const JSP-SETPROPERTYATTRS i64 98)
(const JSP-BUILTINOBJECT    i64 99)
(const JSP-DEFINEPROPERTYVALUE i64 100)
(const JSP-DEFINEPROPERTYGETTER i64 101)
(const JSP-DEFINEPROPERTYSETTER i64 102)
(const JSP-PROPERTYGETTER i64 103)
(const JSP-PROPERTYSETTER i64 104)
(const JSP-PROPERTYATTRS i64 105)
(const JSP-OBJECTISEXTENSIBLE i64 106)
(const JSP-OBJECTPREVENTEXTENSIONS i64 107)
(const JSP-ISSYMBOL         i64 108)
(const JSP-SYMBOLFROMOBJECT i64 109)
(const JSP-GETPROTOTYPE     i64 110)
(const JSP-BOXINT           i64 111)
(const JSP-COUNT            i64 112)

;; Retired primitive ids, for the reason `op-tag-retired?` exists: this space is dense and
;; scanned, and `jsp-op` panics on an id with no row. Never reused.
(defn jsp-retired? [(id i64)] (-> bool)
  (or (= id 24) (= id 25)     ; %StringLower, %StringUpper -- lib/string/case.jsl
      (or (= id 47)           ; %UnboxBool -- declared, never used by lib/
          (= id 62))))        ; %PropDeleteNamed -- same

(defn jsp-name [(id i64)] (-> (slice u8))
  (case id
        JSP-ADD            "%Add"
        JSP-SUB            "%Sub"
        JSP-MUL            "%Mul"
        JSP-DIV            "%Div"
        JSP-MOD            "%Mod"
        JSP-NEG            "%Neg"
        JSP-NOT            "%Not"
        JSP-EQ             "%Eq"
        JSP-LT             "%Lt"
        JSP-LE             "%Le"
        JSP-BITAND         "%BitAnd"
        JSP-BITOR          "%BitOr"
        JSP-BITXOR         "%BitXor"
        JSP-SHL            "%Shl"
        JSP-SHR            "%Shr"
        JSP-USHR           "%Ushr"
        JSP-BITNOT         "%BitNot"
        JSP-STRINGLEN      "%StringLen"
        JSP-STRINGEQ       "%StringEq"
        JSP-STRINGCONCAT   "%StringConcat"
        JSP-STRINGCHARCODE "%StringCharCode"
        JSP-STRINGINDEXOF  "%StringIndexOf"
        JSP-STRINGCOMPARE  "%StringCompare"
        JSP-STRINGFROMCODE "%StringFromCode"
        JSP-TOSTRING       "%ToString"
        JSP-PARSEINT       "%ParseInt"
        JSP-ISNAN          "%IsNaN"
        JSP-NUMBERTOSTRING "%NumberToString"
        JSP-THROW          "%Throw"
        JSP-TOINTEGER      "%ToInteger"
        JSP-SUBSTRING      "%Substring"
        JSP-TONUMBER       "%ToNumber"
        JSP-ISINT          "%IsInt"
        JSP-ISFLT          "%IsFlt"
        JSP-ISNUMBER       "%IsNumber"
        JSP-UNBOXNUMBER    "%UnboxNumber"
        JSP-ISSTRING       "%IsString"
        JSP-ARRAYLEN       "%ArrayLen"
        JSP-ARRAYLOAD      "%ArrayLoad"
        JSP-NEWARRAY       "%NewArray"
        JSP-ARRAYSTORE     "%ArrayStore"
        JSP-BOX            "%Box"
        JSP-UNBOXINT       "%UnboxInt"
        JSP-UNBOXFLT       "%UnboxFlt"
        JSP-FLOORNUM       "%FloorNum"
        JSP-CEILNUM        "%CeilNum"
        JSP-ROUNDNUM       "%RoundNum"
        JSP-ARRAYRESIZE    "%ArrayResize"
        JSP-UNBOXOBJ       "%UnboxObj"
        JSP-PROPLOADNAMED  "%PropLoadNamed"
        JSP-PROPSTORENAMED "%PropStoreNamed"
        JSP-ISARRAY        "%IsArray"
        JSP-UNBOXARRAY     "%UnboxArray"
        JSP-UNBOXSTRING    "%UnboxString"
        JSP-PARSEFLOAT     "%ParseFloat"
        JSP-ISUNDEFINED    "%IsUndefined"
        JSP-ISNULL         "%IsNull"
        JSP-ISBOOL         "%IsBool"
        JSP-ISOBJECT       "%IsObject"
        JSP-ISFUNCTION     "%IsFunction"
        JSP-PROPHASNAMED   "%PropHasNamed"
        JSP-PROTOTYPEHAS   "%PrototypeHas"
        JSP-EXPNUM         "%ExpNum"
        JSP-LOGNUM         "%LogNum"
        JSP-SINNUM         "%SinNum"
        JSP-COSNUM         "%CosNum"
        JSP-TANNUM         "%TanNum"
        JSP-ASINNUM        "%AsinNum"
        JSP-ACOSNUM        "%AcosNum"
        JSP-ATANNUM        "%AtanNum"
        JSP-SQRTNUM        "%SqrtNum"
        JSP-POWNUM         "%PowNum"
        JSP-RANDOMNUM      "%RandomNum"
        JSP-SETPROTOTYPE   "%SetPrototype"
        JSP-PROPLOADKEY    "%PropLoadKey"
        JSP-PROPSTOREKEY   "%PropStoreKey"
        JSP-PROPHASKEY     "%PropHasKey"
        JSP-PROPDELETEKEY  "%PropDeleteKey"
        JSP-NEWOBJECT      "%NewObject"
        JSP-OWNKEYCOUNT    "%OwnKeyCount"
        JSP-OWNKEYAT       "%OwnKeyAt"
        JSP-OBJECTFREEZE   "%ObjectFreeze"
        JSP-INTERNALINIT   "%InternalInit"
        JSP-INTERNALTARGET "%InternalTarget"
        JSP-INTERNALINDEX  "%InternalIndex"
        JSP-INTERNALKIND   "%InternalKind"
        JSP-INTERNALSETINDEX "%InternalSetIndex"
        JSP-STRINGNORMALIZE "%StringNormalize"
        JSP-BOXARRAY       "%BoxArray"
        JSP-TOFIXED        "%ToFixed"
        JSP-STRINGNEW      "%StringNew"
        JSP-STRINGSETUNIT  "%StringSetUnit"
        JSP-ERRORCONSTRUCTOR "%ErrorConstructor"
        JSP-OWNPROPERTYATTRS "%OwnPropertyAttributes"
        JSP-SETPROPERTYATTRS "%SetPropertyAttributes"
        JSP-BUILTINOBJECT    "%BuiltinObject"
        JSP-DEFINEPROPERTYVALUE "%DefinePropertyValue"
        JSP-DEFINEPROPERTYGETTER "%DefinePropertyGetter"
        JSP-DEFINEPROPERTYSETTER "%DefinePropertySetter"
        JSP-PROPERTYGETTER "%PropertyGetter"
        JSP-PROPERTYSETTER "%PropertySetter"
        JSP-PROPERTYATTRS "%PropertyAttributes"
        JSP-OBJECTISEXTENSIBLE "%ObjectIsExtensible"
        JSP-OBJECTPREVENTEXTENSIONS "%ObjectPreventExtensions"
        JSP-ISSYMBOL "%IsSymbol"
        JSP-SYMBOLFROMOBJECT "%SymbolFromObject"
        JSP-GETPROTOTYPE     "%GetPrototype"
        JSP-BOXINT           "%BoxInt"
        "<unknown jsl primitive>"))

(defn jsp-op [(id i64)] (-> Op)
  (case id
        JSP-ADD            (Add)
        JSP-SUB            (Sub)
        JSP-MUL            (Mul)
        JSP-DIV            (Div)
        JSP-MOD            (Mod)
        JSP-NEG            (Minus)
        JSP-NOT            (Not)
        JSP-EQ             (Eq)
        JSP-LT             (Lt)
        JSP-LE             (Le)
        JSP-BITAND         (BitAnd)
        JSP-BITOR          (BitOr)
        JSP-BITXOR         (BitXor)
        JSP-SHL            (Shl)
        JSP-SHR            (Shr)
        JSP-USHR           (UShr)
        JSP-BITNOT         (BitNot)
        JSP-STRINGLEN      (StringLen)
        JSP-STRINGEQ       (StringEq)
        JSP-STRINGCONCAT   (StringConcat)
        JSP-STRINGCHARCODE (StringCharCode)
        JSP-STRINGINDEXOF  (StringIndexOf)
        JSP-STRINGCOMPARE  (StringCompare)
        JSP-STRINGFROMCODE (StringFromCodeUnit)
        JSP-TOSTRING       (ToString)
        JSP-PARSEINT       (ParseInt)
        JSP-ISNAN          (IsNaN)
        JSP-NUMBERTOSTRING (NumberToString)
        JSP-THROW          (JsThrow)
        JSP-TOINTEGER      (ToInteger)
        JSP-SUBSTRING      (StringSubstring (jsp-aux id))
        JSP-TONUMBER       (ToNumber)
        JSP-ISINT          (TypeTest (jsp-aux id))
        JSP-ISFLT          (TypeTest (jsp-aux id))
        JSP-ISNUMBER       (TypeTest (jsp-aux id))
        JSP-UNBOXNUMBER    (Unbox (jsp-aux id))
        JSP-ISSTRING       (TypeTest (jsp-aux id))
        JSP-ARRAYLEN       (ArrayLen)
        JSP-ARRAYLOAD      (ArrayLoad (jsp-aux id))
        JSP-NEWARRAY       (New (jsp-aux id))
        JSP-ARRAYSTORE     (ArrayStore)
        JSP-BOX            (Box (jsp-aux id))
        JSP-UNBOXINT       (Unbox (jsp-aux id))
        JSP-UNBOXFLT       (Unbox (jsp-aux id))
        JSP-FLOORNUM       (JsBuiltin (jsp-aux id))
        JSP-CEILNUM        (JsBuiltin (jsp-aux id))
        JSP-ROUNDNUM       (JsBuiltin (jsp-aux id))
        JSP-ARRAYRESIZE    (ArrayResize)
        JSP-UNBOXOBJ       (Unbox (jsp-aux id))
        JSP-PROPLOADNAMED  (PropLoad (jsp-aux id))
        JSP-PROPSTORENAMED (PropStore (jsp-aux id))
        JSP-ISARRAY        (ArrayTest)
        JSP-UNBOXARRAY     (ArrayUnbox)
        JSP-UNBOXSTRING    (Unbox (jsp-aux id))
        JSP-PARSEFLOAT     (ParseFloat)
        JSP-ISUNDEFINED    (TypeTest (jsp-aux id))
        JSP-ISNULL         (TypeTest (jsp-aux id))
        JSP-ISBOOL         (TypeTest (jsp-aux id))
        JSP-ISOBJECT       (TypeTest (jsp-aux id))
        JSP-ISFUNCTION     (TypeTest (jsp-aux id))
        JSP-PROPHASNAMED   (PropHas (jsp-aux id))
        JSP-PROTOTYPEHAS   (ProtoHas)
        JSP-EXPNUM         (JsBuiltin (jsp-aux id))
        JSP-LOGNUM         (JsBuiltin (jsp-aux id))
        JSP-SINNUM         (JsBuiltin (jsp-aux id))
        JSP-COSNUM         (JsBuiltin (jsp-aux id))
        JSP-TANNUM         (JsBuiltin (jsp-aux id))
        JSP-ASINNUM        (JsBuiltin (jsp-aux id))
        JSP-ACOSNUM        (JsBuiltin (jsp-aux id))
        JSP-ATANNUM        (JsBuiltin (jsp-aux id))
        JSP-SQRTNUM        (JsBuiltin (jsp-aux id))
        JSP-POWNUM         (JsBuiltin (jsp-aux id))
        JSP-RANDOMNUM      (JsBuiltin (jsp-aux id))
        JSP-SETPROTOTYPE   (SetProto)
        JSP-PROPLOADKEY    (PropLoadKey (jsp-aux id))
        JSP-PROPSTOREKEY   (PropStoreKey (jsp-aux id))
        JSP-PROPHASKEY     (PropHasKey)
        JSP-PROPDELETEKEY  (PropDeleteKey)
        JSP-NEWOBJECT      (New (jsp-aux id))
        JSP-OWNKEYCOUNT    (OwnKeyCount)
        JSP-OWNKEYAT       (OwnKeyAt)
        JSP-OBJECTFREEZE   (ObjectFreeze)
        JSP-INTERNALINIT   (InternalStore (jsp-aux id))
        JSP-INTERNALTARGET (InternalLoad (jsp-aux id))
        JSP-INTERNALINDEX  (InternalLoad (jsp-aux id))
        JSP-INTERNALKIND   (InternalLoad (jsp-aux id))
        JSP-INTERNALSETINDEX (InternalStore (jsp-aux id))
        JSP-STRINGNORMALIZE (StringNormalize)
        JSP-BOXARRAY       (Box (jsp-aux id))
        JSP-TOFIXED        (ToFixed)
        JSP-STRINGNEW      (StringAlloc)
        JSP-STRINGSETUNIT  (StringSetUnit)
        JSP-ERRORCONSTRUCTOR (JsBuiltin (jsp-aux id))
        JSP-OWNPROPERTYATTRS (PropLoadKey (jsp-aux id))
        JSP-SETPROPERTYATTRS (PropStoreKey (jsp-aux id))
        JSP-BUILTINOBJECT    (JsBuiltin (jsp-aux id))
        JSP-DEFINEPROPERTYVALUE (PropStoreKey (jsp-aux id))
        JSP-DEFINEPROPERTYGETTER (PropStoreKey (jsp-aux id))
        JSP-DEFINEPROPERTYSETTER (PropStoreKey (jsp-aux id))
        JSP-PROPERTYGETTER (PropLoadKey (jsp-aux id))
        JSP-PROPERTYSETTER (PropLoadKey (jsp-aux id))
        JSP-PROPERTYATTRS (PropLoadKey (jsp-aux id))
        JSP-OBJECTISEXTENSIBLE (PropLoadKey (jsp-aux id))
        JSP-OBJECTPREVENTEXTENSIONS (PropStoreKey (jsp-aux id))
        JSP-ISSYMBOL (TypeTest (jsp-aux id))
        JSP-SYMBOLFROMOBJECT (JsBuiltin (jsp-aux id))
        JSP-GETPROTOTYPE     (PropLoadKey (jsp-aux id))
        JSP-BOXINT           (Box (jsp-aux id))
        (do (panic-corrupt "jsp-op: unknown primitive id") (Start))))

;; How many OPERANDS the primitive takes. Slot 0 of every one of these ops is the ordinary control
;; anchor and is not an operand, so the node built in `jsl_lower` has arity+1 inputs.
(defn jsp-arity [(id i64)] (-> i64)
  (case id
        JSP-ADD            2
        JSP-SUB            2
        JSP-MUL            2
        JSP-DIV            2
        JSP-MOD            2
        JSP-NEG            1
        JSP-NOT            1
        JSP-EQ             2
        JSP-LT             2
        JSP-LE             2
        JSP-BITAND         2
        JSP-BITOR          2
        JSP-BITXOR         2
        JSP-SHL            2
        JSP-SHR            2
        JSP-USHR           2
        JSP-BITNOT         1
        JSP-STRINGLEN      1
        JSP-STRINGEQ       2
        JSP-STRINGCONCAT   2
        JSP-STRINGCHARCODE 2
        JSP-STRINGINDEXOF  3
        JSP-STRINGCOMPARE  2
        JSP-STRINGFROMCODE 1
        JSP-TOSTRING       1
        JSP-PARSEINT       2
        JSP-ISNAN          1
        JSP-NUMBERTOSTRING 2
        JSP-THROW          1
        JSP-TOINTEGER      1
        JSP-SUBSTRING      3
        JSP-TONUMBER       1
        JSP-ISINT          1
        JSP-ISFLT          1
        JSP-ISNUMBER      1
        JSP-UNBOXNUMBER   1
        JSP-ISSTRING       1
        JSP-ARRAYLEN       1
        JSP-ARRAYLOAD      2
        JSP-NEWARRAY       0
        JSP-ARRAYSTORE     3
        JSP-BOX            1
        JSP-UNBOXINT       1
        JSP-UNBOXFLT       1
        JSP-FLOORNUM       1
        JSP-CEILNUM        1
        JSP-ROUNDNUM       1
        JSP-ARRAYRESIZE    3
        JSP-UNBOXOBJ       1
        JSP-PROPLOADNAMED  2
        JSP-PROPSTORENAMED 3
        JSP-ISARRAY        1
        JSP-UNBOXARRAY     1
        JSP-UNBOXSTRING    1
        JSP-PARSEFLOAT     1
        JSP-ISUNDEFINED    1
        JSP-ISNULL         1
        JSP-ISBOOL         1
        JSP-ISOBJECT       1
        JSP-ISFUNCTION     1
        JSP-PROPHASNAMED   2
        JSP-PROTOTYPEHAS   2
        JSP-EXPNUM         1
        JSP-LOGNUM         1
        JSP-SINNUM         1
        JSP-COSNUM         1
        JSP-TANNUM         1
        JSP-ASINNUM        1
        JSP-ACOSNUM        1
        JSP-ATANNUM        1
        JSP-SQRTNUM        1
        JSP-POWNUM         2
        JSP-RANDOMNUM      0
        JSP-SETPROTOTYPE   2
        JSP-PROPLOADKEY    2
        JSP-PROPSTOREKEY   3
        JSP-PROPHASKEY     2
        JSP-PROPDELETEKEY  2
        JSP-NEWOBJECT      0
        JSP-OWNKEYCOUNT    1
        JSP-OWNKEYAT       2
        JSP-OBJECTFREEZE   1
        JSP-INTERNALINIT   3
        JSP-INTERNALTARGET 1
        JSP-INTERNALINDEX  1
        JSP-INTERNALKIND   1
        JSP-INTERNALSETINDEX 2
        JSP-STRINGNORMALIZE 2
        JSP-BOXARRAY       1
        JSP-TOFIXED        2
        JSP-STRINGNEW      1
        JSP-STRINGSETUNIT  3
        JSP-ERRORCONSTRUCTOR 1
        JSP-OWNPROPERTYATTRS 2
        JSP-SETPROPERTYATTRS 3
        JSP-BUILTINOBJECT 1
        JSP-DEFINEPROPERTYVALUE 3
        JSP-DEFINEPROPERTYGETTER 3
        JSP-DEFINEPROPERTYSETTER 3
        JSP-PROPERTYGETTER 2
        JSP-PROPERTYSETTER 2
        JSP-PROPERTYATTRS 2
        JSP-OBJECTISEXTENSIBLE 2
        JSP-OBJECTPREVENTEXTENSIONS 3
        JSP-ISSYMBOL 1
        JSP-SYMBOLFROMOBJECT 1
        JSP-BOXINT           1
        JSP-GETPROTOTYPE 2
        -1))

;; The aux word a primitive's node carries. Almost every op takes 0, but `OPTAG-TYPETEST` takes the
;; TESTED TYPE, and a type id is interned at run time rather than being a compile-time constant —
;; which is why this is a function evaluated at lowering rather than a column of literals.
;; How a primitive relates to the heap. Memory is IMPLICIT in JSL: a definition never writes memory
;; plumbing, because threading a memory SSA value by hand is exactly the mechanical work the language
;; exists to remove. The lowering supplies the current memory to a reader and takes the new one back
;; from a writer.
;;
;; JSP-MEM-WRITE is declared but no primitive uses it yet: a write inside an `if` or a `loop` needs a
;; memory Phi at the merge, and until that exists a writing primitive would be silently wrong on any
;; branch. `jsp-writes-memory?` is what `jl-prim` refuses on, so the gap is a named error rather than
;; a miscompile.
(const JSP-MEM-NONE  i64 0)
(const JSP-MEM-READ  i64 1)
(const JSP-MEM-WRITE i64 2)

;; JSP-MEM-ALLOC needs the current CONTROL rather than the current memory: an allocation happening
;; twice is two objects, so `New` is the one memory-family op whose control input is real. With
;; SHAPE-ROOT it has no field memories at all, so it neither reads nor writes the property heap —
;; the elements written into it afterwards are what do.
(const JSP-MEM-ALLOC i64 3)

(defn jsp-mem [(id i64)] (-> i64)
  (case id
        JSP-ARRAYLEN   JSP-MEM-READ
        JSP-ARRAYLOAD  JSP-MEM-READ
        JSP-ARRAYSTORE JSP-MEM-WRITE
        JSP-ARRAYRESIZE JSP-MEM-WRITE
        JSP-PROPLOADNAMED JSP-MEM-READ
        JSP-PROPSTORENAMED JSP-MEM-WRITE
        JSP-PROPHASNAMED JSP-MEM-READ
        JSP-PROTOTYPEHAS JSP-MEM-READ
        JSP-SETPROTOTYPE JSP-MEM-WRITE
        JSP-PROPLOADKEY JSP-MEM-READ
        JSP-GETPROTOTYPE JSP-MEM-READ
        JSP-PROPSTOREKEY JSP-MEM-WRITE
        JSP-DEFINEPROPERTYVALUE JSP-MEM-WRITE
        JSP-DEFINEPROPERTYGETTER JSP-MEM-WRITE
        JSP-DEFINEPROPERTYSETTER JSP-MEM-WRITE
        JSP-PROPERTYGETTER JSP-MEM-READ
        JSP-PROPERTYSETTER JSP-MEM-READ
        JSP-PROPERTYATTRS JSP-MEM-READ
        JSP-OBJECTISEXTENSIBLE JSP-MEM-READ
        JSP-OBJECTPREVENTEXTENSIONS JSP-MEM-WRITE
        JSP-OWNPROPERTYATTRS JSP-MEM-READ
        JSP-SETPROPERTYATTRS JSP-MEM-WRITE
        JSP-PROPHASKEY JSP-MEM-READ
        JSP-PROPDELETEKEY JSP-MEM-WRITE
        JSP-NEWARRAY   JSP-MEM-ALLOC
        JSP-NEWOBJECT  JSP-MEM-ALLOC
        JSP-OWNKEYCOUNT JSP-MEM-READ
        JSP-OWNKEYAT JSP-MEM-READ
        JSP-OBJECTFREEZE JSP-MEM-WRITE
        JSP-INTERNALINIT JSP-MEM-WRITE
        JSP-INTERNALTARGET JSP-MEM-READ
        JSP-INTERNALINDEX JSP-MEM-READ
        JSP-INTERNALKIND JSP-MEM-READ
        JSP-INTERNALSETINDEX JSP-MEM-WRITE
        JSP-MEM-NONE))

(defn jsp-touches-memory? [(id i64)] (-> bool) (!= (jsp-mem id) JSP-MEM-NONE))
;; Allocation is excluded here on purpose: it does not read the CALLER's heap, so a definition that
;; only allocates may still be an ordinary `builtin`.
(defn jsp-reads-memory? [(id i64)] (-> bool)
  (or (= (jsp-mem id) JSP-MEM-READ) (= (jsp-mem id) JSP-MEM-WRITE)))
(defn jsp-writes-memory? [(id i64)] (-> bool) (= (jsp-mem id) JSP-MEM-WRITE))

(defn jsp-aux [(id i64)] (-> i64)
  (case id
        JSP-ISINT    (t-int)
        JSP-ISFLT    (t-flt)
        JSP-ISNUMBER (t-num)
        JSP-UNBOXNUMBER (t-flt)
        JSP-UNBOXINT (t-int)
        JSP-UNBOXFLT (t-flt)
        JSP-UNBOXOBJ  (t-obj)
        JSP-UNBOXSTRING (t-str)
        ;; The descriptor id the `OPTAG-JSBUILTIN` runtime dispatches on. Rounding a double needs a
        ;; real rounding operation, which is the machine surface rather than something JSL can
        ;; compose; the descriptor table already has libc behind it and both execution modes take
        ;; the same dynamic-value ABI.
        JSP-FLOORNUM JBI-FLOOR
        JSP-CEILNUM  JBI-CEIL
        JSP-ROUNDNUM JBI-ROUND
        JSP-EXPNUM   JBI-EXP
        JSP-LOGNUM   JBI-LOG
        JSP-SINNUM   JBI-SIN
        JSP-COSNUM   JBI-COS
        JSP-TANNUM   JBI-TAN
        JSP-ASINNUM  JBI-ASIN
        JSP-ACOSNUM  JBI-ACOS
        JSP-ATANNUM  JBI-ATAN
        JSP-SQRTNUM  JBI-SQRT
        JSP-POWNUM   JBI-POW
        JSP-RANDOMNUM JBI-RANDOM
        ;; Runtime descriptor 20 returns an opaque function-tagged identity for one built-in Error
        ;; constructor kind. Its JavaScript-visible construction and properties remain in lib/.
        JSP-ERRORCONSTRUCTOR 20
        ;; Stable synthetic object identities back the closed world's built-in prototype objects.
        ;; Their properties and prototype semantics are still initialized and composed in lib/.
        JSP-BUILTINOBJECT 21
        JSP-SYMBOLFROMOBJECT 22
        JSP-BOXINT BOX-AUX-INT
        JSP-ISSTRING (t-str)
        JSP-ISUNDEFINED (t-undef)
        JSP-ISNULL (t-null)
        JSP-ISBOOL (t-bool)
        JSP-ISOBJECT (t-obj)
        JSP-ISFUNCTION (t-fun)
        JSP-ISSYMBOL (t-sym)
        JSP-INTERNALINIT INTERNAL-INIT
        JSP-INTERNALTARGET INTERNAL-TARGET
        JSP-INTERNALINDEX INTERNAL-INDEX
        JSP-INTERNALKIND INTERNAL-KIND
        JSP-INTERNALSETINDEX INTERNAL-SET-INDEX
        JSP-PROPLOADKEY 0
        JSP-PROPSTOREKEY 1
        JSP-OWNPROPERTYATTRS 14
        JSP-SETPROPERTYATTRS 15
        JSP-DEFINEPROPERTYVALUE 16
        JSP-DEFINEPROPERTYGETTER 17
        JSP-DEFINEPROPERTYSETTER 18
        JSP-PROPERTYGETTER 19
        JSP-PROPERTYSETTER 20
        JSP-PROPERTYATTRS 21
        JSP-OBJECTISEXTENSIBLE 22
        JSP-OBJECTPREVENTEXTENSIONS 23
        JSP-GETPROTOTYPE 24
        0))

(defn jsp-find [(name (slice u8))] (-> i64)
  (let [(mut id) 0 (mut found) JSP-NONE]
    (loop (if (or (>= (load id) JSP-COUNT) (!= (load found) JSP-NONE))
              (break)
              (do
                ;; A retired id has no name row, so every one of them would answer the same
                ;; "<unknown>" marker and the first would win a lookup for it. Skip them: a
                ;; retired primitive cannot be reached by name from anywhere.
                (if (and (not (jsp-retired? (load id))) (= name (jsp-name (load id))))
                    (set! found (load id))
                    0)
                (set! id (+ (load id) 1)))))
    (load found)))

; ============================================================================
; The declaration table
; ============================================================================
;; A cap rather than an unbounded list, because a parameter index becomes an `OPTAG-PARM` aux and the
;; call ABI lays arguments out positionally. Sixteen accommodates internal spec algorithms which
;; carry several pieces of state even though public ECMAScript signatures are much narrower; the
;; refusal remains named, so a wider definition is diagnosed rather than silently truncated.
(const JSL-MAX-PARAMS i64 16)

;; A `builtin` gets its own `OPTAG-FUN` and is reached through `OPTAG-CALL`; a `macro` is INLINED into the
;; caller's graph. Only a macro may carry a label, and the reason is structural rather than a
;; simplification: a label is a control edge into the caller's CFG, and a control edge cannot cross
;; a call boundary. Torque draws the same line for the same reason.
(const JSL-KIND-BUILTIN i64 0)
(const JSL-KIND-MACRO   i64 1)
(const JSL-KIND-CALLABLE i64 2)

(const JSL-SPEC-UNSPECIFIED i64 0)
(const JSL-SPEC-COMPLETE    i64 1)
(const JSL-SPEC-PARTIAL     i64 2)

;; ONE LABEL. The pattern a label exists for is a fast path with a bail-out to a generic path, which
;; needs exactly one. Supporting N is not hard, but an unbounded design here would be untested
;; generality, and the refusal above it is named.
(const JSL-MAX-LABELS i64 1)
(const JSL-MAX-RECORD-LEAVES i64 256)

(defstruct JslParam
  [(name (slice u8)) (ty i64) (record i64) (slotlist bool) (rest bool)
   ;; Canonical half-open range in the declaration's lowered parameter vector. Logical source
   ;; arity remains `nparams`; these fields are the ABI shape and are computed once after checking.
   (lowered-off i64) (lowered-width i64)])
(defstruct JslSignature
  [;; Logical source signature.
   (params-off i64) (nparams i64) (ret i64) (ret-record i64)
   ;; Canonical physical ABI vectors retained in `Jsl.signaturetypes`.
   (lowered-params-off i64) (lowered-nparams i64)
   (lowered-results-off i64) (lowered-nresults i64)
   ;; Effect/linkage facts are part of function compatibility, not parallel declaration trivia.
   (transitioning bool) (cold bool) (usesmem bool) (callsback bool) (canthrow bool)])
(defstruct JslRecordDecl
  [(name (slice u8)) (fields-off i64) (nfields i64) (flat-off i64) (flat-width i64)])
(defstruct JslRecordField
  [(name (slice u8)) (ty i64) (record i64) (flat-off i64) (flat-width i64)])
(defstruct JslSlotListDecl
  [(name (slice u8)) (slots-off i64) (nslots i64)])
(const JSL-SLOT-JS-VALUE i64 1)
(const JSL-SLOT-BOOLEAN i64 2)
(const JSL-SLOT-SPEC-LIST i64 3)
(defstruct JslInternalSlotDecl [(name (slice u8)) (storage i64)])
(defstruct JslMethodFamilyDecl [(name (slice u8))])
(defstruct JslInternalMethodDecl [(name (slice u8))])

(defstruct JslDecl
  [(name          (slice u8))
   (kind          i64)          ; JSL-KIND-BUILTIN or JSL-KIND-MACRO
   (label         (slice u8))   ; the one label, or empty when the callable has none
   (spec          (slice u8)) ; ecma262@<full commit>#<stable clause id>, or empty
   (specname      (slice u8)) ; canonical algorithm/builtin label from the pinned ledger
   (specstatus    i64)        ; JSL-SPEC-*, never inferred from a name match
   (specializes   (slice u8)) ; pinned canonical item deliberately narrowed by this helper
   (deviation     (slice u8)) ; required for partial, forbidden for complete
   (signature     JslSignature) ; the one logical and physical function signature
   (captures-off  i64)
   (ncaptures     i64)
   (heapparams    i64)          ; bitset: parameters whose value reaches a heap-array operand
   (body          (ptr rd/Sexp))
   (fun           i64)])        ; the OPTAG-FUN node once lowered; NO-NODE until then

;; SOURCE RANGES ON EVERY REFUSAL. The roadmap requires that unsupported input "fail before object
;; publication with a stable diagnostic and source range", and `coil.reader` puts `lo`/`hi`/`source`
;; on every node, so the range is free — provided something remembers WHICH node the walk was on.
;;
;; A CURRENT-FORM CURSOR rather than a node argument threaded through thirty call sites. Each walk
;; entry point stamps the form it is about to inspect, and `jsl-fail!` copies whatever is stamped.
;; The failing check is therefore attributed to the innermost form that was under inspection, which
;; is the one a reader wants pointed at.
(defstruct Jsl
  [;; THE DECLARATION CALL GRAPH, built once as CSR: callee-first/count index callee-entry.
   ;;
   ;; The effect fixpoints -- memory use, callback use, throw use -- each iterated
   ;; "for every declaration, walk its whole s-expression body and ask whether it or anything it
   ;; calls has the flag", once per round. That is a syntax walk of the entire library per round,
   ;; per fixpoint, and it was 37 ms of a 350 ms cold compile. The FIRST round of each still walks
   ;; the bodies, because that is what computes the declaration's own bit; every round after it can
   ;; only add a flag by propagating from a callee, which is integer work over these edges.
   (callee-first (ArrayList i64))
   (callee-count (ArrayList i64))
   (callee-entry (ArrayList i64))
   (decls   (ArrayList JslDecl))
   (params  (ArrayList JslParam))
   (signaturetypes (ArrayList i64)) ; retained physical parameter/result vectors
   (records (ArrayList JslRecordDecl))
   (recordfields (ArrayList JslRecordField))
   (recordflattypes (ArrayList i64)) ; one canonical recursive physical type vector per schema
   (slotlists (ArrayList JslSlotListDecl))
   (slotnames (ArrayList (slice u8)))
   (internalslots (ArrayList JslInternalSlotDecl))
   (methodfamilies (ArrayList JslMethodFamilyDecl))
   (internalmethods (ArrayList JslInternalMethodDecl))
   (captures (ArrayList (slice u8)))
   (binds   (ArrayList (slice u8)))   ; the checker's binding stack
   (bindrecords (ArrayList i64))      ; schema index parallel to `binds`, or -1
   (bindlists (ArrayList i64))        ; materialized Record List schema, parallel to `binds`
   (bindslotlists (ArrayList i64))    ; compile-time slot-list identity, parallel to `binds`
   (marks   (ArrayList i64))          ; DFS colours, for macro-cycle detection
   (arities (ArrayList i64))          ; enclosing `loop` binding counts, innermost last
   (looprecordbases (ArrayList i64))  ; base in `looprecords` for each active loop
   (looprecords (ArrayList i64))      ; one inferred schema per source loop binding
   (looplists (ArrayList i64))        ; parallel inferred Record-list schema per loop binding
   (loopslotlists (ArrayList i64))    ; parallel compile-time slot-list identity per loop binding
   (paths   (ArrayList (slice u8)))   ; source id -> the path it was read from
   (err     i64)
   (where   (slice u8))               ; the name the first failure was about
   (err-src i64)                      ; and the range it was at
   (err-lo  i64)
   (err-hi  i64)
   (cur-src i64)                      ; the form currently under inspection
   (cur-lo  i64)
   (cur-hi  i64)
   (fidx-base i64)                    ; namespace prefix reserved by the embedding frontend
   (inited  bool)])

;; The one global, the same `static`-in-an-accessor idiom `types`, `shapes` and `graph` use.
(defn jsl [] (-> (ptr Jsl))
  (let [p (primitive/alloc-static Jsl)]
    (if (.inited p) 0
      (do (set! (.inited p) true)   ; set FIRST: `jsl-reset!` re-enters through here
          (set! (.callee-first p) (al-new [i64] (malloc-allocator)))
          (set! (.callee-count p) (al-new [i64] (malloc-allocator)))
          (set! (.callee-entry p) (al-new [i64] (malloc-allocator)))
          (set! (.decls p) (al-new [JslDecl] (malloc-allocator)))
          (set! (.params p) (al-new [JslParam] (malloc-allocator)))
          (set! (.signaturetypes p) (al-new [i64] (malloc-allocator)))
          (set! (.records p) (al-new [JslRecordDecl] (malloc-allocator)))
          (set! (.recordfields p) (al-new [JslRecordField] (malloc-allocator)))
          (set! (.recordflattypes p) (al-new [i64] (malloc-allocator)))
          (set! (.slotlists p) (al-new [JslSlotListDecl] (malloc-allocator)))
          (set! (.slotnames p) (al-new [(slice u8)] (malloc-allocator)))
          (set! (.internalslots p) (al-new [JslInternalSlotDecl] (malloc-allocator)))
          (set! (.methodfamilies p) (al-new [JslMethodFamilyDecl] (malloc-allocator)))
          (set! (.internalmethods p) (al-new [JslInternalMethodDecl] (malloc-allocator)))
          (set! (.captures p) (al-new [(slice u8)] (malloc-allocator)))
          (set! (.binds p) (al-new [(slice u8)] (malloc-allocator)))
          (set! (.bindrecords p) (al-new [i64] (malloc-allocator)))
          (set! (.bindlists p) (al-new [i64] (malloc-allocator)))
          (set! (.bindslotlists p) (al-new [i64] (malloc-allocator)))
          (set! (.marks p) (al-new [i64] (malloc-allocator)))
          (set! (.paths p) (al-new [(slice u8)] (malloc-allocator)))
          (set! (.arities p) (al-new [i64] (malloc-allocator)))
          (set! (.looprecordbases p) (al-new [i64] (malloc-allocator)))
          (set! (.looprecords p) (al-new [i64] (malloc-allocator)))
          (set! (.looplists p) (al-new [i64] (malloc-allocator)))
          (set! (.loopslotlists p) (al-new [i64] (malloc-allocator)))
          (set! (.err p) JSL-OK)
          (set! (.where p) "")
          0))
    p))

(defn jsl-reset! [] (-> i64)
  (let [p (jsl)]
    (al-clear! [i64]         (field p callee-first))
    (al-clear! [i64]         (field p callee-count))
    (al-clear! [i64]         (field p callee-entry))
    (al-clear! [JslDecl]     (field p decls))
    (al-clear! [JslParam]    (field p params))
    (al-clear! [i64]         (field p signaturetypes))
    (al-clear! [JslRecordDecl] (field p records))
    (al-clear! [JslRecordField] (field p recordfields))
    (al-clear! [i64]         (field p recordflattypes))
    (al-clear! [JslSlotListDecl] (field p slotlists))
    (al-clear! [(slice u8)]  (field p slotnames))
    (al-clear! [JslInternalSlotDecl] (field p internalslots))
    (al-clear! [JslMethodFamilyDecl] (field p methodfamilies))
    (al-clear! [JslInternalMethodDecl] (field p internalmethods))
    (al-clear! [(slice u8)]  (field p captures))
    (al-clear! [(slice u8)]  (field p binds))
    (al-clear! [i64]         (field p bindrecords))
    (al-clear! [i64]         (field p bindlists))
    (al-clear! [i64]         (field p bindslotlists))
    (al-clear! [i64]         (field p marks))
    (al-clear! [(slice u8)]  (field p paths))
    (al-clear! [i64]         (field p arities))
    (al-clear! [i64]         (field p looprecordbases))
    (al-clear! [i64]         (field p looprecords))
    (al-clear! [i64]         (field p looplists))
    (al-clear! [i64]         (field p loopslotlists))
    (set! (.err-src p) -1)
    (set! (.err-lo p) 0)
    (set! (.err-hi p) 0)
    (set! (.cur-src p) -1)
    (set! (.cur-lo p) 0)
    (set! (.cur-hi p) 0)
    (set! (.fidx-base p) 0)
    (set! (.err p) JSL-OK)
    (set! (.where p) "")
    0))

(defn jsl-set-fidx-base! [(base i64)] (-> i64)
  (set! (.fidx-base (jsl)) base)
  0)


;; Reuse an already read and checked library in a fresh graph. Declaration syntax, signatures and
;; effect summaries are immutable; only lowered Fun node ids belong to the previous graph. This is
;; deliberately separate from `jsl-reset!`, which remains the full reset used by parser/checker
;; tests and by callers loading a different library.
(defn jsl-reuse-checked! [] (-> i64)
  (let [p (jsl)
        (mut i) 0]
    (loop (if (>= (load i) (al-len [JslDecl] (.decls p)))
              (break)
              (do
                (jsl-decl-set-fun! (load i) NO-NODE)
                (set! i (+ (load i) 1))
                0)))
    (al-clear! [(slice u8)] (field p binds))
    (al-clear! [i64] (field p bindrecords))
    (al-clear! [i64] (field p bindlists))
    (al-clear! [i64] (field p bindslotlists))
    (al-clear! [i64] (field p marks))
    (al-clear! [i64] (field p arities))
    (al-clear! [i64] (field p looprecordbases))
    (al-clear! [i64] (field p looprecords))
    (al-clear! [i64] (field p looplists))
    (al-clear! [i64] (field p loopslotlists))
    (set! (.err-src p) -1)
    (set! (.err-lo p) 0)
    (set! (.err-hi p) 0)
    (set! (.cur-src p) -1)
    (set! (.cur-lo p) 0)
    (set! (.cur-hi p) 0)
    (set! (.fidx-base p) 0)
    (set! (.err p) JSL-OK)
    (set! (.where p) "")
    JSL-OK))

(defn jsl-err [] (-> i64) (.err (jsl)))
(defn jsl-where [] (-> (slice u8)) (.where (jsl)))
(defn jsl-ok? [] (-> bool) (= (jsl-err) JSL-OK))

;; Record a failure and hand its code back so a caller can propagate it in one expression. The
;; FIRST failure is kept: a later, derived complaint is noise, and the one that matters is the one
;; that noticed.
;; Stamp the form the walk is about to inspect. Cheap enough to do unconditionally: three stores,
;; and the alternative is a node parameter on every checking function.
(defn jsl-at! [(x (ptr rd/Sexp))] (-> i64)
  (let [p (jsl)]
    (set! (.cur-src p) (.source x))
    (set! (.cur-lo p) (.lo x))
    (set! (.cur-hi p) (.hi x))
    0))

(defn jsl-fail! [(code i64) (where (slice u8))] (-> i64)
  (let [p (jsl)]
    (if (= (.err p) JSL-OK)
        (do (set! (.err p) code)
            (set! (.where p) where)
            (set! (.err-src p) (.cur-src p))
            (set! (.err-lo p) (.cur-lo p))
            (set! (.err-hi p) (.cur-hi p))
            0)
        0))
  code)

(defn jsl-err-src [] (-> i64) (.err-src (jsl)))
(defn jsl-err-lo [] (-> i64) (.err-lo (jsl)))
(defn jsl-err-hi [] (-> i64) (.err-hi (jsl)))

(defn jsl-source-count [] (-> i64) (al-len [(slice u8)] (.paths (jsl))))
(defn jsl-source-path [(i i64)] (-> (slice u8))
  (if (and (>= i 0) (< i (jsl-source-count)))
      (al-get (.paths (jsl)) i)
      "<string>"))
(defn jsl-source-add! [(path (slice u8))] (-> i64)
  (al-push! [(slice u8)] (field (jsl) paths) path)
  (- (jsl-source-count) 1))

(defn jsl-decl-count [] (-> i64) (al-len [JslDecl] (.decls (jsl))))
(defn jsl-param-count [] (-> i64) (al-len [JslParam] (.params (jsl))))
(defn jsl-capture-count [] (-> i64) (al-len [(slice u8)] (.captures (jsl))))

;; `al-elem` returns a POINTER to the live element, so a field read is one expression and a field
;; write needs no read-modify-write. This used to be ten by-ref accessor functions plus an
;; `al-get`/`al-set!` round trip, because `al-get` returns an rvalue and `field` needs a place;
;; `al-elem` became public in coil.arraylist on 2026-08-07 and the boilerplate went with it.
;;
;; THE CONTRACT: A `-p` POINTER MUST NOT OUTLIVE THE EXPRESSION THAT DEREFERENCES IT. It aims into
;; the list's live storage, and the two ways it stops being right are different enough that
;; reasoning about one misses the other:
;;
;;   - GROWTH (`al-push!` past capacity, `al-reserve!`) moves the block, and the pointer dangles.
;;     This is the one people think of, and it is the one that crashes.
;;   - SLOT REUSE (`al-pop!` then any later `al-push!`) leaves the pointer perfectly valid AS
;;     MEMORY while the element it names stops being the one you asked for. `al-pop!` only
;;     decrements the length, so a read straight after a pop still returns the CORRECT value — and
;;     keeps returning it until an unrelated push happens to reuse that slot, at which point it
;;     silently returns a different record. A latent, order-dependent wrong answer that passes its
;;     tests, which is worse than a crash.
;;
;; Every accessor below dereferences immediately and hands back a value, so no caller can hold one.
;; `jl-drop!` in jsl_lower.coil is the one place the rule had to be applied by hand.
(defn jsl-decl-p [(i i64)] (-> (ptr JslDecl)) (al-elem [JslDecl] (field (jsl) decls) i))

(defn jsl-decl-name [(i i64)] (-> (slice u8)) (.name (jsl-decl-p i)))
(defn jsl-decl-kind [(i i64)] (-> i64) (.kind (jsl-decl-p i)))
(defn jsl-decl-label [(i i64)] (-> (slice u8)) (.label (jsl-decl-p i)))
(defn jsl-macro? [(i i64)] (-> bool) (= (jsl-decl-kind i) JSL-KIND-MACRO))
(defn jsl-callable? [(i i64)] (-> bool) (= (jsl-decl-kind i) JSL-KIND-CALLABLE))
(defn jsl-labelled? [(i i64)] (-> bool) (> (slice-len (jsl-decl-label i)) 0))
;; THE CLOSED-WORLD FUNCTION INDEX, WHICH IS NOT THE DECLARATION INDEX.
;;
;; JavaScript-visible function identities below 63 can be bits in `Val.fidxs`; exact direct JSL
;; functions may live above that finite summary. Macros still must not consume identities because
;; they have no `OPTAG-FUN`, and both eager and on-demand lowering must assign each builtin the same id.
;;
;; This used to be the declaration index, which meant every `macro` — 55 of the 88 entries, and none
;; of which has an `OPTAG-FUN` at all — consumed a bit. The library crossed 63 declarations and
;; `StringIndexOfFrom` landed at index 66. Its bit fell outside the mask, so `be-call-return-kind`
;; could not identify the callee of a call to it, `be-js-tag-for-value` answered -1 for the boxed
;; result, and `String.prototype.indexOf` failed selection with `MSEL-UNSUPPORTED` — a definition
;; that neither used nor called the array entries that had just been added. Counting only the
;; builtins took the same declaration from 66 to 29 and made the index independent of how many
;; macros the library has. The embedding frontend now also supplies a disjoint namespace base.
;;
;; It is still DERIVED FROM DECLARATION ORDER rather than allocated on demand, because two paths
;; open a Fun — `jl-open-all!` for the whole library and `jl-require-decl!` on demand — and they
;; must agree on the index for the same definition whichever ran.
(defn jsl-decl-fidx [(i i64)] (-> i64)
  (let [(mut k) 0 (mut n) (.fidx-base (jsl))]
    (loop (if (>= (load k) i) (break)
            (do (if (jsl-macro? (load k)) 0 (set! n (+ (load n) 1)))
                (set! k (+ (load k) 1))
                0)))
    (load n)))

(defn jsl-decl-signature [(i i64)] (-> (ptr JslSignature))
  (field (jsl-decl-p i) signature))
(defn jsl-decl-nparams [(i i64)] (-> i64) (.nparams (jsl-decl-signature i)))
(defn jsl-decl-lowered-nparams [(i i64)] (-> i64)
  (.lowered-nparams (jsl-decl-signature i)))
(defn jsl-decl-ncaptures [(i i64)] (-> i64) (.ncaptures (jsl-decl-p i)))
(defn jsl-decl-ret [(i i64)] (-> i64) (.ret (jsl-decl-signature i)))
(defn jsl-decl-transitioning? [(i i64)] (-> bool)
  (.transitioning (field (jsl-decl-p i) signature)))
(defn jsl-decl-cold? [(i i64)] (-> bool) (.cold (field (jsl-decl-p i) signature)))
(defn jsl-decl-spec [(i i64)] (-> (slice u8)) (.spec (jsl-decl-p i)))
(defn jsl-decl-spec-name [(i i64)] (-> (slice u8)) (.specname (jsl-decl-p i)))
(defn jsl-decl-spec-status [(i i64)] (-> i64) (.specstatus (jsl-decl-p i)))
(defn jsl-decl-specializes [(i i64)] (-> (slice u8)) (.specializes (jsl-decl-p i)))
(defn jsl-decl-deviation [(i i64)] (-> (slice u8)) (.deviation (jsl-decl-p i)))
(defn jsl-decl-body [(i i64)] (-> (ptr rd/Sexp)) (.body (jsl-decl-p i)))
(defn jsl-decl-fun [(i i64)] (-> i64) (.fun (jsl-decl-p i)))
(defn jsl-decl-uses-memory? [(i i64)] (-> bool) (.usesmem (field (jsl-decl-p i) signature)))
(defn jsl-decl-heap-params [(i i64)] (-> i64) (.heapparams (jsl-decl-p i)))
(defn jsl-decl-set-heap-params! [(i i64) (v i64)] (-> i64)
  (set! (.heapparams (jsl-decl-p i)) v) 0)
(defn jsl-decl-set-uses-memory! [(i i64) (v bool)] (-> i64)
  (set! (.usesmem (field (jsl-decl-p i) signature)) v) 0)

;; Does this definition invoke a JAVASCRIPT CALLBACK? Distinct from `usesmem`, which asks about the
;; heap this library owns. A callback runs USER code, which can write anything the caller's scope
;; reaches -- a captured cell, a closure environment field -- none of which is JS-PROPERTY-ALIAS,
;; and none of which the JSL memory convention carries. The frontend asks so it can hand such a
;; definition the same full memory merge an ordinary JavaScript call gets.
(defn jsl-decl-calls-back? [(i i64)] (-> bool) (.callsback (field (jsl-decl-p i) signature)))
(defn jsl-decl-set-calls-back! [(i i64) (v bool)] (-> i64)
  (set! (.callsback (field (jsl-decl-p i) signature)) v) 0)
(defn jsl-decl-can-throw? [(i i64)] (-> bool) (.canthrow (field (jsl-decl-p i) signature)))
(defn jsl-decl-set-can-throw! [(i i64) (v bool)] (-> i64)
  (set! (.canthrow (field (jsl-decl-p i) signature)) v) 0)

;; A store straight into the live element.
(defn jsl-decl-set-fun! [(i i64) (fun i64)] (-> i64)
  (set! (.fun (jsl-decl-p i)) fun)
  0)

(defn jsl-param-p [(d i64) (k i64)] (-> (ptr JslParam))
  (al-elem [JslParam] (field (jsl) params)
           (+ (.params-off (jsl-decl-signature d)) k)))
(defn jsl-param-name [(d i64) (k i64)] (-> (slice u8)) (.name (jsl-param-p d k)))
(defn jsl-param-ty [(d i64) (k i64)] (-> i64) (.ty (jsl-param-p d k)))
(defn jsl-param-record [(d i64) (k i64)] (-> i64) (.record (jsl-param-p d k)))
(defn jsl-param-slot-list? [(d i64) (k i64)] (-> bool) (.slotlist (jsl-param-p d k)))
(defn jsl-param-lowered-off [(d i64) (k i64)] (-> i64) (.lowered-off (jsl-param-p d k)))
(defn jsl-param-lowered-width [(d i64) (k i64)] (-> i64) (.lowered-width (jsl-param-p d k)))
(defn jsl-param-lowered-type [(d i64) (k i64) (slot i64)] (-> i64)
  (let [parameter (jsl-param-p d k)
        signature (jsl-decl-signature d)]
    (if (or (< slot 0) (>= slot (jsl-param-lowered-width d k)))
        (do (panic-corrupt "jsl: lowered parameter slot is outside its canonical range") TY-NO-ID)
        (al-get [i64] (.signaturetypes (jsl))
                (+ (.lowered-params-off signature) (+ (.lowered-off parameter) slot))))))
(defn jsl-param-runtime-width [(d i64) (k i64)] (-> i64) (jsl-param-lowered-width d k))
(defn jsl-decl-runtime-nparams [(d i64)] (-> i64)
  (jsl-decl-lowered-nparams d))
(defn jsl-param-rest? [(d i64) (k i64)] (-> bool) (.rest (jsl-param-p d k)))
(defn jsl-decl-ret-record [(d i64)] (-> i64) (.ret-record (jsl-decl-signature d)))
(defn jsl-decl-lowered-nresults [(d i64)] (-> i64)
  (.lowered-nresults (jsl-decl-signature d)))
(defn jsl-decl-lowered-param-type [(d i64) (slot i64)] (-> i64)
  (let [signature (jsl-decl-signature d)]
    (if (or (< slot 0) (>= slot (.lowered-nparams signature)))
        (do (panic-corrupt "jsl: lowered parameter slot is outside its canonical vector") TY-NO-ID)
        (al-get [i64] (.signaturetypes (jsl)) (+ (.lowered-params-off signature) slot)))))
(defn jsl-decl-lowered-result-type [(d i64) (slot i64)] (-> i64)
  (let [signature (jsl-decl-signature d)]
    (if (or (< slot 0) (>= slot (.lowered-nresults signature)))
        (do (panic-corrupt "jsl: lowered result slot is outside its canonical vector") TY-NO-ID)
        (al-get [i64] (.signaturetypes (jsl)) (+ (.lowered-results-off signature) slot)))))

(defn jsl-record-count [] (-> i64) (al-len [JslRecordDecl] (.records (jsl))))
(defn jsl-record-p [(i i64)] (-> (ptr JslRecordDecl))
  (al-elem [JslRecordDecl] (field (jsl) records) i))
(defn jsl-record-name [(i i64)] (-> (slice u8)) (.name (jsl-record-p i)))
(defn jsl-record-nfields [(i i64)] (-> i64) (.nfields (jsl-record-p i)))
(defn jsl-record-field-p [(r i64) (i i64)] (-> (ptr JslRecordField))
  (al-elem [JslRecordField] (field (jsl) recordfields)
           (+ (.fields-off (jsl-record-p r)) i)))
(defn jsl-record-field-name [(r i64) (i i64)] (-> (slice u8))
  (.name (jsl-record-field-p r i)))
(defn jsl-record-field-ty [(r i64) (i i64)] (-> i64) (.ty (jsl-record-field-p r i)))
(defn jsl-record-field-record [(r i64) (i i64)] (-> i64)
  (.record (jsl-record-field-p r i)))
(defn jsl-record-field-flat-off [(r i64) (i i64)] (-> i64)
  (.flat-off (jsl-record-field-p r i)))
(defn jsl-record-field-flat-width [(r i64) (i i64)] (-> i64)
  (.flat-width (jsl-record-field-p r i)))
(defn jsl-record-flat-width [(r i64)] (-> i64)
  (.flat-width (jsl-record-p r)))
(defn jsl-record-flat-field-ty [(r i64) (flat-index i64)] (-> i64)
  (if (or (< flat-index 0) (>= flat-index (jsl-record-flat-width r)))
      TY-NO-ID
      (al-get [i64] (.recordflattypes (jsl))
              (+ (.flat-off (jsl-record-p r)) flat-index))))

(defn jsl-slot-list-count [] (-> i64)
  (al-len [JslSlotListDecl] (.slotlists (jsl))))
(defn jsl-slot-list-p [(i i64)] (-> (ptr JslSlotListDecl))
  (al-elem [JslSlotListDecl] (field (jsl) slotlists) i))
(defn jsl-slot-list-name [(i i64)] (-> (slice u8)) (.name (jsl-slot-list-p i)))
(defn jsl-slot-list-size [(i i64)] (-> i64) (.nslots (jsl-slot-list-p i)))
(defn jsl-slot-list-slot [(i i64) (k i64)] (-> (slice u8))
  (al-get (.slotnames (jsl)) (+ (.slots-off (jsl-slot-list-p i)) k)))
(defn jsl-slot-list-find [(name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-slot-list-count)) (>= (load found) 0)) (break)
            (do (if (= name (jsl-slot-list-name (load i))) (store! found (load i)) 0)
                (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-internal-slot-count [] (-> i64)
  (al-len [JslInternalSlotDecl] (.internalslots (jsl))))
(defn jsl-internal-slot-p [(i i64)] (-> (ptr JslInternalSlotDecl))
  (al-elem [JslInternalSlotDecl] (field (jsl) internalslots) i))
(defn jsl-internal-slot-name [(i i64)] (-> (slice u8))
  (.name (jsl-internal-slot-p i)))
(defn jsl-internal-slot-storage [(i i64)] (-> i64)
  (.storage (jsl-internal-slot-p i)))
(defn jsl-internal-slot-find [(name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-internal-slot-count)) (>= (load found) 0)) (break)
            (do (if (= name (jsl-internal-slot-name (load i))) (store! found (load i)) 0)
                (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-method-family-count [] (-> i64)
  (al-len [JslMethodFamilyDecl] (.methodfamilies (jsl))))
(defn jsl-method-family-p [(i i64)] (-> (ptr JslMethodFamilyDecl))
  (al-elem [JslMethodFamilyDecl] (field (jsl) methodfamilies) i))
(defn jsl-method-family-name [(i i64)] (-> (slice u8))
  (.name (jsl-method-family-p i)))
(defn jsl-method-family-find [(name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-method-family-count)) (>= (load found) 0)) (break)
            (do (if (= name (jsl-method-family-name (load i))) (store! found (load i)) 0)
                (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-internal-method-count [] (-> i64)
  (al-len [JslInternalMethodDecl] (.internalmethods (jsl))))
(defn jsl-internal-method-p [(i i64)] (-> (ptr JslInternalMethodDecl))
  (al-elem [JslInternalMethodDecl] (field (jsl) internalmethods) i))
(defn jsl-internal-method-name [(i i64)] (-> (slice u8))
  (.name (jsl-internal-method-p i)))
(defn jsl-internal-method-find [(name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-internal-method-count)) (>= (load found) 0)) (break)
            (do (if (= name (jsl-internal-method-name (load i))) (store! found (load i)) 0)
                (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-signature-build! [(params-off i64) (nparams i64) (expected-lowered-nparams i64)
                            (ret i64) (ret-record i64)] (-> JslSignature)
  (let [(mut signature) (zeroed JslSignature)
        param-types-off (al-len [i64] (.signaturetypes (jsl)))
        (mut parameter) 0]
    (loop (if (>= (load parameter) nparams) (break)
              (let [p (al-elem [JslParam] (field (jsl) params)
                               (+ params-off (load parameter)))
                    (mut slot) 0]
                (loop (if (>= (load slot) (.lowered-width p)) (break)
                          (do (al-push! [i64] (field (jsl) signaturetypes)
                                        (if (>= (.record p) 0)
                                            (jsl-record-flat-field-ty (.record p) (load slot))
                                            (.ty p)))
                              (set! slot (+ (load slot) 1)))))
                (set! parameter (+ (load parameter) 1)))))
    (let [lowered-nparams (- (al-len [i64] (.signaturetypes (jsl))) param-types-off)
          results-off (al-len [i64] (.signaturetypes (jsl)))
          nresults (if (>= ret-record 0) (jsl-record-flat-width ret-record) 1)
          (mut result) 0]
      (if (!= lowered-nparams expected-lowered-nparams)
          (panic-corrupt "jsl: checked parameter ranges disagree with canonical signature") 0)
      (loop (if (>= (load result) nresults) (break)
                (do (al-push! [i64] (field (jsl) signaturetypes)
                              (if (>= ret-record 0)
                                  (jsl-record-flat-field-ty ret-record (load result))
                                  (if (= ret TY-NO-ID) (t-dyn) ret)))
                    (set! result (+ (load result) 1)))))
      (set! (.params-off signature) params-off)
      (set! (.nparams signature) nparams)
      (set! (.ret signature) ret)
      (set! (.ret-record signature) ret-record)
      (set! (.lowered-params-off signature) param-types-off)
      (set! (.lowered-nparams signature) lowered-nparams)
      (set! (.lowered-results-off signature) results-off)
      (set! (.lowered-nresults signature) nresults)
      (load signature))))
(defn jsl-signature-valid? [(d i64)] (-> bool)
  (let [signature (jsl-decl-signature d)
        type-count (al-len [i64] (.signaturetypes (jsl)))
        params-end (+ (.lowered-params-off signature) (.lowered-nparams signature))
        results-end (+ (.lowered-results-off signature) (.lowered-nresults signature))
        expected-results (if (>= (.ret-record signature) 0)
                             (jsl-record-flat-width (.ret-record signature)) 1)
        (mut valid)
          (and (>= (.params-off signature) 0)
               (and (>= (.nparams signature) 0)
                    (and (>= (.lowered-params-off signature) 0)
                         (and (<= params-end type-count)
                              (and (= (.lowered-results-off signature) params-end)
                                   (and (= (.lowered-nresults signature) expected-results)
                                        (<= results-end type-count)))))))
        (mut parameter) 0
        (mut flat) 0]
    (loop (if (or (= (load valid) false) (>= (load parameter) (.nparams signature))) (break)
              (let [p (al-elem [JslParam] (field (jsl) params)
                               (+ (.params-off signature) (load parameter)))
                    (mut slot) 0]
                (if (!= (.lowered-off p) (load flat)) (set! valid false) 0)
                (loop (if (or (= (load valid) false) (>= (load slot) (.lowered-width p)))
                          (break)
                          (let [expected (if (>= (.record p) 0)
                                             (jsl-record-flat-field-ty (.record p) (load slot))
                                             (.ty p))]
                            (if (!= (al-get [i64] (.signaturetypes (jsl))
                                           (+ (.lowered-params-off signature) (load flat)))
                                    expected)
                                (set! valid false) 0)
                            (set! flat (+ (load flat) 1))
                            (set! slot (+ (load slot) 1)))))
                (set! parameter (+ (load parameter) 1)))))
    (if (!= (load flat) (.lowered-nparams signature)) (set! valid false) 0)
    (let [(mut result) 0]
      (loop (if (or (= (load valid) false) (>= (load result) expected-results)) (break)
                (let [expected (if (>= (.ret-record signature) 0)
                                   (jsl-record-flat-field-ty (.ret-record signature) (load result))
                                   (if (= (.ret signature) TY-NO-ID) (t-dyn) (.ret signature)))]
                  (if (!= (al-get [i64] (.signaturetypes (jsl))
                                 (+ (.lowered-results-off signature) (load result)))
                          expected)
                      (set! valid false) 0)
                  (set! result (+ (load result) 1))))))
    (load valid)))
(defn jsl-record-find [(name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-record-count)) (>= (load found) 0)) (break)
              (do (if (= name (jsl-record-name (load i))) (set! found (load i)) 0)
                  (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-record-field-find [(r i64) (name (slice u8))] (-> i64)
  (let [(mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) (jsl-record-nfields r)) (>= (load found) 0)) (break)
              (do (if (= name (jsl-record-field-name r (load i))) (set! found (load i)) 0)
                  (set! i (+ (load i) 1)))))
    (load found)))
(defn jsl-decl-rest? [(d i64)] (-> bool)
  (and (> (jsl-decl-nparams d) 0)
       (jsl-param-rest? d (- (jsl-decl-nparams d) 1))))
(defn jsl-capture-name [(d i64) (k i64)] (-> (slice u8))
  (al-get (.captures (jsl)) (+ (.captures-off (jsl-decl-p d)) k)))
(defn jsl-capture-index [(d i64) (name (slice u8))] (-> i64)
  (let [(mut k) 0 (mut found) -1]
    (loop (if (or (>= (load k) (jsl-decl-ncaptures d)) (>= (load found) 0)) (break)
            (do (if (= name (jsl-capture-name d (load k))) (set! found (load k)) 0)
                (set! k (+ (load k) 1)))))
    (load found)))

;; The parameter index a name denotes in this declaration, or -1. Linear because a signature is
;; capped at JSL-MAX-PARAMS and a hash here would cost more than it saves.
(defn jsl-param-index [(d i64) (name (slice u8))] (-> i64)
  (let [n (jsl-decl-nparams d) (mut k) 0 (mut found) -1]
    (loop (if (or (>= (load k) n) (>= (load found) 0))
              (break)
              (do
                (if (= name (jsl-param-name d (load k))) (set! found (load k)) 0)
                (set! k (+ (load k) 1)))))
    (load found)))

(defn jsl-find [(name (slice u8))] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0))
              (break)
              (do
                (if (= name (jsl-decl-name (load i))) (set! found (load i)) 0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; Does the definition under this NAME touch the heap? The frontend asks before it inlines, because
;; the dynamic alias has to be declared BEFORE the body's loads and stores exist rather than after:
;; every hand-written array path in `frontend_native_graph.coil` records it first, and a body built
;; ahead of the declaration leaves its memory nodes outside the alias subsequently declared dynamic.
;; An unknown name answers false; `jsl-inline!` is what refuses it, with a name.
(defn jsl-name-uses-memory? [(name (slice u8))] (-> bool)
  (let [d (jsl-find name)]
    (and (>= d 0) (jsl-decl-uses-memory? d))))

; ============================================================================
; Symbol classification
; ============================================================================
(const JSL-CH-COLON   i64 58)
(const JSL-CH-QUOTE   i64 34)
(const JSL-CH-PERCENT i64 37)
(const JSL-CH-HASH    i64 35)
(const JSL-CH-NEWLINE i64 10)
(const JSL-CH-SPACE   i64 32)
(const JSL-CH-SEMI    i64 59)
(const JSL-CH-TAB     i64 9)
(const JSL-CH-LPAREN  i64 40)
(const JSL-CH-RPAREN  i64 41)

(defn jsl-byte [(s (slice u8)) (i i64)] (-> i64) (cast i64 (slice-get s i)))

(defn jsl-starts-with? [(s (slice u8)) (c i64)] (-> bool)
  (and (> (slice-len s) 0) (= (jsl-byte s 0) c)))

(defn jsl-keyword? [(x (ptr rd/Sexp))] (-> bool) (rd/sexp-kw? x))

(defn jsl-prim-name? [(s (slice u8))] (-> bool) (jsl-starts-with? s JSL-CH-PERCENT))

;; A type annotation, or TY-NO-ID. A bare symbol carries the spellings with no bracket or space (`dyn`, `int=0`);
;; a string carries the rest of `text.coil`'s grammar verbatim (`"int=[0..9]"`). Both go to the one
;; type parser, so JSL cannot drift from the printed form.
(defn jsl-type-of [(x (ptr rd/Sexp))] (-> i64)
  (if (rd/sexp-str? x) (ty-try-parse (rd/sexp-str x))
    (if (rd/sexp-sym? x) (ty-try-parse (rd/sexp-sym x))
      TY-NO-ID)))

(defn jsl-record-type-of [(x (ptr rd/Sexp))] (-> i64)
  (if (and (rd/sexp-list? x)
           (and (= (rd/sexp-count x) 2)
                (and (rd/sexp-sym? (rd/sexp-nth x 0))
                     (= (rd/sexp-sym (rd/sexp-nth x 0)) "record"))))
      (let [name (rd/sexp-nth x 1)]
        (if (rd/sexp-sym? name) (jsl-record-find (rd/sexp-sym name)) -1))
      -1))

(defn jsl-slot-list-type? [(x (ptr rd/Sexp))] (-> bool)
  (and (rd/sexp-list? x)
       (and (= (rd/sexp-count x) 1)
            (and (rd/sexp-sym? (rd/sexp-nth x 0))
                 (= (rd/sexp-sym (rd/sexp-nth x 0)) "slot-list")))))

;; The lattice constant a bare literal symbol denotes, or TY-NO-ID when it is not one. These four
;; are the only symbols that are values rather than references, which is what makes an unbound
;; name detectable at all.
(defn jsl-literal-ty [(s (slice u8))] (-> i64)
  (if (= s "true")      (t-bool-con true)
    (if (= s "false")     (t-bool-con false)
      (if (= s "undefined") (t-undef)
        (if (= s "null")      (t-null)
          TY-NO-ID)))))

; ============================================================================
; The checker's binding stack
; ============================================================================
(defn jsl-scope-depth [] (-> i64) (al-len [(slice u8)] (.binds (jsl))))

(defn jsl-scope-push-value! [(name (slice u8)) (record i64) (list i64) (slotlist i64)] (-> i64)
  (al-push! [i64] (field (jsl) bindslotlists) slotlist)
  (al-push! [i64] (field (jsl) bindlists) list)
  (al-push! [i64] (field (jsl) bindrecords) record)
  (al-push! [(slice u8)] (field (jsl) binds) name))
(defn jsl-scope-push-record! [(name (slice u8)) (record i64)] (-> i64)
  (jsl-scope-push-value! name record -1 -1))
(defn jsl-scope-push! [(name (slice u8))] (-> i64) (jsl-scope-push-record! name -1))

;; Pop back to a remembered depth. `let` is sequential, so a binding is visible to the bindings
;; after it and to the body, and to nothing outside.
(defn jsl-scope-drop! [(depth i64)] (-> i64)
  (loop (if (<= (jsl-scope-depth) depth) (break)
          (do (al-pop! [(slice u8)] (field (jsl) binds)) 0)))
  (loop (if (<= (al-len [i64] (.bindrecords (jsl))) depth) (break)
          (do (al-pop! [i64] (field (jsl) bindrecords)) 0)))
  (loop (if (<= (al-len [i64] (.bindlists (jsl))) depth) (break)
          (do (al-pop! [i64] (field (jsl) bindlists)) 0)))
  (loop (if (<= (al-len [i64] (.bindslotlists (jsl))) depth) (break)
          (do (al-pop! [i64] (field (jsl) bindslotlists)) 0)))
  0)

(defn jsl-scope-record [(name (slice u8))] (-> i64)
  (let [(mut i) (jsl-scope-depth) (mut found) -2]
    (loop (if (or (<= (load i) 0) (!= (load found) -2)) (break)
              (do (set! i (- (load i) 1))
                  (if (= name (al-get (.binds (jsl)) (load i)))
                      (set! found (al-get (.bindrecords (jsl)) (load i))) 0))))
    (if (= (load found) -2) -1 (load found))))

(defn jsl-scope-list [(name (slice u8))] (-> i64)
  (let [(mut i) (jsl-scope-depth) (mut found) -2]
    (loop (if (or (<= (load i) 0) (!= (load found) -2)) (break)
              (do (set! i (- (load i) 1))
                  (if (= name (al-get (.binds (jsl)) (load i)))
                      (set! found (al-get (.bindlists (jsl)) (load i))) 0))))
    (if (= (load found) -2) -1 (load found))))

(defn jsl-scope-slot-list [(name (slice u8))] (-> i64)
  ;; -2 is a real value here: it means "a slot-list macro parameter whose concrete identity is
  ;; supplied by expansion". Use -3 solely as the lookup sentinel so let/loop bindings preserve it.
  (let [(mut i) (jsl-scope-depth) (mut found) -3]
    (loop (if (or (<= (load i) 0) (!= (load found) -3)) (break)
              (do (set! i (- (load i) 1))
                  (if (= name (al-get (.binds (jsl)) (load i)))
                      (set! found (al-get (.bindslotlists (jsl)) (load i))) 0))))
    (if (= (load found) -3) -1 (load found))))

(defn jsl-scope-has? [(name (slice u8))] (-> bool)
  (let [n (jsl-scope-depth) (mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) n) (load found))
              (break)
              (do
                (if (= name (al-get (.binds (jsl)) (load i)))
                    (set! found true) 0)
                (set! i (+ (load i) 1)))))
    (load found)))

; ============================================================================
; The body walk
; ============================================================================
;; Resolve every symbol and check every head, so that `jsl_lower` may PANIC on anything it does not
;; recognise instead of quietly emitting a plausible node. That division is the whole point of
;; having a checker: the lowering is allowed to assume the shape it walks is legal, and the only
;; place that assumption is established is here. `jsl-check-expr` is defined below and used above;
;; forward references resolve within a file, so the walk reads top-down in dependency order.
(defn jsl-check-args [(x (ptr rd/Sexp)) (d i64) (from i64)] (-> i64)
  (let [n (rd/sexp-count x) (mut i) from (mut err) JSL-OK]
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
              (break)
              (do
                (set! err (jsl-check-expr (rd/sexp-nth x (load i)) d))
                (set! i (+ (load i) 1)))))
    (load err)))

(defn jsl-check-scalar-args [(x (ptr rd/Sexp)) (d i64) (from i64)
                             (where (slice u8))] (-> i64)
  (let [err (jsl-check-args x d from)]
    (if (!= err JSL-OK) err
      (let [(mut i) from (mut result) JSL-OK]
        (loop (if (or (>= (load i) (rd/sexp-count x)) (!= (load result) JSL-OK)) (break)
                (do
                  (if (>= (jsl-expr-record (rd/sexp-nth x (load i)) d) 0)
                      (set! result (jsl-fail! JSL-ERR-RECORD-ESCAPE where)) 0)
                  (if (>= (jsl-expr-record-list (rd/sexp-nth x (load i)) d) 0)
                      (set! result (jsl-fail! JSL-ERR-RECORD-ESCAPE where)) 0)
                  (if (!= (jsl-expr-slot-list (rd/sexp-nth x (load i)) d) -1)
                      (set! result (jsl-fail! JSL-ERR-SLOT-LIST-ESCAPE where)) 0)
                  (set! i (+ (load i) 1)))))
        (load result)))))

(defn jsl-check-let [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (< (rd/sexp-count x) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d))) 0)
    (let [binds (rd/sexp-nth x 1)]
      (if (not (rd/sexp-vec? binds))
          (return-from :done (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d))) 0)
      (let [depth (jsl-scope-depth)
            nb (rd/sexp-count binds)
            (mut i) 0
            (mut err) JSL-OK]
        (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (let [b (rd/sexp-nth binds (load i))]
                      (if (or (not (rd/sexp-list? b)) (!= (rd/sexp-count b) 2))
                          (store! err (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d)))
                          (if (not (rd/sexp-sym? (rd/sexp-nth b 0)))
                              (store! err (jsl-fail! JSL-ERR-BAD-LET (jsl-decl-name d)))
                              (do
                                (store! err (jsl-check-expr (rd/sexp-nth b 1) d))
                                (if (= (load err) JSL-OK)
                                    (jsl-scope-push-value!
                                      (rd/sexp-sym (rd/sexp-nth b 0))
                                      (jsl-expr-record (rd/sexp-nth b 1) d)
                                      (jsl-expr-record-list (rd/sexp-nth b 1) d)
                                      (jsl-expr-slot-list (rd/sexp-nth b 1) d))
                                    0)
                                0))))
                    (store! i (+ (load i) 1)))))
        (if (= (load err) JSL-OK)
            (store! err (jsl-check-args x d 2)) 0)
        (jsl-scope-drop! depth)
        (load err)))))

;; Where `:otherwise` sits in a call form, or -1. It is always the last two items when present, so
;; the positional argument count is everything before it.
(defn jsl-otherwise-at [(x (ptr rd/Sexp))] (-> i64)
  (let [n (rd/sexp-count x) (mut i) 1 (mut found) -1]
    (loop (if (or (>= (load i) n) (>= (load found) 0)) (break)
            (do
              (let [it (rd/sexp-nth x (load i))]
                (if (and (rd/sexp-kw? it) (= (rd/sexp-kw it) "otherwise"))
                    (set! found (load i)) 0))
              (set! i (+ (load i) 1))
              0)))
    (load found)))

;; `(goto L)`. Legal only inside a macro that declares `L`, which is what makes a label a LEXICAL
;; construct rather than a dynamic one: the jump target is fixed by the definition that contains
;; the jump, not by whoever happens to be expanding it.
(defn jsl-check-goto [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (!= (rd/sexp-count x) 2)
        (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (jsl-decl-name d))) 0)
    (let [t (rd/sexp-nth x 1)]
      (if (not (rd/sexp-sym? t))
          (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (jsl-decl-name d))) 0)
      (if (not (= (rd/sexp-sym t) (jsl-decl-label d)))
          (return-from :done (jsl-fail! JSL-ERR-BAD-GOTO (rd/sexp-sym t))) 0))
    JSL-OK))

(defn jsl-check-call [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (let [head (rd/sexp-nth x 0)]
      (if (not (rd/sexp-sym? head))
          (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM (jsl-decl-name d))) 0)
      (let [name (rd/sexp-sym head)
            owa (jsl-otherwise-at x)
            n (rd/sexp-count x)
            nargs (if (>= owa 0) (- owa 1) (- n 1))]
        ;; Macro expansion stores positional arguments in fixed-size compiler scratch arrays.
        ;; Rest parameters make the source arity variadic, but they do not relax that compiler
        ;; representation limit. Refuse before either checking or lowering can index past it.
        (if (> nargs JSL-MAX-PARAMS)
            (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS name)) 0)
        ; `:otherwise` must be last-but-one and carry exactly one handler expression.
        (if (and (>= owa 0) (!= owa (- n 2)))
            (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)
        (if (jsl-prim-name? name)
            (do
              (if (>= owa 0)
                  (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)
              (let [id (jsp-find name)]
                (if (= id JSP-NONE) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-PRIM name)) 0)
                (if (!= nargs (jsp-arity id)) (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)))
            (let [callee (jsl-find name)]
              (if (< callee 0) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-CALL name)) 0)
              ; The heap argument is supplied by the lowering, never written in the source, so the
              ; DECLARED parameter count is what a call site is checked against.
              (let [declared (jsl-decl-nparams callee)
                    fixed (- declared (if (jsl-decl-rest? callee) 1 0))]
                (if (if (jsl-decl-rest? callee) (< nargs fixed) (!= nargs declared))
                    (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0))
              ; A LABEL MUST HAVE SOMEWHERE TO GO, and only a label may be given one. Both
              ; directions are refused: a labelled macro with no handler would lower a `goto` into
              ; a control edge with no destination, and a handler on an unlabelled callee is a
              ; belief about the callee that the callee does not share.
              (if (and (jsl-labelled? callee) (< owa 0))
                  (return-from :done (jsl-fail! JSL-ERR-MISSING-OTHERWISE name)) 0)
              (if (and (not (jsl-labelled? callee)) (>= owa 0))
                  (return-from :done (jsl-fail! JSL-ERR-UNEXPECTED-OTHERWISE name)) 0)))
        ; Positional arguments, then the handler expression when there is one. The handler is
        ; checked in the CALLER's scope, because that is where it is written and where it runs.
        (let [(mut err) JSL-OK (mut k) 1]
          (loop
            (if (or (> (load k) nargs) (!= (load err) JSL-OK)) (break)
              (let [arg (rd/sexp-nth x (load k))]
                (store! err (jsl-check-expr arg d))
                (if (= (load err) JSL-OK)
                    (let [actual (jsl-expr-record arg d)
                          callee (if (jsl-prim-name? name) -1 (jsl-find name))
                          expected (if (and (>= callee 0)
                                            (< (- (load k) 1) (jsl-decl-nparams callee)))
                                       (jsl-param-record callee (- (load k) 1)) -1)]
                      (if (!= actual expected)
                          (store! err (jsl-fail! JSL-ERR-RECORD-ESCAPE name)) 0)) 0)
                (if (and (= (load err) JSL-OK) (>= (jsl-expr-record-list arg d) 0))
                    (store! err (jsl-fail! JSL-ERR-RECORD-ESCAPE name)) 0)
                (if (= (load err) JSL-OK)
                    (let [actual-slots (jsl-expr-slot-list arg d)
                          callee (if (jsl-prim-name? name) -1 (jsl-find name))
                          expected-slots (and (>= callee 0)
                                              (< (- (load k) 1) (jsl-decl-nparams callee))
                                              (jsl-param-slot-list? callee (- (load k) 1)))]
                      (if (!= expected-slots (!= actual-slots -1))
                          (store! err (jsl-fail! JSL-ERR-SLOT-LIST-ESCAPE name)) 0)) 0)
                (store! k (+ (load k) 1)))))
          (if (and (= (load err) JSL-OK) (>= owa 0))
              (store! err (jsl-check-expr (rd/sexp-nth x (+ owa 1)) d)) 0)
          (load err))))))

;; `(call fn arg ...)` invokes a JavaScript function value. It is a control/effect form rather
;; than a `%` primitive: calls have variable arity, produce a CallEnd control, and invalidate the
;; heap. The receiver ABI is deliberately separate; this form implements ordinary callback calls
;; with an undefined/unused receiver, while the universal JavaScript receiver convention is
;; standardised independently.
(defn jsl-check-js-call [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (< (rd/sexp-count x) 2)
      (jsl-fail! JSL-ERR-ARITY "call")
      (if (> (- (rd/sexp-count x) 2) JSL-MAX-PARAMS)
          (jsl-fail! JSL-ERR-TOO-MANY-PARAMS "call")
          (jsl-check-scalar-args x d 1 "call"))))

;; `(call-with-receiver fn receiver arg ...)` is the ordinary ECMAScript [[Call]] shape. Keeping
;; it distinct from `call` makes the receiver ABI explicit in the source and lets the verifier
;; reject a receiver accidentally shifted into the positional arguments.
(defn jsl-check-js-call-with-receiver [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (< (rd/sexp-count x) 3)
      (jsl-fail! JSL-ERR-ARITY "call-with-receiver")
      (if (> (- (rd/sexp-count x) 3) JSL-MAX-PARAMS)
          (jsl-fail! JSL-ERR-TOO-MANY-PARAMS "call-with-receiver")
          (jsl-check-scalar-args x d 1 "call-with-receiver"))))

;; Spread a compile-away rest binding into an ordinary [[Call]]. The binding must be the final
;; `(rest T)` parameter of this macro; accepting an arbitrary expression here would silently turn
;; a JavaScript Array into a specification List, which are observably different abstractions.
(defn jsl-check-js-call-with-rest [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (!= (rd/sexp-count x) 4)
      (jsl-fail! JSL-ERR-ARITY "call-dynamic-with-receiver-rest")
      (let [rest-form (rd/sexp-nth x 3)
            index (if (rd/sexp-sym? rest-form)
                      (jsl-param-index d (rd/sexp-sym rest-form)) -1)]
        (if (or (< index 0) (not (jsl-param-rest? d index)))
            (jsl-fail! JSL-ERR-BAD-REST (jsl-decl-name d))
            (let [first (jsl-check-expr (rd/sexp-nth x 1) d)]
              (if (!= first JSL-OK) first
                  (jsl-check-expr (rd/sexp-nth x 2) d)))))))

;; `(loop [(name init [type]) ...] BODY...)`. The body is an expression: if it evaluates to `(recur ...)`
;; the loop iterates with those values, and otherwise its value is the loop's value. That is a
;; tail-recursive binding group, which is exactly what a loop Phi is — one phi per binding, the
;; init on the entry edge and the recur value on the back edge — so the surface and the IR agree
;; without an assignment form or a mutable local anywhere in the language.
(defn jsl-loop-depth [] (-> i64) (al-len [i64] (.arities (jsl))))
(defn jsl-loop-arity [] (-> i64)
  (if (= (jsl-loop-depth) 0) -1
      (al-get (.arities (jsl)) (- (jsl-loop-depth) 1))))
(defn jsl-loop-record-base [] (-> i64)
  (al-get (.looprecordbases (jsl)) (- (jsl-loop-depth) 1)))
(defn jsl-loop-record [(i i64)] (-> i64)
  (al-get (.looprecords (jsl)) (+ (jsl-loop-record-base) i)))
(defn jsl-loop-list [(i i64)] (-> i64)
  (al-get (.looplists (jsl)) (+ (jsl-loop-record-base) i)))
(defn jsl-loop-slot-list [(i i64)] (-> i64)
  (al-get (.loopslotlists (jsl)) (+ (jsl-loop-record-base) i)))

(defn jsl-check-loop [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (< (rd/sexp-count x) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d))) 0)
    (let [binds (rd/sexp-nth x 1)]
      (if (not (rd/sexp-vec? binds))
          (return-from :done (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d))) 0)
      (let [nb (rd/sexp-count binds)]
        (if (> nb JSL-MAX-PARAMS)
            (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS (jsl-decl-name d))) 0)
        (let [depth (jsl-scope-depth) (mut i) 0 (mut err) JSL-OK]
          ; The INITIALISERS are checked in the enclosing scope: they run once, before the loop
          ; exists, so a binding cannot see itself or its siblings.
          (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK)) (break)
                  (do
                    (let [b (rd/sexp-nth binds (load i))]
                      (if (or (not (rd/sexp-list? b))
                              (or (< (rd/sexp-count b) 2) (> (rd/sexp-count b) 3)))
                          (store! err (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d)))
                        (if (not (rd/sexp-sym? (rd/sexp-nth b 0)))
                            (store! err (jsl-fail! JSL-ERR-BAD-LOOP (jsl-decl-name d)))
                          (let [init (rd/sexp-nth b 1)
                                inferred (jsl-expr-record init d)
                                annotated (if (= (rd/sexp-count b) 3)
                                              (jsl-record-type-of (rd/sexp-nth b 2)) -1)
                                scalar-type (if (= (rd/sexp-count b) 3)
                                              (jsl-type-of (rd/sexp-nth b 2)) (t-dyn))]
                            (if (and (= (rd/sexp-count b) 3)
                                     (and (= scalar-type TY-NO-ID) (< annotated 0)))
                                (store! err (jsl-fail! JSL-ERR-BAD-TYPE
                                                       (rd/sexp-sym (rd/sexp-nth b 0))))
                              (if (and (= (rd/sexp-count b) 3)
                                       (!= inferred annotated))
                                  (store! err (jsl-fail! JSL-ERR-BAD-RECORD
                                                         (rd/sexp-sym (rd/sexp-nth b 0))))
                                  (store! err (jsl-check-expr init d))))))))
                    (store! i (+ (load i) 1))
                    0)))
          ; Then every binding is in scope for the body, all at once.
          (store! i 0)
          (loop (if (or (>= (load i) nb) (!= (load err) JSL-OK)) (break)
                  (let [binding (rd/sexp-nth binds (load i))]
                    (let [init (rd/sexp-nth binding 1)]
                      (jsl-scope-push-value! (rd/sexp-sym (rd/sexp-nth binding 0))
                                             (jsl-expr-record init d)
                                             (jsl-expr-record-list init d)
                                             (jsl-expr-slot-list init d)))
                      (store! i (+ (load i) 1))
                      0)))
          (if (= (load err) JSL-OK)
              (do
                  (let [record-base (al-len [i64] (.looprecords (jsl))) (mut k) 0]
                    (al-push! [i64] (field (jsl) looprecordbases) record-base)
                    (loop (if (>= (load k) nb) (break)
                              (do (al-push! [i64] (field (jsl) looprecords)
                                            (al-get (.bindrecords (jsl)) (+ depth (load k))))
                                  (al-push! [i64] (field (jsl) looplists)
                                            (al-get (.bindlists (jsl)) (+ depth (load k))))
                                  (al-push! [i64] (field (jsl) loopslotlists)
                                            (al-get (.bindslotlists (jsl)) (+ depth (load k))))
                                  (set! k (+ (load k) 1)))))
                    (al-push! [i64] (field (jsl) arities) nb)
                  (store! err (jsl-check-args x d 2))
                  (al-pop! [i64] (field (jsl) arities))
                    (al-pop! [i64] (field (jsl) looprecordbases))
                    (loop (if (<= (al-len [i64] (.looprecords (jsl))) record-base) (break)
                              (do (al-pop! [i64] (field (jsl) looprecords))
                                  (al-pop! [i64] (field (jsl) looplists))
                                  (al-pop! [i64] (field (jsl) loopslotlists)) 0))))
                  0)
              0)
          (jsl-scope-drop! depth)
          (load err))))))

(defn jsl-check-recur [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (block :done
    (if (= (jsl-loop-depth) 0)
        (return-from :done (jsl-fail! JSL-ERR-RECUR-OUTSIDE-LOOP (jsl-decl-name d))) 0)
    (if (!= (- (rd/sexp-count x) 1) (jsl-loop-arity))
        (return-from :done (jsl-fail! JSL-ERR-BAD-RECUR (jsl-decl-name d))) 0)
    (let [checked (jsl-check-args x d 1)]
      (if (!= checked JSL-OK) checked
        (let [(mut i) 0 (mut err) JSL-OK]
          (loop (if (or (>= (load i) (jsl-loop-arity)) (!= (load err) JSL-OK)) (break)
                  (do
                    (if (!= (jsl-expr-record (rd/sexp-nth x (+ (load i) 1)) d)
                            (jsl-loop-record (load i)))
                        (set! err (jsl-fail! JSL-ERR-BAD-RECORD "recur")) 0)
                    (if (!= (jsl-expr-record-list (rd/sexp-nth x (+ (load i) 1)) d)
                            (jsl-loop-list (load i)))
                        (set! err (jsl-fail! JSL-ERR-BAD-RECORD-LIST "recur")) 0)
                    (if (!= (jsl-expr-slot-list (rd/sexp-nth x (+ (load i) 1)) d)
                            (jsl-loop-slot-list (load i)))
                        (set! err (jsl-fail! JSL-ERR-BAD-SLOT-LIST "recur")) 0)
                    (set! i (+ (load i) 1)))))
          (load err))))))

(defn jsl-check-if [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (!= (rd/sexp-count x) 4)
      (jsl-fail! JSL-ERR-BAD-IF (jsl-decl-name d))
      (let [err (jsl-check-args x d 1)]
        (if (!= err JSL-OK) err
          (let [a (jsl-expr-record (rd/sexp-nth x 2) d)
                b (jsl-expr-record (rd/sexp-nth x 3) d)
                la (jsl-expr-record-list (rd/sexp-nth x 2) d)
                lb (jsl-expr-record-list (rd/sexp-nth x 3) d)
                sa (jsl-expr-slot-list (rd/sexp-nth x 2) d)
                sb (jsl-expr-slot-list (rd/sexp-nth x 3) d)
                ad (jsl-expr-diverges? (rd/sexp-nth x 2))
                bd (jsl-expr-diverges? (rd/sexp-nth x 3))]
            (if (and (not ad) (and (not bd)
                     (or (!= a b) (or (!= la lb) (!= sa sb)))))
                (jsl-fail! JSL-ERR-BAD-RECORD "if") JSL-OK))))))

(defn jsl-expr-diverges? [(x (ptr rd/Sexp))] (-> bool)
  (if (or (not (rd/sexp-list? x)) (= (rd/sexp-count x) 0)) false
    (let [head (rd/sexp-nth x 0)]
      (if (not (rd/sexp-sym? head)) false
        (let [name (rd/sexp-sym head)]
          (if (or (= name "recur") (or (= name "goto") (= name "%Throw"))) true
            (if (and (= name "if") (= (rd/sexp-count x) 4))
                (and (jsl-expr-diverges? (rd/sexp-nth x 2))
                     (jsl-expr-diverges? (rd/sexp-nth x 3)))
                (let [callee (jsl-find name)]
                  ;; One expansion level recognizes canonical Throw* helpers without walking a
                  ;; malformed recursive macro before the dedicated cycle checker runs.
                  (if (and (>= callee 0) (jsl-macro? callee))
                      (let [body (jsl-decl-body callee)]
                        (and (rd/sexp-list? body)
                             (and (> (rd/sexp-count body) 0)
                                  (and (rd/sexp-sym? (rd/sexp-nth body 0))
                                       (= (rd/sexp-sym (rd/sexp-nth body 0)) "%Throw")))))
                      false)))))))))

;; Static record identity. `-1` means an ordinary SSA value. The checker uses this to prevent a
;; compiler-only bundle from reaching a primitive or callable ABI and to require both arms of a
;; merge to carry the same schema.
(defn jsl-expr-record [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (rd/sexp-sym? x)
      (let [name (rd/sexp-sym x) local (jsl-scope-record name)]
        (if (jsl-scope-has? name) local
          (let [p (jsl-param-index d name)]
            (if (>= p 0) (jsl-param-record d p) -1))))
    (if (not (rd/sexp-list? x)) -1
      (if (= (rd/sexp-count x) 0) -1
        (let [head (rd/sexp-nth x 0)]
          (if (not (rd/sexp-sym? head)) -1
            (let [name (rd/sexp-sym head)]
              (if (= name "record-new")
                  (let [schema (rd/sexp-nth x 1)]
                    (if (rd/sexp-sym? schema) (jsl-record-find (rd/sexp-sym schema)) -1))
                (if (= name "record-with") (jsl-expr-record (rd/sexp-nth x 1) d)
                  (if (= name "record-list-load")
                      (jsl-expr-record-list (rd/sexp-nth x 1) d)
                  (if (= name "record-get")
                      (let [value (rd/sexp-nth x 1) field (rd/sexp-nth x 2)
                            schema (jsl-expr-record value d)]
                        (if (and (>= schema 0) (rd/sexp-sym? field))
                            (let [index (jsl-record-field-find schema (rd/sexp-sym field))]
                              (if (>= index 0) (jsl-record-field-record schema index) -1)) -1))
                  (if (= name "if")
                      (if (jsl-expr-diverges? (rd/sexp-nth x 2))
                          (jsl-expr-record (rd/sexp-nth x 3) d)
                          (jsl-expr-record (rd/sexp-nth x 2) d))
                    (if (= name "let") (jsl-expr-record-let x d)
                      (if (= name "loop") (jsl-expr-record-loop x d)
                        (let [callee (jsl-find name)]
                          (if (>= callee 0) (jsl-decl-ret-record callee) -1))))))))))))))))

(defn jsl-expr-record-list [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (rd/sexp-sym? x)
      (let [name (rd/sexp-sym x)]
        (if (jsl-scope-has? name) (jsl-scope-list name) -1))
    (if (or (not (rd/sexp-list? x)) (= (rd/sexp-count x) 0)) -1
      (let [head (rd/sexp-nth x 0)]
        (if (not (rd/sexp-sym? head)) -1
          (let [name (rd/sexp-sym head)]
            (if (= name "record-list-new")
                (let [schema (rd/sexp-nth x 1)]
                  (if (rd/sexp-sym? schema) (jsl-record-find (rd/sexp-sym schema)) -1))
              (if (= name "record-list-store")
                  (jsl-expr-record-list (rd/sexp-nth x 1) d)
                (if (= name "if")
                    (if (jsl-expr-diverges? (rd/sexp-nth x 2))
                        (jsl-expr-record-list (rd/sexp-nth x 3) d)
                        (jsl-expr-record-list (rd/sexp-nth x 2) d))
                  (if (= name "let") (jsl-expr-record-list-let x d) -1))))))))))

;; Static identity of an internal-slot List. These values exist only while expanding macros and
;; deliberately have no graph representation. A declaration name is a constant descriptor; a
;; macro parameter or let-binding carries that same identity through substitution.
(defn jsl-expr-slot-list [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (if (rd/sexp-sym? x)
      (let [name (rd/sexp-sym x)]
        (if (jsl-scope-has? name) (jsl-scope-slot-list name)
          (let [p (jsl-param-index d name)]
            (if (and (>= p 0) (jsl-param-slot-list? d p)) -2
              (jsl-slot-list-find name)))))
    (if (or (not (rd/sexp-list? x)) (= (rd/sexp-count x) 0)) -1
      (let [head (rd/sexp-nth x 0)]
        (if (not (rd/sexp-sym? head)) -1
          (let [name (rd/sexp-sym head)]
            (if (= name "if")
                (if (jsl-expr-diverges? (rd/sexp-nth x 2))
                    (jsl-expr-slot-list (rd/sexp-nth x 3) d)
                    (jsl-expr-slot-list (rd/sexp-nth x 2) d))
              (if (= name "let") (jsl-expr-slot-list-let x d) -1))))))))

(defn jsl-expr-slot-list-let [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (let [bindings (rd/sexp-nth x 1) depth (jsl-scope-depth) (mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count bindings)) (break)
              (let [binding (rd/sexp-nth bindings (load i)) value (rd/sexp-nth binding 1)]
                (jsl-scope-push-value! (rd/sexp-sym (rd/sexp-nth binding 0))
                                       (jsl-expr-record value d)
                                       (jsl-expr-record-list value d)
                                       (jsl-expr-slot-list value d))
                (set! i (+ (load i) 1)))))
    (let [(mut result) -1 (mut body) 2]
      (loop (if (>= (load body) (rd/sexp-count x)) (break)
                (do (set! result (jsl-expr-slot-list (rd/sexp-nth x (load body)) d))
                    (set! body (+ (load body) 1)))))
      (jsl-scope-drop! depth)
      (load result))))

(defn jsl-expr-record-list-let [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (let [bindings (rd/sexp-nth x 1) depth (jsl-scope-depth) (mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count bindings)) (break)
              (let [binding (rd/sexp-nth bindings (load i)) value (rd/sexp-nth binding 1)]
                (jsl-scope-push-value! (rd/sexp-sym (rd/sexp-nth binding 0))
                                       (jsl-expr-record value d)
                                       (jsl-expr-record-list value d)
                                       (jsl-expr-slot-list value d))
                (set! i (+ (load i) 1)))))
    (let [(mut result) -1 (mut body) 2]
      (loop (if (>= (load body) (rd/sexp-count x)) (break)
                (do (set! result (jsl-expr-record-list (rd/sexp-nth x (load body)) d))
                    (set! body (+ (load body) 1)))))
      (jsl-scope-drop! depth)
      (load result))))

(defn jsl-expr-record-let [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (let [bindings (rd/sexp-nth x 1)
        depth (jsl-scope-depth)
        (mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count bindings)) (break)
              (let [binding (rd/sexp-nth bindings (load i))]
                (let [value (rd/sexp-nth binding 1)]
                  (jsl-scope-push-value! (rd/sexp-sym (rd/sexp-nth binding 0))
                                         (jsl-expr-record value d)
                                         (jsl-expr-record-list value d)
                                         (jsl-expr-slot-list value d)))
                (set! i (+ (load i) 1)))))
    (let [(mut result) -1 (mut body) 2]
      (loop (if (>= (load body) (rd/sexp-count x)) (break)
                (do (set! result (jsl-expr-record (rd/sexp-nth x (load body)) d))
                    (set! body (+ (load body) 1)))))
      (jsl-scope-drop! depth)
      (load result))))

(defn jsl-expr-record-loop [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (let [bindings (rd/sexp-nth x 1)
        depth (jsl-scope-depth)
        (mut i) 0]
    (loop (if (>= (load i) (rd/sexp-count bindings)) (break)
              (let [binding (rd/sexp-nth bindings (load i))]
                (jsl-scope-push-record! (rd/sexp-sym (rd/sexp-nth binding 0))
                                        (jsl-expr-record (rd/sexp-nth binding 1) d))
                (set! i (+ (load i) 1)))))
    (let [(mut result) -1 (mut body) 2]
      (loop (if (>= (load body) (rd/sexp-count x)) (break)
                (do (set! result (jsl-expr-record (rd/sexp-nth x (load body)) d))
                    (set! body (+ (load body) 1)))))
      (jsl-scope-drop! depth)
      (load result))))

(defn jsl-check-record-form [(x (ptr rd/Sexp)) (d i64) (name (slice u8))] (-> i64)
  (block :done
    (if (= name "record-new")
        (do
          (if (!= (rd/sexp-count x) 3)
              (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
          (let [schemaform (rd/sexp-nth x 1) fields (rd/sexp-nth x 2)]
            (if (not (rd/sexp-sym? schemaform))
                (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-RECORD name)) 0)
            (let [schema (jsl-record-find (rd/sexp-sym schemaform))]
              (if (< schema 0)
                  (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-RECORD
                                                 (rd/sexp-sym schemaform))) 0)
              (if (or (not (rd/sexp-vec? fields))
                      (!= (rd/sexp-count fields) (jsl-record-nfields schema)))
                  (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-FIELD
                                                 (jsl-record-name schema))) 0)
              (let [(mut i) 0 (mut seen) 0 (mut err) JSL-OK]
                (loop (if (or (>= (load i) (rd/sexp-count fields))
                              (!= (load err) JSL-OK)) (break)
                        (let [pair (rd/sexp-nth fields (load i))]
                          (if (or (not (rd/sexp-list? pair)) (!= (rd/sexp-count pair) 2))
                              (store! err (jsl-fail! JSL-ERR-BAD-RECORD-FIELD
                                                     (jsl-record-name schema)))
                            (let [field (rd/sexp-nth pair 0)]
                              (if (not (rd/sexp-sym? field))
                                  (store! err (jsl-fail! JSL-ERR-BAD-RECORD-FIELD
                                                         (jsl-record-name schema)))
                                (let [index (jsl-record-field-find schema (rd/sexp-sym field))]
                                  (if (or (< index 0)
                                          (!= (& (load seen) (<< 1 index)) 0))
                                      (store! err (jsl-fail! JSL-ERR-BAD-RECORD-FIELD
                                                             (rd/sexp-sym field)))
                                    (do
                                      (store! seen (| (load seen) (<< 1 index)))
                                      (store! err (jsl-check-expr (rd/sexp-nth pair 1) d))
                                      (if (and (= (load err) JSL-OK)
                                               (!= (jsl-expr-record (rd/sexp-nth pair 1) d)
                                                   (jsl-record-field-record schema index)))
                                          (store! err (jsl-fail! JSL-ERR-RECORD-ESCAPE
                                                                 (rd/sexp-sym field))) 0)))))))
                          (store! i (+ (load i) 1)))))
                (return-from :done (load err)))))) 0)
    (if (= name "record-get")
        (do
          (if (!= (rd/sexp-count x) 3)
              (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
          (let [value (rd/sexp-nth x 1) field (rd/sexp-nth x 2)]
            (let [err (jsl-check-expr value d)]
              (if (!= err JSL-OK) (return-from :done err) 0))
            (let [schema (jsl-expr-record value d)]
              (if (or (< schema 0) (not (rd/sexp-sym? field)))
                  (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
              (if (< (jsl-record-field-find schema (rd/sexp-sym field)) 0)
                  (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-FIELD
                                                 (rd/sexp-sym field))) 0)))
          (return-from :done JSL-OK)) 0)
    ;; record-with: immutable update, preserving schema identity.
    (if (!= (rd/sexp-count x) 4)
        (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
    (let [value (rd/sexp-nth x 1) field (rd/sexp-nth x 2)
          err (jsl-check-expr value d)]
      (if (!= err JSL-OK) (return-from :done err) 0)
      (let [schema (jsl-expr-record value d)]
        (if (or (< schema 0) (not (rd/sexp-sym? field)))
            (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
        (if (< (jsl-record-field-find schema (rd/sexp-sym field)) 0)
            (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-FIELD (rd/sexp-sym field))) 0))
      (let [replacement (rd/sexp-nth x 3)
            checked (jsl-check-expr replacement d)]
        (if (!= checked JSL-OK) checked
          (let [schema (jsl-expr-record value d)
                index (jsl-record-field-find schema (rd/sexp-sym field))]
            (if (!= (jsl-expr-record replacement d)
                    (jsl-record-field-record schema index))
                (jsl-fail! JSL-ERR-RECORD-ESCAPE (rd/sexp-sym field)) JSL-OK)))))))

(defn jsl-check-record-list-form [(x (ptr rd/Sexp)) (d i64) (name (slice u8))] (-> i64)
  (block :done
    (if (= name "record-list-new")
        (do
          (if (!= (rd/sexp-count x) 2)
              (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-LIST name)) 0)
          (let [schema (rd/sexp-nth x 1)]
            (if (or (not (rd/sexp-sym? schema))
                    (< (jsl-record-find (if (rd/sexp-sym? schema)
                                           (rd/sexp-sym schema) "")) 0))
                (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-RECORD name)) 0))
          (return-from :done JSL-OK)) 0)
    (let [expected-count (if (= name "record-list-store") 4 3)]
      (if (!= (rd/sexp-count x) expected-count)
          (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-LIST name)) 0))
    (let [list (rd/sexp-nth x 1) index (rd/sexp-nth x 2)
          checked-list (jsl-check-expr list d)]
      (if (!= checked-list JSL-OK) (return-from :done checked-list) 0)
      (let [schema (jsl-expr-record-list list d)]
        (if (< schema 0)
            (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-LIST name)) 0)
        (let [checked-index (jsl-check-expr index d)]
          (if (!= checked-index JSL-OK) (return-from :done checked-index) 0)
          (if (or (>= (jsl-expr-record index d) 0)
                  (>= (jsl-expr-record-list index d) 0))
              (return-from :done (jsl-fail! JSL-ERR-RECORD-ESCAPE name)) 0))
        (if (= name "record-list-store")
            (let [value (rd/sexp-nth x 3) checked (jsl-check-expr value d)]
              (if (!= checked JSL-OK) (return-from :done checked) 0)
              (if (!= (jsl-expr-record value d) schema)
                  (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD-LIST name)) 0)) 0))
      JSL-OK)))

(defn jsl-check-object-layout-form [(x (ptr rd/Sexp)) (d i64) (name (slice u8))] (-> i64)
  (block :done
    (if (= name "object-layout-init")
        (do
          (if (!= (rd/sexp-count x) 3)
              (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
          (let [object (rd/sexp-nth x 1) slots (rd/sexp-nth x 2)
                checked (jsl-check-expr object d)]
            (if (!= checked JSL-OK) (return-from :done checked) 0)
            (if (= (jsl-expr-slot-list slots d) -1)
                (return-from :done (jsl-fail! JSL-ERR-BAD-SLOT-LIST name)) 0))
          (return-from :done JSL-OK)) 0)
    (if (or (= name "object-method-family-is") (= name "object-method-family-set"))
        (do
          (if (!= (rd/sexp-count x) 3)
              (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
          (let [family (rd/sexp-nth x 2)]
            (if (or (not (rd/sexp-sym? family))
                    (< (jsl-method-family-find
                         (if (rd/sexp-sym? family) (rd/sexp-sym family) "")) 0))
                (return-from :done (jsl-fail! JSL-ERR-BAD-METHOD-FAMILY name)) 0))
          (return-from :done (jsl-check-expr (rd/sexp-nth x 1) d)) 0)
        0)
    (if (= name "object-method-is-ordinary")
        (do
          (if (!= (rd/sexp-count x) 3)
              (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
          (let [method (rd/sexp-nth x 2)]
            (if (or (not (rd/sexp-sym? method))
                    (< (jsl-internal-method-find
                         (if (rd/sexp-sym? method) (rd/sexp-sym method) "")) 0))
                (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-METHOD name)) 0))
          (return-from :done (jsl-check-expr (rd/sexp-nth x 1) d)) 0)
        0)
    (let [store (= name "internal-slot-store")
          expected (if store 4 3)]
      (if (!= (rd/sexp-count x) expected)
          (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
      (let [slot (rd/sexp-nth x 2)]
        (if (or (not (rd/sexp-sym? slot))
                (< (jsl-internal-slot-find (if (rd/sexp-sym? slot) (rd/sexp-sym slot) "")) 0))
            (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-SLOT name)) 0))
      (let [first (jsl-check-expr (rd/sexp-nth x 1) d)]
        (if (!= first JSL-OK) (return-from :done first) 0))
      (if store
          (return-from :done (jsl-check-expr (rd/sexp-nth x 3) d)) 0)
      JSL-OK)))

;; Designed in docs/JSL.md, not built. Refused BY NAME so that a `.jsl` file using one cannot
;; produce a graph, and so that the diagnostic says which form stopped it rather than "unknown".
(defn jsl-unsupported-form? [(name (slice u8))] (-> bool) (= name "class"))

(defn jsl-check-expr [(x (ptr rd/Sexp)) (d i64)] (-> i64)
  (jsl-at! x)
  (block :done
    (if (rd/sexp-int? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-float? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-str? x) (return-from :done JSL-OK) 0)
    (if (rd/sexp-sym? x)
        (let [s (rd/sexp-sym x)]
          ; THE ORDER IS THE LOWERING'S ORDER. `jl-lookup` searches the binding stack innermost
          ; first and parameters are its outermost entries, so a `let` shadows a parameter there;
          ; resolving parameters first here would make the two disagree about which node a name
          ; denotes, and only in a program that shadows.
          (if (!= (jsl-literal-ty s) TY-NO-ID) (return-from :done JSL-OK) 0)
          (if (jsl-scope-has? s) (return-from :done JSL-OK) 0)
          (let [parameter (jsl-param-index d s)]
            (if (>= parameter 0)
                (if (jsl-param-rest? d parameter)
                    (return-from :done (jsl-fail! JSL-ERR-BAD-REST s))
                    (return-from :done JSL-OK))
                0))
          (if (>= (jsl-capture-index d s) 0) (return-from :done JSL-OK) 0)
          (if (and (jsl-callable? d) (= s "this")) (return-from :done JSL-OK) 0)
          (if (>= (jsl-slot-list-find s) 0) (return-from :done JSL-OK) 0)
          (return-from :done (jsl-fail! JSL-ERR-UNBOUND s)))
        0)
    (if (= (rd/sexp-count x) 0)
        (return-from :done (jsl-fail! JSL-ERR-EMPTY-CALL (jsl-decl-name d))) 0)
    (let [head (rd/sexp-nth x 0)]
      (if (not (rd/sexp-sym? head))
          (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM (jsl-decl-name d))) 0)
      (let [name (rd/sexp-sym head)]
        (if (jsl-unsupported-form? name) (return-from :done (jsl-fail! JSL-ERR-UNSUPPORTED name)) 0)
        (if (= name "let") (return-from :done (jsl-check-let x d)) 0)
        (if (= name "if")  (return-from :done (jsl-check-if x d)) 0)
        (if (= name "goto") (return-from :done (jsl-check-goto x d)) 0)
        (if (= name "loop") (return-from :done (jsl-check-loop x d)) 0)
        (if (= name "recur") (return-from :done (jsl-check-recur x d)) 0)
        (if (or (= name "record-new")
                (or (= name "record-get") (= name "record-with")))
            (return-from :done (jsl-check-record-form x d name)) 0)
        (if (or (= name "record-list-new")
                (or (= name "record-list-store") (= name "record-list-load")))
            (return-from :done (jsl-check-record-list-form x d name)) 0)
        (if (or (= name "object-layout-init")
                (or (= name "object-method-family-is")
                    (or (= name "object-method-family-set")
                    (or (= name "object-method-is-ordinary")
                (or (= name "internal-slot-has")
                    (or (= name "internal-slot-load") (= name "internal-slot-store")))))))
            (return-from :done (jsl-check-object-layout-form x d name)) 0)
        (if (= name "call") (return-from :done (jsl-check-js-call x d)) 0)
        (if (= name "call-with-receiver")
            (return-from :done (jsl-check-js-call-with-receiver x d)) 0)
        (if (= name "call-dynamic-with-receiver")
            (return-from :done (jsl-check-js-call-with-receiver x d)) 0)
        (if (= name "call-dynamic-with-receiver-rest")
            (return-from :done (jsl-check-js-call-with-rest x d)) 0)
        (if (= name "closure")
            (let [count (rd/sexp-count x)]
              (if (< count 2) (return-from :done (jsl-fail! JSL-ERR-ARITY name)) 0)
              (let [target-form (rd/sexp-nth x 1)]
                (if (not (rd/sexp-sym? target-form))
                    (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-CALL name)) 0)
                (let [target (jsl-find (rd/sexp-sym target-form))]
                  (if (or (< target 0) (not (jsl-callable? target)))
                      (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-CALL
                                                     (rd/sexp-sym target-form))) 0)
                  (if (!= (- count 2) (jsl-decl-ncaptures target))
                      (return-from :done (jsl-fail! JSL-ERR-ARITY
                                                     (rd/sexp-sym target-form))) 0)
                  (return-from :done (jsl-check-args x d 2))))) 0)
        (jsl-check-call x d)))))

; ============================================================================
; Macro recursion
; ============================================================================
;; A macro is expanded INTO the caller's graph, so a macro that reaches itself has no fixed point
;; and the lowering would not terminate. That has to be a diagnostic rather than a hang, and it has
;; to be found statically: a depth cap in the lowering would report the wrong thing (a legal deep
;; nest) at the wrong time (after nodes had been built).
;;
;; A standard three-colour DFS over the macro call graph. GREY means "on the current path", so
;; reaching a GREY node is a cycle; BLACK means "finished, and no cycle was found through it", which
;; is what stops a shared macro being walked once per caller.
(const JSL-MARK-WHITE i64 0)
(const JSL-MARK-GREY  i64 1)
(const JSL-MARK-BLACK i64 2)

(defn jsl-mark [(i i64)] (-> i64) (al-get (.marks (jsl)) i))
(defn jsl-set-mark! [(i i64) (v i64)] (-> i64) (al-set! [i64] (field (jsl) marks) i v))

;; Walk one body for calls to macros, recursing through each. Split from the sexp walk below only
;; because the walk has to happen at every nesting depth and the colour logic should appear once.
(defn jsl-macro-edge [(from i64) (callee i64)] (-> i64)
  (if (not (jsl-macro? callee)) JSL-OK
    (if (= (jsl-mark callee) JSL-MARK-GREY)
        (jsl-fail! JSL-ERR-MACRO-RECURSION (jsl-decl-name callee))
      (if (= (jsl-mark callee) JSL-MARK-BLACK) JSL-OK
        (jsl-macro-dfs callee)))))

;; Descends into vectors too, for the reason `jsl-body-reads-memory?` documents: a macro called from
;; inside a `let` or `loop` binding would otherwise be invisible to cycle detection.
(defn jsl-macro-walk [(x (ptr rd/Sexp)) (from i64)] (-> i64)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) JSL-OK
    (let [n (rd/sexp-count x) (mut i) 0 (mut err) JSL-OK]
      ; The head, when it is a symbol, may name a macro; every item is then walked for nested calls.
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [callee (jsl-find (rd/sexp-sym (rd/sexp-nth x 0)))]
            (if (>= callee 0) (set! err (jsl-macro-edge from callee)) 0))
          0)
      (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
              (do (set! err (jsl-macro-walk (rd/sexp-nth x (load i)) from))
                  (set! i (+ (load i) 1))
                  0)))
      (load err))))

(defn jsl-macro-dfs [(d i64)] (-> i64)
  (jsl-set-mark! d JSL-MARK-GREY)
  (let [err (jsl-macro-walk (jsl-decl-body d) d)]
    (jsl-set-mark! d JSL-MARK-BLACK)
    err))

;; Which definitions read the heap, to a fixpoint over the call graph. A definition reads it if its
;; body names a heap-reading primitive, or if it calls one that does — and a `macro` propagates its
;; use to the caller it is inlined into, which is why this is computed over calls rather than read
;; off each body in isolation.
;; DESCENDS INTO VECTORS AS WELL AS LISTS. Since the surface moved to brackets, `let` and `loop`
;; bindings live in a `KVec`, so a walk that only recursed into `KList` would miss every call and
;; every primitive written inside one — silently, because a missed use just means "does not read the
;; heap" rather than an error.
(defn jsl-body-reads-memory? [(x (ptr rd/Sexp))] (-> bool)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) false
    (let [n (rd/sexp-count x) (mut i) 0 (mut found) false]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (or (= name "call")
                    (or (= name "object-layout-init")
                        (or (= name "object-method-family-is")
                            (or (= name "object-method-family-set")
                            (or (= name "object-method-is-ordinary")
                        (or (= name "internal-slot-has")
                            (or (= name "internal-slot-load")
                                (= name "internal-slot-store"))))))))
                (set! found true)
              (if (jsl-prim-name? name)
                (let [id (jsp-find name)]
                  (if (and (!= id JSP-NONE) (jsp-reads-memory? id)) (set! found true) 0))
              (let [c (jsl-find name)]
                (if (and (>= c 0) (jsl-decl-uses-memory? c)) (set! found true) 0)))))
          0)
      (loop (if (or (>= (load i) n) (load found)) (break)
              (do (if (jsl-body-reads-memory? (rd/sexp-nth x (load i))) (set! found true) 0)
                  (set! i (+ (load i) 1))
                  0)))
      (load found))))

;; `heapparams` records which source parameters reach heap primitives, propagated through calls.
;; It began as a safety check while called builtins could not receive their caller's heap. Heap use
;; is now an explicit function effect instead: `jsl-resolve-memory-use!` gives such a builtin one
;; implicit trailing memory argument, and lowering publishes its returned memory at CallEnd. Keep
;; this analysis as useful declaration metadata and as a cross-check on the memory-use fixpoint;
;; it no longer rejects called builtins.
(defn jsl-param-of [(d i64) (x (ptr rd/Sexp))] (-> i64)
  (if (not (rd/sexp-sym? x)) -1 (jsl-param-index d (rd/sexp-sym x))))

(defn jsl-heap-walk [(x (ptr rd/Sexp)) (d i64) (acc (ptr i64))] (-> i64)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) 0
    (let [n (rd/sexp-count x)]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (jsl-prim-name? name)
                ; Operand 1 of every heap primitive is the array.
                (let [id (jsp-find name)]
                  (if (and (and (!= id JSP-NONE) (jsp-reads-memory? id)) (> n 1))
                      (let [k (jsl-param-of d (rd/sexp-nth x 1))]
                        (if (>= k 0) (set! acc (| (load acc) (<< 1 k))) 0))
                      0))
              (let [callee (jsl-find name)]
                (if (< callee 0) 0
                  (let [bits (jsl-decl-heap-params callee) (mut a) 1]
                    (loop (if (>= (load a) n) (break)
                            (do (if (!= (& bits (<< 1 (- (load a) 1))) 0)
                                    (let [k (jsl-param-of d (rd/sexp-nth x (load a)))]
                                      (if (>= k 0) (set! acc (| (load acc) (<< 1 k))) 0))
                                    0)
                                (set! a (+ (load a) 1))
                                0)))
                    0)))))
          0)
      (let [(mut i) 0]
        (loop (if (>= (load i) n) (break)
                (do (jsl-heap-walk (rd/sexp-nth x (load i)) d acc)
                    (set! i (+ (load i) 1))
                    0))))
      0)))

(defn jsl-resolve-heap-params! [] (-> i64)
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0]
    (loop (if (not (load changed)) (break)
            (do (set! changed false)
                (let [(mut i) 0]
                  (loop (if (>= (load i) n) (break)
                          (let [(mut acc) (jsl-decl-heap-params (load i))]
                            (jsl-heap-walk (jsl-decl-body (load i)) (load i) (mut acc))
                            (if (!= (load acc) (jsl-decl-heap-params (load i)))
                                (do (jsl-decl-set-heap-params! (load i) (load acc))
                                    (set! changed true) 0)
                                0)
                            (set! i (+ (load i) 1))
                            0))))
                (set! rounds (+ (load rounds) 1))
                (if (> (load rounds) (+ n 2))
                    (do (jsl-fail! JSL-ERR-MACRO-RECURSION "heap-parameter fixpoint") 0) 0)
                0)))
    JSL-OK))

(defn jsl-check-heap-shape [] (-> i64)
  (jsl-resolve-heap-params!))

;; The same walk as `jsl-body-reads-memory?`, asking a narrower question: does this body contain a
;; JavaScript CALL form, or call a definition that does. `call`, `call-with-receiver` and
;; `call-dynamic-with-receiver` and its compile-away rest form are the callback spellings; every
;; other head is either a
;; primitive or another definition, and a definition propagates the answer to its callers.
(defn jsl-body-calls-back? [(x (ptr rd/Sexp))] (-> bool)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) false
    (let [n (rd/sexp-count x) (mut i) 0 (mut found) false]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (or (= name "call")
                    (or (= name "call-with-receiver")
                        (or (= name "call-dynamic-with-receiver")
                            (= name "call-dynamic-with-receiver-rest"))))
                (set! found true)
              (if (jsl-prim-name? name)
                  0
                  (let [c (jsl-find name)]
                    (if (and (>= c 0) (jsl-decl-calls-back? c)) (set! found true) 0)))))
          0)
      (loop (if (or (>= (load i) n) (load found)) (break)
              (do (if (jsl-body-calls-back? (rd/sexp-nth x (load i))) (set! found true) 0)
                  (set! i (+ (load i) 1))
                  0)))
      (load found))))


;; Collect every declaration named in head position anywhere in one body, including inside vectors
;; -- a call inside a `let` or `loop` binding is a call. Duplicates are allowed: the propagation
;; below only reads flags, so a repeated edge costs one extra comparison and no correctness.
(defn jsl-collect-callees! [(x (ptr rd/Sexp)) (self i64)] (-> i64)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) 0
    (let [n (rd/sexp-count x) (mut i) 0]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [callee (jsl-find (rd/sexp-sym (rd/sexp-nth x 0)))]
            (if (and (>= callee 0) (!= callee self))
                (al-push! [i64] (field (jsl) callee-entry) callee)
                0))
          0)
      (loop (if (>= (load i) n) (break)
              (do (jsl-collect-callees! (rd/sexp-nth x (load i)) self)
                  (set! i (+ (load i) 1)))))
      0)))

(defn jsl-build-call-graph! [] (-> i64)
  (let [p (jsl) n (jsl-decl-count) (mut i) 0]
    (al-clear! [i64] (field p callee-first))
    (al-clear! [i64] (field p callee-count))
    (al-clear! [i64] (field p callee-entry))
    (loop (if (>= (load i) n) (break)
            (let [first (al-len [i64] (.callee-entry p))]
              (jsl-collect-callees! (jsl-decl-body (load i)) (load i))
              (al-push! [i64] (field p callee-first) first)
              (al-push! [i64] (field p callee-count)
                        (- (al-len [i64] (.callee-entry p)) first))
              (set! i (+ (load i) 1)))))
    0))

(defn jsl-callee-count [(d i64)] (-> i64)
  (al-get [i64] (.callee-count (jsl)) d))
(defn jsl-callee [(d i64) (which i64)] (-> i64)
  (al-get [i64] (.callee-entry (jsl)) (+ (al-get [i64] (.callee-first (jsl)) d) which)))

(defn jsl-resolve-callback-use! [] (-> i64)
  ;; ROUND ONE walks the bodies, because that is what decides a declaration's OWN bit. After it,
  ;; the only way a declaration can newly gain the flag is through a callee that has it, so the
  ;; rest of the fixed point runs over the cached call graph instead of over syntax.
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0 (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (do
              (if (jsl-decl-calls-back? (load i)) 0
                (if (jsl-body-calls-back? (jsl-decl-body (load i)))
                    (do (jsl-decl-set-calls-back! (load i) true) 0)
                    0))
              (set! i (+ (load i) 1)))))
    (loop (if (not (load changed)) (break)
            (do
              (set! changed false)
              (set! i 0)
              (loop (if (>= (load i) n) (break)
                      (do
                        (if (jsl-decl-calls-back? (load i)) 0
                          (let [c (jsl-callee-count (load i)) (mut k) 0]
                            (loop (if (>= (load k) c) (break)
                                    (do
                                      (if (jsl-decl-calls-back? (jsl-callee (load i) (load k)))
                                          (do (jsl-decl-set-calls-back! (load i) true)
                                              (set! changed true)
                                              (set! k c) 0)
                                          0)
                                      (set! k (+ (load k) 1)))))))
                        (set! i (+ (load i) 1)))))
              (set! rounds (+ (load rounds) 1))
              ; Each round either sets a flag that never clears or stops, so this terminates in at
              ; most one round per declaration. The cap makes that a named failure, not a hang.
              (if (> (load rounds) (+ n 1))
                  (do (jsl-fail! JSL-ERR-MACRO-RECURSION "callback-use fixpoint") 0)
                  0))))
    JSL-OK))

(defn jsl-name-calls-back? [(name (slice u8))] (-> bool)
  (let [d (jsl-find name)]
    (and (>= d 0) (jsl-decl-calls-back? d))))

;; Exception checks are emitted only around definitions that can actually raise.  This fixed point
;; keeps that optimization an exact property of the DSL call graph rather than a frontend list of
;; operations someone must remember to update.
(defn jsl-body-can-throw? [(x (ptr rd/Sexp))] (-> bool)
  (if (and (not (rd/sexp-list? x)) (not (rd/sexp-vec? x))) false
    (let [n (rd/sexp-count x) (mut i) 0 (mut found) false]
      (if (and (rd/sexp-list? x) (and (> n 0) (rd/sexp-sym? (rd/sexp-nth x 0))))
          (let [name (rd/sexp-sym (rd/sexp-nth x 0))]
            (if (= name "%Throw")
                (set! found true)
                (if (or (= name "call")
                        (or (= name "call-with-receiver")
                            (or (= name "call-dynamic-with-receiver")
                                (= name "call-dynamic-with-receiver-rest"))))
                    ;; User callbacks may throw even when their concrete target is not statically
                    ;; visible to the library definition.
                    (set! found true)
                    (if (jsl-prim-name? name)
                        0
                        (let [callee (jsl-find name)]
                          (if (and (>= callee 0) (jsl-decl-can-throw? callee))
                              (set! found true)
                              0))))))
          0)
      (loop (if (or (>= (load i) n) (load found)) (break)
              (do (if (jsl-body-can-throw? (rd/sexp-nth x (load i))) (set! found true) 0)
                  (set! i (+ (load i) 1)))))
      (load found))))

(defn jsl-resolve-throw-use! [] (-> i64)
  ;; ROUND ONE walks the bodies, because that is what decides a declaration's OWN bit. After it,
  ;; the only way a declaration can newly gain the flag is through a callee that has it, so the
  ;; rest of the fixed point runs over the cached call graph instead of over syntax.
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0 (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (do
              (if (jsl-decl-can-throw? (load i)) 0
                (if (jsl-body-can-throw? (jsl-decl-body (load i)))
                    (do (jsl-decl-set-can-throw! (load i) true) 0)
                    0))
              (set! i (+ (load i) 1)))))
    (loop (if (not (load changed)) (break)
            (do
              (set! changed false)
              (set! i 0)
              (loop (if (>= (load i) n) (break)
                      (do
                        (if (jsl-decl-can-throw? (load i)) 0
                          (let [c (jsl-callee-count (load i)) (mut k) 0]
                            (loop (if (>= (load k) c) (break)
                                    (do
                                      (if (jsl-decl-can-throw? (jsl-callee (load i) (load k)))
                                          (do (jsl-decl-set-can-throw! (load i) true)
                                              (set! changed true)
                                              (set! k c) 0)
                                          0)
                                      (set! k (+ (load k) 1)))))))
                        (set! i (+ (load i) 1)))))
              (set! rounds (+ (load rounds) 1))
              ; Each round either sets a flag that never clears or stops, so this terminates in at
              ; most one round per declaration. The cap makes that a named failure, not a hang.
              (if (> (load rounds) (+ n 1))
                  (do (jsl-fail! JSL-ERR-MACRO-RECURSION "throw-use fixpoint") 0)
                  0))))
    JSL-OK))

(defn jsl-name-can-throw? [(name (slice u8))] (-> bool)
  (let [d (jsl-find name)]
    (and (>= d 0) (jsl-decl-can-throw? d))))

(defn jsl-resolve-memory-use! [] (-> i64)
  ;; ROUND ONE walks the bodies, because that is what decides a declaration's OWN bit. After it,
  ;; the only way a declaration can newly gain the flag is through a callee that has it, so the
  ;; rest of the fixed point runs over the cached call graph instead of over syntax.
  (let [n (jsl-decl-count) (mut changed) true (mut rounds) 0 (mut i) 0]
    (loop (if (>= (load i) n) (break)
            (do
              (if (jsl-decl-uses-memory? (load i)) 0
                (if (jsl-body-reads-memory? (jsl-decl-body (load i)))
                    (do (jsl-decl-set-uses-memory! (load i) true) 0)
                    0))
              (set! i (+ (load i) 1)))))
    (loop (if (not (load changed)) (break)
            (do
              (set! changed false)
              (set! i 0)
              (loop (if (>= (load i) n) (break)
                      (do
                        (if (jsl-decl-uses-memory? (load i)) 0
                          (let [c (jsl-callee-count (load i)) (mut k) 0]
                            (loop (if (>= (load k) c) (break)
                                    (do
                                      (if (jsl-decl-uses-memory? (jsl-callee (load i) (load k)))
                                          (do (jsl-decl-set-uses-memory! (load i) true)
                                              (set! changed true)
                                              (set! k c) 0)
                                          0)
                                      (set! k (+ (load k) 1)))))))
                        (set! i (+ (load i) 1)))))
              (set! rounds (+ (load rounds) 1))
              ; Each round either sets a flag that never clears or stops, so this terminates in at
              ; most one round per declaration. The cap makes that a named failure, not a hang.
              (if (> (load rounds) (+ n 1))
                  (do (jsl-fail! JSL-ERR-MACRO-RECURSION "memory-use fixpoint") 0)
                  0))))
    JSL-OK))

(defn jsl-check-macro-cycles [] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK]
    (al-clear! [i64] (field (jsl) marks))
    (loop (if (>= (load i) n) (break)
            (do (al-push! [i64] (field (jsl) marks) JSL-MARK-WHITE)
                (set! i (+ (load i) 1))
                0)))
    (set! i 0)
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
            (do (if (and (jsl-macro? (load i)) (= (jsl-mark (load i)) JSL-MARK-WHITE))
                    (set! err (jsl-macro-dfs (load i))) 0)
                (set! i (+ (load i) 1))
                0)))
    (load err)))

;; Check every declaration's body. Separate from `jsl-load!` because a body may call a definition
;; that appears LATER in the file: resolution has to see the whole table, so the table is built
;; first and walked second.
(defn jsl-check [] (-> i64)
  (let [n (jsl-decl-count) (mut i) 0 (mut err) JSL-OK (mut body-start) (jsl-profile-now)]
    (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
              (break)
              (do
                (al-clear! [(slice u8)] (field (jsl) binds))
                (al-clear! [i64] (field (jsl) bindrecords))
                (al-clear! [i64] (field (jsl) bindlists))
                (al-clear! [i64] (field (jsl) bindslotlists))
                (set! err (jsl-check-expr (jsl-decl-body (load i)) (load i)))
                (if (and (= (load err) JSL-OK)
                         (!= (jsl-expr-record (jsl-decl-body (load i)) (load i))
                             (jsl-decl-ret-record (load i))))
                    (set! err (jsl-fail! JSL-ERR-RECORD-ESCAPE
                                         (jsl-decl-name (load i)))) 0)
                (if (and (= (load err) JSL-OK)
                         (>= (jsl-expr-record-list (jsl-decl-body (load i)) (load i)) 0))
                    (set! err (jsl-fail! JSL-ERR-RECORD-ESCAPE
                                         (jsl-decl-name (load i)))) 0)
                (if (and (= (load err) JSL-OK)
                         (!= (jsl-expr-slot-list (jsl-decl-body (load i)) (load i)) -1))
                    (set! err (jsl-fail! JSL-ERR-SLOT-LIST-ESCAPE
                                         (jsl-decl-name (load i)))) 0)
                (set! i (+ (load i) 1)))))
    (fmt (stderr) "AOTK_TIMING phase=jsl_check_bodies ns={d}\n" (- (jsl-profile-now) (load body-start)))
    ; Cycles LAST: a body that does not resolve has no meaningful call graph, so reporting a
    ; recursion through an unknown name would name the wrong problem.
    (if (!= (load err) JSL-OK) (load err)
      (let [t0 (jsl-profile-now)
            _ (jsl-build-call-graph!)
            t1 (jsl-profile-now)
            cycles (jsl-check-macro-cycles)
            t2 (jsl-profile-now)]
        (if (!= cycles JSL-OK) cycles
          (let [mem (jsl-resolve-memory-use!)
                t3 (jsl-profile-now)]
            (if (!= mem JSL-OK) mem
              (let [cb (jsl-resolve-callback-use!)
                    t4 (jsl-profile-now)]
                (if (!= cb JSL-OK) cb
                    (let [throws (jsl-resolve-throw-use!)
                          t5 (jsl-profile-now)]
                      (if (!= throws JSL-OK) throws
                          (let [heap (jsl-check-heap-shape)]
                            (fmt (stderr) "AOTK_TIMING phase=jsl_graph ns={d}\n" (- t1 t0))
                            (fmt (stderr) "AOTK_TIMING phase=jsl_cycles ns={d}\n" (- t2 t1))
                            (fmt (stderr) "AOTK_TIMING phase=jsl_memuse ns={d}\n" (- t3 t2))
                            (fmt (stderr) "AOTK_TIMING phase=jsl_cbuse ns={d}\n" (- t4 t3))
                            (fmt (stderr) "AOTK_TIMING phase=jsl_throwuse ns={d}\n" (- t5 t4))
                            (fmt (stderr) "AOTK_TIMING phase=jsl_heapshape ns={d}\n"
                                 (- (jsl-profile-now) t5))
                            heap))))))))))))

; ============================================================================
; The reader
; ============================================================================
(defn jsl-bool-of [(x (ptr rd/Sexp)) (out (ptr bool))] (-> bool)
  (if (not (rd/sexp-sym? x)) false
    (let [s (rd/sexp-sym x)]
      (if (= s "true")  (do (set! out true) true)
        (if (= s "false") (do (set! out false) true)
          false)))))

;; `:params [(name type) ...]`. A VECTOR of pairs. `coil.reader` distinguishes `KVec` from `KList`,
;; so the surface has one spelling and the parenthesised form is a named refusal rather than a
;; second accepted syntax.
(defn jsl-read-params! [(x (ptr rd/Sexp)) (name (slice u8)) (kind i64)
                        (out (ptr i64)) (lowered-out (ptr i64))] (-> i64)
  (jsl-at! x)
  (block :done
    ; A VECTOR, not a list. `coil.reader` distinguishes them, so `:params ((x dyn))` is refused
    ; rather than silently accepted — the surface is one spelling, and it is the Coil-idiomatic one.
    (if (not (rd/sexp-vec? x)) (return-from :done (jsl-fail! JSL-ERR-BAD-PARAMS name)) 0)
    (let [n (rd/sexp-count x)]
      (if (> n JSL-MAX-PARAMS) (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS name)) 0)
      (let [(mut i) 0 (mut lowered) 0 (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (let [pr (rd/sexp-nth x (load i))]
                      (if (or (not (rd/sexp-list? pr)) (!= (rd/sexp-count pr) 2))
                          (store! err (jsl-fail! JSL-ERR-BAD-PARAMS name))
                          (if (not (rd/sexp-sym? (rd/sexp-nth pr 0)))
                              (store! err (jsl-fail! JSL-ERR-BAD-PARAMS name))
                              (let [typeform (rd/sexp-nth pr 1)
                                    rest (and (rd/sexp-list? typeform)
                                              (and (= (rd/sexp-count typeform) 2)
                                                   (and (rd/sexp-sym? (rd/sexp-nth typeform 0))
                                                        (= (rd/sexp-sym (rd/sexp-nth typeform 0))
                                                           "rest"))))
                                    slotlist (jsl-slot-list-type? typeform)
                                    t (if rest (jsl-type-of (rd/sexp-nth typeform 1))
                                          (if slotlist TY-NO-ID (jsl-type-of typeform)))
                                    record (if rest -1 (jsl-record-type-of typeform))]
                                (if (and (= t TY-NO-ID) (and (< record 0) (not slotlist)))
                                    (store! err (jsl-fail! JSL-ERR-BAD-TYPE
                                                           (rd/sexp-sym (rd/sexp-nth pr 0))))
                                    (if (and slotlist (!= kind JSL-KIND-MACRO))
                                        (store! err (jsl-fail! JSL-ERR-SLOT-LIST-ESCAPE name))
                                    (if (and (>= record 0) (= kind JSL-KIND-CALLABLE))
                                        (store! err (jsl-fail! JSL-ERR-RECORD-ESCAPE name))
                                    (if (and rest
                                             (or (!= kind JSL-KIND-MACRO)
                                                 (!= (load i) (- n 1))))
                                        (store! err (jsl-fail! JSL-ERR-BAD-REST name))
                                        (let [(mut p) (zeroed JslParam)]
                                          (store! (field p name)
                                                  (rd/sexp-sym (rd/sexp-nth pr 0)))
                                          (store! (field p ty) t)
                                          (store! (field p record) record)
                                          (store! (field p slotlist) slotlist)
                                          (store! (field p rest) rest)
                                          (store! (field p lowered-off) (load lowered))
                                          (store! (field p lowered-width)
                                                  (if slotlist 0
                                                    (if (>= record 0)
                                                        (jsl-record-flat-width record) 1)))
                                          (store! lowered
                                                  (+ (load lowered)
                                                     (load (field p lowered-width))))
                                          (al-push! [JslParam] (field (jsl) params) (load p))
                                          0)))))))))
                    (store! i (+ (load i) 1)))))
        (store! out n)
        (store! lowered-out (load lowered))
        (load err)))))

(defn jsl-read-captures! [(x (ptr rd/Sexp)) (name (slice u8)) (out (ptr i64))] (-> i64)
  (block :done
    (if (not (rd/sexp-vec? x)) (return-from :done (jsl-fail! JSL-ERR-BAD-PARAMS name)) 0)
    (let [n (rd/sexp-count x) (mut i) 0]
      (if (> n 4) (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-PARAMS name)) 0)
      (loop (if (>= (load i) n) (break)
              (let [capture (rd/sexp-nth x (load i))]
                (if (not (rd/sexp-sym? capture))
                    (return-from :done (jsl-fail! JSL-ERR-BAD-PARAMS name)) 0)
                (al-push! [(slice u8)] (field (jsl) captures) (rd/sexp-sym capture))
                (set! i (+ (load i) 1)))))
      (store! out n)
      JSL-OK)))

;; `(record Name [(field type) ...])` declares a compiler-only specification Record schema.
;; It has no body and publishes no callable. Fields are positional only inside the compiler;
;; source construction and access are always by name so schema edits cannot silently reorder data.
(defn jsl-read-record! [(form (ptr rd/Sexp))] (-> i64)
  (block :done
    (if (!= (rd/sexp-count form) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD "record")) 0)
    (let [nameform (rd/sexp-nth form 1) fields (rd/sexp-nth form 2)]
      (if (not (rd/sexp-sym? nameform))
          (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "record")) 0)
      (let [name (rd/sexp-sym nameform)]
        (if (>= (jsl-record-find name) 0)
            (return-from :done (jsl-fail! JSL-ERR-DUP-RECORD name)) 0)
        (if (not (rd/sexp-vec? fields))
            (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
        (let [off (al-len [JslRecordField] (.recordfields (jsl)))
              flat-off (al-len [i64] (.recordflattypes (jsl)))
              n (rd/sexp-count fields)
              (mut i) 0]
          (if (= n 0)
              (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name))
              0)
          (loop
            (if (>= (load i) n) (break)
              (let [f (rd/sexp-nth fields (load i))]
                (if (or (not (rd/sexp-list? f)) (!= (rd/sexp-count f) 2))
                    (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
                (let [fname (rd/sexp-nth f 0) tyform (rd/sexp-nth f 1)]
                  (if (not (rd/sexp-sym? fname))
                      (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name)) 0)
                  (let [fieldname (rd/sexp-sym fname) (mut k) 0]
                    (loop
                      (if (>= (load k) (load i)) (break)
                        (do
                          (if (= fieldname (.name (al-elem [JslRecordField]
                                                   (field (jsl) recordfields)
                                                   (+ off (load k)))))
                              (return-from :done
                                (jsl-fail! JSL-ERR-BAD-RECORD-FIELD fieldname)) 0)
                          (set! k (+ (load k) 1)))))
                    (let [ty (jsl-type-of tyform)
                          nested (jsl-record-type-of tyform)]
                      (if (and (= ty TY-NO-ID) (< nested 0))
                          (return-from :done (jsl-fail! JSL-ERR-BAD-TYPE fieldname)) 0)
                      (let [(mut rf) (zeroed JslRecordField)]
                        (store! (field rf name) fieldname)
                        (store! (field rf ty) ty)
                        (store! (field rf record) nested)
                        (store! (field rf flat-off)
                                (- (al-len [i64] (.recordflattypes (jsl))) flat-off))
                        (store! (field rf flat-width)
                                (if (>= nested 0) (jsl-record-flat-width nested) 1))
                        (if (>= nested 0)
                            (let [(mut leaf) 0]
                              (loop (if (>= (load leaf) (jsl-record-flat-width nested))
                                        (break)
                                        (do
                                          (al-push! [i64] (field (jsl) recordflattypes)
                                                    (jsl-record-flat-field-ty nested (load leaf)))
                                          (set! leaf (+ (load leaf) 1))))))
                            (al-push! [i64] (field (jsl) recordflattypes) ty))
                        (if (> (- (al-len [i64] (.recordflattypes (jsl))) flat-off)
                               JSL-MAX-RECORD-LEAVES)
                            (return-from :done (jsl-fail! JSL-ERR-BAD-RECORD name))
                            0)
                        (al-push! [JslRecordField] (field (jsl) recordfields) (load rf))))))
                (set! i (+ (load i) 1)))))
          (let [(mut r) (zeroed JslRecordDecl)]
            (store! (field r name) name)
            (store! (field r fields-off) off)
            (store! (field r nfields) n)
            (store! (field r flat-off) flat-off)
            (store! (field r flat-width)
                    (- (al-len [i64] (.recordflattypes (jsl))) flat-off))
            (al-push! [JslRecordDecl] (field (jsl) records) (load r))
            JSL-OK))))))

;; `(internal-slot Name storage-kind)` declares a globally named runtime storage capability. IDs
;; are declaration-order products generated from the manifest; handwritten JSL uses names only.
(defn jsl-read-method-family! [(form (ptr rd/Sexp))] (-> i64)
  (block :done
    (if (!= (rd/sexp-count form) 2)
        (return-from :done (jsl-fail! JSL-ERR-BAD-METHOD-FAMILY
                                      "internal-method-family")) 0)
    (let [nameform (rd/sexp-nth form 1)]
      (if (not (rd/sexp-sym? nameform))
          (return-from :done (jsl-fail! JSL-ERR-BAD-METHOD-FAMILY
                                        "internal-method-family")) 0)
      (let [name (rd/sexp-sym nameform)]
        (if (or (>= (jsl-method-family-find name) 0)
                (or (>= (jsl-internal-slot-find name) 0)
                    (or (>= (jsl-slot-list-find name) 0)
                        (or (>= (jsl-record-find name) 0) (>= (jsl-find name) 0)))))
            (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
        (let [(mut declaration) (zeroed JslMethodFamilyDecl)]
          (store! (field declaration name) name)
          (al-push! [JslMethodFamilyDecl] (field (jsl) methodfamilies) (load declaration))
          JSL-OK)))))

(defn jsl-read-internal-method! [(form (ptr rd/Sexp))] (-> i64)
  (block :done
    (if (!= (rd/sexp-count form) 2)
        (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-METHOD "internal-method")) 0)
    (let [nameform (rd/sexp-nth form 1)]
      (if (not (rd/sexp-sym? nameform))
          (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-METHOD "internal-method")) 0)
      (let [name (rd/sexp-sym nameform)]
        ;; Internal-method names occupy their own specification namespace. `[[Get]]` and the
        ;; abstract operation `Get` are intentionally allowed to share a spelling.
        (if (>= (jsl-internal-method-find name) 0)
            (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
        (let [(mut declaration) (zeroed JslInternalMethodDecl)]
          (store! (field declaration name) name)
          (al-push! [JslInternalMethodDecl] (field (jsl) internalmethods) (load declaration))
          JSL-OK)))))

(defn jsl-read-internal-slot! [(form (ptr rd/Sexp))] (-> i64)
  (block :done
    (if (!= (rd/sexp-count form) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-SLOT "internal-slot")) 0)
    (let [nameform (rd/sexp-nth form 1) storageform (rd/sexp-nth form 2)]
      (if (or (not (rd/sexp-sym? nameform)) (not (rd/sexp-sym? storageform)))
          (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-SLOT "internal-slot")) 0)
      (let [name (rd/sexp-sym nameform) spelling (rd/sexp-sym storageform)
            storage (if (= spelling "js-value") JSL-SLOT-JS-VALUE
                      (if (= spelling "boolean") JSL-SLOT-BOOLEAN
                        (if (= spelling "spec-list") JSL-SLOT-SPEC-LIST -1)))]
        (if (< storage 0)
            (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-SLOT name)) 0)
        (if (or (>= (jsl-internal-slot-find name) 0)
                (or (>= (jsl-method-family-find name) 0)
                (or (>= (jsl-slot-list-find name) 0)
                    (or (>= (jsl-record-find name) 0) (>= (jsl-find name) 0)))))
            (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
        (let [(mut declaration) (zeroed JslInternalSlotDecl)]
          (store! (field declaration name) name)
          (store! (field declaration storage) storage)
          (al-push! [JslInternalSlotDecl] (field (jsl) internalslots) (load declaration))
          JSL-OK)))))

;; `(slot-list Name [Prototype Extensible ...])` declares one immutable compile-time value. The
;; members are spec internal-slot names; their order is semantic because it becomes layout order.
(defn jsl-read-slot-list! [(form (ptr rd/Sexp))] (-> i64)
  (block :done
    (if (!= (rd/sexp-count form) 3)
        (return-from :done (jsl-fail! JSL-ERR-BAD-SLOT-LIST "slot-list")) 0)
    (let [nameform (rd/sexp-nth form 1) slots (rd/sexp-nth form 2)]
      (if (not (rd/sexp-sym? nameform))
          (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "slot-list")) 0)
      (let [name (rd/sexp-sym nameform)]
        (if (or (>= (jsl-slot-list-find name) 0)
                (or (>= (jsl-method-family-find name) 0)
                    (or (>= (jsl-record-find name) 0) (>= (jsl-find name) 0))))
            (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
        (if (or (not (rd/sexp-vec? slots)) (= (rd/sexp-count slots) 0))
            (return-from :done (jsl-fail! JSL-ERR-BAD-SLOT-LIST name)) 0)
        (let [off (al-len [(slice u8)] (.slotnames (jsl)))
              n (rd/sexp-count slots)
              (mut i) 0]
          (loop (if (>= (load i) n) (break)
                  (let [slot (rd/sexp-nth slots (load i))]
                    (if (not (rd/sexp-sym? slot))
                        (return-from :done (jsl-fail! JSL-ERR-BAD-SLOT-LIST name)) 0)
                    (let [slotname (rd/sexp-sym slot) (mut k) 0]
                      (if (< (jsl-internal-slot-find slotname) 0)
                          (return-from :done (jsl-fail! JSL-ERR-BAD-INTERNAL-SLOT slotname)) 0)
                      (loop (if (>= (load k) (load i)) (break)
                              (do (if (= slotname
                                         (rd/sexp-sym (rd/sexp-nth slots (load k))))
                                      (return-from :done
                                        (jsl-fail! JSL-ERR-BAD-SLOT-LIST slotname)) 0)
                                  (set! k (+ (load k) 1))))))
                    (set! i (+ (load i) 1)))))
          (set! i 0)
          (loop (if (>= (load i) n) (break)
                  (do (al-push! [(slice u8)] (field (jsl) slotnames)
                                (rd/sexp-sym (rd/sexp-nth slots (load i))))
                      (set! i (+ (load i) 1)))))
          (let [(mut declaration) (zeroed JslSlotListDecl)]
            (store! (field declaration name) name)
            (store! (field declaration slots-off) off)
            (store! (field declaration nslots) n)
            (al-push! [JslSlotListDecl] (field (jsl) slotlists) (load declaration))
            JSL-OK))))))

;; `:labels (Name)`. A label may only appear on a `macro`: a label is a control edge into the
;; caller's CFG and a control edge cannot cross a call boundary, so declaring one on a `builtin` is
;; refused rather than ignored.
(defn jsl-read-labels! [(x (ptr rd/Sexp)) (name (slice u8)) (kind i64) (out (ptr (slice u8)))] (-> i64)
  (block :done
    (if (!= kind JSL-KIND-MACRO) (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (if (not (rd/sexp-vec? x)) (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (if (> (rd/sexp-count x) JSL-MAX-LABELS)
        (return-from :done (jsl-fail! JSL-ERR-TOO-MANY-LABELS name)) 0)
    (if (= (rd/sexp-count x) 0) (return-from :done JSL-OK) 0)
    (if (not (rd/sexp-sym? (rd/sexp-nth x 0)))
        (return-from :done (jsl-fail! JSL-ERR-BAD-LABELS name)) 0)
    (store! out (rd/sexp-sym (rd/sexp-nth x 0)))
    JSL-OK))

(defn jsl-read-string! [(x (ptr rd/Sexp)) (name (slice u8)) (out (ptr (slice u8)))] (-> i64)
  (if (rd/sexp-str? x)
      (do (store! out (rd/sexp-str x)) JSL-OK)
      (jsl-fail! JSL-ERR-BAD-SPEC-METADATA name)))

(defn jsl-read-spec-status! [(x (ptr rd/Sexp)) (name (slice u8)) (out (ptr i64))] (-> i64)
  (if (not (rd/sexp-sym? x)) (jsl-fail! JSL-ERR-BAD-SPEC-METADATA name)
    (let [value (rd/sexp-sym x)]
      (if (= value "complete") (do (store! out JSL-SPEC-COMPLETE) JSL-OK)
        (if (= value "partial") (do (store! out JSL-SPEC-PARTIAL) JSL-OK)
          (jsl-fail! JSL-ERR-BAD-SPEC-METADATA name))))))

(defn jsl-spec-claim-exists? [(spec (slice u8))] (-> bool)
  (let [(mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (jsl-decl-count)) (load found)) (break)
            (do (if (= spec (jsl-decl-spec (load i))) (store! found true) 0)
                (set! i (+ (load i) 1)))))
    (load found)))

;; One top-level form. The declaration is assembled in locals and pushed ONLY on success, so a
;; malformed form leaves the table exactly as it found it — a half-built declaration is the state
;; from which a later pass produces a plausible wrong answer.
(defn jsl-read-decl! [(form (ptr rd/Sexp))] (-> i64)
  (jsl-at! form)
  (block :done
    (if (not (rd/sexp-list? form)) (return-from :done (jsl-fail! JSL-ERR-NOT-A-LIST "")) 0)
    (if (< (rd/sexp-count form) 2) (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "")) 0)
    (let [head (rd/sexp-nth form 0)]
      (if (not (rd/sexp-sym? head)) (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM "")) 0)
      (let [kw (rd/sexp-sym head)]
        (if (= kw "record") (return-from :done (jsl-read-record! form)) 0)
        (if (= kw "internal-method-family")
            (return-from :done (jsl-read-method-family! form)) 0)
        (if (= kw "internal-method")
            (return-from :done (jsl-read-internal-method! form)) 0)
        (if (= kw "internal-slot") (return-from :done (jsl-read-internal-slot! form)) 0)
        (if (= kw "slot-list") (return-from :done (jsl-read-slot-list! form)) 0)
        (if (jsl-unsupported-form? kw)
            (return-from :done (jsl-fail! JSL-ERR-UNSUPPORTED kw)) 0)
        (if (or (= kw "builtin") (or (= kw "macro") (= kw "callable"))) 0
            (return-from :done (jsl-fail! JSL-ERR-UNKNOWN-FORM kw))))
      (let [nameform (rd/sexp-nth form 1)]
        (if (not (rd/sexp-sym? nameform)) (return-from :done (jsl-fail! JSL-ERR-BAD-NAME "")) 0)
        (let [name (rd/sexp-sym nameform)]
          (if (or (>= (jsl-find name) 0)
                  (or (>= (jsl-method-family-find name) 0)
                      (or (>= (jsl-record-find name) 0) (>= (jsl-slot-list-find name) 0))))
              (return-from :done (jsl-fail! JSL-ERR-DUP-NAME name)) 0)
          (let [n (rd/sexp-count form)
                kind (let [head-name (rd/sexp-sym (rd/sexp-nth form 0))]
                       (if (= head-name "macro") JSL-KIND-MACRO
                         (if (= head-name "callable") JSL-KIND-CALLABLE
                           JSL-KIND-BUILTIN)))
                params-off (jsl-param-count)
                captures-off (jsl-capture-count)
                (mut nparams) 0
                (mut lowered-nparams) 0
                (mut ncaptures) 0
                (mut ret) TY-NO-ID
                (mut ret-record) -1
                (mut label) ""
                (mut transitioning) false
                (mut cold) false
                (mut spec) ""
                (mut specname) ""
                (mut specstatus) JSL-SPEC-UNSPECIFIED
                (mut specializes) ""
                (mut deviation) ""
                (mut i) 2
                (mut err) JSL-OK]
            ; The keyword prefix. Each key consumes its value, so the first non-keyword ends it.
            (loop (if (or (>= (load i) n) (!= (load err) JSL-OK)) (break)
                    (let [k (rd/sexp-nth form (load i))]
                      (if (not (jsl-keyword? k)) (break)
                        (if (>= (+ (load i) 1) n)
                            (do (store! err (jsl-fail! JSL-ERR-BAD-KEY name)) (break))
                          (let [key (rd/sexp-kw k)
                                v (rd/sexp-nth form (+ (load i) 1))]
                            (if (= key "params")
                                (store! err (jsl-read-params! v name kind (mut nparams)
                                                             (mut lowered-nparams)))
                              (if (= key "captures")
                                (if (= kind JSL-KIND-CALLABLE)
                                    (store! err (jsl-read-captures! v name (mut ncaptures)))
                                    (store! err (jsl-fail! JSL-ERR-BAD-KEY key)))
                              (if (= key "ret")
                                  (let [t (jsl-type-of v) record (jsl-record-type-of v)
                                        slotlist (jsl-slot-list-type? v)]
                                    (if slotlist
                                        (store! err (jsl-fail! JSL-ERR-SLOT-LIST-ESCAPE name))
                                    (if (and (= t TY-NO-ID) (< record 0))
                                        (store! err (jsl-fail! JSL-ERR-BAD-TYPE name))
                                        ;; A RECORD MAY NOT BE RETURNED ACROSS A CALL. It may be
                                        ;; PASSED across one -- `ValidateAndApplyPropertyDescriptor`,
                                        ;; `StringDefineOwnProperty` and `DefinePropertyRecord` are
                                        ;; builtins that take one today -- because an argument is
                                        ;; flattened into the caller's outgoing slots. Coming back
                                        ;; is the direction the result-area ABI does not carry: the
                                        ;; callee has one hidden result pointer and a flat result
                                        ;; vector, and a record's fields are not in it. Retagging
                                        ;; `OrdinaryGetOwnProperty`, `StringGetOwnProperty` or
                                        ;; `CompletePropertyDescriptor` as builtins reached
                                        ;; selection and died there with BER-ENCODING and an
                                        ;; out-of-range machine index rather than a diagnosis. This
                                        ;; is that diagnosis. Lift it by giving the ABI a record
                                        ;; result, not by relaxing the check.
                                        (if (and (>= record 0) (!= kind JSL-KIND-MACRO))
                                            (store! err (jsl-fail! JSL-ERR-RECORD-ESCAPE name))
                                            (do (store! ret t) (store! ret-record record) 0))))
                                    0)
                                (if (= key "transitioning")
                                    (if (jsl-bool-of v (mut transitioning)) 0
                                        (store! err (jsl-fail! JSL-ERR-BAD-BOOL name)))
                                  (if (= key "cold")
                                      (if (jsl-bool-of v (mut cold)) 0
                                          (store! err (jsl-fail! JSL-ERR-BAD-BOOL name)))
                                    (if (= key "labels")
                                        (store! err (jsl-read-labels! v name kind (mut label)))
                                      (if (= key "spec")
                                          (store! err (jsl-read-string! v name (mut spec)))
                                        (if (= key "spec-name")
                                            (store! err (jsl-read-string! v name (mut specname)))
                                          (if (= key "status")
                                              (store! err (jsl-read-spec-status! v name (mut specstatus)))
                                            (if (= key "specializes")
                                                (store! err (jsl-read-string! v name (mut specializes)))
                                              (if (= key "deviation")
                                                  (store! err (jsl-read-string! v name (mut deviation)))
                                                (store! err (jsl-fail! JSL-ERR-BAD-KEY key)))))))))))))
                            (store! i (+ (load i) 2))
                            0))))))
            (if (!= (load err) JSL-OK) (return-from :done (load err)) 0)
            (let [has-spec (> (slice-len (load spec)) 0)
                  has-name (> (slice-len (load specname)) 0)
                  has-specializes (> (slice-len (load specializes)) 0)
                  has-deviation (> (slice-len (load deviation)) 0)]
              (if (or (!= has-spec has-name)
                      (or (!= has-spec (!= (load specstatus) JSL-SPEC-UNSPECIFIED))
                          (or (and has-spec has-specializes)
                              (or (and (= (load specstatus) JSL-SPEC-COMPLETE) has-deviation)
                                  (or (and (= (load specstatus) JSL-SPEC-PARTIAL) (not has-deviation))
                                      (!= has-specializes (and (not has-spec) has-deviation)))))))
                  (return-from :done (jsl-fail! JSL-ERR-BAD-SPEC-METADATA name)) 0)
              (if (and has-spec (jsl-spec-claim-exists? (load spec)))
                  (return-from :done (jsl-fail! JSL-ERR-DUP-SPEC-CLAIM (load spec))) 0))
            ; EXACTLY ONE BODY. Zero is a declaration with nothing to lower; more than one would
            ; need a sequencing rule, and every JSL form is an expression, so there is none.
            (if (!= (- n (load i)) 1) (return-from :done (jsl-fail! JSL-ERR-NO-BODY name)) 0)
            (let [(mut d) (zeroed JslDecl)]
              (store! (field d name)          name)
              (store! (field d kind)          kind)
              (store! (field d label)         (load label))
              (store! (field d spec)          (load spec))
              (store! (field d specname)      (load specname))
              (store! (field d specstatus)    (load specstatus))
              (store! (field d specializes)   (load specializes))
              (store! (field d deviation)     (load deviation))
              (store! (field d signature)
                      (jsl-signature-build! params-off (load nparams)
                                            (load lowered-nparams) (load ret)
                                            (load ret-record)))
              (store! (field (field d signature) transitioning) (load transitioning))
              (store! (field (field d signature) cold)          (load cold))
              (store! (field d captures-off)  captures-off)
              (store! (field d ncaptures)     (load ncaptures))
              (store! (field d body)          (rd/sexp-nth form (load i)))
              (store! (field d fun)           NO-NODE)
              (al-push! [JslDecl] (field (jsl) decls) (load d))
              (if (jsl-signature-valid? (- (jsl-decl-count) 1)) 0
                  (panic-corrupt "jsl: constructed an inconsistent canonical signature"))
              JSL-OK)))))))

;; Read a `.jsl` unit and check it. THE CALLER OWNS `src` AND MUST KEEP IT ALIVE: the reader hands
;; back symbols that are VIEWS into these bytes, and a declaration holds those views rather than
;; copying them. Freeing the source under a loaded table is a use-after-free, so tests pass string
;; literals, which have static storage.
;; Read one unit's declarations into the table WITHOUT checking. Reading and checking are separate
;; because a library spans several files and a body may call a definition in any of them: the whole
;; table has to exist before any name is resolved.
;;
;; THE CALLER OWNS `src` AND MUST KEEP IT ALIVE. `coil.reader` hands back `KSym`/`KStr` payloads that
;; are VIEWS into these bytes, and a declaration holds those views rather than copying them, so
;; freeing the source under a loaded table is a use-after-free. That is why `jsl-read-file!` below
;; leaks its buffer on purpose.
(defn jsl-read! [(raw (slice u8))] (-> i64)
  (jsl-read-source! raw (jsl-source-add! "<string>")))

;; Read one unit under a known source id, so every span the checker reports can be attributed to
;; the file it came from. `coil.reader` stamps the id onto each node, so nothing has to be threaded.
(defn jsl-read-source! [(raw (slice u8)) (source i64)] (-> i64)
  (match (rd/read-all (malloc-allocator) raw source)
    ; The reader's own refusal is kept as a named JSL failure rather than being retold: its Diag
    ; already carries the message and the byte range that noticed. Stamp that range explicitly:
    ; the ordinary cursor still names the last declaration read from the PREVIOUS file when a
    ; whole-file read fails, which otherwise reports a convincing but unrelated source location.
    (Err [d]
      (let [dd d p (jsl)]
        (set! (.cur-src p) (.source dd))
        (set! (.cur-lo p) (.lo dd))
        (set! (.cur-hi p) (.hi dd))
        (jsl-fail! JSL-ERR-PARSE (.msg dd))))
    (Ok [forms]
      (let [items (al-slice [rd/Sexp] (load forms))
            n (slice-len items)
            (mut i) 0
            (mut err) JSL-OK]
        (loop (if (or (>= (load i) n) (!= (load err) JSL-OK))
                  (break)
                  (do
                    (set! err (jsl-read-decl! (index (slice-data items) (load i))))
                    (set! i (+ (load i) 1)))))
        (load err)))))

;; Read one source and check it: the single-unit entry point.
(defn jsl-load! [(src (slice u8))] (-> i64)
  (let [err (jsl-read! src)]
    (if (= err JSL-OK) (jsl-check) err)))

; ============================================================================
; Loading the library off disk
; ============================================================================
;; THE BUFFER IS DELIBERATELY NEVER FREED. Declarations hold `(slice u8)` views into it for the
;; lifetime of the table, so freeing it is a use-after-free rather than tidiness. A `.jsl` library
;; is loaded once per process and lives as long as the compilation does, which bounds the leak by
;; the library's size on disk rather than by anything a compiled program does.
(defn jsl-read-file! [(path (slice u8))] (-> i64)
  (let [r (read-file (malloc-allocator) path)]
    (match r
      (Ok  [src] (jsl-read-source! src (jsl-source-add! path)))
      (Err [e]   (jsl-fail! JSL-ERR-NO-SUCH-FILE path)))))

(defn jsl-index-line-usable? [(s (slice u8))] (-> bool)
  (and (> (slice-len s) 0) (!= (jsl-byte s 0) JSL-CH-HASH)))

;; Trim ASCII whitespace. Written out rather than reached for from a string library because the
;; index is a two-rule format and a general splitter would be more code than the rules.
(defn jsl-trim [(s (slice u8))] (-> (slice u8))
  (let [(mut lo) 0 (mut hi) (slice-len s)]
    (loop (if (or (>= (load lo) (load hi)) (> (jsl-byte s (load lo)) JSL-CH-SPACE)) (break)
            (do (set! lo (+ (load lo) 1)) 0)))
    (loop (if (or (>= (load lo) (load hi)) (> (jsl-byte s (- (load hi) 1)) JSL-CH-SPACE)) (break)
            (do (set! hi (- (load hi) 1)) 0)))
    (subslice s (load lo) (load hi))))

;; Load every unit an index names, then check the whole table once.
;;
;; AN EXPLICIT INDEX RATHER THAN A DIRECTORY SCAN. A scan's order is the filesystem's, and load
;; order is observable: it fixes declaration indices, which are closed-world function indices,
;; which appear in every printed graph and every golden hash. A library that reordered itself when
;; a file was renamed would make a golden diff mean nothing. Paths are used verbatim and are
;; therefore relative to the process working directory, which is the repository root under the gate.
(extern clock_gettime_nsec_np :cc c [i32] (-> i64))
(defn jsl-profile-now [] (-> i64) (clock_gettime_nsec_np (cast i32 4)))

(defn jsl-load-index! [(path (slice u8))] (-> i64)
  (let [r (read-file (malloc-allocator) path)]
    (match r
      (Err [e] (jsl-fail! JSL-ERR-NO-SUCH-FILE path))
      (Ok [src]
        (let [n (slice-len src) (mut at) 0 (mut err) JSL-OK (mut loaded) 0]
          (loop (if (or (>= (load at) n) (!= (load err) JSL-OK)) (break)
                  (let [(mut end) (load at)]
                    (loop (if (or (>= (load end) n) (= (jsl-byte src (load end)) JSL-CH-NEWLINE))
                              (break)
                            (do (set! end (+ (load end) 1)) 0)))
                    (let [line (jsl-trim (subslice src (load at) (load end)))]
                      (if (jsl-index-line-usable? line)
                          (do (set! err (jsl-read-file! line))
                              (set! loaded (+ (load loaded) 1))
                              0)
                          0))
                    (set! at (+ (load end) 1))
                    0)))
          ; AN EMPTY INDEX IS A FAILURE, not an empty library. Every assertion a suite makes over a
          ; loaded library is vacuously true of one that loaded nothing, and a mistyped index path
          ; is exactly how that happens in practice.
          (if (!= (load err) JSL-OK) (load err)
            (if (= (load loaded) 0) (jsl-fail! JSL-ERR-EMPTY-INDEX path)
              ;; Split so a cold compile can say whether reading and parsing the library text or
              ;; checking it is the cost. Together they are the largest single item in a cold
              ;; compile of a small program, and they are identical work for every program.
              (let [check-start (jsl-profile-now)
                    result (jsl-check)]
                (fmt (stderr) "AOTK_TIMING phase=jsl_library_check ns={d}\n"
                     (- (jsl-profile-now) check-start))
                result))))))))
