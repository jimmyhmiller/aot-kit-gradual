;; JavaScript strings stored as UTF-16 code units.  Source text arrives as UTF-8, but every
;; observable JavaScript index and length is defined over UTF-16 units.
;;
;; THIS IS THE COMPILER'S STRING-CONSTANT TABLE, not a JavaScript string runtime. Source text
;; interns here, `ms-select-string-id!` reads the units back out to materialize a constant into
;; machine code, and `jsl_lower` reads names. Every operation ON a JavaScript string belongs to
;; lib/ over the atoms, and is performed by the emitted code at run time — not here.
(module jsstring)

(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "jsvalue" :use *)

(const JSS-NONE i64 -1)
(const JSS-REPLACEMENT i64 65533)

;; `filled` is how many units have been WRITTEN. Every string built by `jss-new-window!`
;; arrives complete; only `jss-alloc!` produces one that is not, and `jss-store-unit!` fills
;; it in ascending order. The native runtime keeps the same counter and refuses both an
;; out-of-order write and a read of a partial string, so the evaluator has to refuse them too
;; or a DSL definition that writes out of order would pass here and produce garbage natively.
(defstruct JsString [(start i64) (length i64)])
(defstruct JsStringHeap
  [(strings (ArrayList JsString))
   (units (ArrayList u16))
   (inited bool)])

(defn jss-heap [] (-> (ptr JsStringHeap))
  (let [heap (alloc/static JsStringHeap)]
    (if (.inited heap)
        0
        (do
          (set! (.inited heap) true)
          (set! (.strings heap) (al-new [JsString] (malloc-allocator)))
          (set! (.units heap) (al-new [u16] (malloc-allocator)))
          0))
    heap))

(defn jss-reset! [] (-> i64)
  (al-clear! [JsString] (field (jss-heap) strings))
  (al-clear! [u16] (field (jss-heap) units))
  0)

(defn jss-record-make [(start i64) (length i64)] (-> JsString)
  (JsString :start start :length length))

(defn jss-valid? [(string i64)] (-> bool)
  (and (>= string 0) (< string (al-len [JsString] (.strings (jss-heap))))))

(defn jss-record [(string i64)] (-> JsString)
  (al-get [JsString] (.strings (jss-heap)) string))

(defn jss-length [(string i64)] (-> i64)
  (if (jss-valid? string)
      (let [record (jss-record string)] (.length record))
      0))

(defn jss-code-unit [(string i64) (index i64)] (-> i64)
  (if (or (not (jss-valid? string)) (or (< index 0) (>= index (jss-length string))))
      -1
      (let [record (jss-record string)]
        (cast i64
              (al-get [u16]
                      (.units (jss-heap))
                      (+ (.start record) index))))))

(defn jss-new-window! [(source (ptr (ArrayList u16))) (start i64) (length i64)] (-> i64)
  (let [heap (jss-heap)
        first (al-len [u16] (.units heap))
        id (al-len [JsString] (.strings heap))
        (mut index) 0]
    (loop (if (>= (load index) length)
              (break)
              (do
                (al-push! [u16] (field heap units) (al-get [u16] (load source) (+ start (load index))))
                (set! index (+ (load index) 1)))))
    (al-push! [JsString] (field heap strings) (jss-record-make first length))
    id))

(defn jss-push-codepoint! [(units (ptr (ArrayList u16))) (point i64)] (-> i64)
  (let [value (if (or (< point 0) (> point 1114111)) JSS-REPLACEMENT point)]
    (if (<= value 65535)
        (al-push! [u16] units (cast u16 value))
        (let [adjusted (- value 65536)]
          (al-push! [u16] units (cast u16 (+ 55296 (>> adjusted 10))))
          (al-push! [u16] units (cast u16 (+ 56320 (& adjusted 1023))))))
    0))

(defn jss-from-utf8! [(text (slice u8))] (-> i64)
  (let [(mut decoded) (al-new [u16] (malloc-allocator))
        (mut index) 0
        length (slice-len text)]
    (loop (if (>= (load index) length)
              (break)
              (let [b0 (cast i64 (slice-get text (load index)))
                    (mut point) JSS-REPLACEMENT
                    (mut width) 1]
                (cond (< b0 128) (store! point b0)
                      (and (>= b0 194) (and (<= b0 223) (< (+ (load index) 1) length)))
                        (let [b1 (cast i64 (slice-get text (+ (load index) 1)))]
                          (if (and (>= b1 128) (<= b1 191))
                              (do (store! point (+ (<< (& b0 31) 6) (& b1 63))) (store! width 2))
                              0))
                      (and (>= b0 224) (and (<= b0 239) (< (+ (load index) 2) length)))
                        (let [b1 (cast i64 (slice-get text (+ (load index) 1)))
                              b2 (cast i64 (slice-get text (+ (load index) 2)))]
                          (if (and (and (>= b1 128) (<= b1 191)) (and (>= b2 128) (<= b2 191)))
                              (let [candidate (+ (<< (& b0 15) 12) (+ (<< (& b1 63) 6) (& b2 63)))]
                                (if (and (>= candidate 2048) (or (< candidate 55296) (> candidate 57343)))
                                    (do (store! point candidate) (store! width 3))
                                    0))
                              0))
                      (and (>= b0 240) (and (<= b0 244) (< (+ (load index) 3) length)))
                        (let [b1 (cast i64 (slice-get text (+ (load index) 1)))
                              b2 (cast i64 (slice-get text (+ (load index) 2)))
                              b3 (cast i64 (slice-get text (+ (load index) 3)))]
                          (if (and (and (>= b1 128) (<= b1 191))
                                   (and (and (>= b2 128) (<= b2 191)) (and (>= b3 128) (<= b3 191))))
                              (let [candidate
                                      (+ (<< (& b0 7) 18)
                                         (+ (<< (& b1 63) 12) (+ (<< (& b2 63) 6) (& b3 63))))]
                                (if (and (>= candidate 65536) (<= candidate 1114111))
                                    (do (store! point candidate) (store! width 4))
                                    0))
                              0))
                      :else 0)
                (jss-push-codepoint! (mut decoded) (load point))
                (set! index (+ (load index) (load width))))))
    (let [result (jss-new-window! (mut decoded) 0 (al-len [u16] (load decoded)))]
      (al-free! [u16] (mut decoded))
      result)))

;; Encode a string for compiler-side tables that still use UTF-8 names. Native PropertyKey storage
;; compares UTF-16 directly; this bridge keeps the ideal evaluator observationally aligned for all
;; Unicode scalar values while the shape table remains byte-backed.
(defn jss-utf8! [(string i64) (out (mut (ArrayList u8)))] (-> (slice u8))
  (al-clear! [u8] (mut out))
  (let [(mut i) 0]
    (loop (if (>= (load i) (jss-length string))
              (break)
              (let [first (jss-code-unit string (load i))
                    (mut point) first
                    (mut width) 1]
                (if (and (>= first 55296)
                         (and (<= first 56319) (< (+ (load i) 1) (jss-length string))))
                    (let [second (jss-code-unit string (+ (load i) 1))]
                      (if (and (>= second 56320) (<= second 57343))
                          (do (set! point
                                    (+ 65536 (+ (<< (- first 55296) 10)
                                                (- second 56320))))
                              (set! width 2))
                          0))
                    0)
                (let [p (load point)]
                  (cond (< p 128) (al-push! [u8] (mut out) (cast u8 p))
                        (< p 2048)
                          (do (al-push! [u8] (mut out) (cast u8 (+ 192 (>> p 6))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& p 63)))))
                        (< p 65536)
                          (do (al-push! [u8] (mut out) (cast u8 (+ 224 (>> p 12))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& (>> p 6) 63))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& p 63)))))
                        :else
                          (do (al-push! [u8] (mut out) (cast u8 (+ 240 (>> p 18))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& (>> p 12) 63))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& (>> p 6) 63))))
                              (al-push! [u8] (mut out) (cast u8 (+ 128 (& p 63)))))))
                (set! i (+ (load i) (load width))))))
    (slice-new [u8] (load (field out data)) (al-len [u8] (load out)))))
