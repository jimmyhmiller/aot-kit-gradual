          (set! (.rpo-seen u) (al-new [i64] (malloc-allocator)))
          (set! (.rpo-post u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-values u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-nodes u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-blocks u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-value-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-node-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-block-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.call-result-snapshots u) (al-new [i64] (malloc-allocator)))
          (set! (.call-result-snapshot-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.block-phi-head u) (al-new [i64] (malloc-allocator)))
          (set! (.node-phi-next u) (al-new [i64] (malloc-allocator)))
          (set! (.packed-insts u) (al-new [MInst] (malloc-allocator)))
          (set! (.selection-memory-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-memory-dep-carriers u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-memory-pending u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-ingress-candidates u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-effect-candidates u) (al-new [i64] (malloc-allocator)))
          (set! (.fn-return-kind-memo u) (al-new [i64] (malloc-allocator)))
          (set! (.fn-fp-return-memo u) (al-new [i64] (malloc-allocator)))
          (set! (.fn-abi-fp-return-memo u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-effect-chain-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-anti-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-read-head u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-read-next u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-owner-read-head u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-owner-read-next u) (al-new [i64] (malloc-allocator)))
          (set! (.call-args u) (al-new [i64] (malloc-allocator)))
          (set! (.call-arg-classes u) (al-new [i64] (malloc-allocator)))
          (set! (.schedule-work u) (al-new [MInst] (malloc-allocator)))
          (set! (.schedule-done u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-new-def u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-def-inst u) (al-new [i64] (malloc-allocator)))
          (set! (.block-code-offset u) (al-new [i64] (malloc-allocator)))
          (set! (.node-inst-head u) (al-new [i64] (malloc-allocator)))
          (set! (.node-inst-next u) (al-new [i64] (malloc-allocator)))
          (set! (.pack-next u) (al-new [i64] (malloc-allocator)))
          (set! (.pack-term-next u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-def-count u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-def-count u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-inst-head u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-inst-next u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-membership u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-order-count u) (al-new [i64] (malloc-allocator)))
