          (set! (.verify-memory-read-head u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-memory-read-next u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-phi-block u) (al-new [i64] (malloc-allocator)))
