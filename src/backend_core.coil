          (set! (.vreg-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-origin-kind u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-definition-kind u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-origin-a u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-origin-b u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-abi-kind u) (al-new [i64] (malloc-allocator)))
