;; M10 arm64 backend: machine IR, scheduling, register allocation, and encoding.
(module backend_core)
(import "coil.primitive" :as primitive)

(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(const MI-MOVI i64 0)
(const MI-ADD i64 1)
(const MI-SUB i64 2)
(const MI-MUL i64 3)
(const MI-SDIV i64 4)
(const MI-NEG i64 5)
(const MI-RET i64 6)
(const MI-ARG i64 7)
(const MI-EQ i64 8)
(const MI-LT i64 9)
(const MI-LE i64 10)
(const MI-LABEL i64 11)
(const MI-CBZ i64 12)
(const MI-CSEL i64 13)
(const MI-RESULT-MATERIALIZE i64 14) ; normal-edge logical value <- raw call snapshot
(const MI-B i64 15)
(const MI-NEW i64 16)
(const MI-LOAD i64 17)
(const MI-STORE i64 18)
(const MI-CBR i64 19)  ; block conditional: a=predicate, b=true block, imm=false block
(const MI-JMP i64 20)  ; block jump: imm=target block
(const MI-COPY i64 21)  ; resolved edge copy: dst <- a
(const MI-CALL i64 22)  ; direct call: dst=result, a=arg0, imm=machine function
(const MI-STACKARG i64 23)  ; callee incoming stack argument, imm=contiguous stack slot
(const MI-ABI-COPY i64 24)  ; early allocatable copy from a fixed ABI ingress vreg
(const MI-JSBOX i64 25)
(const MI-JSUNBOX i64 26)
(const MI-JSTEST i64 27)
(const MI-FMOVI i64 28)  ; exact IEEE bits -> FP vreg
(const MI-SCVTF i64 29)  ; signed i64 -> f64
(const MI-FADD i64 30)
(const MI-FSUB i64 31)
(const MI-FMUL i64 32)
(const MI-FDIV i64 33)
(const MI-FNEG i64 34)
(const MI-FEQ i64 35)  ; FP inputs, boolean GPR output
(const MI-FLT i64 36)
(const MI-FLE i64 37)
(const MI-FTRUTH i64 38)  ; FP Number truthiness -> boolean GPR
(const MI-MOD i64 39)
(const MI-BITAND i64 40)
(const MI-BITOR i64 41)
(const MI-BITXOR i64 42)
(const MI-SHL i64 43)
(const MI-SHR i64 44)
(const MI-USHR i64 45)
(const MI-BITNOT i64 46)
(const MI-I32FROMFP i64 47)  ; JavaScript ToInt32/ToUint32 residue: f64 -> low 32 bits
(const MI-FMOD i64 48)  ; JavaScript Number remainder, including signed zero
(const MI-JSPROP i64 49)  ; external named-property runtime: a=owner, b=value/prototype, imm=operation
(const MI-JSARRAY i64 50)  ; external dense-array runtime: a=owner, b=index, arg0=boxed value, imm=operation
(const MI-JSSTRING i64 51)  ; external immutable UTF-16 runtime: a,b,arg0 plus operation
(const MI-CALL-RESULT i64 52) ; fixed ABI result register after a call; imm=result index
(const MI-OPCODE-COUNT i64 53)
;; One shared bound for the selector's temporary argument vector and the verifier. Calls spill
;; beyond the register prefix, so this is a compiler construction bound, not a register-ABI bound.
(const M-CALL-MAX-ARGS i64 32)
(const JSSOP-NEW i64 0)
(const JSSOP-SET-UNIT i64 1)
(const JSSOP-LENGTH i64 2)
(const JSSOP-EQUAL i64 3)
(const JSSOP-CONCAT i64 4)
(const JSSOP-CHAR-CODE i64 5)
(const JSSOP-SUBSTRING i64 6)
(const JSSOP-FROM-INT i64 10)
(const JSSOP-FROM-BOOL i64 11)
(const JSSOP-FROM-NULL i64 12)
(const JSSOP-FROM-UNDEFINED i64 13)
(const JSSOP-PARSE-INT i64 14)
(const JSSOP-IS-NAN i64 15)
(const JSSOP-SPLIT i64 16)
(const JSSOP-IS-NAN-VALUE i64 17)
(const JSSOP-FROM-CODE-UNIT i64 18)
(const JSSOP-FROM-INT-RADIX i64 19)
(const JSSOP-FROM-DOUBLE-BITS i64 20)
;; 21 and 22 are retired: the ASCII case shift is lib/string/case.jsl over JSSOP 0 and 1.
(const JSSOP-INDEX-OF i64 23)
(const JSSOP-COMPARE i64 24)
(const JSSOP-FROM-VALUE i64 25)
(const JSSOP-VALUE-EQUAL i64 26)
(const JSSOP-VALUE-TRUTHY i64 27)
;; Value-level conversions, dispatched by the runtime before any string record is looked up, the
;; same way STRICT-EQUAL and VALUE-TRUTHY are. They mirror `ev-to-number-value` and `ev-to-integer`.
(const JSSOP-TO-NUMBER i64 28)
(const JSSOP-TO-INTEGER i64 29)
(const JSSOP-PARSE-FLOAT i64 30)
(const JSSOP-NORMALIZE i64 31)
(const JSSOP-TO-FIXED i64 32)
(const JSSOP-BUILTIN-BASE i64 100)

; Stable public result codes. Success is the only state in which generated code or object bytes
; are consumable. Later milestones may replace an unsupported result with success, but must never
; renumber or reuse an existing code.
(const BER-OK i64 0)
(const BER-MALFORMED-GRAPH i64 1)
(const BER-UNSUPPORTED-OPCODE i64 2)
(const BER-UNSUPPORTED-CFG i64 3)
(const BER-UNSUPPORTED-PHI i64 4)
(const BER-UNSUPPORTED-CALL i64 5)
(const BER-UNSUPPORTED-CALL-LIVE i64 6)
(const BER-ALLOCATION i64 7)
(const BER-ENCODING i64 8)
(const BER-OBJECT i64 9)

; Machine-CFG verifier results are stable for the same reason as backend phase results: focused
; corruption fixtures must name the broken law instead of collapsing to a generic false.
(const MCFG-OK i64 0)
(const MCFG-OWNER i64 1)
(const MCFG-RECIPROCITY i64 2)
(const MCFG-PREDECESSOR-SLOT i64 3)
(const MCFG-TERMINATOR-ARITY i64 4)
(const MCFG-RPO i64 5)
(const MCFG-FUNCTION-ISOLATION i64 6)
(const MCFG-IDOM i64 7)

(const MSEL-OK i64 0)
(const MSEL-OWNER i64 1)
(const MSEL-DUPLICATE i64 2)
(const MSEL-DEPENDENCY i64 3)
(const MSEL-TERMINATOR i64 4)
(const MSEL-UNSUPPORTED i64 5)
(const MSEL-PHI i64 6)
(const MSEL-CALL i64 7)
(const MSEL-CALL-LIVE i64 8)
(const MSEL-PLACEMENT i64 9)
(const MSEL-MEMORY-ORDER i64 10)

(const MABI-OK i64 0)
(const MABI-FRAME i64 1)
(const MABI-SPILL i64 2)
(const MABI-ARGUMENT i64 3)

(const MSCHED-OK i64 0)
(const MSCHED-CYCLE i64 1)
(const MSCHED-DEPENDENCY i64 2)
(const MSCHED-MEMORY i64 3)
(const MSCHED-EXACTLY-ONCE i64 4)
(const MSCHED-BOUNDARY i64 5)
(const MSCHED-CALL-BUNDLE i64 6)

(const MLIVE-OK i64 0)
(const MLIVE-RANGE i64 1)
(const MLIVE-FIXPOINT i64 2)
(const MLIVE-PHI i64 3)
(const MLIVE-KIND i64 4)
(const MLIVE-SAFEPOINT i64 5)
(const MLIVE-CLASS i64 6)

(const MLK-SCALAR i64 0)
(const MLK-RAW-MANAGED i64 1)
(const MLK-BOXED i64 2)
(const MLK-NONMOVING i64 3)
(const MV-ORIGIN-UNKNOWN i64 0)
(const MV-ORIGIN-IDEAL i64 1)
(const MV-ORIGIN-PHI i64 2)
(const MV-ORIGIN-CALL-RESULT i64 3)
(const MV-ORIGIN-COPY i64 4)
(const MV-ORIGIN-ABI i64 5)
(const MV-ORIGIN-TEMPORARY i64 6)
(const MV-DEF-INSTRUCTION i64 0)
(const MV-DEF-PHI i64 1)
(const MV-DEF-CALL-RESULT i64 2)
(const MV-DEF-COPY i64 3)
(const MV-DEF-ABI i64 4)
(const MV-DEF-TEMPORARY i64 5)
(const MV-ABI-NONE i64 0)
(const MV-ABI-ARGUMENT i64 1)
(const MV-ABI-PARAMETER i64 2)
(const MV-ABI-CALL-RESULT i64 3)
(const MV-STATE-RESERVED i64 0)
(const MV-STATE-DEFINED i64 1)
(const JSV-RAW-NULLABLE-OBJECT i64 -2)

;; Register classes are independent of GC kinds: an f64 is a scalar for stack-map purposes but
;; cannot share a physical register or an interference color with an integer scalar.
(const MRC-GPR i64 0)
(const MRC-FPR i64 1)
(const MV-KIND-MASK-ALL i64 15)
(const MV-CLASS-MASK-ALL i64 3)

(const MRA-OK i64 0)
(const MRA-INTERFERENCE i64 1)
(const MRA-FIXED i64 2)
(const MRA-LOCATION i64 3)
(const MRA-SPILL-KIND i64 4)
(const MRA-COALESCE i64 5)

(const MOBJ-OK i64 0)
(const MOBJ-HEADER i64 1)
(const MOBJ-FUNCTION-RANGE i64 2)
(const MOBJ-SYMBOL i64 3)
(const MOBJ-RELOCATION i64 4)
(const MOBJ-STACKMAP i64 5)
(const MOBJ-LAYOUT i64 6)
(const MOBJ-ATOMIC i64 7)

(defstruct MInst
  [(op i64)
   (dst i64)
   (a i64)
   (b i64)
   (imm i64)
   (node i64)
   ;; Immutable selection-time call-target contract. For MI-CALL this is the exact encoded direct
   ;; owner or complemented polymorphic summary; object publication verifies `imm` against it
   ;; without traversing the ideal graph again. Non-calls carry -1.
   (call-contract i64)
   (owner i64)
   (block-id i64)
   (mem-first i64)
   (mem-count i64)
   (anti-first i64)
   (anti-count i64)
   (arg-first i64)
   (arg-count i64)
   (reg i64)
   (spill i64)
   (first i64)
   (last i64)
   (earliest i64)
   (latest i64)
   (schedule-order i64)])

(defstruct MOpcodeDesc
  [(inputs i64)
   (outputs i64)
   (temporaries i64)
   (clobbers i64)
   (effects i64)
   (pinned bool)
   (memory bool)
   (terminator bool)
   (encodable bool)
   ;; Allowed destination MachineValue contracts. Zero means the opcode has no result. These
   ;; masks are part of the opcode descriptor, not inferred from an ideal node after selection.
   (result-kind-mask i64)
   (result-class-mask i64)])

; These records intentionally use indexes into unit-owned tables. Stable indexes survive later
; edge splitting and avoid pointers becoming stale when an ArrayList grows.
(defstruct MFunction
  [(id i64)
   (ideal i64)
   (entry i64)
   (imported bool)
   (block-first i64)
   (block-count i64)
   (return-first i64)
   (return-count i64)
   (result-area-size i64)
   (result-pointer-offset i64)
   (outgoing-result-pointer-offset i64)
   (frame-size i64)
   (callee-mask i64)
   (callee-count i64)
   (code-start i64)
   (code-size i64)])

(defstruct MBlock
  [(id i64)
   (owner i64)
   (ideal-ctrl i64)
   (pred-first i64)
   (pred-count i64)
   (succ-first i64)
   (succ-count i64)
   (inst-first i64)
   (inst-count i64)
   (loop-depth i64)
   (layout-index i64)])

(defstruct MEdge
  [(id i64)
   (owner i64)
   (source i64)
   (target i64)
   (target-slot i64)
   (copy-first i64)
   (copy-count i64)
   (move-first i64)
   (move-count i64)])

(const MCOPY-VALUE i64 0)
(const MCOPY-MEMORY i64 1)

; Phi transport belongs to an incoming edge, not to either endpoint block.  Keeping the ideal
; Phi and its selected source in the record makes target-slot mistakes independently verifiable.
(defstruct MCopy
  [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)])

(defstruct MMove
  [(edge i64) (dst i64) (src i64) (temporary bool)])

(const MLOC-REGISTER i64 0)
(const MLOC-SPILL i64 1)
(const MLOC-SCRATCH i64 2)
(const MLOC-RESULT-AREA i64 3)

(defstruct MLocation [(kind i64) (class i64) (index i64)])
(defstruct MParallelMove
  [(owner i64) (inst i64)
   (dst-kind i64) (dst-class i64) (dst-index i64)
   (src-kind i64) (src-class i64) (src-index i64)
   (temporary bool)])

;; One machine call owns its complete lowered result capture. Instruction indexes are rebuilt
;; whenever scheduling republishes the instruction stream; consumers never rediscover a bundle by
;; scanning for adjacent MI-CALL-RESULT instructions.
(defstruct MCallBundle
  [(owner i64) (block-id i64) (call-inst i64) (anchor i64)
   (capture-first i64) (capture-count i64) (release-after i64)
   (result-count i64) (result-area-size i64) (can-throw bool)])

(defstruct MachineUnit
  [(functions (ArrayList MFunction))
   (blocks (ArrayList MBlock))
   (edges (ArrayList MEdge))
   ;; Temporary source-block adjacency used while constructing the CFG. Final packed adjacency is
   ;; built later; these lists keep duplicate-edge detection proportional to a block's outdegree.
   (build-edge-head (ArrayList i64))
   (build-edge-next (ArrayList i64))
   (returns (ArrayList i64))
   (pred-edges (ArrayList i64))
   (succ-edges (ArrayList i64))
   (edge-copies (ArrayList MCopy))
   (edge-moves (ArrayList MMove))
   ;; Post-allocation ABI parallel moves. Per-instruction ranges name resolved, sequential moves;
   ;; call-result groups publish their entire range on the first capture instruction.
   (abi-moves (ArrayList MParallelMove))
   (abi-move-first (ArrayList i64))
   (abi-move-count (ArrayList i64))
   (abi-work-dst (ArrayList MLocation))
   (abi-work-src (ArrayList MLocation))
   (abi-work-live (ArrayList i64))
   (copy-work-dst (ArrayList i64))
   (copy-work-src (ArrayList i64))
   (copy-work-live (ArrayList i64))
   (symbols (ArrayList i64))
   (identity-kinds (ArrayList i64))
   (identity-units (ArrayList i64))
   (identity-locals (ArrayList i64))
   (runtime-deps (ArrayList i64))
   ;; Direct internal calls are encoded immediately for ordinary publication, but their semantic
   ;; relocation survives as (source owner, absolute code offset, target function owner). Reusable
   ;; function-text assembly can therefore make the offset source-relative and repatch BL without
   ;; rediscovering machine IR or scanning function ranges.
   (internal-call-sources (ArrayList i64))
   (internal-call-offsets (ArrayList i64))
   (internal-call-targets (ArrayList i64))
   ;; Polymorphic dispatch materializes a target function address as ADR + fixed-width delta + ADD.
   ;; It is relocatable, but not a call instruction, so retain it as a separate relocation kind.
   (internal-address-sources (ArrayList i64))
   (internal-address-offsets (ArrayList i64))
   (internal-address-targets (ArrayList i64))
   ;; Live ideal Call nodes in node order. CFG reachability recursively discovers functions in
   ;; call order; keeping that order in a compact list avoids rescanning every ideal node for each
   ;; discovered function.
   (ideal-calls (ArrayList i64))
   (ideal-function-owner (ArrayList i64))
   (ctrl-block (ArrayList i64))
   (block-terminator (ArrayList i64))
   (block-order (ArrayList i64))
   (block-idom (ArrayList i64))
   (rpo-seen (ArrayList i64))
   (rpo-post (ArrayList i64))
   (selected-values (ArrayList i64))
   (selected-nodes (ArrayList i64))
   (selected-blocks (ArrayList i64))
   ;; Selection runs owners sequentially, so one node-indexed memo plus an owner tag preserves
   ;; isolation without allocating function-count * graph-node-count slots.
   (selected-value-owners (ArrayList i64))
   (selected-node-owners (ArrayList i64))
   (selected-block-owners (ArrayList i64))
   ;; Raw ABI result snapshots are distinct from logical selected values. They are captured in the
   ;; call bundle and may only feed a normal-edge materialization (or explicit outcome inspection).
   (call-result-snapshots (ArrayList i64))
   (call-result-snapshot-owners (ArrayList i64))
   ;; Live Phi nodes grouped by target block in ideal-node order. Selection consumes this index
   ;; for reservation and edge copies instead of scanning the whole ideal graph per function/edge.
   (block-phi-head (ArrayList i64))
   (node-phi-next (ArrayList i64))
   (packed-insts (ArrayList MInst))
   (selection-memory-deps (ArrayList i64))
   ;; Parallel to selection-memory-deps: NO-NODE for a direct dependency, or the control-bearing
   ;; Effect whose ordering value is conditional on that Effect's path.
   (selection-memory-dep-carriers (ArrayList i64))
   (selection-memory-pending (ArrayList i64))
   ;; One-time candidate indexes for selection roots. The old selector rediscovered these by
   ;; scanning every ideal node twice for every function.
   (selection-ingress-candidates (ArrayList i64))
   (selection-effect-candidates (ArrayList i64))
   ;; PER-FUNCTION ANSWERS THAT WERE RECOMPUTED PER QUERY.
   ;;
   ;; be-function-return-kind and ms-function-fp-return? each scan every one of a function's
   ;; returns, and selection asks them at every call site. With F functions and a call site per
   ;; function that is O(F x returns) -- selection is quadratic in the function count, 400 trivial
   ;; functions spend 6 s in it, and lodash core.js never finishes. Both are functions of the CFG
   ;; and the ideal graph's Return nodes, neither of which selection mutates, so one answer per
   ;; owner is the same answer. -2 means "not yet asked".
   (fn-return-kind-memo (ArrayList i64))
   (fn-fp-return-memo (ArrayList i64))
   (fn-abi-fp-return-memo (ArrayList i64))
   ;; The memory-chain owner of each effect candidate, computed ONCE.
   ;;
   ;; ms-preselect-function! runs per function over the WHOLE candidate list, and for each entry it
   ;; called ms-memory-chain-owner -- a walk up the memory chain that does not depend on which
   ;; function is asking -- and ms-memory-block. That is O(functions x candidates) and it is why
   ;; selection is quadratic in the function count: 400 trivial functions spend 3.5 s in
   ;; preselection alone, and lodash core.js never finishes at all. Recording the answer once lets
   ;; a foreign candidate be skipped on an integer compare, in the same list and the same order.
   (selection-effect-chain-owner (ArrayList i64))
   (memory-anti-deps (ArrayList i64))
   (memory-read-head (ArrayList i64))
   (memory-read-next (ArrayList i64))
   (memory-owner-read-head (ArrayList i64))
   (memory-owner-read-next (ArrayList i64))
   (call-args (ArrayList i64))
   ;; The callee declaration owns argument placement. This is deliberately separate from the
   ;; source vreg's register class: representation refinement may produce (for example) an FPR
   ;; value for a declared dyn/GPR parameter, and that refinement must not rewrite the call ABI.
   (call-arg-classes (ArrayList i64))
   (schedule-work (ArrayList MInst))
   (schedule-done (ArrayList i64))
   (vreg-new-def (ArrayList i64))
   ;; Dense vreg -> defining instruction index. Rebuilt whenever instruction packing changes so
   ;; placement, scheduling, and verification never recover a definition by scanning the unit.
   (vreg-def-inst (ArrayList i64))
   ;; Dense block id -> final encoded byte offset, published by the sizing pass.
   (block-code-offset (ArrayList i64))
   (node-inst-head (ArrayList i64))
   (node-inst-next (ArrayList i64))
   (pack-next (ArrayList i64))
   (pack-term-next (ArrayList i64))
   (verify-def-count (ArrayList i64))
   (verify-node-def-count (ArrayList i64))
   ;; Independently rebuilt node -> scheduled instruction lists. The selector's node-inst index
   ;; describes its pre-schedule packing and must not be trusted after instructions move.
   (verify-node-inst-head (ArrayList i64))
   (verify-node-inst-next (ArrayList i64))
   (verify-membership (ArrayList i64))
   (verify-order-count (ArrayList i64))
   ;; Independently derived verifier view of live Phis by target block. This intentionally does
   ;; not reuse selection's block-phi index, so verification still catches selector omissions.
   (verify-block-phi-head (ArrayList i64))
   (verify-node-phi-next (ArrayList i64))
   ;; Independent memory-read index for anti-dependency verification. Keeping verifier-owned
   ;; lists avoids trusting the selector's production index without rescanning every instruction
   ;; for every write.
   (verify-memory-read-head (ArrayList i64))
   (verify-memory-read-next (ArrayList i64))
   ;; vreg -> target block for Phi definitions, or -1 for ordinary instruction definitions.
   ;; GCM queries this for nearly every operand; deriving it by rescanning all edge-copy tables
   ;; makes large Phi-heavy programs quadratic.
   (vreg-phi-block (ArrayList i64))
   ;; vreg -> (defining node, owner): the reverse of selected-values. ml-kind-for-vreg answered
   ;; "which node produced this vreg" by scanning every function x every node per query, which
   ;; made kind classification quadratic on large programs. -1 when no node claimed the vreg.
   (vreg-node (ArrayList i64))
   (vreg-node-owner (ArrayList i64))
   ;; Authoritative MachineValue row columns. These are populated at construction/finalization,
   ;; before scheduling or liveness, and are never reconstructed by a later phase.
   (vreg-owner (ArrayList i64))
   (vreg-origin-kind (ArrayList i64))
   ;; Closed provenance and ABI contract. `origin-a/b` are interpreted by definition kind:
   ;; ideal node, phi block, source vreg, or call/slot. Later phases never rediscover these.
   (vreg-definition-kind (ArrayList i64))
   (vreg-origin-a (ArrayList i64))
   (vreg-origin-b (ArrayList i64))
   (vreg-abi-kind (ArrayList i64))
   (vreg-abi-index (ArrayList i64))
   (vreg-state (ArrayList i64))
   ;; vreg -> linked list of its uses, rebuilt at the start of each pass that asks
   ;; ms-gcm-latest-use-block. An entry is an instruction index, or -(block+2) for a logical use
   ;; qualified to a block (Phi edge copies and control-bearing Effect values). Deriving this by
   ;; rescanning every instruction and every edge
   ;; PER DEFINITION made GCM placement and verification quadratic in program size.
   (vreg-use-head (ArrayList i64))
   (vreg-use-entry (ArrayList i64))
   (vreg-use-next (ArrayList i64))
   ;; Block-local scheduler dependency edges (producer -> consumers), recorded while the
   ;; indegree pass runs its pair loop so each emission decrements along the producer's edge
   ;; list instead of re-asking ms-schedule-dependency-kind for every consumer in the block.
   (sched-edge-head (ArrayList i64))
   (sched-edge-consumer (ArrayList i64))
   (sched-edge-next (ArrayList i64))
   (sched-ready (ArrayList i64))
   ;; Liveness rows contain only the vregs owned by their function. Global-vreg dense rows made
   ;; every function pay for every other function's values (blocks * all-unit-vregs).
   (live-vreg-owner (ArrayList i64))
   (live-vreg-local (ArrayList i64))
   (live-owner-first (ArrayList i64))
   (live-owner-count (ArrayList i64))
   (live-owner-words (ArrayList i64))
   (live-owner-vregs (ArrayList i64))
   ;; LIVENESS SETS ARE SPARSE, AS A CHUNK LIST PER SET.
   ;;
   ;; They used to be one dense bit matrix per set kind: `blocks x ceil(owner_vregs/64)` words, for
   ;; use, def, in and out, plus the same shape over edges. One 253-line Test262 file made that
   ;; 2.3 BILLION words -- 18.6 GB in a single matrix, and the same count again as the walk cost of
   ;; every phase that reads it: the solver, interval construction and GC-root discovery alike.
   ;; Under 2% of those words were ever non-zero.
   ;;
   ;; A set is now a singly-linked list of (word, bits) chunks held in ascending word order in one
   ;; shared arena. `live-set-head` indexes it: `kind * blocks + bid` for the four block sets and
   ;; `4 * blocks + edge` for an edge set. Cost becomes proportional to what is actually live.
   ;;
   ;; The arena is APPEND-ONLY and that is sound rather than lazy: `out` grows monotonically from
   ;; successors and `in = use u (out - def)` grows with it, so a chunk is never removed during the
   ;; fixed point. Only whole-unit reset frees anything.
   (live-set-head (ArrayList i64))
   (live-chunk-word (ArrayList i64))
   (live-chunk-bits (ArrayList i64))
   (live-chunk-next (ArrayList i64))
   ;; One-entry resume cursor for ml-set-word, so an ascending word scan over a set is O(1) per
   ;; step. Invalidated by any write, since a splice can insert ahead of the remembered chunk.
   (live-cursor-set i64)
   (live-cursor-chunk i64)
   (value-kind (ArrayList i64))
   (register-class (ArrayList i64))
   ;; Node -> generation stamp, and the walk stack, for `be-node-fp-value?`. The question is
   ;; "does a floating-point value reach this node", which is reachability over the whole
   ;; expression, so it is answered by a marked walk rather than a depth-limited recursion.
   (fp-mark (ArrayList i64))
   (fp-stack (ArrayList i64))
   (fp-known (ArrayList bool))
   (fp-value (ArrayList bool))
   ;; Selection ABI ordinals are graph invariants. Cache them by ideal node rather than recovering
   ;; each one with another prefix/full-graph scan while recursively selecting values.
   (arg-abi-index (ArrayList i64))
   (parm-abi-index (ArrayList i64))
   (parm-stack-index (ArrayList i64))
   (new-index (ArrayList i64))
   (kind-known (ArrayList bool))
   (kind-value (ArrayList i64))
   (alloc-live (ArrayList i64))
   (alloc-live-list (ArrayList i64))
   (alloc-live-pos (ArrayList i64))
   (alloc-owner-head (ArrayList i64))
   (alloc-owner-next (ArrayList i64))
   (alloc-copy-peer (ArrayList i64))
   (alloc-reg (ArrayList i64))
   (alloc-spill (ArrayList i64))
   (alloc-owner (ArrayList i64))
   (alloc-forbidden (ArrayList i64))
   (alloc-spill-kind (ArrayList i64))
   ;; Frozen linear-scan product. Intervals are keyed by MachineValue id; event heads are keyed by
   ;; final instruction position. Allocation consumes these directly and never materializes the
   ;; pairwise interference graph implied by overlapping intervals.
   (alloc-interval-start (ArrayList i64))
   (alloc-interval-end (ArrayList i64))
   (alloc-start-head (ArrayList i64))
   (alloc-start-next (ArrayList i64))
   (alloc-end-head (ArrayList i64))
   (alloc-end-next (ArrayList i64))
   ;; OR segment trees over final instruction positions. One publishes call-clobber masks; the
   ;; other publishes fixed ABI definitions. Interval allocation answers each constraint query in
   ;; logarithmic work without replaying all live sets.
   (alloc-clobber-tree (ArrayList i64))
   (alloc-fixed-tree (ArrayList i64))
   (alloc-tree-capacity i64)
   (phase i64)
   (next-vreg i64)
   (verify-result i64)
   (verify-item i64)
   (selection-result i64)
   (selection-item i64)
   (schedule-result i64)
   (schedule-item i64)
   (schedule-seed i64)
   (liveness-result i64)
   (liveness-item i64)
   (liveness-seed i64)
   (liveness-rounds i64)
   (fp-gen i64)
   (fp-busy bool)
   (allocation-result i64)
   (allocation-item i64)
   (allocation-seed i64)
   ;; Always-on structural work counters. These count algorithmic work, not formatted profiling,
   ;; so focused scaling tests can reject a fallback without relying on wall-clock noise.
   (work-kind-direct i64)
   (work-memory-alias-candidates i64)
   (work-memory-antidep-duplicate-probes i64)
   (inited bool)])

;; The lazy initialiser lives in its own function so the ACCESSOR can be inlined: inlined it is a
;; static address plus a never-taken branch, and the initialiser it guards stays out of line so
;; nothing is duplicated.
;;
;; MEASURED WORTH NOTHING, and kept anyway because it is the right shape. A main-thread sample put
;; `graph`, `machine-unit` and `backend` at about a third of the compiler's frames, which reads as
;; "these accessors are the bottleneck". They are not: they are simply the innermost frame of
;; everything, so a cumulative sample attributes their callers' work to them. Inlining them --
;; confirmed by their symbols disappearing from the binary -- moved the benchmark 297 ms to 299 ms.
;; The lesson is about the sample, not the accessor.
(defn machine-unit-init! [] (-> (ptr MachineUnit))
  (let [u (primitive/alloc-static MachineUnit)]
    (if (.inited u)
        0
        (do
          (set! (.functions u) (al-new [MFunction] (malloc-allocator)))
          (set! (.blocks u) (al-new [MBlock] (malloc-allocator)))
          (set! (.edges u) (al-new [MEdge] (malloc-allocator)))
          (set! (.build-edge-head u) (al-new [i64] (malloc-allocator)))
          (set! (.build-edge-next u) (al-new [i64] (malloc-allocator)))
          (set! (.returns u) (al-new [i64] (malloc-allocator)))
          (set! (.pred-edges u) (al-new [i64] (malloc-allocator)))
          (set! (.succ-edges u) (al-new [i64] (malloc-allocator)))
          (set! (.edge-copies u) (al-new [MCopy] (malloc-allocator)))
          (set! (.edge-moves u) (al-new [MMove] (malloc-allocator)))
          (set! (.abi-moves u) (al-new [MParallelMove] (malloc-allocator)))
          (set! (.abi-move-first u) (al-new [i64] (malloc-allocator)))
          (set! (.abi-move-count u) (al-new [i64] (malloc-allocator)))
          (set! (.abi-work-dst u) (al-new [MLocation] (malloc-allocator)))
          (set! (.abi-work-src u) (al-new [MLocation] (malloc-allocator)))
          (set! (.abi-work-live u) (al-new [i64] (malloc-allocator)))
          (set! (.copy-work-dst u) (al-new [i64] (malloc-allocator)))
          (set! (.copy-work-src u) (al-new [i64] (malloc-allocator)))
          (set! (.copy-work-live u) (al-new [i64] (malloc-allocator)))
          (set! (.symbols u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-kinds u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-units u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-locals u) (al-new [i64] (malloc-allocator)))
          (set! (.runtime-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-sources u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-offsets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-targets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-sources u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-offsets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-targets u) (al-new [i64] (malloc-allocator)))
          (set! (.ideal-calls u) (al-new [i64] (malloc-allocator)))
          (set! (.ideal-function-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.ctrl-block u) (al-new [i64] (malloc-allocator)))
          (set! (.block-terminator u) (al-new [i64] (malloc-allocator)))
          (set! (.block-order u) (al-new [i64] (malloc-allocator)))
