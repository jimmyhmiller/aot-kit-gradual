;; M10 arm64 backend: machine IR, scheduling, register allocation, and encoding.
(module backend_core)
(import "coil.primitive" :as primitive)

(import "node" :use *)
(import "ty" :use *)
(import "verify" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "jsstring" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)

(const MI-MOVI i64 0)
(const MI-ADD i64 1)
(const MI-SUB i64 2)
(const MI-MUL i64 3)
(const MI-SDIV i64 4)
(const MI-NEG i64 5)
(const MI-RET i64 6)
(const MI-ARG i64 7)
(const MI-EQ i64 8)
(const MI-LT i64 9)
(const MI-LE i64 10)
(const MI-LABEL i64 11)
(const MI-CBZ i64 12)
(const MI-CSEL i64 13)
(const MI-MOV i64 14)
(const MI-B i64 15)
(const MI-NEW i64 16)
(const MI-LOAD i64 17)
(const MI-STORE i64 18)
(const MI-CBR i64 19)  ; block conditional: a=predicate, b=true block, imm=false block
(const MI-JMP i64 20)  ; block jump: imm=target block
(const MI-COPY i64 21)  ; resolved edge copy: dst <- a
(const MI-CALL i64 22)  ; direct call: dst=result, a=arg0, imm=machine function
(const MI-STACKARG i64 23)  ; callee incoming stack argument, imm=contiguous stack slot
(const MI-ABI-COPY i64 24)  ; early allocatable copy from a fixed ABI ingress vreg
(const MI-JSBOX i64 25)
(const MI-JSUNBOX i64 26)
(const MI-JSTEST i64 27)
(const MI-FMOVI i64 28)  ; exact IEEE bits -> FP vreg
(const MI-SCVTF i64 29)  ; signed i64 -> f64
(const MI-FADD i64 30)
(const MI-FSUB i64 31)
(const MI-FMUL i64 32)
(const MI-FDIV i64 33)
(const MI-FNEG i64 34)
(const MI-FEQ i64 35)  ; FP inputs, boolean GPR output
(const MI-FLT i64 36)
(const MI-FLE i64 37)
(const MI-FTRUTH i64 38)  ; FP Number truthiness -> boolean GPR
(const MI-MOD i64 39)
(const MI-BITAND i64 40)
(const MI-BITOR i64 41)
(const MI-BITXOR i64 42)
(const MI-SHL i64 43)
(const MI-SHR i64 44)
(const MI-USHR i64 45)
(const MI-BITNOT i64 46)
(const MI-I32FROMFP i64 47)  ; JavaScript ToInt32/ToUint32 residue: f64 -> low 32 bits
(const MI-FMOD i64 48)  ; JavaScript Number remainder, including signed zero
(const MI-JSPROP i64 49)  ; external named-property runtime: a=owner, b=value/prototype, imm=operation
(const MI-JSARRAY i64 50)  ; external dense-array runtime: a=owner, b=index, arg0=boxed value, imm=operation
(const MI-JSSTRING i64 51)  ; external immutable UTF-16 runtime: a,b,arg0 plus operation
(const MI-OPCODE-COUNT i64 52)
(const JSSOP-NEW i64 0)
(const JSSOP-SET-UNIT i64 1)
(const JSSOP-LENGTH i64 2)
(const JSSOP-EQUAL i64 3)
(const JSSOP-CONCAT i64 4)
(const JSSOP-CHAR-CODE i64 5)
(const JSSOP-SUBSTRING i64 6)
(const JSSOP-FROM-INT i64 10)
(const JSSOP-FROM-BOOL i64 11)
(const JSSOP-FROM-NULL i64 12)
(const JSSOP-FROM-UNDEFINED i64 13)
(const JSSOP-PARSE-INT i64 14)
(const JSSOP-IS-NAN i64 15)
(const JSSOP-SPLIT i64 16)
(const JSSOP-IS-NAN-VALUE i64 17)
(const JSSOP-FROM-CODE-UNIT i64 18)
(const JSSOP-FROM-INT-RADIX i64 19)
(const JSSOP-FROM-DOUBLE-BITS i64 20)
;; 21 and 22 are retired: the ASCII case shift is lib/string/case.jsl over JSSOP 0 and 1.
(const JSSOP-INDEX-OF i64 23)
(const JSSOP-COMPARE i64 24)
(const JSSOP-FROM-VALUE i64 25)
(const JSSOP-VALUE-EQUAL i64 26)
(const JSSOP-VALUE-TRUTHY i64 27)
;; Value-level conversions, dispatched by the runtime before any string record is looked up, the
;; same way STRICT-EQUAL and VALUE-TRUTHY are. They mirror `ev-to-number-value` and `ev-to-integer`.
(const JSSOP-TO-NUMBER i64 28)
(const JSSOP-TO-INTEGER i64 29)
(const JSSOP-PARSE-FLOAT i64 30)
(const JSSOP-NORMALIZE i64 31)
(const JSSOP-TO-FIXED i64 32)
(const JSSOP-BUILTIN-BASE i64 100)

; Stable public result codes. Success is the only state in which generated code or object bytes
; are consumable. Later milestones may replace an unsupported result with success, but must never
; renumber or reuse an existing code.
(const BER-OK i64 0)
(const BER-MALFORMED-GRAPH i64 1)
(const BER-UNSUPPORTED-OPCODE i64 2)
(const BER-UNSUPPORTED-CFG i64 3)
(const BER-UNSUPPORTED-PHI i64 4)
(const BER-UNSUPPORTED-CALL i64 5)
(const BER-UNSUPPORTED-CALL-LIVE i64 6)
(const BER-ALLOCATION i64 7)
(const BER-ENCODING i64 8)
(const BER-OBJECT i64 9)

; Machine-CFG verifier results are stable for the same reason as backend phase results: focused
; corruption fixtures must name the broken law instead of collapsing to a generic false.
(const MCFG-OK i64 0)
(const MCFG-OWNER i64 1)
(const MCFG-RECIPROCITY i64 2)
(const MCFG-PREDECESSOR-SLOT i64 3)
(const MCFG-TERMINATOR-ARITY i64 4)
(const MCFG-RPO i64 5)
(const MCFG-FUNCTION-ISOLATION i64 6)
(const MCFG-IDOM i64 7)

(const MSEL-OK i64 0)
(const MSEL-OWNER i64 1)
(const MSEL-DUPLICATE i64 2)
(const MSEL-DEPENDENCY i64 3)
(const MSEL-TERMINATOR i64 4)
(const MSEL-UNSUPPORTED i64 5)
(const MSEL-PHI i64 6)
(const MSEL-CALL i64 7)
(const MSEL-CALL-LIVE i64 8)
(const MSEL-PLACEMENT i64 9)
(const MSEL-MEMORY-ORDER i64 10)

(const MABI-OK i64 0)
(const MABI-FRAME i64 1)
(const MABI-SPILL i64 2)
(const MABI-ARGUMENT i64 3)

(const MSCHED-OK i64 0)
(const MSCHED-CYCLE i64 1)
(const MSCHED-DEPENDENCY i64 2)
(const MSCHED-MEMORY i64 3)
(const MSCHED-EXACTLY-ONCE i64 4)
(const MSCHED-BOUNDARY i64 5)

(const MLIVE-OK i64 0)
(const MLIVE-RANGE i64 1)
(const MLIVE-FIXPOINT i64 2)
(const MLIVE-PHI i64 3)
(const MLIVE-KIND i64 4)
(const MLIVE-SAFEPOINT i64 5)
(const MLIVE-CLASS i64 6)

(const MLK-SCALAR i64 0)
(const MLK-RAW-MANAGED i64 1)
(const MLK-BOXED i64 2)
(const MLK-NONMOVING i64 3)
(const JSV-RAW-NULLABLE-OBJECT i64 -2)

;; Register classes are independent of GC kinds: an f64 is a scalar for stack-map purposes but
;; cannot share a physical register or an interference color with an integer scalar.
(const MRC-GPR i64 0)
(const MRC-FPR i64 1)

(const MRA-OK i64 0)
(const MRA-INTERFERENCE i64 1)
(const MRA-FIXED i64 2)
(const MRA-LOCATION i64 3)
(const MRA-SPILL-KIND i64 4)
(const MRA-COALESCE i64 5)

(const MOBJ-OK i64 0)
(const MOBJ-HEADER i64 1)
(const MOBJ-FUNCTION-RANGE i64 2)
(const MOBJ-SYMBOL i64 3)
(const MOBJ-RELOCATION i64 4)
(const MOBJ-STACKMAP i64 5)
(const MOBJ-LAYOUT i64 6)
(const MOBJ-ATOMIC i64 7)

(defstruct MInst
  [(op i64)
   (dst i64)
   (a i64)
   (b i64)
   (imm i64)
   (node i64)
   (owner i64)
   (block-id i64)
   (mem-first i64)
   (mem-count i64)
   (anti-first i64)
   (anti-count i64)
   (arg-first i64)
   (arg-count i64)
   (reg i64)
   (spill i64)
   (first i64)
   (last i64)
   (earliest i64)
   (latest i64)
   (schedule-order i64)])

(defstruct MOpcodeDesc
  [(inputs i64)
   (outputs i64)
   (temporaries i64)
   (clobbers i64)
   (effects i64)
   (pinned bool)
   (memory bool)
   (terminator bool)
   (encodable bool)])

; These records intentionally use indexes into unit-owned tables. Stable indexes survive later
; edge splitting and avoid pointers becoming stale when an ArrayList grows.
(defstruct MFunction
  [(id i64)
   (ideal i64)
   (entry i64)
   (imported bool)
   (block-first i64)
   (block-count i64)
   (return-first i64)
   (return-count i64)
   (frame-size i64)
   (callee-mask i64)
   (callee-count i64)
   (code-start i64)
   (code-size i64)])

(defstruct MBlock
  [(id i64)
   (owner i64)
   (ideal-ctrl i64)
   (pred-first i64)
   (pred-count i64)
   (succ-first i64)
   (succ-count i64)
   (inst-first i64)
   (inst-count i64)
   (loop-depth i64)
   (layout-index i64)])

(defstruct MEdge
  [(id i64)
   (owner i64)
   (source i64)
   (target i64)
   (target-slot i64)
   (copy-first i64)
   (copy-count i64)
   (move-first i64)
   (move-count i64)])

(const MCOPY-VALUE i64 0)
(const MCOPY-MEMORY i64 1)

; Phi transport belongs to an incoming edge, not to either endpoint block.  Keeping the ideal
; Phi and its selected source in the record makes target-slot mistakes independently verifiable.
(defstruct MCopy
  [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)])

(defstruct MMove
  [(edge i64) (dst i64) (src i64) (temporary bool)])

(defstruct MachineUnit
  [(functions (ArrayList MFunction))
   (blocks (ArrayList MBlock))
   (edges (ArrayList MEdge))
   ;; Temporary source-block adjacency used while constructing the CFG. Final packed adjacency is
   ;; built later; these lists keep duplicate-edge detection proportional to a block's outdegree.
   (build-edge-head (ArrayList i64))
   (build-edge-next (ArrayList i64))
   (returns (ArrayList i64))
   (pred-edges (ArrayList i64))
   (succ-edges (ArrayList i64))
   (edge-copies (ArrayList MCopy))
   (edge-moves (ArrayList MMove))
   (copy-work-dst (ArrayList i64))
   (copy-work-src (ArrayList i64))
   (copy-work-live (ArrayList i64))
   (symbols (ArrayList i64))
   (identity-kinds (ArrayList i64))
   (identity-units (ArrayList i64))
   (identity-locals (ArrayList i64))
   (runtime-deps (ArrayList i64))
   ;; Direct internal calls are encoded immediately for ordinary publication, but their semantic
   ;; relocation survives as (source owner, absolute code offset, target function owner). Reusable
   ;; function-text assembly can therefore make the offset source-relative and repatch BL without
   ;; rediscovering machine IR or scanning function ranges.
   (internal-call-sources (ArrayList i64))
   (internal-call-offsets (ArrayList i64))
   (internal-call-targets (ArrayList i64))
   ;; Polymorphic dispatch materializes a target function address as ADR + fixed-width delta + ADD.
   ;; It is relocatable, but not a call instruction, so retain it as a separate relocation kind.
   (internal-address-sources (ArrayList i64))
   (internal-address-offsets (ArrayList i64))
   (internal-address-targets (ArrayList i64))
   ;; Live ideal Call nodes in node order. CFG reachability recursively discovers functions in
   ;; call order; keeping that order in a compact list avoids rescanning every ideal node for each
   ;; discovered function.
   (ideal-calls (ArrayList i64))
   (ideal-function-owner (ArrayList i64))
   (ctrl-block (ArrayList i64))
   (block-terminator (ArrayList i64))
   (block-order (ArrayList i64))
   (block-idom (ArrayList i64))
   (rpo-seen (ArrayList i64))
   (rpo-post (ArrayList i64))
   (selected-values (ArrayList i64))
   (selected-nodes (ArrayList i64))
   (selected-blocks (ArrayList i64))
   ;; Selection runs owners sequentially, so one node-indexed memo plus an owner tag preserves
   ;; isolation without allocating function-count * graph-node-count slots.
   (selected-value-owners (ArrayList i64))
   (selected-node-owners (ArrayList i64))
   (selected-block-owners (ArrayList i64))
   ;; Live Phi nodes grouped by target block in ideal-node order. Selection consumes this index
   ;; for reservation and edge copies instead of scanning the whole ideal graph per function/edge.
   (block-phi-head (ArrayList i64))
   (node-phi-next (ArrayList i64))
   (packed-insts (ArrayList MInst))
   (selection-memory-deps (ArrayList i64))
   (selection-memory-pending (ArrayList i64))
   ;; One-time candidate indexes for selection roots. The old selector rediscovered these by
   ;; scanning every ideal node twice for every function.
   (selection-ingress-candidates (ArrayList i64))
   (selection-effect-candidates (ArrayList i64))
   (memory-anti-deps (ArrayList i64))
   (memory-read-head (ArrayList i64))
   (memory-read-next (ArrayList i64))
   (call-args (ArrayList i64))
   (schedule-work (ArrayList MInst))
   (schedule-done (ArrayList i64))
   (vreg-new-def (ArrayList i64))
   ;; Dense vreg -> defining instruction index. Rebuilt whenever instruction packing changes so
   ;; placement, scheduling, and verification never recover a definition by scanning the unit.
   (vreg-def-inst (ArrayList i64))
   ;; Dense block id -> final encoded byte offset, published by the sizing pass.
   (block-code-offset (ArrayList i64))
   (node-inst-head (ArrayList i64))
   (node-inst-next (ArrayList i64))
   (pack-next (ArrayList i64))
   (pack-term-next (ArrayList i64))
   (verify-def-count (ArrayList i64))
   (verify-node-def-count (ArrayList i64))
   ;; Independently rebuilt node -> scheduled instruction lists. The selector's node-inst index
   ;; describes its pre-schedule packing and must not be trusted after instructions move.
   (verify-node-inst-head (ArrayList i64))
   (verify-node-inst-next (ArrayList i64))
   (verify-membership (ArrayList i64))
   (verify-order-count (ArrayList i64))
   ;; Independently derived verifier view of live Phis by target block. This intentionally does
   ;; not reuse selection's block-phi index, so verification still catches selector omissions.
   (verify-block-phi-head (ArrayList i64))
   (verify-node-phi-next (ArrayList i64))
   ;; Independent memory-read index for anti-dependency verification. Keeping verifier-owned
   ;; lists avoids trusting the selector's production index without rescanning every instruction
   ;; for every write.
   (verify-memory-read-head (ArrayList i64))
   (verify-memory-read-next (ArrayList i64))
   ;; vreg -> target block for Phi definitions, or -1 for ordinary instruction definitions.
   ;; GCM queries this for nearly every operand; deriving it by rescanning all edge-copy tables
   ;; makes large Phi-heavy programs quadratic.
   (vreg-phi-block (ArrayList i64))
   ;; vreg -> (defining node, owner): the reverse of selected-values. ml-kind-for-vreg answered
   ;; "which node produced this vreg" by scanning every function x every node per query, which
   ;; made kind classification quadratic on large programs. -1 when no node claimed the vreg.
   (vreg-node (ArrayList i64))
   (vreg-node-owner (ArrayList i64))
   ;; vreg -> linked list of its uses, rebuilt at the start of each pass that asks
   ;; ms-gcm-latest-use-block. An entry is an instruction index, or -(block+2) for an edge
   ;; copy's source-block use. Deriving this by rescanning every instruction and every edge
   ;; PER DEFINITION made GCM placement and verification quadratic in program size.
   (vreg-use-head (ArrayList i64))
   (vreg-use-entry (ArrayList i64))
   (vreg-use-next (ArrayList i64))
   ;; Block-local scheduler dependency edges (producer -> consumers), recorded while the
   ;; indegree pass runs its pair loop so each emission decrements along the producer's edge
   ;; list instead of re-asking ms-schedule-dependency-kind for every consumer in the block.
   (sched-edge-head (ArrayList i64))
   (sched-edge-consumer (ArrayList i64))
   (sched-edge-next (ArrayList i64))
   (sched-ready (ArrayList i64))
   ;; Liveness rows contain only the vregs owned by their function. Global-vreg dense rows made
   ;; every function pay for every other function's values (blocks * all-unit-vregs).
   (live-vreg-owner (ArrayList i64))
   (live-vreg-local (ArrayList i64))
   (live-owner-first (ArrayList i64))
   (live-owner-count (ArrayList i64))
   (live-owner-words (ArrayList i64))
   (live-owner-vregs (ArrayList i64))
   (live-block-first (ArrayList i64))
   (live-edge-first (ArrayList i64))
   (live-use (ArrayList i64))
   (live-def (ArrayList i64))
   (live-in (ArrayList i64))
   (live-out (ArrayList i64))
   (edge-live (ArrayList i64))
   (value-kind (ArrayList i64))
   (register-class (ArrayList i64))
   ;; Node -> generation stamp, and the walk stack, for `be-node-fp-value?`. The question is
   ;; "does a floating-point value reach this node", which is reachability over the whole
   ;; expression, so it is answered by a marked walk rather than a depth-limited recursion.
   (fp-mark (ArrayList i64))
   (fp-stack (ArrayList i64))
   (fp-known (ArrayList bool))
   (fp-value (ArrayList bool))
   ;; Selection ABI ordinals are graph invariants. Cache them by ideal node rather than recovering
   ;; each one with another prefix/full-graph scan while recursively selecting values.
   (arg-abi-index (ArrayList i64))
   (parm-abi-index (ArrayList i64))
   (parm-stack-index (ArrayList i64))
   (new-index (ArrayList i64))
   (kind-known (ArrayList bool))
   (kind-value (ArrayList i64))
   (alloc-interference (ArrayList i64))
   (alloc-row-first (ArrayList i64))
   (alloc-expected (ArrayList i64))
   (alloc-verify-seen (ArrayList i64))
   (alloc-live (ArrayList i64))
   (alloc-live-list (ArrayList i64))
   (alloc-live-pos (ArrayList i64))
   (alloc-owner-head (ArrayList i64))
   (alloc-owner-next (ArrayList i64))
   (alloc-adj-head (ArrayList i64))
   (alloc-adj-other (ArrayList i64))
   (alloc-adj-next (ArrayList i64))
   (alloc-copy-peer (ArrayList i64))
   (alloc-reg (ArrayList i64))
   (alloc-spill (ArrayList i64))
   (alloc-owner (ArrayList i64))
   (alloc-forbidden (ArrayList i64))
   (alloc-spill-kind (ArrayList i64))
   (phase i64)
   (next-vreg i64)
   (verify-result i64)
   (verify-item i64)
   (selection-result i64)
   (selection-item i64)
   (schedule-result i64)
   (schedule-item i64)
   (schedule-seed i64)
   (liveness-result i64)
   (liveness-item i64)
   (liveness-seed i64)
   (liveness-rounds i64)
   (fp-gen i64)
   (fp-busy bool)
   (allocation-result i64)
   (allocation-item i64)
   (allocation-seed i64)
   (inited bool)])

(defn machine-unit [] (-> (ptr MachineUnit))
  (let [u (primitive/alloc-static MachineUnit)]
    (if (.inited u)
        0
        (do
          (set! (.functions u) (al-new [MFunction] (malloc-allocator)))
          (set! (.blocks u) (al-new [MBlock] (malloc-allocator)))
          (set! (.edges u) (al-new [MEdge] (malloc-allocator)))
          (set! (.build-edge-head u) (al-new [i64] (malloc-allocator)))
          (set! (.build-edge-next u) (al-new [i64] (malloc-allocator)))
          (set! (.returns u) (al-new [i64] (malloc-allocator)))
          (set! (.pred-edges u) (al-new [i64] (malloc-allocator)))
          (set! (.succ-edges u) (al-new [i64] (malloc-allocator)))
          (set! (.edge-copies u) (al-new [MCopy] (malloc-allocator)))
          (set! (.edge-moves u) (al-new [MMove] (malloc-allocator)))
          (set! (.copy-work-dst u) (al-new [i64] (malloc-allocator)))
          (set! (.copy-work-src u) (al-new [i64] (malloc-allocator)))
          (set! (.copy-work-live u) (al-new [i64] (malloc-allocator)))
          (set! (.symbols u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-kinds u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-units u) (al-new [i64] (malloc-allocator)))
          (set! (.identity-locals u) (al-new [i64] (malloc-allocator)))
          (set! (.runtime-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-sources u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-offsets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-call-targets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-sources u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-offsets u) (al-new [i64] (malloc-allocator)))
          (set! (.internal-address-targets u) (al-new [i64] (malloc-allocator)))
          (set! (.ideal-calls u) (al-new [i64] (malloc-allocator)))
          (set! (.ideal-function-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.ctrl-block u) (al-new [i64] (malloc-allocator)))
          (set! (.block-terminator u) (al-new [i64] (malloc-allocator)))
          (set! (.block-order u) (al-new [i64] (malloc-allocator)))
          (set! (.block-idom u) (al-new [i64] (malloc-allocator)))
          (set! (.rpo-seen u) (al-new [i64] (malloc-allocator)))
          (set! (.rpo-post u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-values u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-nodes u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-blocks u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-value-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-node-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.selected-block-owners u) (al-new [i64] (malloc-allocator)))
          (set! (.block-phi-head u) (al-new [i64] (malloc-allocator)))
          (set! (.node-phi-next u) (al-new [i64] (malloc-allocator)))
          (set! (.packed-insts u) (al-new [MInst] (malloc-allocator)))
          (set! (.selection-memory-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-memory-pending u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-ingress-candidates u) (al-new [i64] (malloc-allocator)))
          (set! (.selection-effect-candidates u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-anti-deps u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-read-head u) (al-new [i64] (malloc-allocator)))
          (set! (.memory-read-next u) (al-new [i64] (malloc-allocator)))
          (set! (.call-args u) (al-new [i64] (malloc-allocator)))
          (set! (.schedule-work u) (al-new [MInst] (malloc-allocator)))
          (set! (.schedule-done u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-new-def u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-def-inst u) (al-new [i64] (malloc-allocator)))
          (set! (.block-code-offset u) (al-new [i64] (malloc-allocator)))
          (set! (.node-inst-head u) (al-new [i64] (malloc-allocator)))
          (set! (.node-inst-next u) (al-new [i64] (malloc-allocator)))
          (set! (.pack-next u) (al-new [i64] (malloc-allocator)))
          (set! (.pack-term-next u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-def-count u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-def-count u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-inst-head u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-inst-next u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-membership u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-order-count u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-block-phi-head u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-node-phi-next u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-memory-read-head u) (al-new [i64] (malloc-allocator)))
          (set! (.verify-memory-read-next u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-phi-block u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-node u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-node-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-use-head u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-use-entry u) (al-new [i64] (malloc-allocator)))
          (set! (.vreg-use-next u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-head u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-consumer u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-next u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-ready u) (al-new [i64] (malloc-allocator)))
          (set! (.live-vreg-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.live-vreg-local u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-first u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-count u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-words u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-vregs u) (al-new [i64] (malloc-allocator)))
          (set! (.live-block-first u) (al-new [i64] (malloc-allocator)))
          (set! (.live-edge-first u) (al-new [i64] (malloc-allocator)))
          (set! (.live-use u) (al-new [i64] (malloc-allocator)))
          (set! (.live-def u) (al-new [i64] (malloc-allocator)))
          (set! (.live-in u) (al-new [i64] (malloc-allocator)))
          (set! (.live-out u) (al-new [i64] (malloc-allocator)))
          (set! (.edge-live u) (al-new [i64] (malloc-allocator)))
          (set! (.value-kind u) (al-new [i64] (malloc-allocator)))
          (set! (.register-class u) (al-new [i64] (malloc-allocator)))
          (set! (.fp-mark u) (al-new [i64] (malloc-allocator)))
          (set! (.fp-stack u) (al-new [i64] (malloc-allocator)))
          (set! (.fp-known u) (al-new [bool] (malloc-allocator)))
          (set! (.fp-value u) (al-new [bool] (malloc-allocator)))
          (set! (.arg-abi-index u) (al-new [i64] (malloc-allocator)))
          (set! (.parm-abi-index u) (al-new [i64] (malloc-allocator)))
          (set! (.parm-stack-index u) (al-new [i64] (malloc-allocator)))
          (set! (.new-index u) (al-new [i64] (malloc-allocator)))
          (set! (.kind-known u) (al-new [bool] (malloc-allocator)))
          (set! (.kind-value u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-interference u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-row-first u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-expected u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-verify-seen u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-live u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-live-list u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-live-pos u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-owner-head u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-owner-next u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-adj-head u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-adj-other u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-adj-next u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-copy-peer u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-reg u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-spill u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-forbidden u) (al-new [i64] (malloc-allocator)))
          (set! (.alloc-spill-kind u) (al-new [i64] (malloc-allocator)))
          (set! (.inited u) true)
          0))
    u))

(defn mu-reset! [] (-> i64)
  (let [u (machine-unit)]
    (al-clear! [MFunction] (field u functions))
    (al-clear! [MBlock] (field u blocks))
    (al-clear! [MEdge] (field u edges))
    (al-clear! [i64] (field u build-edge-head))
    (al-clear! [i64] (field u build-edge-next))
    (al-clear! [i64] (field u returns))
    (al-clear! [i64] (field u pred-edges))
    (al-clear! [i64] (field u succ-edges))
    (al-clear! [MCopy] (field u edge-copies))
    (al-clear! [MMove] (field u edge-moves))
    (al-clear! [i64] (field u copy-work-dst))
    (al-clear! [i64] (field u copy-work-src))
    (al-clear! [i64] (field u copy-work-live))
    (al-clear! [i64] (field u symbols))
    (al-clear! [i64] (field u identity-kinds))
    (al-clear! [i64] (field u identity-units))
    (al-clear! [i64] (field u identity-locals))
    (al-clear! [i64] (field u runtime-deps))
    (al-clear! [i64] (field u internal-call-sources))
    (al-clear! [i64] (field u internal-call-offsets))
    (al-clear! [i64] (field u internal-call-targets))
    (al-clear! [i64] (field u internal-address-sources))
    (al-clear! [i64] (field u internal-address-offsets))
    (al-clear! [i64] (field u internal-address-targets))
    (al-clear! [i64] (field u ideal-calls))
    (al-clear! [i64] (field u ideal-function-owner))
    (al-clear! [i64] (field u ctrl-block))
    (al-clear! [i64] (field u block-terminator))
    (al-clear! [i64] (field u block-order))
    (al-clear! [i64] (field u block-idom))
    (al-clear! [i64] (field u rpo-seen))
    (al-clear! [i64] (field u rpo-post))
    ;; Selection memo storage is prepared by ms-map-init! at node density, not owner*node density.
    (al-clear! [i64] (field u block-phi-head))
    (al-clear! [i64] (field u node-phi-next))
    (al-clear! [MInst] (field u packed-insts))
    (al-clear! [i64] (field u selection-memory-deps))
    (al-clear! [i64] (field u selection-memory-pending))
    (al-clear! [i64] (field u selection-ingress-candidates))
    (al-clear! [i64] (field u selection-effect-candidates))
    (al-clear! [i64] (field u memory-anti-deps))
    (al-clear! [i64] (field u memory-read-head))
    (al-clear! [i64] (field u memory-read-next))
    (al-clear! [i64] (field u call-args))
    (al-clear! [MInst] (field u schedule-work))
    (al-clear! [i64] (field u schedule-done))
    (al-clear! [i64] (field u vreg-new-def))
    (al-clear! [i64] (field u vreg-def-inst))
    (al-clear! [i64] (field u block-code-offset))
    (al-clear! [i64] (field u node-inst-head))
    (al-clear! [i64] (field u node-inst-next))
    (al-clear! [i64] (field u pack-next))
    (al-clear! [i64] (field u pack-term-next))
    (al-clear! [i64] (field u verify-def-count))
    (al-clear! [i64] (field u verify-node-def-count))
    (al-clear! [i64] (field u verify-node-inst-head))
    (al-clear! [i64] (field u verify-node-inst-next))
    (al-clear! [i64] (field u verify-membership))
    (al-clear! [i64] (field u verify-order-count))
    (al-clear! [i64] (field u verify-block-phi-head))
    (al-clear! [i64] (field u verify-node-phi-next))
    (al-clear! [i64] (field u verify-memory-read-head))
    (al-clear! [i64] (field u verify-memory-read-next))
    (al-clear! [i64] (field u vreg-phi-block))
    (al-clear! [i64] (field u vreg-node))
    (al-clear! [i64] (field u vreg-node-owner))
    (al-clear! [i64] (field u vreg-use-head))
    (al-clear! [i64] (field u vreg-use-entry))
    (al-clear! [i64] (field u vreg-use-next))
    (al-clear! [i64] (field u sched-edge-head))
    (al-clear! [i64] (field u sched-edge-consumer))
    (al-clear! [i64] (field u sched-edge-next))
    (al-clear! [i64] (field u sched-ready))
    (al-clear! [i64] (field u live-vreg-owner))
    (al-clear! [i64] (field u live-vreg-local))
    (al-clear! [i64] (field u live-owner-first))
    (al-clear! [i64] (field u live-owner-count))
    (al-clear! [i64] (field u live-owner-words))
    (al-clear! [i64] (field u live-owner-vregs))
    (al-clear! [i64] (field u live-block-first))
    (al-clear! [i64] (field u live-edge-first))
    (al-clear! [i64] (field u live-use))
    (al-clear! [i64] (field u live-def))
    (al-clear! [i64] (field u live-in))
    (al-clear! [i64] (field u live-out))
    (al-clear! [i64] (field u edge-live))
    (al-clear! [i64] (field u value-kind))
    (al-clear! [i64] (field u register-class))
    (al-clear! [i64] (field u fp-mark))
    (al-clear! [i64] (field u fp-stack))
    (al-clear! [bool] (field u fp-known))
    (al-clear! [bool] (field u fp-value))
    (al-clear! [i64] (field u arg-abi-index))
    (al-clear! [i64] (field u parm-abi-index))
    (al-clear! [i64] (field u parm-stack-index))
    (al-clear! [i64] (field u new-index))
    (al-clear! [bool] (field u kind-known))
    (al-clear! [i64] (field u kind-value))
    (al-clear! [i64] (field u alloc-interference))
    (al-clear! [i64] (field u alloc-row-first))
    (al-clear! [i64] (field u alloc-expected))
    (al-clear! [i64] (field u alloc-verify-seen))
    (al-clear! [i64] (field u alloc-live))
    (al-clear! [i64] (field u alloc-live-list))
    (al-clear! [i64] (field u alloc-live-pos))
    (al-clear! [i64] (field u alloc-owner-head))
    (al-clear! [i64] (field u alloc-owner-next))
    (al-clear! [i64] (field u alloc-adj-head))
    (al-clear! [i64] (field u alloc-adj-other))
    (al-clear! [i64] (field u alloc-adj-next))
    (al-clear! [i64] (field u alloc-copy-peer))
    (al-clear! [i64] (field u alloc-reg))
    (al-clear! [i64] (field u alloc-spill))
    (al-clear! [i64] (field u alloc-owner))
    (al-clear! [i64] (field u alloc-forbidden))
    (al-clear! [i64] (field u alloc-spill-kind))
    (let [(mut i) 0]
      (loop (if (>= (load i) (n-count))
                (break)
                (do
                  (al-push! [i64] (field u ctrl-block) -1)
                  (al-push! [i64] (field u ideal-function-owner) -1)
                  (set! i (+ (load i) 1))
                  0))))
    (set! (.phase u) 0)
    (set! (.next-vreg u) 0)
    (set! (.verify-result u) MCFG-OK)
    (set! (.verify-item u) -1)
    (set! (.selection-result u) MSEL-OK)
    (set! (.selection-item u) -1)
    (set! (.schedule-result u) MSCHED-OK)
    (set! (.schedule-item u) -1)
    (set! (.schedule-seed u) 0)
    (set! (.liveness-result u) MLIVE-OK)
    (set! (.liveness-item u) -1)
    (set! (.liveness-seed u) 0)
    (set! (.liveness-rounds u) 0)
    (set! (.fp-gen u) 0)
    (set! (.fp-busy u) false)
    (set! (.allocation-result u) MRA-OK)
    (set! (.allocation-item u) -1)
    (set! (.allocation-seed u) 0)
    0))

(defn mu-function-count [] (-> i64)
  (al-len [MFunction] (.functions (machine-unit))))
(defn mu-block-count [] (-> i64)
  (al-len [MBlock] (.blocks (machine-unit))))
(defn mu-edge-count [] (-> i64)
  (al-len [MEdge] (.edges (machine-unit))))
(defn mu-verify-result [] (-> i64)
  (.verify-result (machine-unit)))
(defn mu-verify-item [] (-> i64)
  (.verify-item (machine-unit)))

(defn mf-new [(id i64) (ideal i64) (entry i64)] (-> MFunction)
  (let [p (primitive/alloc-stack MFunction)]
    (set! (.id p) id)
    (set! (.ideal p) ideal)
    (set! (.entry p) entry)
    (set! (.imported p) false)
    (set! (.block-first p) -1)
    (set! (.block-count p) 0)
    (set! (.return-first p) -1)
    (set! (.return-count p) 0)
    (set! (.frame-size p) -1)
    (set! (.callee-mask p) 0)
    (set! (.callee-count p) 0)
    (set! (.code-start p) -1)
    (set! (.code-size p) 0)
    (load p)))

(defn mb-new [(id i64) (owner i64) (ctrl i64)] (-> MBlock)
  (let [p (primitive/alloc-stack MBlock)]
    (set! (.id p) id)
    (set! (.owner p) owner)
    (set! (.ideal-ctrl p) ctrl)
    (set! (.pred-first p) -1)
    (set! (.pred-count p) 0)
    (set! (.succ-first p) -1)
    (set! (.succ-count p) 0)
    (set! (.inst-first p) -1)
    (set! (.inst-count p) 0)
    (set! (.loop-depth p) 0)
    (set! (.layout-index p) -1)
    (load p)))

(defn me-new [(id i64) (owner i64) (source i64) (target i64) (slot i64)] (-> MEdge)
  (let [p (primitive/alloc-stack MEdge)]
    (set! (.id p) id)
    (set! (.owner p) owner)
    (set! (.source p) source)
    (set! (.target p) target)
    (set! (.target-slot p) slot)
    (set! (.copy-first p) -1)
    (set! (.copy-count p) 0)
    (set! (.move-first p) -1)
    (set! (.move-count p) 0)
    (load p)))

(defn mc-new [(edge i64) (phi i64) (dst i64) (src i64) (kind i64)] (-> MCopy)
  (let [p (primitive/alloc-stack MCopy)]
    (set! (.edge p) edge)
    (set! (.phi p) phi)
    (set! (.dst p) dst)
    (set! (.src p) src)
    (set! (.kind p) kind)
    (load p)))

(defn mm-new [(edge i64) (dst i64) (src i64) (temporary bool)] (-> MMove)
  (let [p (primitive/alloc-stack MMove)]
    (set! (.edge p) edge)
    (set! (.dst p) dst)
    (set! (.src p) src)
    (set! (.temporary p) temporary)
    (load p)))

(defn mu-function [(i i64)] (-> (ptr MFunction))
  (be-al-elem [MFunction] (field (machine-unit) functions) i))
(defn mu-block [(i i64)] (-> (ptr MBlock))
  (be-al-elem [MBlock] (field (machine-unit) blocks) i))
(defn mu-edge [(i i64)] (-> (ptr MEdge))
  (be-al-elem [MEdge] (field (machine-unit) edges) i))
(defn mu-block-owner [(i i64)] (-> i64)
  (.owner (mu-block i)))
(defn mu-block-control [(i i64)] (-> i64)
  (.ideal-ctrl (mu-block i)))
(defn mu-edge-source [(i i64)] (-> i64)
  (.source (mu-edge i)))
(defn mu-edge-target [(i i64)] (-> i64)
  (.target (mu-edge i)))
(defn mu-edge-target-slot [(i i64)] (-> i64)
  (.target-slot (mu-edge i)))
(defn mu-edge-copy-count [(i i64)] (-> i64)
  (.copy-count (mu-edge i)))
(defn mu-edge-copy [(edge i64) (which i64)] (-> (ptr MCopy))
  (let [first (.copy-first (mu-edge edge))]
    (be-al-elem [MCopy] (field (machine-unit) edge-copies) (+ first which))))
(defn mu-copy-phi [(edge i64) (which i64)] (-> i64)
  (.phi (mu-edge-copy edge which)))
(defn mu-copy-dst [(edge i64) (which i64)] (-> i64)
  (.dst (mu-edge-copy edge which)))
(defn mu-copy-src [(edge i64) (which i64)] (-> i64)
  (.src (mu-edge-copy edge which)))
(defn mu-copy-kind [(edge i64) (which i64)] (-> i64)
  (.kind (mu-edge-copy edge which)))
(defn mu-edge-move-count [(i i64)] (-> i64)
  (.move-count (mu-edge i)))
(defn mu-edge-move [(edge i64) (which i64)] (-> (ptr MMove))
  (let [first (.move-first (mu-edge edge))]
    (be-al-elem [MMove] (field (machine-unit) edge-moves) (+ first which))))
(defn mu-move-dst [(edge i64) (which i64)] (-> i64)
  (.dst (mu-edge-move edge which)))
(defn mu-move-src [(edge i64) (which i64)] (-> i64)
  (.src (mu-edge-move edge which)))
(defn mu-move-temporary? [(edge i64) (which i64)] (-> bool)
  (.temporary (mu-edge-move edge which)))
(defn mu-function-ideal [(i i64)] (-> i64)
  (.ideal (mu-function i)))
(defn mu-function-imported? [(i i64)] (-> bool)
  (.imported (mu-function i)))
(defn mu-function-mark-imported! [(i i64)] (-> i64)
  (set! (.imported (mu-function i)) true)
  0)
(defn mu-function-block-count [(i i64)] (-> i64)
  (.block-count (mu-function i)))
(defn mu-function-frame-size [(i i64)] (-> i64)
  (.frame-size (mu-function i)))
(defn mu-function-code-start [(i i64)] (-> i64)
  (.code-start (mu-function i)))
(defn mu-function-code-size [(i i64)] (-> i64)
  (.code-size (mu-function i)))
(defn mu-function-symbol [(i i64)] (-> i64)
  (al-get [i64] (.symbols (machine-unit)) i))
(defn mu-function-identity-kind [(i i64)] (-> i64)
  (al-get [i64] (.identity-kinds (machine-unit)) i))
(defn mu-function-identity-unit [(i i64)] (-> i64)
  (al-get [i64] (.identity-units (machine-unit)) i))
(defn mu-function-identity-local [(i i64)] (-> i64)
  (al-get [i64] (.identity-locals (machine-unit)) i))
(defn mu-internal-call-reloc-count [] (-> i64)
  (al-len [i64] (.internal-call-offsets (machine-unit))))
(defn mu-internal-call-reloc-source [(i i64)] (-> i64)
  (al-get [i64] (.internal-call-sources (machine-unit)) i))
(defn mu-internal-call-reloc-offset [(i i64)] (-> i64)
  (al-get [i64] (.internal-call-offsets (machine-unit)) i))
(defn mu-internal-call-reloc-target [(i i64)] (-> i64)
  (al-get [i64] (.internal-call-targets (machine-unit)) i))
(defn mu-internal-address-reloc-count [] (-> i64)
  (al-len [i64] (.internal-address-offsets (machine-unit))))
(defn mu-internal-address-reloc-source [(i i64)] (-> i64)
  (al-get [i64] (.internal-address-sources (machine-unit)) i))
(defn mu-internal-address-reloc-offset [(i i64)] (-> i64)
  (al-get [i64] (.internal-address-offsets (machine-unit)) i))
(defn mu-internal-address-reloc-target [(i i64)] (-> i64)
  (al-get [i64] (.internal-address-targets (machine-unit)) i))
(defn mu-function-callee-mask [(i i64)] (-> i64)
  (.callee-mask (mu-function i)))
(defn mu-function-callee-count [(i i64)] (-> i64)
  (.callee-count (mu-function i)))
(defn mu-function-block [(fun i64) (rpo i64)] (-> i64)
  (let [f (mu-function fun)]
    (al-get (.block-order (machine-unit))
            (+ (.block-first f) rpo))))
(defn mu-function-return-count [(fidx i64)] (-> i64)
  (.return-count (mu-function fidx)))
(defn mu-function-return-block [(fidx i64) (i i64)] (-> i64)
  (let [f (mu-function fidx)]
    (al-get (.returns (machine-unit))
            (+ (.return-first f) i))))
(defn mu-block-layout-index [(i i64)] (-> i64)
  (.layout-index (mu-block i)))
(defn mu-block-loop-depth [(i i64)] (-> i64)
  (.loop-depth (mu-block i)))
(defn mu-block-idom [(i i64)] (-> i64)
  (al-get (.block-idom (machine-unit)) i))
(defn mu-block-inst-first [(i i64)] (-> i64)
  (.inst-first (mu-block i)))
(defn mu-block-inst-count [(i i64)] (-> i64)
  (.inst-count (mu-block i)))
(defn mu-block-pred-count [(i i64)] (-> i64)
  (.pred-count (mu-block i)))
(defn mu-block-pred-edge [(bid i64) (i i64)] (-> i64)
  (let [b (mu-block bid)]
    (al-get (.pred-edges (machine-unit))
            (+ (.pred-first b) i))))
(defn mu-block-pred-source [(bid i64) (i i64)] (-> i64)
  (mu-edge-source (mu-block-pred-edge bid i)))
(defn mu-block-succ-count [(i i64)] (-> i64)
  (.succ-count (mu-block i)))
(defn mu-block-succ-edge [(bid i64) (i i64)] (-> i64)
  (let [b (mu-block bid)]
    (al-get (.succ-edges (machine-unit))
            (+ (.succ-first b) i))))
(defn mu-block-succ-target [(bid i64) (i i64)] (-> i64)
  (mu-edge-target (mu-block-succ-edge bid i)))

(defstruct Backend
  [(ins (ArrayList MInst))
   (nval (ArrayList i64))  ; graph node -> virtual register, -1 when unselected
   (mseen (ArrayList i64))
   (clabel (ArrayList i64))
   ;; AArch64 is fixed-width. Store one machine word per append so emission performs one capacity
   ;; check and one length update per instruction instead of four generic byte pushes. `code`
   ;; remains the variable-width x64 buffer; the AArch64 public API presents `a64-code` as bytes.
   (a64-code (ArrayList i64))
   (code (ArrayList u8))
   (obj (ArrayList u8))
   (x64-poly-call-offs (ArrayList i64))
   (x64-poly-call-targets (ArrayList i64))
   (x64-poly-end-offs (ArrayList i64))
   (x64-label-offs (ArrayList i64))
   (x64-entry-owners (ArrayList i64))
   (spills i64)
   (inloop bool)
   (result i64)
   (result-node i64)
   (verify-code i64)
   (object-result i64)
   (object-item i64)
   (runtime-allocation bool)
   (inited bool)])

(defn backend [] (-> (ptr Backend))
  (let [p (primitive/alloc-static Backend)]
    (if (.inited p)
        0
        (do
          (set! (.inited p) true)
          (set! (.ins p) (al-new [MInst] (malloc-allocator)))
          (set! (.nval p) (al-new [i64] (malloc-allocator)))
          (set! (.mseen p) (al-new [i64] (malloc-allocator)))
          (set! (.clabel p) (al-new [i64] (malloc-allocator)))
          (set! (.a64-code p) (al-new [i64] (malloc-allocator)))
          (set! (.code p) (al-new [u8] (malloc-allocator)))
          (set! (.obj p) (al-new [u8] (malloc-allocator)))
          (set! (.x64-poly-call-offs p) (al-new [i64] (malloc-allocator)))
          (set! (.x64-poly-call-targets p) (al-new [i64] (malloc-allocator)))
          (set! (.x64-poly-end-offs p) (al-new [i64] (malloc-allocator)))
          (set! (.x64-label-offs p) (al-new [i64] (malloc-allocator)))
          (set! (.x64-entry-owners p) (al-new [i64] (malloc-allocator)))
          0))
    p))

(defn be-reset! [] (-> i64)
  (let [p (backend)
        (mut i) 0]
    (al-clear! [MInst] (field p ins))
    (al-clear! [i64] (field p nval))
    (al-clear! [i64] (field p mseen))
    (al-clear! [i64] (field p clabel))
    (al-clear! [i64] (field p a64-code))
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    (al-clear! [i64] (field p x64-poly-call-offs))
    (al-clear! [i64] (field p x64-poly-call-targets))
    (al-clear! [i64] (field p x64-poly-end-offs))
    (al-clear! [i64] (field p x64-label-offs))
    (al-clear! [i64] (field p x64-entry-owners))
    (loop (if (>= (load i) (n-count))
              (break)
              (do
                (al-push! [i64] (field p nval) -1)
                (al-push! [i64] (field p mseen) 0)
                (al-push! [i64] (field p clabel) -1)
                (set! i (+ (load i) 1))
                0)))
    (set! (.spills p) 0)
    (set! (.inloop p) false)
    (set! (.result p) BER-OK)
    (set! (.result-node p) NO-NODE)
    (set! (.verify-code p) VERR-NONE)
    (set! (.object-result p) MOBJ-OK)
    (set! (.object-item p) -1)
    ;; `runtime-allocation` is caller policy, not per-unit compiler state. Preserve it across this
    ;; reset so the first compilation in a process observes the same policy as every later one.
    0))

(defn be-result [] (-> i64)
  (.result (backend)))
(defn be-result-node [] (-> i64)
  (.result-node (backend)))
(defn be-verify-code [] (-> i64)
  (.verify-code (backend)))
(defn mobj-result [] (-> i64)
  (.object-result (backend)))
(defn mobj-item [] (-> i64)
  (.object-item (backend)))
(defn be-use-runtime-allocation! [(enabled bool)] (-> i64)
  (set! (.runtime-allocation (backend)) enabled)
  0)
(defn be-runtime-allocation? [] (-> bool)
  (.runtime-allocation (backend)))

(defn be-result-name [(code i64)] (-> (slice u8))
  (case code BER-OK
        "BER-OK" BER-MALFORMED-GRAPH
        "BER-MALFORMED-GRAPH" BER-UNSUPPORTED-OPCODE
        "BER-UNSUPPORTED-OPCODE" BER-UNSUPPORTED-CFG
        "BER-UNSUPPORTED-CFG" BER-UNSUPPORTED-PHI
        "BER-UNSUPPORTED-PHI" BER-UNSUPPORTED-CALL
        "BER-UNSUPPORTED-CALL" BER-UNSUPPORTED-CALL-LIVE
        "BER-UNSUPPORTED-CALL-LIVE" BER-ALLOCATION
        "BER-ALLOCATION" BER-ENCODING
        "BER-ENCODING" BER-OBJECT
        "BER-OBJECT" "BER-?"))

(defn be-fail! [(code i64) (node i64)] (-> bool)
  (let [p (backend)]
    (if (= (.result p) BER-OK)
        (do (set! (.result p) code) (set! (.result-node p) node))
        0)
    ; Publication is atomic: a failure invalidates bytes from this and all prior compilations.
    (al-clear! [i64] (field p a64-code))
    (al-clear! [u8] (field p code))
    (al-clear! [u8] (field p obj))
    false))

(defn mi-new [(op i64) (dst i64) (a i64) (b i64) (imm i64) (node i64)] (-> MInst)
  (let [p (primitive/alloc-stack MInst)]
    (set! (.op p) op)
    (set! (.dst p) dst)
    (set! (.a p) a)
    (set! (.b p) b)
    (set! (.imm p) imm)
    (set! (.node p) node)
    (set! (.owner p) -1)
    (set! (.block-id p) -1)
    (set! (.mem-first p) -1)
    (set! (.mem-count p) 0)
    (set! (.anti-first p) -1)
    (set! (.anti-count p) 0)
    (set! (.arg-first p) -1)
    (set! (.arg-count p) 0)
    (set! (.reg p) -1)
    (set! (.spill p) -1)
    (set! (.first p) -1)
    (set! (.last p) -1)
    (set! (.earliest p) -1)
    (set! (.latest p) -1)
    (set! (.schedule-order p) -1)
    (load p)))

(defn mi-desc-new [(inputs i64)
                   (outputs i64)
                   (effects i64)
                   (pinned bool)
                   (memory bool)
                   (terminator bool)
                   (encodable bool)] (-> MOpcodeDesc)
  (let [p (primitive/alloc-stack MOpcodeDesc)]
    (set! (.inputs p) inputs)
    (set! (.outputs p) outputs)
    (set! (.temporaries p) 0)
    (set! (.clobbers p) 0)
    (set! (.effects p) effects)
    (set! (.pinned p) pinned)
    (set! (.memory p) memory)
    (set! (.terminator p) terminator)
    (set! (.encodable p) encodable)
    (load p)))

(defn mi-desc-compute [(op i64)] (-> MOpcodeDesc)
  (case op MI-MOVI
        (mi-desc-new 0 1 0 false false false true) MI-ARG
        (mi-desc-new 0 1 0 true false false true) MI-NEG
        (mi-desc-new 1 1 0 false false false true) MI-ADD
        (mi-desc-new 2 1 0 false false false true) MI-SUB
        (mi-desc-new 2 1 0 false false false true) MI-MUL
        (mi-desc-new 2 1 0 false false false true) MI-SDIV
        (mi-desc-new 2 1 0 false false false true) MI-EQ
        (mi-desc-new 2 1 0 false false false true) MI-LT
        (mi-desc-new 2 1 0 false false false true) MI-LE
        (mi-desc-new 2 1 0 false false false true) MI-NEW
        (mi-desc-new 0 1 3 true true false true) MI-LOAD
        (mi-desc-new 1 1 2 true true false true) MI-STORE
        (mi-desc-new 2 0 2 true true false true) MI-RET
        (mi-desc-new 1 0 1 true false true true) MI-CBR
        (mi-desc-new 1 0 1 true false true false) MI-JMP
        (mi-desc-new 0 0 1 true false true false) MI-CBZ
        (mi-desc-new 1 0 1 true false true true) MI-B
        (mi-desc-new 0 0 1 true false true true) MI-LABEL
        (mi-desc-new 0 0 1 true false false true) MI-CSEL
        (mi-desc-new 3 1 0 false false false true) MI-MOV
        (mi-desc-new 1 1 0 false false false true) MI-COPY
        (mi-desc-new 1 1 0 true false false true) MI-CALL
        (mi-desc-new 1 1 3 true true false true) MI-STACKARG
        (mi-desc-new 0 1 0 true false false true) MI-ABI-COPY
        (mi-desc-new 1 1 0 true false false true) MI-JSBOX
        (mi-desc-new 1 1 0 false false false true) MI-JSUNBOX
        (mi-desc-new 1 1 0 false false false true) MI-JSTEST
        (mi-desc-new 1 1 0 false false false true) MI-FMOVI
        (mi-desc-new 0 1 0 false false false true) MI-SCVTF
        (mi-desc-new 1 1 0 false false false true) MI-FADD
        (mi-desc-new 2 1 0 false false false true) MI-FSUB
        (mi-desc-new 2 1 0 false false false true) MI-FMUL
        (mi-desc-new 2 1 0 false false false true) MI-FDIV
        (mi-desc-new 2 1 0 false false false true) MI-FNEG
        (mi-desc-new 1 1 0 false false false true) MI-FEQ
        (mi-desc-new 2 1 0 false false false true) MI-FLT
        (mi-desc-new 2 1 0 false false false true) MI-FLE
        (mi-desc-new 2 1 0 false false false true) MI-FTRUTH
        (mi-desc-new 1 1 0 false false false true) MI-MOD
        (mi-desc-new 2 1 0 false false false true) MI-BITAND
        (mi-desc-new 2 1 0 false false false true) MI-BITOR
        (mi-desc-new 2 1 0 false false false true) MI-BITXOR
        (mi-desc-new 2 1 0 false false false true) MI-SHL
        (mi-desc-new 2 1 0 false false false true) MI-SHR
        (mi-desc-new 2 1 0 false false false true) MI-USHR
        (mi-desc-new 2 1 0 false false false true) MI-BITNOT
        (mi-desc-new 1 1 0 false false false true) MI-I32FROMFP
        (mi-desc-new 1 1 0 false false false true) MI-FMOD
        (mi-desc-new 2 1 3 false false false true) MI-JSPROP
        (mi-desc-new 2 1 3 true true false true) MI-JSARRAY
        (mi-desc-new 2 1 3 false false false true) MI-JSSTRING
        (mi-desc-new 2 1 3 false false false true) (mi-desc-new -1 -1 0 false false false false)))

(defstruct MDescCache
  [(descs (array MOpcodeDesc 52))
   (inited bool)])

;; mi-desc sits inside the per-instruction scans of selection, liveness, and the verifiers;
;; recomputing the case chain on every call dominated large emits.
(defn mi-desc [(op i64)] (-> MOpcodeDesc)
  (let [c (primitive/alloc-static MDescCache)]
    (if (.inited c)
        0
        (let [(mut i) 0]
          (loop (if (>= (load i) MI-OPCODE-COUNT)
                    (break)
                    (do
                      (set! (index (field c descs) (load i)) (mi-desc-compute (load i)))
                      (set! i (+ (load i) 1))
                      0)))
          (set! (.inited c) true)
          0))
    (if (or (< op 0) (>= op MI-OPCODE-COUNT))
        (mi-desc-compute op)
        (load (index (field c descs) op)))))

(defstruct MInputsCache
  [(inputs (array i64 52))
   (inited bool)])

;; The input-operand count alone, as a raw table. Operand-membership queries in the scheduler's
;; instruction-pair loops need only this one field; fetching it through mi-desc copied the whole
;; descriptor struct per query.
(defn mi-inputs [(op i64)] (-> i64)
  (let [c (primitive/alloc-static MInputsCache)]
    (if (.inited c)
        0
        (let [(mut i) 0]
          (loop (if (>= (load i) MI-OPCODE-COUNT)
                    (break)
                    (do
                      (set! (index (field c inputs) (load i)) (mi-desc-inputs (mi-desc-compute (load i))))
                      (set! i (+ (load i) 1))
                      0)))
          (set! (.inited c) true)
          0))
    (if (or (< op 0) (>= op MI-OPCODE-COUNT))
        (mi-desc-inputs (mi-desc-compute op))
        (load (index (field c inputs) op)))))

(defn mi-desc-inputs [(d MOpcodeDesc)] (-> i64)
  (.inputs d))
(defn mi-desc-outputs [(d MOpcodeDesc)] (-> i64)
  (.outputs d))
(defn mi-desc-temporaries [(d MOpcodeDesc)] (-> i64)
  (.temporaries d))
(defn mi-desc-clobbers [(d MOpcodeDesc)] (-> i64)
  ; Effect class 3 is a call/safepoint. x0-x11, d0-d7, and d16-d31 are caller-clobbered.
  ; Physical FP locations occupy bits 32..63 in allocator masks.
  (if (= (.effects d) 3) -280379760046081 (.clobbers d)))
(defn mi-desc-effects [(d MOpcodeDesc)] (-> i64)
  (.effects d))
(defn mi-desc-pinned? [(d MOpcodeDesc)] (-> bool)
  (.pinned d))
(defn mi-desc-memory? [(d MOpcodeDesc)] (-> bool)
  (.memory d))
(defn mi-desc-terminator? [(d MOpcodeDesc)] (-> bool)
  (.terminator d))
(defn mi-desc-encodable? [(d MOpcodeDesc)] (-> bool)
  (.encodable d))

; Keep struct-valued descriptor temporaries out of large compiler loops. Coil currently lowers a
; struct result bound inside a loop as dynamic stack storage whose lifetime is the surrounding
; function; these scalar wrappers bound that storage to one ordinary call frame.
(defn mi-op-inputs [(op i64)] (-> i64)
  (mi-desc-inputs (mi-desc op)))
(defn mi-op-pinned? [(op i64)] (-> bool)
  (mi-desc-pinned? (mi-desc op)))
(defn mi-op-terminator? [(op i64)] (-> bool)
  (mi-desc-terminator? (mi-desc op)))
(defn mi-op-effects [(op i64)] (-> i64)
  (mi-desc-effects (mi-desc op)))

(defn be-emit! [(m MInst)] (-> i64)
  (let [p (backend)
        id (al-len [MInst] (.ins p))]
    (al-push! [MInst] (field p ins) m)
    id))

;; Shared typed ArrayList indexing lives in the core because every later phase uses it.
(defn be-al-elem [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field p data)) i))

;; Expensive structural verification is enabled by default so ordinary unit tests exercise every
;; invariant. Corpus drivers may disable it explicitly; this temporary runtime policy will become
;; an expansion-time `(primitive/testing?)` branch when Coil exposes test compilation context.
(defstruct BackendVerificationPolicy [(enabled bool) (initialized bool)])

(defn be-verification-policy [] (-> (ptr BackendVerificationPolicy))
  (let [policy (primitive/alloc-static BackendVerificationPolicy)]
    (if (not (.initialized policy))
        (do (set! (.enabled policy) true)
            (set! (.initialized policy) true))
        0)
    policy))

(defn be-use-verification! [(enabled bool)] (-> i64)
  (set! (.enabled (be-verification-policy)) enabled)
  0)

(defn be-verification? [] (-> bool)
  (.enabled (be-verification-policy)))

;; Profiling is diagnostic work, not compilation work. Keep it independently switchable from
;; verification so production throughput and phase-traced investigations are both honest.
(defstruct BackendProfilingPolicy [(enabled bool) (initialized bool)])

(defn be-profiling-policy [] (-> (ptr BackendProfilingPolicy))
  (let [policy (primitive/alloc-static BackendProfilingPolicy)]
    (if (.initialized policy)
        0
        (do (set! (.enabled policy) false)
            (set! (.initialized policy) true)))
    policy))

(defn be-use-profiling! [(enabled bool)] (-> i64)
  (set! (.enabled (be-profiling-policy)) enabled)
  0)

(defn be-profiling? [] (-> bool)
  (.enabled (be-profiling-policy)))
