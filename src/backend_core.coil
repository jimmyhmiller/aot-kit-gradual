          (set! (.vreg-use-next u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-head u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-consumer u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-edge-next u) (al-new [i64] (malloc-allocator)))
          (set! (.sched-ready u) (al-new [i64] (malloc-allocator)))
          (set! (.live-vreg-owner u) (al-new [i64] (malloc-allocator)))
          (set! (.live-vreg-local u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-first u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-count u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-words u) (al-new [i64] (malloc-allocator)))
          (set! (.live-owner-vregs u) (al-new [i64] (malloc-allocator)))
          (set! (.live-set-head u) (al-new [i64] (malloc-allocator)))
          (set! (.live-chunk-word u) (al-new [i64] (malloc-allocator)))
          (set! (.live-chunk-bits u) (al-new [i64] (malloc-allocator)))
          (set! (.live-chunk-next u) (al-new [i64] (malloc-allocator)))
          (set! (.live-cursor-set u) -1)
          (set! (.live-cursor-chunk u) -1)
          (set! (.value-kind u) (al-new [i64] (malloc-allocator)))
          (set! (.register-class u) (al-new [i64] (malloc-allocator)))
