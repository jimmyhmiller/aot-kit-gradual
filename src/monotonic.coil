(module monotonic)
(import "coil.primitive" :as primitive)

(defstruct MonotonicTimespec [(sec i64) (nsec i64)])
(extern clock_gettime :cc c [i32 (ptr MonotonicTimespec)] (-> i32))

(defn monotonic-clock-id [] (-> Code)
  (if (= (primitive/target-os) `linux) `1 `6))

;;; CLOCK_MONOTONIC is 1 on Linux and 6 on Darwin. Select the constant while compiling so the
;;; generated profiler contains no runtime platform probing.
(defn monotonic-now-ns [] (-> i64)
  (let [t (primitive/alloc-stack MonotonicTimespec)]
    (clock_gettime (monotonic-clock-id) t)
    (+ (* (.sec t) 1000000000) (.nsec t))))
