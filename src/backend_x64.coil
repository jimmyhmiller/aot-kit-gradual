;; Linux x86-64 encoder for the machine IR.  The selector and scheduler are target-neutral; this
;; module translates their allocated integer operations to the SysV AMD64 instruction stream.
(module backend_x64)

(import "backend_core" :use *)
(import "backend_select" :use *)
(import "backend_liveness" :use *)
(import "backend_allocate" :use *)
(import "shape" :use *)
(import "jsvalue" :use *)
(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

;; The allocator currently numbers its first eight GPR colors like AAPCS64 x0-x7.  Keep that
;; internal color space stable while mapping it to the six SysV argument registers followed by
;; two caller-saved temporaries.  This lets target parameterisation happen at the ABI boundary
;; instead of teaching target-neutral selection about hardware register numbers.
(defn x64-reg [(reg i64)] (-> i64)
  (case reg 0
        7  ; rdi
          1
        6  ; rsi
          2
        2  ; rdx
          3
        1  ; rcx
          4
        8  ; r8
          5
        9  ; r9
          6
        10  ; r10
          7
        11  ; r11
          19
        3   ; rbx (SysV callee-saved)
          20
        13  ; r13 (SysV callee-saved; r12 holds GC thread state)
          -1))

(defn x64-u8! [(v i64)] (-> i64)
  (al-push! [u8] (field (backend) code) (cast u8 (& v 255)))
  0)

(defn x64-u64! [(v i64)] (-> i64)
  (let [(mut shift) 0]
    (loop (if (>= (load shift) 64)
              (break)
              (do
                (x64-u8! (>> v (load shift)))
                (set! shift (+ (load shift) 8))
                0))))
  0)

(defn x64-u32! [(v i64)] (-> i64)
  (let [(mut shift) 0]
    (loop (if (>= (load shift) 32) (break)
              (do (x64-u8! (>> v (load shift)))
                  (set! shift (+ (load shift) 8))))))
  0)

(defn x64-patch32! [(at i64) (v i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) 4) (break)
              (do (al-set! [u8] (field (backend) code) (+ at (load i))
                           (cast u8 (& (>> v (* (load i) 8)) 255)))
                  (set! i (+ (load i) 1))))))
  0)

(defn x64-rex! [(r i64) (b i64)] (-> i64)
  (x64-u8! (| 72 (| (if (>= r 8) 4 0) (if (>= b 8) 1 0)))))

(defn x64-modrm! [(reg i64) (rm i64)] (-> i64)
  (x64-u8! (| 192 (| (<< (& reg 7) 3) (& rm 7)))))

(defn x64-mem! [(reg i64) (base i64) (disp i64)] (-> i64)
  (let [lo (& base 7)
        sib (= lo 4)
        md (if (and (= disp 0) (!= lo 5)) 0 (if (and (>= disp -128) (<= disp 127)) 1 2))]
    (x64-u8! (| (<< md 6) (| (<< (& reg 7) 3) lo)))
    (if sib (x64-u8! (| (<< 4 3) lo)) 0)
    (if (= md 1) (x64-u8! disp) (if (= md 2) (x64-u32! disp) 0))))

(defn x64-load! [(dst i64) (base i64) (disp i64)] (-> i64)
  (x64-rex! dst base) (x64-u8! 139) (x64-mem! dst base disp))
(defn x64-store! [(base i64) (disp i64) (src i64)] (-> i64)
  (x64-rex! src base) (x64-u8! 137) (x64-mem! src base disp))
(defn x64-alu! [(opcode i64) (dst i64) (src i64)] (-> i64)
  (x64-rex! src dst) (x64-u8! opcode) (x64-modrm! src dst))
(defn x64-cmp! [(a i64) (b i64)] (-> i64) (x64-alu! 57 a b))
(defn x64-cmp-imm32! [(reg i64) (imm i64)] (-> i64)
  (x64-rex! 0 reg) (x64-u8! 129) (x64-modrm! 7 reg) (x64-u32! imm))
(defn x64-setcc! [(dst i64) (cc i64)] (-> i64)
  ;; A REX prefix selects sil/dil rather than the legacy high-byte registers.
  (if (or (>= dst 4) (>= dst 8)) (x64-u8! (| 64 (if (>= dst 8) 1 0))) 0)
  (x64-u8! 15) (x64-u8! (+ 144 cc)) (x64-modrm! 0 dst)
  (x64-rex! dst dst) (x64-u8! 15) (x64-u8! 182) (x64-modrm! dst dst))

(defn x64-sp-adjust! [(sub bool) (bytes i64)] (-> i64)
  (if (> bytes 0)
      (do (x64-u8! 72) (x64-u8! 129) (x64-u8! (if sub 236 196)) (x64-u32! bytes)) 0))

(defn x64-mov-rr! [(dst i64) (src i64)] (-> i64)
  (if (= dst src)
      0
      (do
        (x64-rex! src dst)
        (x64-u8! 137)
        (x64-modrm! src dst))))

(defn x64-mov-imm! [(dst i64) (imm i64)] (-> i64)
  (x64-rex! 0 dst)
  (x64-u8! (+ 184 (& dst 7)))
  (x64-u64! imm))

(defn x64-add-rr! [(dst i64) (src i64)] (-> i64)
  (x64-rex! src dst)
  (x64-u8! 1)
  (x64-modrm! src dst))

(defn x64-sub-rr! [(dst i64) (src i64)] (-> i64)
  (x64-rex! src dst)
  (x64-u8! 41)
  (x64-modrm! src dst))

(defn x64-imul-rr! [(dst i64) (src i64)] (-> i64)
  (x64-rex! dst src)
  (x64-u8! 15)
  (x64-u8! 175)
  (x64-modrm! dst src))

(defn x64-neg! [(dst i64)] (-> i64)
  (x64-rex! 0 dst)
  (x64-u8! 247)
  (x64-modrm! 3 dst))

(defn x64-shift-imm! [(dst i64) (kind i64) (amount i64)] (-> i64)
  (x64-rex! 0 dst)
  (x64-u8! 193)
  (x64-modrm! kind dst)
  (x64-u8! amount))

(defn x64-signext32! [(reg i64)] (-> i64)
  (x64-rex! reg reg) (x64-u8! 99) (x64-modrm! reg reg))

(defn x64-shift32! [(reg i64) (kind i64)] (-> i64)
  (if (>= reg 8) (x64-u8! 65) 0)
  (x64-u8! 211) (x64-modrm! kind reg))

(defn x64-ret! [] (-> i64)
  (x64-u8! 195))

(defn x64-location [(vreg i64)] (-> i64)
  (let [reg (mra-reg vreg)]
    (if (or (< reg 0) (>= reg 32)) -1 (x64-reg reg))))

(defn x64-fpr-location [(vreg i64)] (-> i64)
  (let [reg (mra-reg vreg)]
    (if (and (>= reg 32) (< reg 64)) (- reg 32) -1)))

(defn x64-spill-off [(vreg i64)] (-> i64)
  (let [owner (mra-owner vreg) slot (mra-spill vreg)]
    (if (or (< owner 0) (< slot 0))
        -1
        (+ 16 (* (+ (mu-function-callee-count owner) slot) 8)))))

(defn x64-callee-save-off [(owner i64) (reg i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner)
        (mut r) 19
        (mut rank) 0]
    (loop (if (>= (load r) reg)
              (break)
              (do
                (if (!= (& mask (<< 1 (load r))) 0)
                    (set! rank (+ (load rank) 1))
                    0)
                (set! r (+ (load r) 1)))))
    (+ 16 (* (load rank) 8))))

(defn x64-fload! [(dst i64) (base i64) (disp i64)] (-> i64)
  (x64-u8! 242) (x64-rex! dst base) (x64-u8! 15) (x64-u8! 16)
  (x64-mem! dst base disp))

(defn x64-fstore! [(base i64) (disp i64) (src i64)] (-> i64)
  (x64-u8! 242) (x64-rex! src base) (x64-u8! 15) (x64-u8! 17)
  (x64-mem! src base disp))

(defn x64-save-callees! [(owner i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner)
        (mut reg) 19]
    (loop (if (> (load reg) 20)
              (break)
              (do
                (if (!= (& mask (<< 1 (load reg))) 0)
                    (x64-store! 4 (x64-callee-save-off owner (load reg))
                                (x64-reg (load reg)))
                    0)
                (set! reg (+ (load reg) 1)))))
    (set! reg 40)
    (loop (if (> (load reg) 47)
              (break)
              (do
                (if (!= (& mask (<< 1 (load reg))) 0)
                    (x64-fstore! 4 (x64-callee-save-off owner (load reg))
                                 (- (load reg) 32))
                    0)
                (set! reg (+ (load reg) 1))))))
  0)

(defn x64-restore-callees! [(owner i64)] (-> i64)
  (let [mask (mu-function-callee-mask owner)
        (mut reg) 19]
    (loop (if (> (load reg) 20)
              (break)
              (do
                (if (!= (& mask (<< 1 (load reg))) 0)
                    (x64-load! (x64-reg (load reg)) 4
                               (x64-callee-save-off owner (load reg)))
                    0)
                (set! reg (+ (load reg) 1)))))
    (set! reg 40)
    (loop (if (> (load reg) 47)
              (break)
              (do
                (if (!= (& mask (<< 1 (load reg))) 0)
                    (x64-fload! (- (load reg) 32) 4
                                (x64-callee-save-off owner (load reg)))
                    0)
                (set! reg (+ (load reg) 1))))))
  0)

(defn x64-read-gpr! [(vreg i64) (scratch i64)] (-> i64)
  (let [reg (x64-location vreg)]
    (if (>= reg 0)
        reg
        (let [off (x64-spill-off vreg)]
          (if (< off 0) -1 (do (x64-load! scratch 4 off) scratch))))))

(defn x64-read-gpr-delta! [(vreg i64) (scratch i64) (delta i64)] (-> i64)
  (let [reg (x64-location vreg)]
    (if (>= reg 0)
        reg
        (let [off (x64-spill-off vreg)]
          (if (< off 0) -1 (do (x64-load! scratch 4 (+ off delta)) scratch))))))

(defn x64-write-gpr [(vreg i64) (scratch i64)] (-> i64)
  (let [reg (x64-location vreg)]
    (if (>= reg 0) reg (if (>= (x64-spill-off vreg) 0) scratch -1))))

(defn x64-store-gpr! [(vreg i64) (reg i64)] (-> i64)
  (let [off (x64-spill-off vreg)]
    (if (>= off 0) (x64-store! 4 off reg) 0)))

(defn x64-read-fpr! [(vreg i64) (scratch i64)] (-> i64)
  (let [reg (x64-fpr-location vreg)]
    (if (>= reg 0)
        reg
        (let [off (x64-spill-off vreg)]
          (if (< off 0) -1 (do (x64-fload! scratch 4 off) scratch))))))

(defn x64-read-fpr-delta! [(vreg i64) (scratch i64) (delta i64)] (-> i64)
  (let [reg (x64-fpr-location vreg)]
    (if (>= reg 0)
        reg
        (let [off (x64-spill-off vreg)]
          (if (< off 0) -1 (do (x64-fload! scratch 4 (+ off delta)) scratch))))))

(defn x64-write-fpr [(vreg i64) (scratch i64)] (-> i64)
  (let [reg (x64-fpr-location vreg)]
    (if (>= reg 0) reg (if (>= (x64-spill-off vreg) 0) scratch -1))))

(defn x64-store-fpr! [(vreg i64) (reg i64)] (-> i64)
  (let [off (x64-spill-off vreg)]
    (if (>= off 0) (x64-fstore! 4 off reg) 0)))

(defn x64-movq-xr! [(xd i64) (rs i64)] (-> i64)
  (x64-u8! 102) (x64-rex! xd rs) (x64-u8! 15) (x64-u8! 110) (x64-modrm! xd rs))
(defn x64-movq-rx! [(rd i64) (xs i64)] (-> i64)
  (x64-u8! 102) (x64-rex! xs rd) (x64-u8! 15) (x64-u8! 126) (x64-modrm! xs rd))
(defn x64-cvtsi2sd! [(xd i64) (rs i64)] (-> i64)
  (x64-u8! 242) (x64-rex! xd rs) (x64-u8! 15) (x64-u8! 42) (x64-modrm! xd rs))
(defn x64-cvttsd2si! [(rd i64) (xs i64)] (-> i64)
  (x64-u8! 242) (x64-rex! rd xs) (x64-u8! 15) (x64-u8! 44) (x64-modrm! rd xs))
(defn x64-fop! [(opcode i64) (dst i64) (src i64)] (-> i64)
  (x64-u8! 242) (x64-rex! dst src) (x64-u8! 15) (x64-u8! opcode) (x64-modrm! dst src))
(defn x64-fmov! [(dst i64) (src i64)] (-> i64)
  (if (= dst src) 0 (x64-fop! 16 dst src)))

(defn x64-fcmp! [(left i64) (right i64)] (-> i64)
  (x64-u8! 102) (x64-rex! left right) (x64-u8! 15) (x64-u8! 46)
  (x64-modrm! left right))

(defn x64-fset-ordered! [(dst i64) (cc i64)] (-> i64)
  (x64-setcc! dst cc)
  (x64-setcc! 0 11) ; setnp: ordered operands
  (x64-alu! 33 dst 0))

(defn x64-label-off [(label i64)] (-> i64)
  (let [(mut i) 0 (mut answer) -1]
    (loop (if (or (>= (load i) (be-inst-count)) (>= (load answer) 0)) (break)
              (do (let [m (be-inst (load i))]
                    (if (and (= (.op m) MI-LABEL) (= (.imm m) label))
                        (set! answer (.first m)) 0))
                  (set! i (+ (load i) 1)))))
    (load answer)))

(defn x64-entry-owner [(bid i64)] (-> i64)
  (let [(mut owner) 0 (mut answer) -1]
    (loop (if (or (>= (load owner) (mu-function-count)) (>= (load answer) 0)) (break)
              (do (if (= (mu-function-block (load owner) 0) bid)
                      (set! answer (load owner)) 0)
                  (set! owner (+ (load owner) 1)))))
    (load answer)))

(defn x64-call-class-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [class (ml-register-class (ms-inst-arg (load (x64-current-inst)) which))
        (mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do (if (= (ml-register-class (ms-inst-arg (load (x64-current-inst)) (load i))) class)
                      (set! index (+ (load index) 1)) 0)
                  (set! i (+ (load i) 1)))))
    (load index)))

(defn x64-call-stack-index [(m (ptr MInst)) (which i64)] (-> i64)
  (let [(mut i) 0
        (mut index) 0]
    (loop (if (>= (load i) which)
              (break)
              (do (if (>= (x64-call-class-index m (load i)) 8)
                      (set! index (+ (load index) 1)) 0)
                  (set! i (+ (load i) 1)))))
    (load index)))

(defn x64-copy! [(dst i64) (src i64)] (-> bool)
  (let [rd (x64-location dst)
        rs (x64-location src)]
    (if (or (< rd 0) (< rs 0))
        false
        (do (x64-mov-rr! rd rs) true))))

(defn x64-variable-shift! [(m (ptr MInst)) (kind i64) (signed bool)] (-> i64)
  (let [left (x64-read-gpr! (.a m) 14)
        right (x64-read-gpr! (.b m) 15)
        to (x64-write-gpr (.dst m) 14)]
    (if (or (< left 0) (< right 0) (< to 0))
        (x64-fail! (.node m))
        (do
          ;; CL is implicit. Save any unrelated allocated rcx value, then publish the result only
          ;; after restoring it (the destination itself may legitimately be rcx).
          (x64-mov-rr! 0 1)
          (x64-mov-rr! 14 left)
          (x64-mov-rr! 1 right)
          (x64-shift32! 14 kind)
          (if signed (x64-signext32! 14) 0)
          (x64-mov-rr! 1 0)
          (x64-mov-rr! to 14)
          (x64-store-gpr! (.dst m) to))))
  0)

(defn x64-runtime-call! [(m (ptr MInst)) (at i64)] (-> i64)
  (let [value (ms-inst-arg at 0)
        rd (x64-write-gpr (.dst m) 14)]
    ;; Machine allocation inherits AArch64's eight callee-saved FP colors. SysV has no
    ;; callee-saved XMM registers, so protect those colors explicitly across C runtime calls.
    (x64-sp-adjust! true 96)
    (let [(mut fp) 8]
      (loop (if (> (load fp) 15)
                (break)
                (do (x64-fstore! 4 (+ 32 (* (- (load fp) 8) 8)) (load fp))
                    (set! fp (+ (load fp) 1))))))
    (if (and (= (.op m) MI-JSSTRING) (= (.imm m) JSSOP-FROM-DOUBLE-BITS))
        (let [fa (x64-read-fpr-delta! (.a m) 15 96)]
          (if (< fa 0) (x64-fail! (.node m))
              (do (x64-movq-rx! 14 fa) (x64-store! 4 0 14))))
        (let [ra (x64-read-gpr-delta! (.a m) 14 96)]
          (if (< ra 0) (x64-fail! (.node m)) (x64-store! 4 0 ra))))
    (let [rb (x64-read-gpr-delta! (.b m) 14 96)]
      (if (< rb 0) (x64-fail! (.node m)) (x64-store! 4 8 rb)))
    (let [rv (x64-read-gpr-delta! value 14 96)]
      (if (< rv 0) (x64-fail! (.node m)) (x64-store! 4 16 rv)))
    (x64-load! 7 4 0)
    (if (= (.op m) MI-JSPROP)
        (do (x64-load! 6 4 16) (x64-load! 2 4 8))
        (do (x64-load! 6 4 8) (x64-load! 2 4 16)))
    (x64-mov-imm! 1 (.imm m))
    (x64-u8! 232)
    (set! (.last m) (al-len [u8] (.code (backend))))
    (x64-u32! 0)
    (set! (.earliest m) (al-len [u8] (.code (backend))))
    (let [(mut fp) 8]
      (loop (if (> (load fp) 15)
                (break)
                (do (x64-fload! (load fp) 4 (+ 32 (* (- (load fp) 8) 8)))
                    (set! fp (+ (load fp) 1))))))
    (x64-sp-adjust! false 96)
    (if (< rd 0)
        (x64-fail! (.node m))
        (do (x64-mov-rr! rd 0) (x64-store-gpr! (.dst m) rd)))
    0))

(defn x64-current-op [] (-> (ptr i64)) (let [v (alloc/static i64)] v))
(defn x64-current-owner [] (-> (ptr i64)) (let [v (alloc/static i64)] v))
(defn x64-current-inst [] (-> (ptr i64)) (let [v (alloc/static i64)] v))

(defn x64-fail! [(node i64)] (-> i64)
  (let [m (be-inst (load (x64-current-inst)))]
    (fmt (stderr) "x64-encoding: unsupported op={d} node={d} owner={d} inst={d} dst={d}/{d}/{d} a={d}/{d}/{d} b={d}/{d}/{d}\n"
         (load (x64-current-op)) node (load (x64-current-owner)) (load (x64-current-inst))
         (.dst m) (if (< (.dst m) 0) -1 (mra-reg (.dst m)))
         (if (< (.dst m) 0) -1 (mra-spill (.dst m)))
         (.a m) (if (< (.a m) 0) -1 (mra-reg (.a m)))
         (if (< (.a m) 0) -1 (mra-spill (.a m)))
         (.b m) (if (< (.b m) 0) -1 (mra-reg (.b m)))
         (if (< (.b m) 0) -1 (mra-spill (.b m)))))
  (be-fail! BER-ENCODING node)
  0)

;; Encode allocated Machine IR. Unsupported operations fail atomically; they must never be
;; mistaken for successfully emitted code.
(defn be-x64-encode-checked! [] (-> bool)
  (if (!= (be-result) BER-OK)
      false
      (let [n (be-inst-count)
            (mut at) 0]
        (al-clear! [u8] (field (backend) code))
        (loop (if (or (>= (load at) n) (!= (be-result) BER-OK))
                  (break)
                  (do
                    (let [m (be-inst (load at))
                          op (.op m)
                          dst (x64-location (.dst m))
                          a (x64-location (.a m))
                          b (x64-location (.b m))
                          fdst (x64-fpr-location (.dst m))
                          fa (x64-fpr-location (.a m))
                          fb (x64-fpr-location (.b m))]
                      (set! (x64-current-op) op)
                      (set! (x64-current-owner) (.owner m))
                      (set! (x64-current-inst) (load at))
                      (set! (.first m) (al-len [u8] (.code (backend))))
                      (case op MI-LABEL
                            (let [owner (x64-entry-owner (.imm m))]
                              (if (< owner 0) 0
                                  (do (x64-u8! 85) (x64-u8! 72) (x64-u8! 137) (x64-u8! 229)
                                      (x64-sp-adjust! true (mu-function-frame-size owner))
                                      (x64-save-callees! owner)))) MI-ARG
                            0 MI-ABI-COPY
                            (let [from (x64-read-gpr! (.a m) 0)
                                  to (x64-write-gpr (.dst m) 14)]
                              (if (or (< from 0) (< to 0))
                                  (x64-fail! (.node m))
                                  (do (x64-mov-rr! to from) (x64-store-gpr! (.dst m) to))))
                              MI-COPY
                            (let [from (x64-read-gpr! (.a m) 0)
                                  to (x64-write-gpr (.dst m) 14)]
                              (if (or (< from 0) (< to 0))
                                  (x64-fail! (.node m))
                                  (do (x64-mov-rr! to from) (x64-store-gpr! (.dst m) to))))
                              MI-MOV
                            (let [from (x64-read-gpr! (.a m) 0)
                                  to (x64-write-gpr (.imm m) 14)]
                              (if (or (< from 0) (< to 0))
                                  (x64-fail! (.node m))
                                  (do (x64-mov-rr! to from) (x64-store-gpr! (.imm m) to))))
                              MI-MOVI
                            (let [to (x64-write-gpr (.dst m) 0)]
                              (if (< to 0)
                                  (x64-fail! (.node m))
                                  (do (x64-mov-imm! to (.imm m))
                                      (x64-store-gpr! (.dst m) to))))
                              MI-FMOVI
                            (let [to (x64-write-fpr (.dst m) 14)]
                              (if (< to 0)
                                (x64-fail! (.node m))
                                  (do (x64-mov-imm! 0 (.imm m)) (x64-movq-xr! to 0)
                                      (x64-store-fpr! (.dst m) to))))
                              MI-SCVTF
                            (let [to (x64-write-fpr (.dst m) 14)
                                  from (x64-read-gpr! (.a m) 14)]
                              (if (or (< to 0) (< from 0))
                                  (x64-fail! (.node m))
                                  (do (x64-cvtsi2sd! to from)
                                      (x64-store-fpr! (.dst m) to))))
                              MI-I32FROMFP
                            (let [to (x64-write-gpr (.dst m) 14)
                                  from (x64-read-fpr! (.a m) 14)]
                              (if (or (< to 0) (< from 0))
                                  (x64-fail! (.node m))
                                  (do
                                    (x64-cvttsd2si! to from)
                                    (x64-rex! to to) (x64-u8! 99) (x64-modrm! to to)
                                    (x64-store-gpr! (.dst m) to))))
                              MI-FADD
                            (let [to (x64-write-fpr (.dst m) 14)
                                  left (x64-read-fpr! (.a m) 14)
                                  right (x64-read-fpr! (.b m) 15)]
                              (if (or (< to 0) (< left 0) (< right 0))
                                  (x64-fail! (.node m))
