                                        ;; Decode a bare function id or a closure environment's
                                        ;; target field into rax without disturbing call arguments.
                                        (x64-load! 0 4 (* argc 8))
                                        (x64-mov-rr! 14 0)
                                        (x64-mov-imm! 15 JSV-TAG-MASK)
                                        (x64-alu! 33 14 15)
                                        (x64-mov-imm! 15 JSV-FUNCTION)
                                        (x64-cmp! 14 15)
                                        (x64-u8! 15) (x64-u8! 132)
                                        (set! function-branch (al-len [u8] (.code (backend)))) (x64-u32! 0)
                                        (x64-mov-imm! 15 JSV-OBJECT)
                                        (x64-cmp! 14 15)
                                        (x64-u8! 15) (x64-u8! 132)
                                        (set! closure-branch (al-len [u8] (.code (backend)))) (x64-u32! 0)
                                        (x64-u8! 15) (x64-u8! 11)
                                        (set! closure-at (al-len [u8] (.code (backend))))
                                        (x64-mov-imm! 15 JSV-PAYLOAD-MASK)
                                        (x64-alu! 33 0 15)
                                        (x64-load! 0 0 8)
                                        (x64-u8! 233)
                                        (set! decoded-jump (al-len [u8] (.code (backend)))) (x64-u32! 0)
                                        (set! function-at (al-len [u8] (.code (backend))))
                                        (x64-mov-imm! 15 JSV-PAYLOAD-MASK)
                                        (x64-alu! 33 0 15)
                                        (set! decoded-at (al-len [u8] (.code (backend))))
                                        (x64-patch32! (load function-branch)
                                                      (- (load function-at) (+ (load function-branch) 4)))
                                        (x64-patch32! (load closure-branch)
                                                      (- (load closure-at) (+ (load closure-branch) 4)))
                                        (x64-patch32! (load decoded-jump)
                                                      (- (load decoded-at) (+ (load decoded-jump) 4)))
                                        (loop (if (>= (load owner) (mu-function-count))
                                                  (break)
                                                  (let [symbol (al-get (.symbols (machine-unit)) (load owner))]
                                                    (if (>= symbol 1)
                                                        (let [(mut skip) 0]
                                                          (x64-cmp-imm32! 0 symbol)
                                                          (x64-u8! 15) (x64-u8! 133)
                                                          (set! skip (al-len [u8] (.code (backend)))) (x64-u32! 0)
                                                          (x64-u8! 232)
                                                          (let [call-off (al-len [u8] (.code (backend)))]
                                                            (x64-u32! 0)
                                                            (al-push! [i64] (field (backend) x64-poly-call-offs) call-off)
                                                            (al-push! [i64] (field (backend) x64-poly-call-targets) (load owner)))
                                                          (let [kind (be-function-return-kind (load owner))]
                                                            (if (= kind MLK-BOXED) 0
                                                                (if (and (= kind MLK-SCALAR)
                                                                         (be-function-fp-return? (load owner)))
                                                                    (x64-movq-rx! 0 0)
                                                                    (do (x64-mov-imm! 14 JSV-PAYLOAD-MASK)
                                                                        (x64-alu! 33 0 14)
                                                                        (x64-mov-imm! 14 (be-function-return-tag (load owner)))
                                                                        (x64-alu! 9 0 14)))))
                                                          (x64-u8! 233)
                                                          (al-push! [i64] (field (backend) x64-poly-end-offs)
                                                                    (al-len [u8] (.code (backend))))
                                                          (x64-u32! 0)
                                                          (x64-patch32! (load skip)
                                                                        (- (al-len [u8] (.code (backend)))
                                                                           (+ (load skip) 4)))) 0)
                                                    (set! owner (+ (load owner) 1)))))
                                        (x64-u8! 15) (x64-u8! 11)
                                        (let [end (al-len [u8] (.code (backend)))
                                              (mut e) first-end]
                                          (loop (if (>= (load e) (al-len [i64] (.x64-poly-end-offs (backend))))
                                                    (break)
                                                    (do (let [off (al-get (.x64-poly-end-offs (backend)) (load e))]
                                                          (x64-patch32! off (- end (+ off 4))))
                                                        (set! e (+ (load e) 1))))))
                                        (set! (.earliest m) (al-len [u8] (.code (backend)))))
                                      (do (x64-u8! 232)
                                          (set! (.last m) (al-len [u8] (.code (backend))))
                                          (x64-u32! 0)
                                          (set! (.earliest m) (al-len [u8] (.code (backend))))))
                                  (if (= (ml-register-class (.dst m)) MRC-FPR)
                                      (let [to (x64-write-fpr (.dst m) 14)]
                                        (if (< to 0) (x64-fail! (.node m))
                                            (do (x64-fmov! 14 0)
                                                (x64-sp-adjust! false area)
                                                (x64-fmov! to 14)
                                                (x64-store-fpr! (.dst m) to))))
                                      (let [to (x64-write-gpr (.dst m) 14)]
                                        (if (< to 0) (x64-fail! (.node m))
                                            (do (x64-mov-rr! 14 0)
                                                (x64-sp-adjust! false area)
                                                (x64-mov-rr! to 14)
                                                (x64-store-gpr! (.dst m) to))))))
                              MI-STACKARG
                            (let [is-fp (= (ml-register-class (.dst m)) MRC-FPR)
                                  to (if is-fp (x64-write-fpr (.dst m) 14)
                                         (x64-write-gpr (.dst m) 14))
                                  ;; At entry the return address is at rsp+0. The prologue then
                                  ;; pushes rbp before subtracting the aligned frame, so incoming
                                  ;; stack arguments begin at frame+16 from the post-prologue rsp.
                                  off (+ (+ (mu-function-frame-size (.owner m)) 16) (* (.imm m) 8))]
                              (if (< to 0) (x64-fail! (.node m))
                                  (if is-fp
                                      (do (x64-fload! to 4 off) (x64-store-fpr! (.dst m) to))
                                      (do (x64-load! to 4 off) (x64-store-gpr! (.dst m) to)))))
                              MI-JSPROP
                            (x64-runtime-call! m (load at)) MI-JSARRAY
                            (x64-runtime-call! m (load at)) MI-JSSTRING
                            (x64-runtime-call! m (load at))
                              MI-RET
                            (let [is-fp (= (ml-register-class (.a m)) MRC-FPR)
                                  result (if is-fp (x64-read-fpr! (.a m) 14)
                                             (x64-read-gpr! (.a m) 14))]
                              (if (< result 0)
                                  (x64-fail! (.node m))
                                  (do (if is-fp (x64-fmov! 0 result) (x64-mov-rr! 0 result))
                                    (if (< (.owner m) 0) 0
                                        (do (x64-restore-callees! (.owner m))
                                            (x64-sp-adjust! false (mu-function-frame-size (.owner m)))
                                            (x64-u8! 93)))
                                      (x64-ret!))))
                              (x64-fail! (.node m))))
                    (set! at (+ (load at) 1))
                    0)))
        ;; Resolve block-relative branches after all variable-length instructions have exact PCs.
        (if (= (be-result) BER-OK)
            (let [(mut j) 0]
              (loop (if (>= (load j) n) (break)
                        (do (let [m (be-inst (load j)) op (.op m)]
                              (case op MI-B (x64-patch32! (.last m)
                                                         (- (x64-label-off (.imm m)) (.earliest m)))
                                    MI-JMP (x64-patch32! (.last m)
                                                        (- (x64-label-off (.imm m)) (.earliest m)))
                                    MI-CBZ (x64-patch32! (.last m)
                                                        (- (x64-label-off (.imm m)) (.earliest m)))
                                    MI-CBR (do (x64-patch32! (.last m)
                                                            (- (x64-label-off (.b m)) (.earliest m)))
                                               (x64-patch32! (.latest m)
                                                             (- (x64-label-off (.imm m)) (.schedule-order m))))
                                    0))
                            (set! j (+ (load j) 1)))))) 0)
        (if (= (be-result) BER-OK)
            (let [(mut fixup) 0]
              (loop (if (>= (load fixup) (al-len [i64] (.x64-poly-call-offs (backend))))
                        (break)
                        (do (let [off (al-get (.x64-poly-call-offs (backend)) (load fixup))
                                  owner (al-get (.x64-poly-call-targets (backend)) (load fixup))
                                  target (x64-label-off (mu-function-block owner 0))]
                              (if (< target 0) (x64-fail! -1)
                                  (x64-patch32! off (- target (+ off 4)))))
                            (set! fixup (+ (load fixup) 1)))))) 0)
        ;; Internal direct calls are also made executable in the raw byte stream used by focused
        ;; backend tests. ELF RELA relocations overwrite these addends when an object is linked.
        (if (= (be-result) BER-OK)
            (let [(mut call) 0]
              (loop (if (>= (load call) n)
                        (break)
                        (do (let [m (be-inst (load call))]
                              (if (and (= (.op m) MI-CALL) (>= (.imm m) 0))
                                  (let [target (x64-label-off (mu-function-block (.imm m) 0))]
                                    (if (< target 0) (x64-fail! (.node m))
                                        (x64-patch32! (.last m) (- target (.earliest m)))))
                                  0))
                            (set! call (+ (load call) 1)))))) 0)
        ;; Exact function ranges are consumed by both ELF symbols and stack maps.
        (let [(mut owner) 0]
          (loop (if (>= (load owner) (mu-function-count)) (break)
                    (do (let [f (mu-function (load owner)) start (x64-label-off (mu-function-block (load owner) 0))
                              end (if (= (+ (load owner) 1) (mu-function-count))
                                      (al-len [u8] (.code (backend)))
                                      (x64-label-off (mu-function-block (+ (load owner) 1) 0)))]
                          (set! (.code-start f) start) (set! (.code-size f) (- end start)))
                        (set! owner (+ (load owner) 1)))))
        (and (= (be-result) BER-OK) (> (al-len [u8] (.code (backend))) 0))))))

(defn be-x64-code-len [] (-> i64)
  (if (= (be-result) BER-OK) (al-len [u8] (.code (backend))) 0))

(defn be-x64-code-byte [(at i64)] (-> i64)
  (cast i64 (al-get (.code (backend)) at)))
