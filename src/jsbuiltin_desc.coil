;; Pure descriptor metadata shared by indexing, lowering, evaluation, and native selection.
(module jsbuiltin_desc)

(import "coil.slice" :use *)
(import "coil.str" :use *)

(const JBI-ABS i64 0)
(const JBI-FLOOR i64 1)
(const JBI-CEIL i64 2)
(const JBI-ROUND i64 3)
(const JBI-EXP i64 4)
(const JBI-LOG i64 5)
(const JBI-SIN i64 6)
(const JBI-COS i64 7)
(const JBI-TAN i64 8)
(const JBI-ASIN i64 9)
(const JBI-ACOS i64 10)
(const JBI-ATAN i64 11)
(const JBI-SQRT i64 12)
(const JBI-POW i64 13)
(const JBI-MAX i64 14)
(const JBI-MIN i64 15)
(const JBI-RANDOM i64 16)
;;; `Math.sign` and `Math.trunc` are here so the frontend can RECOGNISE them; the code that runs
;;; comes from `MathSign` and `MathTrunc` in lib/math/rounding.jsl, which were written and verified
;;; against Node long before any program could name them. They are the only two Math entries whose
;;; conversion is pure: `floor`, `ceil` and `round` still bottom out in `OPTAG-JSBUILTIN` through
;;; `%FloorNum` and friends, and these two do not reach the descriptor runtime at all.
(const JBI-SIGN i64 17)
(const JBI-TRUNC i64 18)
(const JBI-COUNT i64 19)
(const JBI-NONE i64 -1)
(const JBI-RESULT-NUMBER i64 0)
(const JBI-COERCE-NUMBER i64 0)

(defn jbi-name [(id i64)] (-> (slice u8))
  (case id JBI-ABS "Math.abs" JBI-FLOOR "Math.floor" JBI-CEIL "Math.ceil"
        JBI-ROUND "Math.round" JBI-EXP "Math.exp" JBI-LOG "Math.log"
        JBI-SIN "Math.sin" JBI-COS "Math.cos" JBI-TAN "Math.tan"
        JBI-ASIN "Math.asin" JBI-ACOS "Math.acos" JBI-ATAN "Math.atan"
        JBI-SQRT "Math.sqrt" JBI-POW "Math.pow" JBI-MAX "Math.max"
        JBI-MIN "Math.min" JBI-RANDOM "Math.random"
        JBI-SIGN "Math.sign" JBI-TRUNC "Math.trunc" "<unknown>"))

(defn jbi-find [(name (slice u8))] (-> i64)
  (let [(mut id) 0 (mut found) JBI-NONE]
    (loop (if (or (>= (load id) JBI-COUNT) (!= (load found) JBI-NONE))
              (break)
              (do
                (if (= name (jbi-name (load id))) (set! found (load id)) 0)
                (set! id (+ (load id) 1)))))
    (load found)))

(defn jbi-min-arity [(id i64)] (-> i64)
  (if (= id JBI-RANDOM) 0 (if (or (= id JBI-POW) (or (= id JBI-MAX) (= id JBI-MIN))) 2 1)))
(defn jbi-max-arity [(id i64)] (-> i64) (jbi-min-arity id))
(defn jbi-result-kind [(id i64)] (-> i64) JBI-RESULT-NUMBER)
(defn jbi-coercion [(id i64)] (-> i64) JBI-COERCE-NUMBER)
(defn jbi-allocates? [(id i64)] (-> bool) false)
(defn jbi-safepoint? [(id i64)] (-> bool) false)
(defn jbi-valid-arity? [(id i64) (arity i64)] (-> bool)
  (and (>= id 0) (and (>= arity (jbi-min-arity id)) (<= arity (jbi-max-arity id)))))
