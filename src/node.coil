;; The sea-of-nodes graph: nodes, edges, peepholes, global value numbering, worklist.
;;
;; A node is (op, type, inputs, outputs). Inputs are use-def edges, ordered, possibly null
;; (NO-NODE), with input 0 conventionally the controlling node. Outputs are the def-use
;; direction and are maintained automatically, so the graph walks both ways.
;;
;; Three behaviours define an op, and together they are the whole optimiser:
;;
;;   n-compute    the node's type from its inputs' types. MUST BE MONOTONE: if the inputs
;;                only fall in the lattice, the result only falls. That is what makes the
;;                optimistic dataflow pass in M7 both terminate and be correct.
;;   n-idealize   a local rewrite to a better node, or NO-NODE for "no change".
;;   node-hash / node-eq   structural identity, for global value numbering.
;;
;; `n-peephole` composes them: recompute the type, replace with a constant if the type says
;; so, idealize, then value-number. Running it while the graph is being built keeps the graph
;; near-minimal instead of building garbage and sweeping later.
(module node)

(import "coil.alloc" :use * :as alloc)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.control" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)
(import "ty" :use *)
;; The shape table, for `New`'s field count and its per-field aliases. The dependency runs one
;; way only (shape.coil imports ty.coil and nothing else), and it is what lets a memory op carry
;; an alias number instead of a shape and an offset.
(import "shape" :use *)
(import "jsint32" :use *)
(import "monotonic" :as monotonic)

(defn node-profile-now [] (-> i64)
  (monotonic/monotonic-now-ns))

;; A node id is a plain `i64` index into the arena, for the same reason a type id is: a
;; one-field struct would be passed by reference in Coil. `nid`/`n` for node ids, `t` for
;; type ids, so the two never get mixed up by accident.
(const NO-NODE i64 -1)

; ============================================================================
; Ops
; ============================================================================
;; An opcode and its metadata are one value. Variants carry only metadata meaningful for that
;; operation, so nonsense states such as Add with an arbitrary aux word are unrepresentable.
(defsum Op
  (Start)
  (Stop)
  (Return)
  (If)
  (Region)
  (Loop)
  (CProj [(slot i64)])
  (XCtrl)
  (Const [(ty i64)])
  (Arg [(ty i64)])
  (Proj [(slot i64)])
  (Phi [(declared i64)])
  (Cast [(target i64)])
  (Add)
  (Sub)
  (Mul)
  (Div)
  (Minus)
  (Not)
  (Eq)
  (Lt)
  (Le)
  (New [(shape i64)])
  (Load [(alias i64)])
  (Store [(alias i64)])
  (MemMerge)
  (Box [(mode i64)])
  (Unbox [(target i64)])
  (TypeTest [(target i64)])
  (CallEnd)
  (Fun [(index i64)])
  (CallableId [(index i64)])
  (Parm [(index i64)])
  (Call [(abi i64)])
  (FunStart)
  (Closure [(captures i64)])
  (Safepoint)
  (Barrier)
  (Mod)
  (BitAnd)
  (BitOr)
  (BitXor)
  (Shl)
  (Shr)
  (UShr)
  (BitNot)
  (PropLoad [(name i64)])
  (PropStore [(name i64)])
  (SetProto)
  (ArrayMark)
  (ArrayLoad [(alias i64)])
  (ArrayStore)
  (ArrayLen)
  (ArrayResize)
  (ArrayCopy)
  (StringConst [(id i64)])
  (StringLen)
  (StringEq)
  (StringConcat)
  (StringCharCode)
  (StringSubstring [(mode i64)])
  (ToString)
  (ParseInt)
  (IsNaN)
  (StringSplit)
  (StringFromCodeUnit)
  (NumberToString)
  (ToFixed)
  (StringAlloc)
  (StringSetUnit)
  (StringIndexOf)
  (StringCompare)
  (JsBuiltin [(descriptor i64)])
  (JsThrow)
  (ToInteger)
  (ToNumber)
  (ArrayTest)
  (ArrayUnbox)
  (ParseFloat)
  (PropHas [(name i64)])
  (PropDelete [(name i64)])
  (ProtoHas)
  ;; Aux selects the representation operation. Zero/one are ordinary [[Get]]/[[Set]];
  ;; descriptor metadata uses the same key/value ABI with operations 14/15.
  (PropLoadKey [(operation i64)])
  (PropStoreKey [(operation i64)])
  (PropHasKey)
  (PropDeleteKey)
  (OwnKeyCount)
  (OwnKeyAt)
  (ObjectFreeze)
  (InternalLoad [(slot i64)])
  (InternalStore [(operation i64)])
  (StringNormalize)
  ;; Orders an externally effectful value-producing operation in the memory chain without
  ;; introducing another runtime operation. Input 0 is control, 1 is prior memory, 2 is the
  ;; value whose evaluation must occur before the outgoing memory is observed.
  (Effect))

;; A concise variant test that still expands to ordinary pattern matching. The payload pattern is
;; explicit at each call site, so a payload change remains a compile-time migration rather than a
;; hidden tag comparison.
(defn op-is? [(op Code) (variant Code) (payload Code)] (-> Code)
  `(match (n-op ~op) (~variant ~payload true) (_ false)))

(defn op-value-is? [(op Code) (variant Code) (payload Code)] (-> Code)
  `(match ~op (~variant ~payload true) (_ false)))

(defn def-op-payload-accessor [(name Code) (variant Code) (label Code)] (-> Code)
  `(defn ~name [(node i64)] (-> i64)
     (match (n-op node)
       (~variant [payload] payload)
       (_ (do (panic-corrupt ~label) 0)))))

(const OPTAG-START i64 0)  ; the root of control
(const OPTAG-STOP i64 1)  ; collects every Return
(const OPTAG-RETURN i64 2)  ; (ctrl, value)
(const OPTAG-IF i64 3)  ; (ctrl, predicate) -> a tuple of two controls
(const OPTAG-REGION i64 4)  ; (_, ctrl...) a control merge; input 0 is unused
(const OPTAG-LOOP i64 5)  ; a Region whose input 1 is the entry and input 2 the back edge
(const OPTAG-CPROJ i64 6)  ; (multi) control projection; aux = which slot
(const OPTAG-XCTRL i64 7)  ; the unreachable-control constant
(const OPTAG-CTRL-END i64 7)  ; ops <= this produce control

(const OPTAG-CONST i64 8)  ; aux = the constant's TyId
(const OPTAG-ARG i64 9)  ; an opaque value of a declared type; aux = that TyId
(const OPTAG-PROJ i64 10)  ; (multi) data projection; aux = which slot
(const OPTAG-PHI i64 11)  ; (region, value...) one value per region path
(const OPTAG-CAST i64 12)  ; (ctrl, value) upcast to aux, on a control path
(const OPTAG-ADD i64 13)
(const OPTAG-SUB i64 14)
(const OPTAG-MUL i64 15)
(const OPTAG-DIV i64 16)
(const OPTAG-MINUS i64 17)  ; unary negate
(const OPTAG-NOT i64 18)  ; logical not, over JS truthiness
(const OPTAG-EQ i64 19)
(const OPTAG-LT i64 20)
(const OPTAG-LE i64 21)

;; MEMORY. Four ops, and the input layouts are the whole of memory SSA, so they are written out
;; here rather than left to be read off `v-check-slots`:
;;
;;   New      (ctrl, mem-of-field-0, mem-of-field-1, ...)   aux = the shape
;;            a MULTI node: slot 0 of its tuple is the object, slot 1+i is field i's new memory.
;;            Input slot 1+i and output slot 1+i are the same alias, which is what makes the
;;            allocation a link in every one of its fields' memory chains rather than a node
;;            that appears out of nowhere.
;;   Load     (_, mem, ptr)                                 aux = the alias
;;   Store    (_, mem, ptr, val)                            aux = the alias
;;   MemMerge (_, mem, mem, ...)                            one memory over the union of theirs
;;
;; SLOT 0 OF Load, Store AND MemMerge IS THE ORDINARY CONTROL ANCHOR, null today, exactly as an
;; Add's is: a memory op is ordered by its MEMORY edge and by nothing else, which is the property
;; that makes forwarding fall out of dataflow. `New` is the exception and its control input is
;; real: an allocation happening twice is two objects, so its identity is a function of the block
;; it is in and it cannot float.
(const OPTAG-NEW i64 22)
(const OPTAG-LOAD i64 23)
(const OPTAG-STORE i64 24)
(const OPTAG-MEMMERGE i64 25)
(const OPTAG-BOX i64 26)  ; (_, value) -> one dynamically represented word
(const BOX-AUX-INFER i64 0)
(const BOX-AUX-ARRAY i64 1) ; preserve an Array tag across recursive representation boundaries
(const BOX-AUX-INT i64 2) ; a statically raw machine integer crossing into the dyn ABI
(const OPTAG-UNBOX i64 27)  ; (_, boxed value), aux = required unboxed type
(const OPTAG-TYPETEST i64 28)  ; (_, dynamic value), aux = tested type
(const OPTAG-CALLEND i64 29)  ; (ctrl, call) control after a completed call
(const OPTAG-FUN i64 30)  ; (FunStart, body Returns...), aux = closed-world function index
(const FUN-IDENTITY-EPHEMERAL i64 0)
(const FUN-IDENTITY-SOURCE i64 1)
(const FUN-IDENTITY-JSL i64 2)
(const OPTAG-PARM i64 31)  ; (Fun), aux = zero-based parameter index
(const OPTAG-CALL i64 32)  ; (ctrl, callee, args...) -> value
(const OPTAG-FUNSTART i64 33)  ; (Fun) control entry for one dynamic invocation
(const OPTAG-CLOSURE i64 34)  ; (Fun, captures...) -> callable environment
(const CALL-ABI-LEGACY i64 0)
(const CALL-ABI-RECEIVER i64 1)
(const CALL-ABI-DYNAMIC-RECEIVER i64 2)
(const CALL-ABI-CAPTURE-BASE i64 3) ; aux = base + explicit capture prefix count
(const OPTAG-SAFEPOINT i64 35)  ; (ctrl, live refs...) -> (ctrl, relocated refs...)
(const OPTAG-BARRIER i64 36)  ; (ctrl, mem, object, stored ref) -> mem
(const OPTAG-MOD i64 37)
(const OPTAG-BITAND i64 38)
(const OPTAG-BITOR i64 39)
(const OPTAG-BITXOR i64 40)
(const OPTAG-SHL i64 41)
(const OPTAG-SHR i64 42)
(const OPTAG-USHR i64 43)
(const OPTAG-BITNOT i64 44)
(const OPTAG-PROPLOAD i64 45)  ; (_, property-memory, object), aux = interned property name
(const OPTAG-PROPSTORE i64 46)  ; (_, property-memory, object, value), aux = interned property name
(const OPTAG-SETPROTO i64 47)  ; (_, property-memory, object, prototype-or-null) -> property memory
(const OPTAG-ARRAYMARK i64 48)  ; (_, object) -> same identity, represented with the JS Array tag
(const OPTAG-ARRAYLOAD i64 49)  ; (_, property-memory, array, integer index) -> dynamic value
(const OPTAG-ARRAYSTORE i64 50)  ; (_, property-memory, array, integer index, boxed value) -> memory
(const OPTAG-ARRAYLEN i64 51)  ; (_, property-memory, array) -> integer length
(const OPTAG-ARRAYRESIZE i64 52)  ; (_, property-memory, array, integer length, ordering value) -> memory
(const OPTAG-ARRAYCOPY i64 53)  ; (_, property-memory, source, result, integer start) -> memory
(const OPTAG-STRINGCONST i64 54)  ; (Start), aux = immutable jsstring table id
(const OPTAG-STRINGLEN i64 55)  ; (_, string) -> UTF-16 code-unit length
(const OPTAG-STRINGEQ i64 56)  ; (_, left string, right string) -> boolean
(const OPTAG-STRINGCONCAT i64 57)  ; (_, left string, right string) -> string
(const OPTAG-STRINGCHARCODE i64 58)  ; (_, string, integer index) -> integer or canonical NaN
(const OPTAG-STRINGSUBSTRING i64 59)  ; (_, string, start, end), aux = substring/substr/slice mode
(const OPTAG-TOSTRING i64 60)  ; (_, value) -> JavaScript String conversion
(const OPTAG-PARSEINT i64 61)  ; (_, value, integer radix) -> number
(const OPTAG-ISNAN i64 62)  ; (_, value) -> boolean after JavaScript numeric conversion
(const OPTAG-STRINGSPLIT i64 63)  ; (_, memory, string, delimiter, result array) -> memory
(const OPTAG-STRINGFROMCODEUNIT i64 64)  ; (_, integer) -> one UTF-16 code-unit string
(const OPTAG-NUMBERTOSTRING i64 65)  ; (_, integer, radix) -> string
;; 66 and 67 are retired: StringLower/StringUpper were an ASCII case shift the DSL now writes
;; over the string atoms (lib/string/case.jsl). Ids are stable — never reused.
(const OPTAG-STRINGINDEXOF i64 68)  ; (_, haystack, needle, start) -> integer
(const OPTAG-STRINGCOMPARE i64 69)  ; (_, left, right) -> UTF-16 lexical ordering
(const OPTAG-JSBUILTIN i64 70)  ; (_, boxed/dynamic arg0, arg1), aux = jsbuiltin descriptor id
(const OPTAG-JSTHROW i64 71)  ; (_, boxed/dynamic payload) -> unreachable dynamic result
;; ToIntegerOrInfinity (https://tc39.es/ecma262/#sec-tointegerorinfinity) as ONE op, because it is
;; one spec abstract operation and splitting it would put ToNumber, the NaN-to-zero rule and the
;; truncation in three places that could disagree. The result is `num`: finite inputs give an
;; integer, and the two infinities are preserved as f64 because the spec says so and because
;; `String.prototype.indexOf` distinguishes them after clamping.
(const OPTAG-TOINTEGER i64 72)  ; (_, value) -> integer or +/-Infinity
(const OPTAG-TONUMBER i64 73)  ; (_, value) -> ToNumber
(const OPTAG-ARRAYTEST i64 74)  ; (_, dynamic value) -> whether its runtime tag is Array
(const OPTAG-ARRAYUNBOX i64 75)  ; (_, boxed Array) -> raw managed array pointer
(const OPTAG-PARSEFLOAT i64 76)  ; (_, value) -> parseFloat(ToString(value))
(const OPTAG-PROPHAS i64 77)  ; (_, property-memory, object), aux = interned property name -> bool
(const OPTAG-PROPDELETE i64 78)  ; (_, property-memory, object), aux = interned name -> memory
(const OPTAG-PROTOHAS i64 79)  ; (_, property-memory, object, prototype) -> bool
(const OPTAG-PROPLOADKEY i64 80)  ; (_, property-memory, object, PropertyKey) -> dyn
(const OPTAG-PROPSTOREKEY i64 81) ; (_, property-memory, object, PropertyKey, value) -> memory
(const OPTAG-PROPHASKEY i64 82)   ; (_, property-memory, object, PropertyKey) -> bool
(const OPTAG-PROPDELETEKEY i64 83); (_, property-memory, object, PropertyKey) -> memory
(const OPTAG-OWNKEYCOUNT i64 84) ; (_, property-memory, object) -> enumerable own string-key count
(const OPTAG-OWNKEYAT i64 85)    ; (_, property-memory, object, integer ordinal) -> string
(const OPTAG-OBJECTFREEZE i64 86); (_, property-memory, object) -> property memory
(const OPTAG-INTERNALLOAD i64 87); (_, property-memory, object), aux = internal slot -> value
(const OPTAG-INTERNALSTORE i64 88); (_, property-memory, object, values...), aux = slot operation -> memory
(const OPTAG-STRINGNORMALIZE i64 89); (_, string, normalization-form) -> string
(const OPTAG-TOFIXED i64 90); (_, tagged number value, raw digit count) -> string
;; The two string ATOMS. Everything else in the string family is a loop over these two, which
;; is why they are the only ones the DSL cannot be asked to express in terms of something
;; smaller. A fresh string's units are all zero and, at run time, UNINITIALISED: the runtime
;; refuses a read until every unit has been written, and refuses a write that is not the next
;; one in order. That is not a restriction the DSL has to think about -- threading the string
;; through a loop accumulator produces exactly that order from data dependence alone.
(const OPTAG-STRINGALLOC i64 91)   ; (_, raw length) -> a fresh string, all units zero
(const OPTAG-STRINGSETUNIT i64 92) ; (_, string, raw index, raw unit) -> the SAME string
(const OPTAG-CALLABLEID i64 93) ; (Start), aux = compiler-local Fun index -> runtime integer id
(const OPTAG-EFFECT i64 94)
(const OPTAG-COUNT i64 95)

;; Temporary serialization/parser boundary while textual graph opcodes are still numeric.
;; A RETIRED TAG IS A HOLE IN A DENSE, SCANNED ID SPACE. `gparse-op` walks 0..OPTAG-COUNT asking
;; each tag for its name, so deleting an op mid-table leaves a number that decodes to nothing —
;; and `op-decode-tag`'s panic on an unknown opcode is worth keeping, so the hole is declared here
;; instead. The numbers are never reused, so this list only grows.
(defn op-tag-retired? [(code i64)] (-> bool)
  (or (= code 66) (= code 67)))  ; StringLower, StringUpper -- lib/string/case.jsl

(defn op-decode-tag [(code i64) (aux i64)] (-> Op)
  (case code
        OPTAG-START (Start)
        OPTAG-STOP (Stop)
        OPTAG-RETURN (Return)
        OPTAG-IF (If)
        OPTAG-REGION (Region)
        OPTAG-LOOP (Loop)
        OPTAG-CPROJ (CProj aux)
        OPTAG-XCTRL (XCtrl)
        OPTAG-CONST (Const aux)
        OPTAG-ARG (Arg aux)
        OPTAG-PROJ (Proj aux)
        OPTAG-PHI (Phi aux)
        OPTAG-CAST (Cast aux)
        OPTAG-ADD (Add)
        OPTAG-SUB (Sub)
        OPTAG-MUL (Mul)
        OPTAG-DIV (Div)
        OPTAG-MINUS (Minus)
        OPTAG-NOT (Not)
        OPTAG-EQ (Eq)
        OPTAG-LT (Lt)
        OPTAG-LE (Le)
        OPTAG-NEW (New aux)
        OPTAG-LOAD (Load aux)
        OPTAG-STORE (Store aux)
        OPTAG-MEMMERGE (MemMerge)
        OPTAG-BOX (Box aux)
        OPTAG-UNBOX (Unbox aux)
        OPTAG-TYPETEST (TypeTest aux)
        OPTAG-CALLEND (CallEnd)
        OPTAG-FUN (Fun aux)
        OPTAG-CALLABLEID (CallableId aux)
        OPTAG-PARM (Parm aux)
        OPTAG-CALL (Call aux)
        OPTAG-FUNSTART (FunStart)
        OPTAG-CLOSURE (Closure aux)
        OPTAG-SAFEPOINT (Safepoint)
        OPTAG-BARRIER (Barrier)
        OPTAG-MOD (Mod)
        OPTAG-BITAND (BitAnd)
        OPTAG-BITOR (BitOr)
        OPTAG-BITXOR (BitXor)
        OPTAG-SHL (Shl)
        OPTAG-SHR (Shr)
        OPTAG-USHR (UShr)
        OPTAG-BITNOT (BitNot)
        OPTAG-PROPLOAD (PropLoad aux)
        OPTAG-PROPSTORE (PropStore aux)
        OPTAG-SETPROTO (SetProto)
        OPTAG-ARRAYMARK (ArrayMark)
        OPTAG-ARRAYLOAD (ArrayLoad aux)
        OPTAG-ARRAYSTORE (ArrayStore)
        OPTAG-ARRAYLEN (ArrayLen)
        OPTAG-ARRAYRESIZE (ArrayResize)
        OPTAG-ARRAYCOPY (ArrayCopy)
        OPTAG-STRINGCONST (StringConst aux)
        OPTAG-STRINGLEN (StringLen)
        OPTAG-STRINGEQ (StringEq)
        OPTAG-STRINGCONCAT (StringConcat)
        OPTAG-STRINGCHARCODE (StringCharCode)
        OPTAG-STRINGSUBSTRING (StringSubstring aux)
        OPTAG-TOSTRING (ToString)
        OPTAG-PARSEINT (ParseInt)
        OPTAG-ISNAN (IsNaN)
        OPTAG-STRINGSPLIT (StringSplit)
        OPTAG-STRINGFROMCODEUNIT (StringFromCodeUnit)
        OPTAG-NUMBERTOSTRING (NumberToString)
        OPTAG-TOFIXED (ToFixed)
        OPTAG-STRINGALLOC (StringAlloc)
        OPTAG-STRINGSETUNIT (StringSetUnit)
        OPTAG-STRINGINDEXOF (StringIndexOf)
        OPTAG-STRINGCOMPARE (StringCompare)
        OPTAG-JSBUILTIN (JsBuiltin aux)
        OPTAG-JSTHROW (JsThrow)
        OPTAG-TOINTEGER (ToInteger)
        OPTAG-TONUMBER (ToNumber)
        OPTAG-ARRAYTEST (ArrayTest)
        OPTAG-ARRAYUNBOX (ArrayUnbox)
        OPTAG-PARSEFLOAT (ParseFloat)
        OPTAG-PROPHAS (PropHas aux)
        OPTAG-PROPDELETE (PropDelete aux)
        OPTAG-PROTOHAS (ProtoHas)
        OPTAG-PROPLOADKEY (PropLoadKey 0)
        OPTAG-PROPSTOREKEY (PropStoreKey 1)
        OPTAG-PROPHASKEY (PropHasKey)
        OPTAG-PROPDELETEKEY (PropDeleteKey)
        OPTAG-OWNKEYCOUNT (OwnKeyCount)
        OPTAG-OWNKEYAT (OwnKeyAt)
        OPTAG-OBJECTFREEZE (ObjectFreeze)
        OPTAG-INTERNALLOAD (InternalLoad aux)
        OPTAG-INTERNALSTORE (InternalStore aux)
        OPTAG-STRINGNORMALIZE (StringNormalize)
        OPTAG-EFFECT (Effect)
        (do (panic-corrupt "op-decode-tag: unknown opcode") (Start))))

(defn op-encode-tag [(op Op)] (-> i64)
  (match op
    (Start [] OPTAG-START)
    (Stop [] OPTAG-STOP)
    (Return [] OPTAG-RETURN)
    (If [] OPTAG-IF)
    (Region [] OPTAG-REGION)
    (Loop [] OPTAG-LOOP)
    (CProj [slot] OPTAG-CPROJ)
    (XCtrl [] OPTAG-XCTRL)
    (Const [ty] OPTAG-CONST)
    (Arg [ty] OPTAG-ARG)
    (Proj [slot] OPTAG-PROJ)
    (Phi [declared] OPTAG-PHI)
    (Cast [target] OPTAG-CAST)
    (Add [] OPTAG-ADD)
    (Sub [] OPTAG-SUB)
    (Mul [] OPTAG-MUL)
    (Div [] OPTAG-DIV)
    (Minus [] OPTAG-MINUS)
    (Not [] OPTAG-NOT)
    (Eq [] OPTAG-EQ)
    (Lt [] OPTAG-LT)
    (Le [] OPTAG-LE)
    (New [shape] OPTAG-NEW)
    (Load [alias] OPTAG-LOAD)
    (Store [alias] OPTAG-STORE)
    (MemMerge [] OPTAG-MEMMERGE)
    (Box [mode] OPTAG-BOX)
    (Unbox [target] OPTAG-UNBOX)
    (TypeTest [target] OPTAG-TYPETEST)
    (CallEnd [] OPTAG-CALLEND)
    (Fun [index] OPTAG-FUN)
    (CallableId [index] OPTAG-CALLABLEID)
    (Parm [index] OPTAG-PARM)
    (Call [abi] OPTAG-CALL)
    (FunStart [] OPTAG-FUNSTART)
    (Closure [captures] OPTAG-CLOSURE)
    (Safepoint [] OPTAG-SAFEPOINT)
    (Barrier [] OPTAG-BARRIER)
    (Mod [] OPTAG-MOD)
    (BitAnd [] OPTAG-BITAND)
    (BitOr [] OPTAG-BITOR)
    (BitXor [] OPTAG-BITXOR)
    (Shl [] OPTAG-SHL)
    (Shr [] OPTAG-SHR)
    (UShr [] OPTAG-USHR)
    (BitNot [] OPTAG-BITNOT)
    (PropLoad [name] OPTAG-PROPLOAD)
    (PropStore [name] OPTAG-PROPSTORE)
    (SetProto [] OPTAG-SETPROTO)
    (ArrayMark [] OPTAG-ARRAYMARK)
    (ArrayLoad [alias] OPTAG-ARRAYLOAD)
    (ArrayStore [] OPTAG-ARRAYSTORE)
    (ArrayLen [] OPTAG-ARRAYLEN)
    (ArrayResize [] OPTAG-ARRAYRESIZE)
    (ArrayCopy [] OPTAG-ARRAYCOPY)
    (StringConst [id] OPTAG-STRINGCONST)
    (StringLen [] OPTAG-STRINGLEN)
    (StringEq [] OPTAG-STRINGEQ)
    (StringConcat [] OPTAG-STRINGCONCAT)
    (StringCharCode [] OPTAG-STRINGCHARCODE)
    (StringSubstring [mode] OPTAG-STRINGSUBSTRING)
    (ToString [] OPTAG-TOSTRING)
    (ParseInt [] OPTAG-PARSEINT)
    (IsNaN [] OPTAG-ISNAN)
    (StringSplit [] OPTAG-STRINGSPLIT)
    (StringFromCodeUnit [] OPTAG-STRINGFROMCODEUNIT)
    (NumberToString [] OPTAG-NUMBERTOSTRING)
    (ToFixed [] OPTAG-TOFIXED)
    (StringAlloc [] OPTAG-STRINGALLOC)
    (StringSetUnit [] OPTAG-STRINGSETUNIT)
    (StringIndexOf [] OPTAG-STRINGINDEXOF)
    (StringCompare [] OPTAG-STRINGCOMPARE)
    (JsBuiltin [descriptor] OPTAG-JSBUILTIN)
    (JsThrow [] OPTAG-JSTHROW)
    (ToInteger [] OPTAG-TOINTEGER)
    (ToNumber [] OPTAG-TONUMBER)
    (ArrayTest [] OPTAG-ARRAYTEST)
    (ArrayUnbox [] OPTAG-ARRAYUNBOX)
    (ParseFloat [] OPTAG-PARSEFLOAT)
    (PropHas [name] OPTAG-PROPHAS)
    (PropDelete [name] OPTAG-PROPDELETE)
    (ProtoHas [] OPTAG-PROTOHAS)
    (PropLoadKey [_] OPTAG-PROPLOADKEY)
    (PropStoreKey [_] OPTAG-PROPSTOREKEY)
    (PropHasKey [] OPTAG-PROPHASKEY)
    (PropDeleteKey [] OPTAG-PROPDELETEKEY)
    (OwnKeyCount [] OPTAG-OWNKEYCOUNT)
    (OwnKeyAt [] OPTAG-OWNKEYAT)
    (ObjectFreeze [] OPTAG-OBJECTFREEZE)
    (InternalLoad [slot] OPTAG-INTERNALLOAD)
    (InternalStore [operation] OPTAG-INTERNALSTORE)
    (StringNormalize [] OPTAG-STRINGNORMALIZE)
    (Effect [] OPTAG-EFFECT)))

(defn op-encode-payload [(op Op)] (-> i64)
  (match op
    (Start [] 0)
    (Stop [] 0)
    (Return [] 0)
    (If [] 0)
    (Region [] 0)
    (Loop [] 0)
    (CProj [slot] slot)
    (XCtrl [] 0)
    (Const [ty] ty)
    (Arg [ty] ty)
    (Proj [slot] slot)
    (Phi [declared] declared)
    (Cast [target] target)
    (Add [] 0)
    (Sub [] 0)
    (Mul [] 0)
    (Div [] 0)
    (Minus [] 0)
    (Not [] 0)
    (Eq [] 0)
    (Lt [] 0)
    (Le [] 0)
    (New [shape] shape)
    (Load [alias] alias)
    (Store [alias] alias)
    (MemMerge [] 0)
    (Box [mode] mode)
    (Unbox [target] target)
    (TypeTest [target] target)
    (CallEnd [] 0)
    (Fun [index] index)
    (CallableId [index] index)
    (Parm [index] index)
    (Call [abi] abi)
    (FunStart [] 0)
    (Closure [captures] captures)
    (Safepoint [] 0)
    (Barrier [] 0)
    (Mod [] 0)
    (BitAnd [] 0)
    (BitOr [] 0)
    (BitXor [] 0)
    (Shl [] 0)
    (Shr [] 0)
    (UShr [] 0)
    (BitNot [] 0)
    (PropLoad [name] name)
    (PropStore [name] name)
    (SetProto [] 0)
    (ArrayMark [] 0)
    (ArrayLoad [alias] alias)
    (ArrayStore [] 0)
    (ArrayLen [] 0)
    (ArrayResize [] 0)
    (ArrayCopy [] 0)
    (StringConst [id] id)
    (StringLen [] 0)
    (StringEq [] 0)
    (StringConcat [] 0)
    (StringCharCode [] 0)
    (StringSubstring [mode] mode)
    (ToString [] 0)
    (ParseInt [] 0)
    (IsNaN [] 0)
    (StringSplit [] 0)
    (StringFromCodeUnit [] 0)
    (NumberToString [] 0)
    (ToFixed [] 0)
    (StringAlloc [] 0)
    (StringSetUnit [] 0)
    (StringIndexOf [] 0)
    (StringCompare [] 0)
    (JsBuiltin [descriptor] descriptor)
    (JsThrow [] 0)
    (ToInteger [] 0)
    (ToNumber [] 0)
    (ArrayTest [] 0)
    (ArrayUnbox [] 0)
    (ParseFloat [] 0)
    (PropHas [name] name)
    (PropDelete [name] name)
    (ProtoHas [] 0)
    ;; The runtime operation is semantic identity, not merely an encoding immediate. Getter and
    ;; setter component loads have identical inputs but must never GVN into one another; the same
    ;; applies to value/getter/setter/attribute stores.
    (PropLoadKey [operation] operation)
    (PropStoreKey [operation] operation)
    (PropHasKey [] 0)
    (PropDeleteKey [] 0)
    (OwnKeyCount [] 0)
    (OwnKeyAt [] 0)
    (ObjectFreeze [] 0)
    (InternalLoad [slot] slot)
    (InternalStore [operation] operation)
    (StringNormalize [] 0)
    (Effect [] 0)))

(const INTERNAL-TARGET i64 0)
(const INTERNAL-INDEX i64 1)
(const INTERNAL-KIND i64 2)
(const INTERNAL-INIT i64 0)
(const INTERNAL-SET-INDEX i64 1)

;; Case keys are the NAMED constants throughout, never the numbers. Literal keys are how a
;; renumbering silently rewires every dispatch table in the file at once.
(defn op-value-name [(op Op)] (-> (slice u8))
  (match op
    (Start [] "Start")
    (Stop [] "Stop")
    (Return [] "Return")
    (If [] "If")
    (Region [] "Region")
    (Loop [] "Loop")
    (CProj [_] "CProj")
    (XCtrl [] "XCtrl")
    (Const [_] "Const")
    (Arg [_] "Arg")
    (Proj [_] "Proj")
    (Phi [_] "Phi")
    (Cast [_] "Cast")
    (Add [] "Add")
    (Sub [] "Sub")
    (Mul [] "Mul")
    (Div [] "Div")
    (Minus [] "Minus")
    (Not [] "Not")
    (Eq [] "Eq")
    (Lt [] "Lt")
    (Le [] "Le")
    (New [_] "New")
    (Load [_] "Load")
    (Store [_] "Store")
    (MemMerge [] "MemMerge")
    (Box [_] "Box")
    (Unbox [_] "Unbox")
    (TypeTest [_] "TypeTest")
    (CallEnd [] "CallEnd")
    (Fun [_] "Fun")
    (CallableId [_] "CallableId")
    (Parm [_] "Parm")
    (Call [_] "Call")
    (FunStart [] "FunStart")
    (Closure [_] "Closure")
    (Safepoint [] "Safepoint")
    (Barrier [] "Barrier")
    (Mod [] "Mod")
    (BitAnd [] "BitAnd")
    (BitOr [] "BitOr")
    (BitXor [] "BitXor")
    (Shl [] "Shl")
    (Shr [] "Shr")
    (UShr [] "UShr")
    (BitNot [] "BitNot")
    (PropLoad [_] "PropLoad")
    (PropStore [_] "PropStore")
    (SetProto [] "SetProto")
    (ArrayMark [] "ArrayMark")
    (ArrayLoad [_] "ArrayLoad")
    (ArrayStore [] "ArrayStore")
    (ArrayLen [] "ArrayLen")
    (ArrayResize [] "ArrayResize")
    (ArrayCopy [] "ArrayCopy")
    (StringConst [_] "StringConst")
    (StringLen [] "StringLen")
    (StringEq [] "StringEq")
    (StringConcat [] "StringConcat")
    (StringCharCode [] "StringCharCode")
    (StringSubstring [_] "StringSubstring")
    (ToString [] "ToString")
    (ParseInt [] "ParseInt")
    (IsNaN [] "IsNaN")
    (StringSplit [] "StringSplit")
    (StringFromCodeUnit [] "StringFromCodeUnit")
    (NumberToString [] "NumberToString")
    (ToFixed [] "ToFixed")
    (StringAlloc [] "StringAlloc")
    (StringSetUnit [] "StringSetUnit")
    (StringIndexOf [] "StringIndexOf")
    (StringCompare [] "StringCompare")
    (JsBuiltin [_] "JsBuiltin")
    (JsThrow [] "JsThrow")
    (ToInteger [] "ToInteger")
    (ToNumber [] "ToNumber")
    (ArrayTest [] "ArrayTest")
    (ArrayUnbox [] "ArrayUnbox")
    (ParseFloat [] "ParseFloat")
    (PropHas [_] "PropHas")
    (PropDelete [_] "PropDelete")
    (ProtoHas [] "ProtoHas")
    (PropLoadKey [_] "PropLoadKey")
    (PropStoreKey [_] "PropStoreKey")
    (PropHasKey [] "PropHasKey")
    (PropDeleteKey [] "PropDeleteKey")
    (OwnKeyCount [] "OwnKeyCount")
    (OwnKeyAt [] "OwnKeyAt")
    (ObjectFreeze [] "ObjectFreeze")
    (InternalLoad [_] "InternalLoad")
    (InternalStore [_] "InternalStore")
    (StringNormalize [] "StringNormalize")
    (Effect [] "Effect")))

(defn op-name [(op Op)] (-> (slice u8))
  (op-value-name op))

;; Numeric names belong only to codecs and migration diagnostics. Runtime graph code uses `Op`.
(defn op-tag-name [(code i64)] (-> (slice u8))
  (op-value-name (op-decode-tag code 0)))

;; One exhaustive table replaces ordering-dependent integer ranges. Adding an opcode is a compile
;; error here until every semantic category is selected deliberately.
(const OPC-CONTROL i64 1)
(const OPC-VALUE i64 2)
(const OPC-PHI i64 4)
(const OPC-MERGE i64 8)
(const OPC-MULTI i64 16)
(const OPC-GVN i64 32)
(const OPC-FOLDABLE i64 64)
(const OPC-COMMUTES i64 128)
(const OPC-BINARY i64 256)
(const OPC-IDEALIZABLE i64 512)

(defn op-class [(op Op)] (-> i64)
  (match op
    (Start [] 1)
    (Stop [] 513)
    (Return [] 49)
    (If [] 49)
    (Region [] 553)
    (Loop [] 553)
    (CProj [_] 545)
    (XCtrl [] 33)
    (Const [_] 34)
    (Arg [_] 2)
    (Proj [_] 610)
    (Phi [_] 614)
    (Cast [_] 610)
    (Add [] 994)
    (Sub [] 866)
    (Mul [] 994)
    (Div [] 354)
    (Minus [] 610)
    (Not [] 98)
    (Eq [] 994)
    (Lt [] 866)
    (Le [] 866)
    (New [_] 82)
    (Load [_] 610)
    (Store [_] 610)
    (MemMerge [] 98)
    (Box [_] 610)
    (Unbox [_] 610)
    (TypeTest [_] 98)
    (CallEnd [] 513)
    (Fun [_] 2)
    (CallableId [_] 34)
    (Parm [_] 98)
    (Call [_] 530)
    (FunStart [] 33)
    (Closure [_] 2)
    (Safepoint [] 17)
    (Barrier [] 514)
    (Mod [] 354)
    (BitAnd [] 482)
    (BitOr [] 482)
    (BitXor [] 482)
    (Shl [] 354)
    (Shr [] 354)
    (UShr [] 354)
    (BitNot [] 98)
    (PropLoad [_] 98)
    (PropStore [_] 610)
    (SetProto [] 610)
    (ArrayMark [] 98)
    (ArrayLoad [_] 610)
    (ArrayStore [] 610)
    (ArrayLen [] 98)
    (ArrayResize [] 610)
    (ArrayCopy [] 610)
    (StringConst [_] 98)
    (StringLen [] 98)
    (StringEq [] 98)
    (StringConcat [] 98)
    (StringCharCode [] 98)
    (StringSubstring [_] 98)
    (ToString [] 98)
    (ParseInt [] 98)
    (IsNaN [] 98)
    (StringSplit [] 610)
    (StringFromCodeUnit [] 98)
    (NumberToString [] 98)
    (ToFixed [] 98)
    ;; VALUE only. Two `StringAlloc`s of the same length are two DIFFERENT strings, so GVN
    ;; must never merge them, and a unit store is a mutation, so folding must never run it
    ;; at build time.
    (StringAlloc [] 2)
    (StringSetUnit [] 2)
    (StringIndexOf [] 98)
    (StringCompare [] 98)
    (JsBuiltin [_] 98)
    (JsThrow [] 98)
    (ToInteger [] 98)
    (ToNumber [] 98)
    (ArrayTest [] 98)
    (ArrayUnbox [] 98)
    (ParseFloat [] 98)
    (PropHas [_] 98)
    (PropDelete [_] 610)
    (ProtoHas [] 98)
    (PropLoadKey [_] 98)
    (PropStoreKey [_] 610)
    (PropHasKey [] 98)
    (PropDeleteKey [] 610)
    (OwnKeyCount [] 98)
    (OwnKeyAt [] 98)
    (ObjectFreeze [] 610)
    (InternalLoad [_] 98)
    (InternalStore [_] 610)
    (StringNormalize [] 98)
    (Effect [] 610)))

(defn op-has-class? [(op Op) (class i64)] (-> bool)
  (!= (& (op-class op) class) 0))

;; ---------------------------------------------------------------------------
;; Op classification. The numbering above exists so these are range tests: control ops come
;; first, then value ops, and within the value ops the ones that may fold to a constant come
;; after the two that already are their own value.
;; ---------------------------------------------------------------------------
(defn op-control? [(op Op)] (-> bool)
  (op-has-class? op OPC-CONTROL))
(defn op-value? [(op Op)] (-> bool)
  (op-has-class? op OPC-VALUE))
(defn op-phi? [(op Op)] (-> bool)
  (op-has-class? op OPC-PHI))
(defn op-merge? [(op Op)] (-> bool)
  (op-has-class? op OPC-MERGE))
(defn op-multi? [(op Op)] (-> bool)
  (op-has-class? op OPC-MULTI))

;; DOES THIS NODE PRODUCE A MEMORY STATE. It is a question about the NODE and not about its op,
;; which is why the `op-memory?` predicate this replaces could never have been implemented: a
;; `Proj` is memory when it projects a `New`'s field slot and a value when it projects slot 0, and
;; a `Phi` is memory exactly when it merges memory. The type is what actually knows, and by the
;; time anything asks (the diagram, a scheduler) the types are computed.
(defn n-memory? [(n i64)] (-> bool)
  (ty-mem? (n-ty n)))

;; Value numbering covers everything except the four identity-bearing nodes. Start and Stop are
;; singletons; two `Arg`s are different arguments even with identical types.
;;
;; AND TWO `New`s ARE TWO OBJECTS. Structural identity is exactly the wrong relation for an
;; allocation: `a = {}; b = {};` builds two News with the same shape, the same control and the
;; same incoming memory, so they are structurally equal in every respect and merging them makes
;; `a` and `b` the same object. Nothing downstream could ever notice, because the graph that
;; results is internally consistent; the interpreter would simply report that a program which
;; allocates two objects allocates one. It is the same reason `Arg` is excluded, and the same
;; reason Simple gives `NewNode` its own `_alias` identity rather than letting GVN see it.
(defn op-gvn? [(op Op)] (-> bool)
  (op-has-class? op OPC-GVN))

;; May be replaced by a constant when its type says the value is known. Control cannot (a
;; control edge is not a value), `Const` already is one, and `Arg` is opaque by construction.
(defn op-foldable? [(op Op)] (-> bool)
  (op-has-class? op OPC-FOLDABLE))

;; A loop's input 2 is its back edge. Everything else flows forwards.
(defn n-back-edge? [(n i64) (i i64)] (-> bool)
  (and (op-is? n Loop []) (= i 2)))

(defn op-commutes? [(op Op)] (-> bool)
  (op-has-class? op OPC-COMMUTES))

;; Two operands in slots 1 and 2, with slot 0 the (currently unused) control anchor. `Minus`
;; and `Not` sit between the arithmetic and the comparisons in the numbering, so this is two
;; ranges rather than one; the verifier's arity contract is the reason it needs a name.
(defn op-binary? [(op Op)] (-> bool)
  (op-has-class? op OPC-BINARY))

;; Has a nontrivial arm in `n-idealize`. Keep this in the exhaustive opcode metadata rather than
;; rediscovering it by dispatching every already-analysed node during each fold seed.
(defn op-idealizable? [(op Op)] (-> bool)
  (op-has-class? op OPC-IDEALIZABLE))

; ============================================================================
; The node
; ============================================================================
(defstruct Node
  [(id i64)
   (op Op)
   (ty i64)  ; the current computed type
   (ins (ArrayList i64))  ; use-def, ordered, may contain NO-NODE
   (outs (ArrayList i64))  ; def-use, unordered
   (deps (ArrayList i64))  ; nodes to revisit when this node's type changes
   (dead bool)
   (cold bool)  ; scheduler hint for guarded generic fallbacks (M9)
   (observed bool)  ; an allocation pointer has had a non-write use (4c-3)
   (keeps i64)  ; pins against the kill cascade; see n-keep!
   (hash i64)])  ; cached structural hash; 0 means "not computed"

; ============================================================================
; The graph
; ============================================================================
(defstruct FunctionImportCatalog
  [(kinds (ArrayList i64))
   (units (ArrayList i64))
   (locals (ArrayList i64))
   (inited bool)])

(defn function-import-catalog [] (-> (ptr FunctionImportCatalog))
  (let [p (primitive/alloc-static FunctionImportCatalog)]
    (if (.inited p) 0
        (do
          (set! (.kinds p) (al-new [i64] (malloc-allocator)))
          (set! (.units p) (al-new [i64] (malloc-allocator)))
          (set! (.locals p) (al-new [i64] (malloc-allocator)))
          (set! (.inited p) true)))
    p))
(defn n-import-catalog-clear! [] (-> i64)
  (let [p (function-import-catalog)]
    (al-clear! [i64] (field p kinds))
    (al-clear! [i64] (field p units))
    (al-clear! [i64] (field p locals))
    0))
(defn n-import-catalog-add! [(kind i64) (unit i64) (local i64)] (-> i64)
  (let [p (function-import-catalog)]
    (al-push! [i64] (field p kinds) kind)
    (al-push! [i64] (field p units) unit)
    (al-push! [i64] (field p locals) local)
    0))
(defn n-import-catalog-contains? [(kind i64) (unit i64) (local i64)] (-> bool)
  (let [p (function-import-catalog) (mut i) 0 (mut found) false]
    (loop (if (or (>= (load i) (al-len [i64] (.kinds p))) (load found)) (break)
              (do
                (if (and (= (al-get [i64] (.kinds p) (load i)) kind)
                         (and (= (al-get [i64] (.units p) (load i)) unit)
                              (= (al-get [i64] (.locals p) (load i)) local)))
                    (set! found true) 0)
                (set! i (+ (load i) 1)))))
    (load found)))

(defstruct Graph
  [(nodes (ArrayList i64))  ; id -> (ptr Node), held as an integer address
   (fun-index (ArrayList i64))  ; fidx -> live Fun node, or NO-NODE
   (fun-identity-kind (ArrayList i64))
   (fun-identity-unit (ArrayList i64))
   (fun-identity-local (ArrayList i64))
   ;; True only when this semantic function is supplied by the retained-function linker. Imported
   ;; functions still carry a checked ABI and identity, but their body must never be scheduled from
   ;; this graph.
   (fun-imported (ArrayList bool))
   (fun-abi-param-first (ArrayList i64))
   (fun-abi-param-count (ArrayList i64))
   (fun-abi-param-types (ArrayList i64))
   (fun-abi-result-first (ArrayList i64))
   (fun-abi-result-count (ArrayList i64))
   (fun-abi-result-types (ArrayList i64))
   ;; Explicit exceptional outcome is part of the lowered function contract. The backend must not
   ;; rediscover it by scanning bodies or recognizing poison result tuples.
   (fun-abi-can-throw (ArrayList bool))
   (gvn (HashMap i64 i64))  ; structural key -> node id (see gvn-keyops)
   (wl (ArrayList i64))  ; the worklist
   (onwl (ArrayList bool))  ; id -> is it on the worklist
   (seed i64)  ; drives worklist pop order; varying it must not change results
   (start i64)
   (stop i64)
   (idep (ArrayList i64))  ; id -> dominator-tree depth; see g-build-loop-tree!
   (ldep (ArrayList i64))  ; id -> how many loops contain it
   (cfgver i64)  ; bumped whenever a control edge changes
   (domver i64)  ; the cfgver the tables above were built at; -1 = never
   (verifying bool)  ; a checker is walking the graph; see n-add-dep!
   (achecks i64)  ; falling-type checks the last g-analyze! performed
   (infer bool)  ; explicit whole-world interprocedural inference mode (M7)
   (pmark (ArrayList i64))  ; id -> generation stamp, for n-ty-proven?'s input-cone walk
   (pstack (ArrayList i64))  ; its DFS stack; both are reused rather than reallocated
   (pvalueproof (ArrayList bool))  ; proof snapshot for ordinary value transformations
   (pctrlproof (ArrayList bool))  ; proof snapshot while proving dead control
   (psnapshot bool)
   (pgen i64)  ; the current generation
   (pbusy bool)  ; a cone walk is in progress; the buffers above are not reentrant
   (prof-peeps i64)
   (prof-compute-ns i64)
   (prof-proof-ns i64)
   (prof-proof-calls i64)
   (prof-proof-snapshot-ns i64)
   (prof-proof-snapshot-calls i64)
   (prof-proof-snapshot-seeds i64)
   (prof-proof-snapshot-edges i64)
   (prof-proof-visits i64)
   (prof-proof-max i64)
   (prof-idealize-ns i64)
   (prof-gvn-ns i64)
   (prof-analyze-pops i64)
   (prof-fold-scans i64)
   (prof-fold-candidates i64)
   (prof-iterate-live-scans i64)
   (prof-iterate-pops i64)
   (prof-iterate-sweeps i64)
   (nchg i64)  ; peephole changes; see iterate!'s sweep loop
   ;; TWO ENGINE COUNTERS, and they exist because the gate that used to stand in for them stopped
   ;; being an equality. Until 4c-2 the only thing that removed a `Load` was `load-idealize`, so
   ;; "how many loads are dead" WAS "how many forwardings happened" and the corpus gate counted the
   ;; first while claiming the second. 4c-2 removes loads by CASCADE (deleting a store can drop the
   ;; last reader of the object below it), so the stand-in silently inflates the number that says
   ;; 4c-1 still works. These are incremented at exactly one site each, in the branch that performs
   ;; the rewrite, so a gate can assert an EQUALITY rather than "more than zero".
   (nfwd i64)  ; load-after-store forwardings performed (4c-1)
   (nselim i64)  ; store-after-store eliminations performed (4c-2)
   (ndalloc i64)  ; allocations removed after their object did not escape (4c-3)
   ;; HAS `g-analyze!` FINISHED ON THIS GRAPH. Not "are the types current" -- a fold changes edges
   ;; without re-running the analysis and this stays true across that, exactly as the rest of
   ;; `g-fold-proven!` already relies on types computed before the folds beside it. What it
   ;; separates is a graph the analysis has RUN over from one still under construction, which is
   ;; the distinction `n-ty-settled?` needs and could not make. See its note.
   (analysed bool)
   ;; A CONTROL arm is being proven dead, as opposed to a VALUE being proven constant. The two ask
   ;; `n-ty-proven?` the same question and need different answers about ANY; see `n-ty-settled?`.
   (provingctrl bool)
   (inited bool)])

;; The lazy initialiser lives in its own function so the ACCESSOR can be inlined: inlined it is a
;; static address plus a never-taken branch, and the initialiser it guards stays out of line so
;; nothing is duplicated.
;;
;; MEASURED WORTH NOTHING, and kept anyway because it is the right shape. A main-thread sample put
;; `graph`, `machine-unit` and `backend` at about a third of the compiler's frames, which reads as
;; "these accessors are the bottleneck". They are not: they are simply the innermost frame of
;; everything, so a cumulative sample attributes their callers' work to them. Inlining them --
;; confirmed by their symbols disappearing from the binary -- moved the benchmark 297 ms to 299 ms.
;; The lesson is about the sample, not the accessor.
(defn graph-init! [] (-> (ptr Graph))
  (let [p (primitive/alloc-static Graph)]
    (if (.inited p)
        0
        (do
          (set! (.inited p) true)
          (set! (.nodes p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-index p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-identity-kind p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-identity-unit p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-identity-local p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-imported p) (al-new [bool] (malloc-allocator)))
          (set! (.fun-abi-param-first p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-param-count p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-param-types p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-result-first p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-result-count p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-result-types p) (al-new [i64] (malloc-allocator)))
          (set! (.fun-abi-can-throw p) (al-new [bool] (malloc-allocator)))
          (set! (.gvn p) (hm-new [i64 i64] (malloc-allocator) (gvn-keyops)))
          (set! (.wl p) (al-new [i64] (malloc-allocator)))
          (set! (.onwl p) (al-new [bool] (malloc-allocator)))
          (set! (.seed p) 123)
          (set! (.start p) NO-NODE)
          (set! (.stop p) NO-NODE)
          (set! (.idep p) (al-new [i64] (malloc-allocator)))
          (set! (.ldep p) (al-new [i64] (malloc-allocator)))
          (set! (.cfgver p) 0)
          (set! (.domver p) -1)
          (set! (.verifying p) false)
          (set! (.achecks p) 0)
          (set! (.infer p) false)
          (set! (.pmark p) (al-new [i64] (malloc-allocator)))
          (set! (.pstack p) (al-new [i64] (malloc-allocator)))
          (set! (.pvalueproof p) (al-new [bool] (malloc-allocator)))
          (set! (.pctrlproof p) (al-new [bool] (malloc-allocator)))
          (set! (.psnapshot p) false)
          (set! (.pgen p) 0)
          (set! (.pbusy p) false)
          (set! (.prof-peeps p) 0)
          (set! (.prof-compute-ns p) 0)
          (set! (.prof-proof-ns p) 0)
          (set! (.prof-proof-calls p) 0)
          (set! (.prof-proof-snapshot-ns p) 0)
          (set! (.prof-proof-snapshot-calls p) 0)
          (set! (.prof-proof-snapshot-seeds p) 0)
          (set! (.prof-proof-snapshot-edges p) 0)
          (set! (.prof-proof-visits p) 0)
          (set! (.prof-proof-max p) 0)
          (set! (.prof-idealize-ns p) 0)
          (set! (.prof-gvn-ns p) 0)
          (set! (.prof-analyze-pops p) 0)
          (set! (.prof-fold-scans p) 0)
          (set! (.prof-fold-candidates p) 0)
          (set! (.prof-iterate-live-scans p) 0)
          (set! (.prof-iterate-pops p) 0)
          (set! (.prof-iterate-sweeps p) 0)
          (set! (.nchg p) 0)
          (set! (.nfwd p) 0)
          (set! (.nselim p) 0)
          (set! (.ndalloc p) 0)
          0))
    p))

;; Whether the representation verifier (v-pass-representation) is a HARD failure for the current
;; graph. The tagged-value conventions it checks (dyn-aliased slots hold NaN-boxed words, array
;; elements are tagged, receivers are tagged) are contracts of the native JS frontend, not of the
;; IR itself — raw Coil test graphs and the JSL DSL store raw pointers in dyn slots by design. So
;; the JS frontend opts in at its build entry and graph-reset! clears the flag, keeping every
;; other client advisory-only (g-rep-report still works for them).

(defn graph :inline (Always) [] (-> (ptr Graph))
  (let [p (primitive/alloc-static Graph)]
    (if (.inited p) p (graph-init!))))

(defn g-rep-strict-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn g-rep-strict? [] (-> i64) (load (g-rep-strict-cell)))
(defn g-rep-strict! [(v i64)] (-> i64) (set! (g-rep-strict-cell) v) 0)

;; Start a fresh graph. Tests call this between cases, and the seed selects a worklist pop
;; order: the same program must optimise to the same graph under every seed.
(defn graph-reset! [(seed i64)] (-> i64)
  (let [p (graph)]
    ;; Node ids die at this boundary. Release each node's edge buffers and header before dropping
    ;; the pointer table so long-lived compiler workers stay bounded by one graph's high-water mark
    ;; instead of accumulating every graph they have compiled.
    (let [(mut i) 0]
      (loop (if (>= (load i) (al-len [i64] (.nodes p)))
                (break)
                (do
                  (let [node (cast (ptr Node) (al-get (.nodes p) (load i)))]
                    (al-free! [i64] (mut (.ins node)))
                    (al-free! [i64] (mut (.outs node)))
                    (al-free! [i64] (mut (.deps node)))
                    (destroy [Node] (malloc-allocator) node))
                  (set! i (+ (load i) 1))
                  0))))
    (al-clear! [i64] (field p nodes))
    (al-clear! [i64] (field p fun-index))
    (al-clear! [i64] (field p fun-identity-kind))
    (al-clear! [i64] (field p fun-identity-unit))
    (al-clear! [i64] (field p fun-identity-local))
    (al-clear! [bool] (field p fun-imported))
    (al-clear! [i64] (field p fun-abi-param-first))
    (al-clear! [i64] (field p fun-abi-param-count))
    (al-clear! [i64] (field p fun-abi-param-types))
    (al-clear! [i64] (field p fun-abi-result-first))
    (al-clear! [i64] (field p fun-abi-result-count))
    (al-clear! [i64] (field p fun-abi-result-types))
    (al-clear! [bool] (field p fun-abi-can-throw))
    (hm-clear! [i64 i64] (field p gvn))
    (al-clear! [i64] (field p wl))
    (al-clear! [bool] (field p onwl))
    (al-clear! [i64] (field p idep))
    (al-clear! [i64] (field p ldep))
    (al-clear! [i64] (field p pmark))
    (al-clear! [i64] (field p pstack))
    (al-clear! [bool] (field p pvalueproof))
    (al-clear! [bool] (field p pctrlproof))
    (set! (.psnapshot p) false)
    (set! (.pbusy p) false)
    (set! (.prof-peeps p) 0)
    (set! (.prof-compute-ns p) 0)
    (set! (.prof-proof-ns p) 0)
    (set! (.prof-proof-calls p) 0)
    (set! (.prof-proof-snapshot-ns p) 0)
    (set! (.prof-proof-snapshot-calls p) 0)
    (set! (.prof-proof-snapshot-seeds p) 0)
    (set! (.prof-proof-snapshot-edges p) 0)
    (set! (.prof-proof-visits p) 0)
    (set! (.prof-proof-max p) 0)
    (set! (.prof-idealize-ns p) 0)
    (set! (.prof-gvn-ns p) 0)
    (set! (.prof-analyze-pops p) 0)
    (set! (.prof-fold-scans p) 0)
    (set! (.prof-fold-candidates p) 0)
    (set! (.prof-iterate-live-scans p) 0)
    (set! (.prof-iterate-pops p) 0)
    (set! (.prof-iterate-sweeps p) 0)
    (set! (.analysed p) false)
    (set! (.provingctrl p) false)
    (set! (.nchg p) 0)
    ; per-GRAPH, not per-process: every fixture starts from `graph-reset!`, so a gate that builds
    ; the corpus in a loop reads the count for the fixture it just built and not a running total.
    (set! (.nfwd p) 0)
    (set! (.nselim p) 0)
    (set! (.ndalloc p) 0)
    (set! (.cfgver p) 0)
    (set! (.domver p) -1)
    (set! (.verifying p) false)
    (set! (.achecks p) 0)
    (set! (.infer p) false)
    (set! (.seed p) seed)
    (g-rep-strict! 0)
    (set! (.start p) (n-new (Start)))
    (set! (.stop p) (n-new (Stop)))
    ;; THE ROOTS ARE PINNED. Found by the verifier the first time it ran on the corpus, on
    ;; `if(0) return 1; else return 2;`: Start's last user there is the predicate constant, so
    ;; when the dead branch collapsed and that constant died, the kill cascade ran on to Start
    ;; and killed the root of the graph. Two live nodes went on reading it, the printer omits
    ;; dead nodes so Start silently vanished from the diagram, and `g-leaked-count` marks from
    ;; Start, so from then on it could not see a leak.
    ;;
    ;; Start and Stop are singletons whose liveness is not a function of their use count, which
    ;; is exactly what `keeps` is for. Pinning them also upgrades any future attempt to kill a
    ;; root from silent corruption into `n-kill!`'s named panic.
    (n-keep! (.start p))
    (n-keep! (.stop p))
    (n-peephole (.start p))
    (n-peephole (.stop p))
    0))

(defn g-start [] (-> i64)
  (.start (graph)))
(defn g-stop [] (-> i64)
  (.stop (graph)))
(defn n-count [] (-> i64)
  (al-len [i64] (.nodes (graph))))

;; A CHECKER IS RUNNING. Verifying a graph means recomputing types over it, and `n-compute` is
;; not side-effect-free: `phi-compute` records a dependency through `n-add-dep!`. Without this
;; flag the act of verifying appends to deps lists, which changes what the next edge change
;; re-queues, so a checker would be observable in later results. Simple guards exactly the
;; same call with `CODE._midAssert`.
(defn g-verifying? [] (-> bool)
  (.verifying (graph)))
(defn g-set-verifying! [(v bool)] (-> i64)
  (set! (.verifying (graph)) v)
  0)

; ============================================================================
; Node accessors
; ============================================================================
(defn nd :inline (Always) [(n i64)] (-> (ptr Node))
  (cast (ptr Node) (al-get (.nodes (graph)) n)))

(defn n-op :inline (Always) [(n i64)] (-> Op)
  (.op (nd n)))
(def-op-payload-accessor n-cproj-label CProj "n-cproj-label: wrong Op variant")
(def-op-payload-accessor n-const-type Const "n-const-type: wrong Op variant")
(def-op-payload-accessor n-arg-type Arg "n-arg-type: wrong Op variant")
(def-op-payload-accessor n-proj-slot Proj "n-proj-slot: wrong Op variant")
(def-op-payload-accessor n-phi-declared-type Phi "n-phi-declared-type: wrong Op variant")
(def-op-payload-accessor n-cast-target-type Cast "n-cast-target-type: wrong Op variant")
(def-op-payload-accessor n-new-shape New "n-new-shape: wrong Op variant")
(def-op-payload-accessor n-load-alias Load "n-load-alias: wrong Op variant")
(def-op-payload-accessor n-store-alias Store "n-store-alias: wrong Op variant")
(def-op-payload-accessor n-box-kind Box "n-box-kind: wrong Op variant")
(def-op-payload-accessor n-unbox-target-type Unbox "n-unbox-target-type: wrong Op variant")
(def-op-payload-accessor n-typetest-target-type TypeTest "n-typetest-target-type: wrong Op variant")
(def-op-payload-accessor n-fun-index Fun "n-fun-index: wrong Op variant")
(def-op-payload-accessor n-callable-id-index CallableId "n-callable-id-index: wrong Op variant")
(def-op-payload-accessor n-parm-index Parm "n-parm-index: wrong Op variant")
(def-op-payload-accessor n-call-abi Call "n-call-abi: wrong Op variant")
(def-op-payload-accessor n-closure-capture-count Closure "n-closure-capture-count: wrong Op variant")
(def-op-payload-accessor n-propload-name PropLoad "n-propload-name: wrong Op variant")
(def-op-payload-accessor n-propstore-name PropStore "n-propstore-name: wrong Op variant")
(def-op-payload-accessor n-stringconst-id StringConst "n-stringconst-id: wrong Op variant")
(def-op-payload-accessor n-stringsubstring-mode StringSubstring "n-stringsubstring-mode: wrong Op variant")
(def-op-payload-accessor n-jsbuiltin-id JsBuiltin "n-jsbuiltin-id: wrong Op variant")
(def-op-payload-accessor n-prophas-name PropHas "n-prophas-name: wrong Op variant")
(def-op-payload-accessor n-propdelete-name PropDelete "n-propdelete-name: wrong Op variant")
(def-op-payload-accessor n-internal-load-slot InternalLoad "n-internal-load-slot: wrong Op variant")
(def-op-payload-accessor n-internal-store-slot InternalStore "n-internal-store-slot: wrong Op variant")
(defn n-ty [(n i64)] (-> i64)
  (.ty (nd n)))
(defn n-dead? [(n i64)] (-> bool)
  (.dead (nd n)))
(defn n-observed? [(n i64)] (-> bool)
  (.observed (nd n)))
(defn n-nins [(n i64)] (-> i64)
  (al-len [i64] (.ins (nd n))))
(defn n-nouts [(n i64)] (-> i64)
  (al-len [i64] (.outs (nd n))))
;; BOUNDS ARE CHECKED, and this is not defensive programming for its own sake. `al-get` is an
;; unchecked read and `al-clear!` only resets the length, so a read past the end returns whatever
;; the buffer still holds: a real node id, from before the list was cleared. That is how
;; `cproj-idealize` against a killed If (whose `ins` had been cleared by `n-kill!`) handed back a
;; stale id that HAPPENED to be the right one on the flat fixture and the wrong one, a dead node,
;; on a nested branch. A plausible value is the worst possible answer here; the index being out of
;; range is a bug in the caller and has to say so.
;; ONE `nd` PER CALL. These are the hottest reads in the compiler -- `ms-select-value-at!` and the
;; peephole worklist walk inputs constantly -- and each `nd` is a `(graph)` singleton call, an
;; `inited` branch and a bounds-checked list read. Fetching the node once and asking it for both
;; its length and its element halves that, without weakening the bounds check the comment above
;; argues for.
(defn n-in [(n i64) (i i64)] (-> i64)
  (let [p (nd n)]
    (if (or (< i 0) (>= i (al-len [i64] (.ins p))))
        (do (fmt (stderr) "graph corruption: n-in node={d} op={s} index={d} inputs={d} dead={d}\n"
                 n (op-name (n-op n)) i (n-nins n) (if (n-dead? n) 1 0))
            (panic-corrupt "n-in: input index out of range") NO-NODE)
        (al-get (.ins p) i))))
(defn n-out [(n i64) (i i64)] (-> i64)
  (let [p (nd n)]
    (if (or (< i 0) (>= i (al-len [i64] (.outs p))))
        (do (panic-corrupt "n-out: use index out of range") NO-NODE)
        (al-get (.outs p) i))))

(defn n-set-ty! [(n i64) (t i64)] (-> i64)
  (set! (.ty (nd n)) t)
  0)
(defn n-set-op! [(n i64) (op Op)] (-> i64)
  (set! (.op (nd n)) op)
  0)
(defn n-mark-cold! [(n i64)] (-> i64)
  (set! (.cold (nd n)) true)
  0)

; ============================================================================
; Creating nodes and maintaining edges
; ============================================================================
(defn n-new [(op Op)] (-> i64)
  (let [p (graph)
        id (al-len [i64] (.nodes p))
        np (unwrap-ptr [Node] (create [Node] (malloc-allocator)))]
    (set! (.id np) id)
    (set! (.op np) op)
    (set! (.ty np) (t-top))  ; optimistic until computed
    (set! (.ins np) (al-new [i64] (malloc-allocator)))
    (set! (.outs np) (al-new [i64] (malloc-allocator)))
    (set! (.deps np) (al-new [i64] (malloc-allocator)))
    (set! (.dead np) false)
    (set! (.cold np) false)
    (set! (.observed np) false)
    (set! (.keeps np) 0)
    (set! (.hash np) 0)
    (al-push! [i64] (field p nodes) (cast i64 np))
    (al-push! [bool] (field p onwl) false)
    id))

;; Dominators and loop nesting are derived from control edges, so any change to one invalidates
;; them. Bumping an epoch here is what lets a stale read be a hard error instead of a subtly
;; wrong placement decision later.
(defn n-bump-cfg! [(n i64)] (-> i64)
  (if (op-control? (n-op n))
      (do (set! (.cfgver (graph)) (+ (.cfgver (graph)) 1)) 0)
      0))

(defn n-record-object-use! [(n i64) (slot i64) (d i64)] (-> i64)
  (if (or (= d NO-NODE) (n-dead? d))
      0
      (if (match (n-op d) (Proj [projection] (= projection 0)) (_ false))
          (if (and (op-is? n Store [_]) (= slot 2))
              0
              (do (set! (.observed (nd d)) true) 0))
          0)))

(defn n-add-def! [(n i64) (d i64)] (-> i64)
  (if (and (!= d NO-NODE) (n-dead? d))
      (do
        (fmt (stderr) "N_ADD_DEAD_DEF owner=n{d}:{s} input={d} def=n{d}:{s}\n"
             n (op-name (n-op n)) (n-nins n) d (op-name (n-op d)))
        (panic-corrupt "n-add-def!: cannot attach a dead definition")
        0)
      0)
  (n-bump-cfg! n)
  (n-record-object-use! n (n-nins n) d)
  (al-push! [i64] (field (nd n) ins) d)
  (if (!= d NO-NODE) (do (al-push! [i64] (field (nd d) outs) n) 0) 0)
  (set! (.hash (nd n)) 0)
  0)

(defn n-new1 [(op Op) (a i64)] (-> i64)
  (let [n (n-new op)] (n-add-def! n a) n))
(defn n-new2 [(op Op) (a i64) (b i64)] (-> i64)
  (let [n (n-new op)] (n-add-def! n a) (n-add-def! n b) n))
(defn n-new3 [(op Op) (a i64) (b i64) (c i64)] (-> i64)
  (let [n (n-new op)] (n-add-def! n a) (n-add-def! n b) (n-add-def! n c) n))
(defn n-new4 [(op Op) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (let [n (n-new op)]
    (n-add-def! n a)
    (n-add-def! n b)
    (n-add-def! n c)
    (n-add-def! n d)
    n))
(defn n-new5 [(op Op) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (let [n (n-new op)]
    (n-add-def! n a)
    (n-add-def! n b)
    (n-add-def! n c)
    (n-add-def! n d)
    (n-add-def! n e)
    n))

;; Remove one use edge d->u. Unordered, so a swap-remove is fine.
(defn n-del-use! [(d i64) (u i64)] (-> bool)
  (let [outs (field (nd d) outs)
        len (al-len [i64] (load outs))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) len) (load found))
              (break)
              (do
                (if (= (al-get (load outs) (load i)) u)
                    (do
                      (al-set! [i64] outs (load i) (al-get (load outs) (- len 1)))
                      (al-pop! [i64] outs)
                      (set! found true)
                      0)
                    (set! i (+ (load i) 1)))
                0)))
    (and (= (al-len [i64] (load outs)) 0) (= (.keeps (nd d)) 0))))

(defn n-find-in [(n i64) (d i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) 0
        (mut at) NO-NODE]
    (loop (if (or (>= (load i) len) (!= (load at) NO-NODE))
              (break)
              (do
                (if (= (n-in n (load i)) d) (set! at (load i)) 0)
                (set! i (+ (load i) 1))
                0)))
    (load at)))

;; The normal way to change an edge. Keeps def-use in step, kills a def that just lost its
;; last use, and re-queues anything whose analysis depended on this node.
;; Closing a Loop's control back edge while a Phi on it still has an unset input is an ordering
;; error: after this the region is no longer in progress, so that Phi starts meeting a path
;; whose value does not exist yet. Caught here rather than left to surface as a deleted loop.
(defn n-check-loop-close [(n i64) (i i64) (d i64)] (-> i64)
  (if (not (and (and (op-is? n Loop []) (= i 2)) (= (n-in n i) NO-NODE)))
      0
      (let [len (n-nouts n)
            (mut k) 0]
        (loop (if (>= (load k) len)
                  (break)
                  (do
                    (let [u (n-out n (load k))]
                      (if (and (op-phi? (n-op u)) (n-in-progress? u))
                          (do
                            (panic-corrupt "closing a loop's back edge while a phi on it is still open: close the phis first")
                            0)
                          0))
                    (set! k (+ (load k) 1))
                    0)))
        0)))

(defn n-set-def! [(n i64) (i i64) (d i64)] (-> i64)
  (if (and (!= d NO-NODE) (n-dead? d))
      (do
        (fmt (stderr) "N_SET_DEAD_DEF owner=n{d}:{s} input={d} def=n{d}:{s}\n"
             n (op-name (n-op n)) i d (op-name (n-op d)))
        (panic-corrupt "n-set-def!: cannot attach a dead definition")
        0)
      0)
  (n-check-loop-close n i d)
  (n-bump-cfg! n)
  (let [old (n-in n i)]
    (if (= old d)
        0
        (do
          (n-record-object-use! n i d)
          ; add the new use BEFORE dropping the old one: dropping it may kill a subtree that
          ; the new def is part of.
          (if (!= d NO-NODE) (do (al-push! [i64] (field (nd d) outs) n) 0) 0)
          (al-set! [i64] (field (nd n) ins) i d)
          (if (!= old NO-NODE)
              (if (n-del-use! old n)
                  (if (= (n-keeps old) 0) (n-kill! old) (wl-push! old))
                  (wl-push! old))
              0)
          (set! (.hash (nd n)) 0)
          (n-move-deps! n)
          (wl-push! n)
          0))))

;; A node with no uses is garbage. Killing it releases its inputs, which may cascade.
(defn n-kill! [(n i64)] (-> i64)
  (if (n-dead? n)
      0
      (do
        (if (> (n-keeps n) 0)
            (do
              (fmt (stderr) "n-kill-pinned node={d} op={s} keeps={d} uses={d}\n"
                   n (op-name (n-op n)) (n-keeps n) (n-nouts n))
              (panic-corrupt "n-kill!: node is pinned") 0)
            0)
        ;; DEAD MEANS NOBODY USES IT. Killing a node that still has users leaves every one of them
        ;; holding a corpse, and the graph only says so later, somewhere else -- a `Cast` whose
        ;; value was a dead `Box` with four live uses is how this was found. Refusing here names
        ;; the caller that did it instead of the node that noticed.
        (if (> (n-nouts n) 0) (do (panic-corrupt "n-kill!: node still has uses") 0) 0)
        (if (op-is? n Fun [_])
            (let [fidx (n-fun-index n)
                  index (.fun-index (graph))]
              (if (and (>= fidx 0)
                       (and (< fidx (al-len [i64] index))
                            (= (al-get [i64] index fidx) n)))
                  (al-set! [i64] (field (graph) fun-index) fidx NO-NODE)
                  0))
            0)
        (set! (.dead (nd n)) true)
        (gvn-remove! n)
        (let [(mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break)
                    (do
                      (let [d (n-in n (load i))]
                        (if (!= d NO-NODE)
                            ;; Losing the last ordinary user does not make an explicitly kept
                            ;; value dead. JSL bindings pin values whose later uses have not been
                            ;; built yet; a discarded duplicate wrapper can remove their current
                            ;; last edge while that lexical ownership is still active.
                            (if (n-del-use! d n)
                                (if (= (n-keeps d) 0) (n-kill! d) (wl-push! d))
                                (wl-push! d))
                            0))
                      (set! i (+ (load i) 1))
                      0))))
        (al-clear! [i64] (field (nd n) ins))
        0)))

;; Discard a zero-use structural wrapper without recursively collecting its semantic inputs.
;; Frontend/backend root tables are external to ordinary def-use edges; the caller has already
;; proved that the wrapper's replacement retained every required input.
(defn n-discard-scaffolding! [(n i64)] (-> i64)
  (if (n-dead? n)
      0
      (do
        (if (or (> (n-keeps n) 0) (> (n-nouts n) 0))
            (do (panic-corrupt "n-discard-scaffolding!: node is still live") 0)
            0)
        (set! (.dead (nd n)) true)
        (gvn-remove! n)
        (let [(mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break)
                    (do
                      (let [d (n-in n (load i))]
                        (if (!= d NO-NODE) (do (n-del-use! d n) 0) 0))
                      (set! i (+ (load i) 1))))))
        (al-clear! [i64] (field (nd n) ins))
        0)))

;; Replace every use of `old` with `new`, then kill `old`.
(defn n-subsume! [(old i64) (new i64)] (-> i64)
  (loop (let [k (- (n-nouts old) 1)]
          (if (< k 0)
              (break)
              (let [u (n-out old k)
                    at (n-find-in u old)]
                (if (= at NO-NODE)
                    ; `old` is listed as a use but is absent from that user's inputs: a corrupted
                    ; graph. Spinning forever is the worst way to find that out.
                    (do (panic-corrupt "n-subsume!: def-use edge with no matching use-def edge") 0)
                    (do (n-set-def! u at new) 0))))))
  ;; External builders retain node ids for explicitly kept lexical values. Rewire all graph users,
  ;; but leave a pinned old value alive until its owner releases that id; `jl-collect!` will then
  ;; remove it if no later use was built. Killing it here would invalidate the external binding.
  (if (= (n-keeps old) 0) (n-kill! old) (wl-push! old))
  0)

;; Killing a node releases its inputs, which cascades. When the node being killed is being
;; REPLACED by one of its own inputs (`x+0` becomes `x`), that cascade would kill the
;; replacement, which usually has no uses of its own yet. `n-keep!` pins it for the duration.
;; Simple calls this `deadCodeElim`; it is not optional, and without it `return arg+0;`
;; returns a dead node.
(defn n-keeps [(n i64)] (-> i64)
  (.keeps (nd n)))
(defn n-keep! [(n i64)] (-> i64)
  (set! (.keeps (nd n)) (+ (n-keeps n) 1))
  0)
(defn n-unkeep! [(n i64)] (-> i64)
  (if (<= (n-keeps n) 0)
      (do (panic-corrupt "n-unkeep!: not pinned") 0)
      (do (set! (.keeps (nd n)) (- (n-keeps n) 1)) 0)))

(defn panic-corrupt [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (print-str w "graph corruption: ") (print-str w msg) (print-str w "\n"))
  (abort)
  0)

; ============================================================================
; Dependency tracking
; ============================================================================
;; A peephole that looked at a node which is NOT one of its inputs has to say so, or it will
;; not be revisited when that node changes. Missing this is the classic source of a graph
;; that is only wrong under some visit orders, which is exactly what the multi-seed test is
;; built to catch.
;; A verifier recomputes every type and must leave the graph byte-identical, so while it runs
;; this records nothing. That is sound in exactly one direction: the dependency exists to make
;; a node be REVISITED, and the verifier changes nothing that could need revisiting. Dropping
;; it during a real analysis would instead lose a revisit and give an order-dependent graph.
(defn n-add-dep! [(n i64) (dep i64)] (-> i64)
  (if (g-verifying?)
      0
      (do (al-push! [i64] (field (nd n) deps) dep) 0)))

(defn n-move-deps! [(n i64)] (-> i64)
  (let [deps (field (nd n) deps)
        len (al-len [i64] (load deps))
        (mut i) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (wl-push! (al-get (load deps) (load i)))
                (set! i (+ (load i) 1))
                0)))
    (al-clear! [i64] deps)
    0))

; ============================================================================
; The worklist
; ============================================================================
;; Pop order is pseudo-random, seeded. Peepholes must reach the same fixpoint whatever the
;; order; the multi-seed test is what holds that claim up.
(defn wl-push! [(n i64)] (-> i64)
  (let [p (graph)]
    (if (al-get (.onwl p) n)
        0
        (do
          (al-set! [bool] (field p onwl) n true)
          (al-push! [i64] (field p wl) n)
          0))))

(defn wl-push-outs! [(n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (n-nouts n))
              (break)
              (do
                (wl-push! (n-out n (load i)))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn wl-next-seed! [] (-> i64)
  (let [p (graph)
        ; a plain LCG; the point is a different order per seed, not statistical quality
        s (+ (* (.seed p) 6364136223846793005) 1442695040888963407)]
    (set! (.seed p) s)
    (& s TY-IMAX)))

(defn wl-pop! [] (-> i64)
  (let [p (graph)
        wl (field p wl)
        len (al-len [i64] (load wl))]
    (if (= len 0)
        NO-NODE
        (let [i (% (wl-next-seed!) len)
              n (al-get (load wl) i)]
          (al-set! [i64] wl i (al-get (load wl) (- len 1)))
          (al-pop! [i64] wl)
          (al-set! [bool] (field p onwl) n false)
          n))))

;; Is this node pending? Exported for the tests that check the revisit machinery directly: "a type
;; change re-queues the nodes that read it" is otherwise only observable as a fixpoint several steps
;; later, which is a much weaker thing to assert. NOT what `n-ty-proven?` asks, deliberately:
;; `iterate!` sweeps by pushing every live node, so "pending" is true of everything mid-sweep.
(defn wl-on? [(n i64)] (-> bool)
  (al-get (.onwl (graph)) n))

; ============================================================================
; Global value numbering
; ============================================================================
;; The table is node id -> node id, with hash and equality reaching into the arena, so two
;; structurally identical nodes collide and the second one is thrown away.
(defn node-hash [(n i64)] (-> i64)
  (let [cached (.hash (nd n))]
    (if (!= cached 0)
        cached
        (let [(mut h) (hash-step (hash-step 1099511628211 (op-encode-tag (n-op n))) (op-encode-payload (n-op n)))
              (mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break)
                    (do
                      (set! h (hash-step (load h) (n-in n (load i))))
                      (set! i (+ (load i) 1))
                      0)))
          ; 0 is the "not computed" marker, so never hand it back as a real hash
          (let [hv (if (= (load h) 0) 1 (load h))]
            (set! (.hash (nd n)) hv)
            hv)))))

(defn node-eq [(a i64) (b i64)] (-> bool)
  (if (= a b)
      true
      (if (or (!= (op-encode-tag (n-op a)) (op-encode-tag (n-op b)))
              (or (!= (op-encode-payload (n-op a)) (op-encode-payload (n-op b)))
                  (!= (n-nins a) (n-nins b))))
          false
          (let [len (n-nins a)
                (mut i) 0
                (mut same) true]
            (loop (if (or (>= (load i) len) (not (load same)))
                      (break)
                      (do
                        (if (!= (n-in a (load i)) (n-in b (load i))) (set! same false) 0)
                        (set! i (+ (load i) 1))
                        0)))
            (load same)))))

;; Finalized for the same reason `ty-keyhash` is: the stdlib map masks with `cap-1`, and
;; `hash-step`'s multiply leaves the low bits structured -- node ids and op tags are small
;; integers, so GVN probe chains grow with the graph. See `ty-hash-finalize`.
(defn gvn-keyhash [(slot (ptr i8)) (n i64)] (-> i64)
  (ty-hash-finalize (node-hash (load (cast (ptr i64) slot)))))
(defn gvn-keyeq [(ka (ptr i8)) (kb (ptr i8)) (n i64)] (-> bool)
  (node-eq (load (cast (ptr i64) ka)) (load (cast (ptr i64) kb))))
(defn gvn-keyops [] (-> (ptr KeyOps))
  (let [o (primitive/alloc-static KeyOps)]
    (set! (.hash o) (fnptr-of gvn-keyhash))
    (set! (.eq o) (fnptr-of gvn-keyeq))
    (set! (.size o) (sizeof i64))
    o))

(defn gvn-remove! [(n i64)] (-> i64)
  (if (op-gvn? (n-op n)) (do (hm-remove! [i64 i64] (field (graph) gvn) n) 0) 0))

;; Look up a structurally identical node, or install this one. Returns the node that should
;; be used from here on.
(defn gvn! [(n i64)] (-> i64)
  (if (not (op-gvn? (n-op n)))
      n
      (match (hm-get (.gvn (graph)) n)
        (Some [e] (if (or (= e n) (n-dead? e)) n e))
        (None [] (do (hm-put! [i64 i64] (field (graph) gvn) n n) n)))))

; ============================================================================
; compute: the type of a node from its inputs
; ============================================================================
(defn infer-call-targets [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (n-add-dep! callee call)
    (ty-fun-targets (n-ty callee))))

(defn infer-direct-callee-fun [(call i64)] (-> i64)
  (let [callee (n-in call 1)]
    (match (n-op callee)
      (Fun [index] callee)
      (Closure [captures] (n-in callee 0))
      (_ NO-NODE))))

;; `Val.fidxs` is only a finite optimization summary. Exact direct identity remains available on a
;; Fun/Closure even when its internal id lives outside that summary's 63 bits.
(defn infer-call-reaches-fun? [(call i64) (fun i64)] (-> bool)
  (let [direct (infer-direct-callee-fun call)
        fidx (n-fun-index fun)]
    (if (!= direct NO-NODE)
        (= direct fun)
        (and (>= fidx 0)
             (and (< fidx 63) (!= (& (infer-call-targets call) (<< 1 fidx)) 0))))))

(defn infer-parm-source [(call i64) (fun i64) (idx i64)] (-> i64)
  (let [callee (n-in call 1)]
    (if (op-is? callee Closure [_])
        (let [capc (n-closure-capture-count callee)
              base (- (n-nins callee) capc)]
          (if (< idx capc)
              (n-in callee (+ base idx))
              (let [at (+ 2 (- idx capc))]
                (if (< at (n-nins call)) (n-in call at) NO-NODE))))
        (let [at (+ 2 idx)] (if (< at (n-nins call)) (n-in call at) NO-NODE)))))

(defn infer-parm-compute [(parm i64)] (-> i64)
  (let [fun (n-in parm 0)
        fidx (n-fun-index fun)
        idx (n-parm-index parm)
        lim (n-count)
        (mut i) 0
        (mut acc) (t-top)
        (mut seen) false]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (let [call (load i)]
                  (if (or (n-dead? call) (not (op-is? call Call [_])))
                      0
                      (if (not (infer-call-reaches-fun? call fun))
                          0
                          (let [src (infer-parm-source call fun idx)]
                            (if (= src NO-NODE)
                                (set! acc (t-dyn))
                                (do
                                  (n-add-dep! src parm)
                                  (set! acc (ty-meet (load acc) (n-ty src)))))
                            (set! seen true)
                            0))))
                (set! i (+ (load i) 1))
                0)))
    (if (load seen) (load acc) (t-top))))

(defn infer-meet-fun-returns! [(fun i64) (call i64) (acc (ptr i64)) (seen (ptr bool))] (-> i64)
  (let [(mut ri) 1]
    (loop (if (>= (load ri) (n-nins fun))
              (break)
              (do
                (let [ret (n-in fun (load ri))]
                  (if (or (n-dead? ret) (not (op-is? ret Return [])))
                      0
                      (let [v (n-in ret 1)]
                        (n-add-dep! v call)
                        (set! acc (ty-meet (load acc) (n-ty v)))
                        (set! seen true)
                        0)))
                (set! ri (+ (load ri) 1))
                0)))
    0))

(defn n-fun-abi-result-tuple [(fun i64)] (-> i64)
  (let [count (n-fun-abi-result-count fun)
        tuple (ty-tuple-open count)
        (mut result) 0]
    (loop (if (>= (load result) count) (break)
              (do (ty-tuple-put! tuple (load result)
                                 (n-fun-abi-result-type fun (load result)))
                  (set! result (+ (load result) 1)))))
    (ty-tuple-close tuple)))

(defn infer-call-compute [(call i64)] (-> i64)
  (block :done
  (let [targets (infer-call-targets call)
        direct (infer-direct-callee-fun call)
        (mut fidx) 0
        (mut acc) (t-top)
        (mut seen) false]
    ;; A declared multi-result call is itself a tuple producer. Individual consumers use Proj;
    ;; scalar calls retain the established interprocedural meet so existing precision is unchanged.
    (if (and (!= direct NO-NODE)
             (and (n-fun-abi-declared? direct) (!= (n-fun-abi-result-count direct) 1)))
        (return-from :done (n-fun-abi-result-tuple direct))
        0)
    (if (!= direct NO-NODE) (infer-meet-fun-returns! direct call (mut acc) (mut seen)) 0)
    (loop (if (>= (load fidx) 64)
              (break)
              (do
                (if (or (!= direct NO-NODE) (= (& targets (<< 1 (load fidx))) 0))
                    0
                    (let [fun (n-find-fun-index (load fidx))]
                      (if (= fun NO-NODE) 0 (infer-meet-fun-returns! fun call (mut acc) (mut seen)))))
                (set! fidx (+ (load fidx) 1))
                0)))
    (if (load seen) (load acc) (t-top)))))

(defn call-compute [(call i64)] (-> i64)
  (let [direct (infer-direct-callee-fun call)]
    (if (and (!= direct NO-NODE)
             (and (n-fun-abi-declared? direct) (!= (n-fun-abi-result-count direct) 1)))
        (n-fun-abi-result-tuple direct)
        (if (.infer (graph)) (infer-call-compute call) (t-dyn)))))

(defn safepoint-compute [(n i64)] (-> i64)
  (let [len (n-nins n)
        b (ty-tuple-open len)
        (mut i) 1]
    (ty-tuple-put! b 0 (if (ty-high? (n-in-ty n 0)) (t-top) (t-ctrl)))
    (loop (if (>= (load i) len)
              (break)
              (do
                (ty-tuple-put! b (load i) (n-in-ty n (load i)))
                (set! i (+ (load i) 1))
                0)))
    (ty-tuple-close b)))

(defn n-compute [(n i64)] (-> i64)
  (match (n-op n)
    (Start [] (t-ctrl))
    (Stop [] (t-bot))
    (XCtrl [] (t-xctrl))
    (Return [] (return-compute n))
    (If [] (if-compute n))
    (Region [] (region-compute n))
    (Loop [] (loop-compute n))
    (CProj [slot] (proj-compute n))
    (Proj [slot] (proj-compute n))
    (Const [ty] ty)  ; a Const's type IS the constant
    (Arg [ty] ty)  ; an opaque value of its declared type
    (Phi [declared] (phi-compute n))
    (Cast [target] (cast-compute n))
    (Add [] (arith-compute (Add) (n-in-ty n 1) (n-in-ty n 2)))
    (Sub [] (arith-compute (Sub) (n-in-ty n 1) (n-in-ty n 2)))
    (Mul [] (arith-compute (Mul) (n-in-ty n 1) (n-in-ty n 2)))
    (Div [] (arith-compute (Div) (n-in-ty n 1) (n-in-ty n 2)))
    (Minus [] (minus-compute (n-in-ty n 1)))
    (Not [] (not-compute (n-in-ty n 1)))
    (Eq [] (cmp-compute (Eq) (n-in-ty n 1) (n-in-ty n 2)))
    (Lt [] (cmp-compute (Lt) (n-in-ty n 1) (n-in-ty n 2)))
    (Le [] (cmp-compute (Le) (n-in-ty n 1) (n-in-ty n 2)))
    (Mod [] (mod-compute (n-in-ty n 1) (n-in-ty n 2)))
    (BitAnd [] (bitwise-compute JS-BIT-AND (n-in-ty n 1) (n-in-ty n 2)))
    (BitOr [] (bitwise-compute JS-BIT-OR (n-in-ty n 1) (n-in-ty n 2)))
    (BitXor [] (bitwise-compute JS-BIT-XOR (n-in-ty n 1) (n-in-ty n 2)))
    (Shl [] (bitwise-compute JS-SHL (n-in-ty n 1) (n-in-ty n 2)))
    (Shr [] (bitwise-compute JS-SHR (n-in-ty n 1) (n-in-ty n 2)))
    (UShr [] (bitwise-compute JS-USHR (n-in-ty n 1) (n-in-ty n 2)))
    (BitNot [] (bitnot-compute (n-in-ty n 1)))
    (New [shape] (new-compute n))
    (Load [alias] (load-compute n))
    (Store [alias] (store-compute n))
    (MemMerge [] (memmerge-compute n))
    (Box [mode] (box-compute n))
    (Unbox [target] (unbox-compute n))
    (TypeTest [target] (typetest-compute n))
    ;; `ty-unanalysed?` AND NOT `ty-high?`, for the reason `if-compute` documents at length: on the
    ;; control axis "unanalysed" and "proven unreachable" are both high, and they are not the same
    ;; claim. A CallEnd in dead code is `~ctrl` -- it forwards what its control says -- and
    ;; answering ANY for it makes every merge below the call ANY, live arms included.
    (CallEnd [] (if (ty-unanalysed? (n-in-ty n 0)) (t-top) (n-in-ty n 0)))
    (Fun [index]
        ;; Only JavaScript-visible function identities fit in Val.fidxs. Internal JSL functions
        ;; may use the disjoint high namespace; their exact identity remains on this OPTAG-FUN node.
        ;; Give those a generic callable type instead of wrapping the shift and aliasing a low id.
        (if (< index 63) (t-fun-con index) (t-fun)))
    ;; The payload identifies a compiler-local Fun, but the machine value is the runtime integer
    ;; callable symbol. Keep it non-constant so folding cannot erase relocation identity.
    (CallableId [index] (t-int))
    (Parm [index] (if (.infer (graph)) (infer-parm-compute n) (t-dyn)))
    (Call [abi] (call-compute n))
    (FunStart [] (t-ctrl))
    (Closure [captures] (n-in-ty n 0))
    (Safepoint [] (safepoint-compute n))
    (Barrier [] (n-in-ty n 1))
    (PropLoad [name] (t-dyn))
    (PropStore [name] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (SetProto [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (ArrayMark [] (n-in-ty n 1))
    (ArrayLoad [alias] (t-dyn))
    (ArrayStore [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (ArrayLen [] (t-int))
    (ArrayResize [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (ArrayCopy [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (PropHas [name] (t-bool))
    (PropDelete [name] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (ProtoHas [] (t-bool))
    (PropLoadKey [operation]
      (if (or (= operation 26) (or (= operation 29)
              (or (= operation 30) (= operation 32)))) (t-bool)
        (if (or (= operation 14) (= operation 21)) (t-int-range -1 15) (t-dyn))))
    (PropStoreKey [_] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (PropHasKey [] (t-bool))
    (PropDeleteKey [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (OwnKeyCount [] (t-int-range 0 TY-IMAX))
    (OwnKeyAt [] (t-dyn))
    (ObjectFreeze [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (InternalLoad [slot] (if (= slot INTERNAL-TARGET) (t-dyn) (t-int)))
    (InternalStore [operation] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (StringConst [id] (t-str))
    (StringLen [] (t-int-range 0 TY-IMAX))
    (StringEq [] (t-bool))
    (StringConcat [] (t-str))
    (StringCharCode [] (t-num))
    (StringSubstring [mode] (t-str))
    (ToString [] (t-str))
    (ParseInt [] (t-num))
    (IsNaN [] (t-bool))
    (StringSplit [] (t-mem-alias JS-PROPERTY-ALIAS (t-dyn)))
    (StringFromCodeUnit [] (t-str))
    (NumberToString [] (t-str))
    (ToFixed [] (t-str))
    (StringAlloc [] (t-str))
    (StringSetUnit [] (t-str))
    (StringIndexOf [] (t-int))
    (StringCompare [] (t-int))
    (JsBuiltin [descriptor] (t-dyn))
    (JsThrow [] (t-dyn))
    (ToInteger []
        ;; `dyn`, NOT `num`. Both return a BOXED value at run time — the runtime helper hands back
        ;; an AotJsValue — so typing them `num` makes the backend treat the result as an unboxed
        ;; float and place it in an FP register. Merging that with a boxed value in a Phi mixes
        ;; register classes and produces garbage that verifies clean. The IR type has to describe
        ;; the REPRESENTATION, not just the value set.
        (t-dyn))
    (ToNumber [] (t-dyn))
    (ArrayTest [] (arraytest-compute n))
    (ArrayUnbox [] (t-obj))
    (ParseFloat [] (t-dyn))
    (StringNormalize [] (t-str))
    (Effect [] (n-in-ty n 1))))

;; An absent input contributes ANY (nothing known yet), which keeps compute monotone while a
;; graph is still being wired up.
(defn n-in-ty [(n i64) (i i64)] (-> i64)
  (if (>= i (n-nins n))
      (t-top)
      (let [d (n-in n i)] (if (= d NO-NODE) (t-top) (n-ty d)))))

; ---------------------------------------------------------------------------
; Arithmetic over the value lattice
; ---------------------------------------------------------------------------
;; `int` means "an integer-valued number", so integer arithmetic stays in the int kind and
;; only the RANGE is lost on i64 overflow. That is sound: the result is still integral, we
;; just stop tracking bounds. (Whether it is exactly representable past 2^53 is a codegen
;; question, not a lattice one.)
;;
;; Non-numeric operands are handled by real JavaScript semantics, conservatively:
;;   `+`  can concatenate strings or call valueOf, so the result is `dyn`
;;   `-` `*` `/`  coerce to number, so the result is `num` (NaN is a float)
;; Both are sound, and the second is precise. Neither is a placeholder: M5 replaces them with
;; guarded specialisations, it does not correct them.
(defn ty-kinds-of [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-kinds v))
    (TBot [] VK-MASK)  ; ALL includes every value
    (TTop [] VK-NONE)
    (TCtrl [] VK-NONE)
    (TXCtrl [] VK-NONE)
    (TTuple [o l] VK-NONE)
    ; a memory state is not a value, so it joins control and tuples: no kinds at all, which is what
    ; makes `ty-numeric?` and `ty-int-only?` false for it and keeps the int-axis readers below
    ; unreachable on one
    (TMem [a c] VK-NONE)))

(defn ty-numeric? [(t i64)] (-> bool)
  (let [k (ty-kinds-of t)] (and (!= k VK-NONE) (= (& k (^ VK-NUM -1)) 0))))

(defn ty-int-only? [(t i64)] (-> bool)
  (= (ty-kinds-of t) VK-INT))

(defn ty-int-lo [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-ilo v))
    (TBot [] TY-IMIN)
    (TTop [] TY-IMAX)
    (TCtrl [] TY-IMIN)
    (TXCtrl [] TY-IMIN)
    (TTuple [o l] TY-IMIN)
    (TMem [a c] TY-IMIN)))
(defn ty-int-hi [(t i64)] (-> i64)
  (match (ty-get t)
    (TVal [v] (val-ihi v))
    (TBot [] TY-IMAX)
    (TTop [] TY-IMIN)
    (TCtrl [] TY-IMAX)
    (TXCtrl [] TY-IMAX)
    (TTuple [o l] TY-IMAX)
    (TMem [a c] TY-IMAX)))

(defn add-ovf? [(a i64) (b i64) (s i64)] (-> bool)
  ; overflow exactly when the operands share a sign and the result's sign differs
  (and (= (< a 0) (< b 0)) (!= (< s 0) (< a 0))))

(defn mul-ovf? [(a i64) (b i64) (p i64)] (-> bool)
  (if (= a 0)
      false
      (if (and (= a -1) (= b TY-IMIN))
          true  ; test before dividing: IMIN/-1 is undefined
          (!= (/ p a) b))))

(defn imin4 [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (imin2 (imin2 a b) (imin2 c d)))
(defn imax4 [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (imax2 (imax2 a b) (imax2 c d)))
(defn int-fast-result? [(v i64)] (-> bool)
  (and (>= v -140737488355328) (<= v 140737488355327)))

(defn arith-compute [(op Op) (a i64) (b i64)] (-> i64)
  ; ANY on either side means "no value can be here", so the result cannot either. Preserving
  ; that is what lets the optimistic pass start high and fall.
  (if (or (ty-high? a) (ty-high? b))
      (t-top)
      (if (not (and (ty-numeric? a) (ty-numeric? b)))
          (if (op-value-is? op Add []) (t-dyn) (t-num))
          (if (op-value-is? op Div [])
              (div-numeric a b)
              (if (not (and (ty-int-only? a) (ty-int-only? b)))
                  (t-num)
                  (int-arith op (ty-int-lo a) (ty-int-hi a) (ty-int-lo b) (ty-int-hi b)))))))

(defn int-arith [(op Op) (alo i64) (ahi i64) (blo i64) (bhi i64)] (-> i64)
  ; An inverted range is the HIGH element of the int axis: no integer is in it. So the answer
  ; is the HIGH type, not `int`. Answering `int` (the axis BOTTOM) is what made this compute
  ; RISE: `join(int=8, int=[0..5])` is `int=~[5..8]`, the old answer was `int`, and when the
  ; input later fell to `int=[0..5]` the result became `int=[1..6]`, which is above `int`.
  ; `val-high?` now reports an inverted range as high so `arith-compute` filters it out one
  ; level up; this stays because the axis rule belongs where the axis is computed.
  (if (or (> alo ahi) (> blo bhi))
      (t-top)
      (if (and (= alo ahi) (= blo bhi))
          (if (op-value-is? op Add [])
              (let [s (+ alo blo)]
                (if (and (not (add-ovf? alo blo s)) (int-fast-result? s))
                    (t-int-con s)
                    (t-flt-con (+ (cast f64 alo) (cast f64 blo)))))
              (if (op-value-is? op Sub [])
                  (if (= blo TY-IMIN)
                      (t-flt-con (- (cast f64 alo) (cast f64 blo)))
                      (let [s (- alo blo)]
                        (if (and (not (add-ovf? alo (- 0 blo) s)) (int-fast-result? s))
                            (t-int-con s)
                            (t-flt-con (- (cast f64 alo) (cast f64 blo))))))
                  (let [p (* alo blo)]
                    (if (and (= p 0) (!= (< alo 0) (< blo 0)))
                        (t-flt-bits -9223372036854775808)
                        (if (and (not (mul-ovf? alo blo p)) (int-fast-result? p))
                            (t-int-con p)
                            (t-flt-con (* (cast f64 alo) (cast f64 blo))))))))
          (if (op-value-is? op Add [])
              (let [lo (+ alo blo)
                    hi (+ ahi bhi)]
                (if (or (add-ovf? alo blo lo)
                        (or (add-ovf? ahi bhi hi)
                            (or (not (int-fast-result? lo)) (not (int-fast-result? hi)))))
                    (t-num)
                    (t-int-range lo hi)))
              (if (op-value-is? op Sub [])
                  (let [lo (- alo bhi)
                        hi (- ahi blo)]
                    (if (or (= bhi TY-IMIN)
                            (or (= blo TY-IMIN)
                                (or (add-ovf? alo (- 0 bhi) lo)
                                    (or (add-ovf? ahi (- 0 blo) hi)
                                        (or (not (int-fast-result? lo))
                                            (not (int-fast-result? hi)))))))
                        (t-num)
                        (t-int-range lo hi)))
                  ; multiply: the extremes are among the four corner products
                  (let [p1 (* alo blo)
                        p2 (* alo bhi)
                        p3 (* ahi blo)
                        p4 (* ahi bhi)]
                    (if (or (mul-ovf? alo blo p1)
                            (or (mul-ovf? alo bhi p2)
                                (or (mul-ovf? ahi blo p3)
                                    (or (mul-ovf? ahi bhi p4)
                                        (or (not (int-fast-result? (imin4 p1 p2 p3 p4)))
                                            (not (int-fast-result? (imax4 p1 p2 p3 p4))))))))
                        (t-num)
                        (if (or (and (range-has? alo ahi 0) (< blo 0))
                                (and (range-has? blo bhi 0) (< alo 0)))
                            (t-num)
                            (t-int-range (imin4 p1 p2 p3 p4) (imax4 p1 p2 p3 p4))))))))))

;; Division leaves the integers: 1/2 is 0.5 and x/0 is an infinity. So the result is `num`
;; unless both sides are integer constants that divide exactly.
(defn div-numeric [(a i64) (b i64)] (-> i64)
  (if (and (and (ty-int-only? a) (ty-int-only? b))
           (and (ty-const? a) (ty-const? b)))
      (let [x (ty-int-lo a)
            y (ty-int-lo b)]
        (if (= y 0)
            (t-flt-con (/ (cast f64 x) 0.0))
            (if (and (= x TY-IMIN) (= y -1))
                (t-flt-con (/ (cast f64 x) (cast f64 y)))
                (if (= (% x y) 0)
                    (let [q (/ x y)]
                      (if (and (= q 0) (!= (< x 0) (< y 0)))
                          (t-flt-bits -9223372036854775808)
                          (if (int-fast-result? q)
                              (t-int-con q)
                              (t-flt-con (/ (cast f64 x) (cast f64 y))))))
                    (t-flt-con (/ (cast f64 x) (cast f64 y)))))))
      (t-num)))

(defn minus-compute [(a i64)] (-> i64)
  (if (ty-high? a)
      (t-top)
      (if (not (ty-numeric? a))
          (t-num)
          (if (not (ty-int-only? a))
              (t-num)
              (let [lo (ty-int-lo a)
                    hi (ty-int-hi a)]
                ; an inverted range holds no integer, so the negation holds none either: the HIGH
                ; answer, not `int`. See the note in `int-arith`; `int` here also rose.
                (if (> lo hi)
                    (t-top)
                    (if (= lo hi)
                        (if (= lo 0)
                            (t-flt-bits -9223372036854775808)
                            (if (or (= lo TY-IMIN)
                                    (or (< (- 0 lo) -140737488355328)
                                        (> (- 0 lo) 140737488355327)))
                                (t-flt-con (- 0.0 (cast f64 lo)))
                                (t-int-con (- 0 lo))))
                        (if (or (= lo TY-IMIN)
                                (or (range-has? lo hi 0)
                                    (or (< (- 0 hi) -140737488355328)
                                        (> (- 0 lo) 140737488355327))))
                            (t-num)
                            (t-int-range (- 0 hi) (- 0 lo))))))))))

;; `!x` is the truthiness question with the answer inverted, so it asks the same predicates
;; the If does rather than carrying a second, smaller copy of the rules.
(defn not-compute [(a i64)] (-> i64)
  (if (ty-high? a)
      (t-top)
      (let [f (ty-can-be-falsey? a)
            tr (ty-can-be-truthy? a)]
        (if (and f (not tr))
            (t-bool-con true)
            (if (and tr (not f))
                (t-bool-con false)
                ; neither truthy nor falsey means the operand holds no value at all, so neither does
                ; the answer. `bool` here is the axis bottom and rose as soon as the input fell.
                (if (or f tr) (t-bool) (t-top)))))))

(defn ty-number-constant? [(t i64)] (-> bool)
  (and (ty-const? t) (or (= (ty-kinds-of t) VK-INT) (= (ty-kinds-of t) VK-FLT))))
(defn ty-number-constant-f64 [(t i64)] (-> f64)
  (match (ty-get t)
    (TVal [v]
          (if (= (val-kinds v) VK-INT)
              (cast f64 (val-ilo v))
              (bits-f64 (val-fbits v))))
    (TTop [] 0.0)
    (TBot [] 0.0)
    (TCtrl [] 0.0)
    (TXCtrl [] 0.0)
    (TTuple [o l] 0.0)
    (TMem [a c] 0.0)))

(defn ty-number-to-int32 [(t i64)] (-> i64)
  (if (ty-int-only? t)
      (js-to-int32-int (ty-int-lo t))
      (js-to-int32-f64 (ty-number-constant-f64 t))))

(defn bitwise-compute [(op i64) (a i64) (b i64)] (-> i64)
  (if (or (ty-high? a) (ty-high? b))
      (t-top)
      (if (and (ty-number-constant? a) (ty-number-constant? b))
          (t-int-con (js-bit-bin op (ty-number-to-int32 a) (ty-number-to-int32 b)))
          (if (= op JS-USHR)
              (t-int-range 0 4294967295)
              (t-int-range -2147483648 2147483647)))))

(defn bitnot-compute [(a i64)] (-> i64)
  (if (ty-high? a)
      (t-top)
      (if (ty-number-constant? a)
          (t-int-con (js-bit-not (ty-number-to-int32 a)))
          (t-int-range -2147483648 2147483647))))

(defn mod-compute [(a i64) (b i64)] (-> i64)
  (if (or (ty-high? a) (ty-high? b))
      (t-top)
      (if (and (ty-number-constant? a) (ty-number-constant? b))
          (t-flt-bits (js-remainder-bits (ty-number-constant-f64 a)
                                         (ty-number-constant-f64 b)))
          (t-num))))

;; RANGES DECIDE COMPARISONS, NOT ONLY CONSTANTS — and the difference is not academic.
;;
;; `StringIndexOfFrom` clamps its start, and at the call site that dominates every program —
;; `text.indexOf(needle)` — that start is the constant 0, so the clamp is `Clamp 0 0 (%StringLen s)`.
;; Its first test, `0 < 0`, is two constants and folded even before this. Its second, `len < 0`, did
;; not: a length is a RANGE, not a constant, so the comparison stayed `bool` and the diamond around
;; it survived all the way into the emitted code. A pure, loop-invariant `%StringIndexOf` was then
;; pinned between two live branches instead of being hoisted out of the loop — on
;; benchmarks/typescript-aot/string-loop.ts, 3.8ms against 79.4ms.
;;
;; MONOTONE, which is what a compute owes the fixpoint: ranges only ever narrow, so an answer
;; decided here is never withdrawn, only reached sooner.
(defn cmp-int-compute [(op Op) (a i64) (b i64)] (-> i64)
  (let [alo (ty-int-lo a) ahi (ty-int-hi a)
        blo (ty-int-lo b) bhi (ty-int-hi b)]
    (if (op-value-is? op Eq [])
        ;; Two constants that agree are equal; disjoint ranges cannot be. Anything overlapping and
        ;; not pinned says nothing at all.
        (if (and (ty-const? a) (ty-const? b))
            (t-bool-con (= alo blo))
            (if (or (< ahi blo) (< bhi alo)) (t-bool-con false) (t-bool)))
        (if (op-value-is? op Lt [])
            (if (< ahi blo)
                (t-bool-con true)
                (if (<= bhi alo) (t-bool-con false) (t-bool)))
            (if (<= ahi blo)
                (t-bool-con true)
                (if (< bhi alo) (t-bool-con false) (t-bool)))))))

(defn cmp-compute [(op Op) (a i64) (b i64)] (-> i64)
  (if (or (ty-high? a) (ty-high? b))
      (t-top)
      (if (and (ty-int-only? a) (ty-int-only? b))
          (cmp-int-compute op a b)
          (if (and (ty-number-constant? a) (ty-number-constant? b))
              (let [x (ty-number-constant-f64 a)
                    y (ty-number-constant-f64 b)]
                (t-bool-con (if (op-value-is? op Eq [])
                                (primitive/fcmp-eq x y)
                                (if (op-value-is? op Lt [])
                                    (primitive/fcmp-lt x y) (primitive/fcmp-le x y)))))
              (t-bool)))))

;; ---------------------------------------------------------------------------
;; Removing a positional input
;; ---------------------------------------------------------------------------
;; Only valid for nodes whose inputs are a positional LIST (a Region's paths, a Phi's values,
;; Stop's returns) rather than fixed slots. Compressing an Add's operands would be nonsense.
(defn n-del-def! [(n i64) (i i64)] (-> i64)
  (n-bump-cfg! n)
  (let [old (n-in n i)
        len (n-nins n)
        ins (field (nd n) ins)
        (mut k) i]
    (loop (if (>= (+ (load k) 1) len)
              (break)
              (do
                (al-set! [i64] ins (load k) (al-get (load ins) (+ (load k) 1)))
                (set! k (+ (load k) 1))
                0)))
    (al-pop! [i64] ins)
    (set! (.hash (nd n)) 0)
    (if (!= old NO-NODE)
        (if (n-del-use! old n)
            (if (= (n-keeps old) 0) (n-kill! old) (wl-push! old))
            (wl-push! old))
        0)
    (n-move-deps! n)
    (wl-push! n)
    0))

;; ---------------------------------------------------------------------------
;; THE IN-PROGRESS CONTRACT, which a front end must honour
;; ---------------------------------------------------------------------------
;; A merge still being built has a null final input. Two rules follow, and together they are a
;; contract on whoever builds the graph:
;;
;;   1. An in-progress merge reports CONTROL, and a Phi on one reports its DECLARED type.
;;      Otherwise the not-yet-attached path makes the region look dead and the optimiser
;;      deletes a loop body that was about to be filled in.
;;   2. A loop body must be built AND PEEPHOLED inside that window, and the Phis closed before
;;      the control back edge.
;;
;; Rule 2 is the one that bites. Build `i = 0; while(true) i = i + 1;` by closing the loop
;; first and only then peepholing the body, and here is what happens: with the region no longer
;; in progress and the back-edge value still unanalysed, the phi meets only the entry and
;; reports `int=0`. That is a perfectly good OPTIMISTIC answer and it will fall. But `i + 1`
;; then computes `int=1`, which is a constant, and folding is irreversible: the increment
;; becomes the literal 1, the phi loses its only other user, and the entire loop is deleted.
;; Nothing reports an error, because every individual step was locally justified.
;;
;; Build it in the right order and the phi reports `int` throughout, `i + 1` is `int`, and after
;; closing the loop everything is already at its fixpoint.
;;
;; The general defence is M7's phase structure, which analyses to a fixpoint before it
;; transforms anything. Until then, the contract is on the builder, and `n-set-def!` checks the
;; one part of it that is cheap to check.
(defn n-in-progress? [(n i64)] (-> bool)
  (and (> (n-nins n) 1) (= (n-in n (- (n-nins n) 1)) NO-NODE)))

(defn n-xctrl [] (-> i64)
  (n-peephole (n-new (XCtrl))))

;; LAW 4 FOR A MULTI NODE. A merge is in progress until its last input arrives; an If is in
;; progress until its last PROJECTION exists, and for the same reason: a peephole fired inside
;; that window sees a node whose neighbourhood is only half built.
;;
;; The concrete failure. Build `if (0) return 2; else return 3;` one projection at a time. The
;; true arm's type is XCtrl, so peepholing it folds it to XCtrl and `n-subsume!` kills the raw
;; projection. That was the If's ONLY use, so `n-del-use!` reports the If unused and the kill
;; cascade kills the If itself. The false arm is then created on a dead node and peepholed
;; against a dead node: `n-kill!` cleared the If's inputs but not its TYPE, so the tuple still
;; matches, the sibling still reads as XCtrl, and the rewrite reaches for the If's control input,
;; which no longer exists. Before `n-in` was bounds-checked that read returned a stale buffer
;; word, and on a NESTED dead branch the stale word was itself a dead node: the surviving Return
;; ended up with a dead control input and the arm that should have run reported EV-STUCK.
;;
;; So the multi is PINNED across the whole window. `n-del-use!` reports a pinned node as still
;; used, which is the existing mechanism the roots and every `n-subsume!` replacement already
;; rely on, so nothing new has to be invented for it.
;;
;; The pin is not a substitute for dead-code elimination: an If both of whose projections
;; resolved to something else really is garbage, and leaving it live would hold its predicate
;; alive and print a branch the program no longer has. `n-multi-close!` collects it, which is why
;; the graph this produces is the same graph the naive build produced in the cases where the naive
;; build happened to work (node NUMBERING can differ, since the pin changes nothing about when
;; nodes are created but a caller may now create the two projections adjacently; nothing in the
;; suite encodes a node id, deliberately).
(defn n-multi-open! [(m i64)] (-> i64)
  (n-keep! m)
  m)

(defn n-multi-close! [(m i64)] (-> i64)
  (n-unkeep! m)
  ; still pinned means an OUTER window is open on the same node, and that window owns the collect
  (if (and (and (not (n-dead? m)) (= (n-keeps m) 0)) (= (n-nouts m) 0)) (n-kill! m) 0)
  m)

;; An If's two control projections, built and peepholed as ONE operation, which is the way every
;; caller should get them: the open/close pair above is the primitive, and forgetting to use it is
;; what `cproj-idealize`'s named abort exists to catch. A multi with an arity the IR does not build
;; by hand yet (M6's `Start`, one output per parameter) opens and closes the window itself.
(defstruct Arms [(t i64) (f i64)])
(defn arms-t [(a Arms)] (-> i64)
  (.t a))
(defn arms-f [(a Arms)] (-> i64)
  (.f a))

(defn n-if-arms! [(iff i64)] (-> Arms)
  (n-multi-open! iff)
  (let [(mut r) (zeroed Arms)]
    (set! (.t r) (n-peephole (n-new1 (CProj 0) iff)))
    (set! (.f r) (n-peephole (n-new1 (CProj 1) iff)))
    ; THE ARMS ARE PINNED ACROSS THE CLOSE, and this is the second half of the same bug rather
    ; than belt and braces. Closing the window may kill the If, and the sibling-is-dead rewrite
    ; hands back the If's OWN CONTROL INPUT, so the surviving arm is at that moment used by
    ; nothing but the If that is about to die. On a flat `if(0)` that input is Start, which is
    ; pinned, and the fixture looked correct; nested inside another branch it is an ordinary
    ; CProj, and the cascade killed the arm we were about to return. The caller then wired a live
    ; Return to a dead node: `g-verify` says VERR-DEAD-INPUT and the arm that should have run
    ; reports EV-STUCK. Held only in these two slots, the arms need exactly what `n-peephole`
    ; gives a replacement across `n-subsume!`.
    (n-keep! (.t r))
    (n-keep! (.f r))
    (n-multi-close! iff)
    (n-unkeep! (.t r))
    (n-unkeep! (.f r))
    (load r)))

;; Branch on compiler-owned host dispatch metadata. This comparison is not a JavaScript
;; operation: `selector` is the integer argument of the native batch entry point and `index`
;; identifies an independently compiled Script. Keeping it here prevents structural dispatch
;; from being mistaken for frontend implementation of JavaScript equality.
(defn n-host-index-arms! [(ctrl i64) (selector i64) (index i64)] (-> Arms)
  (let [predicate
          (n-peephole
            (n-new3 (Eq) NO-NODE selector
                    (n-new1 (Const (t-int-con index)) (g-start))))]
    (n-if-arms! (n-peephole (n-new2 (If) ctrl predicate)))))

;; The live projection of a multi node at one slot, or NO-NODE. Found by walking def-use, the
;; same way `ev-if-arm` finds a branch arm: a multi node's projections are not held anywhere else,
;; so this is the only place that knows how to get from the multi to its outputs.
(defn n-multi-proj [(m i64) (slot i64)] (-> i64)
  (let [len (n-nouts m)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (or (>= (load i) len) (!= (load found) NO-NODE))
              (break)
              (do
                (let [u (n-out m (load i))]
                  (if (and (not (n-dead? u))
                           (match (n-op u) (Proj [projection] (= projection slot)) (_ false)))
                      (set! found u)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load found)))

; ---------------------------------------------------------------------------
; Building an allocation
; ---------------------------------------------------------------------------
;; A New AND EVERY ONE OF ITS PROJECTIONS, built and peepholed as one operation, inside the same
;; `n-multi-open!` window `n-if-arms!` uses. LAW 4 applies to any multi node, and a New is one.
;;
;; It needs no equivalent of `n-if-arms!`'s pinning of the arms across the close, and the reason
;; is worth stating rather than leaving as an absence: that pin exists because peepholing an If's
;; first projection can REPLACE it, which drops the If's last use and runs the kill cascade
;; through the arm that is about to be returned. A New's projections cannot be replaced by
;; anything. `proj-compute` gives slot 0 an object type and every other slot a memory type,
;; `ty-const?` is false for both (an allocation is not a compile-time constant and neither is a
;; memory state), `n-idealize` has no arm for OPTAG-PROJ, and two projections of one New at one slot
;; are never built. So nothing here can subsume, and the window is doing only its own job.
(defn n-new-obj! [(ctrl i64) (shape i64) (mems (slice i64))] (-> i64)
  (if (shape-defined? shape)
      0
      (do (panic-corrupt "n-new-obj!: not a defined shape id") 0))
  (let [k (shape-field-count shape)]
    (if (= (slice-len mems) k)
        0
        (do (panic-corrupt "n-new-obj!: a New takes the incoming memory of EVERY field of its shape, one each") 0))
    (let [nw (n-new (New shape))
          (mut i) 0]
      (n-add-def! nw ctrl)
      (loop (if (>= (load i) k)
                (break)
                (do
                  (n-add-def! nw (slice-get mems (load i)))
                  (set! i (+ (load i) 1))
                  0)))
      ; A peephole that MOVED the New would leave the projections below hanging off a node the
      ; caller does not hold. It cannot today (see the note above), and this is how that stays true.
      (if (= (n-peephole nw) nw)
          0
          (do (panic-corrupt "n-new-obj!: a New was replaced by its own peephole") 0))
      (n-multi-open! nw)
      (let [(mut j) 0]
        (loop (if (> (load j) k)
                  (break)
                  (do
                    (n-peephole (n-new1 (Proj (load j)) nw))
                    (set! j (+ (load j) 1))
                    0))))
      (n-multi-close! nw)
      nw)))

;; The two arities the IR builds by hand. A shape with more fields than this is built through
;; `n-new-obj!` with a slice; these exist so a fixture does not have to spell out a one-element
;; buffer, and each refuses a shape of the wrong width by name rather than silently allocating an
;; object whose other fields nothing initialises.
(defn n-new-obj0! [(ctrl i64) (shape i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1))]
    (n-new-obj! ctrl shape (slice-new [i64] (cast (ptr i64) buf) 0))))

(defn n-new-obj1! [(ctrl i64) (shape i64) (m0 i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1))
        p (cast (ptr i64) buf)]
    (set! (index p 0) m0)
    (n-new-obj! ctrl shape (slice-new [i64] p 1))))

(defn n-new-obj2! [(ctrl i64) (shape i64) (m0 i64) (m1 i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 2))
        p (cast (ptr i64) buf)]
    (set! (index p 0) m0)
    (set! (index p 1) m1)
    (n-new-obj! ctrl shape (slice-new [i64] p 2))))

;; A New's outputs by MEANING rather than by slot number. The pairing (input slot 1+i is field
;; i's incoming memory, output slot 1+i is its outgoing memory) is stated in the op table and
;; read out here, so a caller never writes the `+ 1` itself.
(defn n-obj-proj [(nw i64) (slot i64)] (-> i64)
  (if (op-is? nw New [_])
      0
      (do (panic-corrupt "n-obj-proj: not a New") 0))
  (let [pr (n-multi-proj nw slot)]
    (if (!= pr NO-NODE)
        0
        (do (panic-corrupt "n-obj-proj: that projection of the New does not exist") 0))
    pr))
(defn n-obj-ptr [(nw i64)] (-> i64)
  (n-obj-proj nw 0))
(defn n-obj-mem [(nw i64) (i i64)] (-> i64)
  (n-obj-proj nw (+ i 1)))

; ---------------------------------------------------------------------------
; Building a memory op
; ---------------------------------------------------------------------------
;; The alias is checked HERE, against the table that could know, for the same reason
;; `shape-defined?` is checked at every entry point that takes a shape id: `t-mem-alias` would
;; catch a number past ALIAS-MAX, but an in-range number that no transition ever allocated is a
;; load off a word the program has no name for, and it would type-check perfectly.
(defn n-check-alias [(alias i64) (what (slice u8))] (-> i64)
  (if (shape-alias-defined? alias)
      0
      (do (panic-corrupt what) 0)))

(defn n-load! [(mem i64) (ptr i64) (alias i64)] (-> i64)
  (n-check-alias alias "n-load!: not an allocated alias number")
  (n-peephole (n-new3 (Load alias) NO-NODE mem ptr)))

(defn n-effect! [(ctrl i64) (mem i64) (value i64)] (-> i64)
  (n-peephole (n-new3 (Effect) ctrl mem value)))

;; The `-at!` variant, for the reason `jl-prim-mem` gives about its own: a read with a null control
;; anchor floats, and global code motion then hoists it to the shallowest block between its inputs
;; and its uses. That is right for a straight-line body and wrong when the POINTER is loop-local:
;; `for (const o of xs) o.v` put the shape-slot load outside the loop and left the `Unbox` that
;; produced its pointer inside, which is a dependency `ms-gcm-place!` refuses (MSEL-DEPENDENCY).
(defn n-load-at! [(ctrl i64) (mem i64) (ptr i64) (alias i64)] (-> i64)
  (n-check-alias alias "n-load-at!: not an allocated alias number")
  (n-peephole (n-new3 (Load alias) ctrl mem ptr)))

(defn n-store! [(mem i64) (ptr i64) (val i64) (alias i64)] (-> i64)
  (n-check-alias alias "n-store!: not an allocated alias number")
  (n-peephole (n-new4 (Store alias) NO-NODE mem ptr val)))

(defn n-prop-load-at! [(ctrl i64) (mem i64) (ptr i64) (name (slice u8))] (-> i64)
  (n-peephole (n-new3 (PropLoad (shape-name-intern! name)) ctrl mem ptr)))

(defn n-prototype-has-at! [(ctrl i64) (mem i64) (ptr i64) (prototype i64)] (-> i64)
  (n-peephole (n-new4 (ProtoHas) ctrl mem ptr prototype)))

(defn n-prop-load-key-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)] (-> i64)
  (n-peephole (n-new4 (PropLoadKey 0) ctrl mem ptr key)))

(defn n-prop-load-key-operation-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)
                                      (operation i64)] (-> i64)
  (n-peephole (n-new4 (PropLoadKey operation) ctrl mem ptr key)))

(defn n-own-property-attributes-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)] (-> i64)
  (n-peephole (n-new4 (PropLoadKey 14) ctrl mem ptr key)))

(defn n-get-prototype-at! [(ctrl i64) (mem i64) (ptr i64) (unused i64)] (-> i64)
  ;; The shared runtime property entry point uses operation 24 for [[GetPrototypeOf]]. Keep the
  ;; otherwise-unused fourth graph input because PropLoadKey has one uniform shape, but preserve
  ;; the operation discriminator: lowering this through the ordinary operation-0 constructor
  ;; performs `object[null]` and can turn a prototype walk into an infinite loop on `undefined`.
  (n-peephole (n-new4 (PropLoadKey 24) ctrl mem ptr unused)))

(defn n-property-component-at! [(ctrl i64) (mem i64) (ptr i64) (key i64) (operation i64)] (-> i64)
  (n-peephole (n-new4 (PropLoadKey operation) ctrl mem ptr key)))

(defn n-prop-store-key-at! [(ctrl i64) (mem i64) (ptr i64) (key i64) (value i64)] (-> i64)
  (n-peephole (n-new5 (PropStoreKey 1) ctrl mem ptr key value)))

(defn n-prop-store-key-operation-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)
                                       (value i64) (operation i64)] (-> i64)
  (n-peephole (n-new5 (PropStoreKey operation) ctrl mem ptr key value)))

(defn n-set-property-attributes-at! [(ctrl i64) (mem i64) (ptr i64) (key i64) (attributes i64)] (-> i64)
  (n-peephole (n-new5 (PropStoreKey 15) ctrl mem ptr key attributes)))

(defn n-define-property-component-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)
                                        (value i64) (operation i64)] (-> i64)
  (n-peephole (n-new5 (PropStoreKey operation) ctrl mem ptr key value)))

(defn n-prop-has-key-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)] (-> i64)
  (n-peephole (n-new4 (PropHasKey) ctrl mem ptr key)))

(defn n-prop-delete-key-at! [(ctrl i64) (mem i64) (ptr i64) (key i64)] (-> i64)
  (n-peephole (n-new4 (PropDeleteKey) ctrl mem ptr key)))

(defn n-own-key-count-at! [(ctrl i64) (mem i64) (ptr i64)] (-> i64)
  (n-peephole (n-new3 (OwnKeyCount) ctrl mem ptr)))

(defn n-own-key-at-at! [(ctrl i64) (mem i64) (ptr i64) (ordinal i64)] (-> i64)
  (n-peephole (n-new4 (OwnKeyAt) ctrl mem ptr ordinal)))

(defn n-object-freeze-at! [(ctrl i64) (mem i64) (ptr i64)] (-> i64)
  (n-peephole (n-new3 (ObjectFreeze) ctrl mem ptr)))

(defn n-internal-load-at! [(ctrl i64) (mem i64) (ptr i64) (slot i64)] (-> i64)
  (n-peephole (n-new3 (InternalLoad slot) ctrl mem ptr)))
(defn n-internal-init-at! [(ctrl i64) (mem i64) (ptr i64) (target i64) (kind i64)] (-> i64)
  (n-peephole (n-new5 (InternalStore INTERNAL-INIT) ctrl mem ptr target kind)))
(defn n-internal-set-index-at! [(ctrl i64) (mem i64) (ptr i64) (index i64)] (-> i64)
  (n-peephole (n-new4 (InternalStore INTERNAL-SET-INDEX) ctrl mem ptr index)))

(defn n-prop-store-at! [(ctrl i64) (mem i64) (ptr i64) (val i64) (name (slice u8))] (-> i64)
  (n-peephole (n-new4 (PropStore (shape-name-intern! name)) ctrl mem ptr val)))

(defn n-set-prototype-at! [(ctrl i64) (mem i64) (ptr i64) (prototype i64)] (-> i64)
  (n-peephole (n-new4 (SetProto) ctrl mem ptr prototype)))

;; The mark lowers to a runtime call, so it must not float: demand-driven selection placed one
;; in whichever consumer's block asked first, which can sit after (or fail to dominate) another
;; consumer. Anchor it to the control point of its allocation.
(defn n-array-mark! [(ctrl i64) (ptr i64)] (-> i64)
  (n-peephole (n-new2 (ArrayMark) ctrl ptr)))

(defn n-array-load-at! [(ctrl i64) (mem i64) (ptr i64) (index i64)] (-> i64)
  (n-peephole (n-new4 (ArrayLoad 0) ctrl mem ptr index)))

(defn n-array-store! [(mem i64) (ptr i64) (index i64) (value i64)] (-> i64)
  (n-peephole (n-new5 (ArrayStore) NO-NODE mem ptr index value)))

(defn n-array-store-at! [(ctrl i64) (mem i64) (ptr i64) (index i64) (value i64)] (-> i64)
  (n-peephole (n-new5 (ArrayStore) ctrl mem ptr index value)))

(defn n-array-length! [(mem i64) (ptr i64)] (-> i64)
  (n-peephole (n-new3 (ArrayLen) NO-NODE mem ptr)))

(defn n-array-length-at! [(ctrl i64) (mem i64) (ptr i64)] (-> i64)
  (n-peephole (n-new3 (ArrayLen) ctrl mem ptr)))

(defn n-array-resize-after-at! [(ctrl i64)
                                 (mem i64)
                                 (ptr i64)
                                 (length i64)
                                 (value i64)] (-> i64)
  (n-peephole (n-new5 (ArrayResize) ctrl mem ptr length value)))

(defn n-string-const! [(string i64)] (-> i64)
  (n-peephole (n-new1 (StringConst string) (g-start))))
(defn n-to-number! [(value i64)] (-> i64)
  (n-peephole (n-new2 (ToNumber) NO-NODE value)))
(defn n-memmerge2! [(a i64) (b i64)] (-> i64)
  (n-peephole (n-new3 (MemMerge) NO-NODE a b)))

(defn n-box! [(v i64)] (-> i64)
  (n-peephole (n-new2 (Box 0) NO-NODE v)))

(defn n-box-array! [(v i64)] (-> i64)
  (n-peephole (n-new2 (Box BOX-AUX-ARRAY) NO-NODE v)))

(defn n-unbox! [(v i64) (target i64)] (-> i64)
  (n-peephole (n-new2 (Unbox target) NO-NODE v)))

(defn n-typetest! [(v i64) (target i64)] (-> i64)
  (n-peephole (n-new2 (TypeTest target) NO-NODE v)))

(defn n-callable-id! [(fun i64)] (-> i64)
  (n-peephole (n-new1 (CallableId (n-fun-index fun)) (g-start))))

;; Function definitions are cyclic by construction: Parm -> Fun -> body Return -> expression ->
;; Parm. The open/close API makes that cycle explicit and prevents a caller from pretending a
;; half-built function is ready to call.
(defn n-fun-open-identity! [(fidx i64) (kind i64) (unit i64) (local i64)] (-> i64)
  (if (and (>= fidx 0)
           (and (< fidx (al-len [i64] (.fun-index (graph))))
                (!= (al-get [i64] (.fun-index (graph)) fidx) NO-NODE)))
      (do (panic-corrupt "n-fun-open-identity!: function index is already owned") NO-NODE)
      0)
  (let [fun (n-new (Fun fidx))
        entry (n-new1 (FunStart) fun)]
    (loop (if (> (al-len [i64] (.fun-index (graph))) fidx)
              (break)
              (do
                (al-push! [i64] (field (graph) fun-index) NO-NODE)
                (al-push! [i64] (field (graph) fun-identity-kind) FUN-IDENTITY-EPHEMERAL)
                (al-push! [i64] (field (graph) fun-identity-unit) 0)
                (al-push! [i64] (field (graph) fun-identity-local) 0)
                (al-push! [bool] (field (graph) fun-imported) false)
                (al-push! [i64] (field (graph) fun-abi-param-first) 0)
                (al-push! [i64] (field (graph) fun-abi-param-count) -1)
                (al-push! [i64] (field (graph) fun-abi-result-first) 0)
                (al-push! [i64] (field (graph) fun-abi-result-count) -1)
                (al-push! [bool] (field (graph) fun-abi-can-throw) false)
                0)))
    (al-set! [i64] (field (graph) fun-index) fidx fun)
    (al-set! [i64] (field (graph) fun-identity-kind) fidx kind)
    (al-set! [i64] (field (graph) fun-identity-unit) fidx unit)
    (al-set! [i64] (field (graph) fun-identity-local) fidx local)
    (al-set! [bool] (field (graph) fun-imported) fidx false)
    (n-add-def! fun entry)
    fun))
(defn n-fun-open! [(fidx i64)] (-> i64)
  (n-fun-open-identity! fidx FUN-IDENTITY-EPHEMERAL 0 fidx))
(defn n-fun-identity-kind [(fun i64)] (-> i64)
  (al-get [i64] (.fun-identity-kind (graph)) (n-fun-index fun)))
(defn n-fun-identity-unit [(fun i64)] (-> i64)
  (al-get [i64] (.fun-identity-unit (graph)) (n-fun-index fun)))
(defn n-fun-identity-local [(fun i64)] (-> i64)
  (al-get [i64] (.fun-identity-local (graph)) (n-fun-index fun)))
(defn n-fun-mark-imported! [(fun i64)] (-> i64)
  (al-set! [bool] (field (graph) fun-imported) (n-fun-index fun) true)
  0)
(defn n-fun-imported? [(fun i64)] (-> bool)
  (and (op-is? fun Fun [_])
       (al-get [bool] (.fun-imported (graph)) (n-fun-index fun))))
(defn n-fun-declare-abi-results! [(fun i64) (params (slice i64)) (results (slice i64))]
                                  (-> i64)
  (let [p (graph) fidx (n-fun-index fun)
        param-first (al-len [i64] (.fun-abi-param-types p))
        result-first (al-len [i64] (.fun-abi-result-types p))
        (mut i) 0]
    (al-set! [i64] (field p fun-abi-param-first) fidx param-first)
    (al-set! [i64] (field p fun-abi-param-count) fidx (slice-len params))
    (al-set! [i64] (field p fun-abi-result-first) fidx result-first)
    (al-set! [i64] (field p fun-abi-result-count) fidx (slice-len results))
    (loop (if (>= (load i) (slice-len params)) (break)
              (do (al-push! [i64] (field p fun-abi-param-types) (slice-get params (load i)))
                  (set! i (+ (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (slice-len results)) (break)
              (do (al-push! [i64] (field p fun-abi-result-types) (slice-get results (load i)))
                  (set! i (+ (load i) 1)))))
    0))
(defn n-fun-declare-abi! [(fun i64) (params (slice i64)) (ret i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1)) p (cast (ptr i64) buf)]
    (store! p ret)
    (n-fun-declare-abi-results! fun params (slice-new [i64] p 1))))
(defn n-fun-abi-declared? [(fun i64)] (-> bool)
  (>= (al-get [i64] (.fun-abi-param-count (graph)) (n-fun-index fun)) 0))
(defn n-fun-abi-param-count [(fun i64)] (-> i64)
  (al-get [i64] (.fun-abi-param-count (graph)) (n-fun-index fun)))
(defn n-fun-abi-param-type [(fun i64) (index i64)] (-> i64)
  (al-get [i64] (.fun-abi-param-types (graph))
          (+ (al-get [i64] (.fun-abi-param-first (graph)) (n-fun-index fun)) index)))
(defn n-fun-abi-result-count [(fun i64)] (-> i64)
  (al-get [i64] (.fun-abi-result-count (graph)) (n-fun-index fun)))
(defn n-fun-abi-result-type [(fun i64) (index i64)] (-> i64)
  (if (or (< index 0) (>= index (n-fun-abi-result-count fun)))
      (do (panic-corrupt "n-fun-abi-result-type: result index is outside the ABI range") TY-NO-ID)
      (al-get [i64] (.fun-abi-result-types (graph))
              (+ (al-get [i64] (.fun-abi-result-first (graph)) (n-fun-index fun)) index))))
(defn n-fun-abi-return-type [(fun i64)] (-> i64)
  ;; Scalar compatibility query. Multi-result consumers must select an explicit result index.
  (if (!= (n-fun-abi-result-count fun) 1)
      (do (panic-corrupt "n-fun-abi-return-type: multi-result ABI requires indexed access")
          TY-NO-ID)
      (n-fun-abi-result-type fun 0)))
(defn n-fun-abi-set-can-throw! [(fun i64) (value bool)] (-> i64)
  (al-set! [bool] (field (graph) fun-abi-can-throw) (n-fun-index fun) value)
  0)
(defn n-fun-abi-can-throw? [(fun i64)] (-> bool)
  (and (n-fun-abi-declared? fun)
       (al-get [bool] (.fun-abi-can-throw (graph)) (n-fun-index fun))))
(defn n-fun-entry [(fun i64)] (-> i64)
  (if (and (op-is? fun Fun [_]) (> (n-nins fun) 0)) (n-in fun 0) NO-NODE))
(defn n-parm! [(fun i64) (idx i64)] (-> i64)
  (n-peephole (n-new1 (Parm idx) fun)))
(defn n-closure! [(fun i64) (captures (slice i64))] (-> i64)
  ; Aux publishes the exact environment width so corruption is independently verifiable.
  (let [n (n-new (Closure (slice-len captures)))
        (mut i) 0]
    (n-add-def! n fun)
    (loop (if (>= (load i) (slice-len captures))
              (break)
              (do
                (n-add-def! n (slice-get captures (load i)))
                (set! i (+ (load i) 1))
                0)))
    (n-peephole n)))
(defn n-materialized-closure! [(fun i64) (object i64) (memory i64)
                                (captures (slice i64))] (-> i64)
  ; The object is the native environment allocation and memory proves all environment fields are
  ; initialized before the closure is published. Aux remains the logical capture width, so
  ; inference and the evaluator do not confuse either structural input with a parameter.
  (let [n (n-new (Closure (slice-len captures)))
        (mut i) 0]
    (n-add-def! n fun)
    (n-add-def! n object)
    (n-add-def! n memory)
    (loop (if (>= (load i) (slice-len captures))
              (break)
              (do
                (n-add-def! n (slice-get captures (load i)))
                (set! i (+ (load i) 1))
                0)))
    (n-peephole n)))
(defn n-closure1! [(fun i64) (capture i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1))
        p (cast (ptr i64) buf)]
    (set! (index p 0) capture)
    (n-closure! fun (slice-new [i64] p 1))))

(defn n-safepoint! [(ctrl i64) (refs (slice i64))] (-> i64)
  (let [sp (n-new (Safepoint))
        (mut i) 0]
    (n-add-def! sp ctrl)
    (loop (if (>= (load i) (slice-len refs))
              (break)
              (do
                (n-add-def! sp (slice-get refs (load i)))
                (set! i (+ (load i) 1))
                0)))
    (n-peephole sp)))
(defn n-safepoint0! [(ctrl i64)] (-> i64)
  (n-peephole (n-new1 (Safepoint) ctrl)))
(defn n-safepoint1! [(ctrl i64) (ref i64)] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 1))
        p (cast (ptr i64) buf)]
    (set! (index p 0) ref)
    (n-safepoint! ctrl (slice-new [i64] p 1))))
(defn n-safepoint-ctrl! [(sp i64)] (-> i64)
  (n-peephole (n-new1 (CProj 0) sp)))
(defn n-safepoint-ref! [(sp i64) (idx i64)] (-> i64)
  (n-peephole (n-new1 (Proj (+ idx 1)) sp)))
(defn n-barrier! [(ctrl i64) (mem i64) (obj i64) (value i64)] (-> i64)
  (n-peephole (n-new4 (Barrier) ctrl mem obj value)))

(defn safepoint-control? [(ctrl i64)] (-> bool)
  (and (!= ctrl NO-NODE)
       (and (op-is? ctrl CProj [_])
            (op-is? (n-in ctrl 0) Safepoint []))))

(defn place-safepoint-before! [(n i64) (slot i64)] (-> bool)
  (let [old (n-in n slot)]
    (if (or (= old NO-NODE) (safepoint-control? old))
        false
        (let [sp (n-safepoint0! old)
              ctrl (n-safepoint-ctrl! sp)]
          (n-set-def! n slot ctrl)
          true))))

(defn g-place-safepoints! [] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i))
                    0
                    (let [node (load i)]
                      (if (or (op-is? node New [_]) (op-is? node Call [_]))
                          (if (place-safepoint-before! (load i) 0)
                              (set! count (+ (load count) 1))
                              0)
                          (if (op-is? node Loop [])
                              (if (place-safepoint-before! (load i) 2)
                                  (set! count (+ (load count) 1))
                                  0)
                              0))))
                (set! i (+ (load i) 1))
                0)))
    (load count)))
(defn n-fun-close! [(fun i64) (body-ret i64)] (-> i64)
  (if (or (not (op-is? fun Fun [_])) (!= (n-nins fun) 1))
      (do (panic-corrupt "n-fun-close!: function is not an open Fun") 0)
      (do
        (if (op-is? body-ret Return [])
            0
            (do (panic-corrupt "n-fun-close!: body root is not a Return") 0))
        (n-add-def! fun body-ret)
        (n-peephole fun)
        fun)))

(defn n-fun-add-return! [(fun i64) (body-ret i64)] (-> i64)
  (if (or (not (op-is? fun Fun [_])) (not (op-is? body-ret Return [])))
      (do (panic-corrupt "n-fun-add-return!: expected a Fun and a Return") 0)
      (do (n-add-def! fun body-ret) (n-peephole fun) fun)))

(defstruct CallSite [(call i64) (value i64) (end i64)])
(defn call-node [(c CallSite)] (-> i64)
  (.call c))
(defn call-value [(c CallSite)] (-> i64)
  ;; Construct the compatibility scalar projection on demand. Calls whose value is ignored must
  ;; not manufacture a permanently live, userless Proj merely because their control site exists.
  (if (!= (.value c) NO-NODE)
      (.value c)
      (call-result-at (.call c) (.end c) 0)))
(defn call-end [(c CallSite)] (-> i64)
  (.end c))
(defn call-result-at [(call i64) (normal-ctrl i64) (index i64)] (-> i64)
  (let [fun (infer-direct-callee-fun call)]
    (if (or (= fun NO-NODE) (not (n-fun-abi-declared? fun)))
        (do (if (= index 0) 0
                (panic-corrupt "call-result: unknown call signature has no indexed result"))
            (n-peephole (n-new2 (Proj 0) normal-ctrl call)))
        (let [count (n-fun-abi-result-count fun)]
          (if (or (< index 0) (>= index count))
              (do (panic-corrupt "call-result: result index is outside the call ABI") call)
              ;; Every declared result uses the same controlled projection, including a scalar
              ;; one-result signature. The raw Call word is backend state, not a compatibility
              ;; source-value representation.
              (n-peephole (n-new2 (Proj index) normal-ctrl call)))))))

(defn call-result [(c CallSite) (index i64)] (-> i64)
  (call-result-at (.call c) (.end c) index))

(defn n-proj-source [(projection i64)] (-> i64)
  (if (not (op-is? projection Proj [_]))
      (do (panic-corrupt "n-proj-source: expected Proj") NO-NODE)
      (if (= (n-nins projection) 2)
          (n-in projection 1)
          (n-in projection 0))))

(defn n-proj-normal-control [(projection i64)] (-> i64)
  (if (and (op-is? projection Proj [_]) (= (n-nins projection) 2))
      (n-in projection 0)
      NO-NODE))

;; A Return carries `[control, result..., optional-memory]`. The owning Fun's declared result count
;; is the authority that separates the value range from the trailing effect channel.
(defn n-return-values! [(ctrl i64) (values (slice i64)) (memory i64)] (-> i64)
  (let [ret (n-new (Return)) (mut i) 0]
    (n-add-def! ret ctrl)
    (loop (if (>= (load i) (slice-len values)) (break)
              (do (n-add-def! ret (slice-get values (load i)))
                  (set! i (+ (load i) 1)))))
    (if (= memory NO-NODE) 0 (n-add-def! ret memory))
    ret))
(defn n-return-value [(ret i64) (index i64)] (-> i64)
  (if (or (not (op-is? ret Return [])) (or (< index 0) (>= (+ index 1) (n-nins ret))))
      (do (panic-corrupt "n-return-value: result index is outside the Return") NO-NODE)
      (n-in ret (+ index 1))))

(defn n-call! [(ctrl i64) (callee i64) (args (slice i64))] (-> CallSite)
  (let [call (n-new (Call 0))
        (mut i) 0
        (mut r) (zeroed CallSite)]
    (n-add-def! call ctrl)
    (n-add-def! call callee)
    (loop (if (>= (load i) (slice-len args))
              (break)
              (do
                (n-add-def! call (slice-get args (load i)))
                (set! i (+ (load i) 1))
                0)))
    (set! (.call r) (n-peephole call))
    (set! (.end r) (n-peephole (n-new2 (CallEnd) ctrl (.call r))))
    (set! (.value r) NO-NODE)
    (load r)))

(defn n-call-receiver-abi! [(abi i64) (ctrl i64) (callee i64) (env i64)
                            (receiver i64) (argc i64) (args (slice i64))] (-> CallSite)
  ; The JavaScript receiver ABI: input 2 is the hidden closure environment (the callee VALUE at
  ; generic sites — a closure is its own environment — or a boxed closure/undefined at exact
  ; sites), input 3 is the receiver, input 4 is the actual source argument count, and explicit
  ; arguments follow. Aux distinguishes this
  ; layout from legacy/internal calls.
  ;; The ABI is fixed on the node BEFORE its first peephole. Dynamic receiver calls must retain
  ;; the heap-loaded callable even when its Cast has a singleton target set; constructing them as
  ;; ordinary receiver calls and relabeling afterward allowed call-idealize to replace that runtime
  ;; value with the compile-time Fun during this very n-peephole invocation.
  (let [call (n-new (Call abi))
        (mut i) 0
        (mut r) (zeroed CallSite)]
    (n-add-def! call ctrl)
    (n-add-def! call callee)
    (n-add-def! call env)
    (n-add-def! call receiver)
    (n-add-def! call argc)
    (loop (if (>= (load i) (slice-len args))
              (break)
              (do
                (n-add-def! call (slice-get args (load i)))
                (set! i (+ (load i) 1))
                0)))
    (set! (.call r) (n-peephole call))
    (set! (.end r) (n-peephole (n-new2 (CallEnd) ctrl (.call r))))
    (set! (.value r) NO-NODE)
    (load r)))

(defn n-call-receiver! [(ctrl i64) (callee i64) (env i64) (receiver i64) (argc i64)
                        (args (slice i64))] (-> CallSite)
  (n-call-receiver-abi! CALL-ABI-RECEIVER ctrl callee env receiver argc args))

(defn n-call-dynamic-receiver! [(ctrl i64) (callee i64) (env i64) (receiver i64) (argc i64)
                                (args (slice i64))] (-> CallSite)
  (n-call-receiver-abi! CALL-ABI-DYNAMIC-RECEIVER ctrl callee env receiver argc args))

(defn n-call-captured-receiver! [(ctrl i64)
                                  (callee i64)
                                  (captures (slice i64))
                                  (receiver i64)
                                  (args (slice i64))] (-> CallSite)
  (let [call (n-new (Call (+ CALL-ABI-CAPTURE-BASE (slice-len captures))))
        (mut i) 0
        (mut r) (zeroed CallSite)]
    (n-add-def! call ctrl)
    (n-add-def! call callee)
    (loop (if (>= (load i) (slice-len captures))
              (break)
              (do (n-add-def! call (slice-get captures (load i)))
                  (set! i (+ (load i) 1)))))
    (n-add-def! call receiver)
    (set! i 0)
    (loop (if (>= (load i) (slice-len args))
              (break)
              (do (n-add-def! call (slice-get args (load i)))
                  (set! i (+ (load i) 1)))))
    (set! (.call r) (n-peephole call))
    (set! (.end r) (n-peephole (n-new2 (CallEnd) ctrl (.call r))))
    (set! (.value r) NO-NODE)
    (load r)))

(defn n-call1! [(ctrl i64) (callee i64) (a i64)] (-> CallSite)
  (let [buf (primitive/alloc-stack (array i64 1))
        p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (n-call! ctrl callee (slice-new [i64] p 1))))

(defn n-call2! [(ctrl i64) (callee i64) (a i64) (b i64)] (-> CallSite)
  (let [buf (primitive/alloc-stack (array i64 2))
        p (cast (ptr i64) buf)]
    (set! (index p 0) a)
    (set! (index p 1) b)
    (n-call! ctrl callee (slice-new [i64] p 2))))

; ============================================================================
; JavaScript truthiness
; ============================================================================
;; `if` and `!` both need to know whether a value can be falsey, truthy, or either. This is
;; not "nonzero": false, 0, -0, NaN, "", null and undefined are all falsey, and every object,
;; function and symbol is truthy. Defining it in one place is the difference between two ops
;; agreeing and two ops quietly drifting apart.
;;
;; `str` and `bigint` appear in BOTH answers, because "" and 0n are falsey while "x" and 1n are
;; truthy and the lattice carries no refinement yet to tell them apart. That is imprecision,
;; not unsoundness: it costs a branch, never a wrong answer.
(defn f64-nan-bits? [(b i64)] (-> bool)
  (and (= (& b 9218868437227405312) 9218868437227405312)  ; exponent all ones
       (!= (& b 4503599627370495) 0)))  ; and a non-zero mantissa

(defn fbits-falsey? [(b i64)] (-> bool)
  (or (= (& b TY-IMAX) 0)  ; +0.0 or -0.0: the sign bit does not matter
      (f64-nan-bits? b)))

(defn range-has? [(lo i64) (hi i64) (v i64)] (-> bool)
  (and (<= lo hi) (and (<= lo v) (<= v hi))))
(defn range-has-other-than? [(lo i64) (hi i64) (v i64)] (-> bool)
  (and (<= lo hi) (or (< lo v) (> hi v))))

(const VK-ALWAYS-FALSEY i64 3)  ; undefined | null
(const VK-ALWAYS-TRUTHY i64 832)  ; sym | obj | fun
(const VK-EITHER-WAY i64 160)  ; str | bigint: "" and 0n are falsey, others are not

(defn ty-can-be-falsey? [(t i64)] (-> bool)
  (match (ty-get t)
    (TVal [v]
          (let [k (val-kinds v)]
            (or (!= (& k (| VK-ALWAYS-FALSEY VK-EITHER-WAY)) 0)
                (or (and (!= (& k (| VK-INT VK-BOOL)) 0) (range-has? (val-ilo v) (val-ihi v) 0))
                    (and (!= (& k VK-FLT) 0)
                         (or (!= (val-fsz v) FSZ-CON) (fbits-falsey? (val-fbits v))))))))
    (TBot [] true)  ; ALL includes every falsey value
    (TTop [] false)
    (TCtrl [] false)
    (TXCtrl [] false)
    (TTuple [o l] false)
    (TMem [a c] false)))  ; a memory state is never a condition

(defn ty-can-be-truthy? [(t i64)] (-> bool)
  (match (ty-get t)
    (TVal [v]
          (let [k (val-kinds v)]
            (or (!= (& k (| VK-ALWAYS-TRUTHY VK-EITHER-WAY)) 0)
                (or (and (!= (& k (| VK-INT VK-BOOL)) 0)
                         (range-has-other-than? (val-ilo v) (val-ihi v) 0))
                    (and (!= (& k VK-FLT) 0)
                         (or (!= (val-fsz v) FSZ-CON) (not (fbits-falsey? (val-fbits v)))))))))
    (TBot [] true)
    (TTop [] false)
    (TCtrl [] false)
    (TXCtrl [] false)
    (TTuple [o l] false)
    (TMem [a c] false)))  ; a memory state is never a condition

; ============================================================================
; Control-flow compute
; ============================================================================
;; An If's type is a TUPLE of its two control outputs, slot 0 true and slot 1 false. That is
;; the whole trick behind dead-code elimination here: a branch that provably is not taken shows
;; up as XCtrl in one slot, and everything downstream follows from ordinary type propagation
;; rather than from a separate reachability pass.
(defn t-if-both [] (-> i64)
  (t-tuple2 (t-ctrl) (t-ctrl)))
(defn t-if-true [] (-> i64)
  (t-tuple2 (t-ctrl) (t-xctrl)))
(defn t-if-false [] (-> i64)
  (t-tuple2 (t-xctrl) (t-ctrl)))
(defn t-if-neither [] (-> i64)
  (t-tuple2 (t-xctrl) (t-xctrl)))

;; UNANALYSED IS NOT UNREACHABLE, ON EITHER INPUT.
;;
;; The old test was `(and (!= c (t-ctrl)) (!= c (t-bot)))`, which ANY satisfies, so an If whose
;; own control had not been computed yet reported [~ctrl ~ctrl]: "both arms provably not taken",
;; minted out of no information at all. `cproj-idealize`'s guard is `= (t-xctrl)`, the test its
;; comment defends as "XCtrl, not merely high", and it cannot tell that answer from a proven
;; one, so it replaced BOTH live projections with XCtrl and the arms were killed outright.
;;
;; Same for the predicate: ANY there is "not analysed yet", while a high-but-not-ANY predicate
;; (`~dyn`, or an uninhabited `int=~[5..8]`) is a real claim that no value reaches the test, and
;; an If no value reaches takes neither arm. So the two are separated by `ty-unanalysed?`.
;;
;; Returning ANY is monotone: it falls to [ctrl ctrl] when the control turns out live and to
;; [~ctrl ~ctrl] when it turns out dead, and `proj-compute` maps ANY to ANY so the projections
;; stay unanalysed rather than becoming provably dead.
(defn if-compute [(n i64)] (-> i64)
  (let [c (n-in-ty n 0)
        p (n-in-ty n 1)]
    (if (or (ty-unanalysed? c) (ty-unanalysed? p))
        (t-top)
        ; an If in unreachable code takes neither branch
        (if (and (!= c (t-ctrl)) (!= c (t-bot)))
            (t-if-neither)
            (if (ty-high? p)
                (t-if-neither)
                (let [f (ty-can-be-falsey? p)
                      tr (ty-can-be-truthy? p)]
                  (if (and tr (not f))
                      (t-if-true)
                      (if (and f (not tr))
                          (t-if-false)
                          ; neither truthy nor falsey: the predicate holds no value, so neither arm runs
                          (if (or f tr) (t-if-both) (t-if-neither))))))))))

;; A merge is reachable when ANY path into it is. Input 0 is unused and skipped.
;;
;; WHILE A PATH IS UNANALYSED THERE IS NO CLAIM TO MAKE. The meet below is seeded with `~ctrl`
;; and `ty-meet-ctrl` gives meet(~ctrl, ANY) = ~ctrl (src/ty.coil), so without this guard a
;; Region none of whose paths has a type yet reported `~ctrl`: PROVABLY UNREACHABLE, out of
;; nothing. That is the answer four separate rewrites test for with `= (t-xctrl)` believing they
;; had the proven one. `region-dead-path` dropped a live path and the matching Phi arm,
;; `stop-idealize` dropped a live Return and the kill cascade took the whole program with it,
;; `phi-single-input` collapsed a Phi onto one arm, `cproj-idealize` replaced a live projection
;; with XCtrl. On the control axis "exactly ~ctrl" and "high" are the same thing when the
;; producer is a Region, which is why switching those four from `ty-high?` to `= (t-xctrl)` did
;; not close the hole.
;;
;; ANY is also what makes unanalysedness PROPAGATE: a merge above an unanalysed merge is itself
;; ANY, so a Phi on it has an ANY input and `n-inputs-analysed?` can see it.
(defn region-compute [(n i64)] (-> i64)
  (if (n-in-progress? n)
      (t-ctrl)
      (if (not (n-inputs-analysed? n))
          (t-top)
          (let [len (n-nins n)
                (mut t) (t-xctrl)
                (mut i) 1]
            (loop (if (>= (load i) len)
                      (break)
                      (do
                        (set! t (ty-meet (load t) (n-in-ty n (load i))))
                        (set! i (+ (load i) 1))
                        0)))
            (load t)))))

;; A loop is reachable exactly when its ENTRY is. Meeting the back edge in would make the
;; loop's liveness depend on its own body, which is circular and never settles.
(defn loop-compute [(n i64)] (-> i64)
  (if (n-in-progress? n) (t-ctrl) (n-in-ty n 1)))

(defn proj-compute [(n i64)] (-> i64)
  (let [source (if (and (op-is? n Proj [_]) (= (n-nins n) 2))
                   (n-in n 1) (n-in n 0))
        t (n-ty source)
        idx (match (n-op n) (Proj [slot] slot) (CProj [slot] slot)
              (_ (do (panic-corrupt "proj-compute: expected Proj or CProj") 0)))]
    (if (and (op-is? n Proj [_])
             (and (= (n-nins n) 2) (op-is? source Call [_])))
        (let [fun (infer-direct-callee-fun source)]
          (if (and (!= fun NO-NODE)
                   (and (n-fun-abi-declared? fun)
                        (and (>= idx 0) (< idx (n-fun-abi-result-count fun)))))
              (n-fun-abi-result-type fun idx)
              (if (= idx 0) t (t-bot))))
        (match (ty-get t)
      (TTuple [off len] (if (< idx len) (ty-kid off idx) (t-bot)))
      (TTop [] (t-top))
      (TXCtrl [] (t-top))
      (TBot [] (t-bot))
      (TCtrl [] (t-bot))
      (TVal [v] (if (val-high? v) (t-top) (t-bot)))
      ; A Proj reading a memory state is a malformed node: memory is not a multi-output. The answer
      ; follows the TVal arm rather than inventing one, so an optimistic input still reports ANY and
      ; only a settled one falls to ALL. Memory's own projections (a `New`'s per-alias outputs)
      ; arrive in 4b as projections of a TUPLE, which the arm above already handles.
      (TMem [a c] (if (ty-high? t) (t-top) (t-bot)))))))

;; A Phi's type is the meet over the paths that are actually LIVE, joined with its declared
;; type (aux). Reading a dead path's value would poison the result with a value that cannot
;; arrive, so the phi records a dependency on the region's control inputs: when a path dies,
;; the phi has to be revisited.
(defn phi-compute [(n i64)] (-> i64)
  (let [r (n-in n 0)]
    (if (or (= r NO-NODE) (not (op-merge? (n-op r))))
        ; the region collapsed under us; hold the current answer unless control is gone
        (if (= r NO-NODE) (t-top) (if (ty-high? (n-ty r)) (t-top) (n-ty n)))
        (if (n-in-progress? r)
            (n-phi-declared-type n)
            (let [len (n-nins n)
                  (mut t) (t-top)
                  (mut i) 1]
              (loop (if (>= (load i) len)
                        (break)
                        ; THE DEP GOES ON THE PATH, NOT ON THE REGION. Simple's PhiNode.compute does
                        ; `addDep(r.in(i))`, and this port had lost the `.in(i)`. A region already at
                        ; `ctrl` does NOT change type when a SECOND path goes live (meet(ctrl,ctrl) is
                        ; ctrl), so nothing re-queued the phi and it kept a type computed while that path
                        ; was still high: `if (p) x=8; else x=0;` settled at `int=8` on 5 of 40 seeds and
                        ; the analysis concluded the program always returns 9. A type that is too SPECIFIC
                        ; is the miscompile direction, and `n-set-ty-falling!` cannot catch it because the
                        ; stale type never changes at all.
                        (do
                          (if (!= (n-in r (load i)) NO-NODE) (n-add-dep! (n-in r (load i)) n) 0)
                          (if (ty-high? (n-in-ty r (load i)))
                              0
                              (set! t (ty-meet (load t) (n-in-ty n (load i)))))
                          (set! i (+ (load i) 1))
                          0)))
              (let [joined (ty-join (load t) (n-phi-declared-type n))]
                ; Around a loop, an induction variable's range would creep upward on every trip and
                ; the analysis would never settle. Widening is what bounds it. This widens on any
                ; change to a non-constant, which is blunter than it needs to be and loses some
                ; loop ranges Simple keeps; termination is the property that matters here, and
                ; sharpening it belongs with loop optimisation.
                ;
                ; Around a loop an induction variable's range grows on every trip, and widening is
                ; what bounds it. The FUEL MUST COME FROM THE PHI'S OWN PREVIOUS TYPE, not from
                ; `joined`. Integer arithmetic mints a fresh type (`t-int-range` sets the counter to
                ; 0), so a phi reading its fuel out of the meet of its paths gets a full tank every
                ; trip and the range creeps one step per round for ever. That bug was real and was
                ; invisible on the eagerly-peepholed path, because the in-progress contract makes the
                ; increment read the phi's DECLARED type and the very first `joined` is already at the
                ; axis bottom. Building the same loop raw and running `g-analyze!` reached
                ; `int=[0..6663]` after 20000 steps with zero rises, until the step cap fired. So the
                ; eager path was terminating by accident of construction order rather than by design.
                (if (and (and (op-is? r Loop []) (!= joined (n-ty n))) (not (ty-const? joined)))
                    (ty-widen-from (n-ty n) joined)
                    joined)))))))

;; Cast is the mechanism the entire guard design rests on: after a type test, the value on the
;; taken edge is known to be narrower, and a Cast is how that knowledge enters the graph.
(defn cast-compute [(n i64)] (-> i64)
  (let [t (n-in-ty n 1)
        target (n-cast-target-type n)
        j (ty-join t target)]
    ; A high join from a low input means the two disagree and no value satisfies the cast.
    ; Reporting that would read as dead code and delete a live branch, so hold the prior
    ; answer instead. This is Simple's "freeze" rule.
    (if (and (ty-high? j) (not (ty-high? t)))
        (if (= (n-ty n) (t-top)) target (n-ty n))
        j)))

;; Representation changes do not change the runtime value observed by the interpreter. `Box`
;; deliberately forgets the unboxed refinement and publishes `dyn`: downstream generic code may
;; inspect the tag but may not use the source representation as proof. `Unbox` reintroduces its
;; declared target; a failing runtime check is a compiler error unless a TypeTest arm proved it.
;; A BOX KEEPS ITS INPUT'S TYPE. Representation and type are different questions here, and
;; `v-rep-of` already answers the first one: a `Box` is TAGGED whatever it holds. Throwing the type
;; away as well left `dyn`, which decides nothing -- `ty-isa dyn int` is false, `join dyn int` is
;; not high -- so every DSL guard on a boxed operand (`IsNumber`, `%IsString`) stayed unknown with
;; a proven int one edge away, and none of them could ever fold.
;;
;; THE ALTERNATIVE WAS TRIED AND IS WRONG. Having `typetest-compute` read THROUGH the Box folds the
;; same guards and breaks propagation: a compute may only depend on its immediate inputs' types,
;; and a Box's type never changed, so when the boxed value's type fell the TypeTest was never
;; re-queued and `g-verify` reported VERR-STALE-TYPE. Carrying the type makes the dependency honest,
;; which is what makes the fold sound rather than merely convenient.
;;
;; See docs/DSL-OWNERSHIP.md: this is what makes moving an operator into `lib/` affordable.
(defn box-compute [(n i64)] (-> i64)
  (let [t (n-in-ty n 1)]
    (if (ty-high? t)
        (t-top)
        ;; THE KIND, NOT THE VALUE. Carrying the input's type verbatim makes a `Box` of a constant
        ;; report a CONSTANT type, and `g-fold-proven!` then replaces the Box with a `Const` --
        ;; deleting the boxing it existed to perform. `box_then_unbox_cancels_only_with_a_proven_
        ;; target` catches exactly that.
        ;;
        ;; AND INT AND FLOAT ARE ONE KIND HERE, WHICH IS THE WHOLE SUBTLETY. `%IsInt` and `%IsFlt`
        ;; ask about the RUNTIME TAG, and the static type does not determine it: a field declared
        ;; `flt` holds an int-tagged 0 after `{a: 0}`, so folding `%IsInt` to false from the type
        ;; is a claim the runtime contradicts. It did, in exactly that shape -- a do/while writing
        ;; `o.a`, where the evaluator walked into a branch the analysis had typed `~ctrl`.
        ;;
        ;; Widening to the numeric union keeps every tag test the type CAN decide -- string against
        ;; number, object against number -- and refuses the one it cannot. That is the line between
        ;; a type and a representation, and it is the same line `v-rep-of` draws.
        (let [k (ty-kinds t)]
          ;; Boxing changes representation, not callable identity. Retaining a closure's finite
          ;; target set lets a callee parameter infer the one function its callers pass and turns
          ;; `assert.throws(..., function () {...})` back into one exact native call instead of a
          ;; per-site all-functions dispatch ladder. Function ids outside the compact summary
          ;; already arrive as generic `t-fun` and remain generic here.
          (if (= k VK-FUN)
              (t-fun-set (ty-fun-targets t))
              (t-kinds (if (!= (& k (| VK-INT VK-FLT)) 0)
                           (| k (| VK-INT VK-FLT))
                           k)))))))

(defn unbox-compute [(n i64)] (-> i64)
  (if (ty-high? (n-in-ty n 1)) (t-top) (n-unbox-target-type n)))

;; A PLAIN `Box` AND ONLY A PLAIN ONE. `BOX-AUX-ARRAY` preserves an Array tag across a
;; representation boundary, so it CHANGES the kind its input reports; reading through it is a
;; different value.
(defn n-plain-box? [(n i64)] (-> bool)
  (if (or (= n NO-NODE) (n-dead? n))
      false
      (match (n-op n) (Box [mode] (= mode 0)) (_ false))))

;; THE VALUE-REPRESENTATION CLASSIFIER, one definition. Every value edge carries one machine
;; representation -- a TAGGED NaN-boxed word, a RAW managed pointer, or a RAW machine number --
;; and the classification is STRUCTURAL (which op produced the value), never a read of the node's
;; type seed: seeds lag construction, and lying seeds were themselves one of the NavierStokes bug
;; classes. UNKNOWN is deliberately quiet.
;;
;; It lives here rather than in the verifier because the verifier is not its only reader:
;; `box-idealize` and `unbox-idealize` below must answer "is this value certainly tagged" before
;; deleting a representation conversion, and two copies of the table would disagree eventually.
;; The verifier's REP pass reads this same function.
;;
;; A Phi with an ABSENT arm is UNKNOWN, not the join of what is present. The verifier never sees
;; one (it refuses in-progress graphs), but the idealizations run DURING construction, where an
;; open loop Phi's backedge may later deliver either representation -- deciding from the entry
;; arm alone would let a peephole delete a deferred `Box(Phi)` placeholder that
;; `g-distribute-deferred-phi-boxes!` still needs to distribute.
(defn n-rep-of [(n i64) (fuel i64)] (-> i64)
  (if (or (< n 0) (or (<= fuel 0) (n-dead? n)))
      REP-UNKNOWN
      (match (n-op n)
        ;; A declared ABI is the physical contract for a parameter.  Its logical lattice type can
        ;; later widen to `dyn` (and backend liveness can classify it by a tagged use), but neither
        ;; changes the word delivered by the caller.  Publishing that contract here prevents a
        ;; Box around an `int` Parm from being deleted as though the incoming integer already
        ;; carried a JavaScript tag.  Leave types without one proven raw form UNKNOWN: callers may
        ;; still retain conversions, but no representation optimization may guess.
        (Parm [index]
          (let [fun (n-in n 0)]
            (if (and (op-is? fun Fun [_])
                     (and (n-fun-abi-declared? fun)
                          (and (>= index 0) (< index (n-fun-abi-param-count fun)))))
                (let [declared (n-fun-abi-param-type fun index)
                      kinds (ty-kinds declared)]
                  (cond (or (= kinds VK-OBJ) (= kinds VK-STR)) REP-RAW-PTR
                        (or (= kinds VK-INT)
                            (or (= kinds VK-FLT) (= kinds VK-BOOL))) REP-RAW-NUM
                        :else REP-UNKNOWN))
                REP-UNKNOWN)))
        (Box [mode] REP-TAGGED)
        (ToNumber [] REP-TAGGED)
        (PropLoad [name] REP-TAGGED)
        (PropLoadKey [operation]
          (if (or (= operation 26) (or (= operation 29)
                  (or (= operation 30) (= operation 32)))) REP-RAW-NUM
            (if (or (= operation 14) (= operation 21)) REP-RAW-NUM REP-TAGGED)))
        (ArrayLoad [alias] REP-TAGGED)
        (JsBuiltin [descriptor] REP-TAGGED)
        (JsThrow [] REP-TAGGED)
        (ArrayUnbox [] REP-RAW-PTR)
        (ArrayMark [] REP-RAW-PTR)
        ;; Every string operation produces the runtime's raw managed string pointer. A Box at a
        ;; JavaScript-value boundary must therefore survive and attach JSV-STRING.
        (StringConst [_] REP-RAW-PTR)
        (StringConcat [] REP-RAW-PTR)
        (StringSubstring [_] REP-RAW-PTR)
        (ToString [] REP-RAW-PTR)
        (StringFromCodeUnit [] REP-RAW-PTR)
        (NumberToString [] REP-RAW-PTR)
        (ToFixed [] REP-RAW-PTR)
        (StringAlloc [] REP-RAW-PTR)
        (StringSetUnit [] REP-RAW-PTR)
        (StringNormalize [] REP-RAW-PTR)
        (Unbox [target]
                (let [t target]
                  (cond (or (= (ty-kinds t) VK-OBJ) (= (ty-kinds t) VK-STR)) REP-RAW-PTR
                        (or (= (ty-kinds t) VK-INT) (= (ty-kinds t) VK-FLT)) REP-RAW-NUM
                        :else REP-UNKNOWN)))
        (Proj [slot]
          (let [parent (n-proj-source n)]
            (if (and (!= parent NO-NODE)
                     (match (n-op parent) (New [shape] true) (_ false)))
                REP-RAW-PTR REP-UNKNOWN)))
        (Cast [target] (n-rep-of (n-in n 1) (- fuel 1)))
        (Load [alias] (shape-alias-rep alias))
        (Phi [declared]
                (let [(mut i) 1 (mut joined) REP-UNKNOWN (mut mixed) false]
                  (loop (if (or (>= (load i) (n-nins n)) (load mixed))
                            (break)
                            (do
                              (let [input (n-in n (load i))]
                                (if (= input NO-NODE)
                                    (set! mixed true)
                                (if (= input n)
                                    0
                                    (let [rep (n-rep-of input (- fuel 1))]
                                      (cond (= rep REP-UNKNOWN) (store! mixed true)
                                            (= (load joined) REP-UNKNOWN) (store! joined rep)
                                            (!= (load joined) rep) (store! mixed true)
                                            :else 0)))))
                              (set! i (+ (load i) 1))
                              0)))
                  (if (load mixed) REP-UNKNOWN (load joined))))
        (Add [] REP-RAW-NUM)
        (Sub [] REP-RAW-NUM)
        (Mul [] REP-RAW-NUM)
        (Div [] REP-RAW-NUM)
        (Mod [] REP-RAW-NUM)
        (Minus [] REP-RAW-NUM)
        (BitAnd [] REP-RAW-NUM)
        (BitOr [] REP-RAW-NUM)
        (BitXor [] REP-RAW-NUM)
        (Shl [] REP-RAW-NUM)
        (Shr [] REP-RAW-NUM)
        (UShr [] REP-RAW-NUM)
        (BitNot [] REP-RAW-NUM)
        (Eq [] REP-RAW-NUM)
        (Lt [] REP-RAW-NUM)
        (Le [] REP-RAW-NUM)
        (Not [] REP-RAW-NUM)
        (TypeTest [target] REP-RAW-NUM)
        (ArrayTest [] REP-RAW-NUM)
        (IsNaN [] REP-RAW-NUM)
              ;; ToInteger is a RUNTIME call (JSSOP-TO-INTEGER) and returns a tagged value --
              ;; its result can be +/-Infinity, which has no raw integer form.
        (ToInteger [] REP-TAGGED)
        (ArrayLen [] REP-RAW-NUM)
        (StringLen [] REP-RAW-NUM)
        (StringCharCode [] REP-RAW-NUM)
        (StringIndexOf [] REP-RAW-NUM)
        (StringCompare [] REP-RAW-NUM)
        (OwnKeyCount [] REP-RAW-NUM)
        (StringEq [] REP-RAW-NUM)
        (PropHas [name] REP-RAW-NUM)
        (PropHasKey [] REP-RAW-NUM)
        (ProtoHas [] REP-RAW-NUM)
        (_ REP-UNKNOWN))))

;; Public representation query for backend conversion boundaries. Consumers must not duplicate
;; the private representation tags: the point of this predicate is to distinguish a physically raw
;; numeric word from a merely numeric logical type.
(defn n-raw-number-representation? [(n i64)] (-> bool)
  (= (n-rep-of n 32) REP-RAW-NUM))

;; `%IsArray`, and it folds in exactly ONE direction. A value whose kinds do not include VK-OBJ
;; cannot be an array, so the test is a constant false -- which is what lets `ToStringValue`'s array
;; dispatch cost nothing at the overwhelming majority of its call sites, where the operand is a
;; proven number or string. The other direction is NOT available here: the lattice has no bit that
;; separates an array from a plain object (both are VK-OBJ with a shape), so "is an array" is a
;; structural question and `arraytest-idealize` is where it is asked.
;;
;; `ty-high?` FIRST, for the reason every compute has it: an unanalysed input has NO kinds, and
;; answering false for it would make the type RISE to `bool` the moment the input fell to `dyn`.
;; `g-analyze!` aborts on a rising type, so this guard is what makes the fold monotone.
(defn arraytest-compute [(n i64)] (-> i64)
  (let [t (n-in-ty n 1)]
    (if (ty-high? t)
        (t-top)
        (if (= (& (ty-kinds t) VK-OBJ) 0) (t-bool-con false) (t-bool)))))

(defn typetest-compute [(n i64)] (-> i64)
  (let [t (n-in-ty n 1)
        target (n-typetest-target-type n)]
    (if (ty-high? t)
        (t-top)
        (if (ty-isa t target)
            (t-bool-con true)
            (if (ty-high? (ty-join t target)) (t-bool-con false) (t-bool))))))

; ============================================================================
; Memory compute
; ============================================================================
;; WHAT A MEMORY STATE'S CONTENTS MEANS, decided here once because every one of the four computes
;; below is an application of it: `TMem(aliases, contents)` says that every value held in any of
;; those alias classes, at this point in the program, is described by `contents`. It is a claim
;; about the WHOLE alias class and not about one object, because an alias class is exactly the
;; granularity this IR resolves memory to.
;;
;; THAT IS WHY A STORE MEETS RATHER THAN REPLACES. `o.x = 5` leaves every OTHER object in alias
;; x holding whatever it held, so the new state's contents is `meet(old, 5)` and not `5`. Taking
;; `5` would be the precise answer for `o` and a lie about the class, and a `Load` reading it
;; would fold a different object's field to a constant it never held. The cost is real and it is
;; the reason 4c's forwarding is STRUCTURAL: `Load(p, Store(p, v))` is `v` because the pointers
;; are the same NODE, which is a fact about the graph rather than about the lattice, and no
;; alias-level type could ever have recovered it. So a load in 4b reports the union of everything
;; its class holds, `tests/mem-test.coil` asserts that union exactly, and 4c is measured against
;; it rather than against a claim this milestone could not make.
;;
;; The declared field type is deliberately NOT joined in. `shape-alias-ty` records what the front
;; end SAID; the contents is what the analysis PROVED. In a dynamic language the two disagree
;; routinely (a field declared `int` can be assigned a string), and joining a proof to a claim
;; would either mint a high type for the disagreement, which reads as dead code (see
;; `cast-compute`'s freeze rule for what that costs), or quietly make the front end's annotation
;; load-bearing for correctness. D4 says a narrowing needs a guard, and a declared type is not one.

;; ---------------------------------------------------------------------------
;; The two questions every memory compute has to ask before it reads a contents
;; ---------------------------------------------------------------------------
;; DOES THIS STATE DESCRIBE THE CLASS I AM TOUCHING. `ty-mem-contents` is a projection: it hands
;; back the contents field whatever the alias bitset says, so reading it for a class the bitset
;; does not carry reports ANOTHER CLASS'S value. That is not imprecision, it is an
;; UNDER-approximation: a type no proof supports, in the direction that miscompiles.
;;
;; It matters because of which consumer sees it first. `load-idealize` refuses this graph shape by
;; comparing alias numbers, but `n-peephole` runs the constant fold BEFORE it ever calls
;; `n-idealize`, so when the other class's contents happens to be a constant -- and `undefined`,
;; the contents of every freshly allocated field, is one -- the Load is replaced by a Const and
;; deleted, and the EV-MEM the interpreter owed that graph is gone with it. One verifier-clean
;; graph then has two observable answers, which is LAW 10's differential oracle failing across a
;; pass, and it is exactly the laundering the alias comparison was written to refuse.
;;
;; ANY, NOT ALL. An alias bitset only GROWS as a memory type falls (meet is OR), so "the class is
;; absent" can only turn into "the class is present". A low answer here would have to RISE to the
;; contents at that moment; ANY falls to it. The project's own `every_memory_compute_is_monotone_in_every_slot`
;; catches the ALL version by name.
(defn mem-in-misses-alias? [(t i64) (alias i64)] (-> bool)
  (and (ty-mem? t) (= (& (ty-mem-aliases t) (<< 1 alias)) 0)))

(defn mem-in-contents-for [(t i64) (alias i64)] (-> i64)
  (if (mem-in-misses-alias? t alias) (t-top) (ty-mem-contents t)))

;; DOES EVERY OBJECT THIS POINTER CAN BE CARRY THIS WORD. The other half of `ev-check-access`, and
;; the reason `shape-field-by-alias` answers SHAPE-NO-FIELD rather than aborting.
;;
;; A fixed-offset access to a word the object does not have is a front end that emitted `o.y`
;; without a shape guard, which D4 says is the bug rather than something the compiler should
;; paper over. `load-compute` answering the class's contents anyway is what lets the fold delete
;; the load and report `undefined`, which hides precisely the guard D4 requires. So the answer for
;; a pointer that MISSES the word is ALL: no proof, nothing to fold, and the Load survives for the
;; interpreter to refuse with EV-SHAPE.
;;
;; "SOME shape misses it" and not "no shape has it", and that is the monotone form. The shape
;; bitset only grows as a pointer type falls, so a set that already contains a missing shape
;; contains it for ever, and the answer can only stay at ALL. Requiring merely that SOME shape
;; carries the word would flip back the other way the moment a second shape arrived.
;;
;; Only DEFINED shape ids are consulted. `t-kinds` mints its shape bitset as -1 (every shape:
;; the bottom of that axis), so most low types name shapes that no transition ever allocated, and
;; `shape-field-by-alias` has nothing to say about those. Newly defined shapes can only ADD a
;; missing one, so the walk stays monotone as the table grows.
(defn ptr-misses-alias? [(t i64) (alias i64)] (-> bool)
  (let [bits (ty-shapes t)
        k (shape-count)
        (mut i) 0
        (mut missing) false]
    (loop (if (or (>= (load i) k) (load missing))
              (break)
              (do
                (if (and (!= (& bits (<< 1 (load i))) 0)
                         (= (shape-field-by-alias (load i) alias) SHAPE-NO-FIELD))
                    (set! missing true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load missing)))

;; WILL THE PROGRAM REFUSE THIS ACCESS. The static twin of `ev-check-access`, asked of a Load's or
;; a Store's own types: slots 1 and 2 are the memory state and the pointer for both ops, so one
;; predicate covers both. `false` is not a promise that the access succeeds -- an alias bitset and
;; a shape set are both unions over paths, so a state that carries the class statically may not
;; carry it on the path taken -- but `true` means every path refuses it.
;;
;; IT EXISTS SO A REWRITE CANNOT CONSUME AN ACCESS THE PROGRAM WOULD REFUSE. Forwarding a load out
;; of a store drops the store's last reader, the kill cascade collects the store, and the
;; EV-SHAPE or EV-MEM that store owed the program disappears; the same program then answers 5
;; before the pass and traps after it, or the other way round. Reading a type to DECLINE a rewrite
;; is always sound, which is why this may look at a provisional answer where an irreversible
;; rewrite may not (LAW 3).
(defn access-refused? [(n i64)] (-> bool)
  (let [alias (match (n-op n)
                (Load [a] a)
                (Store [a] a)
                (_ (do (panic-corrupt "access-refused?: expected Load or Store") 0)))]
    (or (mem-in-misses-alias? (n-in-ty n 1) alias)
        (ptr-misses-alias? (n-in-ty n 2) alias))))

;; A New's tuple is one slot per field plus the object, and the object's shape bitset bounds the
;; field count, so this buffer cannot be overrun by a legal shape. The check below says so anyway,
;; because "cannot" is a property of another file.
(const NEW-TUPLE-MAX i64 65)

;; Slot 0 is the object; slot 1+i is field i's memory AFTER the allocation. Every field of a fresh
;; object holds `undefined`, which is what JavaScript says and what makes an allocation a link in
;; each of its fields' memory chains: the incoming state for that alias is met with `undefined`
;; rather than replaced, for the reason in the header above.
(defn new-compute [(n i64)] (-> i64)
  (let [s (n-new-shape n)]
    (if (shape-defined? s)
        0
        (do (panic-corrupt "new-compute: a New whose aux is not a defined shape id") 0))
    (let [k (shape-field-count s)
          buf (primitive/alloc-stack (array i64 65))
          p (cast (ptr i64) buf)
          (mut i) 0]
      (if (< (+ k 1) NEW-TUPLE-MAX)
          0
          (do (panic-corrupt "new-compute: a shape with more fields than the tuple buffer holds") 0))
      (set! (index p 0) (t-obj-shape s))
      (loop (if (>= (load i) k)
                (break)
                (do
                  (set! (index p (+ (load i) 1))
                        (t-mem-alias (shape-field-alias s (load i))
                                     ; the incoming state has to be one that DESCRIBES this field's
                                     ; class, or the meet would carry a sibling class's contents
                                     ; into it; see `mem-in-contents-for`
                                     (ty-meet (mem-in-contents-for (n-in-ty n (+ (load i) 1))
                                                                   (shape-field-alias s (load i)))
                                              (t-undef))))
                  (set! i (+ (load i) 1))
                  0)))
      (t-tuple-list (slice-new [i64] p (+ k 1))))))

;; A Load's value is what its memory input says the class holds. `ty-mem-contents` maps ANY to
;; ANY, so an unanalysed memory edge leaves the load unanalysed rather than concluding anything,
;; and a memory state at the top of its own sublattice (`t-mem-none`: the empty alias set) leaves
;; it there too.
;;
;; A HIGH POINTER MEANS NO OBJECT REACHES THIS LOAD, so no value comes out of it. That is the
;; ordinary optimistic answer and it falls to the contents as soon as the pointer does; it is what
;; lets a load on a dead arm stay out of the meet at a Phi below it.
;; A POINTER THAT MISSES THE WORD ANSWERS ALL, for the reason `ptr-misses-alias?` gives: the
;; access is a front-end bug rather than a value, and reporting the class's contents would let the
;; fold turn it into `undefined` and delete the node the oracle had to complain about.
(defn load-compute [(n i64)] (-> i64)
  (if (ty-high? (n-in-ty n 2))
      (t-top)
      (if (ptr-misses-alias? (n-in-ty n 2) (n-load-alias n))
          (t-bot)
          (mem-in-contents-for (n-in-ty n 1) (n-load-alias n)))))

;; The pointer is deliberately NOT consulted here. A Store's result is a memory STATE, never a
;; constant, so nothing can fold it away and there is no laundering to prevent; meeting the value
;; into its own class is an over-approximation, which is the safe direction. What it does have to
;; ask is the memory question: an incoming state that describes some other class says nothing
;; about this one, and inheriting its contents would mint a state more specific than the truth.
(defn store-compute [(n i64)] (-> i64)
  (t-mem-alias (n-store-alias n)
               (ty-meet (mem-in-contents-for (n-in-ty n 1) (n-store-alias n))
                        ; a memory state is not a value, so it cannot BE a contents; `t-mem`
                        ; panics on one and this compute has to stay total
                        (ty-as-mem-value (n-in-ty n 3)))))

;; The union of its inputs' alias classes, which is exactly `ty-meet` on the memory production:
;; OR on the alias bitset, meet on the contents. Seeding at `t-mem-none` is seeding at the top of
;; that sublattice, so it is the identity for the fold and a MemMerge with no memory inputs
;; describes nothing rather than describing everything.
;;
;; This is the node that makes the bitset alias axis load-bearing rather than decorative: merging
;; alias {0} with alias {1} has to yield {0,1}, and Simple's collapse rule would answer "all of
;; memory" here (DESIGN.md section 4 has the arithmetic).
(defn memmerge-compute [(n i64)] (-> i64)
  (let [len (n-nins n)
        (mut t) (t-mem-none)
        (mut i) 1]
    (loop (if (>= (load i) len)
              (break)
              (do
                (set! t (ty-meet (load t) (n-in-ty n (load i))))
                (set! i (+ (load i) 1))
                0)))
    (load t)))

;; A Return carries the program's final memory when it has one. It is optional because M0 to M3
;; built Returns with two inputs and those graphs are still the corpus, and it exists at all
;; because memory has to be ROOTED at the exit: with nothing reading the last store, the kill
;; cascade collects the whole heap as unused and 4c's store elimination would be gated on a
;; program whose stores were already gone. It is also the slot M6's calls need, one milestone
;; early rather than retrofitted through every Return in the corpus.
(defn return-compute [(n i64)] (-> i64)
  (if (>= (n-nins n) 3)
      (t-tuple3 (n-in-ty n 0) (n-in-ty n 1) (n-in-ty n 2))
      (t-tuple2 (n-in-ty n 0) (n-in-ty n 1))))

; ============================================================================
; Control-flow idealize
; ============================================================================
(defn region-has-phi? [(n i64)] (-> bool)
  (let [len (n-nouts n)
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) len) (load found))
              (break)
              (do
                (if (op-phi? (n-op (n-out n (load i)))) (set! found true) 0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

;; Reduce every Phi on a merge that is about to be replaced by its ENTRY control to that phi's
;; entry arm. `region-idealize` collapses a two-input Loop whose back edge died by returning
;; `(n-in n 1)`, and its comment says the attached phis then "reduce to their initial value" -- but
;; nothing made them. `n-subsume!` simply retargets each phi's input 0 to the replacement, and
;; `phi-idealize` only rescues the case where that replacement is NOT a merge. When the entry is
;; itself a Region -- an `if` before the loop is enough -- the phi kept its two inputs on a
;; three-input Region and `verify` reported VERR-PHI-ARITY.
;;
;; Subsuming a phi removes it from this node's out list, so the index only advances when nothing
;; was removed.
(defn region-reduce-phis! [(n i64)] (-> i64)
  ;; RESCAN FROM THE START, for the reason `region-remove-path!` states: a subsume can cascade and
  ;; vacate an out slot this scan has already passed, and `n-del-use!` fills that slot from the
  ;; END of the list. Holding the index still when the CURRENT entry disappears is not enough --
  ;; the entry that moves is not always the one being replaced.
  (loop
    (let [(mut found) NO-NODE
          (mut i) 0]
      (loop (if (or (>= (load i) (n-nouts n)) (!= (load found) NO-NODE))
                (break)
                (do
                  (let [u (n-out n (load i))]
                    (if (and (not (n-dead? u)) (op-phi? (n-op u))) (set! found u) 0))
                  (set! i (+ (load i) 1))
                  0)))
      (if (= (load found) NO-NODE)
          (break)
          (do (n-subsume! (load found) (n-in (load found) 1)) 0))))
  0)

;; The index of a path that cannot be reached, or 0 for none. A Loop never gives up its entry:
;; a loop whose entry died is handled by the loop dying, not by rewriting it into a region.
(defn region-dead-path [(n i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) 1
        (mut found) 0]
    (loop (if (or (>= (load i) len) (!= (load found) 0))
              (break)
              ; PROVEN unreachable. Dropping a path is irreversible and it drops an arm from every Phi
              ; on this region with it, so a provisional `~ctrl` here is a miscompile: the arm that
              ; should have run vanishes and the graph left behind is internally consistent, so
              ; `g-verify` sees nothing wrong with it.
              (do
                (if (and (n-in-proven-xctrl? n (load i))
                         (not (and (op-is? n Loop []) (= (load i) 1))))
                    (set! found (load i))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

;; Region and Phi arity is ONE invariant, not two. Dropping a region path without dropping the
;; matching value from every Phi on that region leaves each Phi reading the wrong path, which
;; is a miscompile that typechecks. They are removed together, here, or not at all.
(defn region-remove-path! [(n i64) (path i64)] (-> i64)
  ;; RESCAN FROM THE START AFTER EVERY REMOVAL, because a removal can move an unvisited phi into
  ;; an index this scan has already passed. `n-del-use!` is a SWAP-remove, and dropping a phi's
  ;; backedge arm routinely kills a whole cycle: a memory phi's backedge is a store chain whose
  ;; own memory input is that phi, so releasing the arm kills the chain, the chain releases the
  ;; phi, and the phi -- now unused -- releases this region and vacates its slot in the out list.
  ;; The last entry lands there, and a single forward pass never looks at it again.
  ;;
  ;; That left a THREE-input Phi on a TWO-input Region, which is the exact malformation this
  ;; function exists to prevent, and it surfaced as `phi-compute` reading the region past its
  ;; end. Unreachable until a loop back edge could be proven dead; see `fng-loop`.
  ;;
  ;; The scan is quadratic in the out list, which is a handful of nodes.
  (loop
    (let [(mut found) NO-NODE
          (mut i) 0]
      (loop (if (or (>= (load i) (n-nouts n)) (!= (load found) NO-NODE))
                (break)
                (do
                  (let [u (n-out n (load i))]
                    (if (and (and (not (n-dead? u)) (op-phi? (n-op u)))
                             (= (n-nins u) (n-nins n)))
                        (set! found u)
                        0))
                  (set! i (+ (load i) 1))
                  0)))
      (if (= (load found) NO-NODE)
          (break)
          (do (n-del-def! (load found) path) 0))))
  (n-del-def! n path)
  n)

;; `if(p) {} else {}` with nothing merged is not a branch at all: both paths come straight off
;; the same If, so the merge is just that If's own control input.
(defn region-collapse-diamond [(n i64)] (-> i64)
  ; a Loop's two inputs are entry and back edge, never two arms of one branch
  (if (or (op-is? n Loop []) (or (!= (n-nins n) 3) (region-has-phi? n)))
      NO-NODE
      (let [a (n-in n 1)
            b (n-in n 2)]
        (if (or (= a NO-NODE) (= b NO-NODE))
            NO-NODE
            (if (and (and (op-is? a CProj [_]) (op-is? b CProj [_]))
                     (and (= (n-in a 0) (n-in b 0)) (op-is? (n-in a 0) If [])))
                (n-in (n-in a 0) 0)
                NO-NODE)))))

(defn region-idealize [(n i64)] (-> i64)
  (if (n-in-progress? n)
      NO-NODE
      (if (<= (n-nins n) 1)
          (n-xctrl)  ; no paths left: unreachable
          (let [dead (region-dead-path n)]
            (if (!= dead 0)
                ;; REMOVING THE LAST PATH WOULD STRIP A PHI OF ITS LAST VALUE. Each removal drops
                ;; the matching arm from every attached Phi, so taking a two-input Region down to
                ;; one leaves its phis holding nothing but their control -- and the next visit
                ;; turns the Region into XCtrl and retargets those phis onto it. What is left is a
                ;; one-input Phi on XCtrl: unreachable, never analysed (so still ANY), and rejected
                ;; by the Phi arity rule, which is right to reject it.
                ;;
                ;; So collapse HERE instead, while each phi still has exactly one value to reduce
                ;; to. The value is the one on the dead path, which is sound precisely because
                ;; nothing on this control can execute. repros/dead-branch-after-builtin.js.
                (if (<= (n-nins n) 2)
                    (do (region-reduce-phis! n) (n-xctrl))
                    (region-remove-path! n dead))
                ; A Region with one path and no Phi is not a merge. A Loop whose proven-dead back
                ; edge was removed is not a loop either: replace its control with the entry and let
                ; each attached Phi reduce to its initial value. Keeping a two-input Loop violates
                ; the Loop arity and is the construction-time-folding failure hit by `repeat(0)`.
                (if (and (= (n-nins n) 2)
                         (or (op-is? n Loop []) (not (region-has-phi? n))))
                    (do (region-reduce-phis! n) (n-in n 1))
                    (region-collapse-diamond n)))))))

(defn cproj-idealize [(n i64)] (-> i64)
  (let [m (n-in n 0)
        idx (n-cproj-label n)]
    (if (= m NO-NODE)
        NO-NODE
        ; A LIVE projection whose multi node has been KILLED is graph corruption, and it is
        ; reachable by building a multi's projections one at a time: peepholing the first one to
        ; XCtrl drops the multi's last use, so the kill cascade takes the multi with it, and the
        ; sibling is then peepholed against a corpse. `n-kill!` clears `ins` but leaves `ty`, so
        ; the stale tuple below still matches and the read of input 0 returns a buffer word. Named
        ; abort, not NO-NODE: NO-NODE would leave a live Return whose control is a dead node, which
        ; is the miscompile (a whole arm of the program silently vanishes) rather than a warning.
        ; The window that prevents it is `n-multi-open!`/`n-multi-close!`.
        (if (n-dead? m)
            (do
              (panic-corrupt "cproj-idealize: the multi node was killed before all of its projections existed; build them inside n-multi-open!/n-multi-close!")
              NO-NODE)
            (match (ty-get (n-ty m))
              (TTuple [off len]
                      ; every read of the tuple is bounds-checked against the arity the TYPE declares: aux
                      ; is a slot index and a slot index past the end is a malformed node, not a rewrite
                      (if (or (< idx 0) (>= idx len))
                          NO-NODE
                          ; XCtrl AND PROVEN: see the notes on n-ty-proven? and phi-single-input. `if-compute`
                          ; used to report [~ctrl ~ctrl] for an If whose own control was merely unanalysed,
                          ; and this rewrite then replaced BOTH live projections with XCtrl, deleting the arms.
                          (let [this-control (ty-kid off idx)
                                sibling-dead (and (and (op-is? m If []) (= len 2))
                                                  (= (ty-kid off (- 1 idx)) (t-xctrl)))]
                            ;; Most projections are the two live arms of an unresolved branch.
                            ;; A proof can only enable either rewrite when this arm or its sibling
                            ;; is already XCtrl, so do not repeat a snapshot lookup for every live
                            ;; CProj on every fold round.
                            (if (and (!= this-control (t-xctrl)) (not sibling-dead))
                                NO-NODE
                                (if (not (n-ty-proven? m))
                                    NO-NODE
                                    (if (= this-control (t-xctrl))
                                        (n-xctrl)
                                        ; the sibling is dead, so this projection IS the If's control
                                        (n-in m 0)))))))
              (TBot [] NO-NODE)
              (TTop [] NO-NODE)
              (TCtrl [] NO-NODE)
              (TXCtrl [] NO-NODE)
              (TVal [v] NO-NODE)
              (TMem [a c] NO-NODE))))))

;; Whether a settled CProj has the one state that its idealizer can rewrite. The fold seed runs
;; after analysis reached a type fixpoint; seeding every ordinary two-live-arm projection only to
;; rediscover that neither arm is XCtrl accounted for tens of thousands of repeated visits in a
;; medium Test262 graph. Worklist-driven visits after a rewrite still run unconditionally.
(defn cproj-seed-may-idealize? [(n i64)] (-> bool)
  (let [m (n-in n 0)]
    (if (or (= m NO-NODE) (n-dead? m))
        true
        (match (ty-get (n-ty m))
          (TTuple [off len]
            (let [idx (n-cproj-label n)]
              (if (or (< idx 0) (>= idx len))
                  true
                  (or (= (ty-kid off idx) (t-xctrl))
                      (and (and (op-is? m If []) (= len 2))
                           (= (ty-kid off (- 1 idx)) (t-xctrl)))))))
          (_ false)))))

;; The one value every STRUCTURAL path contributes, ignoring self-references (a loop phi fed by its
;; own back edge), or NO-NODE when the paths disagree. Dead paths are removed atomically by
;; `region-remove-path!`, together with this Phi's matching arm. Skipping a merely dead-TYPED arm
;; here duplicated that ownership and made collapse depend on sweep order: another rewrite in the
;; same proof snapshot could rewire the path live after its value was already gone.
(defn phi-single-input [(n i64) (r i64)] (-> i64)
  (let [len (n-nins n)
        (mut live) NO-NODE
        (mut ok) true
        (mut i) 1]
    (loop (if (or (>= (load i) len) (not (load ok)))
              (break)
              (do
                (let [v (n-in n (load i))]
                  (if (= v n)
                      0
                      (if (= (load live) NO-NODE)
                          (set! live v)
                          (if (!= (load live) v) (set! ok false) 0))))
                (set! i (+ (load i) 1))
                0)))
    (if (load ok) (load live) NO-NODE)))

(defn phi-idealize [(n i64)] (-> i64)
  ;; A PHI CAN BE SHORTER THAN THE RULE BELOW ASSUMES, and then it has nothing to reduce TO.
  ;; When a branch is proven dead the phi's region collapses to XCtrl, and a phi left on XCtrl
  ;; carrying no value input at all is an ordinary unreachable node -- not a malformed one, and
  ;; dead-code elimination is what removes it. The rule underneath reads input 1 to say "a phi
  ;; that is not on a merge is simply its one value", which asks for a value this phi does not
  ;; have: `n-in` aborted the whole compilation with `input index out of range`.
  ;;
  ;; `region-idealize` no longer produces that phi -- it collapses a step earlier, while the phi
  ;; still has a value to reduce to -- so this guard is not what repairs
  ;; repros/dead-branch-after-builtin.js. It is here because reading an input without checking it
  ;; exists is a defect in THIS function regardless of who else stops supplying the shape: a short
  ;; phi should get a verdict from the verifier, which has a rule for it, rather than abort the
  ;; process inside the analysis pass.
  ;;
  ;; Note this is NOT the same as a phi LONGER than its region. That is a real malformation and
  ;; `phi-single-input` still aborts on it, which is the behaviour that case wants.
  (if (< (n-nins n) 2)
      NO-NODE
  (let [r (n-in n 0)]
    (if (or (= r NO-NODE) (not (op-merge? (n-op r))))
        (n-in n 1)
        (if (or (n-in-progress? r) (<= (n-nins r) 1))
            NO-NODE
            (let [u (phi-single-input n r)]
              ; Only collapse when the survivor is at least as specific as the phi. Otherwise the
              ; replacement would WIDEN the type at every use, losing what the join with the
              ; declared type had established.
              (if (and (!= u NO-NODE) (ty-isa (n-ty u) (n-ty n))) u NO-NODE)))))))

;; Stop drops a Return that cannot be reached. Without this, unreachable code is merely TYPED
;; as unreachable and still prints, so "the dead branch is gone" would be a claim about the
;; types rather than something visible in the program.
(defn stop-idealize [(n i64)] (-> i64)
  (let [len (n-nins n)
        (mut i) 0
        (mut found) NO-NODE]
    (loop (if (or (>= (load i) len) (!= (load found) NO-NODE))
              (break)
              (do
                (let [r (n-in n (load i))]
                  ; XCtrl AND PROVEN. Dropping the last Return runs the kill cascade over the whole
                  ; program, so a provisional answer here compiles a valid program to nothing at all:
                  ; Stop with no inputs, which `g-verify` accepts because an empty graph is
                  ; structurally valid and the printer omits dead nodes, so the diagram shows Start
                  ; and Stop and nothing says a word. Simple does not delete a Return at all; this
                  ; rewrite is this project's own addition and carries its own obligation.
                  (if (and (!= r NO-NODE) (n-in-proven-xctrl? r 0))
                      (set! found (load i))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (= (load found) NO-NODE)
        NO-NODE
        (do (n-del-def! n (load found)) n))))

(defn cast-idealize [(n i64)] (-> i64)
  ; The cast is discharged: the input already satisfies it, so the check costs nothing. This is
  ; how a proven type annotation disappears from the graph entirely.
  ;
  ; ANALYSIS versus TRANSFORMATION, for the fifth time in this file, and the most expensive one:
  ; what this deletes is a TYPE CHECK, the only mechanism D4 gives for a guard. So it needs the
  ; PROVEN answer, not a provisional one.
  ;
  ; `ty-isa` reads backwards from subtyping intuition: `isa a b` is `meet(a,b) == b`, and
  ; `meet(ANY, x) == x`, so `ty-isa ANY t` is TRUE FOR EVERY TARGET t. An unanalysed input still
  ; sits at ANY (that is what `n-new` seeds a type to, and what `n-in-ty` reports for a missing
  ; input), so without a guard every Cast on a raw graph discharges itself. `t-top` alone is not
  ; the test either: the whole HIGH half behaves the same way, and the extra cases are exactly
  ; the contradiction cases a guard exists for. A phi whose declared `int` meets a `null` arm
  ; reports `~dyn`, `ty-isa ~dyn int` is true, and the Cast that nothing satisfies disappears
  ; instead of reporting that the compiler narrowed without proof.
  ;
  ; `cast-compute` twelve lines up already guards on exactly this condition (Simple's freeze
  ; rule). The compute half was right and the irreversible half was not.
  ;
  ; AND `not ty-high?` IS STILL NOT THE PROVEN ANSWER, which the nested case showed: with
  ;
  ;   if (p) { a = 1; } else { if (q) a = null; else a = null; }  return (int)a;
  ;
  ; the outer merge's second path is the inner merge, `phi-compute` skips it while it is
  ; unanalysed, and the Phi momentarily reports `int=1`. That is LOW, it satisfies the target, and
  ; the check on a value nothing had proved anything about was deleted on 110 of 200 worklist
  ; seeds. The surviving graph even printed the Phi's settled type as `null|int`, so the analysis
  ; knew the Cast was unsatisfiable after the Cast was gone. A local "no region path of the input
  ; phi is high" test would fix that fixture and not the next level down, because the arm can
  ; itself be a provisional Phi while every region path already reads `ctrl`; the property needed
  ; is transitive, so this asks `n-ty-proven?`.
  (if (and (n-ty-proven? (n-in n 1))
           (and (not (ty-high? (n-in-ty n 1))) (ty-isa (n-in-ty n 1) (n-cast-target-type n))))
      (n-in n 1)
      NO-NODE))

;; Unbox<T>(Box(x)) is x when x is proven to satisfy T. The proof requirement matters even though
;; the nodes are adjacent: deleting the pair on a provisional Phi would silently discharge the
;; representation check in exactly the way an early Cast deletion discharges a type guard.
;; `Box(Box(x))` IS `Box(x)`. Boxing is idempotent -- the second one has nothing left to tag --
;; and leaving the pair standing is not merely wasteful: `unbox-idealize` peels exactly ONE layer,
;; so `Unbox(Box(Box(x)))` folds to the INNER BOX and hands a tagged word to something that asked
;; for a raw one. That is `BitOr slot 1 <- Box is tagged, needs raw-num` on `o.x | 0`, where the
;; field load already forwarded to a boxed value and the DSL call boxed it again on the way in.
;;
;; Only a plain box: `BOX-AUX-ARRAY` preserves an Array tag and is not the same operation.
(defn box-idealize [(n i64)] (-> i64)
  (let [v (n-in n 1)]
    (if (match (n-op n) (Box [mode] (= mode 0)) (_ false))
        ;; Box(Unbox<int>(tagged)) is the original tagged word. The Unbox can only reach its normal
        ;; value after the upstream Cast/tag check, so this retains the check while removing two
        ;; inverse representation moves. Besides being canonical, this matters to scheduling: the
        ;; re-box is otherwise a floating definition after a controlled Unbox and can acquire a
        ;; use earlier than the only block in which its input exists in large shared JSL graphs.
        (if (and (and (!= v NO-NODE) (not (n-dead? v)))
                 (match (n-op v)
                   (Unbox [target]
                     (and (ty-int-only? target)
                          (= (n-rep-of (n-in v 1) 8) REP-TAGGED)))
                   (_ false)))
            (n-in v 1)
        (if (n-plain-box? v)
            v
            ;; BOXING A TAGGED WORD IS THE IDENTITY, and `Box(Box(x))` above is only its easiest
            ;; case. The frontend boxes DSL operands blindly (`fng-arith2` and friends), so a value
            ;; that is tagged WITHOUT being a Box node -- a Phi joining Box arms, a PropLoad --
            ;; arrives here under a second tag, and the backend's Box would convert the NaN-box
            ;; bits as if they were a raw number. The classification must be certain: UNKNOWN
            ;; stands, and an open Phi reads UNKNOWN by construction (see `n-rep-of`), which is
            ;; what keeps the deferred `Box(Phi)` placeholders alive until they are distributed.
            (if (and (and (!= v NO-NODE) (not (n-dead? v)))
                     (= (n-rep-of v 8) REP-TAGGED))
                v
                NO-NODE)))
        NO-NODE)))

;; A dynamic boundary can be built while a loop Phi is still open. Its missing backedge makes the
;; representation unknown, so `n-box!` must retain a `Box(Phi)` placeholder until graph construction
;; closes every incoming edge. A raw Phi spanning different JavaScript tag classes cannot be boxed
;; after the merge: the merged machine word no longer says whether (for example) it was raw
;; `undefined` or raw `bool`. Normalize the graph by boxing each incoming value on its own CFG edge
;; and joining the tagged words instead.
;;
;; This is a GRAPH invariant, not JavaScript-frontend policy. Standalone JSL library graphs need the
;; same normalization, and keeping it in `frontend_native_graph.coil` left their `Box(Phi)` nodes to
;; fail selection with no single tag. Loop self-edges remain self-edges in the new tagged Phi.
(defn g-distribute-deferred-phi-boxes! [] (-> i64)
  (let [(mut node) 0
        (mut changed) 0]
    ;; The scan follows the growing graph deliberately. Boxing one arm may expose a nested
    ;; `Box(Phi)` that did not exist at entry; stopping at the original node count normalizes only
    ;; the outer join and leaves selection facing the same impossible raw union one level down.
    (loop (if (>= (load node) (n-count))
              (break)
              (do
                (if (and (not (n-dead? (load node)))
                         (match (n-op (load node))
                           (Box [mode] (= mode BOX-AUX-INFER))
                           (_ false)))
                    (let [value (n-in (load node) 1)]
                      (if (and (!= value NO-NODE)
                               (and (not (n-dead? value)) (op-is? value Phi [_])))
                          (let [(mut input) 1
                                (mut closed) true]
                            (loop (if (or (>= (load input) (n-nins value))
                                          (not (load closed)))
                                      (break)
                                      (do
                                        (if (= (n-in value (load input)) NO-NODE)
                                            (set! closed false)
                                            0)
                                        (set! input (+ (load input) 1)))))
                            (if (load closed)
                                (let [boxed (n-new (Phi (t-dyn)))]
                                  (n-add-def! boxed (n-in value 0))
                                  (set! input 1)
                                  (loop (if (>= (load input) (n-nins value))
                                            (break)
                                            (do
                                              (let [incoming (n-in value (load input))]
                                                (n-add-def! boxed
                                                            (if (= incoming value)
                                                                boxed
                                                                (n-box! incoming))))
                                              (set! input (+ (load input) 1)))))
                                  (n-keep! boxed)
                                  (n-subsume! (load node) boxed)
                                  (n-unkeep! boxed)
                                  (set! changed (+ (load changed) 1))
                                  0)
                                0))
                          0))
                    0)
                (set! node (+ (load node) 1)))))
    (load changed)))

(defn unbox-idealize [(n i64)] (-> i64)
  (let [b (n-in n 1)]
    (if (and (and (!= b NO-NODE) (not (n-dead? b))) (op-is? b Box [_]))
        (let [v (n-in b 1)]
          ;; A NUMERIC UNBOX OF A PROVEN NUMBER IS THAT NUMBER, whichever numeric kind it is.
          ;;
          ;; `ty-isa int flt` is false, and that is a fact about the TYPE LATTICE, not about the
          ;; machine: `v-rep-of` calls a raw int and a raw double the same thing, `REP-RAW-NUM`, and
          ;; that is the property selection reads. Every numeric consumer takes either -- the
          ;; hand-written `n + 1` was `Add(Arg:int, Const:int=1) : num` with no conversion in it at
          ;; all.
          ;;
          ;; Without this, routing arithmetic through `lib/` boxes a raw int only to unbox it as a
          ;; double, and `n + 1` costs fourteen nodes where six is the whole program. That overhead
          ;; is introduced by the round trip, not required by the arithmetic.
          ;; See docs/DSL-OWNERSHIP.md.
          ;; A TYPE PROOF IS NOT A REPRESENTATION PROOF. `Unbox(Box(v)) = v` additionally requires
          ;; that `v` be the RAW value the Unbox promises -- and a tagged value can prove `num`:
          ;; a Phi joining Box arms has type num and holds a NaN-boxed word. Deleting the pair
          ;; handed that word to a raw Add (the opcode fuzzer's `((If) (New))` counterexample:
          ;; if/else merges two boxed arms, the object field forwards the Phi, and the folded
          ;; arithmetic consumed the tag bits). Certainly-tagged vetoes the fold; `box-idealize`
          ;; then peels the identity re-tag and the Unbox stays as the genuine conversion.
          (if (and (and (!= v NO-NODE) (n-ty-proven? v))
                   (!= (n-rep-of v 8) REP-TAGGED))
              (if (ty-isa (n-ty v) (n-unbox-target-type n))
                  v
                  (if (and (ty-isa (n-ty v) (t-num))
                           (ty-isa (n-unbox-target-type n) (t-num)))
                      v
                      NO-NODE))
              NO-NODE))
      NO-NODE)))

;; THE SAME WORD OF THE SAME OBJECT, decided without reading a single type.
;;
;; Two conditions, and each of them is one half of "the same word". The alias class is the FIELD:
;; this IR resolves memory to alias classes, one class is one field of one shape, and that is what
;; takes the place of Simple's offset comparison. The pointer is the OBJECT, and it is compared by
;; NODE IDENTITY: one node is one object because `op-gvn?` excludes `New`, so two structurally
;; identical allocations stay two nodes and two objects, and therefore one node can only ever have
;; been one allocation.
(defn load-store-same-word? [(ld i64) (st i64) (p i64)] (-> bool)
  (let [wanted (match (n-op ld) (Load [alias] alias) (Store [alias] alias)
                 (_ (do (panic-corrupt "same-word query expects Load or Store") 0)))]
    (match (n-op st)
      (Store [alias] (and (= alias wanted) (= (n-in st 2) p)))
      (_ false))))

;; LOAD AFTER STORE. `Load(ptr=p, mem=Store(mem=_, ptr=p, val=v))` is `v`.
;;
;; IT IS STRUCTURAL, AND IT HAS TO BE. The memory compute header above says why: a memory type
;; describes a whole alias CLASS, so `store-compute` MEETS the stored value into the incoming
;; contents rather than replacing it, and the load on the smallest heap fixture is honestly typed
;; `undefined|int=5`. No alias-level type can ever say that THIS pointer's word is the one the
;; store wrote. Node identity can, and that is a fact about the graph rather than about the
;; lattice, which is exactly why 4b pinned the union in `tests/mem-test.coil`: so this slice is
;; measured against a number the analysis actually earned.
;;
;; SIMPLE'S OFFSET-OVERLAP TEST IS DELIBERATELY NOT PORTED. Chapter 24's `LoadNode.idealize` also
;; forwards PAST a store when the two offsets provably cannot overlap, which asks whether two
;; types are disjoint and then rewrites irreversibly: that is the exact shape D8 forbids acting on
;; provisionally. Its other rule (forwarding past a store to a provably DIFFERENT allocation) is
;; structural and would be legitimate here, but it needs a distinct-allocation predicate that does
;; not exist yet, and pushing a load up through a Phi -- Simple's third rule -- builds a new Phi on
;; the merge's region and so lands in region/phi arity lockstep (LAW 5). Both are later business.
;;
;; ANYTHING ELSE DECLINES: a Phi, a MemMerge, a `Proj` of a New, a Store naming a different class,
;; a Store on a different pointer. Declining is unconditionally sound, because the load simply
;; stays and reads its own memory edge.
;;
;; THE DECLINE RECORDS A DEP ON THE MEMORY NODE, which `wl-push-outs!` does not cover: that pushes
;; the load when the memory node's TYPE moves, and this rule reads the memory node's OP and INPUTS.
;; A Store whose pointer is later rewritten to `p` by some other peephole changes neither its own
;; type nor the load's, and without the dep the load would never be reconsidered. `n-set-def!`
;; flushes a node's deps, which is precisely the event that matters.
(defn load-idealize [(n i64)] (-> i64)
  (let [m (n-in n 1)
        p (n-in n 2)]
    (if (or (= m NO-NODE) (= p NO-NODE))
        NO-NODE
        ; A dead memory input is graph corruption (VERR-DEAD-INPUT), not a rewrite opportunity, and
        ; reporting it is `g-verify`'s job, with the offending node in hand. What must not happen is
        ; reading `ins` out of a killed node: `n-kill!` clears that list, so the read would be either
        ; a bounds panic or, worse, a stale id (see `cproj-idealize`).
        (if (n-dead? m)
            NO-NODE
            ;; PROVEN, and the reason is not the usual one, so it is worth writing down rather than
            ;; copying. Every other guarded rewrite in this file asks `n-ty-proven?` because it READ a
            ;; type and a provisional type is a lie. This one reads no type at all: node identity and an
            ;; alias number are facts about the graph as it stands, and they cannot be provisional.
            ;;
            ;; It asks anyway, because the rewrite is IRREVERSIBLE and the graph it is reading is not
            ;; finished. A Store sitting in a still-settling cone is a store the sweep may yet replace
            ;; (GVN can fold it into an equal one; 4c-2 will delete it outright), and taking its value
            ;; and deleting the load commits to that store's identity permanently. The load's cone
            ;; being at a type fixpoint is the available proxy for "this part of the graph has stopped
            ;; moving", and it is transitive, so it covers the store, its pointer and its value.
            ;;
            ;; It is also what makes the replacement's type safe to install. `load-compute` reports
            ;; `t-top` while the pointer is high, and swapping in `v` under that would WIDEN the type at
            ;; every use of the load. At a fixpoint the pointer is high only if no object reaches the
            ;; load at all, and otherwise `v`'s type is a member of the contents `load-compute`
            ;; reported, so the substitution narrows -- which is the direction `n-set-ty-falling!`
            ;; allows across a rewrite.
            ;; AND THE STORE'S OWN ACCESS MUST NOT BE ONE THE PROGRAM REFUSES. This load is the
            ;; store's reader; taking its value drops that reader and the cascade collects the store,
            ;; so a store the interpreter would have refused by name (EV-SHAPE for a word the object
            ;; does not have, EV-MEM for a state that does not carry the class) turns into a plausible
            ;; value with nothing reported anywhere. Same program, two builds, two answers. Declining
            ;; costs nothing: the load simply stays and reads its own memory edge, and the graph is
            ;; one `g-verify` will not save you from, so somebody has to notice.
            (if (and (load-store-same-word? n m p) (n-ty-proven? n))
                ;; ... AND THE STORE'S OWN ACCESS MUST NOT BE ONE THE PROGRAM REFUSES. Asked in its own
                ;; `if` rather than folded into the condition above, because it may only be asked once
                ;; `m` is known to be a Store: `access-refused?` binds its alias payload, while a
                ;; Phi payload is a declared TYPE.
                (if (access-refused? m)
                    (do (n-add-dep! m n) NO-NODE)
                    ;; COUNTED HERE AND NOWHERE ELSE. A store still being wired has no value yet, and
                    ;; `n-peephole` reads the NO-NODE this would return as "declined"; counting it would
                    ;; be counting a forwarding that never happened, which is exactly the kind of
                    ;; plausible number `g-forwards` exists to replace. So the count goes on the branch
                    ;; that hands back a real node.
                    (let [v (n-in m 3)]
                      (if (= v NO-NODE) NO-NODE (do (g-forwarded!) v))))
                (do (n-add-dep! m n) NO-NODE))))))

;; The store-after-store form of the same question, and it IS the same question. Both ops carry
;; the alias class in `aux` and the pointer in slot 2, so `load-store-same-word?` reads nothing
;; from its first argument that a Store does not have. It gets its own name so the call site below
;; says what it is asking, and so that a day when the two ops' layouts diverge has ONE line to
;; change rather than a call site somebody has to remember.
(defn store-store-same-word? [(outer i64) (inner i64) (p i64)] (-> bool)
  (load-store-same-word? outer inner p))

;; IS THIS STORE THE ONLY THING THAT READS THAT MEMORY STATE. Simple's `checkOnlyUse`, and it is
;; the one clause that makes 4c-2 harder than 4c-1.
;;
;; WHAT IT IS NOT FOR, said first because the obvious story is wrong and this was MEASURED rather
;; than argued. Bypassing an inner store is not a value-level miscompile when somebody else reads
;; it. In this IR a Store is a pure function from memory state to memory state, so
;; `Store(p,v2,Store(p,v1,m))` and `Store(p,v2,m)` denote the SAME state -- the second write lands
;; on the same word of the same object and the first is invisible in the result either way -- and
;; the other reader goes on reading the inner store, which the bypass leaves untouched. The
;; guarded fixture in the corpus was built expecting this clause to be the thing standing between
;; the program and a wrong answer; deleting the clause and running the differential oracle over
;; the fixture returns the identical answer on every seed. Writing "otherwise it returns 2 where
;; the answer is 1" here would have been a plausible sentence that no gate could support.
;;
;; WHAT IT IS FOR is Simple's own reason, and it is about SERIALISABILITY rather than about values:
;; "you get weird non-serializable memory effects in the worst case". Bypass a store somebody else
;; still reads and the graph now holds TWO live writes to one word, both derived from the same
;; incoming state, with no memory edge ordering them against each other. Nothing in the ideal
;; graph is wrong, and the demand-driven interpreter cannot see it, because each state is a value.
;; It stops being harmless the moment memory is one mutable heap and a scheduler has to pick an
;; order for two writes the IR no longer orders (M10's GCM, and D2's safepoints on top of it).
;; Refusing to create that shape is much cheaper than detecting it later.
;;
;; And it is what makes this rewrite a DELETION rather than an edge shuffle. `g-store-elims` counts
;; stores that stopped existing; without this clause it would count edge rearrangements that
;; removed nothing, which is exactly the sort of plausible number the counter was added to replace.
;;
;; PINNED COUNTS AS A CONSUMER. `keeps` is the ONLY signal in the graph that says "a use is
;; coming": a fixture holds a memory state across the next line precisely because the `Return` that
;; roots it does not exist yet (see `fx-object`'s note), and a store in that window has exactly one
;; use and looks final. `n-del-use!` already reports a pinned node as still used, so without this
;; clause the bypass would not kill the store -- it would silently rearrange a chain the builder is
;; still holding open, and the builder's next line would root a state the write no longer reaches.
;;
;; THE DEP GOES ON EVERY OTHER USER. `wl-push-outs!` only re-queues this store when the inner
;; store's TYPE moves, and this rule reads the inner store's USE COUNT. A user that stops reading
;; the state changes neither type, so without the dep the rewrite is never reconsidered. That is
;; Simple's reason for `addDep` in `checkOnlyUse` and it is the same reason `load-idealize` records
;; one on decline. It is not a complete answer on its own: a user that is KILLED does not flush
;; its own deps (`n-kill!` releases inputs, it does not move deps), so the backstop for that case
;; is `iterate!`'s sweep, which re-pushes every live node whenever anything changed.
(defn store-sole-consumer? [(inner i64) (outer i64)] (-> bool)
  (let [len (n-nouts inner)
        (mut i) 0
        (mut others) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out inner (load i))]
                  (if (= u outer)
                      0
                      (do
                        (n-add-dep! u outer)
                        (set! others (+ (load others) 1))
                        0)))
                (set! i (+ (load i) 1))
                0)))
    (and (= (load others) 0) (= (n-keeps inner) 0))))

;; An allocation escapes as soon as its object projection is used for anything except writing one
;; of its own fields. Stores do not expose identity and, if no Load or value consumer can observe
;; the object, every one of those writes is dead. This is deliberately a use-def question: two
;; allocations may have the same shape and type and are still different objects.
(defn store-ptr-is-local-allocation? [(st i64) (p i64)] (-> bool)
  (if (or (or (n-dead? p) (or (n-observed? p) (> (n-keeps p) 0)))
          (not (match (n-op p) (Proj [projection] (= projection 0)) (_ false))))
      false
      (let [nw (n-in p 0)]
        (if (or (n-dead? nw) (not (op-is? nw New [_])))
            false
            (let [len (n-nouts p)
                  (mut i) 0
                  (mut local) true]
              (loop (if (or (>= (load i) len) (not (load local)))
                        (break)
                        (do
                          (let [u (n-out p (load i))]
                            (if (and (and (and (not (n-dead? u)) (op-is? u Store [_]))
                                          (= (n-in u 2) p))
                                     (not (access-refused? u)))
                                0
                                (set! local false)))
                          (set! i (+ (load i) 1))
                          0)))
              (and (load local) (> len 0)))))))

;; Once the object projection of a New is gone, its memory projections are transparent: an
;; allocation whose identity cannot be observed has made no change to the incoming memory. The
;; projection slot and New input slot deliberately line up (slot 0 is the object; slot 1+i is
;; field i on both sides). Count only the final projection, because that substitution is the one
;; whose kill cascade actually removes the New.
(defn proj-dead-allocation-idealize [(pr i64)] (-> i64)
  (if (<= (n-proj-slot pr) 0)
      NO-NODE
      (let [nw (n-in pr 0)]
        (if (or (n-dead? nw) (not (op-is? nw New [_])))
            NO-NODE
            (if (!= (n-multi-proj nw 0) NO-NODE)
                NO-NODE
                (if (not (n-ty-proven? pr))
                    (do (n-add-dep! nw pr) NO-NODE)
                    (let [m (n-in nw (n-proj-slot pr))]
                      (if (or (= m NO-NODE) (n-dead? m))
                          NO-NODE
                          (do
                            (if (= (n-nouts nw) 1) (g-dead-allocation!) 0)
                            m)))))))))

;; STORE AFTER STORE. `Store(p, v2, mem=Store(p, v1, m))` becomes `Store(p, v2, mem=m)`: the inner
;; write is overwritten before anything can read it, so it never happened.
;;
;; IT REWIRES IN PLACE AND RETURNS `n`. There is no replacement node to hand back -- the surviving
;; store is this one -- so the rewrite is a `n-set-def!` on slot 1 and the inner store dies of
;; having no uses left, through the ordinary cascade. That shape has three consequences, and each
;; one is a line below rather than a comment:
;;
;;   - GVN GOES STALE. A Store is value-numbered (`op-gvn?` admits everything above `Stop` bar
;;     `Arg` and `New`), and the table hashes the node's INPUTS out of the arena. Mutating an
;;     installed node leaves an entry filed under a hash nothing will ever compute again, and the
;;     next structurally identical Store either fails to dedup or, worse, dedups against a stale
;;     bucket. `gvn-remove!` before the mutation, and `n-peephole`'s own `gvn!` re-files it after.
;;   - PROGRESS HAS TO BE DECLARED. `n-peephole` counts an idealize as a change only when it
;;     returns a DIFFERENT node, and `iterate!` stops sweeping when a sweep changed nothing. An
;;     in-place rewrite that says nothing can therefore end a sweep with a newly enabled,
;;     proof-gated rewrite still pending, which is an order-dependent graph. Hence `g-changed!`.
;;     (`region-remove-path!` has exactly this shape and does NOT do it; that is a pre-existing
;;     hazard, noted rather than copied.) No corpus fixture distinguishes it today: removing the
;;     call leaves every count and every answer unchanged over 40 raw-then-`iterate!` seeds,
;;     because something else in the same sweep always bumps `nchg`. It stays because being right
;;     by construction costs one line and being right by coincidence costs a debugging session.
;;   - THE STORE'S TYPE RISES, and that is correct. `store-compute` MEETS the stored value into the
;;     incoming contents, so before the rewrite this store reports `meet(contents(m), v1, v2)` and
;;     after it reports `meet(contents(m), v2)`, which is strictly MORE SPECIFIC. The old answer
;;     was an over-approximation naming a value the class no longer holds anywhere; the new one is
;;     the truth. A rewrite narrowing a type across `iterate!` is the direction the notes on
;;     `n-ty-proven?` already allow (dropping a dead region path narrows a Phi the same way), and
;;     `n-peephole` installs it with `n-set-ty!`. It is NOT allowed inside `g-analyze!`, which
;;     rewrites nothing and would report it through `n-set-ty-falling!`.
;;
;; FOUR GUARDS, EACH IN ITS OWN `if`, so the reason for a decline is legible from the code:
;;
;;   1. STRUCTURAL same-word, decided without reading a single type: same alias class (the field)
;;      and the same pointer NODE (the object). This is 4c-1's rule verbatim, and it is structural
;;      for the same reason -- a memory type describes a whole alias CLASS, so no alias-level type
;;      could ever say the two stores hit the same word.
;;   2. ONLY MEMORY CONSUMER, above. It is the one guard here that is NOT a soundness condition on
;;      the value the program computes; read its note for what it actually buys.
;;   3. PROVEN, and the reason is 4c-1's rather than the type-disbelief one, so it is worth saying
;;      again: this rule reads no type, so the guard is not about a provisional type being a lie.
;;      It is that the rewrite is IRREVERSIBLE and the cone it is reading has not stopped moving.
;;      A store in a still-settling cone is one the sweep may yet replace (GVN can fold it into an
;;      equal one; a pointer can still be rewritten under it), and deleting a write on the strength
;;      of a graph that is still being rearranged commits permanently to an arrangement that was
;;      never final. `n-ty-proven?` is the available proxy for "this part of the graph has stopped
;;      moving", and it is transitive, so it covers the inner store, the pointer and both values.
;;      NOTHING IN THE CORPUS REFUSES ON THIS CLAUSE YET, and that is measured: instrumenting the
;;      branch over the whole corpus plus 40 raw-then-`iterate!` seeds counted zero proof-gated
;;      refusals here, for exactly the reason 4c-1 wrote down about its own version -- a fixture
;;      that is ANALYSED before the first peephole has already settled the cone. The construction
;;      that forces it is the UNANALYSED one (`a_refused_forwarding_is_deferred_and_lands_under_
;;      every_seed` in tests/mem-test.coil builds it for a Load); the store analogue belongs in
;;      the same place, and until it exists this branch is a rule with no witness.
;;   4. NEITHER ACCESS IS ONE THE PROGRAM REFUSES. This one READS types inside an irreversible
;;      rewrite, and it is sound only because its sole effect is to NOT FIRE (LAW 3: reading a
;;      provisional type to decline is always safe). If the inner store is refused, the interpreter
;;      owes the program an EV-SHAPE or EV-MEM at that node, and deleting it turns a trap into a
;;      plausible answer -- the same program, two builds, two results. If the OUTER store is
;;      refused the program traps here anyway and the inner write is not obviously dead, so
;;      declining costs nothing. It is asked in its own `if`, AFTER the inner node is known to be a
;;      Store, because `access-refused?` binds the Store alias payload while a Phi payload is a
;;      declared TYPE.
(defn store-idealize [(n i64)] (-> i64)
  (let [m (n-in n 1)
        p (n-in n 2)]
    (if (or (= m NO-NODE) (= p NO-NODE))
        NO-NODE
        ; A dead memory input is graph corruption (VERR-DEAD-INPUT), not a rewrite opportunity, and
        ; reading `ins` out of a killed node returns a stale id: `n-kill!` clears the list. Same
        ; stance, and the same reason, as `load-idealize`.
        (if (n-dead? m)
            NO-NODE
            ;; A Store with no user is commonly still under construction: the Return or next memory
            ;; op that roots it is built on the following line. Wait until it has a real consumer, and
            ;; treat a pin as the same promise of a future consumer that the rest of this file does.
            (if (and (and (> (n-nouts n) 0) (= (n-keeps n) 0))
                     (store-ptr-is-local-allocation? n p))
                (if (not (n-ty-proven? n))
                    (do (n-add-dep! m n) NO-NODE)
                    (if (access-refused? n)
                        (do (n-add-dep! m n) NO-NODE)
                        m))
                (if (not (store-store-same-word? n m p))
                    (do (n-add-dep! m n) NO-NODE)
                    ; The inner store's own memory is what this store inherits. A store still being wired
                    ; has none yet, and rewiring to NO-NODE would leave a Store with a null memory edge,
                    ; which is a malformed node rather than an optimisation.
                    (let [mm (n-in m 1)]
                      (if (or (= mm NO-NODE) (n-dead? mm))
                          (do (n-add-dep! m n) NO-NODE)
                          (if (not (store-sole-consumer? m n))
                              (do (n-add-dep! m n) NO-NODE)
                              (if (not (n-ty-proven? n))
                                  (do (n-add-dep! m n) NO-NODE)
                                  (if (or (access-refused? n) (access-refused? m))
                                      (do (n-add-dep! m n) NO-NODE)
                                      (do
                                        (gvn-remove! n)
                                        (n-set-def! n 1 mm)
                                        (g-store-elim!)
                                        (g-changed!)
                                      n))))))))))))

;; Forward a constant-index dense-array read through its dominating store chain. This is the array
;; analogue of field load forwarding: a different constant index cannot alias, while an unknown
;; index stops the walk. Literal callback expansion exposes exactly these constant reads and lets
;; ordinary dead-node cleanup scalar-replace arrays that never escape.
(defn arrayload-idealize [(n i64)] (-> i64)
  (let [owner (n-in n 2)
        index (n-in n 3)
        (mut memory) (n-in n 1)
        (mut fuel) 64
        (mut answer) NO-NODE]
    (loop (if (or (!= (load answer) NO-NODE)
                  (or (<= (load fuel) 0) (= (load memory) NO-NODE)))
              (break)
              (let [m (load memory)]
                (if (op-is? m ArrayResize [])
                    (let [resized-owner (n-in m 2)
                          resized-length (n-in m 3)]
                      (if (and (= resized-owner owner)
                               (and (op-is? resized-length Const [_])
                                    (and (op-is? index Const [_])
                                         (< (ty-int-lo (n-const-type index))
                                            (ty-int-lo (n-const-type resized-length))))))
                          (set! memory (n-in m 1))
                          (set! fuel 0)))
                    (if (not (op-is? m ArrayStore []))
                        (set! fuel 0)
                        (let [stored-owner (n-in m 2)
                          stored-index (n-in m 3)]
                          (if (!= stored-owner owner)
                              (set! memory (n-in m 1))
                              (if (= stored-index index)
                                  (set! answer (n-in m 4))
                                  (if (and (op-is? stored-index Const [_])
                                           (and (op-is? index Const [_])
                                                (!= (n-const-type stored-index) (n-const-type index))))
                                      (set! memory (n-in m 1))
                                      (set! fuel 0)))))))
                (set! fuel (- (load fuel) 1)))))
    (load answer)))

; ============================================================================
; idealize: local rewrites
; ============================================================================
(defn dead-controlled-memory-effect? [(n i64)] (-> bool)
  (match (n-op n)
    (Store [_] true)
    (PropStore [_] true)
    (PropDelete [_] true)
    (PropStoreKey [_] true)
    (PropDeleteKey [] true)
    (SetProto [] true)
    (ObjectFreeze [] true)
    (InternalStore [_] true)
    (ArrayStore [] true)
    (ArrayResize [] true)
    (ArrayCopy [] true)
    (StringSplit [] true)
    (Effect [] true)
    (_ false)))

(defn n-idealize [(n i64)] (-> i64)
  ;; An effect on proven-unreachable control never executes. Its outgoing memory is therefore
  ;; exactly its incoming memory; retaining the write also retains every value used only to build
  ;; that dead arm and can manufacture a control-only CFG leaf with no terminator.
  (if (and (dead-controlled-memory-effect? n) (n-in-proven-xctrl? n 0))
      (n-in n 1)
      (match (n-op n)
    (Start [] NO-NODE)
    (Stop [] (stop-idealize n))
    (Return [] NO-NODE)
    (If [] NO-NODE)
    (Region [] (region-idealize n))
    (Loop [] (region-idealize n))
    (CProj [_] (cproj-idealize n))
    (XCtrl [] NO-NODE)
    (Const [_] NO-NODE)
    (Arg [_] NO-NODE)
    (Proj [_] (proj-dead-allocation-idealize n))
    (Phi [_] (phi-idealize n))
    (Cast [_] (cast-idealize n))
    (Add [] (add-idealize n))
    (Sub [] (sub-idealize n))
    (Mul [] (mul-idealize n))
    (Div [] NO-NODE)
    (Minus [] (minus-idealize n))
    (Not [] NO-NODE)
    (Eq [] (cmp-idealize n))
    (Lt [] (cmp-idealize n))
    (Le [] (cmp-idealize n))
    (New [_] NO-NODE)
    (Load [_] (load-idealize n))
    (Store [_] (store-idealize n))
    (MemMerge [] NO-NODE)
    (Box [_] (box-idealize n))
    (Unbox [_] (unbox-idealize n))
    (TypeTest [_] NO-NODE)
    (CallEnd [] (callend-idealize n))
    (Fun [_] NO-NODE)
    (CallableId [_] NO-NODE)
    (Parm [_] NO-NODE)
    (Call [_] (call-idealize n))
    (FunStart [] NO-NODE)
    (Closure [_] NO-NODE)
    (Safepoint [] NO-NODE)
    (Barrier [] (barrier-idealize n))
    (Mod [] NO-NODE)
    (BitAnd [] NO-NODE)
    (BitOr [] NO-NODE)
    (BitXor [] NO-NODE)
    (Shl [] NO-NODE)
    (Shr [] NO-NODE)
    (UShr [] NO-NODE)
    (BitNot [] NO-NODE)
    (PropLoad [_] NO-NODE)
    (PropStore [_] NO-NODE)
    (SetProto [] NO-NODE)
    (ArrayMark [] NO-NODE)
    (ArrayLoad [_] (arrayload-idealize n))
    (ArrayStore [] NO-NODE)
    (ArrayLen [] NO-NODE)
    (ArrayResize [] NO-NODE)
    (ArrayCopy [] NO-NODE)
    (StringConst [_] NO-NODE)
    (StringLen [] NO-NODE)
    (StringEq [] NO-NODE)
    (StringConcat [] NO-NODE)
    (StringCharCode [] NO-NODE)
    (StringSubstring [_] NO-NODE)
    (ToString [] NO-NODE)
    (ParseInt [] NO-NODE)
    (IsNaN [] NO-NODE)
    (StringSplit [] NO-NODE)
    (StringFromCodeUnit [] NO-NODE)
    (NumberToString [] NO-NODE)
    (ToFixed [] NO-NODE)
    (StringAlloc [] NO-NODE)
    (StringSetUnit [] NO-NODE)
    (StringIndexOf [] NO-NODE)
    (StringCompare [] NO-NODE)
    (JsBuiltin [_] NO-NODE)
    (JsThrow [] NO-NODE)
    (ToInteger [] NO-NODE)
    (ToNumber [] NO-NODE)
    (ArrayTest [] NO-NODE)
    (ArrayUnbox [] NO-NODE)
    (ParseFloat [] NO-NODE)
    (PropHas [_] NO-NODE)
    (PropDelete [_] NO-NODE)
    (ProtoHas [] NO-NODE)
    (PropLoadKey [_] NO-NODE)
    (PropStoreKey [_] NO-NODE)
    (PropHasKey [] NO-NODE)
    (PropDeleteKey [] NO-NODE)
    (OwnKeyCount [] NO-NODE)
    (OwnKeyAt [] NO-NODE)
    (ObjectFreeze [] NO-NODE)
    (InternalLoad [_] NO-NODE)
    (InternalStore [_] NO-NODE)
    (StringNormalize [] NO-NODE)
    (Effect [] NO-NODE))))

(defn callend-idealize [(n i64)] (-> i64)
  (let [ctrl (n-in n 0)]
    (if (op-is? ctrl XCtrl []) ctrl NO-NODE)))

(defn barrier-idealize [(n i64)] (-> i64)
  (let [prior (n-in n 1)]
    (if (and (op-is? prior Barrier [])
             (and (= (n-in prior 2) (n-in n 2)) (= (n-in prior 3) (n-in n 3))))
        prior
        NO-NODE)))

(defn n-find-fun-index [(fidx i64)] (-> i64)
  (let [index (.fun-index (graph))
        cached (if (and (>= fidx 0) (< fidx (al-len [i64] index)))
                   (al-get [i64] index fidx)
                   NO-NODE)
        lim (n-count)
        (mut i) 0
        (mut found)
          (if (and (!= cached NO-NODE)
                   (and (not (n-dead? cached))
                        (and (op-is? cached Fun [_]) (= (n-fun-index cached) fidx))))
              cached
              NO-NODE)]
    (loop (if (or (>= (load i) lim) (!= (load found) NO-NODE))
              (break)
              (do
                (if (and (and (not (n-dead? (load i))) (op-is? (load i) Fun [_]))
                         (= (n-fun-index (load i)) fidx))
                    (set! found (load i))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (load found)))

(defn call-idealize [(n i64)] (-> i64)
  ;; A dynamic-receiver call's finite target set constrains dispatch; it does not replace the
  ;; runtime callable loaded from the heap. Rewriting a singleton Cast to its Fun made the
  ;; backend validate the raw compile-time fidx as though it were a tagged JavaScript function.
  (if (= (n-call-abi n) CALL-ABI-DYNAMIC-RECEIVER)
      NO-NODE
  (let [callee (n-in n 1)]
    (if (or (op-is? callee Fun [_]) (op-is? callee Closure [_]))
        NO-NODE
        (if (not (n-ty-proven? callee))
            NO-NODE
            (let [fidx (ty-fun-singleton (n-ty callee))]
              (if (< fidx 0)
                  NO-NODE
                  (let [fun (n-find-fun-index fidx)]
                    (if (= fun NO-NODE)
                        NO-NODE
                        ;; Devirtualizing is only sound when this call site already supplies every
                        ;; parameter the target reads. A capture-carrying target receives its
                        ;; hidden environment through the closure value being discarded here;
                        ;; rewriting such a call to the bare Fun leaves its capture parameters
                        ;; reading the argument registers (VERR-CALL-ARITY at best).
                        (let [raw (- (n-nins n) 2)
                              mem (and (> raw 0)
                                       (ty-mem? (n-ty (n-in n (- (n-nins n) 1)))))
                              explicit (- raw (if mem 1 0))
                              (mut parms) 0
                              (mut out) 0]
                          (loop (if (>= (load out) (n-nouts fun))
                                    (break)
                                    (let [u (n-out fun (load out))]
                                      (if (and (not (n-dead? u))
                                               (and (op-is? u Parm [_]) (= (n-in u 0) fun)))
                                          (if (>= (n-parm-index u) (load parms))
                                              (set! parms (+ (n-parm-index u) 1))
                                              0)
                                          0)
                                      (set! out (+ (load out) 1)))))
                          (if (> (load parms) explicit)
                              NO-NODE
                              (do (gvn-remove! n)
                                  (n-set-def! n 1 fun)
                                  (g-changed!)
                                  n))))))))))))

;; M6's deliberately conservative first inliner. It admits only a single Return directly owned by
;; FunStart and a pure expression tree. Branches, memory, calls (including recursion), and closures
;; stay as calls. The preflight makes cloning atomic: an unsupported leaf is discovered before any
;; new node is allocated.
(defn inline-clonable? [(x i64) (fun i64) (call i64) (fuel i64)] (-> bool)
  (if (<= fuel 0)
      false
      (match (n-op x)
        (Const [ty] true)
        (Parm [index] (and (= (n-in x 0) fun) (< index (- (n-nins call) 2))))
        (Cast [target] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (Box [mode] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (Unbox [target] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (TypeTest [target] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (Minus [] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (Not [] (inline-clonable? (n-in x 1) fun call (- fuel 1)))
        (Add [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Sub [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Mul [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Div [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Eq [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                    (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Lt [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                    (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Le [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                    (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Mod [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (BitAnd [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                        (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (BitOr [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                       (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (BitXor [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                        (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Shl [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Shr [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                     (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (UShr [] (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                      (inline-clonable? (n-in x 2) fun call (- fuel 1))))
        (Arg [ty] (= (n-in x 0) (n-fun-entry fun)))
        (ArrayLoad [alias]
          (and (= (n-in x 0) (n-fun-entry fun))
               (and (inline-clonable? (n-in x 1) fun call (- fuel 1))
                    (and (inline-clonable? (n-in x 2) fun call (- fuel 1))
                         (inline-clonable? (n-in x 3) fun call (- fuel 1))))))
        (_ false))))

(defn inline-clone! [(x i64) (fun i64) (call i64)] (-> i64)
  (match (n-op x)
    (Const [ty] x)
    (Parm [index] (n-in call (+ 2 index)))
    (Cast [target] (n-peephole (n-new2 (Cast target) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (Box [mode] (n-peephole (n-new2 (Box mode) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (Unbox [target] (n-peephole (n-new2 (Unbox target) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (TypeTest [target] (n-peephole (n-new2 (TypeTest target) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (Minus [] (n-peephole (n-new2 (Minus) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (Not [] (n-peephole (n-new2 (Not) NO-NODE (inline-clone! (n-in x 1) fun call))))
    (Add [] (n-peephole (n-new3 (Add) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Sub [] (n-peephole (n-new3 (Sub) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Mul [] (n-peephole (n-new3 (Mul) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Div [] (n-peephole (n-new3 (Div) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Eq [] (n-peephole (n-new3 (Eq) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Lt [] (n-peephole (n-new3 (Lt) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Le [] (n-peephole (n-new3 (Le) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Mod [] (n-peephole (n-new3 (Mod) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (BitAnd [] (n-peephole (n-new3 (BitAnd) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (BitOr [] (n-peephole (n-new3 (BitOr) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (BitXor [] (n-peephole (n-new3 (BitXor) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Shl [] (n-peephole (n-new3 (Shl) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Shr [] (n-peephole (n-new3 (Shr) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (UShr [] (n-peephole (n-new3 (UShr) NO-NODE (inline-clone! (n-in x 1) fun call) (inline-clone! (n-in x 2) fun call))))
    (Arg [ty] (n-in call (- (n-nins call) 1)))
    (ArrayLoad [alias]
      (n-peephole
        (n-new4 (ArrayLoad alias)
                  (n-in call 0)
                  (inline-clone! (n-in x 1) fun call)
                  (inline-clone! (n-in x 2) fun call)
                  (inline-clone! (n-in x 3) fun call))))
    (_ NO-NODE)))

(defn call-callend [(call i64)] (-> i64)
  (let [len (n-nouts call)
        (mut i) 0
        (mut found) NO-NODE
        (mut many) false]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out call (load i))]
                  (if (and (not (n-dead? u)) (op-is? u CallEnd []))
                      (if (= (load found) NO-NODE) (set! found u) (set! many true))
                      0))
                (set! i (+ (load i) 1))
                0)))
    (if (load many) NO-NODE (load found))))

(defn inline-one-call! [(call i64)] (-> bool)
  (if (or (n-dead? call) (not (op-is? call Call [_])))
      false
      (let [callee (n-in call 1)
            fun (infer-direct-callee-fun call)]
        ;; A top-level source callback is represented as a capture-free Closure,
        ;; while JSL-local calls name Fun directly. Both have the same argument
        ;; mapping and are safe for this straight-line inliner.
        (if (or (= fun NO-NODE)
                (or (and (op-is? callee Closure [_]) (!= (n-nins callee) 1))
                    (!= (n-nins fun) 2)))
            false
            (let [ret (n-in fun 1)
                  end (call-callend call)]
              (if (or (= end NO-NODE)
                      (or (not (op-is? ret Return []))
                          (or (!= (n-in ret 0) (n-fun-entry fun))
                              (not (inline-clonable? (n-in ret 1) fun call 32)))))
                  false
                  (let [ctrl (n-in call 0)
                        value (inline-clone! (n-in ret 1) fun call)]
                    (n-keep! ctrl)
                    (n-keep! value)
                    ;; Callback calls carry the current heap as their trailing argument. A pure
                    ;; inlined body returns that same heap; replace CallEnd-rooted memory Args
                    ;; before removing the control boundary so sequential DSL stores remain linked.
                    (let [(mut out-index) 0
                          incoming-memory (n-in call (- (n-nins call) 1))]
                      (loop (if (>= (load out-index) (n-nouts end))
                                (break)
                                (let [use (n-out end (load out-index))]
                                  (if (and (not (n-dead? use)) (op-is? use Arg [_]))
                                      (n-subsume! use incoming-memory) 0)
                                  (set! out-index (+ (load out-index) 1))))))
                    (n-subsume! end ctrl)
                    (n-subsume! call value)
                    (n-unkeep! value)
                    (n-unkeep! ctrl)
                    (if (and (and (not (n-dead? value)) (= (n-nouts value) 0))
                             (= (n-keeps value) 0))
                        (n-kill! value) 0)
                    (g-changed!)
                    true)))))))

;; Remove a local dense array after every observing load has forwarded away and the owner has not
;; escaped. Its stores and resize nodes then carry only sequencing tokens; bypassing them exposes
;; the allocation to ordinary dead-node cleanup.
(defn g-eliminate-dead-local-arrays! [] (-> i64)
  (let [limit (n-count)
        (mut owner) 0
        (mut removed) 0]
    (loop (if (>= (load owner) limit)
              (break)
              (do
                (if (and (not (n-dead? (load owner))) (op-is? (load owner) ArrayMark []))
                    (let [(mut use-index) 0
                          (mut local) true]
                      (loop (if (or (not (load local))
                                    (>= (load use-index) (n-nouts (load owner))))
                                (break)
                                (let [use (n-out (load owner) (load use-index))]
                                  (if (and (or (op-is? use ArrayStore []) (op-is? use ArrayResize []))
                                           (= (n-in use 2) (load owner)))
                                      0
                                      (set! local false))
                                  (set! use-index (+ (load use-index) 1)))))
                      (if (load local)
                          (let [(mut node) 0]
                            (loop (if (>= (load node) limit)
                                      (break)
                                      (do
                                        (if (and (not (n-dead? (load node)))
                                                 (and (or (op-is? (load node) ArrayStore [])
                                                          (op-is? (load node) ArrayResize []))
                                                      (= (n-in (load node) 2) (load owner))))
                                            (do (n-subsume! (load node) (n-in (load node) 1))
                                                (set! removed (+ (load removed) 1))) 0)
                                        (set! node (+ (load node) 1))))))
                          0))
                    0)
                (set! owner (+ (load owner) 1)))))
    (if (> (load removed) 0) (g-changed!) 0)
    (load removed)))

(defn fun-parm-count [(fun i64)] (-> i64)
  (let [len (n-nouts fun)
        (mut i) 0
        (mut count) 0]
    (loop (if (>= (load i) len)
              (break)
              (do
                (let [u (n-out fun (load i))]
                  (if (and (not (n-dead? u)) (op-is? u Parm [_]))
                      (if (> (+ (n-parm-index u) 1) (load count))
                          (set! count (+ (n-parm-index u) 1)) 0)
                      0))
                (set! i (+ (load i) 1))
                0)))
    (load count)))

(defstruct SpecSite [(value i64) (end i64) (fast i64) (fallback i64) (clone i64)])
;; Profile input to M9's specialization cost model.
(defn n-profile-specialize? [(samples i64) (target-hits i64) (clone-cost i64)] (-> bool)
  (and (and (>= samples 32) (>= (* target-hits 100) (* samples 80))) (<= clone-cost 32)))

;; "This operand IS the integer k", which every identity rule below asks about the operand it is
;; about to discard. IT IS A CLAIM ABOUT A TYPE, so it needs the proven answer too: a Phi
;; momentarily reporting `int=0` (its region's other path unanalysed and skipped) is not the
;; literal 0, and reading it as one is how the flat diamond `if (p) x = 8; else x = 0;
;; return x + 1;` compiled to `return 1`. The Phi looked like a constant, `should-swap?` moved it
;; to the right because constants belong on the right, and `x + 0 = x` then handed back the
;; LITERAL 1 as the whole program's value. No fold and no control rewrite was involved, so the
;; four guards on those did not see it.
(defn n-int-con? [(n i64) (v i64)] (-> bool)
  (let [t (n-ty n)]
    (and (and (ty-int-only? t) (and (ty-const? t) (= (ty-int-lo t) v)))
         (n-ty-proven? n))))

;; Order the operands of a commutative op so that value numbering can see `a+b` and `b+a` as
;; the same node. Constants go on the right, then lower node ids first: any total order works,
;; it only has to be stable.
(defn should-swap? [(n i64)] (-> bool)
  (let [l (n-in n 1)
        r (n-in n 2)]
    (if (or (= l NO-NODE) (= r NO-NODE))
        false
        (let [lc (ty-const? (n-ty l))
              rc (ty-const? (n-ty r))]
          (if (and lc (not rc))
              true
              (if (and rc (not lc))
                  false
                  (> l r)))))))

(defn n-swap-args! [(n i64)] (-> i64)
  (let [l (n-in n 1)
        r (n-in n 2)]
    (al-set! [i64] (field (nd n) ins) 1 r)
    (al-set! [i64] (field (nd n) ins) 2 l)
    (set! (.hash (nd n)) 0)
    n))

;; AN IDENTITY IS AN IDENTITY OVER A DOMAIN, AND THE DOMAIN HAS TO BE PROVEN.
;;
;; This is a dynamic language: `+` on a non-number concatenates or calls valueOf, and `- * /`
;; coerce. `arith-compute` already says so, which is why it reports `dyn` for a non-numeric `+`
;; and `num` for the others. So none of the four identities below holds for an arbitrary operand:
;; "3"+0 is "30", "3"-0 is the NUMBER 3, "3"*1 is 3, and -(-"3") is 3. Not one of those is the
;; string "3".
;;
;; Replacing the node by its operand is irreversible, and it replaces a node whose type the
;; lattice already computed with a node of a DIFFERENT type, so the graph afterwards claims a
;; value the language does not produce. That is a miscompile, not a lost optimisation, and it is
;; observable today: the interpreter reports EV-TYPE for arithmetic on a bool (rather than
;; inventing an answer), while the unguarded peephole hands back the bool itself.
;;
;; `mul-idealize`'s `x * 0` and `cmp-idealize`'s `x == x` right below already carry the guard, so
;; the missing ones were an inconsistency rather than a decision. `ty-int-only?` is the right
;; test even where all numerics would be sound (x-0, x*1, -(-x)), because it is what the siblings
;; use; and for `+` it is REQUIRED rather than merely consistent, since -0.0 + 0 is +0.0 and so 0
;; is not an identity for floats either.
;; AND THE DOMAIN HAS TO BE PROVEN, NOT MERELY REPORTED. Each of these reads a type and then
;; irreversibly replaces a node, so it needs `n-ty-proven?` on top of `ty-int-only?`. A Phi that
;; momentarily reports `int=1` because `phi-compute` skipped an unanalysed path makes
;; `ty-int-only?` true while the Phi's settled type is `bool|int`, and `x + 0` then hands back the
;; bool that `ev-arith` refuses. Measured on `if (p) x=1; else { if (q) x=true; else x=true; }
;; return x + 0;`: the Add was lost on 99 of 200 worklist seeds and the program answered `true`
;; where the only correct answer is a type error.
(defn n-proven-int-only? [(n i64)] (-> bool)
  (and (ty-int-only? (n-ty n)) (n-ty-proven? n)))

(defn add-idealize [(n i64)] (-> i64)
  (let [l (n-in n 1)
        r (n-in n 2)]
    ; x + 0 = x, integers only: on a non-number `+` concatenates, and for floats -0.0 + 0 is +0.0
    (if (and (n-int-con? r 0) (n-proven-int-only? l)) l NO-NODE)))

(defn sub-idealize [(n i64)] (-> i64)
  (let [l (n-in n 1)
        r (n-in n 2)]
    (if (and (n-int-con? r 0) (n-proven-int-only? l))
        l  ; x - 0 = x, numbers only: "3"-0 is 3
        ; x - x = 0, but only for integers: NaN - NaN is NaN, not 0
        (if (and (= l r) (n-proven-int-only? l))
            (n-const (t-int-con 0))
            NO-NODE))))

(defn mul-idealize [(n i64)] (-> i64)
  (let [l (n-in n 1)
        r (n-in n 2)]
    (if (and (n-int-con? r 1) (n-proven-int-only? l))
        l  ; x * 1 = x, numbers only
        ; x * 0 = 0 only when x cannot be NaN or an infinity, so integers only
        (if (and (n-int-con? r 0)
                 (and (n-proven-int-only? l) (>= (ty-int-lo (n-ty l)) 0)))
            (n-const (t-int-con 0))
            NO-NODE))))

(defn minus-idealize [(n i64)] (-> i64)
  ; -(-x) = x once x is known numeric; on a non-number the INNER minus already coerced, so the
  ; pair is not the identity at all
  (let [a (n-in n 1)]
    (if (and (op-is? a Minus []) (n-proven-int-only? (n-in a 1))) (n-in a 1) NO-NODE)))

(defn cmp-idealize [(n i64)] (-> i64)
  (let [l (n-in n 1)
        r (n-in n 2)]
    ; x == x is true and x < x is false, for integers. Floats are excluded because NaN is not
    ; equal to itself, which is exactly the trap this guard exists for.
    (if (and (= l r) (n-proven-int-only? l))
        (n-const (t-bool-con (not (op-is? n Lt []))))
        NO-NODE)))

; ============================================================================
; peephole
; ============================================================================
;; Has every input this node reads actually been analysed? A NO-NODE input contributes nothing
;; and is skipped; a real input still sitting at ANY means its type is not known yet.
(defn n-inputs-analysed? [(n i64)] (-> bool)
  (let [len (n-nins n)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) len) (not (load ok)))
              (break)
              (do
                (let [d (n-in n (load i))]
                  (if (and (!= d NO-NODE) (ty-unanalysed? (n-ty d))) (set! ok false) 0))
                (set! i (+ (load i) 1))
                0)))
    (load ok)))

;; IS THIS TYPE PROVEN, OR MERELY THE OPTIMISTIC ANSWER SO FAR? Every irreversible rewrite has
;; to ask this and none of them may ask `n-inputs-analysed?` instead, because ONE INPUT DEEP IS
;; NOT DEEP ENOUGH. The answer is "every node in this node's input cone is at its type fixpoint",
;; and both halves of that (the whole cone, and fixpoint rather than merely analysed) were learned
;; from a miscompile that survived the weaker version.
;;
;; The reason it has to be transitive is `phi-compute`. That compute deliberately SKIPS every
;; region path whose control is still high, which is correct for an ANALYSIS (it gets revisited
;; when the control falls) and is load-bearing for loops: a loop phi has to be able to report its
;; entry value while the back edge is unanalysed, or the phi, the exit test and the back edge all
;; sit at ANY forever waiting on each other. The cost is that a Phi's type is provisional while
;; its own type is LOW and its inputs' types are low too, so provisionality does not show up
;; anywhere a one-level check can see it:
;;
;;   if (p) x = 1; else { if (q) x = true; else x = true; }  return x + 0;
;;
;; The outer Phi momentarily reports `int=1` because the inner merge is unanalysed and that path
;; is skipped. Its own inputs are all typed, so `n-inputs-analysed?` passed, and the Add folded
;; to `Const int=1`. The Phi's final type is `bool|int` and `true + 0` is a type error, but the
;; Add was already gone. The same provisional read defeated `ty-int-only?` in the five arithmetic
;; identities and `cast-idealize`'s discharge, which DELETES A TYPE CHECK.
;;
;; AND "ANALYSED" IS NOT THE SAME AS "AT A FIXPOINT". A stale LOW type is every bit as provisional
;; as ANY, and the first version of this predicate only looked for ANY, so a flat diamond still
;; miscompiled: `if (p) x = 8; else x = 0; return x + 1;` built raw became `return 1` on 10 of 40
;; seeds. The phi met `int=0` with an as-yet-unanalysed `8` (ANY is the identity for meet, so the
;; phi reported `int=0`), the `8` was analysed a moment later, and the Add was popped before the
;; phi could be revisited: at that instant nothing in the cone was ANY, yet the phi's stored type
;; was one worklist step out of date.
;;
;; So the test is the FIXPOINT CONDITION ITSELF, asked of every node in the cone: does its stored
;; type still equal what its compute says? A node's type is a function of its input cone alone, so
;; a cone that is internally at a fixpoint cannot move, and a conclusion drawn from those types is
;; a conclusion about the finished program. (Being on the worklist is the wrong proxy for this:
;; `iterate!` sweeps by pushing every live node, so "pending" would be true of everything.)
;;
;; A later REWRITE can still narrow a type in the cone (dropping a dead region path removes an arm
;; from a Phi, which is the type RISE `n-set-ty-falling!`'s comment allows across `iterate!`). That
;; is sound to have acted on: the settled type was an over-approximation, and a rise only makes it
;; more specific, so a constant folded from it is still that constant.
;;
;; Cost is one input-cone walk per query, with the mark array and the stack reused across calls.
;; Cycles (a loop phi's back edge) are handled by the generation stamp: a node already visited in
;; this walk is skipped, so the walk terminates and the cycle is not itself a reason to answer no.
(defn n-proven-grow! [] (-> i64)
  (let [p (graph)
        need (n-count)]
    (loop (if (>= (al-len [i64] (.pmark p)) need)
              (break)
              (do (al-push! [i64] (field p pmark) 0) 0)))
    0))

;; SETTLED MEANS AT A FIXPOINT, and ANY is a fixpoint like any other -- but only once the analysis
;; has actually run. Those are two different states that both spell ANY, and conflating them is what
;; made dead code IMMORTAL: a value inside a proven-dead region computes ANY forever (no path
;; reaches it, so it has no value), so every cone containing one was "unsettled", so
;; `n-in-proven-xctrl?` never proved anything, so the dead region was never dropped -- and the live
;; `Phi` merging it kept an ANY arm that instruction selection has no rule for.
;;
;; NO JAVASCRIPT LOOP COMPILED for this reason, together with `if-compute`'s ordering. A loop puts
;; the DSL's guards under a predicate that is unknown on the first pass, so a loop body always
;; contains proven-dead arms with ANY values in them; straight-line code rarely does.
;;
;; The `analysed` flag is what makes ANY safe to accept: DURING CONSTRUCTION every half-built node
;; is ANY and folding on that is the mistake `n-peephole` documents, so the flag is false until
;; `g-analyze!` has completed once.
(defn n-ty-settled? [(n i64)] (-> bool)
  (and (or (not (ty-unanalysed? (n-ty n)))
           (and (.analysed (graph)) (.provingctrl (graph))))
       (= (n-ty n) (n-compute n))))

;; Freeze the transitive proof answers used by one transformation sweep. At sweep entry no rewrite
;; has happened yet, so every answer describes the same graph snapshot. A false seed is a node
;; whose reported type is not a compute fixpoint (or is still ANY for value folding); false then
;; propagates through def-use edges. This computes the same greatest fixed point as walking every
;; candidate's entire input cone, including settled cycles, in O(nodes+edges) once per sweep.
;; Nodes created by the sweep are beyond the snapshot and deliberately fall back to the exact walk.
(defn n-proof-snapshot! [] (-> i64)
  (let [p (graph)
        count (n-count)
        was (g-verifying?)
        started (node-profile-now)
        (mut i) 0]
    (al-clear! [bool] (field p pvalueproof))
    (al-clear! [bool] (field p pctrlproof))
    (al-clear! [i64] (field p pstack))
    (g-set-verifying! true)
    (loop (if (>= (load i) count)
              (break)
              (do
                (let [n (load i)
                      fixed (or (n-dead? n) (= (n-ty n) (n-compute n)))
                      value-ok (and fixed (or (n-dead? n) (not (ty-unanalysed? (n-ty n)))))]
                  (al-push! [bool] (field p pvalueproof) value-ok)
                  (al-push! [bool] (field p pctrlproof) fixed)
                  (if (and (not (n-dead? n)) (not value-ok))
                      (do
                        (set! (.prof-proof-snapshot-seeds p) (+ (.prof-proof-snapshot-seeds p) 1))
                        (al-push! [i64] (field p pstack) n)
                        0)
                      0))
                (set! i (+ (load i) 1)))))
    ;; Value-proof failures include every control-proof failure, so propagate them together first.
    (loop (let [depth (al-len [i64] (.pstack p))]
            (if (= depth 0)
                (break)
                (let [n (al-get (.pstack p) (- depth 1))]
                  (al-pop! [i64] (field p pstack))
                  (let [len (n-nouts n)
                        (mut j) 0]
                    (loop (if (>= (load j) len)
                              (break)
                              (do
                                (let [use (n-out n (load j))]
                                  (set! (.prof-proof-snapshot-edges p) (+ (.prof-proof-snapshot-edges p) 1))
                                  (if (and (not (n-dead? use)) (al-get (.pvalueproof p) use))
                                      (do
                                        (al-set! [bool] (field p pvalueproof) use false)
                                        (al-push! [i64] (field p pstack) use)
                                        0)
                                      0))
                                (set! j (+ (load j) 1))))))))))
    ;; Control proof accepts settled ANY after analysis, so seed and propagate only non-fixpoints.
    (set! i 0)
    (loop (if (>= (load i) count)
              (break)
              (do
                (if (and (not (n-dead? (load i))) (not (al-get (.pctrlproof p) (load i))))
                    (al-push! [i64] (field p pstack) (load i))
                    0)
                (set! i (+ (load i) 1)))))
    (loop (let [depth (al-len [i64] (.pstack p))]
            (if (= depth 0)
                (break)
                (let [n (al-get (.pstack p) (- depth 1))]
                  (al-pop! [i64] (field p pstack))
                  (let [len (n-nouts n)
                        (mut j) 0]
                    (loop (if (>= (load j) len)
                              (break)
                              (do
                                (let [use (n-out n (load j))]
                                  (set! (.prof-proof-snapshot-edges p) (+ (.prof-proof-snapshot-edges p) 1))
                                  (if (and (not (n-dead? use)) (al-get (.pctrlproof p) use))
                                      (do
                                        (al-set! [bool] (field p pctrlproof) use false)
                                        (al-push! [i64] (field p pstack) use)
                                        0)
                                      0))
                                (set! j (+ (load j) 1))))))))))
    (g-set-verifying! was)
    (set! (.psnapshot p) true)
    (set! (.prof-proof-snapshot-calls p) (+ (.prof-proof-snapshot-calls p) 1))
    (set! (.prof-proof-snapshot-ns p)
          (+ (.prof-proof-snapshot-ns p) (- (node-profile-now) started)))
    0))

(defn n-proof-snapshot-clear! [] (-> i64)
  (set! (.psnapshot (graph)) false)
  0)

(defn n-ty-proven? [(n i64)] (-> bool)
  (let [p (graph)
        was (g-verifying?)
        (mut visits) 0]
    (set! (.prof-proof-calls p) (+ (.prof-proof-calls p) 1))
    (if (and (.psnapshot p) (< n (al-len [bool] (.pvalueproof p))))
        (if (.provingctrl p) (al-get (.pctrlproof p) n) (al-get (.pvalueproof p) n))
        (do
    (let [started (node-profile-now)]
    ; The mark array and the stack are ONE buffer shared by every call, so a walk inside a walk would
    ; silently truncate the outer one and answer "proven" for a cone it never finished looking at.
    ; Nothing reentrant calls this today (`n-compute` below never asks for a proof), and a named abort
    ; is what keeps that true rather than remembered.
    (if (.pbusy p)
        (do (panic-corrupt "n-ty-proven?: reentrant input-cone walk; the mark and stack buffers are shared") 0)
        0)
    (set! (.pbusy p) true)
    (n-proven-grow!)
    (set! (.pgen p) (+ (.pgen p) 1))
    ; Recomputing types is what this does, and `phi-compute` records a dependency as a side
    ; effect. The same flag `g-verify` uses keeps a guard from being observable in later results.
    (g-set-verifying! true)
    (let [gen (.pgen p)
          (mut ok) true]
      (al-clear! [i64] (field p pstack))
      (al-push! [i64] (field p pstack) n)
      (loop (let [depth (al-len [i64] (.pstack p))]
              (if (or (not (load ok)) (= depth 0))
                  (break)
                  (let [m (al-get (.pstack p) (- depth 1))]
                    (al-pop! [i64] (field p pstack))
                    (if (= (al-get (.pmark p) m) gen)
                        0
                        (do
                          (set! visits (+ (load visits) 1))
                          (al-set! [i64] (field p pmark) m gen)
                          (if (not (n-ty-settled? m))
                              (set! ok false)
                              (let [len (n-nins m)
                                    (mut i) 0]
                                (loop (if (>= (load i) len)
                                          (break)
                                          (do
                                            (let [d (n-in m (load i))]
                                              (if (!= d NO-NODE)
                                                  (do (al-push! [i64] (field p pstack) d) 0)
                                                  0))
                                            (set! i (+ (load i) 1))
                                            0)))
                                0))
                          0))))))
      (g-set-verifying! was)
      (set! (.pbusy p) false)
      (set! (.prof-proof-visits p) (+ (.prof-proof-visits p) (load visits)))
      (if (> (load visits) (.prof-proof-max p)) (set! (.prof-proof-max p) (load visits)) 0)
      (set! (.prof-proof-ns p) (+ (.prof-proof-ns p) (- (node-profile-now) started)))
      (load ok)))))))

(defn g-profile-peeps [] (-> i64) (.prof-peeps (graph)))
(defn g-profile-compute-ns [] (-> i64) (.prof-compute-ns (graph)))
(defn g-profile-proof-ns [] (-> i64) (.prof-proof-ns (graph)))
(defn g-profile-proof-calls [] (-> i64) (.prof-proof-calls (graph)))
(defn g-profile-proof-snapshot-ns [] (-> i64) (.prof-proof-snapshot-ns (graph)))
(defn g-profile-proof-snapshot-calls [] (-> i64) (.prof-proof-snapshot-calls (graph)))
(defn g-profile-proof-snapshot-seeds [] (-> i64) (.prof-proof-snapshot-seeds (graph)))
(defn g-profile-proof-snapshot-edges [] (-> i64) (.prof-proof-snapshot-edges (graph)))
(defn g-profile-proof-visits [] (-> i64) (.prof-proof-visits (graph)))
(defn g-profile-proof-max [] (-> i64) (.prof-proof-max (graph)))
(defn g-profile-idealize-ns [] (-> i64) (.prof-idealize-ns (graph)))
(defn g-profile-gvn-ns [] (-> i64) (.prof-gvn-ns (graph)))
(defn g-profile-analyze-pops [] (-> i64) (.prof-analyze-pops (graph)))
(defn g-profile-fold-scans [] (-> i64) (.prof-fold-scans (graph)))
(defn g-profile-fold-candidates [] (-> i64) (.prof-fold-candidates (graph)))
(defn g-profile-iterate-live-scans [] (-> i64) (.prof-iterate-live-scans (graph)))
(defn g-profile-iterate-pops [] (-> i64) (.prof-iterate-pops (graph)))
(defn g-profile-iterate-sweeps [] (-> i64) (.prof-iterate-sweeps (graph)))

;; PROVEN dead, not merely reported dead. `= (t-xctrl)` alone is not proof: XCtrl is the HIGH
;; element of the control axis, so meet(~ctrl, anything reachable) is `ctrl` and a node reporting
;; `~ctrl` may still fall to `ctrl` later. It is proof only once nothing its type depends on is
;; unanalysed. Every rewrite that deletes a control path goes through here.
;; PROVING A CONTROL ARM DEAD IS NOT PROVING A VALUE CONSTANT, and the flag is what tells
;; `n-ty-settled?` which one it is answering. Accepting a fixpoint at ANY is necessary here --
;; without it no dead region is ever removable, because dead regions are full of ANY values that
;; will never be anything else -- and WRONG for the constant fold, where it let a loop's carried
;; phi be replaced by its entry value while the loop was still being built.
(defn n-in-proven-xctrl? [(n i64) (i i64)] (-> bool)
  (and (= (n-in-ty n i) (t-xctrl))
       (let [p (graph)
             was (.provingctrl p)]
         (set! (.provingctrl p) true)
         (let [answer (n-ty-proven? (n-in n i))]
           (set! (.provingctrl p) was)
           answer))))

(defn n-const [(t i64)] (-> i64)
  (n-peephole (n-new1 (Const t) (g-start))))

;; Recompute the type, fold to a constant if the type says the value is known, idealize, then
;; value-number. Returns the node to use from here on, which may not be `n`.
(defn n-peephole [(n i64)] (-> i64)
  (if (n-dead? n)
      n
      (do
        (set! (.prof-peeps (graph)) (+ (.prof-peeps (graph)) 1))
        ; Canonical operand order for commutative ops, FIRST. It is what lets value numbering
        ; see `a+b` and `b+a` as one node, and it means every identity rule below only has to
        ; handle the constant-on-the-right form.
        (if (and (op-commutes? (n-op n)) (should-swap? n)) (n-swap-args! n) 0)
        (let [compute-started (node-profile-now)
              t (n-compute n)]
          (set! (.prof-compute-ns (graph)) (+ (.prof-compute-ns (graph)) (- (node-profile-now) compute-started)))
          (if (!= t (n-ty n))
              (do (n-set-ty! n t) (wl-push-outs! n) (n-move-deps! n) (g-changed!) 0)
              0)
          ;; ANALYSIS versus TRANSFORMATION again, and this was the third place it bit. Replacing a
          ;; node by a constant is irreversible, so the constant answer has to be final, not
          ;; provisional. An input still at ANY has not been analysed yet: around a loop, the phi
          ;; is momentarily `int=0` because its back-edge value has no type yet, and folding there
          ;; turns the induction variable into its initial value and deletes the loop. `t` being a
          ;; constant is not enough on its own; see `n-ty-proven?` for why the test is transitive
          ;; and why it asks for a fixpoint rather than only for "not ANY".
          ;; A singleton function SET is constant as an analysis fact (one possible target), not
          ;; as a runtime JavaScript value. A Cast refining a heap-loaded callable must therefore
          ;; retain that value; replacing it with `Const fun#N` discards function/closure identity.
          ;; A `Box` IS NOT FOLDABLE TO A CONSTANT, for the same reason a function set is not: its
          ;; result is a TAGGED WORD and a `Const` is a raw immediate, so replacing one with the
          ;; other deletes the very operation it exists to perform. `undefined` is where this shows:
          ;; `Box(Const undefined)` has a constant type -- there is only one undefined -- so it
          ;; folded, and a `Phi` merging it with a boxed string then held a raw immediate on one arm
          ;; and a tagged word on the other. `String(v.at(99))` printed one character where node
          ;; prints "undefined", and nothing in the compiler objected, because both arms were
          ;; individually well-typed. DSL-OWNERSHIP records the same trap for `box-compute`'s type;
          ;; this is the transformation half of it.
          (if (and (and (and (op-foldable? (n-op n)) (ty-const? t))
                        (and (= (& (ty-kinds t) VK-FUN) 0)
                             (not (op-value-is? (n-op n) Box [_]))))
                   (n-ty-proven? n))
              (let [c (n-new1 (Const t) (g-start))]
                (n-set-ty! c t)
                (let [c2 (gvn! c)]
                  (if (!= c2 c) (do (n-kill! c) 0) 0)
                  (n-keep! c2)
                  (n-subsume! n c2)
                  (n-unkeep! c2)
                  (g-changed!)
                  c2))
              (let [idealize-started (node-profile-now)
                    m (if (op-idealizable? (n-op n)) (n-idealize n) NO-NODE)]
                (set! (.prof-idealize-ns (graph)) (+ (.prof-idealize-ns (graph)) (- (node-profile-now) idealize-started)))
                (if (and (!= m NO-NODE) (!= m n))
                    (do (n-keep! m) (n-subsume! n m) (n-unkeep! m) (g-changed!) (n-peephole m))
                    (let [gvn-started (node-profile-now)
                          ;; A nonzero structural hash can only have been computed by this node's
                          ;; prior GVN lookup. Every supported input rewrite and operand swap
                          ;; clears it, so an unchanged node is already canonical and need not
                          ;; repeat the same hash-table probe on every whole-graph fold sweep.
                          e (if (and (op-gvn? (n-op n)) (= (.hash (nd n)) 0))
                                (gvn! n)
                                n)]
                      (set! (.prof-gvn-ns (graph)) (+ (.prof-gvn-ns (graph)) (- (node-profile-now) gvn-started)))
                      (if (!= e n)
                          (do (n-keep! e) (n-subsume! n e) (n-unkeep! e) (g-changed!) e)
                          n)))))))))

;; How many peepholes actually changed something. `iterate!` compares it across a sweep, so it
;; has to count every kind of change: a type falling, a fold, an idealize, a GVN replacement.
(defn g-changes [] (-> i64)
  (.nchg (graph)))
(defn g-changed! [] (-> i64)
  (set! (.nchg (graph)) (+ (.nchg (graph)) 1))
  0)

;; WHAT THE TWO MEMORY REWRITES ACTUALLY DID, counted by the engine rather than inferred from the
;; graph afterwards. Each is bumped from exactly ONE line: the branch of `load-idealize` that hands
;; back a stored value, and the branch of `store-idealize` that rewires past a dead store. Nothing
;; else may bump them, because the whole point is that a gate can compare them to a number it
;; derived independently and have a MISMATCH mean something.
;;
;; `g-verify` never runs `idealize` (see verify.coil: asking whether a node could be idealized
;; means rewriting it), so verification cannot inflate either count. `g-analyze!` does not run it
;; either. The only producer is `n-peephole`.
(defn g-forwards [] (-> i64)
  (.nfwd (graph)))
(defn g-store-elims [] (-> i64)
  (.nselim (graph)))
(defn g-forwarded! [] (-> i64)
  (set! (.nfwd (graph)) (+ (.nfwd (graph)) 1))
  0)
(defn g-store-elim! [] (-> i64)
  (set! (.nselim (graph)) (+ (.nselim (graph)) 1))
  0)
(defn g-dead-allocation! [] (-> i64)
  (set! (.ndalloc (graph)) (+ (.ndalloc (graph)) 1))
  0)

(defn wl-push-live! [] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i)) 0 (wl-push! (load i)))
                (set! i (+ (load i) 1))
                0)))
    0))

(defn wl-drain! [] (-> i64)
  (let [(mut steps) 0]
    (loop (let [n (wl-pop!)]
            (if (= n NO-NODE)
                (break)
                (do
                  (if (n-dead? n) 0 (do (n-peephole n) 0))
                  (set! (.prof-iterate-pops (graph)) (+ (.prof-iterate-pops (graph)) 1))
                  (set! steps (+ (load steps) 1))
                  ; a runaway worklist is a bug in a peephole, not something to grind on
                  (if (> (load steps) 10000000)
                      (do (panic-corrupt "iterate!: worklist did not converge") 0)
                      0)
                  0))))
    (load steps)))

;; Run peepholes to a fixpoint. Order comes from the seed; the result must not.
;;
;; IT SWEEPS, and it has to, because a rewrite may now be DEFERRED rather than declined. Any
;; rewrite that needs a proven type (`n-ty-proven?`) is refused while the input cone is still
;; settling, and nothing re-queues the node afterwards: the blocker's type may never change
;; again, so neither `wl-push-outs!` nor the deps list will bring the node back. Draining the
;; worklist once therefore reached a fixpoint of "what could be proven at the time", which is a
;; function of the pop order, and `1 + 2*3` stayed unfolded on some seeds.
;;
;; So: drain, and if that drain changed anything, put every live node back and drain again. A
;; sweep that changes nothing is the fixpoint. Each round needs the previous round to have made
;; progress, and progress is monotone (types only fall, nodes only die), so this terminates.
(defn iterate! [] (-> i64)
  (let [(mut steps) 0
        (mut sweeps) 0
        ;; `g-fold-proven-for-iterate!` leaves both a proof snapshot and the exact affected-node
        ;; worklist behind. Preserve that selective first drain. Standalone callers have no
        ;; snapshot and retain the original all-live seed; any changing selective drain also earns
        ;; the original all-live fallback sweep, so deferred proof rewrites remain order-independent.
        selective-first (.psnapshot (graph))]
    (loop (let [before (g-changes)]
            ;; The frontend's fold pass may hand off its final no-change snapshot. Standalone
            ;; iterate callers arrive with psnapshot clear and retain the original behavior.
            (if (not (.psnapshot (graph))) (n-proof-snapshot!) 0)
            (if (and selective-first (= (load sweeps) 0))
                0
                (do
                  (set! (.prof-iterate-live-scans (graph))
                        (+ (.prof-iterate-live-scans (graph)) (n-count)))
                  (wl-push-live!)
                  0))
            (set! steps (+ (load steps) (wl-drain!)))
            (n-proof-snapshot-clear!)
            (set! sweeps (+ (load sweeps) 1))
            (set! (.prof-iterate-sweeps (graph)) (+ (.prof-iterate-sweeps (graph)) 1))
            ; Each sweep needs the previous one to have changed something, and change is monotone
            ; (types only fall, nodes only die, GVN only merges), so this terminates. A cap anyway:
            ; two peepholes that undo each other would otherwise sweep for ever, and the per-drain
            ; step cap cannot see it because each drain on its own converges.
            (if (> (load sweeps) 10000)
                (do (panic-corrupt "iterate!: sweeps did not converge; two peepholes are undoing each other") 0)
                0)
            (if (= (g-changes) before) (break) 0)))
    (load steps)))

;; Types WITHOUT rewriting: recompute every node's type to a fixpoint and change no edges.
;; Two uses. It renders an honest "before" picture (raw construction leaves every type at ANY,
;; which tells you nothing about the analysis), and it is the shape the optimistic
;; interprocedural pass in M7 takes: seed high, propagate, never rewrite mid-flight.
;;
;; Termination rests on types only ever falling. M1 has no cycles in the graph at all; when
;; M2 introduces loop phis, widening at those phis is what keeps the int axis from creeping
;; forever. The step cap turns a non-converging compute into a named error, not a hang.
;;
;; TYPE MONOTONICITY, checked rather than assumed. "Every compute is monotone" is a claim about
;; a SEQUENCE of types and so cannot be seen in any single graph snapshot: the verifier can only
;; ever say the types are at a fixpoint. This is where it is observable, because `g-analyze!` is
;; the one phase that changes no edges, so every type it writes must be at or below the type it
;; replaces. A rise here means some `compute` is not monotone, which means the optimistic pass
;; in M7 would neither terminate nor be sound, and it is worth an abort naming both types.
;;
;; It is deliberately NOT asserted across `iterate!`, where a type legitimately RISES: dropping
;; a dead path from a Region removes an arm from every Phi on it, and a phi that loses its widest
;; arm reports a MORE specific type than before. Asserting there would be asserting something
;; false.
(defn n-set-ty-falling! [(n i64) (t i64)] (-> i64)
  (let [p (graph)
        old (n-ty n)]
    (set! (.achecks p) (+ (.achecks p) 1))
    (if (ty-falls? old t)
        0
        (do
          (let [w (stderr)]
            (ps w "type monotonicity violated at n")
            (fmt w "{d} ({s}): " n (op-name (n-op n)))
            (ty-print w old)
            (ps w " rose to ")
            (ty-print w t)
            (ps w "\n"))
          (panic-corrupt "g-analyze!: a node's type rose; some compute is not monotone")
          0))
    (n-set-ty! n t)))

;; How many falling-type checks the last `g-analyze!` performed. A gate that only asserted "no
;; violation" would pass just as well with the assertion deleted, so the count is exported and
;; the gate can require the check to have actually run.
(defn g-analyze-checks [] (-> i64)
  (.achecks (graph)))

;; FOLD WHAT ANALYSIS DECIDED.
;;
;; `g-analyze!` only ever calls `n-compute`. That is deliberate — it is the optimistic pass, and
;; rewriting during it would act on provisional types. But nothing ran afterwards to USE what it
;; proved, so a node the fixpoint decided was a constant stayed a node.
;;
;; The case that made this matter: `text.indexOf(needle)` lowers through `Clamp 0 0 (%StringLen s)`,
;; whose result is a Phi that analysis proves is exactly 0. Left as a Phi it stays pinned to its
;; Region inside the loop, so the pure, loop-invariant `%StringIndexOf` consuming it cannot be
;; hoisted and re-scans the haystack on every iteration — 3.8ms against 79.4ms on
;; benchmarks/typescript-aot/string-loop.ts.
;;
;; This is D8-compliant by construction rather than by promise: `n-peephole` already refuses to fold
;; anything whose type is not PROVEN, so running it after the fixpoint rewrites only what the
;; fixpoint settled. Before the fixpoint the same call folds nothing.
;; SWEEPS, for the reason `iterate!` states at length: one pass in index order is a fixpoint of
;; "what happened to be foldable when this index came up", which is a function of the traversal
;; order and not of the program. A peephole at index j can collapse a region that a phi at index
;; i < j is attached to, and that phi is never looked at again -- it survives as a one-armed phi on
;; a control node that is not a merge, which `phi-idealize` would have folded on sight and which
;; `v-check-phi` rejects as VERR-PHI-REGION. A zero-trip `while` after a call produced exactly
;; that. Progress is monotone (types only fall, nodes only die), so this terminates; the round cap
;; is a backstop against a non-monotone peephole rather than an expected exit.
(defn g-fold-proven-core! [(retain-final-snapshot bool)] (-> i64)
  (let [(mut rounds) 0
        (mut changed) true]
    (loop (if (not (load changed))
              (break)
              (do
                (set! changed false)
                ;; In the frontend handoff, retain one analysis snapshot through all monotone
                ;; folding rounds and the immediately following iterate drain. Rewrites only narrow
                ;; types or retire nodes, so a proof that was true at sweep entry remains sound;
                ;; newly created nodes already fall back to the exact cone walk. Standalone folding
                ;; rebuilds per round so it can discover newly true proofs without another analysis.
                (if (not (.psnapshot (graph))) (n-proof-snapshot!) 0)
                (let [(mut i) 0]
                  (loop (if (>= (load i) (n-count))
                            (break)
                            (do (set! (.prof-fold-scans (graph)) (+ (.prof-fold-scans (graph)) 1))
                                (if (or (n-dead? (load i))
                                        ;; Analysis has just brought every node's type to a
                                        ;; fixpoint. On the seed round only operations that can
                                        ;; actually rewrite need a peephole visit; immutable
                                        ;; Arg/Const/runtime nodes still enter later through the
                                        ;; worklist if an earlier rewrite changes one of their
                                        ;; inputs and type propagation is then required.
                                        (and (= (load rounds) 0)
                                             (and (not (wl-on? (load i)))
                                                  (and (not (and (op-foldable? (n-op (load i)))
                                                                 (ty-const? (n-ty (load i)))))
                                                       (and (not (and (op-idealizable? (n-op (load i)))
                                                                      (or (not (op-is? (load i) CProj [_]))
                                                                          (cproj-seed-may-idealize? (load i)))))
                                                            (or (not (op-gvn? (n-op (load i))))
                                                                (!= (.hash (nd (load i))) 0))))))
                                        ;; The first ordered round seeds every operation. Rewrites
                                        ;; queue every dependent that can change; retain that queue
                                        ;; membership through later ascending rounds so an affected
                                        ;; node may fold repeatedly without rescanning unrelated
                                        ;; graph nodes. `iterate!` drains it after this handoff.
                                        (and retain-final-snapshot
                                             (and (> (load rounds) 0)
                                                  (not (wl-on? (load i))))))
                                    0
                                    (let [candidate (load i)]
                                      (set! (.prof-fold-candidates (graph)) (+ (.prof-fold-candidates (graph)) 1))
                                      (let [r (n-peephole candidate)]
                                        (if (or (!= r candidate) (n-dead? candidate))
                                            (set! changed true)
                                            0))))
                                (set! i (+ (load i) 1))
                                0))))
                ;; Standalone folding rebuilds so later rounds can discover newly true proofs. The
                ;; frontend deliberately retains its sound entry proofs through monotone rewrites
                ;; and hands them to the immediately following iterate drain.
                (if (not retain-final-snapshot) (n-proof-snapshot-clear!) 0)
                (set! rounds (+ (load rounds) 1))
                (if (> (load rounds) 1000)
                    (do (panic-corrupt "g-fold-proven!: folding did not converge") 0)
                    0)
                0)))
    (load rounds)))

(defn g-fold-proven! [] (-> i64)
  (g-fold-proven-core! false))

(defn g-fold-proven-for-iterate! [] (-> i64)
  (g-fold-proven-core! true))

(defn g-analyze! [] (-> i64)
  (set! (.achecks (graph)) 0)
  (wl-push-live!)
  (let [(mut steps) 0]
    (loop (let [n (wl-pop!)]
            (if (= n NO-NODE)
                (break)
                (do
                  (if (n-dead? n)
                      0
                      (let [t (n-compute n)]
                        ; DEPS MUST BE FLUSHED HERE TOO. `n-peephole` calls `n-move-deps!` on a type
                        ; change and this loop did not, so every dependency `phi-compute` records was
                        ; recorded and never acted on: the mechanism was inert in exactly the phase
                        ; documented as the shape M7's optimistic pass takes.
                        ; AND THE NODE ITSELF, not only its outs. A Loop phi's `compute` reads the
                        ; phi's OWN current type -- `ty-widen-from` takes its fuel from `(n-ty n)`,
                        ; which is the whole reason the widening terminates -- so the node's type is
                        ; an input to its own computation. Re-queueing only the OUTS meant a loop
                        ; phi advanced its widening by exactly one step per visit and was then never
                        ; looked at again, and the pass returned with `n-compute` still disagreeing
                        ; with `n-ty`: `verify` reported VERR-STALE-TYPE, and the type it left
                        ; behind was NARROWER than the truth, which is the miscompile direction.
                        ; Running `g-analyze!` twice by hand converged, which is what named the bug.
                        ; This terminates for the same reason the widening does: TY-WIDEN-MAX bounds
                        ; the number of times a phi can change its own type.
                        (if (!= t (n-ty n))
                            (do (n-set-ty-falling! n t)
                                (wl-push! n)
                                (wl-push-outs! n)
                                (n-move-deps! n)
                                0)
                            0)))
                  (set! steps (+ (load steps) 1))
                  (set! (.prof-analyze-pops (graph)) (+ (.prof-analyze-pops (graph)) 1))
                  (if (> (load steps) 10000000)
                      (do (panic-corrupt "g-analyze!: types did not reach a fixpoint") 0)
                      0)
                  0))))
    (set! (.analysed (graph)) true)
    (load steps)))

;; Whole-world optimistic inference. Resetting every live node to lattice TOP is intentional: the
;; pass discovers only flows that originate in this compilation unit. `infer-parm-compute` and
;; `infer-call-compute` register the non-local dependencies they inspect, so changing a target,
;; argument, capture, or return value requeues the affected interprocedural node.
(defn g-infer! [] (-> i64)
  (let [p (graph)
        lim (n-count)
        (mut i) 0]
    (set! (.infer p) true)
    (loop (if (>= (load i) lim)
              (break)
              (do
                (if (n-dead? (load i)) 0 (n-set-ty! (load i) (t-top)))
                (set! i (+ (load i) 1))
                0)))
    (g-analyze!)))

(defn g-inference-mode? [] (-> bool)
  (.infer (graph)))

(defn g-call-graph-edges [] (-> i64)
  (let [lim (n-count)
        (mut i) 0
        (mut edges) 0]
    (loop (if (>= (load i) lim)
              (break)
              (do
                (let [call (load i)]
                  (if (or (n-dead? call) (not (op-is? call Call [_])))
                      0
                      (set! edges
                            (+ (load edges)
                               (if (!= (infer-direct-callee-fun call) NO-NODE)
                                   1
                                   (popcount64 (ty-fun-targets (n-in-ty call 1))))))))
                (set! i (+ (load i) 1))
                0)))
    (load edges)))

; ============================================================================
; Reachability, for the leak check
; ============================================================================
(defn n-reachable-mark [(n i64) (seen (ptr (ArrayList bool)))] (-> i64)
  ; Reachability is part of verification and must not dereference a malformed root or input.
  ; Earlier structural passes own the diagnostic; this pass only counts otherwise-live leaks.
  (if (or (< n 0) (>= n (n-count)))
      0
      (if (al-get (load seen) n)
      0
      (do
        (al-set! [bool] seen n true)
        (let [(mut i) 0]
          (loop (if (>= (load i) (n-nins n))
                    (break)
                    (do
                      (let [d (n-in n (load i))]
                        (if (!= d NO-NODE) (do (n-reachable-mark d seen) 0) 0))
                      (set! i (+ (load i) 1))
                      0))))
        0))))

;; Every node that is neither reachable from Stop nor from Start must be dead. A live node
;; nobody can reach is a leak, and the arena would grow forever across a real compile.
;; A DEAD LOOP IS NOT DEAD CODE UNTIL SOMETHING SAYS SO. `n-kill!` refuses a node that still has
;; users, and every node in a loop's Phi cycle has one -- the next node in the cycle. So a loop
;; whose result nobody reads stays live, unreachable from every root, and `v-pass-leaks` reports it
;; as a leak: `"abcdef".toLowerCase()` compared only against `undefined` folds the comparison away
;; and leaves `lib/string/case.jsl`'s whole loop with no consumer, and the program does not compile.
;;
;; The sweep breaks the cycles first -- detach every input of every unreachable node, which drops
;; the uses that were only holding each other up -- and then kills them.
;;
;; IT REFUSES TO RUN ON ANYTHING WITH AN EFFECT. A memory-typed node, a `Call`, a `New` or a throw
;; that is unreachable means something is wrong with the graph rather than merely unused, and
;; deleting it would delete an observable effect. In that case the sweep does nothing and the leak
;; check reports exactly what it reports today. Ordinary memory effects never reach here anyway:
;; they are reachable through the memory chain that ends at the `Return`.
;; A FUNCTION NOTHING CALLS IS NOT PART OF THIS PROGRAM, and until this pass it stayed in the graph
;; anyway. `mu-build-program!` builds EVERY live `Fun` -- deliberately, because a callable whose
;; identity escapes only as a value has no direct call edge and the universal dispatcher can still
;; land on it -- so an uncalled function is selected, scheduled, register-allocated and emitted.
;;
;; IT BECAME REACHABLE THE DAY A `lib/` MACRO STARTED NAMING A `builtin`. `ToStringValue` tests
;; `%IsArray` and hands the array case to `ArrayToStringValue`, and `ToStringValue` is inlined into
;; `JsAdd` -- so `n + 1` pulled the join builtin's `Fun` into its graph, the `ArrayTest` folded to
;; false, the `Call` died with the arm, and the FUNCTION remained: an extra machine function in the
;; object, extra register pressure, and a graph that no longer rendered the same.
;;
;; WHAT COUNTS AS REFERENCED IS REACHABILITY FROM THE PROGRAM'S ROOTS, not the absence of a `Call`.
;; A function whose identity is stored in a field, captured by a closure or merged in a `Phi` is
;; reachable from `Stop` through that value, and dropping it would delete a target the dynamic
;; dispatcher can still land on. Following inputs from `Start` and `Stop` answers both questions at
;; once: a `Call` names its `Fun` as an input, and so does every other consumer of a function value.
;;
;; It refuses to run rather than kill a node something outside the doomed functions still uses --
;; the same conservatism `g-sweep-unreachable!` applies, for the same reason.
(defn g-kill-uncalled-functions! [] (-> i64)
  (let [n (n-count)
        (mut reached) (al-new [bool] (malloc-allocator))
        (mut doomed) (al-new [bool] (malloc-allocator))
        (mut i) 0
        (mut killed) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [bool] (mut reached) false)
                  (al-push! [bool] (mut doomed) false)
                  (set! i (+ (load i) 1))
                  0)))
    (n-reachable-mark (g-stop) (mut reached))
    (n-reachable-mark (g-start) (mut reached))
    ;; Everything a function nobody reached can see. A `Fun` that only another doomed function names
    ;; is doomed too, and this loop finds it without a fixpoint: neither is reachable from the roots,
    ;; so each is its own starting point.
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (op-is? (load i) Fun [_]) (not (al-get (load reached) (load i)))))
                    (n-reachable-mark (load i) (mut doomed))
                    0)
                (set! i (+ (load i) 1))
                0)))
    ;; A `Parm` points AT its function rather than being an input of it, so it is never found by
    ;; the walk above and has to be added by name.
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (op-is? (load i) Parm [_])
                              (and (> (n-nins (load i)) 0)
                                   (and (!= (n-in (load i) 0) NO-NODE)
                                        (al-get (load doomed) (n-in (load i) 0))))))
                    (al-set! [bool] (mut doomed) (load i) true)
                    0)
                (set! i (+ (load i) 1))
                0)))
    (let [(mut safe) true]
      (set! i 0)
      (loop (if (>= (load i) n)
                (break)
                (do
                  (if (and (not (n-dead? (load i)))
                           (and (al-get (load doomed) (load i))
                                (al-get (load reached) (load i))))
                      ;; Shared with the program: a string constant or a type the entry also names.
                      ;; Not doomed at all, and not a reason to refuse -- just not ours to kill.
                      (al-set! [bool] (mut doomed) (load i) false)
                      0)
                  (set! i (+ (load i) 1))
                  0)))
      ;; Nothing outside the doomed set may still be reading from inside it.
      (set! i 0)
      (loop (if (or (>= (load i) n) (not (load safe)))
                (break)
                (do
                  (if (and (not (n-dead? (load i))) (al-get (load doomed) (load i)))
                      (let [(mut k) 0]
                        (loop (if (or (>= (load k) (n-nouts (load i))) (not (load safe)))
                                  (break)
                                  (do
                                    (let [u (n-out (load i) (load k))]
                                      (if (or (n-dead? u) (al-get (load doomed) u))
                                          0
                                          (set! safe false)))
                                    (set! k (+ (load k) 1))
                                    0))))
                      0)
                  (set! i (+ (load i) 1))
                  0)))
      (if (not (load safe))
          0
          (do
            ;; UNPIN FIRST. A `Parm` is pinned for its whole life -- `jl-bind!` keeps it, and the
            ;; pin is deliberate: a function's arity is read off its `Parm` nodes, so a parameter
            ;; the body never mentions must survive every fold. That reason expires with the
            ;; function. Lowering is finished by the time this runs, so nothing else is holding it.
            (set! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (if (and (not (n-dead? (load i))) (al-get (load doomed) (load i)))
                            (loop (if (<= (n-keeps (load i)) 0) (break) (n-unkeep! (load i))))
                            0)
                        (set! i (+ (load i) 1))
                        0)))
            ;; Break every edge first, then collect. `n-kill!` refuses a node that still has users,
            ;; and a function body is full of cycles -- the loop Phis, and the `Fun`/`Return` pair
            ;; itself.
            (set! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (if (and (not (n-dead? (load i))) (al-get (load doomed) (load i)))
                            (let [(mut k) 0]
                              (loop (if (>= (load k) (n-nins (load i)))
                                        (break)
                                        (do (if (!= (n-in (load i) (load k)) NO-NODE)
                                                (do (n-set-def! (load i) (load k) NO-NODE) 0)
                                                0)
                                            (set! k (+ (load k) 1))
                                            0))))
                            0)
                        (set! i (+ (load i) 1))
                        0)))
            (set! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (if (and (not (n-dead? (load i)))
                                 (and (al-get (load doomed) (load i))
                                      (= (n-nouts (load i)) 0)))
                            (do (n-kill! (load i)) (set! killed (+ (load killed) 1)) 0)
                            0)
                        (set! i (+ (load i) 1))
                        0)))
            0)))
    (al-free! [bool] (mut reached))
    (al-free! [bool] (mut doomed))
    (load killed)))

(defn g-sweep-unreachable! [] (-> i64)
  (let [n (n-count)
        (mut seen) (al-new [bool] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [bool] (mut seen) false) (set! i (+ (load i) 1)) 0)))
    (n-reachable-mark (g-stop) (mut seen))
    (n-reachable-mark (g-start) (mut seen))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (or (op-is? (load i) Fun [_])
                             (op-is? (load i) Parm [_])))
                    (n-reachable-mark (load i) (mut seen))
                    0)
                (set! i (+ (load i) 1))
                0)))
    ;; Is every unreachable node safe to delete?
    (let [(mut safe) true]
      (set! i 0)
      (loop (if (>= (load i) n)
                (break)
                (do
                  (if (and (not (n-dead? (load i)))
                           (and (not (al-get (load seen) (load i)))
                                (or (ty-mem? (n-ty (load i)))
                                    (or (op-is? (load i) Call [_])
                                        (or (op-is? (load i) New [_])
                                            (or (op-is? (load i) JsThrow [])
                                                (> (n-keeps (load i)) 0)))))))
                      (set! safe false)
                      0)
                  (set! i (+ (load i) 1))
                  0)))
      (if (not (load safe))
          (do (al-free! [bool] (mut seen)) 0)
          (do
            ;; break the cycles, then collect the corpses
            (set! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (if (and (not (n-dead? (load i))) (not (al-get (load seen) (load i))))
                            (let [(mut k) 0]
                              (loop (if (>= (load k) (n-nins (load i)))
                                        (break)
                                        (do (if (!= (n-in (load i) (load k)) NO-NODE)
                                                (do (n-set-def! (load i) (load k) NO-NODE) 0)
                                                0)
                                            (set! k (+ (load k) 1))
                                            0))))
                            0)
                        (set! i (+ (load i) 1))
                        0)))
            (set! i 0)
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (if (and (not (n-dead? (load i)))
                                 (and (not (al-get (load seen) (load i)))
                                      (= (n-nouts (load i)) 0)))
                            (do (n-kill! (load i)) 0)
                            0)
                        (set! i (+ (load i) 1))
                        0)))
            (al-free! [bool] (mut seen))
            0)))
    0))

(defn g-leaked-count [] (-> i64)
  (let [n (n-count)
        (mut seen) (al-new [bool] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [bool] (mut seen) false) (set! i (+ (load i) 1)) 0)))
    (n-reachable-mark (g-stop) (mut seen))
    (n-reachable-mark (g-start) (mut seen))
    ; Closed-world function definitions are linker roots. A specialization may prove every local
    ; call takes its clone while the generic version must still be emitted as the fallback entry
    ; for other compilation-unit callers.
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i))) (op-is? (load i) Fun [_]))
                    (n-reachable-mark (load i) (mut seen))
                    0)
                (set! i (+ (load i) 1))
                0)))
    ;; Parm nodes are ABI declarations and point toward their Fun rather than being inputs of it.
    ;; A parameter can therefore be intentionally unread by the body while its ordinal must remain
    ;; present for callers and closure environments. Treat parameters of live functions as roots.
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (and (not (n-dead? (load i)))
                         (and (op-is? (load i) Parm [_])
                              (and (> (n-nins (load i)) 0)
                                   (op-is? (n-in (load i) 0) Fun [_]))))
                    (n-reachable-mark (load i) (mut seen))
                    0)
                (set! i (+ (load i) 1))
                0)))
    (let [(mut j) 0
          (mut leaked) 0]
      (loop (if (>= (load j) n)
                (break)
                (do
                  (if (and (not (n-dead? (load j))) (not (al-get (load seen) (load j))))
                      (do
                        ;; The graph dump renders only reachable nodes, so a leak is otherwise
                        ;; invisible in every failure artifact. Name it.
                        (let [w (stderr)
                              (mut in) 0]
                          (fmt w "LEAK n{d}:{s} <-" (load j) (op-name (n-op (load j))))
                          (loop (if (>= (load in) (n-nins (load j)))
                                    (break)
                                    (do
                                      (fmt w " n{d}" (n-in (load j) (load in)))
                                      (set! in (+ (load in) 1))
                                      0)))
                          (fmt w "\n"))
                        (set! leaked (+ (load leaked) 1))
                        0)
                      0)
                  (set! j (+ (load j) 1))
                  0)))
      (al-free! [bool] (mut seen))
      (load leaked))))

(defn g-live-count [] (-> i64)
  (let [n (n-count)
        (mut i) 0
        (mut live) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i)) 0 (set! live (+ (load live) 1)))
                (set! i (+ (load i) 1))
                0)))
    (load live)))

; ============================================================================
; Printing
; ============================================================================
;; Expression form recurses through DATA only. Control nodes and Phis print as a reference
;; (`Region7`, `phi9`), because a loop phi can reach itself through its own back edge and an
;; expression printer that followed that would not terminate. Once a program has control flow,
;; the flat form below is the readable one and the Graphviz dump is better still.
(defn cproj-label [(n i64)] (-> (slice u8))
  (let [m (n-in n 0)]
    (if (and (!= m NO-NODE) (match (n-op m) (If [] true) (_ false)))
        (match (n-op n) (CProj [slot] (if (= slot 0) "True" "False")) (_ "CProj"))
        "CProj")))

(defn n-print [(w (ptr Writer)) (n i64)] (-> i64)
  (if (= n NO-NODE)
      (ps w "_")
      (if (n-dead? n)
          (ps w "DEAD")
          (match (n-op n)
            (Start [] (ps w "Start"))
            (Stop [] (stop-print w n))
            (Return [] (do (ps w "return ") (n-print w (n-in n 1)) (ps w ";") 0))
            (XCtrl [] (ps w "#dead"))
            (If [] (do (ps w "if(") (n-print w (n-in n 1)) (ps w ")") 0))
            (CProj [slot] (do (ps w (cproj-label n)) (fmt w "{d}" n) 0))
            (Region [] (do (ps w "Region") (fmt w "{d}" n) 0))
            (Loop [] (do (ps w "Loop") (fmt w "{d}" n) 0))
            (Phi [declared] (do (ps w "phi") (fmt w "{d}" n) 0))
            (Proj [slot] (do (fmt w "n{d}.{d}" (n-proj-source n) slot) 0))
            (Cast [target] (do
                  (ps w "(")
                  (ty-print w target)
                  (ps w ")")
                  (n-print w (n-in n 1))
                  0))
            (Box [mode] (do (ps w "box(") (n-print w (n-in n 1)) (ps w ")") 0))
            (Unbox [target] (do
                  (ps w "unbox<")
                  (ty-print w target)
                  (ps w ">(")
                  (n-print w (n-in n 1))
                  (ps w ")")
                  0))
            (TypeTest [target] (do
                  (ps w "is<")
                  (ty-print w target)
                  (ps w ">(")
                  (n-print w (n-in n 1))
                  (ps w ")")
                  0))
            (Fun [index] (do (fmt w "fun#{d}" index) 0))
            (Parm [index] (do (fmt w "parm{d}" index) 0))
            (Call [abi] (do
                  (n-print w (n-in n 1))
                  (ps w "(")
                  (let [(mut i) 2]
                    (loop (if (>= (load i) (n-nins n))
                              (break)
                              (do
                                (if (> (load i) 2) (ps w ",") 0)
                                (n-print w (n-in n (load i)))
                                (set! i (+ (load i) 1))
                                0))))
                  (ps w ")")
                  0))
            (CallEnd [] (do (ps w "CallEnd") (fmt w "{d}" n) 0))
            (Const [ty] (ty-print w (n-ty n)))
            (Arg [ty] (ps w "arg"))
            (Add [] (binop-print w n "+"))
            (Sub [] (binop-print w n "-"))
            (Mul [] (binop-print w n "*"))
            (Div [] (binop-print w n "/"))
            (Minus [] (do (ps w "(-") (n-print w (n-in n 1)) (ps w ")") 0))
            (Not [] (do (ps w "(!") (n-print w (n-in n 1)) (ps w ")") 0))
            (Eq [] (binop-print w n "=="))
            (Lt [] (binop-print w n "<"))
            (Le [] (binop-print w n "<="))
            (Mod [] (binop-print w n "%"))
            (BitAnd [] (binop-print w n "&"))
            (BitOr [] (binop-print w n "|"))
            (BitXor [] (binop-print w n "^"))
            (Shl [] (binop-print w n "<<"))
            (Shr [] (binop-print w n ">>"))
            (UShr [] (binop-print w n ">>>"))
            (BitNot [] (do (ps w "(~") (n-print w (n-in n 1)) (ps w ")") 0))
                ;; A LOAD IS AN EXPRESSION AND A MEMORY STATE IS NOT, which is the whole of the
                ;; convention here. `o.x` is what the source said and it recurses into the pointer like
                ;; any other operand; a New, a Store and a MemMerge are states, and a state printed
                ;; inline would read as though the program had a value there. They print as references
                ;; with their id, exactly as a Region and a Phi do and for the same reason: the flat form
                ;; and the diagram are where a state's edges are legible.
            (Load [alias] (do (n-print w (n-in n 2)) (ps w ".") (field-print w alias) 0))
            (Store [alias] (do (ps w "st") (fmt w "{d}" n) 0))
            (New [shape] (do (ps w "new") (fmt w "{d}#{d}" n shape) 0))
            (MemMerge [] (do (ps w "mem") (fmt w "{d}" n) 0))
            (_ (do (ps w (op-name (n-op n))) 0))))))

;; An alias printed as the FIELD NAME it introduced. The number is in the flat form and in the
;; type; a reader of an expression wants `o.x`.
(defn field-print [(w (ptr Writer)) (alias i64)] (-> i64)
  (if (shape-alias-defined? alias)
      (do (print-str w (shape-name-bytes (shape-alias-name alias))) 0)
      ; a printer is observation: an alias with no edge is exactly what you want to see
      (do (ps w "a") (fmt w "{d}?" alias) 0)))

(defn binop-print [(w (ptr Writer)) (n i64) (sym (slice u8))] (-> i64)
  (ps w "(")
  (n-print w (n-in n 1))
  (ps w sym)
  (n-print w (n-in n 2))
  (ps w ")"))

(defn stop-print [(w (ptr Writer)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (n-nins n))
              (break)
              (do
                (if (> (load i) 0) (ps w " ") 0)
                (n-print w (n-in n (load i)))
                (set! i (+ (load i) 1))
                0))))
  0)

;; Flat form, one line per live node, for when the expression form hides the bug: it shows
;; ids, types and every edge.
(defn n-print-flat [(w (ptr Writer)) (n i64)] (-> i64)
  (if (or (< n 0) (or (>= n (n-count)) (n-dead? n)))
      0
      (do
        (fmt w "n{d}: " n)
        (ps w (op-name (n-op n)))
        (match (n-op n)
          (CProj [label] (do (fmt w ".{d}" label) 0))
          (Proj [slot] (do (fmt w ".{d}" slot) 0))
          (Cast [target] (do (ps w " to ") (ty-print w target) 0))
          (New [shape] (do (fmt w "#{d}" shape) 0))
          (Load [alias] (do (fmt w "#{d}" alias) 0))
          (Store [alias] (do (fmt w "#{d}" alias) 0))
          (PropLoad [name] (do (fmt w "@{d}" name) 0))
          (PropStore [name] (do (fmt w "@{d}" name) 0))
          (_ 0))
        (ps w " : ")
        (ty-print w (n-ty n))
        (ps w "  <-")
        (let [(mut k) 0]
          (loop (if (>= (load k) (n-nins n))
                    (break)
                    (do
                      (let [d (n-in n (load k))]
                        (if (= d NO-NODE) (ps w " _") (do (fmt w " n{d}" d) 0)))
                      (set! k (+ (load k) 1)))))
        (ps w "\n")
        0))))

(defn g-print-flat [(w (ptr Writer))] (-> i64)
  (let [n (n-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (n-dead? (load i)) 0 (n-print-flat w (load i)))
                (set! i (+ (load i) 1))
                0))))
  0)

;; Render a node to a caller-owned buffer, so tests can compare printed IR as a string.
(defn n-render [(n i64) (buf (ptr i8)) (cap i64)] (-> (slice u8))
  (let [fb (primitive/alloc-stack FixBuf)
        w (primitive/alloc-stack Writer)]
    (set! (.data fb) buf)
    (set! (.cap fb) cap)
    (set! (.len fb) 0)
    (fixed-buffer-writer w fb)
    (n-print w n)
    (slice-new [u8] (cast (ptr u8) buf) (.len fb))))

; ============================================================================
; Dominators and the loop tree
; ============================================================================
;; Every consumer of this is later: global code motion needs dominators to place a node in its
;; shallowest legal block and loop nesting to weigh blocks, loop optimisation needs the tree, and
;; the never-exit-loop rewrite needs both. It is built now because it is small, because the
;; visualizer can annotate nesting depth immediately, and because dominators computed against a
;; stale CFG are a classic source of scheduling bugs that only appear under optimisation.
;;
;; There is NO incremental maintenance. `g-build-loop-tree!` computes both tables, and reading
;; either one after a control edge changed is a hard error rather than a wrong answer.

;; A CFG node's control predecessors live in a half-open input range that depends on its op: a
;; merge's paths start at 1, Stop's returns start at 0, and everything else has exactly input 0.
(defn n-cpred-lo [(n i64)] (-> i64)
  (if (op-merge? (n-op n)) 1 0))
(defn n-cpred-hi [(n i64)] (-> i64)
  (if (op-merge? (n-op n))
      (n-nins n)
      (if (op-is? n Stop [])
          (n-nins n)
          (if (or (op-is? n Start []) (op-is? n XCtrl []))
              0
              1))))

(defn g-idep-raw [(n i64)] (-> i64)
  (al-get (.idep (graph)) n))

(defn g-dom-fresh? [] (-> bool)
  (let [p (graph)] (= (.domver p) (.cfgver p))))

(defn g-dom-check-fresh [] (-> i64)
  (if (g-dom-fresh?)
      0
      (do (panic-corrupt "dominator tables are stale: call g-build-loop-tree! after changing control edges") 0)))

;; Both tables describe CONTROL nodes. A data node has no dominator depth and no loop membership
;; until a scheduler assigns it one, so asking is a caller bug rather than a question with a
;; harmless default answer.
(defn g-dom-check-cfg [(n i64)] (-> i64)
  (if (op-control? (n-op n))
      0
      (do (panic-corrupt "idepth/loop-depth asked of a non-control node") 0)))

(defn g-idepth [(n i64)] (-> i64)
  (g-dom-check-fresh)
  (g-dom-check-cfg n)
  (g-idep-raw n))
(defn g-loop-depth [(n i64)] (-> i64)
  (g-dom-check-fresh)
  (g-dom-check-cfg n)
  (al-get (.ldep (graph)) n))

;; The immediate dominator. A Loop is dominated by its ENTRY alone: the back edge does not
;; dominate the header, and counting it would neither terminate nor mean anything.
(defn n-idom [(n i64)] (-> i64)
  (match (n-op n)
    (Start [] NO-NODE)
    (XCtrl [] NO-NODE)
    (Loop [] (n-in n 1))
    (Region [] (cfg-lca-of-preds n))
    (Stop [] (cfg-lca-of-preds n))
    (_ (n-in n 0))))

;; Walk the deeper of the two up the dominator tree until they meet: the standard lowest common
;; ancestor, using idepth as the ranking.
(defn cfg-lca [(a i64) (b i64)] (-> i64)
  (if (= a NO-NODE)
      b
      (if (= b NO-NODE)
          a
          (let [(mut x) a
                (mut y) b]
            (loop (if (or (= (load x) (load y))
                          (or (= (load x) NO-NODE) (= (load y) NO-NODE)))
                      (break)
                      (let [dx (g-idep-raw (load x))
                            dy (g-idep-raw (load y))]
                        (if (>= dx dy) (set! x (n-idom (load x))) 0)
                        (if (<= dx dy) (set! y (n-idom (load y))) 0)
                        0)))
            (if (= (load x) (load y)) (load x) NO-NODE)))))

(defn cfg-lca-of-preds [(n i64)] (-> i64)
  (let [lo (n-cpred-lo n)
        hi (n-cpred-hi n)
        (mut acc) NO-NODE
        (mut i) lo]
    (loop (if (>= (load i) hi)
              (break)
              (do
                (let [d (n-in n (load i))]
                  ; a path that cannot be reached dominates nothing
                  (if (or (= d NO-NODE) (= (n-ty d) (t-xctrl)))
                      0
                      (set! acc (cfg-lca (load acc) d))))
                (set! i (+ (load i) 1))
                0)))
    (load acc)))

;; idepth by relaxation to a fixpoint. Start is 0; every other CFG node is one deeper than its
;; deepest reachable predecessor. Excluding a Loop's back edge is what makes the dependency
;; graph acyclic, so this converges.
(defn g-compute-idepth! [] (-> i64)
  (let [p (graph)
        n (n-count)
        (mut i) 0]
    (al-clear! [i64] (field p idep))
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [i64] (field p idep) -1) (set! i (+ (load i) 1)) 0)))
    (al-set! [i64] (field p idep) (g-start) 0)
    (let [(mut changed) true
          (mut rounds) 0]
      (loop (if (not (load changed))
                (break)
                (do
                  (set! changed false)
                  (set! rounds (+ (load rounds) 1))
                  (if (> (load rounds) (+ n 2))
                      (do (panic-corrupt "idepth did not converge") 0)
                      0)
                  (let [(mut k) 0]
                    (loop (if (>= (load k) n)
                              (break)
                              (do
                                (if (or (n-dead? (load k)) (not (op-control? (n-op (load k)))))
                                    0
                                    (if (= (load k) (g-start))
                                        0
                                        (let [d (idepth-of-preds (load k))]
                                          (if (and (!= d -1) (!= d (g-idep-raw (load k))))
                                              (do
                                                (al-set! [i64] (field p idep) (load k) d)
                                                (set! changed true)
                                                0)
                                              0))))
                                (set! k (+ (load k) 1))
                                0))))
                  0))))
    0))

;; One deeper than the deepest predecessor that actually dominates. A Loop consults its entry
;; only; anything with no known predecessor yet reports -1 so relaxation revisits it.
(defn idepth-of-preds [(n i64)] (-> i64)
  (if (op-is? n Loop [])
      (let [e (n-in n 1)]
        (if (= e NO-NODE) -1 (let [d (g-idep-raw e)] (if (= d -1) -1 (+ d 1)))))
      (let [lo (n-cpred-lo n)
            hi (n-cpred-hi n)
            (mut best) -1
            (mut i) lo]
        (loop (if (>= (load i) hi)
                  (break)
                  (do
                    (let [d (n-in n (load i))]
                      (if (or (= d NO-NODE) (= (n-ty d) (t-xctrl)))
                          0
                          (let [dd (g-idep-raw d)]
                            (if (and (!= dd -1) (> (+ dd 1) (load best)))
                                (set! best (+ dd 1))
                                0))))
                    (set! i (+ (load i) 1))
                    0)))
        (load best))))

;; Natural loop bodies. For a Loop header L whose back edge comes from B, the body is L together
;; with every CFG node that reaches B without passing through L. Each node's loop depth is the
;; number of bodies containing it, which for reducible control flow is exactly its nesting.
(defn g-compute-loop-depth! [] (-> i64)
  (let [p (graph)
        n (n-count)
        (mut i) 0]
    (al-clear! [i64] (field p ldep))
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [i64] (field p ldep) 0) (set! i (+ (load i) 1)) 0)))
    (let [(mut h) 0]
      (loop (if (>= (load h) n)
                (break)
                (do
                  (if (and (not (n-dead? (load h))) (op-is? (load h) Loop []))
                      (mark-loop-body! (load h))
                      0)
                  (set! h (+ (load h) 1))
                  0))))
    0))

(defn mark-loop-body! [(header i64)] (-> i64)
  (let [p (graph)
        n (n-count)
        (mut seen) (al-new [bool] (malloc-allocator))
        (mut stack) (al-new [i64] (malloc-allocator))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! [bool] (mut seen) false) (set! i (+ (load i) 1)) 0)))
    ; the header is in its own body, and the walk stops there
    (al-set! [bool] (mut seen) header true)
    (al-set! [i64] (field p ldep) header (+ (al-get (.ldep p) header) 1))
    (let [back (if (>= (n-nins header) 3) (n-in header 2) NO-NODE)]
      (if (!= back NO-NODE) (do (al-push! [i64] (mut stack) back) 0) 0))
    (loop (if (= (al-len [i64] (load stack)) 0)
              (break)
              (let [k (al-get (load stack) (- (al-len [i64] (load stack)) 1))]
                (al-pop! [i64] (mut stack))
                (if (or (al-get (load seen) k) (n-dead? k))
                    0
                    (do
                      (al-set! [bool] (mut seen) k true)
                      (al-set! [i64] (field p ldep) k (+ (al-get (.ldep p) k) 1))
                      (let [lo (n-cpred-lo k)
                            hi (n-cpred-hi k)
                            (mut j) lo]
                        (loop (if (>= (load j) hi)
                                  (break)
                                  (do
                                    (let [d (n-in k (load j))]
                                      (if (= d NO-NODE) 0 (do (al-push! [i64] (mut stack) d) 0)))
                                    (set! j (+ (load j) 1))
                                    0))))
                      0))
                0)))
    (al-free! [bool] (mut seen))
    (al-free! [i64] (mut stack))
    0))

(defn g-build-loop-tree! [] (-> i64)
  (g-compute-idepth!)
  (g-compute-loop-depth!)
  (set! (.domver (graph)) (.cfgver (graph)))
  0)
