;; Exact two-argument Function helper shape used by Test262's property helpers. General Function
;; binding still requires an argument-count channel in the native ABI; these definitions are real
;; callable values rather than syntax rewrites and compose through ordinary dynamic dispatch.
(callable FunctionCall2 :transitioning true
  :params [(thisArg dyn) (arg0 dyn)] :ret dyn
  (call-dynamic-with-receiver this thisArg arg0))

(callable ArrayJoin1 :transitioning true
  :params [(separator dyn)] :ret dyn
  (ArrayJoin this separator))

(callable ArrayPushMethod1 :transitioning true
  :params [(value dyn)] :ret dyn
  (%Box (ArrayPush1 this value)))

(callable BoundFunction2 :transitioning true :captures [target boundThis]
  :params [(arg0 dyn) (arg1 dyn)] :ret dyn
  (call-dynamic-with-receiver target boundThis arg0 arg1))

(callable FunctionBind1 :captures [] :params [(boundThis dyn)] :ret dyn
  (%Box (closure BoundFunction2 this boundThis)))

(builtin FunctionConstructorValue :params [] :ret dyn
  (let [(constructor (%ErrorConstructor 21))
        (prototype (BuiltinPrototypeValue 21))
        (callMethod (closure FunctionCall2))
        (prototypeStored
          (%PropStoreKey constructor (ToPropertyKey "prototype") (%Box prototype)))
        (constructorStored
          (%PropStoreKey prototype (ToPropertyKey "constructor") (%Box constructor)))
        (callStored (%PropStoreKey prototype (ToPropertyKey "call") (%Box callMethod)))
        (bindMethod (closure FunctionBind1))
        (bindStored (%PropStoreKey prototype (ToPropertyKey "bind") (%Box bindMethod)))]
    constructor))
