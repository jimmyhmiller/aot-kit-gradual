;; Fixed-length ArrayBuffer foundation. An ArrayBuffer is an ordinary object carrying opaque
;; internal slots: target is sparse byte storage, index is [[ArrayBufferByteLength]], and kind 105
;; is the brand. Unmaterialized sparse bytes are read as zero by typed-array operations. The byte
;; array is opaque and never represented by JavaScript properties.

(macro IsArrayBuffer :params [(value dyn)] :ret bool
  (HasInternalSlot value (InternalSlotArrayBufferData)))

(macro IsSharedArrayBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-issharedarraybuffer"
  :spec-name "IsSharedArrayBuffer"
  :status partial
  :deviation "Shared Data Blocks and SharedArrayBuffer objects are not represented; every represented fixed ArrayBuffer correctly returns false."
  :params [(object dyn)] :ret bool
  false)

(macro IsDetachedBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isdetachedbuffer"
  :spec-name "IsDetachedBuffer"
  :status partial
  :deviation "ArrayBuffer detachment is not yet implemented; represented allocated ArrayBuffers retain a non-null [[ArrayBufferData]] target and correctly return false."
  :params [(arrayBuffer dyn)] :ret bool
  (%IsNull (%InternalTarget arrayBuffer)))

(macro IsGrowableSharedArrayBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isgrowablesharedarraybuffer"
  :spec-name "IsGrowableSharedArrayBuffer"
  :status partial
  :deviation "SharedArrayBuffer and [[ArrayBufferByteLengthData]] representations are not implemented; represented fixed ArrayBuffers correctly return false."
  :params [(arrayBuffer dyn)] :ret bool
  (if (IsSharedArrayBuffer arrayBuffer)
      (HasInternalSlot arrayBuffer (InternalSlotArrayBufferByteLengthData))
      false))

(macro IsFixedLengthArrayBuffer
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-isfixedlengtharraybuffer"
  :spec-name "IsFixedLengthArrayBuffer"
  :status partial
  :deviation "Resizable and growable ArrayBuffer representations with [[ArrayBufferMaxByteLength]] are not implemented; represented fixed ArrayBuffers correctly return true."
  :params [(arrayBuffer dyn)] :ret bool
  true)

(macro ArrayBufferByteLength
  :spec "ecma262@ed463bc10dbeaad0410ce67e541a77ea8e9900a5#sec-arraybufferbytelength"
  :spec-name "ArrayBufferByteLength"
  :status partial
  :deviation "The growable SharedArrayBuffer atomic-length path and detached buffers are not represented; fixed non-shared ArrayBuffers return their canonical [[ArrayBufferByteLength]]."
  :params [(arrayBuffer dyn) (order int)] :ret dyn
  (if (IsGrowableSharedArrayBuffer arrayBuffer)
      (ThrowTypeError "Growable SharedArrayBuffer byte length is not represented")
      (if (IsDetachedBuffer arrayBuffer)
          (ThrowTypeError "ArrayBuffer is detached")
          (%Box (%InternalIndex arrayBuffer)))))

;; ToIndex owns ECMAScript conversion and validation. This helper owns only the fixed-length
;; implementation's smaller addressable storage range and raw machine-index representation.
(macro ToArrayBufferLength :transitioning true :params [(value dyn)] :ret int
  (let [(index (ToIndex value))]
    (if (%IsInt index)
        (let [(length (%UnboxInt index))]
          (if (%Lt length 0)
              (ThrowRangeError "Invalid array buffer length")
              (if (%Le length 2147483647)
                  length
                  (ThrowRangeError "Invalid array buffer length"))))
        (ThrowRangeError "Invalid array buffer length"))))

(macro NewArrayBuffer :transitioning true :params [(length int)] :ret dyn
  ;; Every allocation path must establish the realm intrinsic whose prototype it installs.
  ;; ConstructArrayBuffer already reaches ArrayBufferConstructorValue directly, but TypedArray
  ;; construction also allocates backing buffers through this operation. Without this dependency
  ;; those buffers carried the right internal slots and an uninitialized %ArrayBuffer.prototype%,
  ;; so an inherited `byteLength` read observed an absent data property instead of the accessor.
  (let [(intrinsics (ArrayBufferConstructorValue))
        (object (%Box (%NewObject)))
        (bytes (%BoxArray (%NewArray)))
        (sized (%ArrayResize bytes length object))
        (initialized (%InternalInit object bytes 105))
        (lengthInitialized (%InternalSetIndex object length))
        (prototype (SetObjectPrototype object (BuiltinPrototypeValue 25)))]
    object))

(macro ConstructArrayBuffer :transitioning true :params [(lengthValue dyn)] :ret dyn
  (let [(initialized (ArrayBufferConstructorValue))
        (length (ToArrayBufferLength lengthValue))]
    (NewArrayBuffer length)))

(callable ArrayBufferByteLengthGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (ArrayBufferByteLength this 0)))

(callable ArrayBufferIsView1 :params [(value dyn)] :ret dyn
  (%Box (IsTypedArray value)))

(callable ArrayBufferResizableGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (%Box (%Not (IsFixedLengthArrayBuffer this)))))

(callable ArrayBufferMaxByteLengthGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (ArrayBufferByteLength this 0)))

(callable ArrayBufferDetachedGetter0 :transitioning true :params [] :ret dyn
  (let [(required (RequireInternalSlot this (InternalSlotArrayBufferData)))]
    (%Box (IsDetachedBuffer this))))

(callable ArrayBufferSpeciesGetter0 :params [] :ret dyn this)

(macro InstallBuiltinGetter :params [(target dyn) (key dyn) (getter dyn) (name dyn)] :ret dyn
  (let [(getterLength (%DefinePropertyValue getter (ToPropertyKey "length") (%Box 0)))
        (getterLengthMarked (%SetPropertyAttributes getter (ToPropertyKey "length") 4))
        (getterName (%DefinePropertyValue getter (ToPropertyKey "name") name))
        (getterNameMarked (%SetPropertyAttributes getter (ToPropertyKey "name") 4))
        (stored (%DefinePropertyGetter target key getter))
        (setter (%DefinePropertySetter target key (%Box undefined)))
        (marked (%SetPropertyAttributes target key 12))]
    target))

(builtin ArrayBufferConstructorValue :transitioning true :params [] :ret dyn
  (let [(constructor (BuiltinConstructorValue 25))
        (prototype (BuiltinPrototypeValue 25))
        (lengthStored (%DefinePropertyValue constructor (ToPropertyKey "length") (%Box 1)))
        (lengthMarked (%SetPropertyAttributes constructor (ToPropertyKey "length") 4))
        (prototypeMarked (%SetPropertyAttributes constructor (ToPropertyKey "prototype") 0))
        (byteLengthGetter (%Box (closure ArrayBufferByteLengthGetter0)))
        (byteLengthInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "byteLength") byteLengthGetter
                                    (%Box "get byteLength")))
        (resizableGetter (%Box (closure ArrayBufferResizableGetter0)))
        (resizableInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "resizable") resizableGetter
                                    (%Box "get resizable")))
        (maxByteLengthGetter (%Box (closure ArrayBufferMaxByteLengthGetter0)))
        (maxByteLengthInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "maxByteLength") maxByteLengthGetter
                                    (%Box "get maxByteLength")))
        (detachedGetter (%Box (closure ArrayBufferDetachedGetter0)))
        (detachedInstalled
          (InstallBuiltinGetter prototype (ToPropertyKey "detached") detachedGetter
                                    (%Box "get detached")))
        (isView (%Box (closure ArrayBufferIsView1)))
        (isViewLength (%DefinePropertyValue isView (ToPropertyKey "length") (%Box 1)))
        (isViewLengthMarked (%SetPropertyAttributes isView (ToPropertyKey "length") 4))
        (isViewName (%DefinePropertyValue isView (ToPropertyKey "name") (%Box "isView")))
        (isViewNameMarked (%SetPropertyAttributes isView (ToPropertyKey "name") 4))
        (isViewStored (%DefinePropertyValue constructor (ToPropertyKey "isView") isView))
        (isViewMarked (%SetPropertyAttributes constructor (ToPropertyKey "isView") 5))
        (speciesKey (SymbolSpeciesValue))
        (speciesGetter (%Box (closure ArrayBufferSpeciesGetter0)))
        (speciesInstalled
          (InstallBuiltinGetter constructor speciesKey speciesGetter
                                    (%Box "get [Symbol.species]")))
        (toStringTagKey (SymbolToStringTagValue))
        (toStringTag (%DefinePropertyValue prototype toStringTagKey (%Box "ArrayBuffer")))
        (toStringTagMarked (%SetPropertyAttributes prototype toStringTagKey 4))]
    constructor))

(macro ThrowArrayBufferCall :transitioning true :params [] :ret dyn
  (ThrowTypeError "Constructor ArrayBuffer requires 'new'"))
