;; The abstract operations the language applies at operator and global-function boundaries, as
;; opposed to the methods in `lib/string/` and `lib/array/`.
;;
;; EVERY ENTRY IS A `macro`. Each is a single primitive plus a name, so a `builtin` would add a call
;; frame around one instruction and nothing else. That is the same split Torque draws, applied for
;; the same reason: a macro is the right shape for an operation the caller is EMITTING rather than
;; invoking. What the library contributes here is that the operation has one name and one spec
;; reference, not that it has an implementation the frontend lacked.

;; https://tc39.es/ecma262/#sec-tostring
;;
;; ToString of an OBJECT is ToPrimitive with hint string, which calls the object's `toString`, and
;; an array's is `Array.prototype.toString` -- `String([1, 2, 3])` is "1,2,3" and not
;; "[object Object]". The primitive cannot make that distinction on its own: it is handed a tagged
;; word and answers a formatting rule, where the array case is a JavaScript algorithm over the
;; elements. So the dispatch happens here, and `ArrayToStringValue` in lib/array/read.jsl is the
;; algorithm.
;;
;; `%Box` BEFORE `%IsArray`, because `v` arrives as whatever machine word the caller had: an array
;; is a RAW object pointer at most call sites and the tag test needs the tagged form. Boxing a value
;; that is already tagged is the identity, and where the analysis has proven `v` is a number the
;; whole test folds away and this is `%ToString` again.
(macro ToStringValue :params [(v dyn)] :ret dyn
  (if (%IsSymbol (%Box v))
      (ThrowTypeError "Cannot convert a Symbol value to a string")
      (if (%IsArray (%Box v))
      (ArrayToStringValue (%Box v) (%NewArray))
      (if (%IsObject (%Box v))
          (let [(kind (%InternalKind (%Box v)))]
            (if (%Eq kind 100)
                (%ToString (%InternalTarget (%Box v)))
                (if (%Eq kind 101)
                    (%ToString (%InternalTarget (%Box v)))
                    (%ToString v))))
          (%ToString v)))))

;; The same conversion CONTINUING an array walk already in progress, so the cycle stack it is
;; already carrying is the one an inner array is checked against. `ArrayJoinSeen` is the only
;; caller; `ToStringValue` above is the entry that starts a fresh stack.
(macro ToStringValueSeen :params [(v dyn) (seen dyn)] :ret str
  (if (%IsArray (%Box v))
      (%UnboxString (ArrayToStringValue (%Box v) seen))
      (%ToString v)))

;; https://tc39.es/ecma262/#sec-tonumber
;;
;; ONE NODE, NO BRANCH, AND THAT IS DELIBERATE. The frontend emits this at every dynamic arithmetic
;; operand, which includes operands inside functions other than the entry, and the guarded spelling
;; — `(if (IsNumber v) v (%ToNumber v))`, the spec's own steps 1 and 2 — puts a Region and a Phi
;; there. `tests/native-conformance/integrated-heap-program.ts` stopped compiling when it did:
;; `tree.value + sum(tree.left)` inside `sum` produced a `New` anchored at Start and selection
;; refused it with a dependency failure. `jsl-inline!` emitting control flow inside a non-entry
;; function is the underlying limitation; it is written up in HANDOFF.md.
;;
;; The guard is worth having back once that is fixed. It is what keeps the runtime call off the
;; numbers: unguarded, `call-loop` goes 9.6ms to 25.5ms and `math-loop` 73.3ms to 97.3ms.
(macro IsPrimitiveValue :params [(v dyn)] :ret bool
  (if (IsNumber v)
      true
      (if (%IsSymbol v)
          true
      (if (%IsString v)
          true
          (if (%IsUndefined v)
              true
              (if (%IsNull v) true (%IsBool v)))))))

;; https://tc39.es/ecma262/#sec-ordinarytoprimitive with hint Number. Wrapper slots return their
;; primitive values. Otherwise valueOf runs first, then toString, each with the object as receiver;
;; a non-primitive result advances to the next method. The runtime has no synthetic
;; Object.prototype methods, so when neither own method exists we compose their default outcome
;; directly: "[object Object]" converted to NaN.
(builtin OrdinaryToPrimitiveNumber :transitioning true :params [(v dyn)] :ret dyn
  (let [(kind (%InternalKind v))]
    (if (%Eq kind 100)
        (%InternalTarget v)
        (if (%Eq kind 101)
            (%InternalTarget v)
            (let [(valueOf (GetProperty v "valueOf"))]
              (if (%IsFunction valueOf)
                  (let [(value (call-dynamic-with-receiver valueOf v))]
                    (if (IsPrimitiveValue value)
                        value
                        (let [(toString (GetProperty v "toString"))]
                          (if (%IsFunction toString)
                              (let [(stringValue (call-dynamic-with-receiver toString v))]
                                (if (IsPrimitiveValue stringValue)
                                    stringValue
                                    (%Throw "TypeError: Cannot convert object to primitive value")))
                              (%ToNumber (%Box "[object Object]"))))))
                  (let [(toString (GetProperty v "toString"))]
                    (if (%IsFunction toString)
                        (let [(stringValue (call-dynamic-with-receiver toString v))]
                          (if (IsPrimitiveValue stringValue)
                              stringValue
                              (%Throw "TypeError: Cannot convert object to primitive value")))
                        (%ToNumber (%Box "[object Object]"))))))))))

(macro ToPrimitiveNumber :params [(v dyn)] :ret dyn
  ;; Primitive is both the overwhelmingly common path and the one static type information can
  ;; usually prove. Put it first so ordinary numeric/string arithmetic does not retain object-only
  ;; conversion calls in its graph.
  (if (IsPrimitiveValue v)
      v
      (if (%IsArray (%Box v))
          (ToStringValue (%Box v))
          (if (%IsFunction (%Box v))
              (%ToNumber (%Box "function () {}"))
              (OrdinaryToPrimitiveNumber (%Box v))))))

(macro ToNumberValue :params [(v dyn)] :ret dyn
  (if (%IsSymbol v)
      (ThrowTypeError "Cannot convert a Symbol value to a number")
      (if (IsNumber v)
      v
      (%ToNumber (ToPrimitiveNumber (%Box v))))))

;; https://tc39.es/ecma262/#sec-number-constructor and #sec-boolean-constructor. Wrapper state is
;; an internal slot, never an observable property. Kinds 100 and 101 are deliberately outside the
;; array-iterator kind range (0..2), while sharing the representation-owned InternalTarget seam.
(macro NewNumberObject :params [(v dyn)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (initialized (%InternalInit object (%Box (ToNumberValue v)) 100))
        (constructor (SetProperty object "constructor" (BuiltinConstructorValue 19)))]
    object))

(macro NewBooleanObject :params [(v dyn)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (initialized (%InternalInit object (%Box (ToBoolean v)) 101))
        (constructor (SetProperty object "constructor" (BuiltinConstructorValue 20)))]
    object))

(macro NewStringObject :params [(v dyn)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (initialized (%InternalInit object (%Box (ToStringValue v)) 102))
        (constructor (SetProperty object "constructor" (BuiltinConstructorValue 18)))]
    object))

(macro NewSymbolObject :params [(v dyn)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (initialized (%InternalInit object (%Box v) 103))
        (prototype (SetObjectPrototype object (BuiltinPrototypeValue 22)))]
    object))

;; https://tc39.es/ecma262/#sec-object-value. ToObject is JavaScript meaning, including the
;; identity result for existing objects and distinct wrapper allocation for primitive values.
(macro ObjectFromValue :params [(v dyn)] :ret dyn
  (let [(value (%Box v))]
    (if (%IsUndefined value)
        (InitializeOrdinaryObject (%Box (%NewObject)))
        (if (%IsNull value)
            (InitializeOrdinaryObject (%Box (%NewObject)))
            (if (IsNumber value)
                (NewNumberObject value)
                (if (%IsBool value)
                    (NewBooleanObject value)
                    (if (%IsString value)
                        (NewStringObject value)
                        (if (%IsSymbol value) (NewSymbolObject value) value))))))))

;; https://tc39.es/ecma262/#sec-parseint-string-radix
(macro ParseIntValue :params [(s dyn) (radix dyn)] :ret dyn (%ParseInt s radix))

;; https://tc39.es/ecma262/#sec-isnan-number — the GLOBAL isNaN, which coerces first and so differs
;; from Number.isNaN: `isNaN("12x")` is true where `Number.isNaN("12x")` is false, because the
;; global asks whether ToNumber of the argument is NaN and Number.isNaN asks whether the argument
;; already IS the NaN value. Keep the coercion composition here rather than relying on the
;; representation primitive's historical partial coercions.
(macro GlobalIsNaN :params [(v dyn)] :ret bool
  (%IsNaN (%Box (ToNumberValue v))))

;; https://tc39.es/ecma262/#sec-string.fromcharcode, for the single-argument case the frontend emits.
(macro StringFromCharCode :params [(c dyn)] :ret dyn (%StringFromCode c))

(macro NumberToStringValue :params [(value dyn) (radix dyn)] :ret dyn
  (%NumberToString value radix))

(macro ThrowValue :params [(value dyn)] :ret dyn (%Throw value))
