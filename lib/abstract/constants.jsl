;; The three non-finite doubles, as macros rather than primitives. JSL has no NaN or Infinity
;; literal and does not need one: IEEE division supplies all three exactly, they fold to constants
;; at lowering, and a macro costs no call.
(macro NaN         :params [] :ret dyn (%Div 0 0))
(macro Infinity    :params [] :ret dyn (%Div 1 0))
(macro MaxSafeInteger :params [] :ret flt 9007199254740991.0)
