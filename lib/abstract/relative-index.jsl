;; The index normalisation `String.prototype.at` and `Array.prototype.at` share
;; (https://tc39.es/ecma262/#sec-string.prototype.at steps 4-6): a negative index counts from the
;; end, and anything still out of range is a miss, reported as -1.
;; The index arrives as a JavaScript value and leaves as a machine integer, so the conversion and
;; the arithmetic are separated: `%ToInteger` first, unboxed once, then plain integer work.
;; A double from `%ToInteger` is an infinity or beyond 2^53, so it is out of range either way.
(macro RelativeIndex :params [(index dyn) (len int)] :ret int
  (let [(n (%ToInteger index))]
    (if (%IsInt n)
        (let [(k (%UnboxInt n))
              (rel (if (%Lt k 0) (%Add len k) k))]
          (if (%Lt rel 0) -1 (if (%Le len rel) -1 rel)))
        -1)))
