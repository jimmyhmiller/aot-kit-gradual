(macro GetNamedProperty :params [(object dyn) (name int)] :ret dyn
  (%PropLoadNamed object name))

(macro HasNamedProperty :params [(object dyn) (name int)] :ret bool
  (%PropHasNamed object name))

(macro OrdinaryHasInstance :params [(object dyn) (proto dyn)] :ret bool
  (%PrototypeHas object proto))

;; The ordinary (non-Symbol.hasInstance) path accepts a runtime constructor object. Keeping the
;; prototype lookup here makes `instanceof` use the same [[Get]] seam as every other property read.
(macro OrdinaryInstanceOf :params [(object dyn) (constructor dyn)] :ret bool
  (OrdinaryHasInstance object (GetProperty constructor "prototype")))

;; `instanceof` against the two globals this closed world has no value bindings for. Each is the
;; prototype-chain question specialised to a chain the runtime itself maintains: every object,
;; array and function terminates at Object.prototype, and only arrays at Array.prototype. (`Object.create(null)` breaks the first claim and is
;; unsupported here.) The frontend dispatches BY NAME only when the name resolves to no user
;; binding, so a shadowing `function Object(...)` still takes the ordinary path.
(macro InstanceOfObjectValue :params [(v dyn)] :ret bool
  (if (%IsObject v) true (if (%IsArray v) true (%IsFunction v))))
(macro InstanceOfArrayValue :params [(v dyn)] :ret bool (%IsArray v))

(macro SetObjectPrototype :params [(object dyn) (proto dyn)] :ret dyn
  (let [(ignored (%SetPrototype object proto))] object))

(macro SetNamedProperty :params [(object dyn) (name int) (value dyn)] :ret dyn
  (let [(ignored (%PropStoreNamed object name (%Box value)))] value))

(macro GetElement :params [(array dyn) (index int)] :ret dyn
  (%ArrayLoad array index))

(macro SetElement :params [(array dyn) (index int) (value dyn)] :ret dyn
  (let [(ignored (%ArrayStore array index (%Box value)))] value))

(macro ResizeArray :params [(array dyn) (length int) (dependency dyn)] :ret dyn
  (let [(ignored (%ArrayResize array length dependency))] array))

;; https://tc39.es/ecma262/#sec-topropertykey. Symbols become the second arm once the runtime has
;; its Symbol representation; all currently representable JavaScript keys canonicalize through
;; ToString and enter one content-based runtime key space.
(macro ToPropertyKey :params [(key dyn)] :ret dyn (ToStringValue (%Box key)))

(macro GetProperty :params [(object dyn) (key dyn)] :ret dyn
  (%PropLoadKey object (ToPropertyKey key)))

(macro SetProperty :params [(object dyn) (key dyn) (value dyn)] :ret dyn
  (let [(ignored (%PropStoreKey object (ToPropertyKey key) (%Box value)))] value))

(macro HasProperty :params [(object dyn) (key dyn)] :ret bool
  (%PropHasKey object (ToPropertyKey key)))

(macro DeleteProperty :params [(object dyn) (key dyn)] :ret bool
  (let [(propertyKey (ToPropertyKey key))]
    (if (%IsArray (%Box object))
        (if (StringEquals propertyKey "length")
            (%Throw "TypeError: Cannot delete property 'length' of Array")
            (let [(ignored (%PropDeleteKey object propertyKey))] true))
        (let [(ignored (%PropDeleteKey object propertyKey))] true))))
