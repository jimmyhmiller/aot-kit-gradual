          (if (%IsArray descriptor) true (%IsFunction descriptor)))
      (let [(accessor (if (%PropHasNamed descriptor "get") true
                          (%PropHasNamed descriptor "set")))]
        (if accessor
            (if (if (%PropHasNamed descriptor "value") true
                    (%PropHasNamed descriptor "writable"))
                false
                (if (if (%PropHasNamed descriptor "get")
                        (let [(getter (%PropLoadNamed descriptor "get"))]
                          (if (%IsUndefined getter) true (%IsFunction getter)))
                        true)
                    (if (%PropHasNamed descriptor "set")
                        (let [(setter (%PropLoadNamed descriptor "set"))]
                          (if (%IsUndefined setter) true (%IsFunction setter)))
                        true)
                    false))
            true))
      false))

