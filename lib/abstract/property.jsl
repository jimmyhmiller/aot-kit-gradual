                          (let [(enumerable (if (%PropHasNamed descriptor "enumerable")
                                                (if (ToBoolean (%PropLoadNamed descriptor "enumerable")) 2 0)
                                                (if exists (%BitAnd oldAttributes 2) 0)))
                                (configurable (if (%PropHasNamed descriptor "configurable")
                                                  (if (ToBoolean (%PropLoadNamed descriptor "configurable")) 4 0)
                                                  (if exists (%BitAnd oldAttributes 4) 0)))
