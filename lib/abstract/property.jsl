        (let [(index (TypedArrayIndex propertyKey))]
          (if (%Lt index 0)
              (OrdinaryGetProperty object propertyKey)
              (TypedArrayGet object index)))
        (OrdinaryGetProperty object propertyKey)))))

(macro OrdinarySetProperty :transitioning true
  :params [(object dyn) (propertyKey dyn) (value dyn)] :ret dyn
