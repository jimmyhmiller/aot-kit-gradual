(macro ResizeArray :params [(array dyn) (length int) (dependency dyn)] :ret dyn
  (let [(ignored (%ArrayResize array length dependency))] array))

;; ArraySetLength for a newly defined indexed own property. The property descriptor itself remains
;; in the ordinary key/component tables; this operation maintains the Array exotic's separate
;; length slot after those writes succeed. The current machine index range is narrower than
;; ECMAScript's full 32-bit Array-index range, and TypedArrayIndex is the shared canonical
;; nonnegative decimal-key parser for that supported range.
(macro MaintainArrayIndexLengthAfterDefine
  :params [(object dyn) (propertyKey dyn) (dependency dyn)] :ret dyn
  (if (%IsArray (%Box object))
      (let [(index (TypedArrayIndex propertyKey))]
        (if (%Lt index 0)
            object
            (let [(length (%ArrayLen object))]
              (if (%Lt index length)
                  object
                  (let [(resized (%ArrayResize object (%Add index 1) dependency))]
                    object)))))
      object))

