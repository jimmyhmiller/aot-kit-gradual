      object))

(macro SetNamedProperty :params [(object dyn) (name int) (value dyn)] :ret dyn
  (let [(ignored (%PropStoreNamed object name (%Box value)))] value))

;; ResolveBinding against the two components of this Realm's GlobalEnvironmentRecord. This is a
;; runtime operation: code created by one Script can be called after another Script has introduced
;; a binding. The frontend supplies only the identifier name and never decides JavaScript-visible
;; absence or exception behavior.
(macro GetGlobalBinding :params [(name dyn)] :ret dyn
  (if (HasProperty (GlobalDeclarativeEnvironmentValue) name)
      (GetProperty (GlobalDeclarativeEnvironmentValue) name)
      (if (HasProperty (GlobalObjectValue) name)
          (GetProperty (GlobalObjectValue) name)
          (ThrowReferenceError (%StringConcat name " is not defined")))))

;; `typeof IdentifierReference` uses ResolveBinding but suppresses ReferenceError only when that
;; resolution is unresolvable. Keep the presence decision beside GetGlobalBinding so the frontend
;; does not duplicate the Realm environment semantics.
(macro TypeOfGlobalBinding :params [(name dyn)] :ret str
  (if (HasProperty (GlobalDeclarativeEnvironmentValue) name)
      (TypeOfValue (%Box (GetProperty (GlobalDeclarativeEnvironmentValue) name)))
      (if (HasProperty (GlobalObjectValue) name)
          (TypeOfValue (%Box (GetProperty (GlobalObjectValue) name)))
          "undefined")))

(macro SetGlobalDeclarativeBinding :params [(name dyn) (value dyn)] :ret dyn
  (SetProperty (GlobalDeclarativeEnvironmentValue) name value))

;; PutValue for an unresolvable Reference. Strict code throws; sloppy code creates or updates the
;; named property on the Realm global object. The frontend supplies syntax-derived strictness and
;; never decides the JavaScript-visible branch itself.
(macro SetUnresolvableBinding :params [(name dyn) (value dyn) (strict bool)] :ret dyn
  (if strict
      (ThrowReferenceError (%StringConcat name " is not defined"))
      (SetProperty (GlobalObjectValue) name value)))

;; SetMutableBinding for an immutable declarative-environment binding. Named function/class
;; expressions use this for their private self name: the RHS is evaluated and remains the value of
;; the assignment expression, but sloppy PutValue does not replace the binding and strict PutValue
;; throws. The frontend identifies the lexical binding; JavaScript-visible behavior stays here.
(macro SetImmutableBinding :params [(value dyn) (strict bool)] :ret dyn
  (if strict
      (ThrowTypeError "Assignment to constant variable")
      value))

(macro GetElement :params [(array dyn) (index int)] :ret dyn
