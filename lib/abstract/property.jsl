(macro GetNamedProperty :params [(object dyn) (name int)] :ret dyn
  (%PropLoadNamed object name))

(macro HasNamedProperty :params [(object dyn) (name int)] :ret bool
  (%PropHasNamed object name))

(macro OrdinaryHasInstance :params [(object dyn) (proto dyn)] :ret bool
  (%PrototypeHas object proto))

(macro IsPrototypeOf :params [(prototype dyn) (object dyn)] :ret bool
  (OrdinaryHasInstance object prototype))

;; The ordinary (non-Symbol.hasInstance) path accepts a runtime constructor object. Keeping the
;; prototype lookup here makes `instanceof` use the same [[Get]] seam as every other property read.
(macro OrdinaryInstanceOf :params [(object dyn) (constructor dyn)] :ret bool
  (OrdinaryHasInstance object (GetProperty constructor "prototype")))

;; `instanceof` against the two globals this closed world has no value bindings for. Each is the
;; prototype-chain question specialised to a chain the runtime itself maintains: every object,
;; array and function terminates at Object.prototype, and only arrays at Array.prototype. (`Object.create(null)` breaks the first claim and is
;; unsupported here.) The frontend dispatches BY NAME only when the name resolves to no user
;; binding, so a shadowing `function Object(...)` still takes the ordinary path.
(macro InstanceOfObjectValue :params [(v dyn)] :ret bool
  (if (%IsObject v) true (if (%IsArray v) true (%IsFunction v))))
(macro InstanceOfArrayValue :params [(v dyn)] :ret bool (%IsArray v))

;; Built-in Error objects are allocated entirely by NewErrorObject and carry their constructor
;; identity as representation-visible state. The frontend uses this only for an unshadowed built-in
;; Error constructor; user constructors continue through OrdinaryInstanceOf and prototype chains.
(macro InstanceOfErrorValue :params [(v dyn) (constructor dyn)] :ret bool
  (StrictEqual (GetProperty v "constructor") constructor))

(macro SetObjectPrototype :params [(object dyn) (proto dyn)] :ret dyn
  (let [(ignored (%SetPrototype object proto))] object))

(macro InitializeOrdinaryObject :params [(object dyn)] :ret dyn
  (let [(linked (SetObjectPrototype object (BuiltinPrototypeValue 16)))]
    object))

(macro NewArgumentsObject :params [(length int)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (initialized (InitializeOrdinaryObject object))
        (stored (%PropStoreNamed object "length" (%Box length)))]
    object))

(macro SetNamedProperty :params [(object dyn) (name int) (value dyn)] :ret dyn
  (let [(ignored (%PropStoreNamed object name (%Box value)))] value))

(macro GetElement :params [(array dyn) (index int)] :ret dyn
  (%ArrayLoad array index))

(macro SetElement :params [(array dyn) (index int) (value dyn)] :ret dyn
  (let [(ignored (%ArrayStore array index (%Box value)))] value))

(macro ResizeArray :params [(array dyn) (length int) (dependency dyn)] :ret dyn
  (let [(ignored (%ArrayResize array length dependency))] array))

;; https://tc39.es/ecma262/#sec-topropertykey. Symbols become the second arm once the runtime has
;; its Symbol representation; all currently representable JavaScript keys canonicalize through
;; ToString and enter one content-based runtime key space.
(macro ToPropertyKey :params [(key dyn)] :ret dyn (ToStringValue (%Box key)))

(callable ObjectHasOwnProperty1 :transitioning true :params [(key dyn)] :ret dyn
  (%Box (HasOwnProperty this key)))

(callable ObjectPropertyIsEnumerable1 :transitioning true :params [(key dyn)] :ret dyn
  (%Box (PropertyIsEnumerable this key)))

(macro GetProperty :transitioning true :params [(object dyn) (key dyn)] :ret dyn
  (let [(propertyKey (ToPropertyKey key))
        (attributes (%PropertyAttributes object propertyKey))]
    ;; `-1` means no property was found. Its low bits are all set, so testing the accessor bit
    ;; alone mistakes every missing property for an accessor. Reads still happen to answer
    ;; undefined, but writes become silent no-ops because the nonexistent setter is undefined.
    (if (%Lt attributes 0)
        (if (%IsFunction object)
            (if (StringEquals propertyKey "bind")
                (%Box (closure FunctionBind1))
                (if (StringEquals propertyKey "call")
                    (%Box (closure FunctionCall2))
                    (%PropLoadKey object propertyKey)))
            (if (StrictEqual object (BuiltinPrototypeValue 16))
                (if (StringEquals propertyKey "hasOwnProperty")
                    (%Box (closure ObjectHasOwnProperty1))
                    (if (StringEquals propertyKey "propertyIsEnumerable")
                        (%Box (closure ObjectPropertyIsEnumerable1))
                        (%PropLoadKey object propertyKey)))
                (if (StrictEqual object (BuiltinPrototypeValue 17))
                    (if (StringEquals propertyKey "join")
                        (%Box (closure ArrayJoin1))
                        (if (StringEquals propertyKey "push")
                            (%Box (closure ArrayPushMethod1))
                            (%PropLoadKey object propertyKey)))
                    (if (StrictEqual object (BuiltinPrototypeValue 18))
                        (if (StringEquals propertyKey "indexOf")
                            (let [(function (%Box (closure StringIndexOfMethod2)))
                                  (lengthKey (ToPropertyKey "length"))
                                  (nameKey (ToPropertyKey "name"))
                                  (lengthStored (%DefinePropertyValue function lengthKey (%Box 1)))
                                  (lengthMarked (%SetPropertyAttributes function lengthKey 4))
                                  (nameStored (%DefinePropertyValue function nameKey (%Box "indexOf")))
                                  (nameMarked (%SetPropertyAttributes function nameKey 4))]
                              function)
                            (%PropLoadKey object propertyKey))
                        (%PropLoadKey object propertyKey)))))
        (if (%Eq (%BitAnd attributes 8) 0)
            (%PropLoadKey object propertyKey)
            (let [(getter (%PropertyGetter object propertyKey))]
              (if (%IsFunction getter)
                  (call-dynamic-with-receiver getter object)
                  (%Box undefined)))))))

(macro SetProperty :transitioning true :params [(object dyn) (key dyn) (value dyn)] :ret dyn
  (let [(propertyKey (ToPropertyKey key))
        (attributes (%PropertyAttributes object propertyKey))]
    (if (%Lt attributes 0)
        (let [(ignored (%PropStoreKey object propertyKey (%Box value)))] value)
        (if (%Eq (%BitAnd attributes 8) 0)
            (if (%Eq (%BitAnd attributes 1) 0)
                value
                (let [(ignored (%PropStoreKey object propertyKey (%Box value)))] value))
            (let [(setter (%PropertySetter object propertyKey))]
              (if (%IsFunction setter)
                  (let [(ignored (call-dynamic-with-receiver setter object (%Box value)))] value)
                  value))))))

(macro HasProperty :params [(object dyn) (key dyn)] :ret bool
  (%PropHasKey object (ToPropertyKey key)))

(macro DeleteProperty :params [(object dyn) (key dyn)] :ret bool
  (let [(propertyKey (ToPropertyKey key))]
    (if (%IsArray (%Box object))
        (if (StringEquals propertyKey "length")
            (ThrowTypeError "Cannot delete property 'length' of Array")
            (let [(ignored (%PropDeleteKey object propertyKey))] true))
        (let [(ignored (%PropDeleteKey object propertyKey))] true))))

(macro WritableAttribute :params [(descriptor dyn) (fallback int)] :ret int
  (if (%PropHasNamed descriptor "writable")
      (if (ToBoolean (%PropLoadNamed descriptor "writable")) 1 0) fallback))
(macro EnumerableAttribute :params [(descriptor dyn) (fallback int)] :ret int
  (if (%PropHasNamed descriptor "enumerable")
      (if (ToBoolean (%PropLoadNamed descriptor "enumerable")) 2 0) fallback))
(macro ConfigurableAttribute :params [(descriptor dyn) (fallback int)] :ret int
  (if (%PropHasNamed descriptor "configurable")
      (if (ToBoolean (%PropLoadNamed descriptor "configurable")) 4 0) fallback))

(macro ValidPropertyDescriptor :params [(descriptor dyn)] :ret bool
  (if (if (%IsObject descriptor) true
          (if (%IsArray descriptor) true (%IsFunction descriptor)))
      (let [(accessor (if (HasProperty descriptor "get") true
                          (HasProperty descriptor "set")))
            (data (if (HasProperty descriptor "value") true
                      (HasProperty descriptor "writable")))
            (getterValid (if (HasProperty descriptor "get")
                             (let [(getter (GetProperty descriptor "get"))]
                               (if (%IsUndefined getter) true (%IsFunction getter)))
                             true))
            (setterValid (if (HasProperty descriptor "set")
                             (let [(setter (GetProperty descriptor "set"))]
                               (if (%IsUndefined setter) true (%IsFunction setter)))
                             true))]
        (if (if accessor data false) false
            (if getterValid setterValid false)))
      false))

(macro ValidPropertyRedefinition
  :transitioning true
  :params [(descriptor dyn) (oldAttributes int) (oldValue dyn)
           (oldGetter dyn) (oldSetter dyn)] :ret bool
  (if (%Lt oldAttributes 0) true
      (if (%Not (%Eq (%BitAnd oldAttributes 4) 0)) true
          (let [(accessorDescriptor (if (HasProperty descriptor "get") true
                                        (HasProperty descriptor "set")))
                (dataDescriptor (if (HasProperty descriptor "value") true
                                    (HasProperty descriptor "writable")))
                (oldAccessor (%Not (%Eq (%BitAnd oldAttributes 8) 0)))]
            (if (if (HasProperty descriptor "configurable")
                    (ToBoolean (GetProperty descriptor "configurable")) false)
                false
                (if (if (HasProperty descriptor "enumerable")
                        (%Not (%Eq (if (ToBoolean (GetProperty descriptor "enumerable")) 2 0)
                                   (%BitAnd oldAttributes 2))) false)
                    false
                    ;; A non-configurable property cannot change descriptor kind. A generic
                    ;; descriptor containing neither data nor accessor fields leaves the kind
                    ;; unchanged.
                    (if (if accessorDescriptor (%Not oldAccessor)
                            (if dataDescriptor oldAccessor false))
                        false
                        (if oldAccessor
                            (if (if (HasProperty descriptor "get")
                                    (StrictNotEqual (GetProperty descriptor "get") oldGetter) false)
                                false
                                (if (if (HasProperty descriptor "set")
                                        (StrictNotEqual (GetProperty descriptor "set") oldSetter) false)
                                    false
                                    true))
                            (if (if (%Eq (%BitAnd oldAttributes 1) 0)
                                    (if (HasProperty descriptor "writable")
                                        (ToBoolean (GetProperty descriptor "writable")) false) false)
                                false
                                (if (if (%Eq (%BitAnd oldAttributes 1) 0)
                                        (if (HasProperty descriptor "value")
                                            (StrictNotEqual (GetProperty descriptor "value") oldValue) false)
                                        false)
                                    false
                                    true))))))))))

(macro RequireObjectValue :params [(value dyn) (message str)] :ret dyn
  (if (%IsObject value) value
      (if (%IsArray value) value
          (if (%IsFunction value) value (ThrowTypeError message)))))

;; Object integrity is JavaScript semantics; the two `%Object*` forms expose only the runtime's
;; internal [[Extensible]] slot. The primitive cases are handled here rather than in the frontend.
(macro ObjectIsExtensibleValue :params [(value dyn)] :ret bool
  (if (%IsObject value)
      (%Lt 0 (%ObjectIsExtensible value 0))
      (if (%IsArray value)
          (%Lt 0 (%ObjectIsExtensible value 0))
          (if (%IsFunction value)
              (%Lt 0 (%ObjectIsExtensible value 0))
              false))))

(macro ObjectPreventExtensionsValue :params [(value dyn)] :ret dyn
  (if (%IsObject value)
      (let [(ignored (%ObjectPreventExtensions value 0 (%Box undefined)))] value)
      (if (%IsArray value)
          (let [(ignored (%ObjectPreventExtensions value 0 (%Box undefined)))] value)
          (if (%IsFunction value)
              (let [(ignored (%ObjectPreventExtensions value 0 (%Box undefined)))] value)
              value))))

(builtin DefineProperty
  :transitioning true :params [(object dyn) (key dyn) (descriptor dyn)] :ret dyn
  (if (if (%IsObject object) false
          (if (%IsArray object) false (%Not (%IsFunction object))))
      (ThrowTypeError "Object.defineProperty called on non-object")
      (if (if (%IsObject descriptor) false
              (if (%IsArray descriptor) false (%Not (%IsFunction descriptor))))
          (ThrowTypeError "Property description must be an object")
          (if (%Not (ValidPropertyDescriptor descriptor))
              (ThrowTypeError "Invalid property descriptor. Cannot both specify accessors and a value or writable attribute")
              (let [(propertyKey (ToPropertyKey key))
                    (oldAttributes (%OwnPropertyAttributes object propertyKey))
                    (exists (%Le 0 oldAttributes))
                    (oldValue (if exists (%PropLoadKey object propertyKey) (%Box undefined)))]
                (if (%Not (ValidPropertyRedefinition descriptor oldAttributes oldValue
                                                     (%PropertyGetter object propertyKey)
                                                     (%PropertySetter object propertyKey)))
                    (ThrowTypeError "Cannot redefine non-configurable property")
                    (let [(accessor (if (HasProperty descriptor "get") true
                                        (HasProperty descriptor "set")))
                          (enumerable (EnumerableAttribute descriptor
                                                           (if exists (%BitAnd oldAttributes 2) 0)))
                          (configurable (ConfigurableAttribute descriptor
                                                               (if exists (%BitAnd oldAttributes 4) 0)))]
                      (if accessor
                          (let [(getter (if (HasProperty descriptor "get")
                                           (GetProperty descriptor "get")
                                           (if (%Eq (%BitAnd oldAttributes 8) 0)
                                               (%Box undefined)
                                               (%PropertyGetter object propertyKey))))
                                (setter (if (HasProperty descriptor "set")
                                           (GetProperty descriptor "set")
                                           (if (%Eq (%BitAnd oldAttributes 8) 0)
                                               (%Box undefined)
                                               (%PropertySetter object propertyKey))))
                                (getterStored (%DefinePropertyGetter object propertyKey getter))
                                (setterStored (%DefinePropertySetter object propertyKey setter))
                                (marked (%SetPropertyAttributes object propertyKey
                                                                (%BitOr 8 (%BitOr enumerable configurable))))]
                            object)
                          (let [(newValue (if (HasProperty descriptor "value")
                                             (GetProperty descriptor "value") oldValue))
                                (writable (WritableAttribute descriptor
                                                             (if exists (%BitAnd oldAttributes 1) 0)))
                                (attributes (%BitOr writable (%BitOr enumerable configurable)))
                                (stored (%DefinePropertyValue object propertyKey newValue))
                                (marked (%SetPropertyAttributes object propertyKey attributes))]
                            object)))))))))

(builtin GetOwnPropertyDescriptor
  :transitioning true :params [(object dyn) (key dyn)] :ret dyn
  (let [(target (RequireObjectValue object "Object.getOwnPropertyDescriptor called on non-object"))
        (propertyKey (ToPropertyKey key))
        (attributes (%OwnPropertyAttributes target propertyKey))]
    (if (%Lt attributes 0)
        (%Box undefined)
        (let [(descriptor (%Box (%NewObject)))
              (enumerable (SetProperty descriptor "enumerable"
                                        (%Not (%Eq (%BitAnd attributes 2) 0))))
              (configurable (SetProperty descriptor "configurable"
                                          (%Not (%Eq (%BitAnd attributes 4) 0))))]
          (if (%Eq (%BitAnd attributes 8) 0)
              (let [(value (SetProperty descriptor "value" (%PropLoadKey target propertyKey)))
                    (writable (SetProperty descriptor "writable"
                                            (%Not (%Eq (%BitAnd attributes 1) 0))))]
                descriptor)
              (let [(getter (SetProperty descriptor "get" (%PropertyGetter target propertyKey)))
                    (setter (SetProperty descriptor "set" (%PropertySetter target propertyKey)))]
                descriptor))))))

;; Object static methods are receiver-agnostic, but first-class publication still needs the
;; uniform JavaScript callable ABI. The adapter contributes that structure and delegates meaning.
(callable ObjectGetOwnPropertyDescriptor2
  :transitioning true :params [(object dyn) (key dyn)] :ret dyn
  (GetOwnPropertyDescriptor object key))

(macro ObjectGetOwnPropertyDescriptorValue :transitioning true :params [] :ret dyn
  (let [(function (%Box (closure ObjectGetOwnPropertyDescriptor2)))
        (lengthKey (ToPropertyKey "length"))
        (nameKey (ToPropertyKey "name"))
        (lengthStored (%DefinePropertyValue function lengthKey (%Box 2)))
        (lengthMarked (%SetPropertyAttributes function lengthKey 4))
        (nameStored (%DefinePropertyValue function nameKey
                                          (%Box "getOwnPropertyDescriptor")))
        (nameMarked (%SetPropertyAttributes function nameKey 4))]
    function))

(macro HasOwnProperty :params [(object dyn) (key dyn)] :ret bool
  (%Le 0 (%OwnPropertyAttributes object (ToPropertyKey key))))

(macro PropertyIsEnumerable :params [(object dyn) (key dyn)] :ret bool
  (let [(attributes (%OwnPropertyAttributes object (ToPropertyKey key)))]
    (if (%Lt attributes 0) false (%Not (%Eq (%BitAnd attributes 2) 0)))))

(builtin DefineProperties
  :transitioning true :params [(object dyn) (descriptors dyn)] :ret dyn
  (let [(target (RequireObjectValue object "Object.defineProperties called on non-object"))
        (source (RequireObjectValue descriptors "Property descriptions must be an object"))
        (count (%OwnKeyCount source))
        (keys (%NewArray))
        (values (%NewArray))
        ;; ToPropertyDescriptor is completed for every enumerable source property before the first
        ;; target mutation. A later invalid descriptor must not leave earlier properties defined.
        (collected
          (loop [(index 0) (at 0)]
            (if (%Le count index)
                at
                (let [(key (%OwnKeyAt source index))
                      (attributes (%OwnPropertyAttributes source key))]
                  (if (%Eq (%BitAnd attributes 2) 0)
                      (recur (%Add index 1) at)
                      (let [(descriptor (GetProperty source key))]
                        (if (%Not (ValidPropertyDescriptor descriptor))
                            (ThrowTypeError "Invalid property descriptor")
                            (let [(storedKey (%ArrayStore keys at key))
                                  (storedValue (%ArrayStore values at descriptor))]
                              (recur (%Add index 1) (%Add at 1))))))))))]
    (loop [(index 0)]
      (if (%Le collected index)
          target
          (let [(ignored (DefineProperty target (%ArrayLoad keys index)
                                         (%ArrayLoad values index)))]
            (recur (%Add index 1)))))))

(builtin ObjectCreate :transitioning true :params [(prototype dyn)] :ret dyn
  (if (%IsNull prototype)
      (let [(object (%Box (%NewObject)))
            (linked (SetObjectPrototype object prototype))]
        object)
      (if (%IsObject prototype)
          (let [(object (%Box (%NewObject)))
                (linked (SetObjectPrototype object prototype))]
            object)
          (ThrowTypeError "Object prototype may only be an Object or null"))))
