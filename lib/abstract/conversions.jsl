;; https://tc39.es/ecma262/#sec-toboolean — `%Not` is JavaScript truthiness, so negating twice IS
;; ToBoolean. No primitive required.
(macro ToBoolean :params [(v dyn)] :ret bool (%Not (%Not v)))

;; https://tc39.es/ecma262/#sec-toint32 and #sec-touint32. The bitwise operators already perform
;; these conversions on their operands, which is exactly what `x | 0` and `x >>> 0` mean in
;; JavaScript, so the abstract operations are the identity element of each.
(macro ToInt32  :params [(v dyn)] :ret int (%BitOr v 0))
(macro ToUint32 :params [(v dyn)] :ret int (%Ushr v 0))

;; https://tc39.es/ecma262/#sec-tolength — ToIntegerOrInfinity clamped to [0, 2^53-1].
(macro ToLength :params [(v dyn)] :ret int (Clamp (%ToInteger v) 0 9007199254740991))

;; https://tc39.es/ecma262/#sec-samevaluezero. `%Eq` is strict equality, which differs from
;; SameValueZero only at NaN: `NaN === NaN` is false and `SameValueZero(NaN, NaN)` is true.
(macro SameValueZero :params [(a dyn) (b dyn)] :ret bool
  (if (%Eq a b) true (if (IsNaNValue a) (IsNaNValue b) false)))

;; `Number.isNaN` without a type test, and it is exact: a value is a NaN Number exactly when it is
;; not strictly equal to itself. Every other value, of every other type, equals itself. This is why
;; `%IsNaN` — which COERCES, so `%IsNaN "abc"` is true — must not be used for this.
(macro IsNaNValue :params [(v dyn)] :ret bool (%Not (%Eq v v)))

;; "Is this value a Number", as TWO single-tag tests rather than one test against `int|flt`.
;; The backend's `be-js-tag-for-type` maps a KIND to a NaN-box tag, and a union has no single tag,
;; so `%IsNumber` on `int|flt` selected fine in the interpreter and failed `MSEL-UNSUPPORTED` in the
;; backend. Splitting it is both compilable and closer to the representation: an integer and a
;; double are genuinely different tags here.
(macro IsNumber :params [(v dyn)] :ret bool (if (%IsInt v) true (%IsFlt v)))
