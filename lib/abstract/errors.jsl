;; Built-in Error constructor identity and ordinary own properties. The runtime primitive creates
;; only an opaque function-tagged identity; allocation and every JavaScript-visible property write
;; remain composed here in the semantic library.
(macro BuiltinPrototypeValue :params [(kind int)] :ret dyn
  (%BuiltinObject kind))

(macro BuiltinConstructorName :params [(kind int)] :ret dyn
  (if (%Eq kind 0) "Error"
  (if (%Eq kind 1) "EvalError"
  (if (%Eq kind 2) "RangeError"
  (if (%Eq kind 3) "ReferenceError"
  (if (%Eq kind 4) "SyntaxError"
  (if (%Eq kind 5) "TypeError"
  (if (%Eq kind 6) "URIError"
  (if (%Eq kind 7) "Test262Error"
  (if (%Eq kind 16) "Object"
  (if (%Eq kind 17) "Array"
  (if (%Eq kind 18) "String"
  (if (%Eq kind 19) "Number"
  (if (%Eq kind 20) "Boolean"
  (if (%Eq kind 21) "Function"
  (if (%Eq kind 22) "Symbol"
  (if (%Eq kind 25) "ArrayBuffer"
  (if (%Eq kind 26) "Int8Array"
  (if (%Eq kind 27) "Uint8Array" "<unknown>")))))))))))))))))))

(builtin BuiltinConstructorValue :params [(kind int)] :ret dyn
  (let [(constructor (%ErrorConstructor kind))
        (prototype (BuiltinPrototypeValue kind))
        (name (BuiltinConstructorName kind))
        (prototypeStored (%PropStoreKey constructor (%Box "prototype") (%Box prototype)))
        (nameKey (%Box "name"))
        (nameStored (%DefinePropertyValue constructor nameKey (%Box name)))
        (nameMarked (%SetPropertyAttributes constructor nameKey 4))
        (constructorKey (%Box "constructor"))
        (constructorStored
          (%DefinePropertyValue prototype constructorKey (%Box constructor)))
        ;; Built-in prototype `constructor` properties are writable and configurable, but not
        ;; enumerable. Defining this through the descriptor seam also makes repeated intrinsic
        ;; materialization idempotent instead of resetting the property to assignment defaults.
        (constructorMarked (%SetPropertyAttributes prototype constructorKey 5))]
    constructor))

;; Opaque built-in identities make `typeof Object.defineProperty` and aliasing observable without
;; moving any operation semantics into the frontend. Define rather than assign so `length` and
;; `name` are non-writable and non-enumerable; bit 4 is configurable in the descriptor encoding.
(builtin BuiltinMethodValue :params [(kind int) (length int) (name dyn)] :ret dyn
  (let [(function (%ErrorConstructor kind))
        (lengthKey (ToPropertyKey "length"))
        (nameKey (ToPropertyKey "name"))
        (lengthStored (%DefinePropertyValue function lengthKey (%Box length)))
        (lengthMarked (%SetPropertyAttributes function lengthKey 4))
        (nameStored (%DefinePropertyValue function nameKey (%Box name)))
        (nameMarked (%SetPropertyAttributes function nameKey 4))]
    function))

(macro ErrorConstructorValue :params [(kind int)] :ret dyn
  (BuiltinConstructorValue kind))

(macro InitializeOrdinaryFunctionName :params [(function dyn) (name dyn)] :ret dyn
  (let [(nameKey (ToPropertyKey "name"))
        (nameStored (%DefinePropertyValue function nameKey (%Box name)))
        (nameMarked (%SetPropertyAttributes function nameKey 4))]
    function))

(macro InitializeFunctionPrototype :params [(prototype dyn) (constructor dyn)] :ret dyn
  (let [(constructorStored
          (%PropStoreKey prototype (ToPropertyKey "constructor") (%Box constructor)))]
    prototype))

(macro NewErrorObject :params [(message dyn) (name dyn) (constructor dyn)] :ret dyn
  (let [(object (%Box (%NewObject)))
        (messageStored (%PropStoreKey object (%Box "message") (%Box message)))
        (nameStored (%PropStoreKey object (%Box "name") (%Box name)))
        (constructorStored
          (%PropStoreKey object (%Box "constructor") (%Box constructor)))]
    object))

(macro ThrowTypeError :params [(message dyn)] :ret dyn
  ;; Built-in abstract operations throw an Error object, not their diagnostic string. Construction
  ;; here gives source `catch` and Test262's `assert.throws` the same observable constructor
  ;; identity as an explicit `new TypeError(message)` expression.
  (%Throw (NewErrorObject message "TypeError" (ErrorConstructorValue 5))))

(macro ThrowReferenceError :params [(message dyn)] :ret dyn
  (%Throw (NewErrorObject message "ReferenceError" (ErrorConstructorValue 3))))

(macro ThrowRangeError :params [(message dyn)] :ret dyn
  (%Throw (NewErrorObject message "RangeError" (ErrorConstructorValue 2))))
