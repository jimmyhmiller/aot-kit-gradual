;; https://tc39.es/ecma262/#sec-object.keys
;; https://tc39.es/ecma262/#sec-object.values
;; https://tc39.es/ecma262/#sec-object.entries
;;
;; Like Torque's `GetOwnPropertyKeys`, the platform intrinsics expose a stable ordinal view of the
;; heap representation. Allocation, looping, value lookup, pair construction, and result layout
;; remain visible JSL semantics.
;; https://tc39.es/ecma262/#sec-ordinarycallbindthis
;; Function strictness is indexed frontend structure. Receiver substitution and primitive boxing
;; are JavaScript semantics and therefore live here, once at function entry rather than at each
;; call site or each read of `this`.
(macro OrdinaryCallBindThisSloppy :transitioning true
  :params [(receiver dyn)] :ret dyn
  (if (%IsUndefined receiver) (GlobalObjectValue)
      (if (%IsNull receiver) (GlobalObjectValue) (ToObject receiver))))

;; One source step from Object.assign. The frontend repeats this macro for variadic source syntax;
;; all JavaScript behavior of a step remains here.
(macro ObjectAssignSource :params [(target dyn) (source dyn)] :ret dyn
  (if (%Eq source (%Box null)) target
      (if (%Eq source (%Box undefined)) target
          (let [(from (ToObject source))
                (count (%OwnKeyCount from))]
            (loop [(index 0)]
              (if (%Le count index) target
                  (let [(key (%OwnKeyAt from index))
                        (value (%PropLoadKey from key))
                        (stored (%PropStoreKey target key value))]
                    (recur (%Add index 1)))))))))

(macro ObjectKeys :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (count (%OwnKeyCount target))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%OwnKeyAt target index))
                (attributes (%OwnPropertyAttributes target key))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (let [(stored (%ArrayStore out outIndex key))]
                  (recur (%Add index 1) (%Add outIndex 1)))))))))

;; https://tc39.es/ecma262/#sec-copydataproperties
;; Excluded names are already canonical property keys: syntax lowering evaluates each computed key
;; once, then uses the same value for its named Get and for this list.
(macro ObjectRestKeyExcluded :params [(excluded dyn) (key dyn)] :ret bool
  (loop [(index 0)]
    (if (%Le (%ArrayLen excluded) index)
        false
        (if (StringEquals (%ArrayLoad excluded index) key)
            true
            (recur (%Add index 1))))))

(macro ObjectRest :params [(source dyn) (excluded dyn)] :ret dyn
  (let [(from (ToObject source))
        (out (%Box (%NewObject)))
        (initialized (InitializeOrdinaryObject out))
        (count (%OwnKeyCount from))]
    (loop [(index 0)]
      (if (%Le count index)
          out
          (let [(key (%OwnKeyAt from index))
                (attributes (%OwnPropertyAttributes from key))]
            (if (if (ObjectRestKeyExcluded excluded key)
                    true
                    (%Eq (%BitAnd attributes 2) 0))
                (recur (%Add index 1))
                (let [(value (GetProperty from key))
                      (defined (%DefinePropertyValue out key value))
                      (marked (%SetPropertyAttributes out key 7))]
                  (recur (%Add index 1)))))))))

(macro ObjectOwnPropertyNames :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (count (%OwnKeyCount target))]
    (loop [(index 0)]
      (if (%Le count index) out
          (let [(stored (%ArrayStore out index (%OwnKeyAt target index)))]
            (recur (%Add index 1)))))))

(callable ObjectOwnPropertyNames1
  :transitioning true :params [(object dyn)] :ret dyn
  (ObjectOwnPropertyNames object))

(macro ObjectOwnPropertyNamesValue :transitioning true :params [] :ret dyn
  (let [(function (%Box (closure ObjectOwnPropertyNames1)))
        (lengthKey (ToPropertyKey "length"))
        (nameKey (ToPropertyKey "name"))
        (lengthStored (%DefinePropertyValue function lengthKey (%Box 1)))
        (lengthMarked (%SetPropertyAttributes function lengthKey 4))
        (nameStored (%DefinePropertyValue function nameKey (%Box "getOwnPropertyNames")))
        (nameMarked (%SetPropertyAttributes function nameKey 4))]
    function))

(macro ObjectValues :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (count (%OwnKeyCount target))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%OwnKeyAt target index))
                (attributes (%OwnPropertyAttributes target key))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (let [(stored (%ArrayStore out outIndex (%PropLoadKey target key)))]
                  (recur (%Add index 1) (%Add outIndex 1)))))))))

(macro ObjectEntries :params [(object dyn)] :ret dyn
  (let [(target (ToObject object))
        (out (%NewArray))
        (count (%OwnKeyCount target))]
    (loop [(index 0) (outIndex 0)]
      (if (%Le count index) out
          (let [(key (%OwnKeyAt target index))
                (attributes (%OwnPropertyAttributes target key))
                (pair (%NewArray))
                (key-store (%ArrayStore pair 0 key))
                (value-store (%ArrayStore pair 1 (%PropLoadKey target key)))
                (out-store (if (%Eq (%BitAnd attributes 2) 0)
                               (%Box undefined)
                               (%ArrayStore out outIndex (%Box pair))))]
            (if (%Eq (%BitAnd attributes 2) 0)
                (recur (%Add index 1) outIndex)
                (recur (%Add index 1) (%Add outIndex 1))))))))

;; https://tc39.es/ecma262/#sec-object.freeze
;; SetIntegrityLevel is representation-owned, like Torque's runtime intrinsic; the observable
;; operation and its primitive-value identity rule remain in JSL.
(macro ObjectFreeze :params [(value dyn)] :ret dyn
  (if (%IsObject value)
      (let [(ignored (%ObjectFreeze value))] value)
      (if (%IsArray value)
          (let [(ignored (%ObjectFreeze value))] value)
          value)))
