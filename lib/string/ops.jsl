;; The string OPERATORS — what `+`, `===` and `<` mean when their operands are strings — as opposed
;; to the methods in the rest of `lib/string/`.
;;
;; Macros, for the same reason as `lib/abstract/coercions.jsl`: each is one primitive plus a name,
;; and the caller is emitting the operation rather than invoking it.

;; https://tc39.es/ecma262/#sec-string.prototype.length — the UTF-16 code-unit count, not a
;; character count and not a byte count.
(macro StringLength :params [(s dyn)] :ret int (%StringLen s))

;; https://tc39.es/ecma262/#sec-isstrictlyequal for two strings: same length, same code units.
;; NOT identity — two separately allocated strings with the same contents are `===`.
(macro StringEquals :params [(a dyn) (b dyn)] :ret bool (%StringEq a b))

;; https://tc39.es/ecma262/#sec-islessthan for two strings: lexicographic by CODE UNIT, which is
;; what makes it a total order that disagrees with locale collation. Negative, zero or positive, so
;; each of the four relational operators is a comparison of this against zero.
(macro StringCompare :params [(a dyn) (b dyn)] :ret int (%StringCompare a b))

;; https://tc39.es/ecma262/#sec-string.prototype.concat — the `+` operator once both operands have
;; already been coerced to strings by the caller.
(macro StringConcat :params [(a dyn) (b dyn)] :ret dyn (%StringConcat a b))
