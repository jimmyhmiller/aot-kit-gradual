;; https://tc39.es/ecma262/#sec-string.prototype.endswith, over already-coerced arguments.
;;
;; THE NEGATIVE GUARD IS LOAD-BEARING, and it is the bug this definition exists to not have. The
;; obvious spelling is "the first occurrence at or after len(s)-len(needle) is exactly there". When
;; the needle is ONE code unit longer than the receiver that position is -1, and a needle that does
;; not occur also answers -1, so the two compare equal and a needle that cannot possibly fit
;; reports true. tests/jsl-test.coil pins the case.
(builtin StringEndsWith
  :transitioning true
  :params [(s dyn) (needle dyn)]
  :ret dyn
  (let [(at (%Sub (%StringLen s) (%StringLen needle)))]
    (%Box (if (%Lt at 0)
              false
              (%Eq (StringIndexOfFrom s needle at) at)))))
