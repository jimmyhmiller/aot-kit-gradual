;; https://tc39.es/ecma262/#sec-string.prototype.indexof
;;
;; All seven steps. The coerced core is kept separate so the other string builtins that share steps
;; 5-7 (startsWith, endsWith, includes) do not each re-derive the clamp.
;;
;; ONE DOCUMENTED DEVIATION, in step 1. RequireObjectCoercible must throw a **TypeError**, and error
;; classes do not exist yet — there are no error objects, no prototypes and no `instanceof` in this
;; runtime (roadmap R03). So the throw carries the message string and the CLASS is wrong. That is a
;; deviation, recorded here and asserted by tests/jsl-test.coil, rather than a silent approximation:
;; the throw happens, on the right inputs, with the right message.
(macro RequireObjectCoercible
  :params [(v dyn)]
  :ret dyn
  (if (%Eq v null)
      (%Throw "TypeError: String.prototype.indexOf called on null or undefined")
      (if (%Eq v undefined)
          (%Throw "TypeError: String.prototype.indexOf called on null or undefined")
          v)))

;; Steps 5-7, over an already-coerced receiver, search string and integer position.
(builtin StringIndexOfFrom
  :params [(s dyn) (needle dyn) (start dyn)]
  :ret int
  (%StringIndexOf s needle (Clamp start 0 (%StringLen s))))

;; Steps 1-4, then the core.
;;
;; `%ToInteger` IS ToIntegerOrInfinity, not `|0`. The difference is observable: `|0` is ToInt32, so
;; it answers 0 for +Infinity, and `"abc".indexOf("c", Infinity)` would then find the `c` at index 2
;; instead of returning -1. It also wraps at 2^31 and mis-handles fractional positions the spec
;; truncates toward zero.
(builtin String.prototype.indexOf
  :transitioning true
  :params [(this dyn) (search dyn) (position dyn)]
  :ret int
  (let [(s      (%ToString (RequireObjectCoercible this)))
        (needle (%ToString search))
        (pos    (%ToInteger position))]
    (StringIndexOfFrom s needle pos)))
