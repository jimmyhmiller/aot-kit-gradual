;; The two extractors that are not slice.

;; https://tc39.es/ecma262/#sec-string.prototype.substring
;;
;; THIS IS THE PRIMITIVE, AND SAYING SO IS THE POINT. `%Substring` lowers to OP-STRINGSUBSTRING with
;; mode 0, and mode 0 IS substring: it clamps both arguments into [0, len] and swaps them when they
;; are out of order. A first version of this definition re-derived that clamp and swap on top. It
;; compiled, it passed conformance, and it was dead code — no perturbation of the swap could change
;; an answer, because the primitive had already performed it. What the library adds here is the name
;; and the spec reference, exactly as it does for the case mappings.
(builtin StringSubstring :params [(s dyn) (start int) (end int)] :ret dyn
  (%Substring s start end))

;; https://tc39.es/ecma262/#sec-string.prototype.substr — Annex B, and genuinely different: the
;; second argument is a COUNT rather than an end position, and a negative start counts from the end.
;;
;; THE COUNT GUARD IS LOAD-BEARING, unlike the clamp that was removed above. A negative count must
;; yield the empty string, but `a + count` is then BELOW `a`, and `%Substring` would helpfully swap
;; the two and return the characters before the start instead — `"abcdefgh".substr(2, -1)` would be
;; "b" rather than "". Clamping the count against the remaining length, by contrast, is redundant:
;; the primitive already clamps the end it is given.
(builtin StringSubstr :params [(s dyn) (start int) (count int)] :ret dyn
  (let [(len (%StringLen s))
        (a (Clamp (if (%Lt start 0) (%Add len start) start) 0 len))]
    (if (%Le count 0) "" (%Substring s a (%Add a count)))))
