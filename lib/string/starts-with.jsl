;; https://tc39.es/ecma262/#sec-string.prototype.startswith, over already-coerced arguments.
;; `indexOf` reports the FIRST occurrence, so "starts with" is exactly "first occurrence is at 0".
;; An empty needle gives 0 and therefore true, which is what the spec says.
(builtin StringStartsWith
  :transitioning true
  :params [(s dyn) (needle dyn)]
  :ret dyn
  (%Box (%Eq (StringIndexOfFrom s needle 0) 0)))
