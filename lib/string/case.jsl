;; https://tc39.es/ecma262/#sec-string.prototype.tolowercase and toUpperCase.
;;
;; These are thin on purpose. Case mapping is a Unicode TABLE, not JavaScript semantics — there is
;; no algorithm here for a DSL to express, only a name for the operation the runtime performs. That
;; makes them the same shape as `%FloorNum`: the definition exists so the library is the one place
;; the operation is named, and the primitive is the machine's answer.
(builtin StringToLowerCase :params [(s dyn)] :ret dyn (%StringLower s))
(builtin StringToUpperCase :params [(s dyn)] :ret dyn (%StringUpper s))
