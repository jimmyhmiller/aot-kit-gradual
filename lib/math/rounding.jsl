;; Math over an already-numeric argument. Each definition is exact for every value this runtime can
;; construct; see docs/JSL.md for the one gap, which is negative zero.

;; https://tc39.es/ecma262/#sec-math.abs
;;
;; `(%Add x 0)` on the non-negative arm is not padding. It is what makes `abs(-0)` answer `+0`, per
;; IEEE `-0 + 0 = +0`, without a special case — and it leaves every other value alone, including
;; NaN and both infinities.
(builtin MathAbs :params [(v dyn)] :ret dyn
  (if (%IsInt v)
      (%Box (IntAbs (%UnboxInt v)))
      (%Box (FltAbs (%UnboxFlt v)))))

;; https://tc39.es/ecma262/#sec-math.sign — the zero arm returns `x` UNCHANGED, because the spec
;; preserves the sign of a zero and canonicalising it would not.
(builtin MathSign :params [(v dyn)] :ret dyn
  (if (%IsInt v)
      (%Box (IntSign (%UnboxInt v)))
      (let [(x (%UnboxFlt v))]
        (if (FltIsNaN x) (BoxedNaN) (%Box (FltSign x))))))

;; https://tc39.es/ecma262/#sec-math.trunc. ToIntegerOrInfinity already truncates toward zero and
;; preserves both infinities; it differs from `trunc` only on NaN, which it maps to 0.
(builtin MathTrunc :params [(v dyn)] :ret dyn
  (if (%IsInt v) v
    (let [(x (%UnboxFlt v))]
      (if (FltIsNaN x) (BoxedNaN) (%ToInteger v)))))

;; https://tc39.es/ecma262/#sec-math.floor and #sec-math.ceil, from truncation. NaN and the
;; infinities fall through untouched: every comparison against NaN is false, and an infinity is
;; already equal to its own truncation.
(builtin MathFloor :transitioning true :params [(x dyn)] :ret dyn
  (let [(t (MathTrunc x))]
    (if (%Lt x 0) (if (%Eq t x) t (%Sub t 1)) t)))

(builtin MathCeil :transitioning true :params [(x dyn)] :ret dyn
  (let [(t (MathTrunc x))]
    (if (%Lt 0 x) (if (%Eq t x) t (%Add t 1)) t)))

;; https://tc39.es/ecma262/#sec-math.round. NOT `floor(x + 0.5)`: the spec rounds a half TOWARD
;; +Infinity, so -0.5 rounds to -0 rather than to -1, and the interval [-0.5, 0) is its own case.
(builtin MathRound :transitioning true :params [(x dyn)] :ret dyn
  (if (IsNaNValue x) (NaN)
    (let [(f (MathFloor x))
          (diff (%Sub x f))]
      (if (%Le 0.5 diff) (%Add f 1) f))))

;; https://tc39.es/ecma262/#sec-math.max and #sec-math.min, two arguments. NaN in either position
;; wins, which is what distinguishes these from a plain comparison.
(builtin MathMax2 :params [(a dyn) (b dyn)] :ret dyn
  (if (IsNaNValue a) (NaN) (if (IsNaNValue b) (NaN) (if (%Lt a b) b a))))

(builtin MathMin2 :params [(a dyn) (b dyn)] :ret dyn
  (if (IsNaNValue a) (NaN) (if (IsNaNValue b) (NaN) (if (%Lt b a) b a))))
