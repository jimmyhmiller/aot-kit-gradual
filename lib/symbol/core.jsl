;; A Symbol payload is the identity of an ordinary traced allocation. The retag primitive is
;; representation-only; all observable construction and conversion semantics remain here.
(macro NewSymbol :params [(description dyn)] :ret dyn
  (let [(text (if (%IsUndefined description)
                  (%Box undefined)
                  (ToStringValue description)))
        (identity (%Box (%NewObject)))
        (initialized (%InternalInit identity (%Box text) 104))
        (prototype (SetObjectPrototype identity (BuiltinPrototypeValue 22)))]
    (%SymbolFromObject identity)))

;; Public Symbol() entry. Direct call syntax can reach this without first loading the constructor
;; object, so materialize its stable prototype surface before allocating the primitive.
(macro CallSymbol :transitioning true :params [(description dyn)] :ret dyn
  (let [(initialized (SymbolConstructorValue))]
    (NewSymbol description)))

;; Well-known symbols are ordinary, traced Symbol allocations whose stable roots are the own
;; properties of the stable Symbol constructor. Never retag a synthetic builtin identity: those
;; are function/object handles, not GC allocations.
(macro WellKnownSymbol :params [(constructor dyn) (name dyn) (description dyn)] :ret dyn
  (if (HasOwnProperty constructor name)
      (GetProperty constructor name)
      (let [(symbol (NewSymbol description))
            (stored (%DefinePropertyValue constructor (ToPropertyKey name) symbol))]
        symbol)))

(callable SymbolValueOf0 :transitioning true :params [] :ret dyn
  (if (%IsSymbol this)
      this
      (if (%IsObject this)
          (if (%Eq (%InternalKind this) 103)
              (%InternalTarget this)
              (ThrowTypeError "Symbol.prototype.valueOf requires that 'this' be a Symbol"))
          (ThrowTypeError "Symbol.prototype.valueOf requires that 'this' be a Symbol"))))

(callable SymbolDescriptionGetter0 :transitioning true :params [] :ret dyn
  (if (%IsSymbol this)
      (%InternalTarget this)
      (if (%IsObject this)
          (if (%Eq (%InternalKind this) 103)
              (%InternalTarget (%InternalTarget this))
              (ThrowTypeError "Symbol.prototype.description requires that 'this' be a Symbol"))
          (ThrowTypeError "Symbol.prototype.description requires that 'this' be a Symbol"))))

(callable SymbolToString0 :transitioning true :params [] :ret dyn
  (let [(symbol (if (%IsSymbol this)
                    this
                    (if (%IsObject this)
                        (if (%Eq (%InternalKind this) 103)
                            (%InternalTarget this)
                            (ThrowTypeError "Symbol.prototype.toString requires that 'this' be a Symbol"))
                        (ThrowTypeError "Symbol.prototype.toString requires that 'this' be a Symbol"))))
        (description (%InternalTarget symbol))]
    (if (%IsUndefined description)
        "Symbol()"
        (%StringConcat "Symbol(" (%StringConcat description ")")))))

(callable SymbolToPrimitive1 :transitioning true :params [(hint dyn)] :ret dyn
  (if (%IsSymbol this)
      this
      (if (%IsObject this)
          (if (%Eq (%InternalKind this) 103)
              (%InternalTarget this)
              (ThrowTypeError "Symbol.prototype[Symbol.toPrimitive] requires a Symbol"))
          (ThrowTypeError "Symbol.prototype[Symbol.toPrimitive] requires a Symbol"))))

(callable SymbolFor1 :transitioning true :params [(key dyn)] :ret dyn
  (let [(name (ToStringValue key))
        (registry (BuiltinPrototypeValue 53))]
    (if (HasOwnProperty registry name)
        (GetProperty registry name)
        (let [(symbol (NewSymbol name))
              (stored (%DefinePropertyValue registry (ToPropertyKey name) symbol))]
          symbol))))

(callable SymbolKeyFor1 :transitioning true :params [(symbol dyn)] :ret dyn
  (if (%IsSymbol symbol)
      (let [(registry (BuiltinPrototypeValue 53))
            (count (%OwnKeyCount registry))]
        (loop [(index 0)]
          (if (%Le count index)
              (%Box undefined)
              (let [(key (%OwnKeyAt registry index))]
                (if (StrictEqual (GetProperty registry key) symbol)
                    key
                    (recur (%Add index 1)))))))
      (ThrowTypeError "Symbol.keyFor requires a Symbol")))

