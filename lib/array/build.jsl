;; Array construction. These are the first definitions that ALLOCATE, and they are what make the
;; read-only entries in `read.jsl` verifiable: a definition can now build the array it then reads,
;; so the whole path lives inside one function and memory never has to cross a call.
;;
;; `%NewArray` allocates and tags; `%ArrayStore` writes an element and yields the new heap, which
;; the lowering threads. Neither appears as a memory operand in the source.

(macro NewArray :params [] :ret dyn (%NewArray))
(macro IsArray :params [(value dyn)] :ret bool (%IsArray value))

;; Append one concat argument, spreading it exactly when its runtime tag is Array.
(macro ArrayConcatValue :params [(out dyn) (value dyn)] :ret dyn
  (if (%IsArray value)
      (let [(array (%UnboxArray value))
            (len (%ArrayLen array))]
        (loop [(i 0)]
          (if (%Le len i) out
            (let [(stored (%ArrayStore out (%ArrayLen out) (%ArrayLoad array i)))]
              (recur (%Add i 1))))))
      (let [(stored (%ArrayStore out (%ArrayLen out) value))] out)))

;; Iterative depth-first flattening. The explicit value/depth stacks are the DSL equivalent of
;; Torque builtins using a work list: recursion remains a source-level policy, not compiler
;; recursion that would infinitely expand an inlined macro.
(macro ArrayFlat :params [(source dyn) (depth int)] :ret dyn
  (let [(out (%NewArray))
        (values (%NewArray))
        (depths (%NewArray))
        (seed-len (%ArrayLen source))
        (seeded
          (loop [(i seed-len)]
            (if (%Le i 0) i
              (let [(j (%Sub i 1))
                    (sv (%ArrayStore values (%ArrayLen values) (%ArrayLoad source j)))
                    (sd (%ArrayStore depths (%ArrayLen depths) (%Box depth)))]
                (recur j)))))]
    (loop [(remaining seed-len)]
      (if (%Le remaining 0) out
        (let [(slot (%Sub (%ArrayLen values) 1))
              (value (%ArrayLoad values slot))
              (d (%UnboxInt (%ArrayLoad depths slot)))
              (rv (%ArrayResize values slot value))
              (rd (%ArrayResize depths slot (%Box d)))]
          (if (if (%Lt 0 d) (%IsArray value) false)
              (let [(array (%UnboxArray value))
                    (n (%ArrayLen array))
                    (pushed
                      (loop [(i n)]
                        (if (%Le i 0) i
                          (let [(j (%Sub i 1))
                                (sv (%ArrayStore values (%ArrayLen values) (%ArrayLoad array j)))
                                (sd (%ArrayStore depths (%ArrayLen depths) (%Box (%Sub d 1))))]
                            (recur j)))))]
                (recur (%Add (%Sub remaining 1) n)))
              (let [(stored (%ArrayStore out (%ArrayLen out) value))]
                (recur (%Sub remaining 1)))))))))

;; https://tc39.es/ecma262/#sec-array.prototype.push, ONE ARGUMENT AT A TIME.
;;
;; The spec's `push` is variadic and JSL has no variadic signature, so the frontend keeps the
;; argument loop and calls this once per argument. That is not a workaround being tolerated: the
;; loop is over the SYNTAX, whose length is known at compile time, so unrolling it in the frontend
;; is what a variadic JSL definition would have had to be lowered into anyway.
;;
;; The length is re-read on each call rather than being carried, which is what makes the
;; one-at-a-time factoring correct: the answer is the length AFTER this element, so `a.push(x, y)`
;; answers len+2 by answering len+1 twice over a heap that moved in between.
(macro ArrayPush1 :params [(a dyn) (v dyn)] :ret int
  (let [(len (%ArrayLen a))
        (ignored (%ArrayStore a len v))]
    (%Add len 1)))

;; `a.push()` with no arguments is the length, unchanged — and it still has to be an OPERATION,
;; because `a.length` and `a.push()` are the same answer through two different paths and only one
;; of them existed in the library.
(macro ArrayLength :params [(a dyn)] :ret int (%ArrayLen a))

;; https://tc39.es/ecma262/#sec-array.prototype.pop.
;;
;; THE THIRD OPERAND OF `%ArrayResize` IS WHY THAT PRIMITIVE HAS THREE. `v` is not data the resize
;; consumes; it is the value whose load must happen before the write that destroys it. Written as
;; a plain two-operand resize the load of the last element is ordered only by the memory chain,
;; which does not say a read precedes a later write of the same memory, so the scheduler floats it
;; past the shortening and selection refuses the block with `MSEL-MEMORY-ORDER`.
;;
;; SPEC STEP 3 IS THE CLAMP, NOT A BRANCH. `[].pop()` must be `undefined` and must leave the length
;; at 0, and clamping the index to [0, len] gets both for free: on an empty array the index is 0, a
;; load past the end already reads `undefined`, and resizing to 0 changes nothing. The hand-written
;; path this replaces had no guard at all and resized an empty array to -1.
;;
;; Written as `(if (%Le len 0) undefined ...)` instead — which is the spec's own shape — it is a Phi
;; over `Const undefined` and a boxed load, and the seam does not carry that: `popped * 10 +
;; values[0]` then answered one low, because the Phi reaches the multiply unboxed while the sibling
;; load does not. The branch-free form has one representation on every path, and it is also the
;; smaller graph.
(macro ArrayPop :params [(a dyn)] :ret dyn
  (let [(last (Clamp (%Sub (%ArrayLen a) 1) 0 (%ArrayLen a)))
        (v (%ArrayLoad a last))
        (ignored (%ArrayResize a last v))]
    v))

;; https://tc39.es/ecma262/#sec-array.prototype.shift.
;;
;; The elements move down by one IN A LOOP, where the hand-written path emitted a single bulk
;; `OP-ARRAYCOPY`. That is the one place this conversion changes the emitted shape rather than only
;; its author: JSL has no bulk-copy primitive, and adding one would be a machine-surface op whose
;; only caller is this line. The loop is the same O(n) work spelled in the language.
;;
;; `head` is loaded before the loop overwrites index 0, and it is also the resize's ordering value,
;; so the read that produces the RESULT is pinned ahead of the write that shortens the array.
;;
;; The empty case is the same clamp `pop` uses, and for the same reason: `last` is 0, so the loop
;; never runs, the resize is a no-op, and the load of index 0 answers `undefined`.
(macro ArrayShift :params [(a dyn)] :ret dyn
  (let [(last (Clamp (%Sub (%ArrayLen a) 1) 0 (%ArrayLen a)))
        (head (%ArrayLoad a 0))
        (moved (loop [(i 0)]
                 (if (%Le last i) i
                   (let [(ignored (%ArrayStore a i (%ArrayLoad a (%Add i 1))))]
                     (recur (%Add i 1))))))
        (ignored2 (%ArrayResize a last head))]
    head))

;; https://tc39.es/ecma262/#sec-array.prototype.unshift, one syntax argument at a time. The
;; frontend visits arguments right-to-left, so repeated calls preserve their source order.
(macro ArrayUnshift1 :params [(a dyn) (v dyn)] :ret int
  (let [(len (%ArrayLen a))
        (copy (%NewArray))
        (copied
          (loop [(i 0)]
            (if (%Le len i) i
              (let [(stored (%ArrayStore copy i (%ArrayLoad a i)))]
                (recur (%Add i 1))))))
        (head (%ArrayStore a 0 v))]
    (loop [(i 0)]
      (if (%Le len i) (%Add len 1)
        (let [(moved (%ArrayStore a (%Add i 1) (%ArrayLoad copy i)))]
          (recur (%Add i 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.reverse. Swapping only the lower half makes odd
;; lengths leave their centre element untouched.
(macro ArrayReverse :params [(a dyn)] :ret dyn
  (let [(len (%ArrayLen a))
        (copy (%NewArray))
        (copied
          (loop [(i 0)]
            (if (%Le len i) i
              (let [(stored (%ArrayStore copy i (%ArrayLoad a i)))]
                (recur (%Add i 1))))))]
    ;; Two passes make the memory dependency explicit: no receiver element is overwritten until
    ;; every original value has reached the scratch array.
    (loop [(i 0)]
      (if (%Le len i) a
        (let [(stored (%ArrayStore a i (%ArrayLoad copy (%Sub (%Sub len 1) i))))]
          (recur (%Add i 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.fill. Bounds use the same relative-index rule as
;; slice, but fill mutates and returns its receiver.
(macro ArrayFill :params [(a dyn) (value dyn) (start int) (end int)] :ret dyn
  (let [(len (%ArrayLen a))
        (lo (Clamp (if (%Lt start 0) (%Add len start) start) 0 len))
        (hi (Clamp (if (%Lt end 0) (%Add len end) end) 0 len))]
    (loop [(i lo)]
      (if (%Le hi i) a
        (let [(stored (%ArrayStore a i value))]
          (recur (%Add i 1)))))))

;; The normalized insertion/deletion point shared by splice's deletion and the frontend's
;; syntax-argument insertion loop. Keeping it named in JSL prevents the two halves of variadic
;; splice from acquiring different negative-index rules.
(macro ArraySpliceStart :params [(a dyn) (start int)] :ret int
  (let [(len (%ArrayLen a))]
    (Clamp (if (%Lt start 0) (%Add len start) start) 0 len)))

;; Delete a range and close the gap. A negative count is the frontend's explicit "argument was
;; absent" sentinel and means the remainder; an actual negative JavaScript deleteCount clamps to
;; zero before it reaches this definition.
(macro ArraySpliceDelete :params [(a dyn) (start int) (count int)] :ret dyn
  (let [(len (%ArrayLen a))
        (n (if (%Lt count 0) (%Sub len start) (Clamp count 0 (%Sub len start))))
        (out (%NewArray))
        (tail (%NewArray))
        (deleted
          (loop [(i 0)]
            (if (%Le n i) i
              (let [(stored (%ArrayStore out i (%ArrayLoad a (%Add start i))))]
                (recur (%Add i 1))))))
        (tail-len (%Sub len (%Add start n)))
        (copied
          (loop [(i 0)]
            (if (%Le tail-len i) i
              (let [(stored (%ArrayStore tail i (%ArrayLoad a (%Add (%Add start n) i))))]
                (recur (%Add i 1))))))
        (closed
          (loop [(i 0)]
            (if (%Le tail-len i) i
              (let [(stored (%ArrayStore a (%Add start i) (%ArrayLoad tail i)))]
                (recur (%Add i 1))))))
        (ordered (%ArrayLoad out 0))
        (resized (%ArrayResize a (%Sub len n) ordered))]
    out))

;; Insert one already-evaluated syntax argument. The frontend invokes this left-to-right after
;; deletion; a scratch copy prevents destructive right shifts from overtaking their source reads.
(macro ArraySpliceInsert1 :params [(a dyn) (start int) (offset int) (value dyn)] :ret dyn
  (let [(at (%Add start offset))
        (len (%ArrayLen a))
        (tail (%NewArray))
        (tail-len (%Sub len at))
        (copied
          (loop [(i 0)]
            (if (%Le tail-len i) i
              (let [(stored (%ArrayStore tail i (%ArrayLoad a (%Add at i))))]
                (recur (%Add i 1))))))
        (inserted (%ArrayStore a at value))]
    (loop [(i 0)]
      (if (%Le tail-len i) a
        (let [(stored (%ArrayStore a (%Add (%Add at i) 1) (%ArrayLoad tail i)))]
          (recur (%Add i 1)))))))

(macro ArrayOfAppend1 :params [(a dyn) (value dyn)] :ret dyn
  (let [(stored (%ArrayStore a (%ArrayLen a) value))] a))

;; https://tc39.es/ecma262/#sec-array.from for the iterable kinds this runtime represents today.
;; String iteration is by Unicode code point, not UTF-16 code unit: a valid surrogate pair is
;; concatenated into one element and advances by two units.
(macro ArrayFrom :params [(source dyn)] :ret dyn
  (let [(out (%NewArray))]
    (if (%IsArray source)
        (let [(array (%UnboxArray source))
              (len (%ArrayLen array))]
          (loop [(i 0)]
            (if (%Le len i) out
              (let [(stored (%ArrayStore out i (%ArrayLoad array i)))]
                (recur (%Add i 1))))))
        (if (%IsString source)
            (let [(string (%UnboxString source))
                  (len (%StringLen string))]
              (loop [(i 0) (at 0)]
                (if (%Le len i) out
                  (let [(first (%StringCharCode string i))
                        (paired
                          (if (if (%Le 55296 first) (%Le first 56319) false)
                              (if (%Lt (%Add i 1) len)
                                  (let [(second (%StringCharCode string (%Add i 1)))]
                                    (if (if (%Le 56320 second) (%Le second 57343) false)
                                        true false))
                                  false)
                              false))
                        (character
                          (if paired
                              (%StringConcat (%StringFromCode first)
                                             (%StringFromCode (%StringCharCode string (%Add i 1))))
                              (%StringFromCode first)))
                        (stored (%ArrayStore out at (%Box character)))]
                    (recur (%Add i (if paired 2 1)) (%Add at 1))))))
            (%Throw "TypeError: Array.from source is not iterable")))))

;; https://tc39.es/ecma262/#sec-array.prototype.slice, over a fresh array.
;;
;; The bounds are the SLICE rule, not the substring rule, and they are the same two lines
;; `StringSlice` carries: a negative index maps to `len + index`, and the result is empty when the
;; start passes the end — never swapped. Sharing `Clamp` is what keeps those two definitions from
;; drifting apart.
;;
;; No `%ArrayResize` here. `%ArrayStore` past the end grows the array, so writing `hi - lo`
;; elements into a fresh one leaves exactly that length, and a zero-width slice is the empty array
;; `%NewArray` already produced.
(macro ArraySlice :params [(a dyn) (start int) (end int)] :ret dyn
  (let [(len (%ArrayLen a))
        (lo (Clamp (if (%Lt start 0) (%Add len start) start) 0 len))
        (hi (Clamp (if (%Lt end 0) (%Add len end) end) 0 len))
        (out (%NewArray))]
    (loop [(i lo)]
      (if (%Le hi i) out
        (let [(ignored (%ArrayStore out (%Sub i lo) (%ArrayLoad a i)))]
          (recur (%Add i 1)))))))

;; A dense array of `n` copies of `v`. `Array.prototype.fill` over a fresh array.
(macro ArrayRepeat :params [(n dyn) (v dyn)] :ret dyn
  (let [(a (%NewArray))]
    (loop [(i 0)]
      (if (%Le n i) a
        (let [(ignored (%ArrayStore a i v))]
          (recur (%Add i 1)))))))

;; The ascending integers [0, n), which gives the conformance table an array whose every element is
;; distinguishable — a fill of one repeated value cannot tell an off-by-one index from a correct one.
(macro ArrayIota :params [(n dyn)] :ret dyn
  (let [(a (%NewArray))]
    (loop [(i 0)]
      (if (%Le n i) a
        (let [(ignored (%ArrayStore a i i))]
          (recur (%Add i 1)))))))

;; The original pre-callback conformance fixture. Kept as a small closed mapping probe; `ArrayMap`
;; below is the actual JavaScript callback definition reached by source programs.
(macro ArrayMapDouble :params [(src dyn)] :ret dyn
  (let [(len (%ArrayLen src))
        (out (%NewArray))]
    (loop [(i 0)]
      (if (%Le len i) out
        (let [(ignored (%ArrayStore out i (%Mul (%ArrayLoad src i) 2)))]
          (recur (%Add i 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.map. Array elements already carry the tagged
;; JavaScript representation expected by a callback. The index and receiver array are boxed at the
;; semantic boundary, and the callback result is stored without changing its representation.
(macro ArrayMap :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))
        (out (%NewArray))]
    (loop [(i 0)]
      (if (%Le len i) out
        (let [(mapped (call callback (%ArrayLoad src i) (%Box i) src))
              (ignored (%ArrayStore out i mapped))]
          (recur (%Add i 1)))))))

(macro ArrayFilter :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))
        (out (%NewArray))
        ;; Reserve the maximum dense result once, then publish the selected count at exit.
        (prepared (%ArrayResize out len out))]
    (loop [(i 0) (j 0)]
      (if (%Le len i)
          (let [(resized (%ArrayResize out j out))] out)
        (let [(value (%ArrayLoad src i))
              (selected (call callback value (%Box i) src))]
          (if selected
              (let [(ignored (%ArrayStore out j value))]
                (recur (%Add i 1) (%Add j 1)))
              (recur (%Add i 1) j)))))))

(macro ArrayForEach :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (loop [(i 0)]
      (if (%Le len i) (%Box undefined)
        (let [(ignored (call callback (%ArrayLoad src i) (%Box i) src))]
          (recur (%Add i 1)))))))

(macro ArraySome :transitioning true :params [(src dyn) (callback dyn)] :ret bool
  (let [(len (%ArrayLen src))]
    (loop [(i 0)]
      (if (%Le len i) false
        (if (call callback (%ArrayLoad src i) (%Box i) src)
            true
            (recur (%Add i 1)))))))

(macro ArrayEvery :transitioning true :params [(src dyn) (callback dyn)] :ret bool
  (let [(len (%ArrayLen src))]
    (loop [(i 0)]
      (if (%Le len i) true
        (if (call callback (%ArrayLoad src i) (%Box i) src)
            (recur (%Add i 1))
            false)))))

(macro ArrayFind :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (loop [(i 0)]
      (if (%Le len i) (%Box undefined)
        (let [(value (%ArrayLoad src i))]
          (if (call callback value (%Box i) src)
              value
              (recur (%Add i 1))))))))

(macro ArrayFindIndex :transitioning true :params [(src dyn) (callback dyn)] :ret int
  (let [(len (%ArrayLen src))]
    (loop [(i 0)]
      (if (%Le len i) -1
        (if (call callback (%ArrayLoad src i) (%Box i) src)
            i
            (recur (%Add i 1)))))))

;; The accumulator is a loop-carried JavaScript value. Older lowering could not select that dyn Phi
;; and used a one-element scratch array instead; carrying it directly removes an allocation plus a
;; load and store around every callback while spelling the specification more faithfully.
(macro ArrayReduceInitial :transitioning true
  :params [(src dyn) (callback dyn) (initial dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (loop [(i 0) (acc initial)]
      (if (%Le len i) acc
        (recur (%Add i 1)
               (call callback acc (%ArrayLoad src i) (%Box i) src))))))

(macro ArrayReduce :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (if (%Le len 0)
        (%Throw "TypeError: Reduce of empty array with no initial value")
        (loop [(i 1) (acc (%ArrayLoad src 0))]
          (if (%Le len i) acc
            (recur (%Add i 1)
                   (call callback acc (%ArrayLoad src i) (%Box i) src)))))))

(macro ArrayReduceRightInitial :transitioning true
  :params [(src dyn) (callback dyn) (initial dyn)] :ret dyn
  (loop [(i (%Sub (%ArrayLen src) 1)) (acc initial)]
    (if (%Lt i 0) acc
      (recur (%Sub i 1)
             (call callback acc (%ArrayLoad src i) (%Box i) src)))))

(macro ArrayReduceRight :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (if (%Le len 0)
        (%Throw "TypeError: Reduce of empty array with no initial value")
        (loop [(i (%Sub len 2)) (acc (%ArrayLoad src (%Sub len 1)))]
          (if (%Lt i 0) acc
            (recur (%Sub i 1)
                   (call callback acc (%ArrayLoad src i) (%Box i) src)))))))

(macro ArraySort :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (loop [(end (%Sub len 1))]
      (if (%Le end 0) src
        (let [(pass
                (loop [(i 0)]
                  (if (%Le end i) i
                    (let [(left (%ArrayLoad src i))
                          (right (%ArrayLoad src (%Add i 1)))
                          (order (call callback left right))]
                      (if (%Lt 0 order)
                          (let [(first (%ArrayStore src i right))
                                (second (%ArrayStore src (%Add i 1) left))]
                            (recur (%Add i 1)))
                          (recur (%Add i 1)))))))]
          (recur (%Sub end 1)))))))

(macro ArraySortDefault :params [(src dyn)] :ret dyn
  (let [(len (%ArrayLen src))]
    (loop [(end (%Sub len 1))]
      (if (%Le end 0) src
        (let [(pass
                (loop [(i 0)]
                  (if (%Le end i) i
                    (let [(left (%ArrayLoad src i))
                          (right (%ArrayLoad src (%Add i 1)))
                          (order (%StringCompare (ToStringValue left) (ToStringValue right)))]
                      (if (%Lt 0 order)
                          (let [(first (%ArrayStore src i right))
                                (second (%ArrayStore src (%Add i 1) left))]
                            (recur (%Add i 1)))
                          (recur (%Add i 1)))))))]
          (recur (%Sub end 1)))))))

(macro ArrayFlatMap :transitioning true :params [(src dyn) (callback dyn)] :ret dyn
  (let [(len (%ArrayLen src))
        (out (%NewArray))]
    (loop [(i 0) (to 0)]
      (if (%Le len i) out
        (let [(mapped (%UnboxObj (call callback (%ArrayLoad src i) (%Box i) src)))
              (mlen (%ArrayLen mapped))
              (next
                (loop [(j 0) (at to)]
                  (if (%Le mlen j) at
                    (let [(stored (%ArrayStore out at (%ArrayLoad mapped j)))]
                      (recur (%Add j 1) (%Add at 1))))))]
          (recur (%Add i 1) next))))))
