  (let [(len (%ArrayLen src))]
    (loop [(end (%Sub len 1))]
      (if (%Le end 0) src
        (let [(pass
                (loop [(i 0)]
                  (if (%Le end i) i
                    (let [(left (%ArrayLoad src i))
                          (right (%ArrayLoad src (%Add i 1)))
                          (order (%StringCompare (ToStringValue left) (ToStringValue right)))]
                      (if (%Lt 0 order)
                          (let [(first (%ArrayStore src i right))
                                (second (%ArrayStore src (%Add i 1) left))]
                            (recur (%Add i 1)))
                          (recur (%Add i 1)))))))]
          (recur (%Sub end 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.flatmap -- FlattenIntoArray with depth 1, and the
;; depth is the whole subtlety: a mapped element is SPREAD when it is an array and APPENDED when it
;; is not. This used to do neither. It unboxed EVERY mapped value as an object and read its length,
;; so `[1, 2, 3].flatMap(x => x)` -- whose callback answers a number -- read the length of a number
;; and produced the EMPTY array where node says "1,2,3".
;;
;; `ArrayConcatValue` IS that append-or-spread step, already written for `concat`, so this is the
;; loop and nothing else. It could not be written this way until `be-array-value?` learned to follow
;; a `Call` to its callee's returns: `ArrayConcatValue` asks `%IsArray`, and an array returned from a
;; function was not array-tagged, so `flatMap(x => [x, x])` appended three arrays instead of
;; spreading six numbers. Both callbacks are in `tests/native-execution-test.coil` now, because the
;; two shapes fail in opposite directions and one of them passing proves nothing about the other.
(macro ArrayFlatMap :transitioning true
  :params [(src dyn) (callback dyn) (thisArg dyn)] :ret dyn
  (let [(len (%ArrayLen src))
        (out (%NewArray))]
    (loop [(i 0)]
      (if (%Le len i) out
        (let [(mapped (call-dynamic-with-receiver callback thisArg
                                                   (%ArrayLoad src i) (%Box i) src))
              (appended (ArrayConcatValue out mapped))]
          (recur (%Add i 1)))))))
