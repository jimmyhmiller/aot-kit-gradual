;; Read-only Array.prototype, over an array receiver and already-coerced arguments.
;;
;; EVERY ENTRY HERE IS A `macro`, AND IT HAS TO BE. Memory reaches a function as an `OP-ARG`, never
;; as a parameter — `v-mem-producer?` decides that structurally — so a `builtin` synthesises its own
;; entry heap and reads an EMPTY one rather than its caller's. A macro is lowered into the caller's
;; graph, so it reads the caller's memory. `JSL-ERR-HEAP-IN-BUILTIN` refuses the other shape.
;;
;; These ARE verified against Node, now that `build.jsl` can allocate: a probe definition builds the
;; array and reads it back, all inside one function, so nothing crosses a call.
;;
;; MEMORY IS IMPLICIT. `%ArrayLen` and `%ArrayLoad` take the ambient heap from the lowering rather
;; than from an operand here, so a definition reads like the spec rather than like memory SSA.

;; https://tc39.es/ecma262/#sec-array.prototype.indexof, steps 6-10, from an already-clamped start.
(macro ArrayIndexOfFrom :params [(a dyn) (target dyn) (from int)] :ret int
  (let [(len (%ArrayLen a))]
    (loop [(i from)]
      (if (%Le len i) -1
        (if (%Eq (%ArrayLoad a i) target) i (recur (%Add i 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.includes. It differs from `indexOf` in EXACTLY one
;; way and it is the reason both exist: `includes` compares with SameValueZero, so it finds a NaN
;; that `indexOf` — using strict equality — never can.
(macro ArrayIncludes :params [(a dyn) (target dyn)] :ret bool
  (let [(len (%ArrayLen a))]
    (loop [(i 0)]
      (if (%Le len i) false
        (if (SameValueZero (%ArrayLoad a i) target) true (recur (%Add i 1)))))))

;; https://tc39.es/ecma262/#sec-array.prototype.lastindexof, searching the whole array.
(macro ArrayLastIndexOf :params [(a dyn) (target dyn)] :ret int
  (loop [(i (%Sub (%ArrayLen a) 1))]
    (if (%Lt i 0) -1
      (if (%Eq (%ArrayLoad a i) target) i (recur (%Sub i 1))))))

;; https://tc39.es/ecma262/#sec-array.prototype.at — a negative index counts from the end.
;;
;; `(%Box undefined)` RATHER THAN `undefined`, and the same in `StringAt`. A bare `undefined` in a
;; JSL body is `Const : undef`, and selection materialises that as the machine word 0 — the payload
;; without the tag, which is correct for a value the compiler knows is undefined and wrong the
;; moment it merges with a tagged one. The other arm here is `%ArrayLoad`, which is boxed, so the
;; Phi would be a tag on one path and a plain 0 on the other. `ArrayPop` sidesteps the same trap by
;; being branch-free; an index that can miss cannot, so the constant is boxed to match.
(macro ArrayAt :params [(a dyn) (i dyn)] :ret dyn
  (let [(k (RelativeIndex i (%ArrayLen a)))]
    (if (%Lt k 0) (%Box undefined) (%ArrayLoad a k))))

;; https://tc39.es/ecma262/#sec-array.prototype.join.
;;
;; `undefined` and `null` become the EMPTY string rather than "undefined" and "null", which is the
;; one place `join` disagrees with `String(x)` and the reason this cannot just call `%ToString`.
(macro ArrayJoin :params [(a dyn) (sep dyn)] :ret dyn
  (ArrayJoinSeen a sep (%NewArray)))

(macro ArrayJoinSeen :params [(a dyn) (sep dyn) (seen dyn)] :ret dyn
  (let [(len (%ArrayLen a))]
    (loop [(i 0) (out "")]
      (if (%Le len i) out
        (let [(v (%ArrayLoad a i))
              ;; Boxed constants, for the reason `ArrayAt` above states: `v` is a tagged element and
              ;; a bare `undefined` is the machine word 0, so the unboxed spelling compared a tag
              ;; against a payload and never matched. `[1, undefined, null, 4].join(",")` came out
              ;; as "1,undefined,null,4" — the exact case this definition exists to get right.
              ;; `ToStringValue`, NOT `%ToString`, and that is what makes `join` RECURSIVE:
              ;; `[1, [2, 3]].join("-")` is "1-2,3", because converting an element that is itself
              ;; an array joins it with a comma. `%ToString` bottoms out in the runtime's tag
              ;; dispatch and answers "[object Object]" there. The recursion runs through
              ;; `ArrayToStringValue`, which is a `builtin` -- a CALL, which terminates; a macro
              ;; reaching itself is an inline expansion that does not, and
              ;; `jsl-check-macro-cycles` refuses it by name.
              (piece (if (%Eq v (%Box undefined)) ""
                       (if (%Eq v (%Box null)) "" (ToStringValueSeen v seen))))
              (joined (if (%Eq i 0) piece (%StringConcat out (%StringConcat sep piece))))]
          (recur (%Add i 1) joined))))))

;; https://tc39.es/ecma262/#sec-array.prototype.tostring -- `join` with no separator, which is a
;; comma. THIS IS WHAT `String([1, 2, 3])` REACHES. `%ToString` bottoms out in the runtime's tag
;; dispatch, which answers "[object Object]" for every tagged object; that is right for an object
;; and wrong for an array, and no amount of work inside the primitive can tell them apart usefully
;; because the ARRAY case is a JavaScript algorithm rather than a formatting rule. So it is decided
;; above the primitive, here.
;; `seen` IS A STACK, PUSHED AND POPPED, and it is what makes a self-referential array terminate:
;; `let a = [1]; a.push(a); String(a)` is "1," in JavaScript, not an infinite recursion and not a
;; RangeError. Pushed and popped rather than accumulated, because the question is "am I inside this
;; array right now" and not "have I ever seen it": `String([b, b])` for one array `b` is "1,1", and
;; an append-only visited list would answer "1," for it.
(builtin ArrayToStringValue :transitioning true :params [(value dyn) (seen dyn)] :ret dyn
  (if (ArraySeenHas seen value)
      ""
      (let [(pushed (%ArrayStore seen (%ArrayLen seen) value))
            (out (ArrayJoinSeen (%UnboxArray value) "," seen))
            (dropped (%ArrayResize seen (%Sub (%ArrayLen seen) 1) seen))]
        out)))

;; The cycle stack, searched by IDENTITY. `%Eq` on two tagged array words compares the pointers,
;; which is the question being asked -- two arrays with equal contents are different entries.
(macro ArraySeenHas :params [(seen dyn) (value dyn)] :ret bool
  (let [(len (%ArrayLen seen))]
    (loop [(i 0)]
      (if (%Le len i) false
        (if (%Eq (%ArrayLoad seen i) value) true (recur (%Add i 1)))))))
