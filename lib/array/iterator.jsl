;; https://tc39.es/ecma262/#sec-createarrayiterator
;; The three internal slots are representation-owned primitives, analogous to V8's Torque-declared
;; JSArrayIterator fields. Everything observable—live length, exhaustion, values and result object
;; layout—is ordinary JSL.
(macro CreateArrayIterator :params [(array dyn) (kind int)] :ret dyn
  (let [(iterator (%Box (%NewObject)))
        (initialized (%InternalInit iterator array kind))]
    iterator))

(macro ArrayKeys :params [(array dyn)] :ret dyn (CreateArrayIterator array 0))
(macro ArrayValues :params [(array dyn)] :ret dyn (CreateArrayIterator array 1))
(macro ArrayEntries :params [(array dyn)] :ret dyn (CreateArrayIterator array 2))

(macro CreateIteratorResultObject :params [(value dyn) (done bool)] :ret dyn
  (let [(result (%Box (%NewObject)))
        (value-stored (SetProperty result "value" value))
        (done-stored (SetProperty result "done" done))]
    result))

;; https://tc39.es/ecma262/#sec-%arrayiteratorprototype%.next
(macro ArrayIteratorNext :params [(iterator dyn)] :ret dyn
  (let [(index (%InternalIndex iterator))]
    (if (%Lt index 0)
        (CreateIteratorResultObject (%Box undefined) true)
        (let [(array (%InternalTarget iterator))
              (length (%ArrayLen array))]
          (if (%Le length index)
              (let [(exhausted (%InternalSetIndex iterator -1))]
                (CreateIteratorResultObject (%Box undefined) true))
              (let [(kind (%InternalKind iterator))
                    (advanced (%InternalSetIndex iterator (%Add index 1)))
                    (value
                      (if (%Eq kind 0)
                          (%Box index)
                          (if (%Eq kind 1)
                              (%ArrayLoad array index)
                              (let [(entry (%NewArray))
                                    (key-stored (%ArrayStore entry 0 (%Box index)))
                                    (value-stored (%ArrayStore entry 1 (%ArrayLoad array index)))]
                                (%Box entry)))))]
                (CreateIteratorResultObject value false)))))))

;; https://tc39.es/ecma262/#sec-getiterator, restricted to the one iterable this closed world has
;; a representation for. There are no Symbols here, so there is no @@iterator to look up: an array
;; answers with %ArrayIteratorPrototype% and everything else is a TypeError. It THROWS rather than
;; iterating zero times, because `for (const c of "abc")` is a real program this cannot run yet and
;; an empty body would look like a correct answer.
(macro GetIterator :params [(value dyn)] :ret dyn
  (if (%IsArray (%Box value))
      (ArrayValues value)
      (%Throw "TypeError: value is not iterable")))

;; https://tc39.es/ecma262/#sec-iteratorcomplete and #sec-iteratorvalue: the two questions
;; `for ... of` asks of the object `next` hands back. `done` is stored through SetProperty, so it
;; arrives boxed and the `if` is ordinary JavaScript truthiness -- which `If` owns end to end.
(macro IteratorComplete :params [(result dyn)] :ret bool
  (if (GetProperty result "done") true false))

(macro IteratorValue :params [(result dyn)] :ret dyn (GetProperty result "value"))
