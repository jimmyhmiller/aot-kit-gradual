;; https://tc39.es/ecma262/#sec-number.isnan etc. Every one of these is false for a NON-number, which
;; is the whole difference between `Number.isNaN` and the global `isNaN`, so each begins with a type
;; test rather than a coercion.
(builtin NumberIsNaN :params [(v dyn)] :ret bool
  (if (%IsNumber v) (IsNaNValue v) false))

(builtin NumberIsFinite :params [(v dyn)] :ret bool
  (if (%IsNumber v)
      (if (IsNaNValue v) false
        (if (%Eq v (Infinity)) false (%Not (%Eq v (NegInfinity)))))
      false))

;; An integral Number is one equal to its own truncation. The finiteness test comes first because
;; `trunc(Infinity)` is `Infinity`, which would otherwise compare equal and report true.
(builtin NumberIsInteger :transitioning true :params [(v dyn)] :ret bool
  (if (NumberIsFinite v) (%Eq v (MathTrunc v)) false))

(builtin NumberIsSafeInteger :transitioning true :params [(v dyn)] :ret bool
  (if (NumberIsInteger v)
      (%Le (MathAbs v) 9007199254740991)
      false))
