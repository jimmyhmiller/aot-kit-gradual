{
  "name": "aot-kit-gradual-workflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test262": "node tools/run-test262.mjs",
    "spec:ledger": "node tools/ecma262-ledger.mjs --fetch",
    "spec:ledger:check": "node tools/ecma262-ledger.mjs --check",
    "spec:ledger:validate": "node tools/ecma262-ledger.mjs --validate",
    "test:spec-ledger": "node --test tools/ecma262-ledger-test.mjs",
    "test:jsl-provenance": "node --test tools/jsl-provenance-test.mjs",
    "spec:provenance": "node tools/jsl-provenance.mjs",
    "spec:provenance:check": "node tools/jsl-provenance.mjs --check",
    "test:spec-coverage": "node --test tools/ecma262-coverage-test.mjs",
    "spec:coverage": "node tools/ecma262-coverage.mjs",
    "spec:coverage:check": "node tools/ecma262-coverage.mjs --check",
    "test:spec-dependency-plan": "node --test tools/ecma262-dependency-plan-test.mjs",
    "spec:dependency-plan": "node tools/ecma262-dependency-plan.mjs",
    "spec:dependency-plan:check": "node tools/ecma262-dependency-plan.mjs --check",
    "test:spec-classification-candidates": "node --test tools/ecma262-classification-candidates-test.mjs",
    "spec:classification-candidates": "node tools/ecma262-classification-candidates.mjs",
    "spec:classification-candidates:check": "node tools/ecma262-classification-candidates.mjs --check",
    "test:intrinsic-manifest": "node --test tools/intrinsic-manifest-test.mjs",
    "spec:intrinsics": "node tools/intrinsic-manifest.mjs",
    "spec:intrinsics:check": "node tools/intrinsic-manifest.mjs --check",
    "spec:operation:graph": "coil run tools/jsl-operation-check.coil --quiet --",
    "bench:simple-scheduler": "node tools/simple-scheduler-benchmark.mjs",
    "test:spec-operation": "node --test tools/ecma262-operation-test.mjs",
    "spec:operation": "node tools/ecma262-operation.mjs",
    "test:test262-compare": "node --test tools/compare-test262-results-test.mjs",
    "test262:compare": "node tools/compare-test262-results.mjs",
    "test:test262-analysis": "node --test tools/analyze-test262-results-test.mjs",
    "test:spec-test262": "node --test tools/ecma262-test262-test.mjs",
    "spec:test262": "node tools/ecma262-test262.mjs",
    "spec:ledger:gate": "npm run test:spec-ledger && npm run spec:ledger:validate && npm run test:jsl-provenance && npm run spec:provenance:check && npm run test:spec-coverage && npm run spec:coverage:check && npm run test:spec-dependency-plan && npm run spec:dependency-plan:check && npm run test:spec-classification-candidates && npm run spec:classification-candidates:check && npm run test:intrinsic-manifest && npm run spec:intrinsics:check && npm run test:spec-operation && npm run test:test262-compare && npm run test:test262-analysis && npm run test:spec-test262"
  },
  "devDependencies": {
    "ecmarkup": "24.2.1",
    "js-yaml": "^5.3.0",
    "typescript": "5.9.3"
  }
}
